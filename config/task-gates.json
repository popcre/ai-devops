      "match": "*/ai-devops",
      "paths": [
        {
          "glob": "bin/ai-review",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-review-*",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-claude-review",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-codex-review",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-grok-review",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-deepseek-agent",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-stepfun*",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-gemini*",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-glm",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-kimi",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-muse",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-qwen",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-reviewer-issue",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-task-gates",
          "class": "reviewer-safety"
        },
        {
          "glob": "bin/ai-process-supervisor",
          "class": "reviewer-safety"
        },
        {
          "glob": "tools/lib/task-gates.sh",
          "class": "reviewer-safety"
        },
        {
          "glob": "config/task-gates.json",
          "class": "reviewer-safety"
        },
        {
          "glob": "tools/reviewer_*",
          "class": "reviewer-safety"
        },
        {
          "glob": "config/review-action-profiles.json",
          "class": "reviewer-safety"
        },
        {
          "glob": "tools/review_action_profile.py",
          "class": "reviewer-safety"
        }
      ],
      "gates": {}
    },
    {
      "match": "popcre/designflow-*",
      "paths": [
        {
          "glob": "**/*.component.ts",
          "class": "ui-live-workflow"
        },
        {
          "glob": "**/*.component.html",
          "class": "ui-live-workflow"
        },
        {
          "glob": "supabase/**",
          "class": "shared-db"
        }
      ],
      "gates": {
        "prose": {
          "required": [
            "no-self-merge"
          ],
          "forbidden_actions": []
        },
        "code": {
          "required": [
            "no-self-merge",
            "sandbox-branch-pr-to-develop"
          ],
          "forbidden_actions": []
        },
        "ui-live-workflow": {
          "required": [
            "no-self-merge",
            "sandbox-branch-pr-to-develop"
          ],
          "forbidden_actions": []
        },
        "shared-db": {
          "required": [
            "route-to-shared-db-repository"
          ],
          "forbidden_actions": [
            "database"
          ]
        }
      }
    },
    {
      "match": "popcre/shared-db",
      "paths": [
        {
          "glob": "migrations/**",
          "class": "shared-db"
        },
        {
          "glob": "master-data/**",
          "class": "shared-db"
        },
        {
          "glob": "policies/**",
          "class": "shared-db"
        }
      ],
      "gates": {
