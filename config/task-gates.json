{
  "schema_version": 1,
  "_comment": [
    "Central task-gate contract. It answers two separate questions:",
    "  1. what changed  -> a change class, from `paths`",
    "  2. which gates apply -> required proofs and forbidden actions, from `gates`",
    "A consumer repository ships only `.ai-devops/task-gates.json`, holding",
    "optional extra `paths` and optional extra `gates`. It carries no `match`:",
    "the file already belongs to one repository. Resolution takes the STRONGEST",
    "class over every changed path across both central and local",
    "matches, so a local declaration can strengthen a gate and can never weaken",
    "one. See docs/context-spec.md for the full contract.",
    "",
    "code-only-review is the sealed attachment-only route (bin/ai-review --code-only):",
    "the only review action a private class may start without a reviewer approval.",
    "It refuses to start on a private class unless that repository's own",
    ".ai-devops/task-gates.json declares the synthetic-fixtures-only gate for",
    "that class, so opening the route is each private repository's own reviewed",
    "decision. The formal review action stays forbidden for both private classes.",
    "",
    "reviewer_release (#1239) lets one protected class reach the reviewer-approval step for one named",
    "action, only while the EFFECTIVE class is named there AND that repository declares the named gate",
    "for that class in its own .ai-devops/task-gates.json. It never starts the action without an",
    "assigned AI reviewer exact-head final-check or security-review APPROVE, and it can never",
    "release private-evidence: one licensed path in the change set keeps the action sealed.",
    "application_source_releases is one closed central exception for a reviewed Cloud Build branch-source push, never a manual cloud mutation."
  ],
  "actions": [
    "review",
    "code-only-review",
    "pr-wait",
    "ship",
    "deploy",
    "database",
    "infrastructure",
    "production",
    "shared-db-promotion"
  ],
  "action_gates": {
    "code-only-review": {
      "require_gate": {
        "private-evidence": "synthetic-fixtures-only",
        "private-tooling": "synthetic-fixtures-only"
      }
    },
    "shared-db-promotion": {
      "require_gate": {
        "shared-db": "production-promotion-authorization"
      }
    }
  },
  "reviewer_release": {
    "database": {
      "private-tooling": "reviewed-private-data-writer"
    }
  },
  "application_source_releases": {
    "popcre/designflow-backend": {
      "manifest_path": ".ai-devops/application-release-target.json",
      "required_consumer_gate": "cloud-build-release-review",
      "target": {
        "schema_version": 1,
        "repository": "popcre/designflow-backend",
        "route": "cloud-build-branch-push",
        "branch": "sandbox-albert",
        "project": "lithe-breaker-323913",
        "region": "us-east4",
        "service": "popcre-albert-core-sandbox"
      }
    }
  },
  "change_classes": {
    "prose": {
      "rank": 10,
      "protected": false,
      "description": "Ordinary documentation, plans, handoffs, and notes."
    },
    "code": {
      "rank": 20,
      "protected": false,
      "description": "Source, tests, configuration, and workflows."
    },
    "installation": {
      "rank": 25,
      "protected": false,
      "description": "Toolkit installers, machine setup, and local command catalogs requiring an assigned AI reviewer's exact-head APPROVE before installation."
    },
    "reviewer-safety": {
      "rank": 30,
      "protected": true,
      "description": "Reviewer lifecycle, provider wrappers, sandboxing, and evidence integrity."
    },
    "ui-live-workflow": {
      "rank": 40,
      "protected": true,
      "description": "User interface or an authenticated live workflow needing visual proof."
    },
    "shared-db": {
      "rank": 50,
      "protected": true,
      "description": "Shared database structure, migrations, security rules, or curated master data."
    },
    "deployment": {
      "rank": 60,
      "protected": true,
      "description": "Deployment definitions, pipelines, and release wiring."
    },
    "infrastructure": {
      "rank": 70,
      "protected": true,
      "description": "Terraform, Terragrunt, Ansible, and other infrastructure definitions."
    },
    "production": {
      "rank": 80,
      "protected": true,
      "description": "Anything that mutates or gates live production state."
    },
    "private-evidence": {
      "rank": 90,
      "protected": true,
      "description": "Licensed rows, raw transcripts, and other private evidence."
    },
    "private-tooling": {
      "rank": 95,
      "protected": true,
      "description": "Explicit tooling inside a private-evidence repository that is named as carrying no licensed rows. Ranked above private-evidence only so those paths can demand local-tests; review stays forbidden because a formal review snapshots the whole private repository. One licensed path still forces the change set to private-evidence."
    }
  },
  "default": {
    "fallback_class": "code",
    "paths": [
      {
        "glob": "**/*.md",
        "class": "prose"
      },
      {
        "glob": "**/*.txt",
        "class": "prose"
      },
      {
        "glob": "*.ps1",
        "class": "code"
      },
      {
        "glob": "*.psm1",
        "class": "code"
      },
      {
        "glob": "*.psd1",
        "class": "code"
      },
      {
        "glob": "skills/**",
        "class": "code"
      },
      {
        "glob": ".github/workflows/*",
        "class": "code"
      },
      {
        "glob": "**/Dockerfile",
        "class": "deployment"
      },
      {
        "glob": "**/docker-compose*.yml",
        "class": "deployment"
      },
      {
        "glob": "**/cloudbuild*.yaml",
        "class": "deployment"
      },
      {
        "glob": "**/*.tf",
        "class": "infrastructure"
      },
      {
        "glob": "**/*.tfvars",
        "class": "infrastructure"
      },
      {
        "glob": "**/*.hcl",
        "class": "infrastructure"
      },
      {
        "glob": "**/migrations/**",
        "class": "shared-db"
      },
      {
        "glob": "**/*.sql",
        "class": "shared-db"
      }
    ],
    "gates": {
      "prose": {
        "required": [],
        "forbidden_actions": [
          "review",
          "pr-wait",
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "code": {
        "required": [
          "local-tests"
        ],
        "forbidden_actions": [
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "installation": {
        "required": [
          "local-tests",
          "assigned-ai-reviewer-approval"
        ],
        "forbidden_actions": [
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "reviewer-safety": {
        "required": [
          "local-tests",
          "exact-head-independent-review"
        ],
        "forbidden_actions": [
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "ui-live-workflow": {
        "required": [
          "local-tests",
          "visual-proof",
          "authenticated-workflow-proof"
        ],
        "forbidden_actions": [
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "shared-db": {
        "required": [
          "local-tests",
          "shared-db-branch-and-pr",
          "target-identity-proof",
          "claim-admission"
        ],
        "forbidden_actions": [
          "deploy",
          "infrastructure",
          "production"
        ]
      },
      "deployment": {
        "required": [
          "local-tests",
          "assigned-ai-reviewer-approval"
        ],
        "forbidden_actions": [
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "infrastructure": {
        "required": [
          "local-tests",
          "assigned-ai-reviewer-approval",
          "read-only-by-default"
        ],
        "forbidden_actions": [
          "database",
          "production",
          "shared-db-promotion"
        ]
      },
      "production": {
        "required": [
          "exact-resource-and-action-ai-reviewer-approval"
        ],
        "forbidden_actions": [
          "shared-db-promotion"
        ]
      },
      "private-evidence": {
        "required": [
          "privacy-classification",
          "no-raw-content-read"
        ],
        "forbidden_actions": [
          "review",
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      },
      "private-tooling": {
        "required": [
          "privacy-classification",
          "no-raw-content-read",
          "local-tests"
        ],
        "forbidden_actions": [
          "review",
          "deploy",
          "database",
          "infrastructure",
          "production",
          "shared-db-promotion"
        ]
      }
    }
  },
  "rules": [
