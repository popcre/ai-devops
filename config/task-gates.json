          "class": "deployment"
        },
        {
          "glob": "**/fixtures/licensed/**",
          "class": "private-evidence"
        }
      ],
      "gates": {
        "deployment": {
          "required": [
            "release-marker-review"
          ],
          "forbidden_actions": []
        },
        "production": {
          "required": [
            "current-chat-resource-and-action-authorization"
          ],
          "forbidden_actions": []
        }
      }
    },
    {
      "match": "u2giants/popcrm-web",
      "paths": [
        {
          "glob": "src/**",
          "class": "ui-live-workflow"
        }
      ],
      "gates": {}
    },
    {
      "match": "u2giants/poppim-web",
      "paths": [
        {
          "glob": "src/**",
          "class": "ui-live-workflow"
        }
      ],
      "gates": {}
    },
    {
      "match": "u2giants/popdam3",
      "paths": [
        {
          "glob": "src/**",
          "class": "ui-live-workflow"
        }
      ],
      "gates": {}
    },
    {
      "match": "u2giants/backrest-wiz",
      "paths": [],
      "gates": {}
    },
    {
      "match": "u2giants/licensor-source-data",
      "_comment": [
        "Licensed rows and captures stay private-evidence under the ** catch-all.",
        "Named tooling paths are a narrow exception: they demand local-tests, but",
        "review stays forbidden because a formal review snapshots the whole private",
        "repository. Classification is still path-based — never put licensed rows",
        "under scripts/ or scraper/."
      ],
      "paths": [
        {
          "glob": "**/scripts/**",
          "class": "private-tooling"
        },
        {
          "glob": "**/scraper/**",
          "class": "private-tooling"
        },
        {
          "glob": "**/*.mjs",
          "class": "private-tooling"
        },
        {
          "glob": "**/*.py",
          "class": "private-tooling"
        },
        {
          "glob": "**/package.json",
          "class": "private-tooling"
        },
        {
          "glob": "**/package-lock.json",
          "class": "private-tooling"
        },
        {
          "glob": ".ai-devops/task-gates.json",
          "class": "private-tooling"
        },
        {
          "glob": "**",
          "class": "private-evidence"
        }
      ],
      "gates": {
        "private-evidence": {
          "required": [
            "licensed-row-containment"
          ],
          "forbidden_actions": []
        },
        "private-tooling": {
          "required": [
            "licensed-row-containment"
          ],
          "forbidden_actions": []
        }
      }
    },
    {
      "match": "u2giants/ai-devops-transcripts",
      "paths": [
        {
          "glob": "**",
          "class": "private-evidence"
        }
      ],
      "gates": {
        "private-evidence": {
          "required": [
            "never-open-raw-transcript-archives"
          ],
          "forbidden_actions": []
        }
      }
    },
    {
      "match": "popcre/infrastructure",
      "paths": [
        {
          "glob": "**",
          "class": "infrastructure"
        }
      ],
      "gates": {
        "infrastructure": {
          "required": [
            "exact-resource-and-action-ai-reviewer-approval"
          ],
          "forbidden_actions": [
            "production"
          ]
        }
      }
    },
    {
      "match": "u2giants/ansible",
      "paths": [
        {
          "glob": "playbooks/**",
          "class": "infrastructure"
        },
        {
          "glob": "roles/**",
          "class": "infrastructure"
        },
        {
          "glob": "inventory/**",
          "class": "infrastructure"
        }
      ],
      "gates": {
        "infrastructure": {
          "required": [
            "exact-resource-and-action-ai-reviewer-approval"
          ],
          "forbidden_actions": [
            "production"
          ]
        }
      }
    }
  ]
}
