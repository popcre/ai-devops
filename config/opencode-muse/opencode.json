{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta-model-api/muse-spark-1.3-contributor",
  "small_model": "meta-model-api/muse-spark-1.3-contributor",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 8,
    "reserved": 32768
  },
  "provider": {
    "meta-model-api": {
      "npm": "@ai-sdk/openai",
      "name": "Meta Model API",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor",
          "limit": { "context": 1048576, "output": 65536 },
          "cost": { "input": 1.25, "output": 4.25, "cache_read": 0.15 },
          "options": {
            "promptCacheKey": "ai-devops-muse-review",
            "promptCacheRetention": "24h"
          }
        }
      }
    }
  }
}
