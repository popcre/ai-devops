# ==========================================================================
# ai-devops model configuration (EXAMPLE)
# --------------------------------------------------------------------------
# install.sh copies this to /etc/ai-devops/models.env ONLY if that file does
# not already exist. Edit the REAL file at /etc/ai-devops/models.env to match
# the exact CLI flags available on THIS machine — the model flags below are a
# starting point and may differ on your system.
#
# This is an EXAMPLE file and is safe to commit. Never put tokens or secrets
# here — real secrets belong in the CLI login state (~/.claude, ~/.codex), not
# in this file.
# ==========================================================================

# Root of the toolkit checkout.
AI_DEVOPS_HOME="/worksp/ai-devops"

# --------------------------------------------------------------------------
# Model command overrides
# --------------------------------------------------------------------------
# Each variable is the FULL command used to invoke that stage's model. The
# scripts pipe a prompt to these commands. Adjust the flags to whatever your
# installed `claude` / `codex` CLIs actually accept (run `claude --help` /
# `codex --help` to confirm).

# Claude Opus 5 — independent plan/diff/security/final reviewer. The adapter
# also validates the canonical returned model before accepting a report.
CLAUDE_REVIEW_CMD='claude -p --model claude-opus-5 --effort high --output-format json --permission-mode plan --tools Read,Grep,Glob --strict-mcp-config --mcp-config {"mcpServers":{}} --no-session-persistence --no-chrome --disable-slash-commands'

# Codex planning is read-only. Implementation and testing are the only shipped
# stage commands allowed to write the workspace. GPT-5.6 is explicitly kept at
# the supported low/medium reasoning levels.
CODEX_PLAN_CMD='codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox read-only -c model_reasoning_effort=medium'
CODEX_IMPLEMENT_CMD='codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox workspace-write -c model_reasoning_effort=medium'
CODEX_TEST_CMD='codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox workspace-write -c model_reasoning_effort=medium'

# Codex — used by ai-codex-review for second-opinion reviews.
CODEX_CMD='codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox read-only -c model_reasoning_effort=medium'
