#!/usr/bin/env bash
# ai-gh-wait — the sanctioned way to wait for a GitHub run, check, or PR state.
#
# It repeats one read through the ai-gh throttle no more often than every five
# minutes, prints output only when it changes, honours any machine-wide
# rate-limit back-off, and exits when the output matches a pattern or the
# deadline passes. Never use `gh run watch` or a sleep loop around bare `gh`
# (2026-09-15 secondary rate-limit incident, popcre/ai-devops#401).
#
# Usage:
#   ai-gh-wait --until-regex REGEX --timeout-minutes N [--interval SECONDS] -- <gh args>
# Example:
#   ai-gh-wait --until-regex '"status":"completed"' --timeout-minutes 30 -- run view 123 --repo o/r --json status,conclusion
#
# --timeout-minutes is required (explicit deadline only; #1183 child 3). There
# is no default: a waiter is never started without a deadline the caller named.
#
# The interval may not be below 300 seconds. Exit: 0 matched, 1 repeated
# non-rate-limit failure, 2 deadline reached, 3 usage error.
set -uo pipefail
say(){ printf 'ai-gh-wait: %s\n' "$*" >&2; }
MIN=300
[ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_GH_WAIT_TEST_MIN_INTERVAL:-}" ] && MIN="$AI_GH_WAIT_TEST_MIN_INTERVAL"
INTERVAL=300; TIMEOUT=''; REGEX=''
# Exit codes that mean "not finished yet" rather than failure (gh pr checks: 8).
PENDING="${AI_GH_WAIT_PENDING_CODES:-8}"
while [ $# -gt 0 ]; do
  case "$1" in
    --until-regex|--interval|--timeout-minutes)
      [ $# -ge 2 ] || { say "$1 needs a value"; exit 3; }
      case "$1" in
        --until-regex) REGEX="$2" ;;
        --interval) INTERVAL="$2" ;;
        --timeout-minutes) TIMEOUT="$2" ;;
      esac
      shift 2 ;;
    --) shift; break ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) say "unknown option $1"; exit 3 ;;
  esac
done
case "$INTERVAL" in *[!0-9]*|'') say "--interval must be a whole number"; exit 3 ;; esac
case "$TIMEOUT" in
  '') say "--timeout-minutes is required (explicit deadline only; no default)"; exit 3 ;;
  *[!0-9]*|0*) say "--timeout-minutes must be a positive whole number without leading zeros"; exit 3 ;;
esac
[ -n "$REGEX" ] || { say "--until-regex is required"; exit 3; }
[ $# -gt 0 ] || { say "gh arguments are required after --"; exit 3; }
[ "$INTERVAL" -ge "$MIN" ] || { say "--interval ${INTERVAL}s is below the 300-second minimum for GitHub waits"; exit 3; }
GH="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/ai-gh"
STATE="${AI_GH_STATE_DIR:-$HOME/.ai-devops/gh-throttle}"
SUPERVISOR="$(dirname "$GH")/ai-process-supervisor"
BASH_RUNNER="$(command -v bash 2>/dev/null || true)"
PYTHON_RUNNER=''
for candidate in python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' >/dev/null 2>&1 || continue
  PYTHON_RUNNER="$(command -v "$candidate")"; break
done
[ -x "$SUPERVISOR" ] && [ -n "$BASH_RUNNER" ] && [ -n "$PYTHON_RUNNER" ] || {
  say 'owned process supervision is unavailable; no GitHub call was made'; exit 3;
}
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*)
  GH="$(cygpath -w "$GH")"; SUPERVISOR="$(cygpath -w "$SUPERVISOR")"
  BASH_RUNNER="$(cygpath -w "$BASH_RUNNER")"; PYTHON_RUNNER="$(cygpath -w "$PYTHON_RUNNER")" ;;
esac
deadline=$(( $(date +%s) + TIMEOUT * 60 ))
# Offline tests (AI_DEVOPS_TEST_MODE=1 only) pin the deadline without sleeping
# a real minute. Production ignores the hook so a stray env cannot defeat the
# caller's explicit bound.
if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_GH_WAIT_TEST_DEADLINE_EPOCH:-}" ]; then
  deadline="$AI_GH_WAIT_TEST_DEADLINE_EPOCH"
fi
prev=''; fails=0
while :; do
  remaining=$(( deadline - $(date +%s) ))
  [ "$remaining" -gt 0 ] || { say 'deadline reached'; exit 2; }
  admission_budget="${AI_GH_NO_WAIT_LOCK_SECONDS:-300}"
  case "$admission_budget" in ''|*[!0-9]*) say 'AI_GH_NO_WAIT_LOCK_SECONDS must be whole seconds'; exit 3;; esac
  [ "$admission_budget" -le "$remaining" ] || admission_budget="$remaining"
  out="$(AI_GH_CALLER=ai-gh-wait AI_GH_NO_WAIT=1 AI_GH_NO_WAIT_LOCK_SECONDS="$admission_budget" \
    "$PYTHON_RUNNER" "$SUPERVISOR" --timeout-seconds "$remaining" -- \
    "$BASH_RUNNER" -c 'runner="$1"; shift; command -v cygpath >/dev/null 2>&1 && runner="$(cygpath -u "$runner")"; exec "$runner" "$@"' bash \
    "$GH" "$@")"; rc=$?   # stderr passes through so the real error is visible
  [ "$rc" -ne 124 ] || { say 'deadline reached'; exit 2; }
  delay="$INTERVAL"
  if [ "$rc" -eq 75 ]; then
    until_ts="$(cat "$STATE/backoff_until" 2>/dev/null)"; case "$until_ts" in ''|*[!0-9]*) until_ts=0;; esac
    left=$(( until_ts - $(date +%s) )); [ "$left" -gt "$delay" ] && delay="$left"
    say "GitHub back-off active; next attempt in ${delay}s"
  elif [ "$rc" -eq 2 ]; then
    say "the throttle refused this command (rc=2); not retrying"; exit 3
  elif [ "$rc" -ne 0 ] && ! printf ' %s ' "$PENDING" | grep -q " $rc "; then
    fails=$((fails+1)); say "gh failed (rc=$rc, attempt $fails)"
    [ "$fails" -ge 3 ] && { say "three consecutive failures; stopping"; exit 1; }
  else
    # rc 0, or a "not done yet" exit such as 8 from `gh pr checks` while checks
    # are pending: the output is real state, so it is shown and matched.
    fails=0
    [ "$out" != "$prev" ] && printf '%s\n' "$out"
    prev="$out"
    # Here-string, not a pipe: with pipefail, grep -q closing a large pipe early
    # would turn a real match into a failure.
    grep -Eq -- "$REGEX" <<<"$out" && exit 0
  fi
  [ $(( $(date +%s) + delay )) -lt "$deadline" ] || { say "deadline reached"; exit 2; }
  sleep "$delay"
done
