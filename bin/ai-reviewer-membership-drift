#!/usr/bin/env bash
# ai-reviewer-membership-drift — wrapper: duty-pool tick/schedule plus the
# existing Node compare (now ai-reviewer-membership-drift.cjs).
#
# Usage:
#   ai-reviewer-membership-drift tick      duty tick (claim, offline suite, compare)
#   ai-reviewer-membership-drift schedule|unschedule
#   ai-reviewer-membership-drift [args]    pass-through to the Node compare
#
# Exit: 0 ok; 1 drift/alarm; 2 usage; 3 not leader (tick only).
set -euo pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
TOOL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
# shellcheck source=tools/lib/local-watch.sh
. "$TOOL_ROOT/tools/lib/local-watch.sh"

TOOL_NAME='ai-reviewer-membership-drift'
HOME_DIR="${AI_MEMBERSHIP_DRIFT_HOME:-$HOME/.ai-devops/reviewer-membership-drift}"
CONFIG="${AI_LOCAL_WATCH_CONFIG:-$TOOL_ROOT/config/local-watch.json}"
LOG="$HOME_DIR/tick.log"
NODE_TOOL="$TOOL_ROOT/bin/ai-reviewer-membership-drift.cjs"
CLAIM="${AI_LOCAL_WATCH_BIN:-$TOOL_ROOT/bin/ai-local-watch}"

cfg(){ jq -er "$1" "$CONFIG" 2>/dev/null || echo 5000000; }

cmd_tick(){
  mkdir -p "$HOME_DIR"
  rotate_log "$LOG" "$(cfg .log_max_bytes)"
  local claim_rc=0
  "$CLAIM" claim || claim_rc=$?
  if [ "$claim_rc" -eq 3 ]; then
    note "skip: another host holds the claim"
    return 3
  fi
  if [ "$claim_rc" -ne 0 ]; then
    note "claim failed; not alarming without leadership"
    return 1
  fi
  local rc=0
  printf '%s membership-drift tick\n' "$(stamp)" >> "$LOG"
  bash "$TOOL_ROOT/tests/test-ai-reviewer-membership-drift.sh" >> "$LOG" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    node "$NODE_TOOL" >> "$LOG" 2>&1 || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    printf '%s ALARM: membership drift (exit %s)\n' "$(stamp)" "$rc" >> "$LOG"
  else
    printf '%s OK membership matches\n' "$(stamp)" >> "$LOG"
  fi
  return "$rc"
}

cmd_schedule(){ register_timer 360 "$TOOL_ROOT/bin/ai-reviewer-membership-drift" tick; }
cmd_unschedule(){ unregister_timer; }

case "${1:-}" in
  tick) cmd_tick ;;
  schedule) cmd_schedule ;;
  unschedule) cmd_unschedule ;;
  -h|--help|help)
    sed -n '2,16p' "$_self" | sed 's/^# \{0,1\}//'
    ;;
  *) exec node "$NODE_TOOL" "$@" ;;
esac
