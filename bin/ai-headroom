#!/usr/bin/env bash
# ai-headroom — turn the Headroom token-compression proxy ON or OFF for THIS machine.
#
# Headroom is a SINGLE POINT OF FAILURE. When Claude is pointed at it, Claude
# cannot reach Anthropic at all if the hetz VPS is down, the headroom service is
# stopped, or this machine's Tailscale link drops. There is NO automatic
# fallback — Claude Code has no "try the proxy, else go direct" behaviour.
#
# This is the escape hatch. Works on Windows (Git Bash) and Ubuntu.
#
#   ai-headroom status   what am I using, and is the proxy answering?
#   ai-headroom off      go straight to Anthropic
#   ai-headroom on       route through the proxy (refuses if it is down)
#   ai-headroom wrap-remote    force Claude remote workers on this host through it
#   ai-headroom unwrap-remote  restore those workers to their raw binaries
#
# Afterwards: fully quit Claude (tray icon -> Quit) and reopen it. The setting
# is only read at startup.
#
# THE ONLY MECHANISM THAT WORKS IS A REAL ENVIRONMENT VARIABLE.
# Measured on Claude Code 2.1.234 (2026-08-21): an `"env": {"ANTHROPIC_BASE_URL":
# …}` block in ~/.claude/settings.json is ACCEPTED, shown by every settings
# reader, and COMPLETELY IGNORED — a fresh `claude` process sent zero requests to
# the proxy. The same test with the variable exported in the environment routed
# immediately (proxy inbound count 352 -> 356). Claude resolves its base URL
# before settings `env` is applied.
#
# So this tool manages the environment variable, per platform:
#   Windows : the persistent USER environment variable (registry), which every
#             newly launched Claude inherits.
#   Linux   : the `export ANTHROPIC_BASE_URL=` line in ~/.bashrc.
#
# It also REMOVES any settings.json env entry it finds, because that entry is a
# false signal: it makes every status display say "routing through the proxy"
# while nothing is. That mistake cost this project nine days of believing
# Headroom was in use when it carried no traffic at all.
#
# See docs/headroom.md in popcre/ai-devops for the full picture.

set -euo pipefail

PROXY_URL="${AI_HEADROOM_PROXY_URL:-}"
if [ -z "$PROXY_URL" ] && [ -x "$(dirname "$0")/ai-private-config" ]; then
  PROXY_URL="$("$(dirname "$0")/ai-private-config" value headroom_proxy_url 2>/dev/null || true)"
fi
# An unresolved proxy URL must NEVER surface as "proxy not reachable" -- that
# sends you to debug the network when the real problem is that this machine has
# no protected config. Reproduced 2026-08-23: status said "NOT REACHABLE. Claude
# WILL FAIL to connect" against a perfectly healthy proxy, purely because
# ai-private-config was not installed here.
# `off` deliberately does not need the URL: the escape hatch must still work.
PROXY_URL_MISSING=0
[ -n "$PROXY_URL" ] || PROXY_URL_MISSING=1

SETTINGS="$HOME/.claude/settings.json"
BASHRC="$HOME/.bashrc"
KEEP_BACKUPS=10

die() { printf '%s\n' "$*" >&2; exit 1; }

# Pick a Python that actually RUNS. On Windows, python3 is usually a Microsoft
# Store placeholder that is present on PATH, prints "Python was not found", and
# exits nonzero. Probing with "command -v" alone finds that stub and every later
# call fails silently -- which once made this script report "proxy off" while the
# proxy was on. Never probe by existence; probe by execution.
PY=""
for c in python3 python py; do
  command -v "$c" >/dev/null 2>&1 || continue
  if "$c" -c 'import json,sys' >/dev/null 2>&1; then PY="$c"; break; fi
done
# Python is needed ONLY to read/clean the inert settings.json entry -- never to
# flip the actual switch. `off` must survive a machine where Python is broken or
# missing; that is precisely when someone needs the escape hatch. A missing
# Python degrades to a warning, never a refusal.
HAVE_PY=1
[ -n "$PY" ] || HAVE_PY=0

# curl is needed only to CHECK reachability (status, and the safety gate on `on`).
# `off` must never depend on it: the escape hatch has to work on a broken machine,
# and refusing to run because a health-check tool is missing would strand the user
# in exactly the situation this command exists for.
HAVE_CURL=1
command -v curl >/dev/null 2>&1 || HAVE_CURL=0

# Reachability. Tolerates whitespace and key-order changes in the health JSON
# rather than matching one exact byte sequence. Non-2xx or timeout counts as down.
proxy_healthy() {
  local body
  [ -n "$PROXY_URL" ] || return 1
  [ "$HAVE_CURL" = 1 ] || return 1
  body="$(curl -fsS -m 6 "$PROXY_URL/health" 2>/dev/null)" || return 1
  printf '%s' "$body" | tr -d ' \t\r\n' | grep -q '"status":"healthy"'
}

# ---------------------------------------------------------------------------
# ~/.claude/settings.json — INERT. Claude ignores its env block for the base URL
# (measured, see header). We only ever READ it to warn, and REMOVE it to stop it
# lying. We never write a value into it.
# ---------------------------------------------------------------------------

# Any failure here is FATAL, never silent: reporting "off" while the proxy is
# actually on would send you hunting the wrong problem.
json_url() {
  [ "$HAVE_PY" = 1 ] || return 0
  [ -f "$SETTINGS" ] || return 0
  "$PY" - "$SETTINGS" <<'PY' || die "ai-headroom: could not read $SETTINGS (see error above)."
import io, json, sys
# utf-8-sig transparently tolerates a BOM; an explicit encoding stops the
# Windows locale default from mangling non-ASCII values.
with io.open(sys.argv[1], encoding="utf-8-sig") as fh:
    d = json.load(fh)
v = (d.get("env") or {}).get("ANTHROPIC_BASE_URL")
if v:
    print(v)
PY
}

prune_backups() { # prune_backups <path-prefix>
  local prefix="$1" old
  ls -1t "$prefix".bak-* 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while IFS= read -r old; do
    rm -f "$old"
  done
  return 0
}

json_set() { # json_set <url|"">  — empty removes the key
  local want="$1" backup
  [ "$HAVE_PY" = 1 ] || { printf 'NOTE: no working Python, so I could not clean the (inert) settings.json entry.
'; return 0; }
  [ -f "$SETTINGS" ] || return 0
  # The pid is in the backup name so two invocations in the same second cannot
  # overwrite each other's only recovery copy.
  backup="$SETTINGS.bak-$(date +%Y%m%d-%H%M%S)-$$"
  cp "$SETTINGS" "$backup"
  printf 'Backup: %s\n' "$backup"
  "$PY" - "$SETTINGS" "$want" <<'PY' || die "ai-headroom: failed to update $SETTINGS. It is UNCHANGED; backup path printed above."
import io, json, os, sys, tempfile
p, want = sys.argv[1], sys.argv[2]
with io.open(p, encoding="utf-8-sig") as fh:
    d = json.load(fh)
env = d.get("env")
if not isinstance(env, dict):
    env = {}
if want:
    env["ANTHROPIC_BASE_URL"] = want
else:
    env.pop("ANTHROPIC_BASE_URL", None)
if env:
    d["env"] = env
else:
    d.pop("env", None)
# Write a temp file in the same directory, then atomically replace. A crash, a
# full disk, or a concurrent reader can never observe a truncated settings file:
# either the old one is there or the new one is, never half of one.
dirn = os.path.dirname(os.path.abspath(p)) or "."
fd, tmp = tempfile.mkstemp(dir=dirn, prefix=".ai-headroom-", suffix=".json")
try:
    with io.open(fd, "w", encoding="utf-8") as fh:
        json.dump(d, fh, indent=2)
        fh.write("\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, p)
except BaseException:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
  prune_backups "$SETTINGS"
}

# ---------------------------------------------------------------------------
# Windows: the persistent USER environment variable. This is the real switch on
# Windows — every newly launched Claude inherits it. Changing it does NOT affect
# already-running processes, hence the "fully quit and reopen" instruction.
# ---------------------------------------------------------------------------

is_windows() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac; }

PS=""
if is_windows; then
  for c in powershell pwsh; do command -v "$c" >/dev/null 2>&1 && { PS="$c"; break; }; done
  [ -n "$PS" ] || die "ai-headroom: PowerShell not found on PATH; cannot read or set the
persistent user environment variable that Claude actually reads on Windows."
fi

winenv_url() {   # prints the persistent USER value, or nothing
  is_windows || return 0
  # Octal codes, not '\r\n': a literal backslash-r here would silently leave the
  # carriage return in place, and every read-back comparison would then fail
  # against a value that looks identical when printed.
  "$PS" -NoProfile -Command "[Environment]::GetEnvironmentVariable('ANTHROPIC_BASE_URL','User')" 2>/dev/null | tr -d '\015\012'
}

winenv_set() {   # winenv_set <url|"">  — empty removes the variable
  is_windows || return 0
  local want="$1" verify
  if [ -n "$want" ]; then
    "$PS" -NoProfile -Command "[Environment]::SetEnvironmentVariable('ANTHROPIC_BASE_URL','$want','User')" >/dev/null 2>&1       || die "ai-headroom: failed to set the user environment variable."
  else
    "$PS" -NoProfile -Command "[Environment]::SetEnvironmentVariable('ANTHROPIC_BASE_URL',\$null,'User')" >/dev/null 2>&1       || die "ai-headroom: failed to clear the user environment variable."
  fi
  # Never claim success without reading it back.
  verify="$(winenv_url)"
  [ "$verify" = "$want" ] || die "ai-headroom: wrote the environment variable but read back '''$verify''' (expected '''$want'''). Nothing is guaranteed; fix it in
System Properties -> Environment Variables before relying on this."
  printf 'Windows user environment variable: %s
' "${want:-cleared}"
}

# ---------------------------------------------------------------------------
# Source 2: an "export ANTHROPIC_BASE_URL=" line in ~/.bashrc (the hetz VPS).
# Absent on the Windows machines, where every function below is a no-op.
# ---------------------------------------------------------------------------

DISABLED_TAG='#ai-headroom-off# '   # no regex metacharacters: [ ] would form a character class

bashrc_state() { # -> "on <url>" | "off <url>" | "none"
  [ -f "$BASHRC" ] || { printf 'none\n'; return 0; }
  local live disabled
  live="$(grep -oE '^[[:space:]]*export[[:space:]]+ANTHROPIC_BASE_URL=[^[:space:]]+' "$BASHRC" 2>/dev/null | tail -1 || true)"
  if [ -n "$live" ]; then
    printf 'on %s\n' "${live#*=}"
    return 0
  fi
  disabled="$(grep -oE "^${DISABLED_TAG}export[[:space:]]+ANTHROPIC_BASE_URL=[^[:space:]]+" "$BASHRC" 2>/dev/null | tail -1 || true)"
  if [ -n "$disabled" ]; then
    printf 'off %s\n' "${disabled#*=}"
    return 0
  fi
  printf 'none\n'
}

bashrc_set() { # bashrc_set on|off
  local want="$1" state backup
  state="$(bashrc_state)"

  # No line at all + we want it ON => ADD it. The previous version returned
  # success here and printed "Proxy ON" while changing nothing, so a fresh
  # Ubuntu machine silently kept talking straight to Anthropic. An action that
  # reports success must have acted.
  if [ "$state" = none ]; then
    [ "$want" = on ] || return 0
    # Windows: the registry variable is the switch. Do NOT also plant an export
    # in Git Bash's .bashrc -- it would only cover shells started from Git Bash,
    # and leaves a second source to forget about later.
    is_windows && return 0
    [ -f "$BASHRC" ] || { : > "$BASHRC"; }
    backup="$BASHRC.bak-$(date +%Y%m%d-%H%M%S)-$$"
    cp "$BASHRC" "$backup"; chmod 600 "$backup" 2>/dev/null || true
    printf 'Backup: %s
' "$backup"
    # It MUST go above the stock Debian non-interactive guard. Claude Code SSH
    # sessions run non-interactive shells; anything below the guard never runs,
    # which is exactly how this proxy sat unused for nine days.
    if grep -qE '^[[:space:]]*\*\)[[:space:]]*return;;' "$BASHRC" 2>/dev/null        || grep -qE '^case \$- in' "$BASHRC" 2>/dev/null; then
      "$PY" - "$BASHRC" "$PROXY_URL" <<'PY' || die "ai-headroom: failed to edit $BASHRC. Unchanged; backup above."
import io, os, sys
p, url = sys.argv[1], sys.argv[2]
NL = chr(10)
lines = io.open(p, encoding="utf-8", errors="surrogateescape").read().split(NL)
block = [
  "# Headroom token-compression proxy (managed by ai-headroom).",
  "# MUST stay above the non-interactive guard: Claude Code SSH sessions run a",
  "# NON-interactive shell and never reach anything below it.",
  "export ANTHROPIC_BASE_URL=" + url,
  "",
]
idx = next((i for i, l in enumerate(lines) if l.startswith("case $- in")), 0)
lines[idx:idx] = block
tmp = p + ".tmp"
io.open(tmp, "w", encoding="utf-8", errors="surrogateescape", newline=NL).write(NL.join(lines))
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY
    else
      printf '# Headroom token-compression proxy (managed by ai-headroom).
export ANTHROPIC_BASE_URL=%s
' "$PROXY_URL" >> "$BASHRC"
    fi
    bash -n "$BASHRC" || die "ai-headroom: the edit left $BASHRC invalid. Restore: cp '$backup' '$BASHRC'"
    [ "$(bashrc_state)" = "on $PROXY_URL" ] || die "ai-headroom: added the export to $BASHRC but cannot read it back. Restore: cp '$backup' '$BASHRC'"
    prune_backups "$BASHRC"
    printf 'Shell startup export added to %s
' "$BASHRC"
    return 0
  fi

  case "$state" in "$want "*) return 0 ;; esac

  backup="$BASHRC.bak-$(date +%Y%m%d-%H%M%S)-$$"
  cp "$BASHRC" "$backup"; chmod 600 "$backup" 2>/dev/null || true
  printf 'Backup: %s
' "$backup"
  if [ "$want" = off ]; then
    sed -i "s|^[[:space:]]*export[[:space:]]\{1,\}ANTHROPIC_BASE_URL=|${DISABLED_TAG}export ANTHROPIC_BASE_URL=|" "$BASHRC"
  else
    sed -i "s|^[[:space:]]*${DISABLED_TAG}export[[:space:]]\{1,\}ANTHROPIC_BASE_URL=|export ANTHROPIC_BASE_URL=|" "$BASHRC"
  fi
  bash -n "$BASHRC" || die "ai-headroom: the edit left $BASHRC syntactically invalid.
Restore it with:  cp '$backup' '$BASHRC'"
  # Read back: never report a change we cannot see.
  case "$(bashrc_state)" in
    "$want "*) : ;;
    *) die "ai-headroom: edited $BASHRC but it is still not '$want'. Restore: cp '$backup' '$BASHRC'" ;;
  esac
  prune_backups "$BASHRC"
  printf 'Shell startup export in %s: %s
' "$BASHRC" "$want"
}

# ---------------------------------------------------------------------------
# Source 3: Claude Code remote workers on the hetz VPS (~/.claude/remote/ccd-cli).
# The claude-ssh launcher spawns each worker with
# ANTHROPIC_BASE_URL=https://api.anthropic.com, which sends those sessions
# straight to Anthropic and bypasses Headroom no matter what .bashrc says.
# Measured on hetz 2026-10-20: every ccd-cli process had that value in its
# environ and held TLS connections to api.anthropic.com, while a fresh CLI from
# a shell (which inherits the .bashrc export) routed through :8787.
#
# The only lever we control is the executable path the launcher execs. We move
# the real binary aside and install a tiny wrapper that forces the proxy URL,
# then execs the real one. Running workers keep their old inode, so nothing
# live is killed — new spawns pick up the wrapper.
# ---------------------------------------------------------------------------

CCD_DIR="${AI_HEADROOM_CCD_DIR:-$HOME/.claude/remote/ccd-cli}"
CCD_REAL_SUFFIX=".headroom-real"
# Claude Desktop (Linux) installs its Claude Code as <ver>/<hash>/claude and
# also forces ANTHROPIC_BASE_URL=https://api.anthropic.com on it. Each Desktop
# update drops a new version that bypasses the proxy until it is wrapped.
DESKTOP_CC_DIR="${AI_HEADROOM_DESKTOP_CC_DIR:-$HOME/.config/Claude/claude-code}"
CCD_MARK="# Managed by ai-headroom"

is_elf() {
  # od is POSIX; `file` is not installed on the VPS.
  local h
  h="$(dd if="$1" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  [ "$h" = "7f454c46" ]
}

is_ccd_wrapper() {
  [ -f "$1" ] && head -n 1 "$1" 2>/dev/null | grep -q '^#!/' && grep -qF "$CCD_MARK" "$1" 2>/dev/null
}

ccd_wrap_one() { # ccd_wrap_one <path>
  local bin="$1" real tmp
  real="$bin$CCD_REAL_SUFFIX"
  if is_ccd_wrapper "$bin"; then
    # Re-wrap: rewrite the baked URL in place.
    :
  elif is_elf "$bin"; then
    [ -e "$real" ] && die "ai-headroom: $real already exists and $bin is still a raw binary. Refusing to overwrite a recovery copy."
    mv "$bin" "$real" || die "ai-headroom: could not move $bin aside."
    chmod +x "$real" 2>/dev/null || true
  else
    return 0
  fi
  tmp="$bin.wrap-tmp.$$"
  cat > "$tmp" <<EOF
#!/usr/bin/env bash
$CCD_MARK
# Claude Code remote launchers spawn this binary with ANTHROPIC_BASE_URL set to
# https://api.anthropic.com, which bypasses the Headroom proxy. Force the proxy
# URL, then exec the real binary. Re-run "ai-headroom on" after a Claude Code
# update drops a new version into this directory.
export ANTHROPIC_BASE_URL='$PROXY_URL'
exec "\$(dirname "\$0")/\$(basename "\$0")$CCD_REAL_SUFFIX" "\$@"
EOF
  chmod 755 "$tmp" || { rm -f "$tmp"; die "ai-headroom: could not chmod wrapper"; }
  mv "$tmp" "$bin" || { rm -f "$tmp"; die "ai-headroom: could not install wrapper at $bin"; }
}

ccd_unwrap_one() { # ccd_unwrap_one <path>
  local bin="$1" real
  real="$bin$CCD_REAL_SUFFIX"
  is_ccd_wrapper "$bin" || return 0
  [ -e "$real" ] || { rm -f "$bin"; return 0; }
  rm -f "$bin" || die "ai-headroom: could not remove wrapper $bin"
  mv "$real" "$bin" || die "ai-headroom: could not restore $real"
  chmod +x "$bin" 2>/dev/null || true
}

ccd_candidates() { # every launcher-execed Claude Code binary path on this host
  local f
  if [ -d "$CCD_DIR" ]; then
    for f in "$CCD_DIR"/*; do printf '%s\n' "$f"; done
  fi
  if [ -d "$DESKTOP_CC_DIR" ]; then
    for f in "$DESKTOP_CC_DIR"/*/*/claude; do
      # Desktop writes .verified only after the download finishes; never touch
      # a half-written binary.
      [ -e "$(dirname "$f")/.verified" ] && printf '%s\n' "$f"
    done
  fi
}

ccd_wrap_all() {
  local f n=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in *"$CCD_REAL_SUFFIX") continue ;; esac
    if is_ccd_wrapper "$f" || is_elf "$f"; then
      ccd_wrap_one "$f"
      n=$((n + 1))
    fi
  done < <(ccd_candidates)
  [ "$n" -gt 0 ] && printf 'Claude remote workers : wrapped %s binary(ies)\n' "$n"
  return 0
}

ccd_unwrap_all() {
  local f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in *"$CCD_REAL_SUFFIX") continue ;; esac
    ccd_unwrap_one "$f"
  done < <(ccd_candidates)
}

ccd_wrap_status() {
  local f wrapped=0 raw=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in *"$CCD_REAL_SUFFIX") continue ;; esac
    if is_ccd_wrapper "$f"; then wrapped=$((wrapped + 1))
    elif is_elf "$f"; then raw=$((raw + 1))
    fi
  done < <(ccd_candidates)
  if [ "$wrapped" -gt 0 ] && [ "$raw" -eq 0 ]; then
    printf 'Claude remote workers : %s wrapped -> Headroom   (new spawns only)\n' "$wrapped"
  elif [ "$raw" -gt 0 ] && [ "$wrapped" -eq 0 ]; then
    printf 'Claude remote workers : %s UNWRAPPED -> DIRECT to Anthropic   <- gap\n' "$raw"
    printf '  Run "ai-headroom on" (or "ai-headroom wrap-remote") after any Claude update.\n'
  elif [ "$raw" -gt 0 ]; then
    printf 'Claude remote workers : %s wrapped, %s still DIRECT (new Claude version?)\n' "$wrapped" "$raw"
    printf '  Re-run "ai-headroom on" to wrap the new binary.\n'
  fi
}

# Desktop updates arrive silently, so on a Linux desktop a systemd user timer
# re-runs wrap-remote every few minutes. Idempotent; a no-op once wrapped.
AUTOWRAP_UNIT="ai-headroom-autowrap"

autowrap_set() { # autowrap_set on|off
  local dir="$HOME/.config/systemd/user" self
  is_windows && return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  if [ "$1" = on ]; then
    # Only "on" needs Desktop; "off" must clean up the timer even after Desktop is gone.
    [ -d "$DESKTOP_CC_DIR" ] || return 0
    self="$(readlink -f "$0")"
    mkdir -p "$dir" || die "ai-headroom: could not create $dir"
    printf '[Unit]\nDescription=Re-wrap Claude Desktop Claude Code through Headroom\n\n[Service]\nType=oneshot\nExecStart=%s wrap-remote\n' "$self" > "$dir/$AUTOWRAP_UNIT.service"
    printf '[Unit]\nDescription=Re-wrap Claude Code after Desktop updates\n\n[Timer]\nOnBootSec=1min\nOnUnitActiveSec=5min\n\n[Install]\nWantedBy=timers.target\n' > "$dir/$AUTOWRAP_UNIT.timer"
    systemctl --user daemon-reload && systemctl --user enable --now "$AUTOWRAP_UNIT.timer" >/dev/null 2>&1 \
      || die "ai-headroom: could not enable $AUTOWRAP_UNIT.timer"
    printf 'Desktop auto-rewrap    : on (every 5 min)\n'
  else
    local i
    systemctl --user disable --now "$AUTOWRAP_UNIT.timer" >/dev/null 2>&1 || true
    # Never trust a silent failure: the timer must be confirmed inactive.
    if systemctl --user is-active --quiet "$AUTOWRAP_UNIT.timer" 2>/dev/null; then
      die "ai-headroom: $AUTOWRAP_UNIT.timer is still active; not unwrapping"
    fi
    # A rewrap already running is left to finish (killing it mid-move could
    # strand a binary); wait (60s by default), and refuse to continue if it persists.
    for i in $(seq "${AI_HEADROOM_AUTOWRAP_WAIT:-60}"); do
      systemctl --user is-active --quiet "$AUTOWRAP_UNIT.service" 2>/dev/null || break
      sleep 1
    done
    if systemctl --user is-active --quiet "$AUTOWRAP_UNIT.service" 2>/dev/null; then
      die "ai-headroom: $AUTOWRAP_UNIT.service is still running; not unwrapping"
    fi
    rm -f "$dir/$AUTOWRAP_UNIT.service" "$dir/$AUTOWRAP_UNIT.timer"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
}

# ---------------------------------------------------------------------------

action="${1:-status}"
case "$action" in
  status)
    if is_windows; then
      wv="$(winenv_url)"
      if [ -n "$wv" ]; then
        printf 'Windows user env var   : routes through %s   <- THE REAL SWITCH
' "$wv"
      else
        printf 'Windows user env var   : not set -> DIRECT to Anthropic   <- THE REAL SWITCH
'
      fi
    fi
    brc="$(bashrc_state)"
    case "$brc" in
      none)   is_windows || printf 'Shell startup (.bashrc): no redirect present   <- THE REAL SWITCH
' ;;
      on\ *)  printf 'Shell startup (.bashrc): routes through %s   <- THE REAL SWITCH
' "${brc#on }" ;;
      off\ *) printf 'Shell startup (.bashrc): disabled by ai-headroom
' ;;
    esac
    ccd_wrap_status
    cur="$(json_url)" || die "ai-headroom: could not read $SETTINGS."
    if [ -n "$cur" ]; then
      printf 'settings.json          : has %s -- IGNORED by Claude, run "ai-headroom on" or "off" to remove it
' "$cur"
    fi
    # The persistent setting is what NEW processes inherit -- but this very shell
    # may already carry a different value, and anything launched from it inherits
    # THAT. Codex flagged this: status could say "direct" while the terminal the
    # user relaunches Claude from still exports the proxy. Show both.
    eff="${ANTHROPIC_BASE_URL:-}"
    persisted="${wv:-}"
    if [ -z "$persisted" ] && [ "${brc%% *}" = on ]; then persisted="${brc#on }"; fi
    if [ "$eff" != "$persisted" ]; then
      printf 'THIS shell inherits    : %s
' "${eff:-(not set)}"
      printf '  ^ differs from the persistent setting above. Anything launched from THIS
'
      printf '    shell inherits this value. Open a NEW terminal to pick up the change.
'
    fi
    if [ "$PROXY_URL_MISSING" = 1 ]; then
      printf 'Proxy health           : UNKNOWN -- the proxy address is not configured
'
      printf '  This machine has no protected config, so I cannot tell whether the
'
      printf '  proxy is up. This is NOT a network problem. Fix with:
'
      printf '      ai-private-config sync
'
    elif [ "$HAVE_CURL" != 1 ]; then
      printf 'Proxy health           : UNKNOWN (curl not on PATH, cannot check)
'
    elif proxy_healthy; then
      printf 'Proxy health           : reachable and healthy.
'
    else
      printf 'Proxy health           : NOT REACHABLE.
'
      if [ -n "${wv:-}" ] || [ "${brc%% *}" = on ]; then
        printf 'Claude WILL FAIL to connect. Run:  ai-headroom off
'
      fi
    fi
    printf 'Changes apply only to Claude sessions started AFTER this point.
'
    ;;
  on)
    [ -n "$PROXY_URL" ] || die "ai-headroom: protected proxy topology is unavailable; run: ai-private-config sync"
    [ "$HAVE_CURL" = 1 ] || die "ai-headroom: curl not found on PATH, so I cannot verify the
proxy is answering before pointing Claude at it. Refusing to guess. (\`ai-headroom off\`
still works without curl.)"
    proxy_healthy || die "Refusing to enable: the proxy is not answering at $PROXY_URL.
Turning it on now would leave Claude unable to connect at all."
    winenv_set "$PROXY_URL"
    bashrc_set on
    ccd_wrap_all
    autowrap_set on
    # Capture first: a `die` inside $( ) only kills the subshell, so
    # `[ -n "$(json_url)" ]` silently swallowed a fatal read error and the branch
    # went on to print success. Assign, check status, then act.
    stale="$(json_url)" || die "ai-headroom: could not read $SETTINGS; refusing to claim success."
    [ -n "$stale" ] && json_set ""   # drop the inert, misleading entry
    printf 'Proxy ON  -> %s
' "$PROXY_URL"
    printf 'Now fully quit Claude (tray icon -> Quit) and reopen it. Already-running
'
    printf 'sessions keep their old setting until they are restarted.
'
    ;;
  off)
    winenv_set ""
    bashrc_set off
    autowrap_set off
    ccd_unwrap_all
    stale="$(json_url)" || die "ai-headroom: could not read $SETTINGS; refusing to claim success."
    [ -n "$stale" ] && json_set ""
    printf 'Proxy OFF -> Claude goes straight to Anthropic.
'
    printf 'Now fully quit Claude (tray icon -> Quit) and reopen it. Already-running
'
    printf 'sessions keep their old setting until they are restarted.
'
    ;;
  wrap-remote)
    [ -n "$PROXY_URL" ] || die "ai-headroom: protected proxy topology is unavailable; run: ai-private-config sync"
    ccd_wrap_all
    ccd_wrap_status
    printf 'New Claude remote workers will route through Headroom. Existing ones keep
'
    printf 'their current path until that session restarts.
'
    ;;
  unwrap-remote)
    # Stop the auto-rewrap timer first, or it re-wraps within five minutes.
    autowrap_set off
    ccd_unwrap_all
    ccd_wrap_status
    ;;
  *)
    die "Usage: ai-headroom [status|on|off|wrap-remote|unwrap-remote]"
    ;;
esac
