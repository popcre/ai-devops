#!/usr/bin/env bash
# ai-gh-app-auth — short-lived GitHub App installation token for background work.
#
# WHY THIS EXISTS. Every AI helper and every scheduled BlockerWatch tick used
# Albert's personal login, so they shared ONE hourly GitHub allowance (5,000
# REST requests, 5,000 GraphQL points). On 2026-09-28 it ran out and all GitHub
# work stopped for about an hour. The GitHub App "pop-ai-watchers" (app id
# 5112061, installed on popcre and u2giants) has its own allowance per
# installation, so scheduled background reads no longer spend the allowance
# that interactive sessions need.
#
# Usage:
#   ai-gh-app-auth token <owner>   print an installation token for <owner> on stdout
#                                   (for a pipe or GH_TOKEN only; never log it)
#   ai-gh-app-auth install         copy the app private key from 1Password
#                                   (vibe_coding / "GitHub App - pop-ai-watchers")
#                                   into this machine's protected key file
#   ai-gh-app-auth status          say whether this machine is set up (no secrets)
#   ai-gh-app-auth context <owner> print only a locally verified App context
#                                   for the exact selected GH_TOKEN; no network
#
# Exit status: 0 ok; 3 this machine has no app key (callers fall back to the
# personal login, so nothing stops); 1 any other failure.
#
# Environment:
#   AI_GH_APP_DIR   key and token cache (default ~/.ai-devops/github-app)
#   AI_GH_APP_ID    app id (default 5112061)
set -euo pipefail
umask 077

DIR="${AI_GH_APP_DIR:-${HOME:?}/.ai-devops/github-app}"
APP_ID="${AI_GH_APP_ID:-5112061}"
KEY="$DIR/pop-ai-watchers.pem"
API="https://api.github.com"
OP_ITEM="GitHub App - pop-ai-watchers"

say(){ printf 'ai-gh-app-auth: %s\n' "$*" >&2; }
b64url(){ openssl base64 -A | tr '+/' '-_' | tr -d '='; }

jwt(){
  local now head body
  now="$(date +%s)"
  head="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  body="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$APP_ID" | b64url)"
  printf '%s.%s.%s' "$head" "$body" "$(printf '%s.%s' "$head" "$body" | openssl dgst -sha256 -sign "$KEY" | b64url)"
}

# App-authenticated calls (JWT) are not counted against any user allowance.
# JWTs arrive only through stdin and continue through an anonymous pipe to
# curl's config reader; process arguments and diagnostics contain no value.
app_request(){
  local method="$1" route="$2" jwt_value extra
  case "$method:$route" in
    GET:users/*/installation) [[ "$route" =~ ^users/[A-Za-z0-9-]+/installation$ ]] || return 1 ;;
    POST:app/installations/*/access_tokens) [[ "$route" =~ ^app/installations/[0-9]{1,20}/access_tokens$ ]] || return 1 ;;
    *) return 1 ;;
  esac
  IFS= read -r jwt_value || return 1
  if IFS= read -r extra || [ -n "${extra:-}" ]; then return 1; fi
  [[ "$jwt_value" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]] || return 1
  if [ "$method" = POST ]; then
    printf 'header = "Authorization: Bearer %s"\n' "$jwt_value" |
      curl -q --config - -fsS --max-time 20 -X POST -H 'Accept: application/vnd.github+json' "$API/$route"
  else
    printf 'header = "Authorization: Bearer %s"\n' "$jwt_value" |
      curl -q --config - -fsS --max-time 20 -H 'Accept: application/vnd.github+json' "$API/$route"
  fi
}
app_get(){ app_request GET "$1"; }
app_post(){ app_request POST "$1"; }

# Optional read sharing is Linux-qualified. These checks add no requirement to
# the existing token command: missing/legacy/insecure metadata only disables
# sharing, never token selection, minting or personal fallback.
context_private_path(){
  local path="$1" mode="$2" details
  [ ! -L "$path" ] || return 1
  if [ "$mode" = 700 ]; then [ -d "$path" ] || return 1
  else [ -f "$path" ] && [ "$(stat -c %s "$path" 2>/dev/null)" -le 65536 ] || return 1; fi
  details="$(stat -c '%u %a' "$path" 2>/dev/null)" || return 1
  [ "$details" = "$(id -u) $mode" ]
}

save_context_metadata()(
  # installation, response and tok remain in cmd_token's shell scope. Neither
  # the token nor response body becomes an external command argument.
  local owner="$1" token_hash metadata temporary=""
  trap '[ -z "$temporary" ] || rm -f -- "$temporary"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  [ "$(uname -s)" = Linux ] && context_private_path "$DIR" 700 || return 1
  context_private_path "$DIR/token-$owner" 600 || return 1
  # Invalidate older binding before parsing the new response, including the
  # unlikely case that a provider repeats token bytes with changed scope.
  if [ -e "$DIR/context-$owner" ] || [ -L "$DIR/context-$owner" ]; then
    context_private_path "$DIR/context-$owner" 600 || return 1
  fi
  temporary="$(mktemp "$DIR/context-$owner.XXXXXX")" || return 1
  if ! printf '{"schema":0}\n' > "$temporary" || ! mv -f -- "$temporary" "$DIR/context-$owner"; then
    rm -f -- "$temporary"; return 1
  fi
  token_hash="$(printf '%s' "$tok" | sha256sum | cut -d' ' -f1)" || return 1
  metadata="$(printf '%s\n%s\n' "$installation" "$response" | jq -ecs --arg owner "$owner" --arg app "$APP_ID" --arg hash "$token_hash" '
    .[0] as $i | .[1] as $t |
    select(($i.id|type)=="number" and $i.id>0 and ($i.id|floor)==$i.id and
      ($i.app_id|tostring)==$app and ($i.account.login|ascii_downcase)==$owner and
      ($t.expires_at|type)=="string" and ($t.permissions|type)=="object" and
      ($t.permissions|to_entries|all(.[]; (.key|test("^[a-z_]+$")) and (.value=="read" or .value=="write"))) and
      ($t.repository_selection=="all" or $t.repository_selection=="selected")) |
    {schema:1,host:"github.com",owner:$owner,app_id:$i.app_id,installation_id:$i.id,
     expires_epoch:($t.expires_at|fromdateiso8601),permissions:$t.permissions,
     repository_selection:$t.repository_selection,
     repository_ids:(if $t|has("repositories") then ($t.repositories|map(.id)|sort|unique) else null end),
     token_sha256:$hash}' 2>/dev/null)" || return 1
  temporary="$(mktemp "$DIR/context-$owner.XXXXXX")" || return 1
  if ! printf '%s\n' "$metadata" > "$temporary"; then rm -f -- "$temporary"; return 1; fi
  # A foreign metadata path is preserved. Token behavior remains unchanged.
  context_private_path "$DIR/context-$owner" 600 || { rm -f -- "$temporary"; return 1; }
  mv -f -- "$temporary" "$DIR/context-$owner"
)

cmd_context(){
  local owner="${1:-}" exp tok extra hash canonical now
  [[ "$owner" =~ ^[A-Za-z0-9-]+$ ]] && [ "${GH_HOST:-github.com}" = github.com ] &&
    [ -n "${GH_TOKEN:-}" ] && [ "$(uname -s)" = Linux ] || return 1
  owner="${owner,,}"
  context_private_path "$DIR" 700 && context_private_path "$DIR/token-$owner" 600 &&
    context_private_path "$DIR/context-$owner" 600 || return 1
  read -r exp tok extra < "$DIR/token-$owner" || return 1
  [[ "$exp" =~ ^[0-9]{1,12}$ ]] && [ -z "${extra:-}" ] && [ "$tok" = "$GH_TOKEN" ] || return 1
  now="$(date +%s)"; [ "$exp" -gt "$now" ] || return 1
  hash="$(printf '%s' "$GH_TOKEN" | sha256sum | cut -d' ' -f1)" || return 1
  canonical="$(jq -ecS --arg owner "$owner" --arg app "$APP_ID" --arg hash "$hash" --argjson now "$now" '
    select(keys==["app_id","expires_epoch","host","installation_id","owner","permissions","repository_ids","repository_selection","schema","token_sha256"] and
      .schema==1 and .host=="github.com" and .owner==$owner and (.app_id|tostring)==$app and
      (.installation_id|type)=="number" and .installation_id>0 and (.installation_id|floor)==.installation_id and
      (.expires_epoch|type)=="number" and .expires_epoch>$now and (.expires_epoch|floor)==.expires_epoch and
      .token_sha256==$hash and (.permissions|type)=="object" and
      (.permissions|to_entries|all(.[]; (.key|test("^[a-z_]+$")) and (.value=="read" or .value=="write"))) and
      (.repository_selection=="all" or .repository_selection=="selected") and
      (.repository_ids==null or ((.repository_ids|type)=="array" and (.repository_ids|all(.[]; type=="number" and .>0 and floor==.)))))' "$DIR/context-$owner" 2>/dev/null)" || return 1
  printf 'app-v1:%s\n' "$(printf '%s' "$canonical" | sha256sum | cut -d' ' -f1)"
}

cmd_token(){
  local owner="${1:-}" cache now exp tok J inst installation response
  [[ "$owner" =~ ^[A-Za-z0-9-]+$ ]] || { say "usage: token <owner>"; exit 1; }
  [ -f "$KEY" ] || exit 3
  owner="${owner,,}"
  cache="$DIR/token-$owner"
  now="$(date +%s)"
  # Reuse a cached token with at least 10 minutes left (tokens last one hour).
  if [ -f "$cache" ] && read -r exp tok < "$cache" && [ -n "${tok:-}" ] && [ "$exp" -gt $((now + 600)) ]; then
    printf '%s\n' "$tok"; return 0
  fi
  J="$(jwt)" || { say "cannot sign with the app key"; exit 1; }
  installation="$(printf '%s\n' "$J" | app_get "users/$owner/installation")" ||
    { say "app is not installed for $owner"; exit 1; }
  inst="$(printf '%s' "$installation" | jq -r '.id // empty')" || { say "app is not installed for $owner"; exit 1; }
  [ -n "$inst" ] || { say "app is not installed for $owner"; exit 1; }
  response="$(printf '%s\n' "$J" | app_post "app/installations/$inst/access_tokens")" || { say "token request failed for $owner"; exit 1; }
  tok="$(printf '%s' "$response" | jq -r '.token // empty')" || { say "token request failed for $owner"; exit 1; }
  [ -n "$tok" ] || { say "token request returned nothing for $owner"; exit 1; }
  printf '%s %s\n' "$((now + 3300))" "$tok" > "$cache.tmp" && mv -f "$cache.tmp" "$cache"
  save_context_metadata "$owner" ||
    say 'optional App read-sharing metadata unavailable; token behavior unchanged'
  printf '%s\n' "$tok"
}

cmd_install(){
  command -v op >/dev/null || { say "1Password CLI (op) is required"; exit 1; }
  mkdir -p "$DIR"; chmod 700 "$DIR"
  # The key moves op -> protected file directly; it is never printed.
  timeout 60 op read "op://vibe_coding/$OP_ITEM/private_key" < /dev/null > "$KEY.tmp" ||
    { rm -f "$KEY.tmp"; say "could not read the key from 1Password"; exit 1; }
  grep -q 'PRIVATE KEY' "$KEY.tmp" || { rm -f "$KEY.tmp"; say "1Password value is not a private key"; exit 1; }
  chmod 600 "$KEY.tmp"; mv -f "$KEY.tmp" "$KEY"
  say "key installed; checking both installations"
  cmd_status
}

cmd_status(){
  [ -f "$KEY" ] || { say "not set up on this machine (run: ai-gh-app-auth install)"; exit 3; }
  local o rc=0
  for o in popcre u2giants; do
    if cmd_token "$o" >/dev/null; then say "$o: ok"; else say "$o: FAILED"; rc=1; fi
  done
  return "$rc"
}

case "${1:-}" in
  token) shift; cmd_token "$@" ;;
  context) shift; cmd_context "$@" ;;
  install) cmd_install ;;
  status) cmd_status ;;
  *) say "usage: ai-gh-app-auth token <owner> | install | status"; exit 1 ;;
esac
