#!/usr/bin/env bash
# ai-memory-health — READ-ONLY audit of Claude Code auto-memory across every project
# on this machine, plus the cross-machine hub state.
#
# It NEVER edits, deletes, or syncs anything. It reports what a human (or the
# consolidate-memory skill) should look at. This is deliberate: a memory deletion
# propagates to every machine through ai-sync-memory's tombstones and cannot be
# undone by a later pull, so unattended pruning is not an acceptable design.
#
# Exit status: 0 = nothing to act on, 1 = findings to review, 2 = usage/setup error.
set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
claude_home=""
out=""
stale_days=180
index_only=0
for_cwd=""
hub_only=0
ignore_sync_state=0
coverage_only=0


usage() {
  cat <<'USAGE'
usage: ai-memory-health [--claude-home DIR] [--repo-root DIR] [--out FILE] [--stale-days N]

  --claude-home DIR  Claude home to audit (default: $USERPROFILE/.claude on Windows,
                     $HOME/.claude elsewhere).
  --repo-root DIR    ai-devops checkout whose hub sync state is reported (default: the
                     checkout this script lives in).
  --out FILE         Also write the report to FILE (parent directory must exist).
  --stale-days N     Flag memories untouched for more than N days (default 180).
  --index-only       Only check index coverage (memories missing from MEMORY.md,
                     index lines pointing at missing files, a missing index). Fast
                     enough to run from a session hook; skips the slower link,
                     duplicate, size and age checks.
  --hub-only         Audit the canonical memory directories under --repo-root
                     instead of this machine's Claude project directories.
  --ignore-sync-state
                     Do not treat uncommitted hub changes as a finding. Intended
                     for the pre-commit health gate inside ai-memory-sync.
  --coverage-only    Check only missing indexes, missing index entries, and
                     broken index targets. Implies --index-only.
  --for-cwd DIR      Implies --index-only and audits ONLY the project whose memory
                     folder corresponds to DIR (the working directory of a session).
                     Silent and exit 0 when that project has no memory yet.
USAGE
}

while (($#)); do
  case "$1" in
    --claude-home) claude_home="$2"; shift 2 ;;
    --repo-root) repo_root="$2"; shift 2 ;;
    --index-only) index_only=1; shift ;;
    --hub-only) hub_only=1; shift ;;
    --ignore-sync-state) ignore_sync_state=1; shift ;;
    --coverage-only) coverage_only=1; index_only=1; shift ;;
    --for-cwd) for_cwd="$2"; index_only=1; shift 2 ;;
    --out) out="$2"; shift 2 ;;
    --stale-days) stale_days="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z "$claude_home" ]]; then
  case "${OSTYPE:-}" in
    msys*|cygwin*)
      profile="${USERPROFILE:-}"
      [[ -n "$profile" ]] || { echo "ERROR USERPROFILE is unset" >&2; exit 2; }
      command -v cygpath >/dev/null 2>&1 && profile="$(cygpath -u "$profile")"
      claude_home="$profile/.claude" ;;
    *) claude_home="$HOME/.claude" ;;
  esac
fi

projects_dir="$claude_home/projects"
if (( ! hub_only )); then
  [[ -d "$projects_dir" ]] || { echo "ERROR no Claude projects directory at $projects_dir" >&2; exit 2; }
fi

findings=0
report="$(mktemp)"
trap 'rm -f "$report"' EXIT

note()  { printf '  - %s\n' "$1" >> "$report"; findings=$((findings + 1)); }
head1() { printf '\n## %s\n\n' "$1" >> "$report"; }

{
  printf '# Memory health report\n\n'
  printf 'Machine: %s\n' "$(hostname)"
  printf 'Claude home: %s\n' "$claude_home"
  printf 'Generated: %s\n' "$(date -u '+%Y-%m-%dT%H:%MZ')"
  printf '\nThis report changes nothing. To act on it, open a Claude Code session in the\n'
  printf 'affected project and say "consolidate my memory".\n'
} > "$report"

total_files=0
total_projects=0
total_index_bytes=0

if (( hub_only )); then
  project_glob=("$repo_root"/memory/*)
else
  project_glob=("$projects_dir"/*/memory)
fi
if [[ -n "$for_cwd" ]]; then
  # Claude names a project folder after its absolute path, replacing the drive
  # colon and every separator with a dash. That is why the drive letter is
  # followed by two dashes: the colon becomes one and the separator the other.
  abs="$(cd "$for_cwd" 2>/dev/null && pwd -W 2>/dev/null || (cd "$for_cwd" 2>/dev/null && pwd))"
  [[ -n "$abs" ]] || exit 0
  slug="${abs//:/-}"
  slug="${slug//\\//-}"
  slug="${slug//\//-}"
  project_glob=("$projects_dir/$slug/memory")
  [[ -d "${project_glob[0]}" ]] || exit 0
fi

for mem in "${project_glob[@]}"; do
  [[ -d "$mem" ]] || continue
  if (( hub_only )); then
    project="$(basename "$mem")"
  else
    project="$(basename "$(dirname "$mem")")"
  fi
  index="$mem/MEMORY.md"
  files=()
  while IFS= read -r f; do files+=("$f"); done < <(find "$mem" -maxdepth 1 -name '*.md' ! -name 'MEMORY.md' -printf '%f\n' 2>/dev/null | sort)
  ((${#files[@]} == 0)) && continue
  total_projects=$((total_projects + 1))
  total_files=$((total_files + ${#files[@]}))
  if [[ -f "$index" ]]; then
    total_index_bytes=$((total_index_bytes + $(wc -c < "$index" | tr -d ' ')))
  fi

  head1 "$project (${#files[@]} memories)"
  before=$findings

  if [[ ! -f "$index" ]]; then
    note "NO INDEX: MEMORY.md is missing, so none of these ${#files[@]} memories load into a session."
  else
    # Memories that exist but are not in the index are invisible to future sessions.
    for f in "${files[@]}"; do
      grep -qF "($f)" "$index" || note "NOT IN INDEX: $f — a future session will never see it."
    done
    # Index lines pointing at files that no longer exist.
    while IFS= read -r target; do
      [[ -f "$mem/$target" ]] || note "BROKEN INDEX LINE: MEMORY.md points at missing $target."
    done < <(grep -oE '\]\([A-Za-z0-9._-]+\.md\)' "$index" 2>/dev/null | sed 's/^](//; s/)$//' | sort -u)

    # The index size check runs in EVERY mode, including --coverage-only,
    # because that is the mode `bin/ai-memory-sync` gates on. Before
    # 2026-08-26 the limit existed but only ever fired in a manual or weekly
    # full run, so an index could grow past it for weeks without blocking a
    # single sync.
    #
    # Deliberately NOT done: making the sync gate run the FULL check. Health
    # exits nonzero on ANY finding, and three harmless dangling cross-links
    # exist today, so a full gate would have blocked memory sync on every
    # machine — trading a size warning for a broken sync. Only this moved.
    #
    # 12KB, lowered from 25KB on 2026-08-26: every real index measured
    # between 1KB and 9.3KB, so the old limit allowed 2.7x growth in silence.
    lines="$(wc -l < "$index" | tr -d ' ')"
    bytes="$(wc -c < "$index" | tr -d ' ')"
    (( lines > 200 ))   && note "INDEX TOO LONG: $lines lines (limit 200) - it is loaded every session."
    (( bytes > 12288 )) && note "INDEX TOO BIG: $bytes bytes (limit 12KB) - it is loaded every session, so this is a per-session cost on every machine."
  fi

  if (( index_only )); then
    (( findings == before )) && printf '  - clean
' >> "$report"
    continue
  fi

  # Cross-links that point at a memory which does not exist.
  while IFS= read -r link; do
    [[ -f "$mem/$link.md" ]] || note "DANGLING LINK: [[$link]] has no matching memory file."
  done < <(grep -rhoE '\[\[[A-Za-z0-9._-]+\]\]' "$mem" 2>/dev/null | tr -d '[]' | sort -u)

  # Structural hygiene.
  for f in "${files[@]}"; do
    head -1 "$mem/$f" | grep -q '^---$' || note "NO FRONTMATTER: $f — type and description are missing."
    (( $(wc -c < "$mem/$f") > 8192 )) && note "OVERSIZED: $f is $(wc -c < "$mem/$f") bytes; one memory should hold one fact."
  done

  # Possible duplicates: two memories whose descriptions share a lot of wording.
  while IFS= read -r dup; do
    note "POSSIBLE DUPLICATE: $dup"
  done < <(
    for f in "${files[@]}"; do
      d="$(sed -n 's/^description:[[:space:]]*//p' "$mem/$f" | head -1 | tr -d '"' | tr 'A-Z' 'a-z')"
      [[ -n "$d" ]] && printf '%s\t%s\n' "$f" "$d"
    done | awk -F'\t' '
      { file[NR]=$1; desc[NR]=$2; n=NR }
      END {
        for (i=1;i<=n;i++) for (j=i+1;j<=n;j++) {
          split(desc[i],a," "); split(desc[j],b," "); shared=0; total=0
          for (k in a) if (length(a[k])>5) { total++; for (m in b) if (a[k]==b[m]) { shared++; break } }
          if (total>=4 && shared/total>=0.5) printf "%s and %s describe overlapping facts\n", file[i], file[j]
        }
      }')

  # Age. Not a reason to delete — a reason to check the fact still holds.
  while IFS= read -r f; do
    note "UNTOUCHED >${stale_days}d: $f — confirm it is still true."
  done < <(find "$mem" -maxdepth 1 -name '*.md' ! -name 'MEMORY.md' -mtime "+$stale_days" -printf '%f\n' 2>/dev/null | sort)

  (( findings == before )) && printf '  - clean\n' >> "$report"
done

head1 "Cross-machine sync"
if (( ignore_sync_state )); then
  printf '  - sync-state check intentionally deferred to transaction owner\n' >> "$report"
elif [[ -d "$repo_root/memory" ]]; then
  if git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1; then
    behind="$(git -C "$repo_root" rev-list --count HEAD..@{u} 2>/dev/null || echo '?')"
    dirty="$(git -C "$repo_root" status --porcelain -- memory 2>/dev/null | wc -l | tr -d ' ')"
    printf '  - hub: %s\n' "$repo_root" >> "$report"
    [[ "$behind" != "0" && "$behind" != "?" ]] && note "HUB BEHIND: $behind commit(s) unpulled — run \"sync my dotfiles\"."
    (( dirty > 0 )) && note "UNPUSHED MEMORY: $dirty change(s) staged or untracked under memory/ — run \"sync my dotfiles\"."
    [[ "$behind" == "0" && "$dirty" == "0" ]] && printf '  - in step with the hub\n' >> "$report"
  fi
else
  printf '  - no hub memory directory at %s/memory\n' "$repo_root" >> "$report"
fi

# Trend. One week's totals say nothing; the direction does. The 2026-08-27
# consolidation found single memories forked into dozens of copies and 62
# phantom projects, all of which had been growing for weeks - every weekly
# report listed the symptoms and none showed the trajectory, so nobody read it
# as a problem. Counts are recorded per machine and per mode; a first run says
# so rather than inventing a baseline.
index_kb=$(( (total_index_bytes + 1023) / 1024 ))
trend_state="${AI_MEMORY_HEALTH_STATE:-$HOME/.cache/ai-memory-health.trend}"
trend_key="$(hostname)|$hub_only"
# $3 is an optional unit, appended only when there is a number to attach it to,
# so a flat week reads "index no change" and never "index no changeKB".
delta() {
  local d=$(( $1 - $2 ))
  if   (( d > 0 )); then printf '+%s%s' "$d" "${3:-}"
  elif (( d < 0 )); then printf '%s%s' "$d" "${3:-}"
  else printf 'no change'; fi
}
previous="$(grep -F "$trend_key|" "$trend_state" 2>/dev/null | tail -1)"
if [[ -n "$previous" ]]; then
  prev_date="$(printf '%s' "$previous" | cut -d'|' -f3)"
  prev_projects="$(printf '%s' "$previous" | cut -d'|' -f4)"
  prev_files="$(printf '%s' "$previous" | cut -d'|' -f5)"
  prev_kb=$(( ($(printf '%s' "$previous" | cut -d'|' -f6) + 1023) / 1024 ))
  prev_findings="$(printf '%s' "$previous" | cut -d'|' -f7)"
  trend_line="  - since $prev_date: projects $(delta "$total_projects" "$prev_projects"), files $(delta "$total_files" "$prev_files"), index $(delta "$index_kb" "$prev_kb" KB), findings $(delta "$findings" "$prev_findings")"
else
  trend_line="  - no earlier report to compare against; this run is the baseline"
fi
mkdir -p "$(dirname "$trend_state")" 2>/dev/null || true
printf '%s|%s|%s|%s|%s|%s\n' "$trend_key" "$(date -u '+%Y-%m-%d')" \
  "$total_projects" "$total_files" "$total_index_bytes" "$findings" >> "$trend_state" 2>/dev/null || true

{
  printf '\n## Summary\n\n'
  printf '  - %s project(s), %s memory file(s), %s KB of index loaded per session\n' \
    "$total_projects" "$total_files" "$index_kb"
  printf '  - %s finding(s) to review\n' "$findings"
  printf '%s\n' "$trend_line"
  if (( findings > 0 )); then
    printf '\nNothing was changed. Open Claude Code in the affected project and say\n'
    printf '"consolidate my memory" to act on any of the above.\n'
  fi
} >> "$report"

cat "$report"
if [[ -n "$out" ]]; then cp "$report" "$out"; fi
(( findings > 0 )) && exit 1
exit 0
