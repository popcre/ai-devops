#!/usr/bin/env bash
# ai-review-preflight - fast provider health checks and temporary quarantine.
#
# WHY THIS EXISTS
# A provider that is logged out, out of allowance, or locally unavailable must
# be rejected before it receives a durable review assignment. A failed check is
# not a review attempt. Quarantine prevents the next caller from immediately
# assigning the same unhealthy provider again.
set -euo pipefail

VERSION="1.5.0"
STATE_DIR="${AI_REVIEW_QUARANTINE_DIR:-$HOME/.local/state/ai-devops/review-quarantine}"
CHECK_TIMEOUT="${AI_REVIEW_PREFLIGHT_TIMEOUT:-10}"
# A real live doctor turn (Qwen ~50s, Grok/DeepSeek ~10s on Windows Git Bash) and an
# offline doctor (~10s of process forks on Windows) both outlast the 10s identity
# budget, which recorded false provider-timeout quarantines (2026-10-02). A timeout
# still never means healthy.
LIVE_PROBE_TIMEOUT="${AI_REVIEW_LIVE_PROBE_TIMEOUT:-180}"
DOCTOR_PROBE_TIMEOUT="${AI_REVIEW_DOCTOR_PROBE_TIMEOUT:-30}"
COOLDOWN="${AI_REVIEW_QUARANTINE_SECONDS:-1800}"
# A transient liveness timeout is not a demonstrated safety or identity
# problem. It gets a short cooldown so the next caller can retry quickly,
# instead of the full quarantine that auth/containment failures earn.
TIMEOUT_COOLDOWN="${AI_REVIEW_TIMEOUT_COOLDOWN_SECONDS:-60}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Registry membership is a separate gate from install health. A provider whose
# doctor passes is still unusable if the allocating registry does not carry it.
# bin/* is symlinked onto PATH, so resolve the real script location before
# looking for the repository's config directory; $SCRIPT_DIR is the symlink dir.
REGISTRY_REAL_DIR="$SCRIPT_DIR"
if command -v readlink >/dev/null 2>&1; then
  REGISTRY_REAL_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -z "$REGISTRY_REAL_SOURCE" ] || REGISTRY_REAL_DIR="$(cd "$(dirname "$REGISTRY_REAL_SOURCE")" && pwd)"
fi
REGISTRY_FILE="${AI_REVIEW_REGISTRY_FILE:-}"
if [ -z "$REGISTRY_FILE" ]; then
  for candidate in "$REGISTRY_REAL_DIR/../config/reviewer-registry.json"                    "$SCRIPT_DIR/../config/reviewer-registry.json"                    "${AI_DEVOPS_CONFIG_DIR:-/etc/ai-devops}/reviewer-registry.json"; do
    [ -f "$candidate" ] || continue
    REGISTRY_FILE="$candidate"; break
  done
  [ -n "$REGISTRY_FILE" ] || REGISTRY_FILE="$REGISTRY_REAL_DIR/../config/reviewer-registry.json"
fi
CAPACITY_CONFIG="${AI_REVIEW_CAPACITY_CONFIG:-$REGISTRY_REAL_DIR/../config/reviewer-capacity.json}"
CAPACITY_TIMEOUT="${AI_REVIEW_CAPACITY_TIMEOUT:-}"
CAPACITY_MAX_AGE="${AI_REVIEW_CAPACITY_MAX_AGE:-30}"

die()  { printf 'ai-review-preflight: error: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

valid_provider() { case "$1" in claude|grok|kimi|glm|muse|gemini|qwen|codex|deepseek|stepfun) return 0 ;; *) return 1 ;; esac; }
provider_file() { printf '%s/%s.json' "$STATE_DIR" "$1"; }
qualification_file() { printf '%s/%s-live-qualified.json' "$STATE_DIR" "$1"; }
now_epoch() { date +%s; }

admission_store() {
  local runtime
  runtime="$(command -v python3 || command -v python)" || die 'Python is required for the admission store.'
  "$runtime" "$REGISTRY_REAL_DIR/../tools/reviewer_admission.py" "$@" --directory "$STATE_DIR"
}

kimi_effective_profile() {
  local home="${KIMI_CODE_HOME:-$HOME/.kimi-code}" owner="${AI_KIMI_OWNER:-ai}" as="" candidate binary="" found="" context
  # Only root can use the existing password-free delegation capability. All
  # probes are non-generating, bounded and keep provider configuration private.
  if [ "$(id -u)" = 0 ] && [ "$(id -un)" != "$owner" ]; then
    for candidate in "${AI_KIMI_BIN:-}" "$(command -v kimi 2>/dev/null || true)" "$home/bin/kimi" "$home/bin/kimi.exe" "$HOME/.kimi-code/bin/kimi" /home/ai/.kimi-code/bin/kimi /usr/local/bin/kimi; do
      [ -n "$candidate" ] && [ -x "$candidate" ] || continue
      binary="$candidate"; break
    done
    if [ -n "$binary" ]; then
      found="$(KIMI_CODE_HOME="$home" timeout "${CHECK_TIMEOUT}s" "$binary" provider list 2>/dev/null)" || { case "$?" in 124|137) return 1;; esac; }
    fi
    if [ -z "$found" ] || printf '%s' "$found" | grep -qi 'no providers configured'; then
      # Read the login environment, never infer an account's home pathname.
      # Prefix framing rejects incidental shell startup output.
      context="$(timeout "${CHECK_TIMEOUT}s" su - "$owner" -c 'h=${KIMI_CODE_HOME:-$HOME/.kimi-code}; case "$h" in /*) ;; *) h="$PWD/$h";; esac; p=$(KIMI_CODE_HOME="$h" "$HOME/.kimi-code/bin/kimi" provider list 2>/dev/null) || exit 1; [ -n "$p" ] && ! printf "%s" "$p" | grep -qi "no providers configured" || exit 1; printf "AI_KIMI_HOME=%s\n" "$h"' 2>/dev/null)" || { case "$?" in 124|137) return 1;; esac; }
      if [ -n "$context" ]; then
        case "$context" in AI_KIMI_HOME=*) home="${context#AI_KIMI_HOME=}"; as="$owner";; *) return 1;; esac
        case "$home" in ''|*$'\n'*|*$'\r'*) return 1;; esac
      fi
    fi
  fi
  admission_store profile kimi --home "$home" | jq -ce --arg as "$as" \
    '. + {run_as_user:$as} | select(.credential_profile_scope|test("^[0-9a-f]{64}$"))'
}

default_admission() {
  local profile="${AI_REVIEW_ADMISSION_PROFILE:-}" model="${AI_REVIEW_ADMISSION_MODEL:-}"
  if [ "$1" = kimi ]; then
    [ -n "$profile" ] || profile="$(kimi_effective_profile | jq -er .credential_profile_scope)" || return 1
    [ -n "$model" ] || model="${AI_KIMI_MODEL:-kimi-code/k3}"
  fi
  admission_store admission "$1" --profile "$profile" --model "$model"
}

capacity_unknown() { # PROVIDER REASON [OBSERVED-VERSION] [SOURCE] [QUALIFIED-VERSION]
  jq -nc --arg provider "$1" --arg reason "$2" --arg version "${3:-unknown}" \
    --arg source "${4:-unsupported}" --arg qualified "${5:-}" --arg checked "$(date -u +%FT%TZ)" \
    '{schema_version:1,provider:$provider,state:"unknown",checked_at:$checked,
      provider_version:$version,qualified_version:(if $qualified=="" then null else $qualified end),credential_profile_scope:null,model_scope:null,
      source_kind:$source,reason:$reason,reset_at:null}'
}

validate_capacity_result() { # PROVIDER JSON
  local provider="$1" value="$2" checked_epoch now age expected_profile="${AI_REVIEW_CAPACITY_EXPECTED_PROFILE:-}" expected_model="${AI_REVIEW_CAPACITY_EXPECTED_MODEL:-}"
  printf '%s\n' "$value" | jq -e --arg p "$provider" --arg expected_profile "$expected_profile" --arg expected_model "$expected_model" '
    .schema_version==1 and .provider==$p and
    (.state|IN("available","exhausted","unknown")) and
    (.checked_at|type=="string") and
    (.provider_version|type=="string" and length>0 and length<=128) and
    ((.qualified_version==null) or (.qualified_version|type=="string" and length>0 and length<=128)) and
    ((.credential_profile_scope==null) or (.credential_profile_scope|type=="string" and length>0 and length<=128)) and
    ((.model_scope==null) or (.model_scope|type=="string" and length>0 and length<=128)) and
    (.source_kind|type=="string" and test("^[A-Za-z0-9._-]{1,64}$")) and
    (.reason|type=="string" and IN("reported-capacity","reported-exhaustion","unsupported-interface","unsupported-version","timeout","malformed-response","transport-error","authentication-error","stale-response","wrong-scope","unscopable")) and
    ((.reset_at==null) or (.reset_at|type=="string" and (try fromdateiso8601 catch null)!=null)) and
    (if .state=="available" then .reason=="reported-capacity" and .credential_profile_scope!=null
     elif .state=="exhausted" then .reason=="reported-exhaustion" and .credential_profile_scope!=null
     else true end)' >/dev/null 2>&1 || return 1
  [ -z "$expected_profile" ] || [ "$(printf '%s\n' "$value" | jq -r '.credential_profile_scope // ""')" = "$expected_profile" ] || return 3
  [ -z "$expected_model" ] || [ "$(printf '%s\n' "$value" | jq -r '.model_scope // ""')" = "$expected_model" ] || return 3
  checked_epoch="$(printf '%s\n' "$value" | jq -r '.checked_at|fromdateiso8601' 2>/dev/null)" || return 1
  now="$(now_epoch)"; age=$((now - checked_epoch))
  [ "$age" -ge 0 ] && [ "$age" -le "$CAPACITY_MAX_AGE" ] || return 2
}

capacity_result() { # PROVIDER
  local provider="$1" value="" version="unknown" source="unsupported" reason="unsupported-interface" rc
  valid_provider "$provider" || die "unknown provider '$provider'."
  need jq
  if [ -z "$CAPACITY_TIMEOUT" ]; then
    CAPACITY_TIMEOUT="$(jq -r '.timeout_seconds // 5' "$CAPACITY_CONFIG" 2>/dev/null || printf 5)"
  fi
  case "$CAPACITY_TIMEOUT" in ''|0|*[!0-9]*) die 'capacity timeout must be a positive whole number of seconds.';; esac
  [ "$CAPACITY_TIMEOUT" -le 5 ] || die 'capacity timeout may not exceed five seconds.'

  # Hostile tests inject an already-captured provider response. Production never
  # evaluates a configured command or guesses an endpoint.
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_REVIEW_CAPACITY_TEST_RESPONSE:-}" ]; then
    [ -z "${AI_REVIEW_CAPACITY_TEST_COUNT_FILE:-}" ] || printf 'request\n' >> "$AI_REVIEW_CAPACITY_TEST_COUNT_FILE"
    value="$AI_REVIEW_CAPACITY_TEST_RESPONSE"
    if validate_capacity_result "$provider" "$value"; then rc=0; else rc=$?; fi
    case "$rc" in
      0) printf '%s\n' "$value" | jq -c .; return 0;;
      2) capacity_unknown "$provider" stale-response "$(printf '%s' "$value" | jq -r '.provider_version // "unknown"' 2>/dev/null || printf unknown)" synthetic-fixture; return 0;;
      3) capacity_unknown "$provider" wrong-scope "$(printf '%s' "$value" | jq -r '.provider_version // "unknown"' 2>/dev/null || printf unknown)" synthetic-fixture; return 0;;
      *) capacity_unknown "$provider" malformed-response unknown synthetic-fixture; return 0;;
    esac
  fi

  if [ -f "$CAPACITY_CONFIG" ]; then
    version="$(jq -r --arg p "$provider" '.providers[$p].qualified_version // "unknown"' "$CAPACITY_CONFIG" 2>/dev/null || printf unknown)"
    source="$(jq -r --arg p "$provider" '.providers[$p].source_kind // "unsupported"' "$CAPACITY_CONFIG" 2>/dev/null || printf unsupported)"
    reason="$(jq -r --arg p "$provider" '.providers[$p].reason // "unsupported-interface"' "$CAPACITY_CONFIG" 2>/dev/null || printf unsupported-interface)"
  fi
  value="$(capacity_unknown "$provider" "$reason" unverified "$source" "$version")"
  if validate_capacity_result "$provider" "$value"; then
    printf '%s\n' "$value"
  else
    capacity_unknown "$provider" malformed-response unverified config "$version"
  fi
}
# The live-qualification record is a versioned store keyed by the exact
# installed bytes (wrapper/runtime/preloader hashes; Gemini also model). Each
# version is one live canary that PASSED for those exact bytes. Older
# single-record files are folded into the same array so a toolkit upgrade does
# not throw away the last good approval.
#
# The file keeps its legacy top-level fields as the "selected" view because
# bin/ai-gemini reads only those (it is out of scope to change that wrapper).
# Preflight matches against versions[], then syncs the top-level view to the
# version it selected, so the wrapper and preflight never disagree.
normalize_qualification_versions() { # RAW_JSON -> JSON array
  printf '%s\n' "$1" | jq -c '
    if ((.versions|type)=="array") then [.versions[]]
    elif ((.wrapper_sha256|type)=="string") then [ {
        wrapper_sha256: .wrapper_sha256,
        runtime_sha256: .runtime_sha256,
        preloader_sha256: .preloader_sha256,
        agy_sha256: .agy_sha256,
        agy_version: .agy_version,
        model: .model,
        cli_sha256: .cli_sha256,
        cli_version: .cli_version,
        policy_mode: .policy_mode,
        policy_version: .policy_version,
        qualified_epoch: .qualified_epoch
      } | with_entries(select(.value != null)) ]
    else [] end' 2>/dev/null || printf '[]\n'
}

# qualification_versions PROVIDER prints the provider's stored qualification
# versions as a JSON array. An absent or unreadable record yields [] — never a
# guessed match.
qualification_versions() { # PROVIDER -> JSON array
  local file raw
  file="$(qualification_file "$1")"
  [ -f "$file" ] || { printf '[]\n'; return 0; }
  raw="$(cat "$file" 2>/dev/null)" || { printf '[]\n'; return 0; }
  [ -n "$raw" ] || { printf '[]\n'; return 0; }
  normalize_qualification_versions "$raw"
}

legacy_record_version() { # PROVIDER -> schema number the provider wrapper accepts
  # gemini/qwen wrappers validate their own schema numbers. The pin-bump lane
  # records under schema 1 for every other provider; those wrappers do not read
  # this store (they are not in LIVE_QUALIFIED_PROVIDERS), so the number is
  # evidence metadata only and never a review gate.
  case "$1" in gemini) printf 2 ;; qwen) printf 3 ;; *) printf 1 ;; esac
}

# write_qualification_store PROVIDER VERSIONS_JSON SELECTED_JSON writes the
# versioned store with the legacy top-level view set to SELECTED. VERSIONS []
# removes the record entirely. The candidate goes to a temp file and is moved
# into place only after it validates, so untested bytes are never published.
write_qualification_store() { # PROVIDER VERSIONS_JSON SELECTED_JSON
  local provider="$1" versions="$2" selected="$3" file legacy candidate
  file="$(qualification_file "$provider")"
  if [ -z "$versions" ] || [ "$versions" = "[]" ]; then rm -f "$file"; return 0; fi
  legacy="$(legacy_record_version "$provider")" || return 1
  candidate="$(jq -nc --arg p "$provider" --argjson legacy "$legacy" --argjson versions "$versions" --argjson selected "$selected" \
    '{version:$legacy, provider:$p} + $selected + {versions:$versions}')" || return 1
  printf '%s\n' "$candidate" | jq -e --arg p "$provider" '
    .provider==$p and (.versions|type=="array") and (.versions|length>0)
    and (.wrapper_sha256|type=="string" and test("^[0-9a-f]{64}$"))
    and (.qualified_epoch|type=="number")' >/dev/null 2>&1 || return 1
  write_atomic "$file" "$candidate"
}

# publish_qualification_version PROVIDER PRIOR_VERSIONS_JSON NEW_VERSION_JSON
# appends (or refreshes) one canary-proven version and publishes it atomically.
# PRIOR_VERSIONS must be captured BEFORE the canary: a provider wrapper may
# rewrite the record during its own canary, and the last good approvals have
# to survive that. A failed canary never calls this (issue #1112 — the old
# delete-before-canary revoke-on-fail was the 24-48h quarantine loop).
publish_qualification_version() { # PROVIDER PRIOR_VERSIONS_JSON NEW_VERSION_JSON
  local provider="$1" prior="$2" new_version="$3" versions
  [ -n "$prior" ] || prior='[]'
  versions="$(printf '%s\n' "$prior" | jq -c --argjson new "$new_version" '
    [ .[] | select(
        .wrapper_sha256 != $new.wrapper_sha256
        or ((.runtime_sha256 // "") != ($new.runtime_sha256 // ""))
        or ((.preloader_sha256 // "") != ($new.preloader_sha256 // ""))
        or ((.agy_sha256 // "") != ($new.agy_sha256 // ""))
        or ((.agy_version // "") != ($new.agy_version // ""))
        or ((.model // "") != ($new.model // ""))
        or ((.cli_sha256 // "") != ($new.cli_sha256 // ""))
        or ((.cli_version // "") != ($new.cli_version // ""))
      ) ] + [$new] | .[-32:]')" || return 1
  write_qualification_store "$provider" "$versions" "$new_version"
}

# restore_qualification_versions PROVIDER PRIOR_RAW_JSON undoes any rewrite a
# provider wrapper made during a canary this preflight rejected, putting the
# record back exactly as it was before the canary started.
restore_qualification_versions() { # PROVIDER PRIOR_RAW_JSON
  local provider="$1" prior_raw="$2" file versions
  file="$(qualification_file "$provider")"
  if [ -z "$prior_raw" ]; then rm -f "$file"; return 0; fi
  versions="$(normalize_qualification_versions "$prior_raw")"
  if [ "$versions" = "[]" ]; then rm -f "$file"; return 0; fi
  write_atomic "$file" "$prior_raw"
}

# activate_qualification_version PROVIDER VERSION_JSON syncs the record's
# legacy top-level view to the version preflight selected, so the provider
# wrapper's own check agrees with this selection. Best effort: a failed sync
# never invalidates a match that already succeeded.
activate_qualification_version() { # PROVIDER VERSION_JSON
  local provider="$1" selected="$2" file raw versions current
  file="$(qualification_file "$provider")"; [ -f "$file" ] || return 0
  raw="$(cat "$file" 2>/dev/null)"; [ -n "$raw" ] || return 0
  current="$(printf '%s\n' "$raw" | jq -c '{wrapper_sha256,runtime_sha256,preloader_sha256,agy_sha256,agy_version,model,qualified_epoch}' 2>/dev/null)" || return 0
  [ "$current" = "$(printf '%s\n' "$selected" | jq -c '{wrapper_sha256,runtime_sha256,preloader_sha256,agy_sha256,agy_version,model,qualified_epoch}')" ] && return 0
  versions="$(normalize_qualification_versions "$raw")"
  [ "$versions" = "[]" ] && return 0
  write_qualification_store "$provider" "$versions" "$selected" || true
}

gemini_live_qualified() {
  local file wrapper actual actual_agy actual_agy_sha actual_model out rc versions match
  file="$(qualification_file gemini)"; [ -f "$file" ] || return 1
  wrapper="$(provider_wrapper gemini)"; [ -f "$wrapper" ] || return 1
  actual="$(sha256sum "$wrapper" 2>/dev/null | awk '{print $1}')"
  set +e; out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; rc=$?; set -e
  [ "$rc" -eq 0 ] || return 1
  actual_agy="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=\([^ ]*\) agy_sha256=.*/\1/p')"
  actual_agy_sha="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"
  actual_model="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=[^ ]* agy_sha256=[0-9a-f]\{64\} model=\([^ ]*\) .*/\1/p')"
  [ -n "$actual" ] && [ -n "$actual_agy" ] && [ -n "$actual_agy_sha" ] && [ -n "$actual_model" ] || return 1
  versions="$(qualification_versions gemini)"
  # Usable only when a stored version's key matches every installed byte. A
  # stored version never authorizes untested bytes; drift selects the version
  # that matches the drifted bytes, or fails closed.
  match="$(printf '%s\n' "$versions" | jq -c --arg sha "$actual" --arg agy "$actual_agy" --arg agy_sha "$actual_agy_sha" --arg model "$actual_model" '
    [ .[] | select(
        (.wrapper_sha256|type=="string" and test("^[0-9a-f]{64}$")) and
        (.agy_sha256|type=="string" and test("^[0-9a-f]{64}$")) and
        (.agy_version|type=="string" and length>0) and
        (.model|type=="string" and length>0) and
        (.qualified_epoch|type=="number") and
        .wrapper_sha256==$sha and .agy_sha256==$agy_sha and .agy_version==$agy and .model==$model
      ) ][0] // empty')" || return 1
  [ -n "$match" ] && [ "$match" != null ] || return 1
  activate_qualification_version gemini "$match"
}
qwen_live_qualified() {
  local file wrapper actual actual_runtime actual_preloader out rc count lines versions match
  file="$(qualification_file qwen)"; [ -f "$file" ] || return 1
  wrapper="$(provider_wrapper qwen)"; [ -f "$wrapper" ] || return 1
  actual="$(sha256sum "$wrapper" 2>/dev/null | awk '{print $1}')"
  set +e; out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; rc=$?; set -e
  [ "$rc" -eq 0 ] || return 1
  count="$(printf '%s\n' "$out" | grep -Ec '^IDENTITY runtime_sha256=[0-9a-f]{64} preloader_sha256=[0-9a-f]{64}$' || true)"
  lines="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
  [ "$count" -eq 1 ] && [ "$lines" -eq 1 ] || return 1
  actual_runtime="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY runtime_sha256=\([0-9a-f]\{64\}\) preloader_sha256=[0-9a-f]\{64\}$/\1/p')"
  actual_preloader="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY runtime_sha256=[0-9a-f]\{64\} preloader_sha256=\([0-9a-f]\{64\}\)$/\1/p')"
  [ -n "$actual" ] && [ -n "$actual_runtime" ] && [ -n "$actual_preloader" ] || return 1
  versions="$(qualification_versions qwen)"
  match="$(printf '%s\n' "$versions" | jq -c --arg sha "$actual" --arg runtime "$actual_runtime" --arg preloader "$actual_preloader" '
    [ .[] | select(
        (.wrapper_sha256|type=="string" and test("^[0-9a-f]{64}$")) and
        (.runtime_sha256|type=="string" and test("^[0-9a-f]{64}$")) and
        (.preloader_sha256|type=="string" and test("^[0-9a-f]{64}$")) and
        (.qualified_epoch|type=="number") and
        .wrapper_sha256==$sha and .runtime_sha256==$runtime and .preloader_sha256==$preloader
      ) ][0] // empty')" || return 1
  [ -n "$match" ] && [ "$match" != null ] || return 1
  activate_qualification_version qwen "$match"
}
qwen_runtime_sha() { # WRAPPER [DOCTOR_OUTPUT]
  local wrapper="$1" out="${2:-}" value count
  [ -n "$out" ] || out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$out" | grep -Ec '^qwen runtime sha256:[[:space:]]*[0-9a-f]{64}$' || true)"
  [ "$count" -eq 1 ] || return 1
  value="$(printf '%s\n' "$out" | sed -n 's/^qwen runtime sha256:[[:space:]]*\([0-9a-f]\{64\}\)$/\1/p')"
  [ -n "$value" ] || return 1; printf '%s' "$value"
}
qwen_preloader_sha() { # WRAPPER [DOCTOR_OUTPUT]
  local wrapper="$1" out="${2:-}" value count
  [ -n "$out" ] || out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$out" | grep -Ec '^qwen preloader sha256:[[:space:]]*[0-9a-f]{64}$' || true)"
  [ "$count" -eq 1 ] || return 1
  value="$(printf '%s\n' "$out" | sed -n 's/^qwen preloader sha256:[[:space:]]*\([0-9a-f]\{64\}\)$/\1/p')"
  [ -n "$value" ] || return 1; printf '%s' "$value"
}
registry_state() { # PROVIDER -> registered|absent|unknown
  local value
  [ -f "$REGISTRY_FILE" ] || { printf unknown; return; }
  value="$(jq -r --arg p "$1" '.providers[$p].registry_state // "unknown"' "$REGISTRY_FILE" 2>/dev/null)" || value=unknown
  case "$value" in registered|absent) printf '%s' "$value" ;; *) printf unknown ;; esac
}

registry_reason() { # PROVIDER
  local value
  [ -f "$REGISTRY_FILE" ] || { printf 'no reviewer registry at %s, so membership is unverified.' "$REGISTRY_FILE"; return; }
  value="$(jq -r --arg p "$1" '.providers[$p].reason // "not described in the reviewer registry, so membership is unverified."' "$REGISTRY_FILE" 2>/dev/null)"     || value='reviewer registry is unreadable, so membership is unverified.'
  printf '%s' "$value"
}

# health_status PROVIDER prints the install-health object and returns 0 only
# when the local install is healthy, unquarantined, and live-qualified.
health_status() { # PROVIDER
  if static_status "$1"; then return 1; fi
  if [ "$1" = stepfun ]; then
    case "${AI_STEPFUN_PLATFORM:-$(uname -s)}" in
      MINGW*|MSYS*|CYGWIN*|Windows*|windows*)
        local oc="${AI_STEPFUN_OPENCODE:-}"
        if [ -z "$oc" ] || [ ! -x "$oc" ]; then
          printf '{"provider":"stepfun","status":"unsupported-platform","failure_class":"unsupported-platform"}\n'
          return 1
        fi
        ;;
    esac
  fi
  if active_quarantine "$1"; then printf '%s\n' "$ACTIVE_QUARANTINE" | jq -c '. + {status:"quarantined"}'; return 1; fi
  printf '{"provider":"%s","status":"installed-healthy"}
' "$1"
}

# reconciled_status PROVIDER gives one answer across install health, quarantine,
# live qualification, and allocating-registry membership. It returns 0 only when
# the provider may actually be given a review right now. "installed-healthy" is
# deliberately not called "available": health alone never means allocatable.
reconciled_status() { # PROVIDER
  local health healthy=0 state reason usable admission
  health="$(health_status "$1")" || healthy=1
  # A provider whose admission record cannot be read is unusable, but it must
  # still emit a row: a silent provider made callers refuse EVERY reviewer draw.
  if ! admission="$(default_admission "$1")" || ! printf '%s' "$admission" | jq -e 'type=="object"' >/dev/null 2>&1; then
    admission='{"state":"unknown","reason":"admission-unreadable"}'; healthy=1
  fi
  state="$(registry_state "$1")"; reason="$(registry_reason "$1")"
  local wrapper_path; wrapper_path="$(provider_wrapper "$1")"
  if [ "$healthy" = 0 ] && [ "$state" = registered ] && [ "$(printf '%s' "$admission" | jq -r .state)" != backoff ]; then usable=true; else usable=false; fi
  printf '%s
' "$health" | jq -c --arg state "$state" --arg reason "$reason" --argjson usable "$usable" --argjson admission "$admission" --arg wrapper_path "$wrapper_path" --arg wrapper_command "${wrapper_path##*/}" '. + {wrapper_command:$wrapper_command, wrapper_path:$wrapper_path, registry_state:$state, registry_reason:$reason, usable:$usable, admission:$admission}'
  [ "$usable" = true ]
}

static_status() {
  case "$1" in
    gemini) gemini_live_qualified && return 1; printf '{"provider":"gemini","status":"quarantined","failure_class":"live-qualification-required"}\n'; return 0 ;;
    qwen) qwen_live_qualified && return 1; printf '{"provider":"qwen","status":"quarantined","failure_class":"live-qualification-required"}\n'; return 0 ;;
    # StepFun: Linux (bubblewrap) or Windows (folder + test shell, owner
    # 2026-09-30). Other platforms unsupported.
    stepfun)
      case "${AI_STEPFUN_PLATFORM:-$(uname -s)}" in
        Linux|linux) return 1 ;;
        MINGW*|MSYS*|CYGWIN*|Windows*|windows*) return 1 ;;
      esac
      printf '{"provider":"stepfun","status":"unsupported-platform","failure_class":"unsupported-platform"}\n'; return 0 ;;
    *) return 1 ;;
  esac
}

PREFLIGHT_REPO=""
PREFLIGHT_TAG=""
PREFLIGHT_SANDBOX=""
cleanup_check() {
  [ -z "$PREFLIGHT_SANDBOX" ] || "${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet}" remove "$PREFLIGHT_SANDBOX" "$PREFLIGHT_TAG" >/dev/null 2>&1 || true
  [ -z "$PREFLIGHT_REPO" ] || "${AI_REVIEW_SANDBOX_BIN:-$SCRIPT_DIR/ai-review-sandbox}" remove-copy "$PREFLIGHT_REPO" "$PREFLIGHT_TAG" >/dev/null 2>&1 || true
}

write_atomic() { # FILE JSON
  local f="$1" tmp
  mkdir -p "$(dirname "$f")"; chmod 0700 "$(dirname "$f")" 2>/dev/null || true
  tmp="$(mktemp "$(dirname "$f")/.preflight.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; chmod 0600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f"
}

quarantine() { # PROVIDER CLASS [SECONDS]
  local provider="$1" class="$2" seconds="${3:-}" now expires f
  # Out of credit matches the wrapper classifier's one-hour hold (CREDIT_SECONDS).
  if [ -z "$seconds" ]; then
    case "$class" in
      out-of-credit)    seconds=3600 ;;
      # Transient timeout earns a short retry window, not a 30-minute hold.
      provider-timeout) seconds="$TIMEOUT_COOLDOWN" ;;
      *)                seconds="$COOLDOWN" ;;
    esac
  fi
  valid_provider "$provider" || die "unknown provider '$provider'."
  case "$seconds" in ''|*[!0-9]*) die "quarantine seconds must be a positive integer." ;; esac
  [ "$seconds" -gt 0 ] || die "quarantine seconds must be greater than zero."
  admission_store quarantine "$provider" --reason "$class" --seconds "$seconds" >/dev/null
  note "ai-review-preflight: quarantined $provider for ${seconds}s ($class)."
}

active_quarantine() { # PROVIDER -> 0 active, 1 absent/expired
  ACTIVE_QUARANTINE="$(admission_store global "$1")" || die 'invalid quarantine record.'
  [ "$ACTIVE_QUARANTINE" != null ]
}

classify_failure() { # OUTPUT
  local text; text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  # An empty or whitespace-only probe result is not evidence of any named
  # health failure. It is a probe that produced no diagnosis.
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || { printf probe-no-output; return; }
  case "$text" in
    *insufficient*balance*|*insufficient_quota*|*out?of?credit*|*credits*depleted*|*monthly?spending?limit*|*arrearage*) printf out-of-credit ;;
    *403*|*429*|*allowance*|*usage.limit*|*quota*) printf allowance-exhausted ;;
    *not.authenticated*|*login*required*|*credential*|*unauthorized*|*401*) printf authentication-failed ;;
    *timed.out*|*timeout*) printf provider-timeout ;;
    *unreachable*|*connection.refused*|*health.endpoint*failed*|*service*unavailable*) printf service-unavailable ;;
    *) printf provider-unhealthy ;;
  esac
}

explain_failure() {
  case "$1" in
    allowance-exhausted) printf 'Quarantine this provider. Do not assign another review until the cooling period expires.\n' ;;
    out-of-credit) printf 'The provider account has run out of paid credit. Tell Albert in this same reply which provider needs credits and where to add them, then rotate to another reviewer. After credits are added, run: ai-review-preflight clear <provider>\n' ;;
    broken-snapshot) printf 'Rebuild once with ai-review-sandbox. If it still fails, quarantine the provider; never use a raw linked worktree.\n' ;;
    empty-assistant-turns) printf 'Stop within 2-3 minutes and report no usable answer. Do not keep retrying empty turns.\n' ;;
    turn-exhaustion) printf 'Do not increase the turn ceiling automatically. Check for a vague brief, an oversized change, or reviewer wandering, then narrow the work.\n' ;;
    service-unavailable) printf 'Retry the service check once after a short delay, then wait. Do not misclassify an outage as a code verdict.\n' ;;
    substantive-finding) printf 'Stop and fix the finding. Never rotate providers to shop for a friendlier verdict.\n' ;;
    empty-report) printf 'The provider returned a decision with no analysis behind it. Treat it as malformed, not as an approval. Re-run the review and require a report; never relax the report floor to let the verdict through.\n' ;;
    unsupported-platform) printf 'This provider has no engine on this operating system (StepFun: Ubuntu/Linux under bubblewrap, or Windows folder + test shell). Use another registered reviewer; never emulate or force it.\n' ;;
    not-registered) printf 'The provider is not carried in the reviewer registry, so it cannot receive a review no matter how healthy its local install is. Re-entry is a reviewed registry change backed by a live well-formed verdict, never an edit made to unblock an allocation.\n' ;;
    live-qualification-required) printf 'The reviewer live qualification no longer matches its wrapper, runtime, or preloader bytes. A pull of new toolkit code re-qualifies it automatically via the repository post-merge hook; to restore it now run: ai-review-preflight requalify\n' ;;
    pin-mismatch) printf 'The installed provider CLI does not satisfy config/provider-cli-versions.json (below the floor, a new major, or an exact-pin miss). This is not a hard exact-pin rule: a version_match "minimum" provider accepts any same-major build at or above its floor, so an auto-updated provider is never blocked here. Fix by installing a satisfying build, or bump the pin in the same change and run: ai-review-preflight pin-bump-qualify <provider>\n' ;;
    probe-no-output) printf 'The health probe returned no diagnostic output. This is not proof the provider is broken. Retry after the short cooldown; if it persists, check the wrapper manually. Never treat empty output as healthy.\n' ;;
    provider-timeout) printf 'The health probe exceeded its time budget. This is a transient liveness problem, not an identity or auth failure. A short cooldown applies; retry after it expires. A timeout never means the provider is healthy and never authorizes a review.\n' ;;
    authentication-failed|provider-unhealthy) printf 'Quarantine this provider and correct the named health failure before assigning a review.\n' ;;
    *) die "unknown failure class '$1'." ;;
  esac
}

provider_wrapper() {
  case "$1" in
    claude) printf '%s' "${AI_REVIEW_CLAUDE_WRAPPER:-$SCRIPT_DIR/ai-claude-review}" ;;
    grok) printf '%s' "${AI_REVIEW_GROK_WRAPPER:-$SCRIPT_DIR/ai-grok-review}" ;;
    kimi) printf '%s' "${AI_REVIEW_KIMI_WRAPPER:-$SCRIPT_DIR/ai-kimi}" ;;
    glm)  printf '%s' "${AI_REVIEW_GLM_WRAPPER:-$SCRIPT_DIR/ai-glm}" ;;
    muse) printf '%s' "${AI_REVIEW_MUSE_WRAPPER:-$SCRIPT_DIR/ai-muse}" ;;
    gemini) printf '%s' "${AI_REVIEW_GEMINI_WRAPPER:-$SCRIPT_DIR/ai-gemini}" ;;
    qwen) printf '%s' "${AI_REVIEW_QWEN_WRAPPER:-$SCRIPT_DIR/ai-qwen}" ;;
    codex) printf '%s' "${AI_REVIEW_CODEX_WRAPPER:-$SCRIPT_DIR/ai-codex-review}" ;;
    deepseek) printf '%s' "${AI_REVIEW_DEEPSEEK_WRAPPER:-$SCRIPT_DIR/ai-deepseek-agent}" ;;
    stepfun) printf '%s' "${AI_REVIEW_STEPFUN_WRAPPER:-$SCRIPT_DIR/ai-stepfun}" ;;
  esac
}

qualify_qwen() {
  local wrapper out rc sha before_sha runtime_sha preloader_sha now file prior_versions prior_raw
  wrapper="$(provider_wrapper qwen)"; [ -x "$wrapper" ] || die "Qwen wrapper is not executable: $wrapper"
  file="$(qualification_file qwen)"
  # Never delete the prior qualification before the canary (issue #1112). A
  # failed canary keeps the previous version valid — revoke-on-fail was the
  # 24-48h quarantine loop — and never authorizes the untested bytes.
  prior_raw="$(cat "$file" 2>/dev/null || true)"
  prior_versions="$(qualification_versions qwen)"
  before_sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  set +e; out="$(timeout "${AI_REVIEW_QWEN_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?; set -e
  [ "$rc" = 0 ] || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen live qualification failed; the previous qualification version stays valid.\n%s\n' "$out" >&2; return 1; }
  runtime_sha="$(qwen_runtime_sha "$wrapper" "$out")" || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen live qualification did not identify one exact installed runtime hash; the previous qualification version stays valid.\n' >&2; return 1; }
  preloader_sha="$(qwen_preloader_sha "$wrapper" "$out")" || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen live qualification did not identify one exact credential-preloader hash; the previous qualification version stays valid.\n' >&2; return 1; }
  sha="$(sha256sum "$wrapper" | awk '{print $1}')"; [ "$before_sha" = "$sha" ] || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen wrapper changed during qualification; untested bytes are not authorized and the previous qualification version stays valid.\n' >&2; return 1; }
  now="$(now_epoch)"
  publish_qualification_version qwen "$prior_versions" "$(jq -nc --arg sha "$sha" --arg runtime "$runtime_sha" --arg preloader "$preloader_sha" --argjson at "$now" '{wrapper_sha256:$sha,runtime_sha256:$runtime,preloader_sha256:$preloader,qualified_epoch:$at}')" \
    || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen qualification version did not publish; the previous qualification version stays valid.\n' >&2; return 1; }
  qwen_live_qualified || { restore_qualification_versions qwen "$prior_raw"; printf 'ai-review-preflight: Qwen qualification record did not validate after publishing; the previous qualification version stays valid.\n' >&2; return 1; }
  note "ai-review-preflight: Qwen live qualification recorded for wrapper $sha, runtime $runtime_sha, and credential preloader $preloader_sha."
}

qualify_gemini() {
  local wrapper out rc sha before_sha agy_version before_agy agy_sha before_agy_sha model before_model now file doctor_out before_doctor count prior_versions prior_raw
  wrapper="$(provider_wrapper gemini)"; [ -x "$wrapper" ] || die "Gemini wrapper is not executable: $wrapper"
  file="$(qualification_file gemini)"
  # Never delete the prior qualification before the canary (issue #1112). A
  # failed canary keeps the previous version valid — revoke-on-fail was the
  # 24-48h quarantine loop — and never authorizes the untested bytes. The
  # prior store is captured before the canary because bin/ai-gemini rewrites
  # the record when its own canary passes; that rewrite must not drop history.
  prior_raw="$(cat "$file" 2>/dev/null || true)"
  prior_versions="$(qualification_versions gemini)"
  before_sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  set +e; before_doctor="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; set -e
  before_agy="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=\([^ ]*\) agy_sha256=.*/\1/p')"; before_agy_sha="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"; before_model="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=[0-9a-f]\{64\} model=\([^ ]*\) .*/\1/p')"
  [ -n "$before_agy" ] && [ -n "$before_agy_sha" ] && [ -n "$before_model" ] || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini qualification could not identify the pre-canary runtime and model; the previous qualification version stays valid.\n' >&2; return 1; }
  set +e; out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" qualify-live 2>&1)"; rc=$?; set -e
  [ "$rc" = 0 ] || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini live qualification failed; the previous qualification version stays valid.\n%s\n' "$out" >&2; return 1; }
  count="$(printf '%s\n' "$out" | grep -Ec '^QUALIFIED session=[^ ]+ model=[^ ]+ exact-resume=yes mutation-request=no-change outside-sentinel=unchanged reports=durable fixture=.+$' || true)"
  [ "$count" -eq 1 ] || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini live qualification did not return one exact QUALIFIED contract; the previous qualification version stays valid.\n' >&2; return 1; }
  model="$(printf '%s\n' "$out" | sed -n 's/^QUALIFIED session=[^ ]* model=\([^ ]*\) exact-resume=yes mutation-request=no-change outside-sentinel=unchanged reports=durable fixture=.*$/\1/p')"
  set +e; doctor_out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; set -e
  agy_version="$(printf '%s\n' "$doctor_out" | sed -n 's/^[A-Z]* agy=\([^ ]*\) agy_sha256=.*/\1/p')"; agy_sha="$(printf '%s\n' "$doctor_out" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"
  [ -n "$agy_version" ] && [ -n "$model" ] || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini qualification could not bind the runtime version and model; the previous qualification version stays valid.\n' >&2; return 1; }
  printf '%s\n' "$doctor_out" | grep -q " model=$model " || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini qualification model disagrees with the wrapper doctor; the previous qualification version stays valid.\n' >&2; return 1; }
  sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  [ "$before_sha" = "$sha" ] && [ "$before_agy" = "$agy_version" ] && [ "$before_agy_sha" = "$agy_sha" ] && [ "$before_model" = "$model" ] || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini wrapper, runtime, or model changed during qualification; untested bytes are not authorized and the previous qualification version stays valid.\n' >&2; return 1; }
  now="$(now_epoch)"
  publish_qualification_version gemini "$prior_versions" "$(jq -nc --arg sha "$sha" --arg agy "$agy_version" --arg agy_sha "$agy_sha" --arg model "$model" --argjson at "$now" '{wrapper_sha256:$sha,agy_version:$agy,agy_sha256:$agy_sha,model:$model,qualified_epoch:$at}')" \
    || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini qualification version did not publish; the previous qualification version stays valid.\n' >&2; return 1; }
  gemini_live_qualified || { restore_qualification_versions gemini "$prior_raw"; printf 'ai-review-preflight: Gemini qualification record did not validate after publishing; the previous qualification version stays valid.\n' >&2; return 1; }
  note "ai-review-preflight: Gemini live qualification recorded for wrapper $sha, agy $agy_version, and model $model."
}

# LIVE_QUALIFIED_PROVIDERS names every provider whose usability is bound to a
# live qualification record. requalify iterates exactly these; adding a live
# qualification contract for another provider means adding it here and a
# stale-check case in requalify_provider.
LIVE_QUALIFIED_PROVIDERS="gemini qwen"

# record_requalify_failure PROVIDER OUTPUT_FILE persists a failed automatic
# requalification as a reviewer issue (#804). A failure that cannot be
# recorded is still printed, so it is never silently skipped.
record_requalify_failure() { # PROVIDER OUTPUT_FILE
  local provider="$1" output="$2" issue_bin="${AI_REVIEWER_ISSUE_BIN:-$SCRIPT_DIR/ai-reviewer-issue}" out id
  if [ -x "$issue_bin" ]; then
    out="$("$issue_bin" record --provider "$provider" \
      --summary "automatic $provider requalification failed after a pulled wrapper, runtime, or preloader change" \
      --details-file "$output" \
      --command "ai-review-preflight requalify $provider" \
      --repo "$REGISTRY_REAL_DIR/.." \
      --caller requalify 2>&1)" || out="$out
ai-reviewer-issue record itself failed."
    printf '%s\n' "$out" >&2
    id="$(printf '%s\n' "$out" | sed -n 's/^ai-reviewer-issue: recorded //p')"
  else
    id=""
    printf 'ai-review-preflight: ai-reviewer-issue is unavailable at %s; failure NOT recorded.\n' "$issue_bin" >&2
  fi
  [ -n "$id" ] || id=unrecorded
  printf 'ai-review-preflight: %s automatic requalification FAILED; it stays quarantined (live-qualification-required). reviewer issue: %s\n' "$provider" "$id" >&2
}

# requalify_expected_file PROVIDER is the marker that says this host HAS
# held a live qualification for the provider. A record that is missing
# entirely (for example, manually removed) with a marker present is still
# retried; without this marker the next automatic run would see "no record"
# and silently stop retrying (#804 requires the opposite). Since #1112 the
# qualify path no longer deletes the record on a failed canary, so the
# "revoked" case only appears when something outside requalify removed it.
requalify_expected_file() { printf '%s/%s-requalify-marker.json' "$STATE_DIR" "$1"; }

# requalify_provider PROVIDER returns 0 when the provider's live qualification
# is current or was just re-established, and 1 when a requalification attempt
# failed (already recorded and surfaced by then).
requalify_provider() { # PROVIDER
  local provider="$1" file marker output rc qualify_output
  if [ "$(registry_state "$provider")" != registered ]; then
    note "ai-review-preflight: $provider is not carried in the reviewer registry; automatic requalification skips it."
    return 0
  fi
  file="$(qualification_file "$provider")"
  marker="$(requalify_expected_file "$provider")"
  if [ ! -f "$file" ]; then
    if [ ! -f "$marker" ]; then
      # The first qualification is a deliberate act (a live canary on live
      # credentials); automation only refreshes an existing qualification.
      note "ai-review-preflight: $provider has no prior live-qualification record; nothing to re-qualify."
      return 0
    fi
    note "ai-review-preflight: $provider qualification record is missing but this host held one before; retrying."
  else
    write_atomic "$marker" "$(jq -nc --arg provider "$provider" --argjson at "$(now_epoch)" '{version:1,provider:$provider,expected_epoch:$at}')"
    case "$provider" in
      gemini) gemini_live_qualified && { note "ai-review-preflight: gemini live qualification is current."; return 0; } ;;
      qwen)   qwen_live_qualified   && { note "ai-review-preflight: qwen live qualification is current."; return 0; } ;;
      *) die "requalify has no stale check for provider '$provider'." ;;
    esac
    note "ai-review-preflight: $provider live qualification is stale (wrapper, runtime, or preloader changed); re-qualifying."
  fi
  output="$(mktemp "${TMPDIR:-/tmp}/requalify.XXXXXX")"
  set +e
  qualify_output="$(case "$provider" in gemini) qualify_gemini ;; qwen) qualify_qwen ;; esac 2>&1)"
  rc=$?
  set -e
  printf '%s\n' "$qualify_output" >&2
  if [ "$rc" -eq 0 ]; then
    rm -f "$output"
    return 0
  fi
  printf '%s\n' "$qualify_output" > "$output"
  record_requalify_failure "$provider" "$output"
  rm -f "$output"
  return 1
}

# requalify re-runs the live qualification for every named provider (default:
# all LIVE_QUALIFIED_PROVIDERS) whose qualification record no longer matches
# the installed bytes. Called automatically by the repository's post-merge
# hook and by update.sh after a pull; safe to run by hand at any time.
requalify() { # [PROVIDER...]
  local provider failed=0
  local providers=("$@")
  [ "$#" -gt 0 ] || read -r -a providers <<< "$LIVE_QUALIFIED_PROVIDERS"
  for provider in "${providers[@]}"; do
    case " $LIVE_QUALIFIED_PROVIDERS " in
      *" $provider "*) ;;
      *) die "requalify only knows: $LIVE_QUALIFIED_PROVIDERS (got '$provider')." ;;
    esac
    requalify_provider "$provider" || failed=1
  done
  return "$failed"
}

# emit_status PROVIDER runs one provider's reconciled check in isolation. A
# provider whose check crashes still yields an explicit unusable row, so one
# provider's fault never drops the providers after it or blocks other draws.
emit_status() {
  local row rc=0
  row="$(reconciled_status "$1")" || rc=$?
  if [ -z "$row" ]; then
    jq -nc --arg p "$1" '{provider:$p,status:"check-failed",failure_class:"preflight-check-crashed",usable:false,admission:{state:"unknown",reason:"check-failed"}}'
    return 1
  fi
  printf '%s
' "$row"; return "$rc"
}

# ---------------------------------------------------------------------------
# Structural forcing function (plan_reviewer-pipeline-core §9 Phase D).
# A provider whose door is registered in config/review-runner-doors.json MUST
# be dispatched through the shared review runner (bin/ai-review-engine).
# Preflight refuses to authorize a review that would bypass the runner: an
# ungated AI_REVIEW_ENGINE_BIN override, or a runner-doors provider whose
# engine or door is missing at runtime, never reaches a PASS row. The shipped
# registry is authoritative, so a foreign AI_REVIEW_RUNNER_DOORS_JSON cannot
# unregister a migrated door here either.
# ---------------------------------------------------------------------------
SHIPPED_DOORS_JSON="$REGISTRY_REAL_DIR/../config/review-runner-doors.json"
runner_door_registered() { # PROVIDER -> 0 when the shipped registry lists it
  [ -f "$SHIPPED_DOORS_JSON" ] && jq -e --arg p "$1" 'has($p)' "$SHIPPED_DOORS_JSON" >/dev/null 2>&1
}

refuse_runner_bypass() { # PROVIDER -> 0 to authorize; nonzero to refuse
  local provider="$1" engine door effective
  runner_door_registered "$provider" || return 0
  engine="$REGISTRY_REAL_DIR/ai-review-engine"
  if [ -n "${AI_REVIEW_ENGINE_BIN:-}" ]; then
    if [ "${AI_POOL_TEST_HOOKS:-0}" != 1 ]; then
      note "ai-review-preflight: AI_REVIEW_ENGINE_BIN is a test hook (AI_POOL_TEST_HOOKS=1); refusing an ungated engine override for $provider."
      return 1
    fi
    engine="$AI_REVIEW_ENGINE_BIN"
  fi
  if [ ! -f "$engine" ] && [ ! -x "$engine" ]; then
    note "ai-review-preflight: $provider is a runner-doors provider but the shared review runner is missing ($engine); refusing to authorize a review that would bypass it."
    return 1
  fi
  effective="${AI_REVIEW_RUNNER_DOORS_JSON:-$SHIPPED_DOORS_JSON}"
  door="$(jq -r --arg p "$provider" '.[$p].door // empty' "$SHIPPED_DOORS_JSON" 2>/dev/null || true)"
  if [ -z "$door" ] || [ "$door" = null ]; then
    door="$(jq -r --arg p "$provider" '.[$p].door // empty' "$effective" 2>/dev/null || true)"
  fi
  case "$door" in
    ''|null) ;;
    /*|[A-Za-z]:*) ;;
    *) door="$REGISTRY_REAL_DIR/../$door" ;;
  esac
  if [ -z "$door" ] || [ "$door" = null ] || [ ! -f "$door" ]; then
    note "ai-review-preflight: $provider is a runner-doors provider but its door is missing at runtime; refusing to authorize a review that would bypass the runner."
    return 1
  fi
  return 0
}

check_provider() { # PROVIDER REPO LIVE BASE
  local provider="$1" repo="$2" live="$3" base="$4" wrapper sandbox packet tag out rc class
  valid_provider "$provider" || die "unknown provider '$provider'."
  [ -d "$repo" ] || die "review directory does not exist: $repo"
  repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || die "not a Git repository: $repo"
  need jq; need git; need timeout
  # Structural refusal before any health work: a runner-doors provider whose
  # review would bypass bin/ai-review-engine is never authorized here.
  refuse_runner_bypass "$provider" || return 1
  # Always name the exact resolved wrapper so nobody reports a guessed name.
  wrapper="$(provider_wrapper "$provider")"
  printf 'ai-review-preflight: %s wrapper command: %s (%s)
' "$provider" "${wrapper##*/}" "$wrapper" >&2
  if active_quarantine "$provider"; then
    printf '%s\n' "$ACTIVE_QUARANTINE" | jq -r '"ai-review-preflight: " + .provider + " is quarantined until epoch " + (.expires_epoch|tostring) + " (" + .failure_class + ")."' >&2
    return 3
  fi
  out="$(default_admission "$provider")" || return 1
  if [ "$(printf '%s' "$out" | jq -r .state)" = backoff ]; then
    printf 'ai-review-preflight: %s has an active scoped usage-limit backoff.\n' "$provider" >&2
    return 3
  fi
  if [ "$(registry_state "$provider")" != registered ]; then
    printf 'ai-review-preflight: %s is not carried in the reviewer registry and cannot receive a review: %s
' "$provider" "$(registry_reason "$provider")" >&2
    return 3
  fi
  if static_status "$provider" >/dev/null; then
    static_status "$provider" >&2
    case "$provider" in gemini|qwen) return 3 ;; *) return 4 ;; esac
  fi
  # Windows StepFun without OpenCode is an engine miss (exit 4), not a quarantine.
  if [ "$provider" = stepfun ]; then
    case "${AI_STEPFUN_PLATFORM:-$(uname -s)}" in
      MINGW*|MSYS*|CYGWIN*|Windows*|windows*)
        if [ -z "${AI_STEPFUN_OPENCODE:-}" ] || [ ! -x "${AI_STEPFUN_OPENCODE:-}" ]; then
          if ! command -v opencode >/dev/null 2>&1 && [ ! -x "${AI_STEPFUN_OPENCODE:-}" ]; then
            printf 'ai-review-preflight: stepfun is unsupported on this platform (engine missing or wrong OS).\n' >&2
            return 4
          fi
        fi
        ;;
    esac
  fi

  git -C "$repo" rev-parse --verify HEAD^{commit} >/dev/null 2>&1 || die "repository has no readable HEAD commit."
  [ -z "$base" ] || git -C "$repo" rev-parse --verify "$base^{commit}" >/dev/null 2>&1 \
    || die "base ref does not resolve: $base"

  wrapper="$(provider_wrapper "$provider")"; [ -x "$wrapper" ] || die "provider wrapper is not executable: $wrapper"
  set +e
  if [ "$provider" = muse ]; then
    # A real Muse live turn outlasts the 10s check budget; ai-muse doctor --live
    # enforces its own 90s turn limit, so give the whole call room (#842).
    # The offline doctor spawns ~40 short processes; on Windows hosts where each
    # Git Bash fork costs ~0.3s (4837) it takes ~12s, past the 10s check budget,
    # so it gets its own bounded budget. A timeout still never means healthy.
    if [ "$live" = 1 ]; then out="$(AI_MUSE_CALLER=preflight timeout "${AI_REVIEW_MUSE_QUALIFY_TIMEOUT:-240}s" "$wrapper" doctor --live 2>&1)"; rc=$?
    else out="$(AI_MUSE_CALLER=preflight timeout "${AI_REVIEW_MUSE_DOCTOR_TIMEOUT:-30}s" "$wrapper" doctor 2>&1)"; rc=$?; fi
  elif [ "$live" = 1 ] && [ "$provider" != glm ]; then
    if [ "$provider" = gemini ]; then out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?
    # A StepCode live turn takes about 8-9s, too close to the 10s check budget.
    elif [ "$provider" = stepfun ]; then out="$(timeout "${AI_REVIEW_STEPFUN_QUALIFY_TIMEOUT:-120}s" "$wrapper" doctor --live 2>&1)"; rc=$?
    else out="$(timeout "${LIVE_PROBE_TIMEOUT}s" "$wrapper" doctor --live 2>&1)"; rc=$?; fi
  else
    out="$(timeout "${DOCTOR_PROBE_TIMEOUT}s" "$wrapper" doctor 2>&1)"; rc=$?
  fi
  # A transient liveness timeout gets one bounded retry before it is recorded.
  # The retry is part of the timeout path: a timeout result alone never means
  # the provider is healthy and never authorizes a review to proceed.
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    note "ai-review-preflight: $provider probe timed out (rc=$rc); retrying once after a short delay."
    sleep "${AI_REVIEW_TIMEOUT_RETRY_DELAY:-2}"
    if [ "$provider" = muse ]; then
      if [ "$live" = 1 ]; then out="$(AI_MUSE_CALLER=preflight timeout "${AI_REVIEW_MUSE_QUALIFY_TIMEOUT:-240}s" "$wrapper" doctor --live 2>&1)"; rc=$?
      else out="$(AI_MUSE_CALLER=preflight timeout "${AI_REVIEW_MUSE_DOCTOR_TIMEOUT:-30}s" "$wrapper" doctor 2>&1)"; rc=$?; fi
    elif [ "$live" = 1 ] && [ "$provider" != glm ]; then
      if [ "$provider" = gemini ]; then out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?
      elif [ "$provider" = stepfun ]; then out="$(timeout "${AI_REVIEW_STEPFUN_QUALIFY_TIMEOUT:-120}s" "$wrapper" doctor --live 2>&1)"; rc=$?
      else out="$(timeout "${LIVE_PROBE_TIMEOUT}s" "$wrapper" doctor --live 2>&1)"; rc=$?; fi
    else
      out="$(timeout "${DOCTOR_PROBE_TIMEOUT}s" "$wrapper" doctor 2>&1)"; rc=$?
    fi
  fi
  set -e
  if [ "$rc" -ne 0 ]; then
    if printf '%s' "$out" | grep -q 'unsupported-platform'; then
      printf 'ai-review-preflight: %s is unsupported on this platform (engine missing or wrong OS).\n' "$provider" >&2
      return 4
    fi
    # A doctor killed by the check budget is a timeout, whatever its partial
    # output says: Qwen's doctor prints "credential" before any auth step, and
    # reading that as authentication-failed quarantined a healthy Qwen (#720).
    # Empty output with a non-zero exit is probe-no-output, not provider-unhealthy.
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then class=provider-timeout
    elif [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then class=probe-no-output
    else class="$(classify_failure "$out")"; fi
    quarantine "$provider" "$class"
    printf 'ai-review-preflight: %s failed: %s\n' "$provider" "$class" >&2
    printf '%s\n' "$out" | tail -12 >&2
    return 1
  fi
  # Reject unhealthy providers before preparing evidence for a review they
  # cannot receive. A successful doctor still cannot authorize dispatch until
  # the complete isolated packet has been built and verified below.
  tag="preflight-$provider-$$"
  # Always isolate preflight. Ordinary wrappers keep their packet in an
  # ordinary clone while a reviewer reads it; a preflight packet must never
  # replace or delete that live evidence.
  sandbox="$(AI_REVIEW_SANDBOX_BASE="${base:-}" ${AI_REVIEW_SANDBOX_BIN:-$SCRIPT_DIR/ai-review-sandbox} ensure-copy "$repo" "$tag")"
  PREFLIGHT_REPO="$repo"; PREFLIGHT_TAG="$tag"; PREFLIGHT_SANDBOX="$sandbox"
  trap cleanup_check EXIT
  packet="$(${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet} build "$sandbox" "$tag" ${base:+--base "$base"})"
  "${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet}" verify "$packet" >/dev/null
  printf 'PASS provider=%s repository=%s packet=verified health=ok allowance=%s\n' \
    "$provider" "$repo" "$([ "$live" = 1 ] && [ "$provider" != glm ] && printf live-verified || printf not-separately-exposed)"
}

# provider_cli_binary PROVIDER prints the path of the provider CLI that the
# provider wrapper actually executes, resolved the same way the wrappers do
# (explicit override first, then private install paths, then PATH). The name is
# read from the one versioned contract (ai-provider-version command), never
# hardcoded here. Hashing only the PATH hit would certify bytes the live smoke
# never exercised when a wrapper prefers an override or a private install path
# (Grok, Kimi, StepFun).
provider_cli_binary() { # PROVIDER
  local provider="$1" policy_bin cmd path c
  policy_bin="${AI_PROVIDER_VERSION_BIN:-$REGISTRY_REAL_DIR/ai-provider-version}"
  [ -x "$policy_bin" ] || die "ai-provider-version is not executable: $policy_bin"
  cmd="$("$policy_bin" command "$provider")" || return 1
  case "$provider" in
    grok)
      if [ -n "${AI_GROK_BIN:-}" ] && [ -e "${AI_GROK_BIN}" ]; then
        printf '%s' "$AI_GROK_BIN"; return 0
      fi
      for c in "$(command -v "$cmd" 2>/dev/null || true)" \
               "$HOME/.local/bin/grok" "$HOME/.grok/bin/grok" "$HOME/.grok/bin/grok.exe" \
               /home/ai/.local/bin/grok /usr/local/bin/grok; do
        [ -n "$c" ] && [ -e "$c" ] && { printf '%s' "$c"; return 0; }
      done
      return 1 ;;
    kimi)
      if [ -n "${AI_KIMI_BIN:-}" ] && [ -e "${AI_KIMI_BIN}" ]; then
        printf '%s' "$AI_KIMI_BIN"; return 0
      fi
      for c in "$(command -v "$cmd" 2>/dev/null || true)" \
               "${KIMI_CODE_HOME:-$HOME/.kimi-code}/bin/kimi" \
               "${KIMI_CODE_HOME:-$HOME/.kimi-code}/bin/kimi.exe" \
               "$HOME/.kimi-code/bin/kimi" "$HOME/.kimi-code/bin/kimi.exe" \
               /home/ai/.kimi-code/bin/kimi /usr/local/bin/kimi; do
        [ -n "$c" ] && [ -e "$c" ] && { printf '%s' "$c"; return 0; }
      done
      return 1 ;;
    stepfun)
      if [ -n "${AI_STEPFUN_STEP_BIN:-}" ] && [ -e "${AI_STEPFUN_STEP_BIN}" ]; then
        printf '%s' "$AI_STEPFUN_STEP_BIN"; return 0
      fi
      for c in "$HOME/.stepcode/bin/step" "$(command -v "$cmd" 2>/dev/null || true)"; do
        [ -n "$c" ] && [ -e "$c" ] && { printf '%s' "$c"; return 0; }
      done
      return 1 ;;
    *)
      path="$(command -v "$cmd" 2>/dev/null || true)"
      [ -n "$path" ] && [ -e "$path" ] || return 1
      printf '%s' "$path" ;;
  esac
}

# pin_bump_qualify PROVIDER is the FAST PATH for a version-pin-bump-only change
# (Muse 2b shape, #1183 child 5): hash the binary, run doctor, one live smoke.
#
# This is NOT the rejected hard exact-pin lane. Version policy is whatever
# config/provider-cli-versions.json says, read only through ai-provider-version.
# `version_match: "minimum"` (Grok, owner ruling 2026-09-23 on #686) accepts any
# same-major build at or above the floor, so a provider that auto-updates past
# the pin is never blocked by this path and never earns a quarantine here. The
# lane only:
#   - auto-quarantines on pin mismatch (the installed build FAILS policy), and
#   - auto-restores that quarantine when the pin is updated in the same change
#     (running this command IS the pin update), then
#   - records the cheap qualification in the existing hash-pin store (the same
#     one Gemini's live qualification uses — never a second store).
# It deliberately does NOT add the provider to LIVE_QUALIFIED_PROVIDERS: a
# later auto-update stays usable under the floor policy without re-running this
# lane. Full live qualification (qualify gemini|qwen) remains the path for
# behaviour changes; this lane is the cheap one for a pin bump.
pin_bump_qualify() { # PROVIDER
  local provider="$1" wrapper cli_bin cli_sha before_sha after_sha after_cli_sha file
  local policy_bin cli_version_text cli_version prior_raw prior_versions now
  local out rc mode want class clear_stale_pin_mismatch switched_as switched_bin
  valid_provider "$provider" || die "unknown provider '$provider'."
  case "$provider" in
    gemini|qwen)
      die "pin-bump-qualify is the cheap lane for version-pin bumps only; $provider has its own full live qualification (ai-review-preflight qualify $provider)." ;;
  esac
  need jq; need timeout; need sha256sum; need awk
  policy_bin="${AI_PROVIDER_VERSION_BIN:-$REGISTRY_REAL_DIR/ai-provider-version}"
  [ -x "$policy_bin" ] || die "ai-provider-version is not executable: $policy_bin"
  wrapper="$(provider_wrapper "$provider")"; [ -x "$wrapper" ] || die "provider wrapper is not executable: $wrapper"
  cli_bin="$(provider_cli_binary "$provider")" || die "could not resolve the $provider CLI binary to hash (is its command on PATH?)."

  # Auto-restore. This command runs because the pin is being updated in this
  # change, so a pin-mismatch quarantine recorded against the OLD pin is stale.
  # The clear is DEFERRED until qualification fully succeeds (including a
  # published record): clearing first would leave the provider usable if a
  # later step failed without re-quarantining (wrapper/CLI drift, publish
  # failure). A failure below either re-quarantines or leaves the stale
  # pin-mismatch in place, so an unqualified provider is never left usable.
  clear_stale_pin_mismatch=0
  if active_quarantine "$provider"; then
    if [ "$(printf '%s' "$ACTIVE_QUARANTINE" | jq -r '.failure_class // ""')" = pin-mismatch ]; then
      clear_stale_pin_mismatch=1
    else
      die "$provider has an active $(printf '%s' "$ACTIVE_QUARANTINE" | jq -r '.failure_class // "unknown"') quarantine; clear it before pin-bump qualification."
    fi
  fi

  before_sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  cli_sha="$(sha256sum "$cli_bin" | awk '{print $1}')"
  cli_version_text="$(timeout "${CHECK_TIMEOUT}s" "$cli_bin" --version 2>/dev/null || true)"
  cli_version="$("$policy_bin" parse "$cli_version_text")"
  mode="$("$policy_bin" match "$provider")"
  want="$("$policy_bin" required "$provider")"
  # A pin-bump lane with no pin is meaningless: ai-provider-version treats an
  # empty pin as a satisfied check, which would publish evidence that binds no
  # version at all. Refuse here; the provider simply has no pin to bump.
  [ -n "$want" ] || die "$provider has no version pin in config/provider-cli-versions.json; pin-bump-qualify is only for a pin bump."
  note "ai-review-preflight: pin-bump-qualify $provider: wrapper=$before_sha cli=$cli_sha version=${cli_version:-unreadable} policy=$mode:${want:-unpinned}"

  # Cheap fixed check 1: the wrapper doctor (binary present + health probe).
  set +e; out="$(timeout "${DOCTOR_PROBE_TIMEOUT}s" "$wrapper" doctor 2>&1)"; rc=$?; set -e
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then class=provider-timeout
    elif [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then class=probe-no-output
    else class="$(classify_failure "$out")"; fi
    quarantine "$provider" "$class"
    printf 'ai-review-preflight: pin-bump-qualify %s doctor failed: %s\n' "$provider" "$class" >&2
    printf '%s\n' "$out" | tail -12 >&2
    return 1
  fi

  # Kimi may borrow another user's credentials and execute THAT user's
  # ~/.kimi-code/bin/kimi for the live turn (ai-kimi run_turn). The bytes that
  # run are the switched user's binary, not the caller's — re-resolve and
  # re-hash those before the live smoke so evidence binds the tested bytes.
  if [ "$provider" = kimi ]; then
    switched_as="$(printf '%s' "$out" | sed -n 's/.*borrowed from user "\([^"]*\)".*/\1/p' | head -1)"
    if [ -n "$switched_as" ]; then
      switched_bin="$(su - "$switched_as" -c 'printf %s "$HOME/.kimi-code/bin/kimi"' 2>/dev/null || true)"
      if [ -n "$switched_bin" ] && [ -e "$switched_bin" ]; then
        cli_bin="$switched_bin"
        cli_sha="$(sha256sum "$cli_bin" | awk '{print $1}')"
        cli_version_text="$(timeout "${CHECK_TIMEOUT}s" "$cli_bin" --version 2>/dev/null || true)"
        cli_version="$("$policy_bin" parse "$cli_version_text")"
      else
        printf 'ai-review-preflight: kimi live smoke would run as user %s but its binary cannot be resolved; untested bytes are not authorized.\n' "$switched_as" >&2
        return 1
      fi
    fi
  fi

  # Cheap fixed check 2: the version pin. ai-provider-version enforces the
  # policy exactly as written — a "minimum" provider accepts newer same-major
  # builds, so this never becomes a hard exact pin on an auto-updater.
  set +e; "$policy_bin" check "$provider" "$cli_version_text" >/dev/null; rc=$?; set -e
  if [ "$rc" -ne 0 ]; then
    quarantine "$provider" pin-mismatch
    printf 'ai-review-preflight: pin-bump-qualify %s pin mismatch: installed version %s does not satisfy policy %s:%s.\n' \
      "$provider" "${cli_version:-unreadable}" "$mode" "${want:-unpinned}" >&2
    printf 'ai-review-preflight: auto-quarantined %s (pin-mismatch). Update the pin in this same change (or install a satisfying build) and re-run pin-bump-qualify to auto-restore.\n' "$provider" >&2
    return 1
  fi

  # One live smoke. A pin bump is blessed by exactly one live turn, not a full
  # re-qualification; behaviour changes still take the qualify path.
  set +e
  if [ "$provider" = muse ]; then
    out="$(AI_MUSE_CALLER=preflight timeout "${AI_REVIEW_MUSE_QUALIFY_TIMEOUT:-240}s" "$wrapper" doctor --live 2>&1)"; rc=$?
  elif [ "$provider" = gemini ]; then
    out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?
  elif [ "$provider" = stepfun ]; then
    out="$(timeout "${AI_REVIEW_STEPFUN_QUALIFY_TIMEOUT:-120}s" "$wrapper" doctor --live 2>&1)"; rc=$?
  else
    out="$(timeout "${LIVE_PROBE_TIMEOUT}s" "$wrapper" doctor --live 2>&1)"; rc=$?
  fi
  set -e
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then class=provider-timeout
    elif [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then class=probe-no-output
    else class="$(classify_failure "$out")"; fi
    quarantine "$provider" "$class"
    printf 'ai-review-preflight: pin-bump-qualify %s live smoke failed: %s\n' "$provider" "$class" >&2
    printf '%s\n' "$out" | tail -12 >&2
    return 1
  fi

  # Untested bytes are never authorized: neither the wrapper nor the provider
  # CLI may change under us during the canary (same rule as qualify_gemini /
  # qualify_qwen). The CLI hash is taken again here and must match the hash of
  # the bytes the live smoke actually exercised, so a CLI update mid-qualification
  # can never produce evidence for bytes that were not tested.
  after_sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  after_cli_sha="$(sha256sum "$cli_bin" | awk '{print $1}')"
  [ "$before_sha" = "$after_sha" ] || {
    printf 'ai-review-preflight: %s wrapper changed during pin-bump qualification; untested bytes are not authorized.\n' "$provider" >&2
    return 1
  }
  [ "$cli_sha" = "$after_cli_sha" ] || {
    printf 'ai-review-preflight: %s provider CLI changed during pin-bump qualification; untested bytes are not authorized.\n' "$provider" >&2
    return 1
  }

  # Record in the existing hash-pin store (qualification_file), never a second
  # store. The record is evidence of this cheap bless; it does NOT gate the
  # provider (not in LIVE_QUALIFIED_PROVIDERS), so a later auto-update under
  # the floor policy keeps working without a re-run.
  file="$(qualification_file "$provider")"
  prior_raw="$(cat "$file" 2>/dev/null || true)"
  prior_versions="$(qualification_versions "$provider")"
  now="$(now_epoch)"
  publish_qualification_version "$provider" "$prior_versions" \
    "$(jq -nc --arg sha "$after_sha" --arg cli "$after_cli_sha" --arg ver "$cli_version" --arg mode "$mode" --arg want "$want" --argjson at "$now" \
        '{wrapper_sha256:$sha,cli_sha256:$cli,cli_version:$ver,policy_mode:$mode,policy_version:$want,qualified_epoch:$at}')" \
    || { restore_qualification_versions "$provider" "$prior_raw"; printf 'ai-review-preflight: %s pin-bump qualification did not publish; the previous record stays valid.\n' "$provider" >&2; return 1; }
  # Only now is it safe to drop a stale pin-mismatch quarantine: the new
  # qualification record is on disk. Anything that failed above left the
  # provider quarantined (or re-quarantined it).
  if [ "$clear_stale_pin_mismatch" = 1 ]; then
    admission_store clear "$provider" >/dev/null
    note "ai-review-preflight: cleared stale pin-mismatch quarantine for $provider (the pin is being updated in this change)."
  fi
  note "ai-review-preflight: pin-bump-qualified $provider (wrapper $after_sha, cli $after_cli_sha, version ${cli_version:-unreadable}, policy $mode:${want:-unpinned})."
  printf 'PASS pin-bump-qualify provider=%s cli_version=%s policy=%s:%s cli_sha256=%s\n' \
    "$provider" "${cli_version:-unreadable}" "$mode" "${want:-unpinned}" "$after_cli_sha"
}

usage() {
  cat <<EOF
Usage:
  ai-review-preflight check <provider> <repo> [--base REF] [--live]
  ai-review-preflight quarantine <provider> <failure-class> [--seconds N]
  ai-review-preflight clear <provider>
  ai-review-preflight qualify gemini|qwen
  ai-review-preflight pin-bump-qualify <provider>
  ai-review-preflight requalify [provider]
  ai-review-preflight status [provider]
  ai-review-preflight usable [provider]
  ai-review-preflight explain <failure-class>
  ai-review-preflight capacity <provider> --json
  ai-review-preflight admission <provider> --profile HASH --model MODEL --json
  ai-review-preflight profile <provider> --home PATH
  ai-review-preflight effective-profile kimi
  ai-review-preflight observe-refusal <provider> --profile HASH --model MODEL --run-id ID --observed EPOCH --seconds N --reason usage-limit --evidence FILE
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  effective-profile)
    [ "${1:-}" = kimi ] && [ "$#" = 1 ] || die 'effective-profile requires kimi.'
    kimi_effective_profile ;;
  profile)
    provider="${1:-}"; shift || true
    valid_provider "$provider" || die "unknown provider '$provider'."
    admission_store profile "$provider" "$@" ;;
  admission|observe-refusal)
    provider="${1:-}"; shift || true
    valid_provider "$provider" || die "unknown provider '$provider'."
    admission_args=()
    for arg in "$@"; do [ "$arg" = --json ] || admission_args+=("$arg"); done
    action=admission; [ "$cmd" != observe-refusal ] || action=observe
    admission_store "$action" "$provider" "${admission_args[@]}" ;;
  capacity)
    provider="${1:-}"; shift || true
    [ "${1:-}" = --json ] || die 'capacity requires --json.'
    shift
    [ "$#" -eq 0 ] || die "unexpected argument '$1'."
    capacity_result "$provider" ;;
  check)
    provider="${1:-}"; repo="${2:-}"; shift 2 || true; live=0; base=""
    while [ "$#" -gt 0 ]; do case "$1" in --live) live=1; shift ;; --base) base="${2:-}"; shift 2 ;; *) die "unknown option '$1'." ;; esac; done
    check_provider "$provider" "$repo" "$live" "$base" ;;
  quarantine)
    provider="${1:-}"; class="${2:-}"; shift 2 || true; seconds="$COOLDOWN"
    [ "${1:-}" != --seconds ] || { seconds="${2:-}"; shift 2; }
    [ "$#" -eq 0 ] || die "unexpected argument '$1'."
    quarantine "$provider" "$class" "$seconds" ;;
  clear)
    provider="${1:-}"; valid_provider "$provider" || die "unknown provider '$provider'."
    admission_store clear "$provider" >/dev/null; note "ai-review-preflight: cleared $provider quarantine and scoped backoffs." ;;
  qualify)
    [ "$#" -eq 1 ] || die 'usage: ai-review-preflight qualify gemini|qwen'
    case "${1:-}" in gemini) qualify_gemini ;; qwen) qualify_qwen ;; *) die 'usage: ai-review-preflight qualify gemini|qwen' ;; esac ;;
  pin-bump-qualify)
    [ "$#" -eq 1 ] || die 'usage: ai-review-preflight pin-bump-qualify <provider>'
    pin_bump_qualify "$1" ;;
  requalify) requalify "$@" ;;
  status)
    provider="${1:-}"
    if [ -n "$provider" ]; then valid_provider "$provider" || die "unknown provider '$provider'."; providers=("$provider")
    else providers=(claude grok kimi glm muse gemini qwen codex deepseek stepfun); fi
    for provider in "${providers[@]}"; do emit_status "$provider" || true; done ;;
  usable)
    provider="${1:-}"
    if [ -n "$provider" ]; then valid_provider "$provider" || die "unknown provider '$provider'."; providers=("$provider")
    else providers=(claude grok kimi glm muse gemini qwen codex deepseek stepfun); fi
    usable_rc=0
    for provider in "${providers[@]}"; do emit_status "$provider" || usable_rc=3; done
    exit "$usable_rc" ;;
  explain) explain_failure "${1:-}" ;;
  --version) printf 'ai-review-preflight %s\n' "$VERSION" ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
