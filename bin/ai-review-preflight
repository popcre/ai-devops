#!/usr/bin/env bash
# ai-review-preflight - fast provider health checks and temporary quarantine.
#
# WHY THIS EXISTS
# A provider that is logged out, out of allowance, or locally unavailable must
# be rejected before it receives a durable review assignment. A failed check is
# not a review attempt. Quarantine prevents the next caller from immediately
# assigning the same unhealthy provider again.
set -euo pipefail

VERSION="1.1.2"
STATE_DIR="${AI_REVIEW_QUARANTINE_DIR:-$HOME/.local/state/ai-devops/review-quarantine}"
CHECK_TIMEOUT="${AI_REVIEW_PREFLIGHT_TIMEOUT:-10}"
COOLDOWN="${AI_REVIEW_QUARANTINE_SECONDS:-1800}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die()  { printf 'ai-review-preflight: error: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

valid_provider() { case "$1" in claude|grok|kimi|glm|muse|gemini|qwen|codex|deepseek) return 0 ;; *) return 1 ;; esac; }
provider_file() { printf '%s/%s.json' "$STATE_DIR" "$1"; }
qualification_file() { printf '%s/%s-live-qualified.json' "$STATE_DIR" "$1"; }
now_epoch() { date +%s; }
gemini_live_qualified() {
  local file wrapper expected actual expected_agy actual_agy expected_agy_sha actual_agy_sha expected_model actual_model out rc
  file="$(qualification_file gemini)"; [ -f "$file" ] || return 1
  wrapper="$(provider_wrapper gemini)"; [ -f "$wrapper" ] || return 1
  jq -e '.version==2 and .provider=="gemini" and (.wrapper_sha256|type=="string" and test("^[0-9a-f]{64}$")) and (.agy_sha256|type=="string" and test("^[0-9a-f]{64}$")) and (.agy_version|type=="string" and length>0) and (.model|type=="string" and length>0) and (.qualified_epoch|type=="number")' "$file" >/dev/null 2>&1 || return 1
  expected="$(jq -r .wrapper_sha256 "$file")"; expected_agy="$(jq -r .agy_version "$file")"; expected_agy_sha="$(jq -r .agy_sha256 "$file")"; expected_model="$(jq -r .model "$file")"
  actual="$(sha256sum "$wrapper" 2>/dev/null | awk '{print $1}')"
  set +e; out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; rc=$?; set -e
  [ "$rc" -eq 0 ] || return 1
  actual_agy="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=\([^ ]*\) agy_sha256=.*/\1/p')"
  actual_agy_sha="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"
  actual_model="$(printf '%s\n' "$out" | sed -n 's/^IDENTITY agy=[^ ]* agy_sha256=[0-9a-f]\{64\} model=\([^ ]*\) .*/\1/p')"
  [ -n "$expected" ] && [ "$expected" = "$actual" ] && [ "$expected_agy" = "$actual_agy" ] && [ "$expected_agy_sha" = "$actual_agy_sha" ] && [ "$expected_model" = "$actual_model" ]
}
qwen_live_qualified() {
  local file wrapper expected actual expected_runtime actual_runtime expected_preloader actual_preloader
  file="$(qualification_file qwen)"; [ -f "$file" ] || return 1
  wrapper="$(provider_wrapper qwen)"; [ -f "$wrapper" ] || return 1
  expected="$(jq -r '.wrapper_sha256 // empty' "$file" 2>/dev/null)"
  expected_runtime="$(jq -r '.runtime_sha256 // empty' "$file" 2>/dev/null)"
  expected_preloader="$(jq -r '.preloader_sha256 // empty' "$file" 2>/dev/null)"
  actual="$(sha256sum "$wrapper" 2>/dev/null | awk '{print $1}')"
  actual_runtime="$(qwen_runtime_sha "$wrapper" || true)"
  actual_preloader="$(qwen_preloader_sha "$wrapper" || true)"
  [ -n "$expected" ] && [ "$expected" = "$actual" ] && [ -n "$expected_runtime" ] && [ "$expected_runtime" = "$actual_runtime" ] && [ -n "$expected_preloader" ] && [ "$expected_preloader" = "$actual_preloader" ]
}
qwen_runtime_sha() { # WRAPPER [DOCTOR_OUTPUT]
  local wrapper="$1" out="${2:-}" value count
  [ -n "$out" ] || out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$out" | grep -Ec '^qwen runtime sha256:[[:space:]]*[0-9a-f]{64}$' || true)"
  [ "$count" -eq 1 ] || return 1
  value="$(printf '%s\n' "$out" | sed -n 's/^qwen runtime sha256:[[:space:]]*\([0-9a-f]\{64\}\)$/\1/p')"
  [ -n "$value" ] || return 1; printf '%s' "$value"
}
qwen_preloader_sha() { # WRAPPER [DOCTOR_OUTPUT]
  local wrapper="$1" out="${2:-}" value count
  [ -n "$out" ] || out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$out" | grep -Ec '^qwen preloader sha256:[[:space:]]*[0-9a-f]{64}$' || true)"
  [ "$count" -eq 1 ] || return 1
  value="$(printf '%s\n' "$out" | sed -n 's/^qwen preloader sha256:[[:space:]]*\([0-9a-f]\{64\}\)$/\1/p')"
  [ -n "$value" ] || return 1; printf '%s' "$value"
}
static_status() {
  case "$1" in
    gemini) gemini_live_qualified && return 1; printf '{"provider":"gemini","status":"quarantined","failure_class":"live-qualification-required"}\n'; return 0 ;;
    qwen) qwen_live_qualified && return 1; printf '{"provider":"qwen","status":"quarantined","failure_class":"live-qualification-required"}\n'; return 0 ;;
    *) return 1 ;;
  esac
}

PREFLIGHT_REPO=""
PREFLIGHT_TAG=""
PREFLIGHT_SANDBOX=""
cleanup_check() {
  [ -z "$PREFLIGHT_SANDBOX" ] || "${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet}" remove "$PREFLIGHT_SANDBOX" "$PREFLIGHT_TAG" >/dev/null 2>&1 || true
  [ -z "$PREFLIGHT_REPO" ] || "${AI_REVIEW_SANDBOX_BIN:-$SCRIPT_DIR/ai-review-sandbox}" remove-copy "$PREFLIGHT_REPO" "$PREFLIGHT_TAG" >/dev/null 2>&1 || true
}

write_atomic() { # FILE JSON
  local f="$1" tmp
  mkdir -p "$(dirname "$f")"; chmod 0700 "$(dirname "$f")" 2>/dev/null || true
  tmp="$(mktemp "$(dirname "$f")/.preflight.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; chmod 0600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f"
}

quarantine() { # PROVIDER CLASS [SECONDS]
  local provider="$1" class="$2" seconds="${3:-$COOLDOWN}" now expires f
  valid_provider "$provider" || die "unknown provider '$provider'."
  case "$seconds" in ''|*[!0-9]*) die "quarantine seconds must be a positive integer." ;; esac
  [ "$seconds" -gt 0 ] || die "quarantine seconds must be greater than zero."
  now="$(now_epoch)"; expires=$((now + seconds)); f="$(provider_file "$provider")"
  write_atomic "$f" "$(jq -nc --arg provider "$provider" --arg class "$class" \
    --argjson created "$now" --argjson expires "$expires" \
    '{version:1,provider:$provider,failure_class:$class,created_epoch:$created,expires_epoch:$expires}')"
  note "ai-review-preflight: quarantined $provider for ${seconds}s ($class)."
}

active_quarantine() { # PROVIDER -> 0 active, 1 absent/expired
  local f now expires
  f="$(provider_file "$1")"; [ -f "$f" ] || return 1
  jq -e --arg p "$1" '.version==1 and .provider==$p and (.expires_epoch|type=="number")' "$f" >/dev/null 2>&1 \
    || die "invalid quarantine record: $f"
  now="$(now_epoch)"; expires="$(jq -r .expires_epoch "$f")"
  if [ "$expires" -le "$now" ]; then rm -f "$f"; return 1; fi
  return 0
}

classify_failure() { # OUTPUT
  local text; text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$text" in
    *403*|*429*|*allowance*|*usage.limit*|*quota*|*out.of.credit*) printf allowance-exhausted ;;
    *not.authenticated*|*login*required*|*credential*|*unauthorized*|*401*) printf authentication-failed ;;
    *timed.out*|*timeout*) printf provider-timeout ;;
    *unreachable*|*connection.refused*|*health.endpoint*failed*|*service*unavailable*) printf service-unavailable ;;
    *) printf provider-unhealthy ;;
  esac
}

explain_failure() {
  case "$1" in
    allowance-exhausted) printf 'Quarantine this provider. Do not assign another review until the cooling period expires.\n' ;;
    broken-snapshot) printf 'Rebuild once with ai-review-sandbox. If it still fails, quarantine the provider; never use a raw linked worktree.\n' ;;
    empty-assistant-turns) printf 'Stop within 2-3 minutes and report no usable answer. Do not keep retrying empty turns.\n' ;;
    turn-exhaustion) printf 'Do not increase the turn ceiling automatically. Check for a vague brief, an oversized change, or reviewer wandering, then narrow the work.\n' ;;
    service-unavailable) printf 'Retry the service check once after a short delay, then wait. Do not misclassify an outage as a code verdict.\n' ;;
    substantive-finding) printf 'Stop and fix the finding. Never rotate providers to shop for a friendlier verdict.\n' ;;
    authentication-failed|provider-timeout|provider-unhealthy) printf 'Quarantine this provider and correct the named health failure before assigning a review.\n' ;;
    *) die "unknown failure class '$1'." ;;
  esac
}

provider_wrapper() {
  case "$1" in
    claude) printf '%s' "${AI_REVIEW_CLAUDE_WRAPPER:-$SCRIPT_DIR/ai-claude-review}" ;;
    grok) printf '%s' "${AI_REVIEW_GROK_WRAPPER:-$SCRIPT_DIR/ai-grok-review}" ;;
    kimi) printf '%s' "${AI_REVIEW_KIMI_WRAPPER:-$SCRIPT_DIR/ai-kimi}" ;;
    glm)  printf '%s' "${AI_REVIEW_GLM_WRAPPER:-$SCRIPT_DIR/ai-glm}" ;;
    muse) printf '%s' "${AI_REVIEW_MUSE_WRAPPER:-$SCRIPT_DIR/ai-muse}" ;;
    gemini) printf '%s' "${AI_REVIEW_GEMINI_WRAPPER:-$SCRIPT_DIR/ai-gemini}" ;;
    qwen) printf '%s' "${AI_REVIEW_QWEN_WRAPPER:-$SCRIPT_DIR/ai-qwen}" ;;
    codex) printf '%s' "${AI_REVIEW_CODEX_WRAPPER:-$SCRIPT_DIR/ai-codex-review}" ;;
    deepseek) printf '%s' "${AI_REVIEW_DEEPSEEK_WRAPPER:-$SCRIPT_DIR/ai-deepseek-agent}" ;;
  esac
}

qualify_qwen() {
  local wrapper out rc sha runtime_sha preloader_sha now file
  wrapper="$(provider_wrapper qwen)"; [ -x "$wrapper" ] || die "Qwen wrapper is not executable: $wrapper"
  set +e; out="$(timeout "${AI_REVIEW_QWEN_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?; set -e
  [ "$rc" = 0 ] || { printf 'ai-review-preflight: Qwen live qualification failed; quarantine remains.\n%s\n' "$out" >&2; return 1; }
  runtime_sha="$(qwen_runtime_sha "$wrapper" "$out")" || { printf 'ai-review-preflight: Qwen live qualification did not identify one exact installed runtime hash; quarantine remains.\n' >&2; return 1; }
  preloader_sha="$(qwen_preloader_sha "$wrapper" "$out")" || { printf 'ai-review-preflight: Qwen live qualification did not identify one exact credential-preloader hash; quarantine remains.\n' >&2; return 1; }
  sha="$(sha256sum "$wrapper" | awk '{print $1}')"; now="$(now_epoch)"; file="$(qualification_file qwen)"
  write_atomic "$file" "$(jq -nc --arg provider qwen --arg sha "$sha" --arg runtime "$runtime_sha" --arg preloader "$preloader_sha" --argjson at "$now" '{version:3,provider:$provider,wrapper_sha256:$sha,runtime_sha256:$runtime,preloader_sha256:$preloader,qualified_epoch:$at}')"
  note "ai-review-preflight: Qwen live qualification recorded for wrapper $sha, runtime $runtime_sha, and credential preloader $preloader_sha."
}

qualify_gemini() {
  local wrapper out rc sha before_sha agy_version before_agy agy_sha before_agy_sha model before_model now file doctor_out before_doctor count
  wrapper="$(provider_wrapper gemini)"; [ -x "$wrapper" ] || die "Gemini wrapper is not executable: $wrapper"
  file="$(qualification_file gemini)"; rm -f "$file"
  before_sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  set +e; before_doctor="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; set -e
  before_agy="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=\([^ ]*\) agy_sha256=.*/\1/p')"; before_agy_sha="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"; before_model="$(printf '%s\n' "$before_doctor" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=[0-9a-f]\{64\} model=\([^ ]*\) .*/\1/p')"
  [ -n "$before_agy" ] && [ -n "$before_agy_sha" ] && [ -n "$before_model" ] || { printf 'ai-review-preflight: Gemini qualification could not identify the pre-canary runtime and model; quarantine remains.\n' >&2; return 1; }
  set +e; out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" qualify-live 2>&1)"; rc=$?; set -e
  [ "$rc" = 0 ] || { printf 'ai-review-preflight: Gemini live qualification failed; quarantine remains.\n%s\n' "$out" >&2; return 1; }
  count="$(printf '%s\n' "$out" | grep -Ec '^QUALIFIED session=[^ ]+ model=[^ ]+ exact-resume=yes mutation-request=no-change outside-sentinel=unchanged reports=durable fixture=.+$' || true)"
  [ "$count" -eq 1 ] || { printf 'ai-review-preflight: Gemini live qualification did not return one exact QUALIFIED contract; quarantine remains.\n' >&2; return 1; }
  model="$(printf '%s\n' "$out" | sed -n 's/^QUALIFIED session=[^ ]* model=\([^ ]*\) exact-resume=yes mutation-request=no-change outside-sentinel=unchanged reports=durable fixture=.*$/\1/p')"
  set +e; doctor_out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --identity 2>/dev/null)"; set -e
  agy_version="$(printf '%s\n' "$doctor_out" | sed -n 's/^[A-Z]* agy=\([^ ]*\) agy_sha256=.*/\1/p')"; agy_sha="$(printf '%s\n' "$doctor_out" | sed -n 's/^[A-Z]* agy=[^ ]* agy_sha256=\([0-9a-f]\{64\}\) model=.*/\1/p')"
  [ -n "$agy_version" ] && [ -n "$model" ] || { printf 'ai-review-preflight: Gemini qualification could not bind the runtime version and model; quarantine remains.\n' >&2; return 1; }
  printf '%s\n' "$doctor_out" | grep -q " model=$model " || { printf 'ai-review-preflight: Gemini qualification model disagrees with the wrapper doctor; quarantine remains.\n' >&2; return 1; }
  sha="$(sha256sum "$wrapper" | awk '{print $1}')"
  [ "$before_sha" = "$sha" ] && [ "$before_agy" = "$agy_version" ] && [ "$before_agy_sha" = "$agy_sha" ] && [ "$before_model" = "$model" ] || { printf 'ai-review-preflight: Gemini wrapper, runtime, or model changed during qualification; quarantine remains.\n' >&2; return 1; }
  now="$(now_epoch)"
  write_atomic "$file" "$(jq -nc --arg provider gemini --arg sha "$sha" --arg agy "$agy_version" --arg agy_sha "$agy_sha" --arg model "$model" --argjson at "$now" '{version:2,provider:$provider,wrapper_sha256:$sha,agy_version:$agy,agy_sha256:$agy_sha,model:$model,qualified_epoch:$at}')"
  gemini_live_qualified || { rm -f "$file"; printf 'ai-review-preflight: Gemini qualification record did not validate after writing; quarantine remains.\n' >&2; return 1; }
  note "ai-review-preflight: Gemini live qualification recorded for wrapper $sha, agy $agy_version, and model $model."
}

check_provider() { # PROVIDER REPO LIVE BASE
  local provider="$1" repo="$2" live="$3" base="$4" wrapper sandbox packet tag out rc class
  valid_provider "$provider" || die "unknown provider '$provider'."
  [ -d "$repo" ] || die "review directory does not exist: $repo"
  repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || die "not a Git repository: $repo"
  need jq; need git; need timeout
  if active_quarantine "$provider"; then
    jq -r '"ai-review-preflight: " + .provider + " is quarantined until epoch " + (.expires_epoch|tostring) + " (" + .failure_class + ")."' "$(provider_file "$provider")" >&2
    return 3
  fi
  if static_status "$provider" >/dev/null; then
    static_status "$provider" >&2
    case "$provider" in gemini|qwen) return 3 ;; *) return 4 ;; esac
  fi

  git -C "$repo" rev-parse --verify HEAD^{commit} >/dev/null 2>&1 || die "repository has no readable HEAD commit."
  [ -z "$base" ] || git -C "$repo" rev-parse --verify "$base^{commit}" >/dev/null 2>&1 \
    || die "base ref does not resolve: $base"

  tag="preflight-$provider-$$"
  # Always isolate preflight. Ordinary wrappers keep their packet in an
  # ordinary clone while a reviewer reads it; a preflight packet must never
  # replace or delete that live evidence.
  sandbox="$(${AI_REVIEW_SANDBOX_BIN:-$SCRIPT_DIR/ai-review-sandbox} ensure-copy "$repo" "$tag")"
  PREFLIGHT_REPO="$repo"; PREFLIGHT_TAG="$tag"; PREFLIGHT_SANDBOX="$sandbox"
  trap cleanup_check EXIT
  packet="$(${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet} build "$sandbox" "$tag" ${base:+--base "$base"})"
  "${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet}" verify "$packet" >/dev/null
  wrapper="$(provider_wrapper "$provider")"; [ -x "$wrapper" ] || die "provider wrapper is not executable: $wrapper"
  set +e
  if [ "$provider" = muse ]; then
    if [ "$live" = 1 ]; then out="$(AI_MUSE_CALLER=preflight timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --live 2>&1)"; rc=$?
    else out="$(AI_MUSE_CALLER=preflight timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>&1)"; rc=$?; fi
  elif [ "$live" = 1 ] && [ "$provider" != glm ]; then
    if [ "$provider" = gemini ]; then out="$(timeout "${AI_REVIEW_GEMINI_QUALIFY_TIMEOUT:-1800}s" "$wrapper" doctor --live 2>&1)"; rc=$?
    else out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor --live 2>&1)"; rc=$?; fi
  else
    out="$(timeout "${CHECK_TIMEOUT}s" "$wrapper" doctor 2>&1)"; rc=$?
  fi
  set -e
  if [ "$rc" -ne 0 ]; then
    class="$(classify_failure "$out")"; quarantine "$provider" "$class"
    printf 'ai-review-preflight: %s failed: %s\n' "$provider" "$class" >&2
    printf '%s\n' "$out" | tail -12 >&2
    return 1
  fi
  printf 'PASS provider=%s repository=%s packet=verified health=ok allowance=%s\n' \
    "$provider" "$repo" "$([ "$live" = 1 ] && [ "$provider" != glm ] && printf live-verified || printf not-separately-exposed)"
}

usage() {
  cat <<EOF
Usage:
  ai-review-preflight check <provider> <repo> [--base REF] [--live]
  ai-review-preflight quarantine <provider> <failure-class> [--seconds N]
  ai-review-preflight clear <provider>
  ai-review-preflight qualify gemini|qwen
  ai-review-preflight status [provider]
  ai-review-preflight explain <failure-class>
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  check)
    provider="${1:-}"; repo="${2:-}"; shift 2 || true; live=0; base=""
    while [ "$#" -gt 0 ]; do case "$1" in --live) live=1; shift ;; --base) base="${2:-}"; shift 2 ;; *) die "unknown option '$1'." ;; esac; done
    check_provider "$provider" "$repo" "$live" "$base" ;;
  quarantine)
    provider="${1:-}"; class="${2:-}"; shift 2 || true; seconds="$COOLDOWN"
    [ "${1:-}" != --seconds ] || { seconds="${2:-}"; shift 2; }
    [ "$#" -eq 0 ] || die "unexpected argument '$1'."
    quarantine "$provider" "$class" "$seconds" ;;
  clear)
    provider="${1:-}"; valid_provider "$provider" || die "unknown provider '$provider'."
    rm -f "$(provider_file "$provider")"; note "ai-review-preflight: cleared $provider quarantine." ;;
  qualify)
    [ "$#" -eq 1 ] || die 'usage: ai-review-preflight qualify gemini|qwen'
    case "${1:-}" in gemini) qualify_gemini ;; qwen) qualify_qwen ;; *) die 'usage: ai-review-preflight qualify gemini|qwen' ;; esac ;;
  status)
    provider="${1:-}"
    if [ -n "$provider" ]; then valid_provider "$provider" || die "unknown provider '$provider'."; providers=("$provider")
    else providers=(claude grok kimi glm muse gemini qwen codex deepseek); fi
    for provider in "${providers[@]}"; do
      if static_status "$provider"; then :
      elif active_quarantine "$provider"; then jq -c '. + {status:"quarantined"}' "$(provider_file "$provider")"
      else printf '{"provider":"%s","status":"available"}\n' "$provider"; fi
    done ;;
  explain) explain_failure "${1:-}" ;;
  --version) printf 'ai-review-preflight %s\n' "$VERSION" ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
