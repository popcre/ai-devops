#!/usr/bin/env bash
# ai-reviewer-logs-sync — collect this machine's complete reviewer logs into
# the private fleet-wide repository u2giants/ai-devops-reviewer-logs, so one AI
# session can see every machine's reviewer evidence in one place.
#
# Usage:
#   ai-reviewer-logs-sync [sync]   copy, scrub secret values, commit, push
#   ai-reviewer-logs-sync schedule register an hourly run (Task Scheduler / crontab)
#   ai-reviewer-logs-sync unschedule
#
# Layout in the repository (one folder per machine, append-only):
#   <machine>/reviewer-issues/   full incident packages (ai-reviewer-issue)
#   <machine>/state/             review scoreboard, invocation events, lifecycle runs
#   <machine>/reviews/<checkout>/ review reports (.ai/reviews) from every checkout
#   <machine>/LAST-SYNC.txt      when and what was collected; SKIPPED.txt lists
#                                files left out (too large or binary)
#
# Content is copied unchanged except recognizable secret VALUES (tokens, keys,
# private-key blocks, labeled passwords), which become [REDACTED-SECRET]. A push
# is refused if any secret pattern survives. The repository must be private:
# unauthenticated access has to fail before anything is pushed.
#
# Environment:
#   AI_REVIEWER_LOGS_REMOTE         remote URL (default the private fleet repository)
#   AI_REVIEWER_LOGS_HUB            local clone (default ~/.cache/ai-devops-reviewer-logs)
#   AI_REVIEWER_LOGS_ROOTS          colon-separated folders holding checkouts to scan
#                                   for .ai/reviews (default: the toolkit's parent
#                                   folder plus /c/repos /d/repos ~/repos /worksp)
#   AI_REVIEWER_LOGS_MAX_FILE_BYTES largest file copied (default 5000000)
#   AI_REVIEWER_LOGS_MACHINE        machine folder name (default lowercased hostname)
#   AI_REVIEWER_ISSUE_DIR, AI_REVIEWER_STATE_BASE  as in ai-reviewer-issue
#   AI_REVIEWER_LOGS_TEST_MODE=1    tests: allow a local remote, skip the privacy probe
set -euo pipefail

_self="${BASH_SOURCE[0]}"
TOOL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
TOOL_NAME=ai-reviewer-logs-sync
HOME_DIR="$HOME/.ai-devops/reviewer-logs-sync"
# shellcheck source=../tools/lib/local-watch.sh
. "$TOOL_ROOT/tools/lib/local-watch.sh"

CANONICAL="github.com/u2giants/ai-devops-reviewer-logs"
REMOTE="${AI_REVIEWER_LOGS_REMOTE:-https://$CANONICAL.git}"
HUB="${AI_REVIEWER_LOGS_HUB:-$HOME/.cache/ai-devops-reviewer-logs}"
STATE="${AI_REVIEWER_STATE_BASE:-$HOME/.local/state/ai-devops}"
ISSUES="${AI_REVIEWER_ISSUE_DIR:-$TOOL_ROOT/.ai/reviewer-issues}"
MAX_BYTES="${AI_REVIEWER_LOGS_MAX_FILE_BYTES:-5000000}"
MACHINE="$(printf '%s' "${AI_REVIEWER_LOGS_MACHINE:-$(hostname)}" | lower | tr -c 'a-z0-9.-' '-')"
case "$MACHINE" in ''|.*|*..*) die "invalid machine folder name: $MACHINE" ;; esac
LOG="$HOME_DIR/sync.log"

# Detects survivors; the scrub below replaces whole values for each family.
SECRET_RE='Basic[[:space:]]+[A-Za-z0-9+/]{8,}|npm_[A-Za-z0-9]{36}|AIza[0-9A-Za-z_-]{35}|glpat-[A-Za-z0-9_-]{20}|[rs]k_live_[A-Za-z0-9]{20}|hooks\.slack\.com/services/T[A-Za-z0-9]+/|[a-z][a-z0-9+.-]*://[^/[:space:]:@]+:[^[/[:space:]@][^/[:space:]@]{2,}@|ops_[A-Za-z0-9]{20}|gh[pousr]_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|xox[baprs]-[A-Za-z0-9-]{10}|sk-[A-Za-z0-9]{20}|eyJ[A-Za-z0-9_-]{18,}\.[A-Za-z0-9_-]{18,}\.'
R='[REDACTED-SECRET]'
# Credential labels, including composite names such as AWS_SECRET_ACCESS_KEY.
# Anything after the keyword must start with a separator, so usage counters such
# as input_tokens or max_tokens are not credential labels and stay readable.
LABEL="[A-Za-z0-9_.-]*(api[_ -]?key|access[_ -]?key|private[_ -]?key|token|secret|password|passwd|pwd|authorization|credential)([_.-][A-Za-z0-9_.-]*)?"
# Any labeled value that is not already masked.
VALUE="[^\"'[:space:],}[]"
LABELED_RE="$LABEL[\"']?[[:space:]]*[:=][[:space:]]*[\"']?$VALUE"

log(){ mkdir -p "$HOME_DIR"; printf '%s %s\n' "$(stamp)" "$*" | tee -a "$LOG" >&2; }

canonical_remote(){
  printf '%s\n' "$1" | sed -E -e 's#^(https?://|ssh://)?([^@/]+@)?##' -e 's#^github\.com:#github.com/#' -e 's#\.git$##' -e 's#/$##'
}

scrub(){
  sed -E -i \
    -e "/-----BEGIN [A-Z ]*PRIVATE KEY-----/,/-----END [A-Z ]*PRIVATE KEY-----/c\\$R" \
    -e "s/npm_[A-Za-z0-9]{36,}/$R/g" \
    -e "s/AIza[0-9A-Za-z_-]{35}/$R/g" \
    -e "s/glpat-[A-Za-z0-9_-]{20,}/$R/g" \
    -e "s/[rs]k_live_[A-Za-z0-9]{20,}/$R/g" \
    -e "s#hooks\.slack\.com/services/[A-Za-z0-9/]+#hooks.slack.com/services/$R#g" \
    -e "s#([a-z][a-z0-9+.-]*://[^/[:space:]:@]+:)[^/[:space:]@]{3,}@#\\1$R@#g" \
    -e "s/ops_[A-Za-z0-9]{20,}/$R/g" \
    -e "s/gh[pousr]_[A-Za-z0-9]{20,}/$R/g" \
    -e "s/github_pat_[A-Za-z0-9_]{20,}/$R/g" \
    -e "s/AKIA[0-9A-Z]{16}/$R/g" \
    -e "s/xox[baprs]-[A-Za-z0-9-]{10,}/$R/g" \
    -e "s/sk-[A-Za-z0-9_-]{20,}/$R/g" \
    -e "s/eyJ[A-Za-z0-9_-]{18,}\.[A-Za-z0-9_-]{18,}\.[A-Za-z0-9_-]*/$R/g" \
    -e "s/(Bearer[[:space:]]+)[A-Za-z0-9._~+\/=-]{12,}/\\1$R/g" \
    -e "s/(Basic[[:space:]]+)[A-Za-z0-9+\/]{8,}={0,2}/\\1$R/g" \
    -e "s/($LABEL[\"']?[[:space:]]*[:=][[:space:]]*\")[^\"[][^\"]*\"/\\1$R\"/Ig" \
    -e "s/($LABEL[\"']?[[:space:]]*[:=][[:space:]]*')[^'[][^']*'/\\1$R'/Ig" \
    -e "s/($LABEL[\"']?[[:space:]]*[:=][[:space:]]*)$VALUE.*$/\\1$R/Ig" \
    "$1"
}

# copy_tree <source dir> <destination relative to the machine folder>
copy_tree(){
  local src="$1" dest="$HUB/$MACHINE/$2" file rel target size line digest
  [ -d "$src" ] || return 0
  # One hashing pass per tree: a file is re-collected whenever its content changes.
  # Unreadable or vanished files are recorded in $ERRS and fail the run at the end.
  local sums="$HOME_DIR/sums.$$"
  find "$src" -type f ! -name '*.tmp' -print0 2>>"$ERRS" | xargs -0 -r sha1sum -z -- > "$sums" 2>>"$ERRS" \
    || printf 'hashing failed under %s\n' "$2" >> "$ERRS"
  while IFS= read -r -d '' line; do
    # "<40-hex digest><space><' ' or '*' mode marker><path>"
    digest="${line:0:40}"; file="${line:42}"
    rel="${file#"$src"/}"
    shopt -s nocasematch
    case "$rel" in
      *.env|*.env.*|.env|*.pem|*.key|*.p12|*.pfx|*id_rsa*|*id_ed25519*) printf '%s/%s\tsecret file type\n' "$2" "$rel" >> "$SKIPPED"; continue ;;
    esac
    if printf '%s' "$rel" | grep -Eqi "$SECRET_RE|$LABELED_RE"; then
      printf '%s/[name withheld: looks like a secret]\tsecret in file name\n' "$2" >> "$SKIPPED"; continue
    fi
    target="$dest/$rel"
    NEW_SEEN["$file"]="$digest"
    # Collected before and the content is unchanged.
    if [ -f "$target" ] && [ "${SEEN[$file]:-}" = "$digest" ]; then continue; fi
    size="$(wc -c < "$file")"
    if [ "$size" -gt "$MAX_BYTES" ]; then
      printf '%s/%s\t%s bytes, over the size limit\n' "$2" "$rel" "$size" >> "$SKIPPED"; continue
    fi
    if [ "$size" -gt 0 ] && ! grep -Iq . "$file"; then
      printf '%s/%s\tbinary\n' "$2" "$rel" >> "$SKIPPED"; continue
    fi
    mkdir -p "$(dirname "$target")"
    cp -f "$file" "$target.tmp"
    scrub "$target.tmp"
    if [ -f "$target" ] && cmp -s "$target.tmp" "$target"; then rm -f "$target.tmp"; continue; fi
    mv -f "$target.tmp" "$target"
    COPIED=$((COPIED + 1))
  done < "$sums"
  rm -f "$sums"
}

ensure_hub(){
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$REMOTE")" = "$CANONICAL" ] || die "remote is not the private reviewer-logs repository"
    if GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never git -c credential.helper= -c core.askPass= \
        ls-remote "https://$CANONICAL.git" >/dev/null 2>&1; then
      die "reviewer-logs repository is publicly readable; refusing to sync"
    fi
  fi
  if [ ! -d "$HUB/.git" ]; then
    mkdir -p "$(dirname "$HUB")"
    GIT_TERMINAL_PROMPT=0 git clone -q -c core.symlinks=false "$REMOTE" "$HUB" || die "could not clone $REMOTE"
  fi
  # Repository content must never redirect writes outside the clone.
  git -C "$HUB" config --replace-all core.symlinks false
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$(git -C "$HUB" remote get-url origin)")" = "$CANONICAL" ] \
      || die "$HUB is not a clone of $REMOTE"
  fi
  GIT_TERMINAL_PROMPT=0 git -C "$HUB" fetch -q origin 2>>"$LOG" || die "could not fetch $REMOTE"
  if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1; then
    if git -C "$HUB" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      git -C "$HUB" rebase -q origin/main 2>>"$LOG" || { git -C "$HUB" rebase --abort 2>/dev/null; die "could not bring $HUB up to date"; }
    else
      git -C "$HUB" checkout -q -B main origin/main
    fi
  fi
  if [ -n "$(git -C "$HUB" ls-files -s | awk '$1 == "120000"')" ]; then
    die "the reviewer-logs repository contains symbolic links; refusing to write into it"
  fi
}

write_readme(){
  local readme="$HUB/README.md"
  [ -f "$readme" ] && return 0
  cat > "$readme" <<'EOF'
# Fleet reviewer logs (private)

Every ai-devops machine pushes its complete reviewer evidence here hourly
(`bin/ai-reviewer-logs-sync` in popcre/ai-devops). One folder per machine:

- `reviewer-issues/` — full incident packages from `ai-reviewer-issue`
- `state/review-scoreboard/` — every review's outcome record
- `state/reviewer-events/` — start/exit record of every reviewer invocation
- `state/review-lifecycle/runs/` — per-run lifecycle state
- `reviews/<checkout>/` — review reports from each repository checkout
- `LAST-SYNC.txt` — last collection time; `SKIPPED.txt` — files left out

Only recognizable secret values are replaced with `[REDACTED-SECRET]`;
everything else is the original text. Nothing is ever deleted here.
EOF
}

# Evidence that could not be read never passes silently: list it and exit 2.
report_errors(){
  if [ -s "$ERRS" ]; then
    log "PARTIAL: some evidence could not be read:"
    sed 's/^/  /' "$ERRS" | tee -a "$LOG" >&2
    rm -f "$ERRS"
    exit 2
  fi
  rm -f "$ERRS"
}

save_seen(){
  local k
  for k in "${!NEW_SEEN[@]}"; do printf '%s\0%s\0' "$k" "${NEW_SEEN[$k]}"; done > "$HOME_DIR/seen.new"
  mv -f "$HOME_DIR/seen.new" "$HOME_DIR/seen"
}

push_with_retry(){
  local attempt
  for attempt in 1 2 3; do
    if GIT_TERMINAL_PROMPT=0 git -C "$HUB" push -q origin HEAD:main 2>>"$LOG"; then return 0; fi
    GIT_TERMINAL_PROMPT=0 git -C "$HUB" pull -q --rebase origin main 2>>"$LOG" || true
  done
  die "push to $REMOTE failed after 3 attempts"
}

cmd_sync(){
  mkdir -p "$HOME_DIR"
  take_lock "$HOME_DIR/sync.lock" 60
  rotate_log "$LOG"
  ensure_hub
  write_readme
  mkdir -p "$HUB/$MACHINE"
  SKIPPED="$HUB/$MACHINE/SKIPPED.txt.new"; : > "$SKIPPED"
  COPIED=0
  ERRS="$HOME_DIR/errors.$$"; : > "$ERRS"
  # Size and modification time of every source already collected (local only).
  declare -gA SEEN=() NEW_SEEN=()
  local key val
  if [ -f "$HOME_DIR/seen" ]; then
    while IFS= read -r -d '' key && IFS= read -r -d '' val; do SEEN["$key"]="$val"; done < "$HOME_DIR/seen"
  fi
  copy_tree "$ISSUES" reviewer-issues
  copy_tree "$STATE/review-scoreboard" state/review-scoreboard
  copy_tree "$STATE/reviewer-events" state/reviewer-events
  copy_tree "$STATE/review-lifecycle/runs" state/review-lifecycle/runs
  local roots root dir checkout
  roots="${AI_REVIEWER_LOGS_ROOTS:-$(dirname "$TOOL_ROOT"):/c/repos:/d/repos:$HOME/repos:/worksp}"
  declare -A seen=()
  IFS=: read -r -a root_list <<< "$roots"
  for root in "${root_list[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r -d '' dir; do
      dir="$(cd "$dir" && pwd -P)"
      [ -n "${seen[$dir]:-}" ] && continue
      seen[$dir]=1
      # Full checkout path as the folder name, so same-named checkouts never merge.
      # Readable name plus a hash of the full path: distinct checkouts never share a folder.
      checkout="$(dirname "$(dirname "$dir")")"
      checkout="$(basename "$(dirname "$checkout")")_$(basename "$checkout")--$(printf '%s' "$checkout" | sha1sum | cut -c1-8)"
      copy_tree "$dir" "reviews/$checkout"
    done < <(find "$root" -maxdepth 4 -type d -path '*/.ai/reviews' -print0 2>/dev/null)
  done
  sort -u "$SKIPPED" > "$HUB/$MACHINE/SKIPPED.txt"; rm -f "$SKIPPED"

  git -C "$HUB" add -A README.md "$MACHINE"
  local hits=() rel
  while IFS= read -r -d '' rel; do
    [ -f "$HUB/$rel" ] || continue
    if printf '%s' "$rel" | grep -Eqi "$SECRET_RE|$LABELED_RE"; then hits+=("[file name withheld]"); continue; fi
    if grep -Eq "$SECRET_RE" "$HUB/$rel" || grep -Eqi "$LABELED_RE" "$HUB/$rel"; then hits+=("$rel"); fi
  done < <(git -C "$HUB" diff --cached --name-only -z)
  if ((${#hits[@]})); then
    git -C "$HUB" reset -q
    log "BLOCKED: secret patterns survived scrubbing in:"; printf '  %s\n' "${hits[@]}" | tee -a "$LOG" >&2
    exit 1
  fi
  if git -C "$HUB" diff --cached --quiet; then
    save_seen; log "$MACHINE: nothing new"; unlock "$HOME_DIR/sync.lock"; report_errors; return 0
  fi
  printf 'machine: %s\nlast sync: %s\nfiles updated this run: %s\n' "$MACHINE" "$(stamp)" "$COPIED" > "$HUB/$MACHINE/LAST-SYNC.txt"
  git -C "$HUB" add "$MACHINE/LAST-SYNC.txt"
  git -C "$HUB" commit -qm "reviewer logs: $MACHINE $(stamp)"
  push_with_retry
  save_seen
  log "$MACHINE: sync complete ($COPIED files updated)"
  unlock "$HOME_DIR/sync.lock"
  report_errors
}

case "${1:-sync}" in
  sync) cmd_sync ;;
  schedule) register_timer 60 "$TOOL_ROOT/bin/ai-reviewer-logs-sync" sync ;;
  unschedule) unregister_timer ;;
  -h|--help|help) sed -n '2,32p' "$_self" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command; see ai-reviewer-logs-sync --help" ;;
esac
