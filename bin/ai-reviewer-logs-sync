#!/usr/bin/env bash
# ai-reviewer-logs-sync — put every machine's complete reviewer logs in one
# place: the private repository u2giants/ai-devops-reviewer-logs. Evidence is
# stored unmasked but encrypted, file names included, so nothing diagnostic is
# removed and nothing readable reaches GitHub.
#
# Usage:
#   ai-reviewer-logs-sync [sync]      pack new or changed evidence into one encrypted bundle, push it
#   ai-reviewer-logs-sync view [DIR]  decrypt the whole fleet archive into DIR
#                                     (default ~/.cache/ai-devops-reviewer-logs-plain)
#   ai-reviewer-logs-sync schedule    register an hourly sync (Task Scheduler / crontab)
#   ai-reviewer-logs-sync unschedule
#
# Archive: <machine>/bundles/<UTC time>-<random>.tar.cms, one per run that found
# new evidence (tar inside CMS, AES-256 to an RSA-4096 recipient), plus the
# clear-text <machine>/LAST-SYNC.txt (time, file count, complete or not; no
# names). Nothing is ever deleted. `view` extracts every bundle in time order,
# giving one folder per machine:
#   reviewer-issues/   incident packages (ai-reviewer-issue)
#   state/             review scoreboard, invocation events, lifecycle runs
#   reviews/<checkout>/ .ai/reviews reports from every checkout
#   _collection/       per-bundle notes: files skipped as oversized, read errors
#
# Writers need only the public certificate config/reviewer-logs-archive.crt.
# Readers need the private key in 1Password (vibe_coding):
#   "Reviewer logs archive private key - ai-devops-reviewer-logs (fleet, decrypt only)"
# Bundles are encrypted, not signed: anyone able to push to the private archive
# (only the u2giants account) could add a forged bundle. `view` therefore
# unpacks only plain files and folders with relative names, so a forged bundle
# can add misleading evidence but can never write outside the view folder.
# Every run starts from the published archive (unpushed local commits are
# discarded; their evidence is collected again because nothing is remembered as
# collected until a push succeeds). A push happens only when the repository is
# private (unauthenticated access fails) and every new file is a CMS
# enveloped-data bundle.
#
# Environment:
#   AI_REVIEWER_LOGS_REMOTE / _HUB / _ROOTS / _MAX_FILE_BYTES / _MACHINE / _CERT
#   AI_REVIEWER_ISSUE_DIR, AI_REVIEWER_STATE_BASE   as in ai-reviewer-issue
#   AI_REVIEWER_LOGS_KEY_FILE   view: use this key file instead of 1Password (tests)
#   AI_REVIEWER_LOGS_TEST_MODE=1  tests: local remote allowed, no privacy probe
set -euo pipefail
umask 077

_self="${BASH_SOURCE[0]}"
TOOL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
TOOL_NAME=ai-reviewer-logs-sync
HOME_DIR="$HOME/.ai-devops/reviewer-logs-sync"
# shellcheck source=../tools/lib/local-watch.sh
. "$TOOL_ROOT/tools/lib/local-watch.sh"

CANONICAL="github.com/u2giants/ai-devops-reviewer-logs"
REMOTE="${AI_REVIEWER_LOGS_REMOTE:-https://$CANONICAL.git}"
HUB="${AI_REVIEWER_LOGS_HUB:-$HOME/.cache/ai-devops-reviewer-logs}"
STATE="${AI_REVIEWER_STATE_BASE:-$HOME/.local/state/ai-devops}"
ISSUES="${AI_REVIEWER_ISSUE_DIR:-$TOOL_ROOT/.ai/reviewer-issues}"
MAX_BYTES="${AI_REVIEWER_LOGS_MAX_FILE_BYTES:-20000000}"
CERT="${AI_REVIEWER_LOGS_CERT:-$TOOL_ROOT/config/reviewer-logs-archive.crt}"
KEY_REF='op://vibe_coding/Reviewer logs archive private key - ai-devops-reviewer-logs (fleet, decrypt only)/REVIEWER_LOGS_PRIVATE_KEY_PEM'
MACHINE="$(printf '%s' "${AI_REVIEWER_LOGS_MACHINE:-$(hostname)}" | lower | tr -c 'a-z0-9.-' '-')"
case "$MACHINE" in ''|.*|-*|*..*) die "invalid machine folder name: $MACHINE" ;; esac
LOG="$HOME_DIR/sync.log"

log(){ printf '%s %s\n' "$(stamp)" "$*" | tee -a "$LOG" >&2; }
canonical_remote(){
  printf '%s\n' "$1" | sed -E -e 's#^(https?://|ssh://)?([^@/]+@)?##' -e 's#^github\.com:#github.com/#' -e 's#\.git$##' -e 's#/$##'
}
# Native Windows openssl needs Windows paths; elsewhere this is a no-op.
native(){ if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi; }
ossl(){ MSYS2_ARG_CONV_EXCL='*' openssl "$@"; }
is_envelope(){ ossl cms -cmsout -print -noout -inform DER -in "$(native "$1")" 2>/dev/null | grep -q 'pkcs7-envelopedData'; }

# stage_tree <source dir> <path inside the bundle>: copy new or changed files
# into the private staging folder.
stage_tree(){
  local src="$1" into="$2" line digest file rel size sums="$WORK/sums"
  [ -d "$src" ] || return 0
  # One hashing pass per tree; a file is collected again whenever its content changes.
  find "$src" -type f ! -name '*.tmp' -print0 2>>"$ERRS" | xargs -0 -r sha1sum -z -- > "$sums" 2>>"$ERRS" \
    || printf 'hashing failed under %s\n' "$into" >> "$ERRS"
  while IFS= read -r -d '' line; do
    # "<40-hex digest><space><' ' or '*' mode marker><path>"
    digest="${line:0:40}"; file="${line:42}"
    rel="${file#"$src"/}"
    if ! size="$(wc -c < "$file" 2>>"$ERRS")"; then continue; fi
    if [ "$size" -gt "$MAX_BYTES" ]; then
      printf '%s/%s\t%s bytes, over the size limit\n' "$into" "$rel" "$size" >> "$NOTES"; continue
    fi
    NEW_SEEN["$file"]="$digest"
    [ "${SEEN[$file]:-}" = "$digest" ] && continue
    mkdir -p "$WORK/stage/$into/$(dirname "$rel")"
    if cp -f -- "$file" "$WORK/stage/$into/$rel" 2>>"$ERRS"; then COPIED=$((COPIED + 1)); else unset 'NEW_SEEN[$file]'; fi
  done < "$sums"
}

ensure_hub(){
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$REMOTE")" = "$CANONICAL" ] || die "remote is not the private reviewer-logs repository"
    if GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never git -c credential.helper= -c core.askPass= \
        ls-remote "https://$CANONICAL.git" >/dev/null 2>&1; then
      die "reviewer-logs repository is publicly readable; refusing to sync"
    fi
  fi
  if [ ! -d "$HUB/.git" ]; then
    mkdir -p "$(dirname "$HUB")"
    GIT_TERMINAL_PROMPT=0 git clone -q -c core.symlinks=false "$REMOTE" "$HUB" 2>>"$LOG" || die "could not clone $REMOTE"
  fi
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$(git -C "$HUB" remote get-url origin)")" = "$CANONICAL" ] || die "$HUB is not a clone of $REMOTE"
  fi
  git -C "$HUB" config --replace-all core.symlinks false
  GIT_TERMINAL_PROMPT=0 git -C "$HUB" fetch -q origin 2>>"$LOG" || die "could not fetch $REMOTE"
  # Always start from exactly what is published.
  if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1; then
    git -C "$HUB" checkout -q -B main origin/main 2>>"$LOG" || git -C "$HUB" checkout -q -f -B main origin/main
    git -C "$HUB" reset -q --hard origin/main
  fi
  git -C "$HUB" clean -qfdx
  if [ -n "$(git -C "$HUB" ls-files -s | awk '$1 == "120000"')" ]; then
    die "the reviewer-logs repository contains symbolic links; refusing to write into it"
  fi
}

save_seen(){
  local k
  for k in "${!NEW_SEEN[@]}"; do printf '%s\0%s\0' "$k" "${NEW_SEEN[$k]}"; done > "$HOME_DIR/seen.new"
  mv -f "$HOME_DIR/seen.new" "$HOME_DIR/seen"
}

# Push, then prove delivery: every path passed must be in the published main.
push_or_die(){
  local attempt p delivered
  for attempt in 1 2 3; do
    GIT_TERMINAL_PROMPT=0 git -C "$HUB" push -q origin HEAD:main 2>>"$LOG" || true
    GIT_TERMINAL_PROMPT=0 git -C "$HUB" fetch -q origin 2>>"$LOG" || die "could not fetch $REMOTE"
    delivered=1
    for p in "$@"; do git -C "$HUB" cat-file -e "origin/main:$p" 2>/dev/null || delivered=0; done
    [ "$delivered" = 1 ] && return 0
    if ! git -C "$HUB" rebase -q origin/main 2>>"$LOG"; then
      git -C "$HUB" rebase --abort 2>/dev/null || true
      die "could not rebase onto the published archive; nothing was recorded as delivered"
    fi
  done
  die "push to $REMOTE failed after 3 attempts; nothing was recorded as delivered"
}

cmd_sync(){
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"
  take_lock "$HOME_DIR/sync.lock" 60
  rotate_log "$LOG"
  [ -f "$CERT" ] || die "archive certificate missing: $CERT"
  ensure_hub
  WORK="$HOME_DIR/work.$$"; rm -rf "$WORK"; mkdir -p "$WORK/stage"
  ERRS="$WORK/errors"; NOTES="$WORK/notes"; : > "$ERRS"; : > "$NOTES"
  COPIED=0; RECOVERING=0
  declare -gA SEEN=() NEW_SEEN=()
  local key val
  if [ -f "$HOME_DIR/seen" ]; then
    while IFS= read -r -d '' key && IFS= read -r -d '' val; do SEEN["$key"]="$val"; done < "$HOME_DIR/seen"
  fi
  # Every bundle this machine delivered is also kept locally (encrypted). If the
  # published archive lost one, put the very same bundle back; only if the local
  # copy is gone too is everything collected again.
  RESTORED=()
  if [ -f "$HOME_DIR/pushed-bundles" ]; then
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      [ -f "$HUB/$key" ] && continue
      if [ -f "$HOME_DIR/sent/$(basename "$key")" ]; then
        mkdir -p "$(dirname "$HUB/$key")"
        cp -f "$HOME_DIR/sent/$(basename "$key")" "$HUB/$key"
        git -C "$HUB" add -- "$key"; RESTORED+=("$key")
        log "$MACHINE: restored $key to the archive from the local copy"
      else
        log "$MACHINE: the archive and this machine both lost $key; collecting everything again"
        SEEN=(); RECOVERING=1
      fi
    done < "$HOME_DIR/pushed-bundles"
  fi

  stage_tree "$ISSUES" reviewer-issues
  stage_tree "$STATE/review-scoreboard" state/review-scoreboard
  stage_tree "$STATE/reviewer-events" state/reviewer-events
  stage_tree "$STATE/review-lifecycle/runs" state/review-lifecycle/runs
  local roots root dir checkout
  roots="${AI_REVIEWER_LOGS_ROOTS:-$(dirname "$TOOL_ROOT"):/c/repos:/d/repos:$HOME/repos:/worksp}"
  declare -A seen_dirs=()
  IFS=: read -r -a root_list <<< "$roots"
  for root in "${root_list[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r -d '' dir; do
      dir="$(cd "$dir" && pwd -P)"
      [ -n "${seen_dirs[$dir]:-}" ] && continue
      seen_dirs[$dir]=1
      # Readable name plus a hash of the full path: distinct checkouts never share a folder.
      checkout="$(dirname "$(dirname "$dir")")"
      checkout="$(basename "$(dirname "$checkout")")_$(basename "$checkout")--$(printf '%s' "$checkout" | sha1sum | cut -c1-16)"
      stage_tree "$dir" "reviews/$checkout"
    done < <(find "$root" -maxdepth 4 -type d -path '*/.ai/reviews' -print0 2>>"$ERRS")
  done

  local partial=0 bundle=""
  [ -s "$ERRS" ] && partial=1
  # The oversized list is re-published only when it changes.
  local notes_sum notes_changed=0
  notes_sum="$(sha1sum < "$NOTES" | cut -c1-40)"
  [ "$notes_sum" = "$(cat "$HOME_DIR/notes.sha1" 2>/dev/null)" ] || notes_changed=1
  if [ "$COPIED" -gt 0 ] || [ "$notes_changed" = 1 ] || [ "$partial" = 1 ]; then
    local id; id="$(date -u +%Y%m%dT%H%M%S%NZ)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    mkdir -p "$WORK/stage/_collection"
    cp -f "$NOTES" "$WORK/stage/_collection/$id-skipped.txt"
    cp -f "$ERRS" "$WORK/stage/_collection/$id-read-errors.txt"
    tar -C "$WORK/stage" -cf "$WORK/bundle.tar" . || die "could not pack the evidence bundle"
    mkdir -p "$HUB/$MACHINE/bundles"
    bundle="$MACHINE/bundles/$id.tar.cms"
    ossl cms -encrypt -binary -aes-256-cbc -outform DER -in "$(native "$WORK/bundle.tar")" \
      -out "$(native "$HUB/$bundle")" "$(native "$CERT")" || die "could not encrypt the evidence bundle"
    printf 'machine: %s\nlast bundle: %s\nfiles in it: %s\ncomplete: %s\n' "$MACHINE" "$id" "$COPIED" \
      "$([ "$partial" = 0 ] && echo yes || echo 'no - some files could not be read; they are retried next run')" > "$HUB/$MACHINE/LAST-SYNC.txt"
    git -C "$HUB" add -- "$bundle" "$MACHINE/LAST-SYNC.txt"
  elif grep -q '^complete: no' "$HUB/$MACHINE/LAST-SYNC.txt" 2>/dev/null; then
    sed -i 's/^complete: no.*/complete: yes (a later run collected everything)/' "$HUB/$MACHINE/LAST-SYNC.txt"
    git -C "$HUB" add -- "$MACHINE/LAST-SYNC.txt"
  fi

  # Leak gate on exactly what will be published: only this run's bundle and
  # the clear-text status file, and the bundle must be a CMS envelope.
  local rel bad=() expected=" $bundle ${RESTORED[*]:-} "
  while IFS= read -r -d '' rel; do
    if [ "$rel" = "$MACHINE/LAST-SYNC.txt" ]; then continue; fi
    if [[ "$expected" == *" $rel "* ]] && is_envelope "$HUB/$rel"; then continue; fi
    bad+=("$rel")
  done < <(git -C "$HUB" diff --cached --name-only -z)
  if ((${#bad[@]})); then
    git -C "$HUB" reset -q --hard
    log "BLOCKED: refusing to publish files that are not encrypted bundles:"; printf '  %s\n' "${bad[@]}" | tee -a "$LOG" >&2
    rm -rf "$WORK"; exit 1
  fi

  if ! git -C "$HUB" diff --cached --quiet; then
    git -C "$HUB" commit -qm "reviewer logs: $MACHINE $(stamp)$([ "$partial" = 0 ] || echo ' (partial)')"
    push_or_die ${bundle:+"$bundle"} ${RESTORED[@]+"${RESTORED[@]}"} "$MACHINE/LAST-SYNC.txt"
  fi
  # Delivery is proven; record it. A sent bundle is kept locally for restores.
  # After a full re-collection, bundles lost everywhere leave the ledger: their
  # current files are in this run's bundle (deleted files and older versions
  # that existed only in them cannot be recovered and are reported once).
  if [ "$RECOVERING" = 1 ] && [ "$partial" = 0 ]; then
    local entry
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      if [ -f "$HUB/$entry" ]; then printf '%s\n' "$entry"; else log "$MACHINE: permanently lost: $entry"; fi
    done < "$HOME_DIR/pushed-bundles" > "$HOME_DIR/pushed-bundles.new"
    mv -f "$HOME_DIR/pushed-bundles.new" "$HOME_DIR/pushed-bundles"
  fi
  if [ -n "$bundle" ]; then
    mkdir -p "$HOME_DIR/sent"; cp -f "$HUB/$bundle" "$HOME_DIR/sent/$(basename "$bundle")"
    printf '%s\n' "$bundle" >> "$HOME_DIR/pushed-bundles"
  fi
  if [ "$partial" = 0 ]; then
    save_seen
    printf '%s\n' "$notes_sum" > "$HOME_DIR/notes.sha1"
    if [ "$COPIED" = 0 ]; then log "$MACHINE: nothing new"; else log "$MACHINE: sync complete ($COPIED files in $bundle)"; fi
  fi
  unlock "$HOME_DIR/sync.lock"
  if [ "$partial" = 1 ]; then
    log "PARTIAL: some evidence could not be read (retried next run):"
    sed 's/^/  /' "$ERRS" | tee -a "$LOG" >&2
    rm -rf "$WORK"; exit 2
  fi
  rm -rf "$WORK"
}

cmd_view(){
  local out="${1:-$HOME/.cache/ai-devops-reviewer-logs-plain}" keyfile work b machine n=0 entry
  # Same lock as sync: view's reset of the clone must never race a sync.
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"
  take_lock "$HOME_DIR/sync.lock" 60
  ensure_hub
  work="$(mktemp -d)"; chmod 700 "$work"
  # shellcheck disable=SC2064
  trap "rm -rf '$work' '$HOME_DIR/sync.lock'" EXIT
  if [ -n "${AI_REVIEWER_LOGS_KEY_FILE:-}" ]; then
    keyfile="$AI_REVIEWER_LOGS_KEY_FILE"
  else
    command -v op >/dev/null 2>&1 || die "1Password CLI (op) is required to read the archive key"
    keyfile="$work/key.pem"
    op read "$KEY_REF" < /dev/null > "$keyfile" || die "could not read the archive key from 1Password"
  fi
  # Always rebuild from scratch, and only ever wipe a folder this command made.
  if [ -e "$out" ] && [ ! -f "$out/.ai-reviewer-logs-view" ] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then
    die "$out exists and was not made by 'ai-reviewer-logs-sync view'; choose another folder"
  fi
  rm -rf "$out"; mkdir -p "$out"; chmod 700 "$out"; : > "$out/.ai-reviewer-logs-view"
  while IFS= read -r b; do
    machine="${b%%/*}"
    ossl cms -decrypt -binary -inform DER -inkey "$(native "$keyfile")" -in "$(native "$HUB/$b")" \
      -out "$(native "$work/b.tar")" || die "could not decrypt $b"
    # Only plain files and folders with relative, non-escaping names are unpacked.
    while IFS= read -r entry; do
      case "$entry" in /*|..|../*|*/..|*/../*) die "$b contains an unsafe path; not unpacking it" ;; esac
    done < <(tar -tf "$work/b.tar")
    if tar -tvf "$work/b.tar" | grep -qv '^[-d]'; then die "$b contains links or special files; not unpacking it"; fi
    mkdir -p "$out/$machine"
    tar -C "$out/$machine" --no-same-owner --no-same-permissions -xf "$work/b.tar" || die "could not unpack $b"
    cp -f "$HUB/$machine/LAST-SYNC.txt" "$out/$machine/" 2>/dev/null || true
    n=$((n + 1))
  done < <(cd "$HUB" && find . -path ./.git -prune -o -type f -path '*/bundles/*.tar.cms' -print | sed 's#^\./##' |
    awk -F/ '{ print $3 "\t" $0 }' | sort | cut -f2-)
  printf 'decrypted %s bundles into %s (one folder per machine)\n' "$n" "$out"
}

case "${1:-sync}" in
  sync) cmd_sync ;;
  view) shift; cmd_view "$@" ;;
  schedule) register_timer 60 "$TOOL_ROOT/bin/ai-reviewer-logs-sync" sync ;;
  unschedule) unregister_timer ;;
  -h|--help|help) sed -n '2,38p' "$_self" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command; see ai-reviewer-logs-sync --help" ;;
esac
