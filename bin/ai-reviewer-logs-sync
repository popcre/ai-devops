#!/usr/bin/env bash
# ai-reviewer-logs-sync — put every machine's complete reviewer logs in one
# place: the private repository u2giants/ai-devops-reviewer-logs. Files are
# stored unmasked but encrypted, so nothing diagnostic is removed and nothing
# readable (including any credential a log happened to capture) reaches GitHub.
#
# Usage:
#   ai-reviewer-logs-sync [sync]      encrypt new or changed evidence, commit, push
#   ai-reviewer-logs-sync view [DIR]  decrypt the whole fleet archive into DIR
#                                     (default ~/.cache/ai-devops-reviewer-logs-plain)
#   ai-reviewer-logs-sync schedule    register an hourly sync (Task Scheduler / crontab)
#   ai-reviewer-logs-sync unschedule
#
# Archive layout (one folder per machine; nothing is ever deleted):
#   <machine>/reviewer-issues/...       incident packages (ai-reviewer-issue)
#   <machine>/state/...                 scoreboard, invocation events, lifecycle runs
#   <machine>/reviews/<checkout>/...    .ai/reviews reports from every checkout
#   every collected file is stored as <name>.cms (CMS, AES-256, RSA-4096 recipient)
#   <machine>/LAST-SYNC.txt             last new evidence; whether that run was complete
#   <machine>/SKIPPED.txt               files left out (over the size limit) with reasons
#   File names that look like credentials are stored as withheld-<hash>.cms; the
#   real names are in the encrypted <machine>/withheld-names.cms.
#
# Writers need only the public certificate config/reviewer-logs-archive.crt.
# Readers need the private key in 1Password (vibe_coding):
#   "Reviewer logs archive private key - ai-devops-reviewer-logs (fleet, decrypt only)"
# The push is refused unless the repository is private (unauthenticated access
# must fail) and every outgoing collected file is a CMS envelope.
#
# Environment:
#   AI_REVIEWER_LOGS_REMOTE / _HUB / _ROOTS / _MAX_FILE_BYTES / _MACHINE / _CERT
#   AI_REVIEWER_ISSUE_DIR, AI_REVIEWER_STATE_BASE   as in ai-reviewer-issue
#   AI_REVIEWER_LOGS_KEY_FILE   view: use this key file instead of 1Password (tests)
#   AI_REVIEWER_LOGS_TEST_MODE=1  tests: local remote allowed, no privacy probe
set -euo pipefail

_self="${BASH_SOURCE[0]}"
TOOL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
TOOL_NAME=ai-reviewer-logs-sync
HOME_DIR="$HOME/.ai-devops/reviewer-logs-sync"
# shellcheck source=../tools/lib/local-watch.sh
. "$TOOL_ROOT/tools/lib/local-watch.sh"

CANONICAL="github.com/u2giants/ai-devops-reviewer-logs"
REMOTE="${AI_REVIEWER_LOGS_REMOTE:-https://$CANONICAL.git}"
HUB="${AI_REVIEWER_LOGS_HUB:-$HOME/.cache/ai-devops-reviewer-logs}"
STATE="${AI_REVIEWER_STATE_BASE:-$HOME/.local/state/ai-devops}"
ISSUES="${AI_REVIEWER_ISSUE_DIR:-$TOOL_ROOT/.ai/reviewer-issues}"
MAX_BYTES="${AI_REVIEWER_LOGS_MAX_FILE_BYTES:-20000000}"
CERT="${AI_REVIEWER_LOGS_CERT:-$TOOL_ROOT/config/reviewer-logs-archive.crt}"
KEY_REF='op://vibe_coding/Reviewer logs archive private key - ai-devops-reviewer-logs (fleet, decrypt only)/REVIEWER_LOGS_PRIVATE_KEY_PEM'
MACHINE="$(printf '%s' "${AI_REVIEWER_LOGS_MACHINE:-$(hostname)}" | lower | tr -c 'a-z0-9.-' '-')"
case "$MACHINE" in ''|.*|-*|*..*) die "invalid machine folder name: $MACHINE" ;; esac
LOG="$HOME_DIR/sync.log"
# Credential-looking file names are withheld from the clear-text tree.
NAME_RE='gh[pousr]_[A-Za-z0-9]{20}|github_pat_|sk-[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|xox[baprs]-|eyJ[A-Za-z0-9_-]{18,}\.|npm_[A-Za-z0-9]{36}|AIza[0-9A-Za-z_-]{35}|glpat-|ops_[A-Za-z0-9]{20}|password|passwd|secret|token|api[_-]?key|credential'

log(){ mkdir -p "$HOME_DIR"; printf '%s %s\n' "$(stamp)" "$*" | tee -a "$LOG" >&2; }
canonical_remote(){
  printf '%s\n' "$1" | sed -E -e 's#^(https?://|ssh://)?([^@/]+@)?##' -e 's#^github\.com:#github.com/#' -e 's#\.git$##' -e 's#/$##'
}
# Native Windows openssl needs Windows paths; elsewhere this is a no-op.
native(){ if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi; }
ossl(){ MSYS2_ARG_CONV_EXCL='*' openssl "$@"; }
encrypt(){ ossl cms -encrypt -binary -aes-256-cbc -outform DER -in "$(native "$1")" -out "$(native "$2")" "$(native "$CERT")"; }
decrypt(){ ossl cms -decrypt -binary -inform DER -inkey "$(native "$3")" -in "$(native "$1")" -out "$(native "$2")"; }

# copy_tree <source dir> <destination relative to the machine folder>
copy_tree(){
  local src="$1" dest="$HUB/$MACHINE/$2" line digest file rel stored target size sums="$HOME_DIR/sums.$$"
  [ -d "$src" ] || return 0
  # One hashing pass per tree; a file is re-collected whenever its content changes.
  # Unreadable or vanished files land in $ERRS and mark the run partial.
  find "$src" -type f ! -name '*.tmp' -print0 2>>"$ERRS" | xargs -0 -r sha1sum -z -- > "$sums" 2>>"$ERRS" \
    || printf 'hashing failed under %s\n' "$2" >> "$ERRS"
  while IFS= read -r -d '' line; do
    # "<40-hex digest><space><' ' or '*' mode marker><path>"
    digest="${line:0:40}"; file="${line:42}"
    rel="${file#"$src"/}"
    stored="$rel"
    if printf '%s' "$rel" | grep -Eqi "$NAME_RE"; then
      stored="$(dirname "$rel")/withheld-$(printf '%s' "$rel" | sha1sum | cut -c1-12)"
      stored="${stored#./}"
      printf '%s/%s\t%s/%s\n' "$2" "$stored" "$2" "$rel" >> "$WITHHELD"
    fi
    target="$dest/$stored.cms"
    NEW_SEEN["$file"]="$digest"
    if [ -f "$target" ] && [ "${SEEN[$file]:-}" = "$digest" ]; then continue; fi
    size="$(wc -c < "$file")"
    if [ "$size" -gt "$MAX_BYTES" ]; then
      printf '%s/%s\t%s bytes, over the size limit\n' "$2" "$stored" "$size" >> "$SKIPPED"; continue
    fi
    mkdir -p "$(dirname "$target")"
    if ! encrypt "$file" "$target.tmp" 2>>"$ERRS"; then
      rm -f "$target.tmp"; printf 'could not encrypt %s/%s\n' "$2" "$stored" >> "$ERRS"; continue
    fi
    mv -f "$target.tmp" "$target"
    COPIED=$((COPIED + 1))
  done < "$sums"
  rm -f "$sums"
}

ensure_hub(){
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$REMOTE")" = "$CANONICAL" ] || die "remote is not the private reviewer-logs repository"
    if GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never git -c credential.helper= -c core.askPass= \
        ls-remote "https://$CANONICAL.git" >/dev/null 2>&1; then
      die "reviewer-logs repository is publicly readable; refusing to sync"
    fi
  fi
  if [ ! -d "$HUB/.git" ]; then
    mkdir -p "$(dirname "$HUB")"
    GIT_TERMINAL_PROMPT=0 git clone -q -c core.symlinks=false "$REMOTE" "$HUB" 2>>"$LOG" || die "could not clone $REMOTE"
  fi
  if [ "${AI_REVIEWER_LOGS_TEST_MODE:-}" != 1 ]; then
    [ "$(canonical_remote "$(git -C "$HUB" remote get-url origin)")" = "$CANONICAL" ] || die "$HUB is not a clone of $REMOTE"
  fi
  # Repository content must never redirect writes outside the clone.
  git -C "$HUB" config --replace-all core.symlinks false
  # Recover from an interrupted or refused run: keep finished commits, drop
  # uncommitted edits (everything in the clone is regenerated from the sources,
  # and nothing was remembered as collected when a run did not finish).
  if git -C "$HUB" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    git -C "$HUB" reset -q --hard HEAD
    git -C "$HUB" clean -qfd
  fi
  GIT_TERMINAL_PROMPT=0 git -C "$HUB" fetch -q origin 2>>"$LOG" || die "could not fetch $REMOTE"
  if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1; then
    if git -C "$HUB" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      git -C "$HUB" rebase -q origin/main 2>>"$LOG" || { git -C "$HUB" rebase --abort 2>/dev/null || true; die "could not bring $HUB up to date"; }
    else
      git -C "$HUB" checkout -q -B main origin/main
    fi
  fi
  if [ -n "$(git -C "$HUB" ls-files -s | awk '$1 == "120000"')" ]; then
    die "the reviewer-logs repository contains symbolic links; refusing to write into it"
  fi
}

write_readme(){
  cat > "$HUB/README.md" <<'EOF'
# Fleet reviewer logs (private, encrypted)

Every ai-devops machine pushes its complete reviewer evidence here hourly
(`bin/ai-reviewer-logs-sync` in popcre/ai-devops). Nothing is masked or
removed; every collected file is encrypted (`*.cms`).

Read everything at once: `ai-reviewer-logs-sync view` on any ai-devops machine
(it reads the private key from 1Password, vibe_coding, "Reviewer logs archive
private key - ai-devops-reviewer-logs (fleet, decrypt only)", and decrypts into
~/.cache/ai-devops-reviewer-logs-plain).

One folder per machine:
- `reviewer-issues/` — incident packages from `ai-reviewer-issue`
- `state/review-scoreboard/` — every review's outcome record
- `state/reviewer-events/` — start/exit record of every reviewer invocation
- `state/review-lifecycle/runs/` — per-run lifecycle state
- `reviews/<checkout>/` — review reports from each repository checkout
- `LAST-SYNC.txt` — last new evidence and whether that run was complete
- `SKIPPED.txt` — files over the size limit
- `withheld-names.cms` — real names of files stored as `withheld-<hash>`
EOF
}

push_if_ahead(){
  git -C "$HUB" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0
  if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1 && \
     [ "$(git -C "$HUB" rev-list --count origin/main..HEAD)" = 0 ]; then return 0; fi
  local attempt
  for attempt in 1 2 3; do
    if GIT_TERMINAL_PROMPT=0 git -C "$HUB" push -q origin HEAD:main 2>>"$LOG"; then return 0; fi
    GIT_TERMINAL_PROMPT=0 git -C "$HUB" pull -q --rebase origin main 2>>"$LOG" || true
  done
  die "push to $REMOTE failed after 3 attempts"
}

save_seen(){
  local k
  for k in "${!NEW_SEEN[@]}"; do printf '%s\0%s\0' "$k" "${NEW_SEEN[$k]}"; done > "$HOME_DIR/seen.new"
  mv -f "$HOME_DIR/seen.new" "$HOME_DIR/seen"
}

cmd_sync(){
  mkdir -p "$HOME_DIR"
  take_lock "$HOME_DIR/sync.lock" 60
  rotate_log "$LOG"
  [ -f "$CERT" ] || die "archive certificate missing: $CERT"
  ensure_hub
  write_readme
  mkdir -p "$HUB/$MACHINE"
  SKIPPED="$HOME_DIR/skipped.$$"; WITHHELD="$HOME_DIR/withheld.$$"; ERRS="$HOME_DIR/errors.$$"
  : > "$SKIPPED"; : > "$WITHHELD"; : > "$ERRS"
  COPIED=0
  declare -gA SEEN=() NEW_SEEN=()
  local key val
  if [ -f "$HOME_DIR/seen" ]; then
    while IFS= read -r -d '' key && IFS= read -r -d '' val; do SEEN["$key"]="$val"; done < "$HOME_DIR/seen"
  fi

  copy_tree "$ISSUES" reviewer-issues
  copy_tree "$STATE/review-scoreboard" state/review-scoreboard
  copy_tree "$STATE/reviewer-events" state/reviewer-events
  copy_tree "$STATE/review-lifecycle/runs" state/review-lifecycle/runs
  local roots root dir checkout
  roots="${AI_REVIEWER_LOGS_ROOTS:-$(dirname "$TOOL_ROOT"):/c/repos:/d/repos:$HOME/repos:/worksp}"
  declare -A seen_dirs=()
  IFS=: read -r -a root_list <<< "$roots"
  for root in "${root_list[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r -d '' dir; do
      dir="$(cd "$dir" && pwd -P)"
      [ -n "${seen_dirs[$dir]:-}" ] && continue
      seen_dirs[$dir]=1
      # Readable name plus a hash of the full path: distinct checkouts never share a folder.
      checkout="$(dirname "$(dirname "$dir")")"
      checkout="$(basename "$(dirname "$checkout")")_$(basename "$checkout")--$(printf '%s' "$checkout" | sha1sum | cut -c1-8)"
      copy_tree "$dir" "reviews/$checkout"
    done < <(find "$root" -maxdepth 4 -type d -path '*/.ai/reviews' -print0 2>>"$ERRS")
  done

  sort -u "$SKIPPED" > "$HUB/$MACHINE/SKIPPED.txt"
  if [ -s "$WITHHELD" ]; then
    local names="$HOME_DIR/names.$$"
    # Every run lists every current file, so this is the complete name map.
    sort -u "$WITHHELD" > "$names"
    if [ -f "$HUB/$MACHINE/withheld-names.list.sha1" ] && \
       [ "$(sha1sum < "$names" | cut -c1-40)" = "$(cat "$HUB/$MACHINE/withheld-names.list.sha1")" ]; then :; else
      encrypt "$names" "$HUB/$MACHINE/withheld-names.cms" && sha1sum < "$names" | cut -c1-40 > "$HUB/$MACHINE/withheld-names.list.sha1"
    fi
    rm -f "$names"
  fi
  rm -f "$SKIPPED" "$WITHHELD"

  local partial=0 stale_partial=0
  [ -s "$ERRS" ] && partial=1
  [ "$partial" = 0 ] && grep -q '^complete: no' "$HUB/$MACHINE/LAST-SYNC.txt" 2>/dev/null && stale_partial=1
  git -C "$HUB" add -A README.md "$MACHINE"
  if ! git -C "$HUB" diff --cached --quiet || [ "$partial" = 1 ] || [ "$stale_partial" = 1 ]; then
    printf 'machine: %s\nlast new evidence collected: %s\nfiles updated in that run: %s\ncomplete: %s\n' \
      "$MACHINE" "$(stamp)" "$COPIED" "$([ "$partial" = 0 ] && echo yes || echo 'no - some files could not be read')" > "$HUB/$MACHINE/LAST-SYNC.txt"
    git -C "$HUB" add "$MACHINE/LAST-SYNC.txt"
  fi

  # Leak gate over everything that would reach GitHub (staged files and any
  # unpushed commits): each collected file must parse as a CMS enveloped-data
  # structure; only the generated clear-text index files may be plain.
  local bad=() rel outgoing=()
  if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1; then
    outgoing=(diff --cached --name-only --diff-filter=ACMR -z origin/main)
  else
    outgoing=(ls-files -z)
  fi
  while IFS= read -r -d '' rel; do
    [ -f "$HUB/$rel" ] || continue
    case "$rel" in
      README.md|*/LAST-SYNC.txt|*/SKIPPED.txt|*/withheld-names.list.sha1) continue ;;
      *.cms) ossl cms -cmsout -print -noout -inform DER -in "$(native "$HUB/$rel")" 2>/dev/null | grep -q 'pkcs7-envelopedData' && continue ;;
    esac
    bad+=("$rel")
  done < <(git -C "$HUB" "${outgoing[@]}")
  if ((${#bad[@]})); then
    git -C "$HUB" reset -q
    if git -C "$HUB" rev-parse -q --verify origin/main >/dev/null 2>&1; then git -C "$HUB" reset -q --hard origin/main; fi
    log "BLOCKED: refusing to push files that are not encrypted:"; printf '  %s\n' "${bad[@]}" | tee -a "$LOG" >&2
    exit 1
  fi

  if ! git -C "$HUB" diff --cached --quiet; then
    git -C "$HUB" commit -qm "reviewer logs: $MACHINE $(stamp)$([ "$partial" = 0 ] || echo ' (partial)')"
  fi
  push_if_ahead
  if [ "$partial" = 0 ]; then
    save_seen
    if [ "$COPIED" = 0 ]; then log "$MACHINE: nothing new"; else log "$MACHINE: sync complete ($COPIED files updated)"; fi
  fi
  unlock "$HOME_DIR/sync.lock"
  if [ -s "$ERRS" ]; then
    log "PARTIAL: some evidence could not be read (it is retried next run):"
    sed 's/^/  /' "$ERRS" | tee -a "$LOG" >&2
    rm -f "$ERRS"
    exit 2
  fi
  rm -f "$ERRS"
}

cmd_view(){
  local out="${1:-$HOME/.cache/ai-devops-reviewer-logs-plain}" keyfile work f rel n=0 failed=0
  ensure_hub
  work="$(mktemp -d)"; chmod 700 "$work"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT
  if [ -n "${AI_REVIEWER_LOGS_KEY_FILE:-}" ]; then
    keyfile="$AI_REVIEWER_LOGS_KEY_FILE"
  else
    command -v op >/dev/null 2>&1 || die "1Password CLI (op) is required to read the archive key"
    keyfile="$work/key.pem"
    (umask 077; op read "$KEY_REF" < /dev/null > "$keyfile") || die "could not read the archive key from 1Password"
  fi
  mkdir -p "$out"; chmod 700 "$out"
  while IFS= read -r -d '' f; do
    rel="${f#"$HUB"/}"; rel="${rel%.cms}"
    mkdir -p "$out/$(dirname "$rel")"
    if decrypt "$f" "$out/$rel" "$keyfile" 2>/dev/null; then n=$((n + 1)); else failed=$((failed + 1)); fi
  done < <(find "$HUB" -path "$HUB/.git" -prune -o -type f -name '*.cms' -print0)
  cp -f "$HUB/README.md" "$out/" 2>/dev/null || true
  find "$HUB" -path "$HUB/.git" -prune -o -type f \( -name LAST-SYNC.txt -o -name SKIPPED.txt \) -print0 |
    while IFS= read -r -d '' f; do rel="${f#"$HUB"/}"; mkdir -p "$out/$(dirname "$rel")"; cp -f "$f" "$out/$rel"; done
  printf 'decrypted %s files into %s\n' "$n" "$out"
  [ "$failed" = 0 ] || die "$failed files could not be decrypted"
}

case "${1:-sync}" in
  sync) cmd_sync ;;
  view) shift; cmd_view "$@" ;;
  schedule) register_timer 60 "$TOOL_ROOT/bin/ai-reviewer-logs-sync" sync ;;
  unschedule) unregister_timer ;;
  -h|--help|help) sed -n '2,35p' "$_self" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command; see ai-reviewer-logs-sync --help" ;;
esac
