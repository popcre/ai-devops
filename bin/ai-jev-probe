#!/usr/bin/env bash
# ai-jev-probe -- one bounded TypeSafe Jev reachability call.
# Prints `ok` on a well-formed Noul answer, otherwise `FAIL: <reason>` and exits 1.
# Evaluation only; see plan_typesafe-jev-decision-layer.md. Transport and secret
# bootstrap live in tools/lib/jev-client.sh (advisory plan §9.2).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../tools/lib/jev-client.sh
. "$SCRIPT_DIR/../tools/lib/jev-client.sh"

fail() { echo "FAIL: $*" >&2; exit 1; }

if ! jev_bootstrap "$0" "$@"; then
  fail "bootstrap failed (empty key, missing op reference, or op run failure)"
fi

req=""; resp=""
jev_tmp req || fail "temp file"
jev_tmp resp || fail "temp file"

# Probe uses the pinned model, not jev-latest (calibration and reachability agree).
jq -nc --arg m "$JEV_MODEL_PIN" \
  '{model:$m,state:"The sky is blue on a clear day.",questions:{probe:{type:"noul",instructions:"Does the state describe the colour of the sky?"}}}' \
  > "$req"

if ! jev_request "$req" "$resp"; then
  fail "Jev request failed (network, HTTP, schema, or model mismatch)"
fi

if ! jev_read_noul "$resp" probe >/dev/null; then
  fail "HTTP 200 but no numeric Noul answer at answers.probe.noul"
fi

echo ok
