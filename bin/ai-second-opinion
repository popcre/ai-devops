REVIEW_SUFFIX = """

Review the change between {base} and HEAD in this repository copy. The diff is
below; read surrounding files when needed. Report concrete defects first, with
paths. End with exactly one final line: VERDICT: APPROVE, VERDICT: REJECT or
VERDICT: REVISE.

{fence}diff
{diff}
{fence}
"""


def die(msg, code=1):
    print(f"ai-second-opinion: {msg}", file=sys.stderr)
    sys.exit(code)


def doctor_diagnostics(provider, state):
    """Retain only redacted probe outcomes, never the disposable repository."""
    import tempfile
    parent = os.path.join(state, ".doctor-diagnostics", provider)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    info = os.lstat(parent)
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or (os.name != "nt" and info.st_mode & 0o077):
        die("doctor diagnostics directory must be private and not a symlink")
    directory = tempfile.mkdtemp(prefix=time.strftime("%Y%m%dT%H%M%SZ-", time.gmtime()), dir=parent)
    return os.path.join(directory, "outcomes.json")


def save_doctor_diagnostics(path, provider, attempts, status):
    value = {"schema_version": 1, "provider": provider, "model": ars.PROVIDERS[provider]["model"],
             "status": status, "attempts": attempts, "prompt_kind": "synthetic-ready-only"}
    temporary = path + ".tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(value, fh, indent=2)
    os.replace(temporary, path)


def git(repo, *args, check=True):
    return subprocess.run(["git", "-C", repo, *args], check=check, capture_output=True,
                          text=True, encoding="utf-8", errors="replace").stdout


def session_dir(provider, name):
    if not name or "/" in name or "\\" in name or name.startswith("."):
        die(f"invalid session name: {name!r}")
    return os.path.join(STATE, provider, name)


def meta_route(meta):
    return (meta or {}).get("route")


def load_meta(sdir):
    try:
        with open(os.path.join(sdir, "meta.json")) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def save_meta(sdir, meta):
    tmp = os.path.join(sdir, "meta.json.tmp")
    with open(tmp, "w") as fh:
        json.dump(meta, fh, indent=1)
    os.replace(tmp, os.path.join(sdir, "meta.json"))


def copy_repo(repo, work, writable):
    """Private copy: HEAD, plus tracked edits and untracked files, no remote."""
    top = git(repo, "rev-parse", "--show-toplevel").strip()
    subprocess.run(["git", "clone", "--quiet", "--no-hardlinks", top, work],
                   check=True, capture_output=True)
    subprocess.run(["git", "-C", work, "remote", "remove", "origin"], capture_output=True)
    patch = subprocess.run(["git", "-C", top, "diff", "--binary", "HEAD"],
                           check=True, capture_output=True).stdout
    if patch.strip():
        subprocess.run(["git", "-C", work, "apply", "--whitespace=nowarn"], input=patch,
                       capture_output=True)
    for rel in git(top, "ls-files", "--others", "--exclude-standard", "-z").split("\0"):
        if not rel:
            continue
        src, dst = os.path.join(top, rel), os.path.join(work, rel)
        if os.path.isfile(src) and not os.path.islink(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
    if writable:
        subprocess.run(["git", "-C", work, "add", "-A"], capture_output=True)
        subprocess.run(["git", "-C", work, "-c", "user.name=second-opinion",
                        "-c", "user.email=second-opinion@localhost", "commit", "-q",
                        "--allow-empty", "-m", "baseline"], capture_output=True)
    else:
        for d, _dirs, files in os.walk(work):
            if os.sep + ".git" in d + os.sep:
                continue
            for f in files:
                p = os.path.join(d, f)
                if not os.path.islink(p):
                    os.chmod(p, stat.S_IRUSR | stat.S_IRGRP)
    return top


def write_config(sdir, provider, agent_name, agent_text, spec=None, cache=None):
    cfg_dir = os.path.join(sdir, "xdg", "config", "opencode")
    os.makedirs(os.path.join(cfg_dir, "agent"), exist_ok=True)
    spec = spec or ars.PROVIDERS[provider]
    cfg = {"$schema": "https://opencode.ai/config.json", "model": spec["model"],
           "share": "disabled", "autoupdate": False}
    if spec["provider"]:
        cfg["provider"] = spec["provider"]
        if cache and spec.get("route"):
            cfg["provider"] = RR.opencode_provider_block(RR.route(spec["route"]),
                                                         cache=cache)
    with open(os.path.join(cfg_dir, "opencode.json"), "w") as fh:
        json.dump(cfg, fh, indent=1)
    with open(os.path.join(cfg_dir, "agent", agent_name + ".md"), "w") as fh:
        fh.write(agent_text)
    os.makedirs(os.path.join(sdir, "home"), exist_ok=True)


def session_id(stdout):
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if isinstance(ev, dict):
            sid = ev.get("sessionID") or (ev.get("part") or {}).get("sessionID")
            if sid:
                return sid
    return None


class SessionLock:
    """One turn at a time per named session (#2549/#2550): a concurrent resume
    is rejected instead of racing the transcript or the runtime session."""

    def __init__(self, sdir):
        self.dir = os.path.join(sdir, ".lock")
        self.wait = float(os.environ.get("AI_SECOND_OPINION_LOCK_WAIT") or "15")

    def __enter__(self):
        deadline = time.time() + self.wait
        while True:
            try:
                os.mkdir(self.dir)
            except FileExistsError:
                if time.time() >= deadline:
                    die("session is busy: another turn is running.", 1)
                time.sleep(0.5)
                continue
            try:
                with open(os.path.join(self.dir, "owner"), "w") as fh:
                    fh.write(f"{os.getpid()} {time.time()}\n")
            except OSError:
                pass
            return self

    def __exit__(self, *_exc):
        try:
            os.remove(os.path.join(self.dir, "owner"))
            os.rmdir(self.dir)
        except OSError:
            pass


def kill_process_tree(proc):
    """Timeout cleanup: take the whole tree, not just the .cmd shim, so no
    orphaned child keeps the private workspace open (#2549/#2550)."""
    try:
        if hasattr(os, "killpg"):
            os.killpg(proc.pid, signal.SIGKILL)
        elif os.name == "nt":
            subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                           capture_output=True)
        else:
            proc.kill()
    except OSError:
        pass
    try:
        proc.communicate(timeout=10)
    except Exception:
        pass


def harness_session_id(stdout):
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if isinstance(ev, dict) and ev.get("type") == "session" and ev.get("sessionId"):
            return ev["sessionId"]
    return None


def write_harness_profile(sdir, spec):
    """A private, persistent DeepSeek Harness home per named session."""
    profiles = os.path.join(sdir, "dsh-home", "profiles", "headless")
    os.makedirs(profiles, exist_ok=True)
    with open(os.path.join(profiles, "cordis.patch.yml"), "w", encoding="utf-8") as fh:
        fh.write(RR.harness_patch_yaml(spec))


def run_harness_turn(provider, sdir, meta, prompt, spec, route):
    """One DeepSeek Harness turn with native session resume (#2549)."""
    key = ars.read_key(spec)
    if not key:
        die(f"{provider}: no API key (secret file {spec['key_file']}).", 3)
    dsh = RR.resolve_deepseek_harness()
    if not dsh:
        die("deepseek harness binary not found; run bin/setup-deepseek-harness.sh.", 3)
    write_harness_profile(sdir, spec)
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.path.join(sdir, "home"),
           "DSH_HOME": os.path.join(sdir, "dsh-home"), "PYTHONDONTWRITEBYTECODE": "1",
           spec["key_env"]: key}
    for n in ("LANG", "TMPDIR", "TEMP", "TMP", "SYSTEMROOT", "PATHEXT", "COMSPEC", "WINDIR",
              "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS", "AI_REVIEW_SIMPLE_FAKE_STATE"):
        if os.environ.get(n):
            env[n] = os.environ[n]
    if os.name == "nt":
        env["USERPROFILE"] = env["HOME"]
    cmd = [dsh, "--profile", "headless", "--json", "--permission-mode", "read-only",
           "--approval-policy", "never"]
    resume = meta.get("session")
    if resume:
        cmd += ["--session-id", resume]
    cmd.append("-")
    timeout = int(os.environ.get("AI_SECOND_OPINION_TIMEOUT") or spec["timeout"])
    meta.update(state="running", pid=os.getpid(), updated=time.time())
    save_meta(sdir, meta)
    proc = subprocess.Popen(cmd, cwd=meta["work"], env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            encoding="utf-8", errors="replace",
                            start_new_session=hasattr(os, "killpg"))
    try:
        out, err = proc.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_process_tree(proc)
        meta.update(state="failed", updated=time.time())
        save_meta(sdir, meta)
        die(f"{provider}: no answer within {timeout}s.", 3)
    final, ev_err = ars.read_harness_events(out)
    sid = resume or harness_session_id(out)
    answer = ars.redact((final or "").strip(), key)
    label = f"{provider} via {route}" if route else provider
    with open(os.path.join(sdir, "transcript.md"), "a", encoding="utf-8") as fh:
        fh.write(f"\n\n## Request ({time.strftime('%Y-%m-%d %H:%M:%S')})\n\n{prompt}\n"
                 f"\n## {label}\n\n{ars.redact((final or '').strip(), key)}\n")
    return answer, sid, ev_err, err, key, proc.returncode


def sanitized_replay(meta):
    """Visible turns only (request + final answer), never tool records or
    private reasoning, for a cross-route Muse continuation (plan section 9)."""
    turns = meta.get("visible") or []
    if not turns:
        return ""
    blocks = ["Prior conversation (sanitized visible turns; tool records omitted):"]
    for i, turn in enumerate(turns, 1):
        blocks.append(f"--- turn {i} ---\nRequest: {turn.get('q', '').strip()}\n"
                      f"Answer: {turn.get('a', '').strip()}")
    return "\n".join(blocks) + "\n\nAnswer the new request below under the same rules.\n\n"


def run_opencode(provider, sdir, meta, prompt, route=None):
    """One turn. Returns the answer text; exits 3 when the provider is unavailable."""
    known = RR.routes()
    auto = route == "auto"
    if route and route != "auto" and route not in known:
        die(f"unknown reviewer route: {route}", 2)
    if auto and provider != "muse":
        die('route "auto" is only valid for muse (same-model failover).', 2)
    spec = dict(ars.PROVIDERS[provider])
    effective = None
    if route and route != "auto":
        effective = route
    elif auto:
        effective = meta.get("route") if meta.get("route") in known else "muse-meta"
    elif spec.get("route") in known:
        effective = spec["route"]
    if effective:
        spec = ars.spec_for(provider, effective)
    with SessionLock(sdir):
        if spec.get("engine") == "deepseek-harness":
            answer, sid, ev_err, err, key, rc = run_harness_turn(
                provider, sdir, meta, prompt, spec, effective)
            if not answer:
                problem = ars.redact("\n".join(x for x in (ev_err, (err or "")[-2000:])
                                               if x.strip()), key)
                meta.update(state="failed", updated=time.time())
                save_meta(sdir, meta)
                kind = "out of credit" if ars.is_credit_error(problem) else f"no answer (exit {rc})"
                die(f"{provider}: {kind}: {problem[:800]}", 3)
            if sid:
                meta["session"] = sid
            meta.update(state="idle", turns=meta.get("turns", 0) + 1, updated=time.time())
            meta.pop("pid", None)
            if effective:
                meta["route"] = effective
                meta.setdefault("visible", []).append({"q": prompt, "a": answer})
            save_meta(sdir, meta)
            return answer
        return _run_opencode_turn(provider, sdir, meta, prompt, spec, effective, auto)


def _run_opencode_turn(provider, sdir, meta, prompt, spec, effective, auto, new_session=False):
    key = ars.read_key(spec)
    if not key:
        die(f"{provider}: no API key (secret file {spec['key_file']}).", 3)
    oc = ars.resolve_opencode()
    if not oc:
        die("opencode binary not found; run the normal installer.", 3)
    xdg = os.path.join(sdir, "xdg")
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.path.join(sdir, "home"),
           "XDG_CONFIG_HOME": os.path.join(xdg, "config"), "XDG_DATA_HOME": os.path.join(xdg, "data"),
           "XDG_STATE_HOME": os.path.join(xdg, "state"), "XDG_CACHE_HOME": os.path.join(xdg, "cache"),
           "OPENCODE_DISABLE_CLAUDE_CODE": "1", "OPENCODE_DISABLE_EXTERNAL_SKILLS": "1",
           "PYTHONDONTWRITEBYTECODE": "1", spec["key_env"]: key}
    if os.name == "nt":
        env["USERPROFILE"] = env["HOME"]
    for n in ("LANG", "TMPDIR", "TEMP", "TMP", "SYSTEMROOT", "PATHEXT", "COMSPEC", "WINDIR", "SSL_CERT_FILE", "SSL_CERT_DIR",
              "NODE_EXTRA_CA_CERTS", "AI_REVIEW_SIMPLE_FAKE_STATE"):
        if os.environ.get(n):
            env[n] = os.environ[n]
    ars.seed_models(xdg, env)
    work = meta["work"]
    cmd = [oc, "run", "--agent", meta["agent"], "--auto", "--format", "json",
           "--model", spec["model"], "--dir", work]
    if meta.get("session") and not new_session:
        cmd += ["--session", meta["session"]]
    timeout = int(os.environ.get("AI_SECOND_OPINION_TIMEOUT") or spec["timeout"])
    meta.update(state="running", pid=os.getpid(), updated=time.time())
    save_meta(sdir, meta)
    proc = subprocess.Popen(cmd, cwd=work, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            encoding="utf-8", errors="replace",
                            start_new_session=hasattr(os, "killpg"))
    try:
        out, err = proc.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_process_tree(proc)
        meta.update(state="failed", updated=time.time())
        save_meta(sdir, meta)
        die(f"{provider}: no answer within {timeout}s.", 3)
    meta["session"] = meta.get("session") or session_id(out)
    full, final, ev_err = ars.read_events(out)
    answer = ars.redact((final or full or "").strip(), key)
    label = f"{provider} via {effective}" if effective else provider
    with open(os.path.join(sdir, "transcript.md"), "a", encoding="utf-8") as fh:
        fh.write(f"\n\n## Request ({time.strftime('%Y-%m-%d %H:%M:%S')})\n\n{prompt}\n"
                 f"\n## {label}\n\n{ars.redact((full or '').strip(), key)}\n")
    if not answer:
        problem = ars.redact("\n".join(x for x in (ev_err, (err or "")[-2000:]) if x.strip()), key)
        if auto and effective == "muse-meta" and RR.classify(problem)[0] == "advance":
            return _muse_failover(provider, sdir, meta, prompt, problem)
        meta.update(state="failed", updated=time.time())
        save_meta(sdir, meta)
        kind = "out of credit" if ars.is_credit_error(problem) else f"no answer (exit {proc.returncode})"
        die(f"{provider}: {kind}: {problem[:800]}", 3)
    meta.update(state="idle", turns=meta.get("turns", 0) + 1, updated=time.time())
    meta.pop("pid", None)
    if effective:
        meta["route"] = effective
        meta.setdefault("visible", []).append({"q": prompt, "a": answer})
    save_meta(sdir, meta)
    return answer


def _muse_failover(provider, sdir, meta, prompt, first_error):
    """Same-model Muse continuation on a confirmed connection failure.

    The direct session is route-bound, so the OpenRouter turn starts a new
    scoped runtime session from the sanitized visible turns plus this one
    question. The new binding is saved only after a valid answer; a failed
    fallback leaves the last-good record untouched (plan section 9 step 3)."""
    spec = ars.spec_for(provider, "muse-openrouter")
    # The session's on-disk OpenCode profile still names the direct provider;
    # rewrite it for the alternate connection before the continuation runs.
    write_config(sdir, provider, meta["agent"], READ_AGENT, spec=spec,
                 cache=RR.cache_fields("muse-openrouter", meta.get("repo"), meta.get("name")))
    replay = sanitized_replay(meta) + f"New request: {prompt}"
    meta.update(state="failing-over", updated=time.time())
    save_meta(sdir, meta)
    previous_session = meta.get("session")
    meta["session"] = None
    try:
        answer = _run_opencode_turn(provider, sdir, meta, replay, spec, "muse-openrouter",
                                    False, new_session=True)
    except SystemExit as exc:
        meta["session"] = previous_session
        meta.update(state="failed", updated=time.time())
        save_meta(sdir, meta)
        die(f"{provider}: muse-meta failed ({first_error[:300]}) and the muse-openrouter "
            f"continuation also failed ({exc.code}); last-good session retained.", 3)
    with open(os.path.join(sdir, "transcript.md"), "a", encoding="utf-8") as fh:
        fh.write(f"\n\n<!-- route failover: muse-meta -> muse-openrouter "
                 f"({time.strftime('%Y-%m-%d %H:%M:%S')}) -->\n")
    return answer


def read_prompt(args):
    if getattr(args, "prompt", None):
        return args.prompt
    if args.prompt_file:
        with open(args.prompt_file, encoding="utf-8") as fh:
            return fh.read()
    text = " ".join(args.text).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read()
    return text


def start(provider, name, repo, writable, base=None, route=None):
    if name is None:
        name = f"oneshot-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    sdir = session_dir(provider, name)
    if os.path.exists(sdir):
        die(f"session {name} already exists; use ask, or delete it first.")
    os.makedirs(sdir)
    work = os.path.join(sdir, "work")
    try:
        top = copy_repo(repo, work, writable)
    except subprocess.CalledProcessError as exc:
        shutil.rmtree(sdir, ignore_errors=True)
        detail = exc.stderr or ""
        if isinstance(detail, bytes):
            detail = detail.decode(errors="replace")
        die("could not copy the repository: " + detail[:300])
    agent = "implement" if writable else "second-opinion"
    spec = (ars.spec_for(provider, route) if route and route in RR.routes()
            else ars.PROVIDERS[provider])
    cache = RR.cache_fields(route, top, name) if route else None
    write_config(sdir, provider, agent, WRITE_AGENT if writable else READ_AGENT, spec=spec,
                 cache=cache)
    meta = {"name": name, "provider": provider, "repo": top, "work": work, "agent": agent,
            "mode": "implement" if writable else "read-only", "base": base,
            "created": time.time(), "turns": 0, "state": "idle"}
    if route and route in RR.routes():
        meta["route"] = route
    save_meta(sdir, meta)
    return sdir, meta


def parse(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="ai-second-opinion")
    ap.add_argument("provider", choices=sorted(ars.PROVIDERS))
    ap.add_argument("command")
    ap.add_argument("text", nargs="*")
    ap.add_argument("--prompt-file")
    ap.add_argument("--prompt")
    ap.add_argument("--repo", default=".")
    ap.add_argument("--base")
    ap.add_argument("--route")
    ap.add_argument("--live", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    args, _unknown = ap.parse_known_args(argv)
    return args


def main(argv):
    global STATE
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    args = parse(argv)
    p, cmd = args.provider, args.command
    route = getattr(args, "route", None)
    if route:
        known = RR.routes()
        if route not in known and route != "auto":
            die(f"unknown reviewer route: {route}", 2)
        if cmd == "implement":
            die("--route is read-only: it cannot run implement.", 2)
        if route == "auto" and p != "muse":
            die('route "auto" is only valid for muse (same-model failover).', 2)
        if route in known and RR.route(route)["reviewer"] != p and p != route:
            die(f"route {route} does not belong to provider {p}.", 2)

    if cmd in ("new", "ask", "implement"):
        name = existing = None
        t = args.text
        if t and "/" not in t[0] and " " not in t[0] and load_meta(os.path.join(STATE, p, t[0])):
            existing = name = t[0]
            args.text = t[1:]
        elif t and " " not in t[0] and (
                (cmd in ("new", "implement") and (len(t) >= 2 or args.prompt_file or args.prompt))
                or (args.prompt_file and len(t) == 1)):
            name = t[0]
            args.text = t[1:]
        prompt = read_prompt(args)
        if not prompt.strip():
            die("nothing to ask: give --prompt-file or text.")
        if existing:
            if cmd == "new":
                die(f"session {name} already exists; use ask.")
            if route and route != "auto" and meta_route(load_meta(os.path.join(STATE, p, name)))                     not in (None, route):
                bound = meta_route(load_meta(os.path.join(STATE, p, name)))
                die(f"session {name} is bound to route {bound}; explicit selection is sticky.", 2)
            sdir = os.path.join(STATE, p, name)
            meta = load_meta(sdir)
        else:
            sdir, meta = start(p, name, args.repo, cmd == "implement", args.base,
                               route=route if route in RR.routes() else None)
        print(run_opencode(p, sdir, meta, prompt, route=route))
        if meta["mode"] == "implement":
            git(meta["work"], "add", "-A", check=False)
            diff = git(meta["work"], "diff", "--cached", "HEAD")
            print(f"\n--- {p} changes (private copy {meta['work']}; apply with "
                  f"`ai-second-opinion {p} diff {meta['name']} | git apply`) ---\n{diff or '(no changes)'}")
        print(f"\n[session {meta['name']}]", file=sys.stderr)
        return 0

    if cmd == "review":
        repo = git(args.repo, "rev-parse", "--show-toplevel").strip()
        base = args.base or "origin/main"
        mb = git(repo, "merge-base", base, "HEAD").strip()
        diff = git(repo, "diff", mb)
        if len(diff) > ars.MAX_DIFF:
            diff = diff[:ars.MAX_DIFF] + "\n[diff truncated; read the files directly]\n"
        runs = [len(m) for m in __import__("re").findall(r"`{3,}", diff)]
        fence = "`" * max([3] + [n + 1 for n in runs])
        brief = read_prompt(args) if (args.prompt_file or args.text) else "Review this change."
        prompt = brief + REVIEW_SUFFIX.format(base=base, fence=fence, diff=diff)
        sdir, meta = start(p, None, repo, False, base,
                           route=route if route in RR.routes() else None)
        print(run_opencode(p, sdir, meta, prompt, route=route))
        return 0

    if cmd == "list":
        root = os.path.join(STATE, p)
        for n in sorted(os.listdir(root)) if os.path.isdir(root) else []:
            m = load_meta(os.path.join(root, n))
            if m:
                print(f"{n}\t{m.get('mode')}\t{m.get('state')}\tturns={m.get('turns', 0)}\t"
                      f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(m.get('updated', m['created'])))}")
        return 0

    if cmd in ("server", "reconcile", "finalize-failed-turn") and not args.text[1:]:
        if cmd == "server":
            print(f"{p}: no server is needed; each call runs OpenCode directly.")
            return 0

    if cmd in ("show", "transcript", "diff", "abort", "delete", "reconcile", "finalize-failed-turn"):
        if not args.text:
            die(f"{cmd} needs a session name.")
        sdir = session_dir(p, args.text[0])
        meta = load_meta(sdir)
        if not meta:
            die(f"no session named {args.text[0]}.")
        if cmd in ("show", "reconcile", "finalize-failed-turn"):
            print(json.dumps(meta, indent=1))
        elif cmd == "transcript":
            with open(os.path.join(sdir, "transcript.md"), encoding="utf-8") as fh:
                sys.stdout.write(fh.read())
        elif cmd == "diff":
            git(meta["work"], "add", "-A", check=False)
            sys.stdout.write(git(meta["work"], "diff", "--cached", "HEAD"))
        elif cmd == "abort":
            pid = meta.get("pid")
            if pid and meta.get("state") == "running":
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
            meta.update(state="aborted", updated=time.time())
            save_meta(sdir, meta)
            print(f"{args.text[0]}: aborted")
        elif cmd == "delete":
            for d, dirs, files in os.walk(sdir):
                for x in dirs + files:
                    try:
                        os.chmod(os.path.join(d, x), stat.S_IRWXU)
                    except OSError:
                        pass
            shutil.rmtree(sdir)
            print(f"{args.text[0]}: deleted")
        return 0

    if cmd == "store-key":
        if_missing = "--if-missing" in argv
        if if_missing and ars.read_key(p):
            print(f"{p}: key store already present")
            return 0
        key = "" if sys.stdin.isatty() else sys.stdin.readline().strip()
        if not key and OP_REFS.get(p) and shutil.which("op"):
            env = dict(os.environ)
            tok = os.path.expanduser("~/.config/ai-devops/op-service-account")
            if not env.get("OP_SERVICE_ACCOUNT_TOKEN") and os.path.isfile(tok):
                with open(tok) as fh:
                    env["OP_SERVICE_ACCOUNT_TOKEN"] = fh.read().strip()
            r = subprocess.run(["op", "read", OP_REFS[p]], env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=120)
            key = r.stdout.strip() if r.returncode == 0 else ""
        if not key:
            die(f"store-key: no key on stdin and none readable from 1Password for {p}.")
        if p == "glm":
            die("glm keys are stored by bin/setup-opencode-glm.sh; nothing written.")
        secrets = os.environ.get("AI_REVIEW_SIMPLE_SECRETS_DIR",
                                 os.path.expanduser("~/.config/ai-devops/secrets"))
        os.makedirs(secrets, mode=0o700, exist_ok=True)
        path = os.path.join(secrets, ars.PROVIDERS[p]["key_file"])
        tmp = path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(key + "\n")
        os.replace(tmp, path)
        print(f"{p}: key stored")
        return 0

    if cmd == "doctor":
        ok = True
        oc = ars.resolve_opencode()
        print(f"opencode: {oc or 'MISSING'}")
        ok &= bool(oc)
        has_key = bool(ars.read_key(p))
        print(f"{p} key: {'present' if has_key else 'MISSING'}")
        ok &= has_key
        print(f"model: {ars.PROVIDERS[p]['model']}")
        if ok and args.live:
            import tempfile
            diagnostic_path = doctor_diagnostics(p, STATE)
            attempts = []
            save_doctor_diagnostics(diagnostic_path, p, attempts, "running")
            try:
                with tempfile.TemporaryDirectory() as tmp:
                    subprocess.run(["git", "init", "-q", tmp], check=True)
                    with open(os.path.join(tmp, "README"), "w") as fh:
                        fh.write("probe\n")
                    subprocess.run(["git", "-C", tmp, "add", "README"], check=True)
                    subprocess.run(["git", "-C", tmp, "-c", "user.name=p", "-c", "user.email=p@l",
                                    "commit", "-qm", "p"], check=True)
                    STATE = os.path.join(tmp, "state")
                    # The provider or OpenCode sometimes answers a single call with a
                    # transient "Unexpected server error" (about one call in five for
                    # GLM on 2026-10-31), which failed whole installs. Retry a failed
                    # probe with a fresh session; a real fault fails all attempts.
                    ans = ""
                    for attempt in range(3):
                        started = time.monotonic()
                        errors = io.StringIO()
                        exit_code = 0
                        try:
                            with contextlib.redirect_stderr(errors):
                                sdir, meta = start(p, f"doctor{attempt}", tmp, False)
                                ans = run_opencode(p, sdir, meta, "Reply with exactly the word READY.")
                        except SystemExit as error:
                            ans = ""
                            exit_code = error.code if type(error.code) is int else 1
                        problem = ars.redact(errors.getvalue(), ars.read_key(p))[-4000:]
                        outcome = "ready" if "READY" in ans.upper() else "timeout" if "no answer within" in problem else "provider_unavailable" if exit_code else "unexpected_reply"
                        attempts.append({"attempt": attempt + 1, "outcome": outcome, "exit_code": exit_code,
                                         "elapsed_ms": round((time.monotonic() - started) * 1000),
                                         "error": problem, "answer_excerpt": ars.redact(ans.strip(), ars.read_key(p))[:160]})
                        save_doctor_diagnostics(diagnostic_path, p, attempts, "passed" if outcome == "ready" else "running" if attempt < 2 else "failed")
                        if "READY" in ans.upper():
                            break
                        if attempt < 2:
                            print(f"live: attempt {attempt + 1} failed; retrying", file=sys.stderr)
                            time.sleep(3)
                    print(f"live: {ars.redact(ans.strip(), ars.read_key(p))[:80]}")
                    ok &= "READY" in ans.upper()
            except Exception as error:
                problem = ars.redact(f"{type(error).__name__}: {error}", ars.read_key(p))[-4000:]
                attempts.append({"attempt": len(attempts) + 1, "outcome": "local_error", "exit_code": 1,
                                 "elapsed_ms": 0, "error": problem, "answer_excerpt": ""})
                save_doctor_diagnostics(diagnostic_path, p, attempts, "failed")
                print(f"live diagnostics: {diagnostic_path}", file=sys.stderr)
                die(problem, 1)
            print(f"live diagnostics: {diagnostic_path}", file=sys.stderr)
        print("doctor: OK" if ok else "doctor: FAILED")
        return 0 if ok else 3

    die(f"unknown command {cmd!r}; see --help.")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
