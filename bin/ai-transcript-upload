#!/usr/bin/env bash
# ai-transcript-upload — daily copy of this host's AI session transcripts into
# Dropbox/ai/chat_transcripts/<live hostname>/ (plan_transcript-store.md step 1).
#
# Copy rules: skip files modified in the last 15 minutes; copy through
# <D>/.partial/ and rename into place only when the size matches the source
# (retry once, then skip); copy when the destination is missing, its size
# differs, or the source is newer. Never deletes anything in the destination
# and never reads or parses file contents.
#
# usage: ai-transcript-upload [--dropbox DIR] [--host NAME] [--hot-minutes N]
#                             [--map SRC=DESTREL]... [--pull HOST]
#        ai-transcript-upload --install [--with-pull HOST] | --check | --remove
#   --map       replaces the default source map (repeatable; tests use it).
#   --pull      also pull HOST's transcripts over SSH (rsync) into a local cache
#               and upload them as chat_transcripts/HOST/ (for hosts without
#               Dropbox, e.g. hetz). Same hot-file and .partial rules.
# Environment: AI_TRANSCRIPT_PULL_SSH (default "ssh -i ~/.ssh/916-alien -o
#   BatchMode=yes"), AI_TRANSCRIPT_PULL_USER (default root),
#   AI_TRANSCRIPT_PULL_LOCAL_ROOT (tests: rsync from this local dir instead),
#   AI_TRANSCRIPT_UPLOAD_SYSTEMCTL, AI_TRANSCRIPT_UPLOAD_STATE_DIR.
# On Windows (Git Bash) it hands off to ai-transcript-upload.ps1.
set -u

self="${BASH_SOURCE[0]}"
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$(dirname "$self")/ai-transcript-upload.ps1")" "$@" ;;
esac

dropbox="${HOME}/Dropbox"; host="$(hostname 2>/dev/null || uname -n)"; host="${host%%.*}"
hot_min=15; maps=(); pull=""; mode=run; with_pull=""
while (($#)); do
  case "$1" in
    --dropbox) dropbox="$2"; shift 2 ;;
    --host) host="$2"; shift 2 ;;
    --hot-minutes) hot_min="$2"; shift 2 ;;
    --map) maps+=("$2"); shift 2 ;;
    --pull) pull="$2"; shift 2 ;;
    --install) mode=install; shift ;;
    --with-pull) with_pull="$2"; shift 2 ;;
    --check) mode=check; shift ;;
    --remove) mode=remove; shift ;;
    -h|--help) sed -n '2,24p' "$self"; exit 0 ;;
    *) echo "ai-transcript-upload: unknown option: $1" >&2; exit 2 ;;
  esac
done
case "$hot_min" in ''|*[!0-9]*) echo "ai-transcript-upload: --hot-minutes needs a whole number" >&2; exit 2 ;; esac

state_dir="${AI_TRANSCRIPT_UPLOAD_STATE_DIR:-$HOME/.local/state/ai-devops}"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ai-devops"
systemctl_cmd="${AI_TRANSCRIPT_UPLOAD_SYSTEMCTL:-systemctl}"
unit=ai-transcript-upload

if [ "$mode" = remove ]; then
  "$systemctl_cmd" --user disable --now "$unit.timer" >/dev/null 2>&1 || true
  rm -f "$unit_dir/$unit.timer" "$unit_dir/$unit.service" "$cfg_dir/transcript-upload"
  "$systemctl_cmd" --user daemon-reload >/dev/null 2>&1 || true
  echo "OK transcript upload timer removed (Dropbox copies are left as they are)"; exit 0
fi
if [ "$mode" = check ]; then
  rc=0
  [ -x "$cfg_dir/transcript-upload" ] || { echo "ERROR $cfg_dir/transcript-upload not installed"; rc=1; }
  cmp -s "$self" "$cfg_dir/transcript-upload" || { echo "ERROR installed copy differs from $self"; rc=1; }
  [ -f "$unit_dir/$unit.timer" ] || { echo "ERROR $unit.timer not installed"; rc=1; }
  "$systemctl_cmd" --user is-enabled "$unit.timer" >/dev/null 2>&1 || { echo "ERROR $unit.timer not enabled"; rc=1; }
  ((rc)) || echo "OK transcript upload timer installed"
  exit "$rc"
fi
if [ "$mode" = install ]; then
  mkdir -p "$cfg_dir" "$unit_dir" || exit 1
  cp "$self" "$cfg_dir/transcript-upload.tmp.$$" && chmod +x "$cfg_dir/transcript-upload.tmp.$$" \
    && mv -f "$cfg_dir/transcript-upload.tmp.$$" "$cfg_dir/transcript-upload" || exit 1
  {
    printf '[Unit]\nDescription=Copy AI session transcripts to Dropbox (ai-devops)\n\n[Service]\nType=oneshot\n'
    printf 'ExecStart=-/usr/bin/env bash "%%h/.config/ai-devops/transcript-upload"\n'
    [ -n "$with_pull" ] && printf 'ExecStart=-/usr/bin/env bash "%%h/.config/ai-devops/transcript-upload" --pull %s --map none\n' "$with_pull"
  } > "$unit_dir/$unit.service"
  printf '[Unit]\nDescription=Daily AI transcript upload to Dropbox\n\n[Timer]\nOnCalendar=*-*-* 06:30:00\nRandomizedDelaySec=900\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' > "$unit_dir/$unit.timer"
  "$systemctl_cmd" --user daemon-reload || exit 1
  "$systemctl_cmd" --user enable --now "$unit.timer" || exit 1
  echo "OK transcript upload timer installed (daily 06:30 local${with_pull:+, also pulls $with_pull})"; exit 0
fi

# ---------- run ----------
root="$dropbox/ai/chat_transcripts"
[ -d "$root" ] || { echo "ai-transcript-upload: $root not found (Dropbox missing?)" >&2; exit 1; }
now="$(date +%s)"; scanned=0; copied=0; hot=0; errors=0

fsize() { stat -L -c %s -- "$1" 2>/dev/null; }
fmtime() { stat -L -c %Y -- "$1" 2>/dev/null; }

copy_one() { # SRCFILE DEST PARTIAL SRCSIZE
  local src="$1" dest="$2" part="$3" want="$4" try got
  mkdir -p -- "$(dirname -- "$part")" "$(dirname -- "$dest")" || return 1
  for try in 1 2; do
    cp -p -- "$src" "$part" 2>/dev/null || { rm -f -- "$part"; return 1; }
    got="$(fsize "$part")"
    if [ "$got" = "$want" ] && [ "$(fsize "$src")" = "$want" ]; then
      mv -f -- "$part" "$dest" && return 0
      rm -f -- "$part"; return 1
    fi
    rm -f -- "$part"; want="$(fsize "$src")"
  done
  return 2
}

upload_tree() { # SRCDIR DESTDIR PARTIALDIR
  local src="$1" dest="$2" part="$3" f rel s m ds dm rc
  [ -d "$src" ] || return 0
  src="$(readlink -f -- "$src")"
  while IFS= read -r -d '' f; do
    rel="${f#"$src"/}"; scanned=$((scanned + 1))
    s="$(fsize "$f")"; m="$(fmtime "$f")"
    [ -n "$s" ] && [ -n "$m" ] || { errors=$((errors + 1)); continue; }
    if (( now - m < hot_min * 60 )); then hot=$((hot + 1)); continue; fi
    if [ -e "$dest/$rel" ]; then
      ds="$(fsize "$dest/$rel")"; dm="$(fmtime "$dest/$rel")"
      [ "$ds" = "$s" ] && (( m <= ${dm:-0} )) && continue
    fi
    copy_one "$f" "$dest/$rel" "$part/$rel" "$s"; rc=$?
    case "$rc" in 0) copied=$((copied + 1)) ;; 2) ;; *) errors=$((errors + 1)) ;; esac
  done < <(find -L "$src" -type f -print0 2>/dev/null)
}

write_log() { # HOSTFOLDER
  local line dir="$root/$1"
  line="$(TZ=America/New_York date '+%Y-%m-%d %H:%M:%S %Z') host=$1 scanned=$scanned copied=$copied skipped_hot=$hot errors=$errors"
  mkdir -p "$state_dir" "$dir" && printf '%s\n' "$line" >> "$state_dir/transcript-upload.log"
  printf '%s\n' "$line" > "$dir/.upload-last.txt.tmp.$$" && mv -f "$dir/.upload-last.txt.tmp.$$" "$dir/.upload-last.txt"
  printf '%s\n' "$line"
}

run_maps() { # HOSTFOLDER MAP...
  local folder="$1" m; shift
  for m in "$@"; do
    [ "$m" = none ] && continue
    upload_tree "${m%%=*}" "$root/$folder/${m#*=}" "$root/$folder/.partial/${m#*=}"
  done
}

status=0
if ((${#maps[@]} == 0)); then
  if [ "$host" = hetz ]; then
    maps=(/root/.claude/projects=root/claude/projects /root/.codex/sessions=root/codex/sessions
          /home/ai/.claude/projects=ai/claude/projects /home/ai/.codex/sessions=ai/codex/sessions)
  else
    maps=("$HOME/.claude/projects=claude/projects" "$HOME/.codex/sessions=codex/sessions"
          "$HOME/.codex/archived_sessions=codex/archived_sessions")
  fi
fi
if ! { ((${#maps[@]} == 1)) && [ "${maps[0]}" = none ]; }; then
  run_maps "$host" "${maps[@]}"; write_log "$host"; ((errors)) && status=1
fi

if [ -n "$pull" ]; then
  scanned=0; copied=0; hot=0; errors=0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/ai-devops/transcript-pull/$pull"
  ssh_cmd="${AI_TRANSCRIPT_PULL_SSH:-ssh -i $HOME/.ssh/916-alien -o BatchMode=yes}"
  user="${AI_TRANSCRIPT_PULL_USER:-root}"
  for m in /root/.claude/projects=root/claude/projects /root/.codex/sessions=root/codex/sessions \
           /home/ai/.claude/projects=ai/claude/projects /home/ai/.codex/sessions=ai/codex/sessions; do
    rsrc="${m%%=*}"; rel="${m#*=}"; mkdir -p "$cache/$rel"
    if [ -n "${AI_TRANSCRIPT_PULL_LOCAL_ROOT:-}" ]; then
      [ -d "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rsrc" ] || continue
      rsync -a -- "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rsrc/" "$cache/$rel/" || errors=$((errors + 1))
    else
      rsync -a -e "$ssh_cmd" -- "$user@$pull:$rsrc/" "$cache/$rel/" 2>/dev/null || errors=$((errors + 1))
    fi
    upload_tree "$cache/$rel" "$root/$pull/$rel" "$root/$pull/.partial/$rel"
  done
  write_log "$pull"; ((errors)) && status=1
fi
exit "$status"
