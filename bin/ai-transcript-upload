#!/usr/bin/env bash
# ai-transcript-upload — daily copy of this host's AI session transcripts into
# Dropbox/ai/chat_transcripts/<live hostname>/ (plan_transcript-store.md step 1).
#
# Copy rules: skip files modified in the last 15 minutes; copy through
# <D>/.partial/ and rename into place only when the size matches the source
# (retry once, then skip); copy when the destination is missing, its size
# differs, or the source is newer. Never deletes anything in the destination
# and never reads or parses file contents.
#
# usage: ai-transcript-upload [--dropbox DIR] [--host NAME] [--hot-minutes N]
#                             [--map SRC=DESTREL]... [--pull HOST]
#        ai-transcript-upload --install [--with-pull HOST] | --sync | --check | --remove
#   The installed copy updates itself from merged main at the start of each run;
#   a failed update never stops the upload and is logged as self_update=failed.
#   --check fails when the installed files differ from merged main, or main cannot
#   be read. --sync is the installers' stage: install on a host with Dropbox or an
#   existing timer, otherwise SKIP. --install keeps an existing --pull.
#   --map       replaces the default source map (repeatable; tests use it).
#   --pull      also pull HOST's transcripts over SSH (rsync) into a local cache
#               and upload them as chat_transcripts/HOST/ (for hosts without
#               Dropbox, e.g. hetz). Same hot-file and .partial rules.
# Environment: AI_TRANSCRIPT_PULL_SSH (default "ssh -i ~/.ssh/916-alien -o
#   BatchMode=yes"), AI_TRANSCRIPT_PULL_USER (default root),
#   AI_TRANSCRIPT_PULL_LOCAL_ROOT (tests: rsync from this local dir instead),
#   AI_TRANSCRIPT_UPLOAD_SOURCE (main's raw URL, or a local dir in tests),
#   AI_TRANSCRIPT_UPLOAD_SYSTEMCTL, AI_TRANSCRIPT_UPLOAD_STATE_DIR.
# On Windows (Git Bash) it hands off to ai-transcript-upload.ps1.
set -u

self="${BASH_SOURCE[0]}"
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    # Translate this script's options to the PowerShell twin's parameters.
    ps_args=()
    while (($#)); do
      case "$1" in
        --dropbox) ps_args+=(-DropboxRoot "$(cygpath -w "$2")"); shift 2 ;;
        --host) ps_args+=(-HostName "$2"); shift 2 ;;
        --hot-minutes) ps_args+=(-HotMinutes "$2"); shift 2 ;;
        --map) ps_args+=(-Map "$2"); shift 2 ;;
        --install) ps_args+=(-Install); shift ;;
        --sync) ps_args+=(-Sync); shift ;;
        --check) ps_args+=(-Check); shift ;;
        --remove) ps_args+=(-Remove); shift ;;
        -h|--help) sed -n '2,30p' "$self"; exit 0 ;;
        *) echo "ai-transcript-upload: $1 is not supported on Windows" >&2; exit 2 ;;
      esac
    done
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$(dirname "$self")/ai-transcript-upload.ps1")" "${ps_args[@]}" ;;
esac

# A folder or relative destination must stay inside chat_transcripts/.
safe_name() { case "$1" in ''|*/*|.|..|*[!A-Za-z0-9._-]*) return 1 ;; esac; }
safe_rel() { case "/$1/" in //*|*/../*|*/./*) return 1 ;; esac; case "$1" in *[!A-Za-z0-9._/-]*) return 1 ;; esac; }

orig_args=("$@")
dropbox="${HOME}/Dropbox"; host="$(hostname 2>/dev/null || uname -n)"; host="${host%%.*}"
hot_min=15; maps=(); pull=""; mode=run; with_pull=""
while (($#)); do
  case "$1" in
    --dropbox) dropbox="$2"; shift 2 ;;
    --host) host="$2"; shift 2 ;;
    --hot-minutes) hot_min="$2"; shift 2 ;;
    --map) maps+=("$2"); shift 2 ;;
    --pull) pull="$2"; shift 2 ;;
    --install) mode=install; shift ;;
    --sync) mode=sync; shift ;;
    --with-pull) with_pull="$2"; shift 2 ;;
    --check) mode=check; shift ;;
    --remove) mode=remove; shift ;;
    -h|--help) sed -n '2,30p' "$self"; exit 0 ;;
    *) echo "ai-transcript-upload: unknown option: $1" >&2; exit 2 ;;
  esac
done
case "$hot_min" in ''|*[!0-9]*) echo "ai-transcript-upload: --hot-minutes needs a whole number" >&2; exit 2 ;; esac
for v in "$host" ${pull:+"$pull"} ${with_pull:+"$with_pull"}; do
  safe_name "$v" || { echo "ai-transcript-upload: unsafe host name: $v" >&2; exit 2; }
done
for m in ${maps[@]+"${maps[@]}"}; do
  [ "$m" = none ] && continue
  case "$m" in *=*) ;; *) echo "ai-transcript-upload: --map needs SRC=DESTREL: $m" >&2; exit 2 ;; esac
  safe_rel "${m#*=}" || { echo "ai-transcript-upload: unsafe destination in --map: ${m#*=}" >&2; exit 2; }
done

state_dir="${AI_TRANSCRIPT_UPLOAD_STATE_DIR:-$HOME/.local/state/ai-devops}"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ai-devops"
systemctl_cmd="${AI_TRANSCRIPT_UPLOAD_SYSTEMCTL:-systemctl}"
unit=ai-transcript-upload
exporter="$(dirname -- "$self")/zcode_export.py"
[ -f "$exporter" ] || exporter="$(dirname -- "$self")/../tools/transcript_store/zcode_export.py"
source_base="${AI_TRANSCRIPT_UPLOAD_SOURCE:-https://raw.githubusercontent.com/popcre/ai-devops/main}"
self_update=""

fetch_main() { # REPO_PATH OUT
  case "$source_base" in
    http*) curl -fsSL --max-time 60 -o "$2" "$source_base/$1" ;;
    *) cp -- "$source_base/$1" "$2" ;;
  esac
}
# Line endings differ between a Windows checkout and main; content does not.
same_text() { cmp -s <(tr -d '\r' < "$1") <(tr -d '\r' < "$2"); }

# Fetch both files from main into DIR and refuse anything that does not parse.
fetch_verified() { # DIR
  fetch_main bin/ai-transcript-upload "$1/transcript-upload" 2>/dev/null \
    && fetch_main tools/transcript_store/zcode_export.py "$1/zcode_export.py" 2>/dev/null \
    && [ -s "$1/transcript-upload" ] && [ -s "$1/zcode_export.py" ] \
    && bash -n "$1/transcript-upload" 2>/dev/null \
    && python3 -c 'import sys; compile(open(sys.argv[1], encoding="utf-8").read(), "x", "exec")' "$1/zcode_export.py" 2>/dev/null
}

update_self() {
  local d changed=0
  d="$(mktemp -d)" || return 1
  if ! fetch_verified "$d"; then rm -rf "$d"; return 1; fi
  same_text "$d/zcode_export.py" "$cfg_dir/zcode_export.py" || mv -f "$d/zcode_export.py" "$cfg_dir/zcode_export.py" || changed=2
  if ! same_text "$d/transcript-upload" "$cfg_dir/transcript-upload"; then
    if chmod +x "$d/transcript-upload" && mv -f "$d/transcript-upload" "$cfg_dir/transcript-upload"; then
      [ "$changed" = 2 ] || changed=1
    else
      changed=2
    fi
  fi
  rm -rf "$d"
  [ "$changed" = 2 ] && return 1
  # Restart once so this run already uses the merged code.
  if [ "$changed" = 1 ]; then AI_TRANSCRIPT_UPLOAD_UPDATED=1 exec bash "$cfg_dir/transcript-upload" ${orig_args[@]+"${orig_args[@]}"}; fi
  return 0
}

if [ "$mode" = sync ]; then
  if [ ! -d "$dropbox/ai/chat_transcripts" ] && [ ! -f "$unit_dir/$unit.timer" ]; then
    echo "SKIP transcript upload: not a Dropbox transcript host"; exit 0
  fi
  mode=install
fi
if [ "$mode" = remove ]; then
  "$systemctl_cmd" --user disable --now "$unit.timer" >/dev/null 2>&1 || true
  rm -f "$unit_dir/$unit.timer" "$unit_dir/$unit.service" "$cfg_dir/transcript-upload" "$cfg_dir/zcode_export.py"
  "$systemctl_cmd" --user daemon-reload >/dev/null 2>&1 || true
  echo "OK transcript upload timer removed (Dropbox copies are left as they are)"; exit 0
fi
if [ "$mode" = check ]; then
  rc=0
  [ -x "$cfg_dir/transcript-upload" ] || { echo "ERROR $cfg_dir/transcript-upload not installed"; rc=1; }
  main_dir="$(mktemp -d)"
  if fetch_verified "$main_dir"; then
    for f in transcript-upload zcode_export.py; do
      same_text "$main_dir/$f" "$cfg_dir/$f" || { echo "ERROR installed $f is stale: differs from merged main"; rc=1; }
    done
  else
    echo "ERROR could not read merged main; installed copy freshness unverified"; rc=1
  fi
  rm -rf "$main_dir"
  [ -f "$unit_dir/$unit.timer" ] || { echo "ERROR $unit.timer not installed"; rc=1; }
  "$systemctl_cmd" --user is-enabled "$unit.timer" >/dev/null 2>&1 || { echo "ERROR $unit.timer not enabled"; rc=1; }
  ((rc)) || echo "OK transcript upload timer installed and matches merged main"
  exit "$rc"
fi
if [ "$mode" = install ]; then
  mkdir -p "$cfg_dir" "$unit_dir" || exit 1
  # A reinstall must not lose this host's pull (edge-dev3 is the only route for hetz).
  if [ -z "$with_pull" ] && [ -f "$unit_dir/$unit.service" ]; then
    with_pull="$(sed -n 's/.* --pull \([A-Za-z0-9._-]*\) --map none$/\1/p' "$unit_dir/$unit.service" | head -n 1)"
  fi
  cp "$self" "$cfg_dir/transcript-upload.tmp.$$" && chmod +x "$cfg_dir/transcript-upload.tmp.$$" \
    && mv -f "$cfg_dir/transcript-upload.tmp.$$" "$cfg_dir/transcript-upload" || exit 1
  cp "$exporter" "$cfg_dir/zcode_export.py.tmp.$$" && mv -f "$cfg_dir/zcode_export.py.tmp.$$" "$cfg_dir/zcode_export.py" || exit 1
  {
    printf '[Unit]\nDescription=Copy AI session transcripts to Dropbox (ai-devops)\n\n[Service]\nType=oneshot\n'
    printf 'ExecStart=-/usr/bin/env bash "%s/transcript-upload"\n' "$cfg_dir"
    [ -n "$with_pull" ] && printf 'ExecStart=-/usr/bin/env bash "%s/transcript-upload" --pull %s --map none\n' "$cfg_dir" "$with_pull"
  } > "$unit_dir/$unit.service"
  printf '[Unit]\nDescription=Daily AI transcript upload to Dropbox\n\n[Timer]\nOnCalendar=*-*-* 06:30:00\nRandomizedDelaySec=900\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' > "$unit_dir/$unit.timer"
  "$systemctl_cmd" --user daemon-reload || exit 1
  "$systemctl_cmd" --user enable --now "$unit.timer" || exit 1
  echo "OK transcript upload timer installed (daily 06:30 local${with_pull:+, also pulls $with_pull})"; exit 0
fi

# ---------- run ----------
if [ -z "${AI_TRANSCRIPT_UPLOAD_UPDATED:-}" ] && [ "$self" -ef "$cfg_dir/transcript-upload" ]; then
  update_self || self_update=" self_update=failed"
fi
root="$dropbox/ai/chat_transcripts"
[ -d "$root" ] || { echo "ai-transcript-upload: $root not found (Dropbox missing?)" >&2; exit 1; }
now="$(date +%s)"; scanned=0; copied=0; hot=0; errors=0

fsize() { stat -L -c %s -- "$1" 2>/dev/null; }
fmtime() { stat -L -c %Y -- "$1" 2>/dev/null; }

copy_one() { # SRCFILE DEST PARTIAL SRCSIZE
  local src="$1" dest="$2" part="$3" want="$4" try got
  mkdir -p -- "$(dirname -- "$part")" "$(dirname -- "$dest")" || return 1
  for try in 1 2; do
    cp -p -- "$src" "$part" 2>/dev/null || { rm -f -- "$part"; return 1; }
    got="$(fsize "$part")"
    if [ "$got" = "$want" ] && [ "$(fsize "$src")" = "$want" ]; then
      mv -f -- "$part" "$dest" && return 0
      rm -f -- "$part"; return 1
    fi
    rm -f -- "$part"; want="$(fsize "$src")"
  done
  return 2
}

upload_tree() { # SRCDIR DESTDIR PARTIALDIR
  local src="$1" dest="$2" part="$3" f rel s m ds dm rc
  [ -d "$src" ] || return 0
  src="$(readlink -f -- "$src")"
  while IFS= read -r -d '' f; do
    rel="${f#"$src"/}"; scanned=$((scanned + 1))
    s="$(fsize "$f")"; m="$(fmtime "$f")"
    [ -n "$s" ] && [ -n "$m" ] || { errors=$((errors + 1)); continue; }
    if (( now - m < hot_min * 60 )); then hot=$((hot + 1)); continue; fi
    if [ -e "$dest/$rel" ]; then
      ds="$(fsize "$dest/$rel")"; dm="$(fmtime "$dest/$rel")"
      [ "$ds" = "$s" ] && (( m <= ${dm:-0} )) && continue
    fi
    copy_one "$f" "$dest/$rel" "$part/$rel" "$s"; rc=$?
    case "$rc" in 0) copied=$((copied + 1)) ;; 2) ;; *) errors=$((errors + 1)) ;; esac
  done < <(find -L "$src" -type f -print0 2>/dev/null)
}

write_log() { # HOSTFOLDER
  local line dir="$root/$1"
  line="$(TZ=America/New_York date '+%Y-%m-%d %H:%M:%S %Z') host=$1 scanned=$scanned copied=$copied skipped_hot=$hot errors=$errors$self_update"
  mkdir -p "$state_dir" "$dir" && printf '%s\n' "$line" >> "$state_dir/transcript-upload.log"
  printf '%s\n' "$line" > "$dir/.upload-last.txt.tmp.$$" && mv -f "$dir/.upload-last.txt.tmp.$$" "$dir/.upload-last.txt"
  printf '%s\n' "$line"
}

run_maps() { # HOSTFOLDER MAP...
  local folder="$1" m; shift
  for m in "$@"; do
    [ "$m" = none ] && continue
    upload_tree "${m%%=*}" "$root/$folder/${m#*=}" "$root/$folder/.partial/${m#*=}"
  done
}

status=0
if ((${#maps[@]} == 0)); then
  if [ "$host" = hetz ]; then
    maps=(/root/.claude/projects=root/claude/projects /root/.codex/sessions=root/codex/sessions
          /home/ai/.claude/projects=ai/claude/projects /home/ai/.codex/sessions=ai/codex/sessions)
  else
    maps=("$HOME/.claude/projects=claude/projects" "$HOME/.codex/sessions=codex/sessions"
          "$HOME/.codex/archived_sessions=codex/archived_sessions")
    # ZCode keeps sessions in sqlite: export them to session files, then copy those like any other.
    zdb="$HOME/.zcode/cli/db/db.sqlite"
    if [ -f "$zdb" ]; then
      python3 "$exporter" "$zdb" "$state_dir/zcode-export" >/dev/null 2>&1 || errors=$((errors + 1))
    fi
    maps+=("$state_dir/zcode-export=zcode/sessions")
  fi
fi
if ! { ((${#maps[@]} == 1)) && [ "${maps[0]}" = none ]; }; then
  run_maps "$host" "${maps[@]}"; write_log "$host"; ((errors)) && status=1
fi

if [ -n "$pull" ]; then
  scanned=0; copied=0; hot=0; errors=0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/ai-devops/transcript-pull/$pull"
  ssh_cmd="${AI_TRANSCRIPT_PULL_SSH:-ssh -i $HOME/.ssh/916-alien -o BatchMode=yes}"
  user="${AI_TRANSCRIPT_PULL_USER:-root}"
  for m in /root/.claude/projects=root/claude/projects /root/.codex/sessions=root/codex/sessions \
           /home/ai/.claude/projects=ai/claude/projects /home/ai/.codex/sessions=ai/codex/sessions; do
    rsrc="${m%%=*}"; rel="${m#*=}"; mkdir -p "$cache/$rel"
    if [ -n "${AI_TRANSCRIPT_PULL_LOCAL_ROOT:-}" ]; then
      [ -d "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rsrc" ] || continue
      rsync -a -- "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rsrc/" "$cache/$rel/" || errors=$((errors + 1))
    else
      rsync -a -e "$ssh_cmd" -- "$user@$pull:$rsrc/" "$cache/$rel/" 2>/dev/null || errors=$((errors + 1))
    fi
    upload_tree "$cache/$rel" "$root/$pull/$rel" "$root/$pull/.partial/$rel"
  done
  # ZCode keeps sessions in sqlite: copy the database, export it here, upload the export.
  for m in root=/root ai=/home/ai; do
    who="${m%%=*}"; rdb="${m#*=}/.zcode/cli/db"; zc="$cache/$who/zcode-db"; rc=0
    if [ -n "${AI_TRANSCRIPT_PULL_LOCAL_ROOT:-}" ]; then
      [ -f "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rdb/db.sqlite" ] || continue
      mkdir -p "$zc"; rsync -a --include='db.sqlite*' --exclude='*' -- "$AI_TRANSCRIPT_PULL_LOCAL_ROOT$rdb/" "$zc/" || rc=1
    else
      # shellcheck disable=SC2086 # ssh_cmd is a command line, as rsync -e reads it.
      $ssh_cmd "$user@$pull" test -f "$rdb/db.sqlite" 2>/dev/null; probe=$?
      [ "$probe" = 1 ] && continue
      [ "$probe" = 0 ] || { errors=$((errors + 1)); continue; }
      mkdir -p "$zc"; rsync -a --include='db.sqlite*' --exclude='*' -e "$ssh_cmd" -- "$user@$pull:$rdb/" "$zc/" 2>/dev/null || rc=1
    fi
    if [ "$rc" != 0 ] || ! python3 "$exporter" "$zc/db.sqlite" "$cache/$who/zcode-export" >/dev/null 2>&1; then errors=$((errors + 1)); fi
    upload_tree "$cache/$who/zcode-export" "$root/$pull/$who/zcode/sessions" "$root/$pull/.partial/$who/zcode/sessions"
  done
  write_log "$pull"; ((errors)) && status=1
fi
exit "$status"
