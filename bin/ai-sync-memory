#!/usr/bin/env bash
#
# Sync Claude Code auto-memory between this machine and the ai-devops repo.
#
# Memory lives per-project on each machine at:
#     $CLAUDE_HOME/projects/<slug>/memory/
# where <slug> encodes the working-copy PATH (e.g. C--repos-dflow). That slug
# DIFFERS per machine (C: on one box, D: on another), so the same logical
# project would otherwise never unify. We canonicalize <slug> to a project key:
#     C--repos-dflow, D--repos-dflow  ->  dflow
# Exceptions can be pinned in  memory/project-map.tsv  (one "slug<TAB>project"
# per line, '#' comments allowed).
#
# In the repo, memory is stored at:  memory/<project>/
#
#   ai-sync-memory push [--dry-run]   # machine memory  -> repo   (commit/push is a separate step)
#   ai-sync-memory pull [--dry-run]   # repo memory     -> machine (only for projects that already exist locally)
#
# Memory is SECRET-FREE by policy (facts, not credentials), so it is git-tracked
# directly. Never let a secret into a memory file.
set -euo pipefail

DIRECTION="${1:-}"
DRY_RUN="${2:-}"

# WINDOWS HOME-DRIVE TRAP — must match bin/ai-install-skills exactly.
# On some Windows boxes Git Bash's $HOME resolves to a roaming/network drive
# (Z:), while Claude Code reads the Windows profile (%USERPROFILE%). Basing the
# memory path on $HOME there points this script at a directory Claude never
# uses: `push` finds nothing and reports "0 project memory folder(s)" with exit
# 0, and `pull` prints "no local project dir on this machine yet" for every
# project — output the skill documents as *expected*. The sync appears to
# succeed while memory never moves in either direction. ai-install-skills was
# already fixed for this; this script was not, so skills and memory resolved to
# DIFFERENT homes on exactly the machines that need them most.
if [[ -n "${USERPROFILE:-}" ]]; then
  if command -v cygpath >/dev/null 2>&1; then
    BASE_HOME="$(cygpath -u "$USERPROFILE")"
  else
    BASE_HOME="/$(printf '%s' "$USERPROFILE" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#\L\1#')"
  fi
else
  BASE_HOME="$HOME"
fi
CLAUDE_HOME="${CLAUDE_HOME:-$BASE_HOME/.claude}"
TOOL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HUB_ROOT="${AI_MEMORY_HUB_ROOT:-$TOOL_ROOT}"
MEM_REPO="$HUB_ROOT/memory"
MAP_FILE="$TOOL_ROOT/memory/project-map.tsv"

run() { if [[ "$DRY_RUN" == "--dry-run" ]]; then echo "[dry-run] $*"; else "$@"; fi }

# The public ai-devops repository used to double as the memory hub. That is no
# longer permitted: memory is private operational state, and a stale scheduled
# wrapper on an unreachable machine must not be able to publish it. Keep this
# guard in the child command because old wrappers fetch the current repository
# before invoking it, so the protection reaches those machines without first
# replacing their installed launcher.
public_ai_devops_hub() {
  local origin
  origin="$(git -C "$HUB_ROOT" config --get remote.origin.url 2>/dev/null || true)"
  [[ "$origin" =~ github\.com[:/]u2giants/ai-devops(\.git)?$ ]]
}

# MEMORY.md is a recall index written independently by every machine. During
# migration, a pull must preserve local-only entries while accepting the hub's
# entries. Start from the hub index, then append any local link lines it lacks.
# This compatibility merge is intentionally conservative and can be removed
# after every scheduled writer is running the private-hub protocol.
merge_memory_index() {
  local local_index="$1" hub_index="$2" output="$3" tmp additions
  [[ -f "$local_index" ]] || return 0
  if [[ ! -f "$hub_index" ]]; then
    cp -a "$local_index" "$output" || return 1
    return 0
  fi
  tmp="$output.merge.$$"
  additions="$output.additions.$$"
  if ! cp -a "$hub_index" "$tmp"; then
    rm -f "$tmp" "$additions"
    return 1
  fi
  # Load the hub entries once, then test every local entry against that in-memory
  # set. The former grep-per-line loop became quadratic on a duplicate-storm
  # index (a 20 MB index required hours). Canonicalize CRLF on both sides for the
  # comparison while preserving the hub file byte-for-byte.
  if ! awk '
    FILENAME == ARGV[1] {
      value = $0
      sub(/\r$/, "", value)
      if (value ~ /^- \[.*\]\(.*\).*/) seen[value] = 1
      next
    }
    {
      value = $0
      sub(/\r$/, "", value)
    }
    value ~ /^- \[.*\]\(.*\).*/ && !(value in seen) {
      print value
      seen[value] = 1
    }
  ' "$tmp" "$local_index" > "$additions"; then
    rm -f "$tmp" "$additions"
    return 1
  fi
  if [[ -s "$additions" ]]; then
    if ! { printf '\n## Local entries preserved during migration\n\n' >> "$tmp" &&
      cat "$additions" >> "$tmp"; }; then
      rm -f "$tmp" "$additions"
      return 1
    fi
  fi
  rm -f "$additions"
  if ! mv -f "$tmp" "$output"; then
    rm -f "$tmp"
    return 1
  fi
}

copy_fact_union() {
  local source="$1" destination="$2" label="$3" file target base extension safe candidate suffix
  safe="$(printf '%s' "$label" | sed 's/[^A-Za-z0-9._-]/-/g')"
  for file in "$source"/* "$source"/.[!.]*; do
    [[ -f "$file" ]] || continue
    base="$(basename "$file")"
    [[ "$base" == "MEMORY.md" || "$base" == "$FORGET_NAME" ||
       "$base" == MEMORY.md.merge.* || "$base" == MEMORY.md.additions.* ||
       "$base" == MEMORY.md.tombstone.* || "$base" == "$FORGET_NAME.tmp" ]] && continue
    target="$destination/$base"
    if [[ ! -e "$target" ]]; then
      run cp -a "$file" "$target"
    elif ! cmp -s "$file" "$target"; then
      extension="${base##*.}"
      if [[ "$extension" == "$base" ]]; then extension=""; else extension=".$extension"; fi
      base="${base%$extension}"
      candidate="$destination/$base--$safe$extension"
      suffix=2
      while [[ -e "$candidate" ]] && ! cmp -s "$file" "$candidate"; do
        candidate="$destination/$base--$safe-$suffix$extension"
        suffix=$((suffix+1))
      done
      [[ -e "$candidate" ]] || run cp -a "$file" "$candidate"
    fi
  done
}

ensure_index_coverage() {
  local directory="$1" label="$2" index file base added=0
  index="$directory/MEMORY.md"
  if [[ ! -f "$index" ]]; then
    run bash -c 'printf "# Memory index - %s\n\n" "$1" > "$2"' _ "$label" "$index"
  fi
  for file in "$directory"/*.md; do
    [[ -f "$file" ]] || continue
    base="$(basename "$file")"
    [[ "$base" == "MEMORY.md" ]] && continue
    if ! grep -Fq "($base)" "$index"; then
      if [[ "$DRY_RUN" == "--dry-run" ]]; then
        echo "[dry-run] index $label/$base"
      else
        if [[ "$added" -eq 0 ]]; then printf '\n## Recovered union entries\n\n' >> "$index"; fi
        printf -- '- [%s](%s) - Portable fact preserved by lossless sync.\n' "${base%.md}" "$base" >> "$index"
      fi
      added=$((added+1))
    fi
  done
}

usage() {
  echo "usage: ai-sync-memory {push|pull} [--dry-run]" >&2
  echo "       ai-sync-memory forget <project> <file.md> \"<reason>\"" >&2
  exit 2
}

# Load explicit path aliases once. canonical() is used for every local memory
# directory; rereading project-map.tsv with awk on each call made even the
# corrected one-pass project lookup unnecessarily expensive on Windows.
declare -A explicit_project_map=()
if [[ -f "$MAP_FILE" ]]; then
  while IFS=$'\t' read -r mapped_slug mapped_project _ || [[ -n "${mapped_slug:-}" ]]; do
    mapped_project="${mapped_project%$'\r'}"
    [[ -n "$mapped_slug" && "$mapped_slug" != \#* && -n "$mapped_project" ]] || continue
    # Preserve the former awk contract: the first declaration wins.
    [[ -n "${explicit_project_map[$mapped_slug]+present}" ]] ||
      explicit_project_map["$mapped_slug"]="$mapped_project"
  done < "$MAP_FILE"
fi

# Canonical project key for a per-machine slug.
canonical() {
  local slug="$1" mapped
  mapped="${explicit_project_map[$slug]:-}"
  if [[ -n "$mapped" ]]; then echo "$mapped"; return; fi
  # Linux checkouts live under /worksp, whose slug is "-worksp-<name>". Without
  # this the Windows box stores "monitor" and hetz stores "-worksp-monitor" —
  # two keys for one project, neither machine ever seeing the other's memory.
  # (That is exactly how 87 files ended up stranded before 2026-07-26.)
  if [[ "$slug" == -worksp-* ]]; then echo "${slug#-worksp-}"; return; fi
  # default heuristic: drop everything up to and including the last "repos-"
  if [[ "$slug" == *repos-* ]]; then echo "${slug##*repos-}"; else echo "$slug"; fi
}

# --- Tombstones ------------------------------------------------------------
# Sync is copy-over, not mirror: `cp` never deletes. So deleting a memory file
# that turned out to be WRONG did not propagate — the next pull restored it from
# the hub, and any machine still holding it re-pushed it. A wrong memory was
# effectively immortal, which directly defeats the standing instruction to
# delete memories that turn out to be wrong.
#
# A tombstone records the deletion instead of relying on absence (absence is
# indistinguishable from "this machine hasn't synced yet"). Each project may
# carry a `.forgotten` file:
#     <filename><TAB><YYYY-MM-DD><TAB><reason>
# push: never re-adds a tombstoned file, and unions the machine's tombstones
#       with the hub's so a deletion recorded anywhere reaches the hub.
# pull: deletes tombstoned files from the machine, so the removal propagates.
FORGET_NAME=".forgotten"

# Names listed in a project's tombstone file (comments/blank lines ignored).
tombstoned_names() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  awk -F'\t' '!/^#/ && NF && $1 != "" {print $1}' "$f"
}

# Delete tombstoned files from a directory.
apply_tombstones() {
  local dir="$1" forget="$2" label="$3" name index tmp
  [[ -f "$forget" ]] || return 0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if [[ -e "$dir/$name" ]]; then
      run rm -f "$dir/$name"
      echo "  forget  $label/$name  (tombstoned)"
    fi
    index="$dir/MEMORY.md"
    if [[ -f "$index" && "$DRY_RUN" != "--dry-run" ]]; then
      tmp="$index.tombstone.$$"
      awk -v needle="($name)" 'index($0, needle) == 0' "$index" > "$tmp"
      mv -f "$tmp" "$index"
    fi
  done < <(tombstoned_names "$forget")
}

case "$DIRECTION" in
  push)
    if public_ai_devops_hub; then
      echo "[BLOCKED] Refusing to copy machine memory into the public u2giants/ai-devops repository." >&2
      echo "[BLOCKED] Configure the governed private memory hub before enabling uploads." >&2
      exit 1
    fi
    run mkdir -p "$MEM_REPO"
    n=0
    for md in "$CLAUDE_HOME"/projects/*/memory; do
      [[ -d "$md" ]] || continue
      slug="$(basename "$(dirname "$md")")"
      proj="$(canonical "$slug")"
      dest="$MEM_REPO/$proj"
      run mkdir -p "$dest"
      hub_index=""
      if [[ "$DRY_RUN" != "--dry-run" && -f "$dest/MEMORY.md" ]]; then
        hub_index="$(mktemp)"
        cp -a "$dest/MEMORY.md" "$hub_index"
      fi
      # Union the two tombstone lists BEFORE copying, so neither side loses a
      # deletion: the machine may have forgotten something the hub hasn't, and
      # a stale machine must not overwrite the hub's newer list.
      if [[ -f "$md/$FORGET_NAME" || -f "$dest/$FORGET_NAME" ]] && [[ "$DRY_RUN" != "--dry-run" ]]; then
        # `cat` exits non-zero when only one side exists, and `set -o pipefail`
        # would abort the pipeline mid-way and strand a .tmp file — so tolerate
        # the missing file explicitly rather than chaining on success.
        { cat "$dest/$FORGET_NAME" 2>/dev/null; cat "$md/$FORGET_NAME" 2>/dev/null; } \
          | awk 'NF && !seen[$0]++' > "$dest/$FORGET_NAME.tmp" || true
        mv -f "$dest/$FORGET_NAME.tmp" "$dest/$FORGET_NAME"
      fi
      # MEMORY.md is union-merged below. An older machine can add entries but
      # cannot shrink the hub index; only an explicit tombstone removes one.
      copy_fact_union "$md" "$dest" "$(hostname)"
      if [[ -n "$hub_index" ]]; then
        if ! merge_memory_index "$hub_index" "$md/MEMORY.md" "$dest/MEMORY.md"; then
          rm -f "$hub_index"
          echo "[FAIL] Could not merge the memory/$proj index into the hub." >&2
          exit 1
        fi
        rm -f "$hub_index"
      fi
      # Re-apply after the copy: the machine may still hold a file the hub has
      # tombstoned, and cp would have silently resurrected it in the hub.
      apply_tombstones "$dest" "$dest/$FORGET_NAME" "memory/$proj"
      ensure_index_coverage "$dest" "$proj"
      # A file in the hub but not on this machine is EITHER a deletion nobody
      # recorded, OR memory from another machine this one has never pulled.
      # Those are indistinguishable, so never delete — surface it and let a
      # human decide, via `ai-sync-memory forget`.
      while IFS= read -r rf; do
        base="$(basename "$rf")"
        [[ "$base" == "$FORGET_NAME" || "$base" == MEMORY.md.merge.* ||
           "$base" == MEMORY.md.additions.* || "$base" == MEMORY.md.tombstone.* ||
           "$base" == "$FORGET_NAME.tmp" ]] && continue
        [[ -e "$md/$base" ]] || echo "  note    memory/$proj/$base is in the hub but not on this machine (deleted here, or never pulled) — 'ai-sync-memory forget $proj $base \"why\"' to propagate a deletion"
      done < <(find "$dest" -maxdepth 1 -type f 2>/dev/null)
      echo "  push  $slug  ->  memory/$proj"
      n=$((n+1))
    done
    echo "$n project memory folder(s) copied into the repo. Review, then commit+push ai-devops."
    # Finding nothing is almost never legitimate: any machine running this has
    # used Claude Code at least once. Silence here previously read as success.
    if [[ "$n" -eq 0 ]]; then
      echo "[FAIL] No memory found under $CLAUDE_HOME/projects/." >&2
      echo "[FAIL] Nothing was captured — do NOT report this sync as successful." >&2
      echo "[FAIL] Check that this is the home Claude Code actually uses (Windows: %USERPROFILE%, not a Z:/roaming drive)." >&2
      exit 1
    fi
    ;;
  pull)
    [[ -d "$MEM_REPO" ]] || { echo "No memory/ tree in repo yet — nothing to pull."; exit 0; }
    # Build the machine-side project map once. The former nested scan called
    # canonical() for every hub-project/local-project pair. A machine carrying
    # 737 historical reviewer sandboxes therefore performed more than 543,000
    # path classifications before copying a byte. Keep every matching memory
    # directory (multiple checkout paths may intentionally map to one project),
    # but make lookup linear in the number of hub and local projects.
    declare -A local_memory_paths=()
    memory_path_separator=$'\034'
    local_project_memory_count=0
    for md in "$CLAUDE_HOME"/projects/*/memory; do
      memory_parent="${md%/memory}"
      [[ -d "$memory_parent" ]] || continue
      local_project_memory_count=$((local_project_memory_count+1))
      slug="${memory_parent##*/}"
      project_key="$(canonical "$slug")"
      local_memory_paths["$project_key"]+="$md$memory_path_separator"
    done
    pulled=0
    skipped=0
    for pd in "$MEM_REPO"/*/; do
      [[ -d "$pd" ]] || continue
      project_path="${pd%/}"
      proj="${project_path##*/}"
      matched=0
      project_memory_paths="${local_memory_paths[$proj]:-}"
      if [[ -n "$project_memory_paths" ]]; then
        while IFS= read -r -d "$memory_path_separator" md; do
          [[ -n "$md" ]] || continue
          memory_parent="${md%/memory}"
          slug="${memory_parent##*/}"
          run mkdir -p "$md"
          local_index=""
          if [[ "$DRY_RUN" != "--dry-run" && -f "$md/MEMORY.md" ]]; then
            local_index="$(mktemp)"
            cp -a "$md/MEMORY.md" "$local_index"
          fi
          if [[ -f "$pd/$FORGET_NAME" || -f "$md/$FORGET_NAME" ]] && [[ "$DRY_RUN" != "--dry-run" ]]; then
            { cat "$md/$FORGET_NAME" 2>/dev/null; cat "$pd/$FORGET_NAME" 2>/dev/null; } \
              | awk 'NF && !seen[$0]++' > "$md/$FORGET_NAME.tmp" || true
            mv -f "$md/$FORGET_NAME.tmp" "$md/$FORGET_NAME"
          fi
          copy_fact_union "$pd" "$md" "hub"
          if [[ -n "$local_index" ]]; then
            if ! merge_memory_index "$local_index" "$pd/MEMORY.md" "$md/MEMORY.md"; then
              rm -f "$local_index"
              echo "[FAIL] Could not merge the memory/$proj index into $slug." >&2
              exit 1
            fi
            rm -f "$local_index"
          fi
          # This is what makes a deletion actually propagate: the hub's
          # tombstones remove the file from this machine too.
          apply_tombstones "$md" "$md/$FORGET_NAME" "$slug"
          ensure_index_coverage "$md" "$slug"
          echo "  pull  memory/$proj  ->  $slug"
          matched=1
        done < <(printf '%s' "$project_memory_paths")
      fi
      [[ $matched -eq 0 ]] && { echo "  skip  memory/$proj  (no local project dir on this machine yet)"; skipped=$((skipped+1)); }
      [[ $matched -eq 1 ]] && pulled=$((pulled+1))
    done
    # A skip is normal for a project this machine doesn't have. EVERY project
    # skipping is normally a wrong-home signal. There is one deliberate
    # exception: restore-from-zero installs the managed skills before Claude has
    # created its first projects/*/memory directory. In that recognizable fresh
    # home, cloning and validating the private hub is the complete safe seed;
    # there is no machine memory to receive or upload yet.
    if [[ "${pulled:-0}" -eq 0 && "${skipped:-0}" -gt 0 ]]; then
      if [[ -d "$CLAUDE_HOME/skills" && "$local_project_memory_count" -eq 0 ]]; then
        echo "[INFO] Fresh Claude home has no project memory yet; private hub is ready for the first project."
        exit 0
      fi
      echo "[FAIL] Every project was skipped — no local project directory matched." >&2
      echo "[FAIL] $CLAUDE_HOME is almost certainly not the home Claude Code uses." >&2
      echo "[FAIL] Memory did NOT sync. Do not report this sync as successful." >&2
      exit 1
    fi
    ;;
  forget)
    # ai-sync-memory forget <project> <file> "<reason>"
    # Records a deletion so it propagates, instead of a bare `rm` that the next
    # sync silently undoes.
    proj="${2:-}"; file="${3:-}"; reason="${4:-}"
    [[ -n "$proj" && -n "$file" ]] || {
      echo "usage: ai-sync-memory forget <project> <file.md> \"<reason>\"" >&2; exit 2; }
    dest="$MEM_REPO/$proj"
    [[ -d "$dest" ]] || { echo "No such project in the hub: memory/$proj" >&2; exit 1; }
    [[ -n "$reason" ]] || {
      echo "Refusing to forget without a reason — a future session needs to know WHY" >&2
      echo "this memory was wrong, or it gets re-learned and re-added." >&2; exit 2; }
    # Date comes from the OS; memories record absolute dates, never "today".
    printf '%s\t%s\t%s\n' "$file" "$(date +%Y-%m-%d)" "$reason" >> "$dest/$FORGET_NAME"
    [[ -e "$dest/$file" ]] && rm -f "$dest/$file" && echo "  removed memory/$proj/$file from the hub"
    echo "  tombstoned $file in memory/$proj — every machine drops it on its next pull."
    echo "  Remember to remove its line from memory/$proj/MEMORY.md, then commit+push ai-devops."
    ;;
  *) usage ;;
esac
