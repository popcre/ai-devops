#!/usr/bin/env bash
# ai-reviewer-issue - record a detailed reviewer failure and its evidence.
#
# WHY THIS EXISTS
# The performance scoreboard records comparable numbers, but those numbers are
# not enough to diagnose an unusual reviewer failure. This command captures the
# surrounding repository, machine, reviewer state, complete matching review
# reports, provider logs, scoreboard outcome, and any notes the session supplies.
# Reports are local and git-ignored because reviewer state may describe private
# code or provider sessions.
set -euo pipefail

VERSION="1.2.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ISSUE_DIR="${AI_REVIEWER_ISSUE_DIR:-$TOOLKIT_ROOT/.ai/reviewer-issues}"
STATE_BASE="${AI_REVIEWER_STATE_BASE:-$HOME/.local/state/ai-devops}"

die(){ printf 'ai-reviewer-issue: error: %s\n' "$*" >&2; exit 1; }
note(){ printf 'ai-reviewer-issue: %s\n' "$*"; }

usage(){
  cat <<'EOF'
Usage:
  ai-reviewer-issue record --provider NAME --summary "title" [--details TEXT | --details-file PATH]
                           [--command TEXT] [--repo PATH] [--error-file PATH]
                           [--run-id ID] [--session-id ID] [--caller NAME]
  ai-reviewer-issue list
  ai-reviewer-issue show <issue-id>
  ai-reviewer-issue path

The record command captures complete matching review reports, recent provider
logs, reviewer metadata, scoreboard outcome, repository state, and machine facts.
Details and error files are copied in full after common credentials are redacted.
Reports remain local under the ai-devops checkout and are never committed.
EOF
}

safe_provider(){
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

canonical_dir(){
  [ -d "$1" ] || return 1
  (cd "$1" && pwd -P)
}

repo_root(){
  git -C "$1" rev-parse --show-toplevel 2>/dev/null || canonical_dir "$1"
}

latest_json(){ # latest_json DIRECTORY
  local dir="$1" latest="" f
  [ -d "$dir" ] || return 0
  while IFS= read -r -d '' f; do
    if [ -z "$latest" ] || [ "$f" -nt "$latest" ]; then latest="$f"; fi
  done < <(find "$dir" -type f -name '*.json' -print0 2>/dev/null)
  printf '%s' "$latest"
}

exact_json(){ # DIRECTORY RUN SESSION REPO HEAD CALLER
  local dir="$1" run="$2" session="$3" repo="$4" head="$5" caller="$6" f
  { [ -n "$run" ] || [ -n "$session" ]; } && [ -n "$caller" ] || return 0
  [ -d "$dir" ] || return 0
  while IFS= read -r -d '' f; do
    jq -e --arg run "$run" --arg session "$session" --arg repo "$repo" --arg head "$head" --arg caller "$caller" '
      ($run=="" or (.run_id // .job_id // .id // "")==$run) and
      ($session=="" or (.session_id // .session // .name // "")==$session) and
      ((.repo // .repository_root // "")==$repo) and (.head // "")==$head and
      (.caller // "")==$caller' "$f" >/dev/null 2>&1 && { printf '%s' "$f"; return 0; }
  done < <(find "$dir" -type f -name '*.json' -print0 2>/dev/null)
}

sanitize_json(){ # sanitize_json SOURCE DESTINATION
  jq 'walk(if type == "object" then
        with_entries(select((.key | ascii_downcase) as $k |
          ($k == "prompt" or $k == "prompt_text" or $k == "content" or
           $k == "body" or $k == "api_key" or $k == "credential" or
           $k == "secret" or $k == "authorization" or
           $k == "access_token" or $k == "refresh_token") | not))
      else . end)' "$1" > "$2"
}

redact_text(){
  sed -E \
    -e 's/((api[_ -]?key|token|secret|password|authorization|credential)[=:][[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig' \
    -e 's/(Bearer[[:space:]]+)[A-Za-z0-9._~+\/-]+/\1[REDACTED]/Ig'
}

write_artifact_inventory(){ # write_artifact_inventory REPO DESTINATION
  local repo="$1" dest="$2" f count=0
  : > "$dest"
  [ -d "$repo/.ai/reviews" ] || return 0
  while IFS= read -r -d '' f; do
    printf '%s\t%s bytes\n' "${f#"$repo/"}" "$(wc -c < "$f" | tr -d ' ')" >> "$dest"
    count=$((count + 1))
    if [ "$count" -ge 10 ]; then break; fi
  done < <(find "$repo/.ai/reviews" -maxdepth 1 -type f -print0 2>/dev/null)
}

capture_review_reports(){ # capture_review_reports REPO PROVIDER JOIN DEST INVENTORY
  local repo="$1" provider="$2" join="$3" dest="$4" inventory="$5" f saved count=0
  mkdir -p "$dest"
  [ -n "$join" ] || return 0
  [ -d "$repo/.ai/reviews" ] || return 0
  while IFS= read -r -d '' f; do
    count=$((count + 1)); saved="$(printf '%03d-%s' "$count" "$(basename "$f")")"
    redact_text < "$f" > "$dest/$saved"
    printf '%s\t%s\t%s bytes\n' "$f" "$saved" "$(wc -c < "$f" | tr -d ' ')" >> "$inventory"
  done < <(find "$repo/.ai/reviews" -maxdepth 1 -type f -iname "*${provider}*${join}*" -print0 2>/dev/null)
}

capture_provider_logs(){ # capture_provider_logs PROVIDER_DIR JOIN DEST INVENTORY
  local source="$1" join="$2" dest="$3" inventory="$4" f saved count=0
  mkdir -p "$dest"
  [ -n "$join" ] || return 0
  [ -d "$source" ] || return 0
  while IFS= read -r -d '' f; do
    count=$((count + 1)); saved="$(printf '%03d-%s' "$count" "$(basename "$f")")"
    redact_text < "$f" > "$dest/$saved"
    printf '%s\t%s\t%s bytes\n' "$f" "$saved" "$(wc -c < "$f" | tr -d ' ')" >> "$inventory"
  done < <(find "$source" -type f -path "*${join}*" -mtime -2 \( -name '*.log' -o -name '*.jsonl' -o -name '*.out' -o -name '*.err' \) -print0 2>/dev/null)
}

capture_scoreboard(){ # capture_scoreboard PROVIDER REPO HEAD RUN SESSION CALLER DESTINATION
  local provider="$1" repo="$2" head="$3" run="$4" session="$5" caller="$6" dest="$7" ledger="${AI_REVIEW_SCOREBOARD_FILE:-$STATE_BASE/review-scoreboard/reviews.jsonl}"
  { [ -n "$run" ] || [ -n "$session" ]; } && [ -n "$caller" ] || return 0
  [ -f "$ledger" ] || return 0
  jq -s --arg provider "$provider" --arg repo "$repo" --arg head "$head" --arg run "$run" --arg session "$session" --arg caller "$caller" \
    '[.[] | select(.provider==$provider and .repo==$repo and .head==$head and
      ($run=="" or (.run_id // "")==$run) and ($session=="" or (.session_id // "")==$session) and
      (.caller // "")==$caller)] | last // empty' "$ledger" > "$dest"
  [ -s "$dest" ] || rm -f "$dest"
}

record_issue(){
  local provider="" summary="" details="" details_file="" command_text="" repo="$(pwd)" error_file="" run_id="" session_id="" caller="" join="" root now stamp host id report_dir
  local metadata_source="" metadata_copy="" status_short="" branch="" head="" remote="" safe_summary="" safe_command=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --provider) provider="${2:-}"; shift 2 ;;
      --summary) summary="${2:-}"; shift 2 ;;
      --details) details="${2:-}"; shift 2 ;;
      --details-file) details_file="${2:-}"; shift 2 ;;
      --command) command_text="${2:-}"; shift 2 ;;
      --repo) repo="${2:-}"; shift 2 ;;
      --error-file) error_file="${2:-}"; shift 2 ;;
      --run-id) run_id="${2:-}"; shift 2 ;;
      --session-id) session_id="${2:-}"; shift 2 ;;
      --caller) caller="${2:-}"; shift 2 ;;
      *) die "unknown option '$1'." ;;
    esac
  done
  safe_provider "$provider" || die "provider must use only letters, numbers, dot, dash, or underscore."
  [ -n "$summary" ] || die "--summary is required."
  [ -z "$details" ] || [ -z "$details_file" ] || die "use --details or --details-file, not both."
  root="$(repo_root "$repo")" || die "repository directory not found: $repo"
  if [ -n "$error_file" ]; then [ -f "$error_file" ] || die "error file not found: $error_file"; fi
  if [ -n "$details_file" ] && [ "$details_file" != "-" ]; then [ -f "$details_file" ] || die "details file not found: $details_file"; fi
  safe_summary="$(printf '%s' "$summary" | redact_text)"
  safe_command="$(printf '%s' "$command_text" | redact_text)"

  now="$(date -u +%FT%TZ)"; stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  host="$(hostname 2>/dev/null || printf unknown)"
  id="$stamp-$host-$provider-$$"
  report_dir="$ISSUE_DIR/$id"
  mkdir -p "$report_dir" || die "cannot create report directory: $report_dir"
  chmod 0700 "$ISSUE_DIR" "$report_dir" 2>/dev/null || true

  if { [ -n "$run_id" ] || [ -n "$session_id" ]; } && [ -n "$caller" ]; then
    join="${run_id:-$session_id}"
  fi

  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
    head="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
    remote="$(git -C "$root" remote get-url origin 2>/dev/null || true)"
    status_short="$(git -C "$root" status --short --untracked-files=no 2>/dev/null || true)"
  fi
  metadata_source="$(exact_json "$STATE_BASE/$provider" "$run_id" "$session_id" "$root" "$head" "$caller" || true)"
  if [ -n "$metadata_source" ] && jq -e . "$metadata_source" >/dev/null 2>&1; then
    metadata_copy="$report_dir/reviewer-metadata.redacted.json"
    sanitize_json "$metadata_source" "$metadata_copy" || die "could not redact reviewer metadata."
    chmod 0600 "$metadata_copy" 2>/dev/null || true
  fi

  write_artifact_inventory "$root" "$report_dir/recent-review-artifacts.txt"
  : > "$report_dir/captured-review-reports.txt"
  : > "$report_dir/captured-provider-logs.txt"
  capture_review_reports "$root" "$provider" "$join" "$report_dir/review-reports" "$report_dir/captured-review-reports.txt"
  capture_provider_logs "$STATE_BASE/$provider" "$join" "$report_dir/provider-logs" "$report_dir/captured-provider-logs.txt"
  capture_scoreboard "$provider" "$root" "$head" "$run_id" "$session_id" "$caller" "$report_dir/latest-scoreboard-entry.json"
  if [ -z "$metadata_source" ]; then printf 'No exact reviewer metadata matched provider, repository, head, run/session, and caller.\n' > "$report_dir/missing-evidence.txt"; fi
  if [ -n "$details" ]; then
    printf '%s\n' "$details" | redact_text > "$report_dir/details.redacted.txt"
  elif [ -n "$details_file" ]; then
    if [ "$details_file" = "-" ]; then redact_text > "$report_dir/details.redacted.txt"
    else redact_text < "$details_file" > "$report_dir/details.redacted.txt"; fi
  fi
  if [ -n "$error_file" ]; then
    redact_text < "$error_file" > "$report_dir/error.redacted.txt"
    chmod 0600 "$report_dir/error.redacted.txt" 2>/dev/null || true
  fi

  jq -n \
    --arg id "$id" --arg created "$now" --arg provider "$provider" --arg summary "$safe_summary" \
    --arg toolkit "$TOOLKIT_ROOT" --arg report_dir "$report_dir" --arg repo "$root" \
    --arg remote "$remote" --arg branch "$branch" --arg head "$head" --arg status "$status_short" \
    --arg host "$host" --arg os "$(uname -a 2>/dev/null || printf unavailable)" \
    --arg shell "${SHELL:-unavailable}" --arg metadata_source "$metadata_source" \
    --arg metadata_copy "$metadata_copy" --arg error_source "$error_file" --arg command "$safe_command" \
    --arg details_file "$details_file" --arg details "$details" \
    --arg run_id "$run_id" --arg session_id "$session_id" --arg caller "$caller" \
    '{schema_version:3,id:$id,created_at:$created,provider:$provider,summary:$summary,reported_command:$command,
      join:{run_id:(if $run_id=="" then null else $run_id end),session_id:(if $session_id=="" then null else $session_id end),caller:(if $caller=="" then null else $caller end)},
      toolkit_root:$toolkit,report_directory:$report_dir,
      repository:{root:$repo,remote:$remote,branch:$branch,head:$head,working_tree_changes:$status},
      machine:{hostname:$host,os:$os,shell:$shell},
      evidence:{latest_metadata_source:$metadata_source,redacted_metadata_copy:$metadata_copy,
        recent_review_artifacts:"recent-review-artifacts.txt",
        complete_matching_review_reports:"review-reports/",
        recent_provider_logs:"provider-logs/",
        latest_scoreboard_entry:"latest-scoreboard-entry.json",
        session_details:(if ($details_file=="" and $details=="") then null else "details.redacted.txt" end),
        complete_error_log:(if $error_source=="" then null else "error.redacted.txt" end)}}' \
    > "$report_dir/issue.json"
  chmod -R go-rwx "$report_dir" 2>/dev/null || true

  note "recorded $id"
  note "saved to $report_dir"
}

list_issues(){
  local f found=0
  [ -d "$ISSUE_DIR" ] || { note "no recorded issues"; return 0; }
  for f in "$ISSUE_DIR"/*/issue.json; do
    [ -f "$f" ] || continue; found=1
    jq -r '[.id,.created_at,.provider,.summary]|@tsv' "$f"
  done
  [ "$found" -eq 1 ] || note "no recorded issues"
}

show_issue(){
  local id="$1" file
  safe_provider "$id" || die "invalid issue id."
  file="$ISSUE_DIR/$id/issue.json"
  [ -f "$file" ] || die "issue not found: $id"
  jq . "$file"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  record) record_issue "$@" ;;
  list) [ "$#" -eq 0 ] || die "list takes no arguments."; list_issues ;;
  show) [ "$#" -eq 1 ] || die "show requires one issue id."; show_issue "$1" ;;
  path) [ "$#" -eq 0 ] || die "path takes no arguments."; printf '%s\n' "$ISSUE_DIR" ;;
  --version) printf 'ai-reviewer-issue %s\n' "$VERSION" ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
