#!/usr/bin/env bash
# Fail if tracked public-repository paths or content cross the privacy boundary.
set -uo pipefail
# Usage: ai-public-boundary-check [root] [-- path...]
# With "-- path...", only those tracked paths are checked (a PR's changed
# files); without it, every tracked file is (u2giants/theoracle#345).
#
# A repository may declare intentional evidence publishes in an optional
# tools/public-boundary-path-allowlist.txt at its root (popcre/shared-db#5826):
# one entry per line ("#" comments and blanks ignored), matched against the
# lowercased tracked path. An entry ending in "/" is a directory prefix;
# any other entry is an exact path. A matching path skips ONLY the path
# classification rules (generated AI artifact, transcript, operational memory)
# -- exactly the .ai/reviewer-issues/ carve-out below, but repository-chosen.
# Secret-bearing file names and types and every content-level check
# (credentials, topology, project IDs) still apply to every tracked file.
root="${1:-.}"
[ "$#" -gt 0 ] && shift
root="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)" || { echo 'BOUNDARY FAIL: not a git repo' >&2; exit 1; }
scope=()
if [ "${1:-}" = '--' ]; then
  shift
  for path in "$@"; do scope+=(":(literal)$path"); done
  if [ "${#scope[@]}" -eq 0 ]; then
    echo 'PASS: public path, credential, and topology boundary (no paths to check)'
    exit 0
  fi
fi
failed=0
# Repository-declared intentional evidence publishes (see header comment).
path_exemptions=()
path_allowlist="$root/tools/public-boundary-path-allowlist.txt"
if [ -f "$path_allowlist" ]; then
  while IFS= read -r entry || [ -n "$entry" ]; do
    entry="${entry%$'\r'}"
    case "$entry" in ''|'#'*) continue ;; esac
    path_exemptions+=("$entry")
  done < "$path_allowlist"
fi
path_is_exempt() {
  local lowered="$1" entry
  for entry in ${path_exemptions[@]+"${path_exemptions[@]}"}; do
    case "$entry" in
      */) case "$lowered" in "${entry}"*) return 0 ;; esac ;;
      *)  [ "$lowered" = "$entry" ] && return 0 ;;
    esac
  done
  return 1
}
while IFS= read -r -d '' path; do
  lowered="${path,,}"
  # .ai/reviewer-issues/ is an intentional publish (PR #1626). Content-level
  # checks (credentials, topology, project IDs) below still apply to every
  # tracked file; the path rule only rejects non-publish .ai/ artifacts and
  # secret-bearing filenames (case-insensitive) under the publish path.
  # path_is_exempt extends that same carve-out to repository-declared paths.
  if ! path_is_exempt "$lowered"; then
  case "$lowered" in
    .ai/reviewer-issues/*) ;; # publish path: classified by the case below
    .ai/*)
      echo "BOUNDARY FAIL: generated AI artifact tracked at $path" >&2
      echo '  Intentional evidence publishes may be declared in tools/public-boundary-path-allowlist.txt.' >&2
      failed=1 ;;
    claude_chats/*|codex_chats/*|transcripts/claude_chats/*|transcripts/codex_chats/*)
      echo "BOUNDARY FAIL: tracked transcript path $path" >&2; failed=1 ;;
    memory/*.md|memory/*/*.md)
      [ "$path" = memory/README.md ] || { echo "BOUNDARY FAIL: operational memory tracked at $path" >&2; failed=1; } ;;
  esac
  fi
  case "$lowered" in
    .ai/reviewer-issues/*)
      case "$lowered" in
        *.env*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.kdbx|\
        */auth.json|*/credentials.json|*/id_rsa*|*/id_ed25519*|*/id_ecdsa*|*/id_dsa*|\
        *token*|*secret*|*private*|*passwd*|*password*)
          echo "BOUNDARY FAIL: secret-bearing file name tracked at $path" >&2; failed=1 ;;
        *.json|*.txt|*.md|*.log|*.csv|*.err|*.out) ;;
        *) echo "BOUNDARY FAIL: non-prose file tracked at $path" >&2; failed=1 ;;
      esac ;;
  esac
  # Always forbid secret-bearing file types, including under reviewer-issues.
  # Match basenames like .gitignore: .env, *.env, .env.*, *.pem, *.key —
  # never the documented examples.
  base="${path##*/}"
  case "$base" in
    .env.example|*.env.example) ;;
    .env|*.env|.env.*|*.pem|*.key)
      echo "BOUNDARY FAIL: secret-bearing file type tracked at $path" >&2; failed=1 ;;
  esac
done < <(git -C "$root" ls-files -z -- ${scope[@]+"${scope[@]}"})

pattern='(ops_[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]{20,}|sk-[A-Za-z0-9]{24,})'
cred_hits="$(git -C "$root" grep -alE "$pattern" -- ${scope[@]+"${scope[@]}"} ':!tests/fixtures/**' ':!tests/test-public-boundary.sh' ':!tests/test-build-private-memory-hub.ps1' ':!tests/test-ai-doc-safety.sh' ':!tests/test-ai-pr-wait.sh' 2>/dev/null || true)"
if [ -n "$cred_hits" ]; then
  echo 'BOUNDARY FAIL: credential-shaped tracked content found' >&2; failed=1
fi

# Private/RFC1918 and carrier-grade/Tailscale addresses identify Albert's
# topology even though they are not credentials. The documented network range
# itself is harmless. Complete RFC1918 standards also qualify only in proven
# direct stdlib policy calls, never as bare text or narrower host networks.
topology_ip_pattern='(100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})'
# Dependency versions and complete standard networks are not host topology.
# Remove only proven semantic spans; all other same-line hits remain protected.
tool_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
topology_matches="$(git -C "$root" grep -anE "$topology_ip_pattern" -- ${scope[@]+"${scope[@]}"} ':!tests/fixtures/**' ':!tests/test-public-boundary.sh' ':!tests/test-ai-doc-safety.sh' ':!tests/test-ai-pr-wait.sh' 2>/dev/null | grep -vE '100\.64\.0\.0/(10|255\.192\.0\.0)' || true)"
if [ -n "$topology_matches" ]; then
  # Parser failure cannot discard evidence: keep the original hits unless the
  # filter completed successfully. Python is already required by doc safety.
  for python_runner in python3 python; do
    command -v "$python_runner" >/dev/null 2>&1 || continue
    if filtered_topology="$(printf '%s\n' "$topology_matches" | "$python_runner" -I "$tool_dir/../tools/public-boundary-version-spans.py" "$root")"; then
      topology_matches="$filtered_topology"
    fi
    break
  done
fi
if [ -n "$topology_matches" ]; then
  echo 'BOUNDARY FAIL: protected private-network topology found' >&2; failed=1
fi

# A tailnet MagicDNS name (<host>.<tailnet>.ts.net) identifies the same
# topology as the address it resolves to. Bare "ts.net" prose stays allowed.
tailnet_host_pattern='([A-Za-z0-9-]+\.){2}ts\.net'
# The unanchored repetition backtracks quadratically on long lines (minified
# or binary blobs ran 10+ minutes, #2324), so a fixed-string pass picks the
# few candidate lines first and the regex only sees those.
tailnet_host_matches="$(git -C "$root" grep -anF '.ts.net' -- ${scope[@]+"${scope[@]}"} ':!tests/fixtures/**' ':!tests/test-public-boundary.sh' ':!tests/test-ai-doc-safety.sh' ':!tests/test-ai-pr-wait.sh' 2>/dev/null | grep -aE "$tailnet_host_pattern" || true)"
if [ -n "$tailnet_host_matches" ]; then
  echo 'BOUNDARY FAIL: protected tailnet hostname found' >&2; failed=1
fi

# A public endpoint address is also topology when it appears in a host/URL/IP
# assignment. Domain-based product endpoints remain allowed — only the URL
# authority (host) counts as an endpoint, never a version number in the path.
public_ip_context='(HostName|public IP|Tailscale IP|PROXY_URL=)[^[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3}|https?://(([0-9]{1,3}\.){3}[0-9]{1,3})([^0-9.]|$)'
public_ip_matches="$(git -C "$root" grep -anE "$public_ip_context" -- ${scope[@]+"${scope[@]}"} ':!tests/fixtures/**' ':!tests/test-public-boundary.sh' ':!tests/test-ai-doc-safety.sh' ':!tests/test-ai-pr-wait.sh' 2>/dev/null | grep -vF '127.0.0.1' || true)"
if [ -n "$public_ip_matches" ]; then
  echo 'BOUNDARY FAIL: protected endpoint address found' >&2; failed=1
fi

# Supabase project references are stable infrastructure identifiers. They carry
# no prefix to key on, unlike ghp_/sk-/AKIA, so shape is all there is: exactly
# 20 lowercase letters. That is deliberately blunt and it catches ordinary long
# English words too. Clearing a false positive is a reviewed allowlist entry in
# tools/public-boundary-allowlist.txt, never a widening of this pattern.
#
# The allowlist is applied per matched WORD, not per line, so an allowlisted
# word sharing a line with a real identifier still fails.
#
# The word extraction and allowlist lookup run in ONE awk pass, not a
# grep-per-line loop: per-line process substitution cost ~0.2s per hit line on
# Windows (popcre/shared-db#5826 saw 1,584 hit lines run 19+ minutes and blow
# ai-doc-safety's hard timeout). awk is POSIX-only here (no interval regex) so
# mawk on Ubuntu runs it unchanged. Semantics are byte-identical: strip the
# file:line: prefix, cut every maximal lowercase run into non-overlapping
# 20-letter chunks (grep -oE '[a-z]{20}' behavior), and fail the line on the
# first chunk the allowlist does not carry as an exact whole line.
allowlist="$root/tools/public-boundary-allowlist.txt"
project_matches="$(git -C "$root" grep -anE '(^|[^a-z])[a-z]{20}([^a-z]|$)' -- ${scope[@]+"${scope[@]}"} ':!tests/fixtures/**' ':!tests/test-public-boundary.sh' ':!tests/test-ai-doc-safety.sh' ':!tests/test-ai-pr-wait.sh' ':!tools/public-boundary-allowlist.txt' 2>/dev/null | awk -v allow="$allowlist" '
  BEGIN {
    if (allow != "") {
      while ((getline aline < allow) > 0) {
        sub(/\r$/, "", aline)
        if (aline != "" && aline !~ /^#/) allowed[aline] = 1
      }
      close(allow)
    }
  }
  {
    hit = $0
    text = $0
    sub(/^[^:]*:[^:]*:/, "", text)
    n = split(text, runs, /[^a-z]+/)
    for (i = 1; i <= n; i++) {
      len = length(runs[i])
      for (off = 1; off + 19 <= len; off += 20) {
        word = substr(runs[i], off, 20)
        if (!(word in allowed)) { print hit; next }
      }
    }
  }
' || true)"
if [ -n "$project_matches" ]; then
  # Name the file and line. The old message named neither, which cost one
  # session twenty minutes of bisecting a documentation-only change.
  echo 'BOUNDARY FAIL: protected project-shaped identifier found' >&2
  printf '%s' "$project_matches" | sed 's/^/  /' >&2
  echo '  If that is an ordinary English word, add it to tools/public-boundary-allowlist.txt with a justification, or reword the prose. Do not widen the pattern.' >&2
  failed=1
fi
[ "$failed" -eq 0 ] || exit 1
echo 'PASS: public path, credential, and topology boundary'
