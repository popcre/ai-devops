#!/usr/bin/env bash
# ai-claude-statusline - Claude Code status line: context meter + turn counter.
#
# Answers two questions at a glance:
#   1. How full is the context?          (bar + %)
#   2. How long has this session run?    (turn count, warns past 150)
#
# WHY THE TURN COUNT IS THE NUMBER THAT MATTERS. Measured on 2026-08-27 across
# ten days of edge-dev transcripts: turns past #200 were 40% of activity but 66%
# of input tokens, because every turn re-reads the whole conversation and the
# conversation only grows. Caching makes each read ~10x cheaper; it does not make
# it free, and it does not shorten the conversation. See
# docs/context-engineering.md, "Skill index ratchet on 2026-08-27".
#
# autoCompactWindow protects the cost automatically. This protects the judgement
# call: at amber, hand off to a fresh session instead of pushing on.
#
# Wire it up with the "statusLine" key in ~/.claude/settings.json:
#   "statusLine": "ai-claude-statusline"
# Claude Code reads it at startup, so restart after changing it.
set -uo pipefail

IN=$(cat)

j() { printf '%s' "$IN" | jq -r "$1 // empty" 2>/dev/null; }

MODEL=$(j '.model.display_name')
DIR=$(j '.workspace.current_dir')
BRANCH=$(j '.workspace.git_worktree')
PCT=$(j '.context_window.used_percentage')
TP=$(j '.transcript_path')
COST=$(j '.cost.total_cost_usd')
WK=$(j '.rate_limits.seven_day.used_percentage')

# --- colours -------------------------------------------------------------
R=$'\033[0m'; DIM=$'\033[2m'; B=$'\033[1m'
GRN=$'\033[32m'; YEL=$'\033[33m'; RED=$'\033[31m'; CYA=$'\033[36m'

# --- turn counter --------------------------------------------------------
# One "turn" = one assistant response. Cost per turn grows with the
# conversation, so this is the number that predicts the bill.
TURNS=0
if [[ -n "$TP" && -f "$TP" ]]; then
  TURNS=$(grep -c '"type":"assistant"' "$TP" 2>/dev/null || echo 0)
fi

SOFT=150   # start thinking about a handoff
HARD=250   # you are now paying a large premium per turn

if   (( TURNS >= HARD )); then TC=$RED;  TMARK=" — hand off"
elif (( TURNS >= SOFT )); then TC=$YEL;  TMARK=" — wrap up soon"
else                           TC=$GRN;  TMARK=""
fi

# --- context bar ---------------------------------------------------------
PCT=${PCT:-0}; PCT=${PCT%.*}
WIDTH=16
FILLED=$(( PCT * WIDTH / 100 )); (( FILLED > WIDTH )) && FILLED=$WIDTH
(( FILLED < 0 )) && FILLED=0
EMPTY=$(( WIDTH - FILLED ))

if   (( PCT >= 80 )); then CC=$RED
elif (( PCT >= 55 )); then CC=$YEL
else                       CC=$GRN
fi

BAR=""
for ((i=0;i<FILLED;i++)); do BAR+="█"; done
for ((i=0;i<EMPTY;i++));  do BAR+="░"; done

# --- render --------------------------------------------------------------
LINE1="${B}${MODEL}${R} ${DIM}·${R} ${CYA}$(basename "${DIR:-?}")${R}"
[[ -n "$BRANCH" ]] && LINE1+=" ${DIM}·${R} ${BRANCH}"

LINE2="${CC}${BAR}${R} ${CC}${PCT}%${R} ${DIM}ctx${R}"
LINE2+="  ${DIM}·${R}  ${TC}${B}${TURNS}${R}${TC} turns${TMARK}${R}"
[[ -n "$COST" ]] && LINE2+="  ${DIM}·${R}  ${DIM}\$$(printf '%.2f' "$COST")${R}"
[[ -n "$WK"   ]] && LINE2+="  ${DIM}·${R}  ${DIM}wk $(printf '%.0f' "$WK")%${R}"

printf '%s\n%s' "$LINE1" "$LINE2"
