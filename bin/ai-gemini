#!/usr/bin/env bash
# ai-gemini - quarantined Gemini reviews in a disposable repository copy.
# Antigravity plan mode is guidance, not a read-only boundary. Accept a review
# only after byte identity, exact conversation/model, and durable report gates.
# Never add --dangerously-skip-permissions or mutate global Antigravity settings.
set -euo pipefail
VERSION=0.2.0
QUARANTINED=1
STATE_DIR="${AI_GEMINI_STATE_DIR:-$HOME/.local/state/ai-devops/gemini}"
CALLER="${AI_GEMINI_CALLER:-codex}"
MODEL="${AI_GEMINI_MODEL:-gemini-3.7-flash-high}"
TIMEOUT="${AI_GEMINI_PRINT_TIMEOUT:-10m}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX="${AI_REVIEW_SANDBOX_BIN:-$HERE/ai-review-sandbox}"
PACKET="${AI_REVIEW_PACKET_BIN:-$HERE/ai-review-packet}"
ACTIVE_META=''; ACTIVE_LOCKS=''; ACTIVE_TERMINAL=0; ACTIVE_CHILD=''
die(){ printf 'ai-gemini: error: %s\n' "$*" >&2; exit 1; }
guard_quarantine(){ [ "$QUARANTINED" -eq 0 ] || die 'Gemini reviews are quarantined until live safety qualification is complete'; }
need(){ command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
name_ok(){ case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
root(){ git rev-parse --show-toplevel 2>/dev/null || die 'run inside a Git repository'; }
rid(){ local r="$1" u; u="$(git -C "$r" config --get remote.origin.url 2>/dev/null || true)"; printf '%s\n%s' "$(cd "$r" && pwd -P)" "$u" | sha256sum | cut -c1-12; }
meta(){ printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
lock_path(){ printf '%s/locks/%s' "$STATE_DIR" "$1"; }
agy(){ local a; for a in "${AI_GEMINI_BIN:-}" "$(command -v agy 2>/dev/null || true)" "${LOCALAPPDATA:-}/agy/bin/agy.exe"; do [ -n "$a" ] && [ -x "$a" ] && { printf %s "$a"; return; }; done; die 'local_dependency_unavailable: the LOCAL agy runtime is not installed. This is not a Gemini provider fault. Run: ai-gemini doctor'; }
require_local_runtime(){ local a; a="$(agy)"; "$a" --version >/dev/null 2>&1 || die 'local_dependency_unavailable: the LOCAL agy runtime cannot start. This is not a Gemini provider fault. Run: ai-gemini doctor'; }
request(){ if [ "${1:-}" = --prompt ]; then printf %s "${2:-}"; elif [ "${1:-}" = --prompt-file ]; then [ -f "${2:-}" ] || die 'prompt file not found'; cat "$2"; elif [ ! -t 0 ]; then cat; else die 'provide --prompt, --prompt-file, or standard input'; fi; }
write(){ local f="$1" j="$2" t; mkdir -p "$(dirname "$f")"; t="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"; printf '%s\n' "$j" > "$t"; mv -f "$t" "$f"; }
update_state(){ local f="$1" status="$2" detail="${3:-}" j; j="$(jq -c --arg s "$status" --arg d "$detail" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.status=$s | .status_detail=$d | .updated_at=$t' "$f")" || die 'invalid session metadata'; write "$f" "$j"; }
inventory(){ local d="$1"; (cd "$d" && find . \( -type f -o -type l \) -print0 | LC_ALL=C sort -z | while IFS= read -r -d '' f; do if [ -L "$f" ]; then printf 'L\t%s\t%s\n' "$f" "$(readlink "$f")"; else sha256sum -- "$f"; fi; done) | sha256sum | cut -d' ' -f1; }
sentinel_state(){ local s out=''; IFS=';' read -r -a paths <<< "${AI_GEMINI_OUTSIDE_SENTINELS:-}"; for s in "${paths[@]}"; do [ -n "$s" ] || continue; [ -e "$s" ] || die "outside sentinel missing: $s"; out+="$(sha256sum -- "$s")"$'\n'; done; printf %s "$out" | sha256sum | cut -d' ' -f1; }
acquire(){ local p="$1" token="$2"; mkdir -p "$(dirname "$p")"; mkdir "$p" 2>/dev/null || die "review already active or recovery required: $token"; printf '%s\n' "$$" > "$p/owner"; ACTIVE_LOCKS="${ACTIVE_LOCKS:+$ACTIVE_LOCKS;}$p"; }
release_locks(){ local p; IFS=';' read -r -a locks <<< "$ACTIVE_LOCKS"; for p in "${locks[@]}"; do [ -n "$p" ] && rm -f "$p/owner" && rmdir "$p" 2>/dev/null || true; done; ACTIVE_LOCKS=''; }
on_exit(){ local rc=$?; if [ -n "$ACTIVE_META" ] && [ "$ACTIVE_TERMINAL" -eq 0 ] && [ -f "$ACTIVE_META" ]; then update_state "$ACTIVE_META" RECOVERY_REQUIRED 'interrupted or failed before all acceptance gates' || true; fi; release_locks; exit "$rc"; }
on_signal(){ local code="$1"; trap - HUP INT TERM; if [ -n "$ACTIVE_CHILD" ]; then kill -TERM "$ACTIVE_CHILD" 2>/dev/null || true; wait "$ACTIVE_CHILD" 2>/dev/null || true; ACTIVE_CHILD=''; fi; exit "$code"; }
trap on_exit EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
verify_turn(){ local f="$1" expected="${2:-}"; jq -e --arg c "$expected" '.status=="SUCCESS" and (.conversation_id|type=="string" and length>0) and ($c=="" or .conversation_id==$c) and (.response|type=="string" and test("^## Verdict[ \\t]*\\r?\\n[ \\t]*(APPROVE|REJECT|BLOCKED)[ \\t]*(\\r?\\n|$)"))' "$f" >/dev/null || die 'no usable Gemini verdict or exact conversation mismatch'; }
verify_model(){ local d="$1" protected="$2" c="$3" o="$4" a actual returned bd ad bp ap bs as rc; a="$(agy)"; bd="$(inventory "$d")"; bp="$(inventory "$protected")"; bs="$(sentinel_state)"; (cd "$d" && exec env MSYS_NO_PATHCONV=1 "$a" --conversation "$c" --sandbox --mode plan --output-format json --print-timeout 1m --print /model) > "$o" 2>"$o.stderr" & ACTIVE_CHILD=$!; rc=0; wait "$ACTIVE_CHILD" || rc=$?; ACTIVE_CHILD=''; [ "$rc" -eq 0 ] || die 'model verification request failed'; ad="$(inventory "$d")"; ap="$(inventory "$protected")"; as="$(sentinel_state)"; [ "$bd" = "$ad" ] || die 'Gemini changed the disposable review copy during model verification'; [ "$bp" = "$ap" ] || die 'Gemini changed the protected source checkout during model verification'; [ "$bs" = "$as" ] || die 'Gemini changed an outside sentinel during model verification'; returned="$(jq -r '.conversation_id // empty' "$o" 2>/dev/null || true)"; [ -z "$returned" ] || [ "$returned" = "$c" ] || die 'model verification returned the wrong conversation'; if ! jq -e --arg m "$MODEL" '.status=="SUCCESS" and .command.name=="model" and .command.data.id==$m and .command.data.is_default==false' "$o" >/dev/null; then actual="$(jq -r '.command.data.id // .response // "unavailable"' "$o" 2>/dev/null | head -c 200)"; die "model verification returned '$actual'; expected $MODEL"; fi; }
call(){ local d="$1" protected="$2" c="$3" p="$4" o="$5" a bd ad bp ap bs as rc; a="$(agy)"; bd="$(inventory "$d")"; bp="$(inventory "$protected")"; bs="$(sentinel_state)"; (cd "$d" && if [ -n "$c" ]; then exec "$a" --conversation "$c" --sandbox --mode plan --model "$MODEL" --output-format json --print-timeout "$TIMEOUT" --print "$p"; else exec "$a" --new-project --sandbox --mode plan --model "$MODEL" --output-format json --print-timeout "$TIMEOUT" --print "$p"; fi) > "$o" 2>"$o.stderr" & ACTIVE_CHILD=$!; rc=0; wait "$ACTIVE_CHILD" || rc=$?; ACTIVE_CHILD=''; [ "$rc" -eq 0 ] || die 'Gemini request failed; evidence preserved'; ad="$(inventory "$d")"; ap="$(inventory "$protected")"; as="$(sentinel_state)"; [ "$bd" = "$ad" ] || die "Gemini changed the disposable review copy; response rejected and copy preserved at $d"; [ "$bp" = "$ap" ] || die 'Gemini changed the protected source checkout; response rejected'; [ "$bs" = "$as" ] || die 'Gemini changed an outside sentinel; response rejected'; }
brief(){ cat <<EOF
Review this code without editing files, running commands, using the network, opening URLs, or invoking MCP tools. Read $2/MANIFEST.md first. Start your response exactly with:
## Verdict
Then provide concise findings with file paths. This is a disposable review copy.
--- Request ---
$1
EOF
}
report(){ local r="$1" n="$2" m="$3" o="$4" rel p physical tmp; rel=".ai/reviews/gemini-$n-$(date -u +%Y%m%dT%H%M%SZ)-$$.md"; p="$r/$rel"; [ ! -L "$r/.ai" ] && [ ! -L "$r/.ai/reviews" ] || die 'review report destination uses a link'; git -C "$r" check-ignore --no-index -q -- "$rel" 2>/dev/null || die 'review report destination is not safely Git-ignored'; git -C "$r" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && die 'review report destination is tracked'; mkdir -p "$r/.ai/reviews" || die 'cannot create review report directory'; physical="$(cd "$r/.ai/reviews" && pwd -P)"; case "$physical" in "$(cd "$r" && pwd -P)"/*) ;; *) die 'review report destination escapes repository' ;; esac; tmp="$(mktemp "$r/.ai/reviews/.gemini-report.XXXXXX")" || die 'cannot create review report'; { jq -er .response "$o"; printf '\n\n---\n'; jq -er '"Provider: Gemini\\nModel: " + .model + "\\nConversation: " + .conversation_id + "\\nHead: " + .head + "\\nPacket: " + .packet_sha256' "$m"; } > "$tmp" || { rm -f "$tmp"; die 'cannot render review report'; }; mv -f "$tmp" "$p" || { rm -f "$tmp"; die 'cannot publish review report'; }; [ -s "$p" ] || die 'review report is empty'; printf %s "$p"; }
begin(){ local m="$1" repo_lock="$2" session_lock="$3"; acquire "$repo_lock" repository; acquire "$session_lock" session; ACTIVE_META="$m"; ACTIVE_TERMINAL=0; }
begin_new(){ local m="$1" repo_lock="$2" session_lock="$3"; acquire "$repo_lock" repository; acquire "$session_lock" session; [ ! -e "$m" ] || { ACTIVE_TERMINAL=1; release_locks; die 'session already exists'; }; ACTIVE_META="$m"; ACTIVE_TERMINAL=0; }
finish(){ local m="$1"; update_state "$m" COMPLETE accepted; ACTIVE_TERMINAL=1; release_locks; ACTIVE_META=''; }
new(){ local n="${1:-}" r id m tag d p q out c h ph rep now; guard_quarantine; shift || true; name_ok "$n" || die 'invalid session name'; require_local_runtime; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; begin_new "$m" "$(lock_path "repo-$id")" "$(lock_path "session-$id-$CALLER-$n")"; tag="gemini-$id-$CALLER-$n"; d="$("$SANDBOX" ensure-copy "$r" "$tag")"; p="$("$PACKET" build "$d" "$tag")"; "$PACKET" verify "$p" >/dev/null; h="$(git -C "$d" rev-parse HEAD)"; ph="$(cat "$p/MANIFEST.sha256")"; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; write "$m" "$(jq -nc --arg name "$n" --arg caller "$CALLER" --arg root "$r" --arg dir "$d" --arg tag "$tag" --arg model "$MODEL" --arg head "$h" --arg packet "$ph" --arg now "$now" '{name:$name,caller:$caller,repository_root:$root,review_dir:$dir,sandbox_tag:$tag,conversation_id:null,model:$model,head:$head,packet_sha256:$packet,status:"PREPARED",created_at:$now,updated_at:$now}')"; update_state "$m" RUNNING 'provider request in progress'; q="$(brief "$(request "$@")" "$(basename "$p")")"; out="$(mktemp)"; call "$d" "$r" '' "$q" "$out"; verify_turn "$out"; c="$(jq -r .conversation_id "$out")"; update_state "$m" VERIFYING 'turn returned; checking exact model and report'; write "$m" "$(jq -c --arg c "$c" '.conversation_id=$c' "$m")"; verify_model "$d" "$r" "$c" "$out.model"; rep="$(report "$r" "$n" "$m" "$out")"; rm -f "$out" "$out.stderr" "$out.model" "$out.model.stderr"; finish "$m"; printf 'PASS session=%s report=%s\n' "$n" "$rep"; }
ask(){ local n="${1:-}" r id m d c q out rep actual tag; guard_quarantine; shift || true; name_ok "$n" || die 'invalid session name'; require_local_runtime; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; [ -f "$m" ] || die 'session not found'; [ "$(jq -r .status "$m")" = COMPLETE ] || die 'session requires recovery before reuse'; begin "$m" "$(lock_path "repo-$id")" "$(lock_path "session-$id-$CALLER-$n")"; d="$(jq -r .review_dir "$m")"; c="$(jq -r .conversation_id "$m")"; actual="$(git -C "$r" rev-parse HEAD)"; [ "$actual" = "$(jq -r .head "$m")" ] || die 'working checkout changed; start a new review'; tag="$(jq -r .sandbox_tag "$m")"; "$PACKET" verify "$("$PACKET" path "$d" "$tag")" >/dev/null || die 'evidence packet verification failed'; update_state "$m" RUNNING 'follow-up provider request in progress'; q="$(brief "$(request "$@")" "$(basename "$("$PACKET" path "$d" "$tag")")")"; out="$(mktemp)"; call "$d" "$r" "$c" "$q" "$out"; verify_turn "$out" "$c"; update_state "$m" VERIFYING 'turn returned; checking exact model and report'; verify_model "$d" "$r" "$c" "$out.model"; rep="$(report "$r" "$n" "$m" "$out")"; rm -f "$out" "$out.stderr" "$out.model" "$out.model.stderr"; finish "$m"; printf 'PASS session=%s report=%s\n' "$n" "$rep"; }
list(){ find "$STATE_DIR/sessions" -name '*.json' -type f -print0 2>/dev/null | xargs -0 -r -n1 jq -r '[.name,.caller,.status,.model,(.conversation_id//"unavailable")]|@tsv'; }
delete(){ local n="${1:-}" r id m d t status; name_ok "$n" || die 'invalid session name'; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; [ -f "$m" ] || die 'session not found'; acquire "$(lock_path "repo-$id")" repository; acquire "$(lock_path "session-$id-$CALLER-$n")" session; status="$(jq -r .status "$m")"; [ "$status" = COMPLETE ] || die 'refusing to delete preserved recovery evidence'; d="$(jq -r .review_dir "$m")"; t="$(jq -r .sandbox_tag "$m")"; "$PACKET" remove "$d" "$t" >/dev/null 2>&1 || true; "$SANDBOX" remove-copy "$r" "$t"; rm -f "$m"; ACTIVE_TERMINAL=1; release_locks; }
doctor(){ local a; need git; need jq; a="$(agy)"; "$a" --help 2>&1 | grep -q -- --sandbox || die 'agy lacks --sandbox'; "$a" models | grep -q "^$MODEL" || die 'configured model unavailable'; printf 'QUARANTINED agy=%s model=%s disposable-copy=yes containment=--sandbox+byte-inventory live-qualification=required\n' "$("$a" --version)" "$MODEL"; return 3; }
usage(){ printf '%s\n' 'Usage: ai-gemini new|ask <name> [--prompt TEXT|--prompt-file FILE|stdin] ; ai-gemini list|delete <name>|doctor'; }
case "${1:-}" in new) shift; new "$@";; ask) shift; ask "$@";; list) list;; delete) shift; delete "${1:-}";; doctor) doctor;; --version) echo "ai-gemini $VERSION";; -h|--help|help) usage;; *) usage >&2; exit 2;; esac
