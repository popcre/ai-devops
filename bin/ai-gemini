#!/usr/bin/env bash
# ai-gemini - Gemini reviews in a disposable repository copy.
set -euo pipefail
VERSION=0.1.0
STATE_DIR="${AI_GEMINI_STATE_DIR:-$HOME/.local/state/ai-devops/gemini}"
CALLER="${AI_GEMINI_CALLER:-codex}"
MODEL="${AI_GEMINI_MODEL:-gemini-3.7-flash-high}"
TIMEOUT="${AI_GEMINI_PRINT_TIMEOUT:-10m}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX="${AI_REVIEW_SANDBOX_BIN:-$HERE/ai-review-sandbox}"
PACKET="${AI_REVIEW_PACKET_BIN:-$HERE/ai-review-packet}"
die(){ printf 'ai-gemini: error: %s\n' "$*" >&2; exit 1; }
warn(){ printf 'ai-gemini: warning: %s\n' "$*" >&2; }
need(){ command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
name_ok(){ case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
root(){ git rev-parse --show-toplevel 2>/dev/null || die 'run inside a Git repository'; }
rid(){ local r="$1" u; u="$(git -C "$r" config --get remote.origin.url 2>/dev/null || true)"; printf '%s\n%s' "$(cd "$r" && pwd -P)" "$u" | sha256sum | cut -c1-12; }
meta(){ printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
agy(){ local a; for a in "${AI_GEMINI_BIN:-}" "$(command -v agy 2>/dev/null || true)" "${LOCALAPPDATA:-}/agy/bin/agy.exe"; do [ -n "$a" ] && [ -x "$a" ] && { printf %s "$a"; return; }; done; die 'local_dependency_unavailable: the LOCAL agy runtime is not installed. This is not a Gemini provider fault. Run: ai-gemini doctor'; }
require_local_runtime(){ local a; a="$(agy)"; "$a" --version >/dev/null 2>&1 || die 'local_dependency_unavailable: the LOCAL agy runtime cannot start. This is not a Gemini provider fault. Run: ai-gemini doctor'; }
tree_state(){ git -C "$1" status --porcelain=v1 --untracked-files=all | sha256sum | cut -d' ' -f1; }
request(){ if [ "${1:-}" = --prompt ]; then printf %s "${2:-}"; elif [ "${1:-}" = --prompt-file ]; then cat "${2:-}"; elif [ ! -t 0 ]; then cat; else die 'provide --prompt, --prompt-file, or standard input'; fi; }
write(){ local f="$1" j="$2" t; mkdir -p "$(dirname "$f")"; t="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"; printf '%s\n' "$j" > "$t"; mv -f "$t" "$f"; }
verify(){ jq -e '.status=="SUCCESS" and (.conversation_id|type=="string" and length>0) and (.response|type=="string" and length>0) and (.response|test("^## Verdict";"m"))' "$1" >/dev/null || die 'no usable Gemini verdict'; }
model(){ local d="$1" c="$2" o="$3" a error actual; a="$(agy)"; if ! (cd "$d" && MSYS_NO_PATHCONV=1 "$a" --conversation "$c" --sandbox --mode plan --output-format json --print-timeout 1m --print /model) > "$o" 2>"$o.stderr"; then error="$(tail -c 600 "$o.stderr" 2>/dev/null || true)"; die "model verification request failed: ${error:-no response}"; fi; if ! jq -e --arg m "$MODEL" '.status=="SUCCESS" and .command.name=="model" and .command.data.id==$m and .command.data.is_default==false' "$o" >/dev/null; then actual="$(jq -r '.command.data.id // .response // "unavailable"' "$o" 2>/dev/null | head -c 200)"; die "model verification returned '$actual'; expected $MODEL"; fi; }
call(){ local d="$1" c="$2" p="$3" o="$4" a before after; a="$(agy)"; before="$(tree_state "$d")"; (cd "$d" && if [ -n "$c" ]; then "$a" --conversation "$c" --sandbox --mode plan --model "$MODEL" --output-format json --print-timeout "$TIMEOUT" --print "$p"; else "$a" --new-project --sandbox --mode plan --model "$MODEL" --output-format json --print-timeout "$TIMEOUT" --print "$p"; fi) > "$o"; after="$(tree_state "$d")"; [ "$before" = "$after" ] || die "Gemini changed the disposable review copy; response rejected and copy preserved at $d"; }
brief(){ cat <<EOF
Review this code without editing files, running commands, using the network, opening URLs, or invoking MCP tools. Read .ai-review/MANIFEST.md first. Start your response exactly with:
## Verdict
Then provide concise findings with file paths. This is a disposable review copy.
--- Request ---
$1
EOF
}
report(){ local r="$1" n="$2" m="$3" o="$4" p rel; rel=".ai/reviews/gemini-$n-$(date -u +%Y%m%dT%H%M%SZ)-$$.md"; p="$r/$rel"; if git -C "$r" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 || ! git -C "$r" check-ignore --no-index -q -- "$rel" 2>/dev/null || [ -L "$r/.ai" ] || [ -L "$r/.ai/reviews" ]; then warn "not writing a review file: exact destination is not safely git-ignored in $r"; return 0; fi; mkdir -p "$r/.ai/reviews"; { jq -r .response "$o"; printf '\n\n---\n'; jq -r '"Provider: Gemini\\nModel: " + .model + "\\nConversation: " + .conversation_id + "\\nHead: " + .head + "\\nPacket: " + .packet_sha256' "$m"; } > "$p"; printf %s "$p"; }
new(){ local n="${1:-}" r id m tag d p q out mod c h ph rep; shift || true; name_ok "$n" || die 'invalid session name'; require_local_runtime; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; [ ! -e "$m" ] || die 'session already exists'; tag="gemini-$id-$CALLER-$n"; d="$("$SANDBOX" ensure-copy "$r" "$tag")"; p="$("$PACKET" build "$d" "$tag")"; "$PACKET" verify "$p" >/dev/null; q="$(brief "$(request "$@")")"; out="$(mktemp)"; call "$d" '' "$q" "$out"; verify "$out"; c="$(jq -r .conversation_id "$out")"; model "$d" "$c" "$out.model"; h="$(git -C "$d" rev-parse HEAD)"; ph="$(cat "$p/MANIFEST.sha256")"; write "$m" "$(jq -nc --arg name "$n" --arg caller "$CALLER" --arg root "$r" --arg dir "$d" --arg tag "$tag" --arg c "$c" --arg model "$MODEL" --arg head "$h" --arg packet "$ph" '{name:$name,caller:$caller,repository_root:$root,review_dir:$dir,sandbox_tag:$tag,conversation_id:$c,model:$model,head:$head,packet_sha256:$packet}')"; rep="$(report "$r" "$n" "$m" "$out")"; rm -f "$out" "$out.model"; printf 'PASS session=%s report=%s\n' "$n" "$rep"; }
ask(){ local n="${1:-}" r id m d c q out rep actual; shift || true; require_local_runtime; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; [ -f "$m" ] || die 'session not found'; d="$(jq -r .review_dir "$m")"; c="$(jq -r .conversation_id "$m")"; actual="$(git -C "$r" rev-parse HEAD)"; [ "$actual" = "$(jq -r .head "$m")" ] || die 'working checkout changed; start a new review'; q="$(brief "$(request "$@")")"; out="$(mktemp)"; call "$d" "$c" "$q" "$out"; verify "$out"; model "$d" "$c" "$out.model"; rep="$(report "$r" "$n" "$m" "$out")"; rm -f "$out" "$out.model"; printf 'PASS session=%s report=%s\n' "$n" "$rep"; }
list(){ find "$STATE_DIR/sessions" -name '*.json' -type f -print0 2>/dev/null | xargs -0 -r -n1 jq -r '[.name,.caller,.model,.conversation_id]|@tsv'; }
delete(){ local n="$1" r id m d t; r="$(root)"; id="$(rid "$r")"; m="$(meta "$id" "$n")"; [ -f "$m" ] || die 'session not found'; d="$(jq -r .review_dir "$m")"; t="$(jq -r .sandbox_tag "$m")"; "$PACKET" remove "$d" >/dev/null 2>&1 || true; "$SANDBOX" remove-copy "$r" "$t"; rm -f "$m"; }
doctor(){ need git; need jq; a="$(agy)"; "$a" --help 2>&1 | grep -q -- --sandbox || die 'agy lacks --sandbox'; "$a" models | grep -q "^$MODEL" || die 'configured model unavailable'; printf 'PASS agy=%s model=%s disposable-copy=yes containment=--sandbox\n' "$($a --version)" "$MODEL"; }
usage(){ printf '%s\n' 'Usage: ai-gemini new|ask <name> [--prompt TEXT|--prompt-file FILE|stdin] ; ai-gemini list|delete <name>|doctor'; }
case "${1:-}" in new) shift; new "$@";; ask) shift; ask "$@";; list) list;; delete) shift; delete "${1:-}";; doctor) doctor;; --version) echo "ai-gemini $VERSION";; -h|--help|help) usage;; *) usage >&2; exit 2;; esac
