#!/usr/bin/env bash
# Run this repository's CI verification locally, in parallel, on this machine.
#
# GitHub Actions runs two jobs: linux-offline (all Bash) and windows-offline
# (Windows-sensitive Bash plus all PowerShell). Scheduled/manual Windows and
# the local default below remain complete backstops.
#
# This runs the same suites, unchanged, across worker slots on this machine.
# It is a local pre-check, not a replacement for CI: GitHub is still the authority
# on whether a branch is green.
set -uo pipefail
_ai_st="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools/lib/session-tmp.sh"; if [ -f "$_ai_st" ]; then . "$_ai_st"; ai_session_tmp_wrap test-local "$(readlink -f "${BASH_SOURCE[0]}")" "$@"; fi; unset _ai_st  # own temp root, deleted on exit

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GH="$ROOT/bin/ai-gh"

JOBS=""
MODE="all"
FORCE=0
CHECK_COLLISION=0
# An explicit override retains the single-repository fixture/custom route.
# Otherwise each installed registration supplies its actual repository.
AI_TEST_RUNNER_REPO="${AI_TEST_RUNNER_REPO:-}"
AI_TEST_SHARED_RUNTIME_LOCK="${AI_TEST_SHARED_RUNTIME_LOCK:-}"
SHARED_RUNTIME_LOCK="$AI_TEST_SHARED_RUNTIME_LOCK"
SHARED_RUNTIME_LOCK_HELD=0

usage() {
  cat <<'USAGE'
usage: bin/ai-test-local [--bash|--powershell|--reviewer|--all] [-j N]

  --all          Bash suites and PowerShell suites (default; mirrors CI)
  --bash         only the Bash suites (mirrors linux-offline)
  --powershell   only the PowerShell suites
  --reviewer     only the reviewer safety suites (local check; no CI lane)
  -j N           worker slots (default: a quarter of this machine's cores, max 8)
  --force        start even if a CI job is running on this same machine
  --check-collision
                 report whether this host may start a local series, then exit

Logs land under .test-logs/. Failing suites are named at the end with their log
path; rerun just those with: bash tests/run-parallel.sh --rerun-failed
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --all) MODE=all; shift ;;
    --bash) MODE=bash; shift ;;
    --powershell|--pwsh) MODE=powershell; shift ;;
    --reviewer) MODE=reviewer; shift ;;
    -j) JOBS="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --check-collision) CHECK_COLLISION=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ "$CHECK_COLLISION" -eq 1 ] && [ "$FORCE" -eq 1 ]; then
  printf 'ai-test-local: --force and --check-collision cannot be combined; a safety probe cannot bypass itself.\n' >&2
  exit 2
fi

release_shared_runtime_lock() {
  [ "$SHARED_RUNTIME_LOCK_HELD" -eq 1 ] || return 0
  rmdir -- "$SHARED_RUNTIME_LOCK" 2>/dev/null || true
  SHARED_RUNTIME_LOCK_HELD=0
}

release_shared_runtime_lock_on_signal() {
  local rc="$1"
  release_shared_runtime_lock
  trap - EXIT INT TERM
  exit "$rc"
}

acquire_shared_runtime_lock() {
  [ -n "$SHARED_RUNTIME_LOCK" ] || return 0
  if mkdir -- "$SHARED_RUNTIME_LOCK" 2>/dev/null; then
    SHARED_RUNTIME_LOCK_HELD=1
    trap release_shared_runtime_lock EXIT
    trap 'release_shared_runtime_lock_on_signal 130' INT
    trap 'release_shared_runtime_lock_on_signal 143' TERM
    if [ "$CHECK_COLLISION" -eq 1 ]; then
      release_shared_runtime_lock
      trap - EXIT INT TERM
    fi
    unset AI_TEST_SHARED_RUNTIME_LOCK
    return 0
  fi
  if [ -d "$SHARED_RUNTIME_LOCK" ]; then
    printf 'ai-test-local: refusing to start -- shared installed runtime is already in use: %s\n' "$SHARED_RUNTIME_LOCK" >&2
    exit 3
  fi
  printf 'ai-test-local: unknown -- shared-runtime lock cannot be created safely: %s\n' "$SHARED_RUNTIME_LOCK" >&2
  exit 4
}

# --- refuse to collide with a CI job on THIS machine ------------------------
# On 2026-08-28 a local series and a CI job shared this desktop. The series'
# cleanup matched on process name and killed the runner's job, and eight
# concurrent suites starved its heartbeat. GitHub cannot prevent this: a
# runner's "busy" flag only reflects jobs it accepted, so a local shell suite
# is invisible to the dispatcher and it will hand this host a job mid-run.
#
# The check is per HOST, not per pool. A job on another Windows runner cannot
# touch this machine's processes, and waiting on one defeats the whole point of
# having a pool. So we resolve the runner(s) installed HERE from their own
# .runner files and ask about those names only.
#
# It fails OPEN. A local pre-check that refuses to run because gh is missing or
# unauthenticated is worse than the collision it prevents; --force skips it.
# The glob is overridable so the suite can drive this with fixture .runner
# files instead of whatever happens to be installed on the test machine. That
# matters: the GitHub-hosted CI lanes have no runner installed, so a check
# gated on real files would silently pass there and prove nothing.
AI_TEST_RUNNER_DIRS="${AI_TEST_RUNNER_DIRS:-/c/actions-runner* $HOME/actions-runner*}"

# Names are compared case-insensitively, with NULs and CRs stripped. The GitHub
# API returns EDGE-ALIEN where that host's own .runner may say edge-alien, and
# a stray CR from a Windows tool would make an exact compare fail open -- that
# is, run the series on a busy host while reporting all clear. Dropping NULs
# also lets a UTF-16 .runner parse, instead of yielding nothing and silently
# turning the guard off.
normalise_names() { tr -d '\000\r' | tr '[:upper:]' '[:lower:]' | sed '/^$/d'; }

local_runner_bindings() {
  local d f py='' candidate executable
  for d in $AI_TEST_RUNNER_DIRS; do
    f="$d/.runner"
    [ -f "$f" ] || continue
    if [ -z "$py" ]; then
      # Reuse ai-pr-wait's native-interpreter resolution. A Store alias is
      # not a usable interpreter and must not launch an interactive installer.
      for candidate in python3 python; do
        executable="$(command -v "$candidate" 2>/dev/null || true)"
        [ -n "$executable" ] || continue
        case "${executable,,}" in */windowsapps/*) continue ;; esac
        executable="$("$executable" -I -S -c 'import sys; print(sys.executable) if sys.version_info >= (3, 8) else sys.exit(1)' 2>/dev/null | tr -d '\r')" || continue
        if command -v cygpath >/dev/null 2>&1; then executable="$(cygpath -u "$executable")" || continue; fi
        [ -x "$executable" ] || continue
        py="$executable"; break
      done
      [ -n "$py" ] || return 4
    fi
    "$py" -I -S -c '
import json,re,sys
from urllib.parse import urlsplit
def unique(pairs):
 result={}
 for key,value in pairs:
  if key in result:raise ValueError()
  result[key]=value
 return result
try:
 raw=sys.stdin.buffer.read(1048577)
 if len(raw)>1048576:raise ValueError()
 encoding="utf-16" if raw.startswith((b"\xff\xfe",b"\xfe\xff")) else "utf-8-sig"
 if b"\0" in raw and encoding=="utf-8-sig":encoding="utf-16-le"
 data=json.loads(raw.decode(encoding),object_pairs_hook=unique)
 if type(data) is not dict:raise ValueError()
 name=data["agentName"]
 if not isinstance(name,str):raise ValueError()
 name=name.replace("\0", "").replace("\r", "")
 if not name or any(ord(c)<32 or ord(c)==127 for c in name):raise ValueError()
 repository=sys.argv[1]
 if not repository:
  address=data["gitHubUrl"]
  if not isinstance(address,str) or any(ord(c)<32 or ord(c)==127 for c in address):raise ValueError()
  url=urlsplit(address)
  if url.scheme!="https" or url.netloc.lower()!="github.com" or url.query or url.fragment:raise ValueError()
  repository=url.path.strip("/")
  if repository.endswith(".git"):repository=repository[:-4]
 if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+",repository) is None:raise ValueError()
 if any(part in (".","..") for part in repository.split("/")):raise ValueError()
 print(repository+"\t"+name)
except (ValueError,KeyError,TypeError,UnicodeError,AttributeError):sys.exit(4)
' "$AI_TEST_RUNNER_REPO" < "$f" || return 4
  done
}

refuse_if_local_runner_busy() {
  if [ "$FORCE" -eq 1 ]; then
    # Say it out loud. An unlogged escape hatch gets used under time pressure
    # and then nobody can tell, afterwards, why two runs killed each other.
    echo 'ai-test-local: --force given; skipping the same-host CI check.' >&2
    return 0
  fi
  local bindings names
  bindings="$(local_runner_bindings 2>/dev/null)" || {
    if [ "$CHECK_COLLISION" -eq 1 ]; then
      echo 'ai-test-local: unknown -- local runner registration is unavailable; no safe scheduling decision was made.' >&2
      exit 4
    fi
    return 0
  }
  bindings="$(printf '%s\n' "$bindings" | normalise_names | LC_ALL=C sort -u)"
  names="$(printf '%s\n' "$bindings" | cut -f2 | sed '/^$/d')"
  if [ -z "$bindings" ]; then
    [ "$CHECK_COLLISION" -eq 0 ] || echo 'ai-test-local: clear -- no GitHub runner installation is shared with this host.'
    return 0
  fi
  if [ ! -x "$GH" ]; then
    if [ "$CHECK_COLLISION" -eq 1 ]; then
      echo 'ai-test-local: unknown -- runner status is unavailable; no safe scheduling decision was made.' >&2
      exit 4
    fi
    return 0
  fi

  local repository registered_repo n busy_remote busy="" unavailable=0
  while IFS= read -r repository; do
    [ -n "$repository" ] || continue
    busy_remote="$(AI_GH_CALLER=ai-test-local "$GH" api "repos/$repository/actions/runners" --paginate \
                     --jq '.runners[] | select(.busy) | .name' 2>/dev/null | normalise_names)" || {
      unavailable=1
      continue
    }
    while IFS=$'\t' read -r registered_repo n; do
      [ "$registered_repo" = "$repository" ] || continue
      printf '%s\n' "$busy_remote" | grep -qxF "$n" && busy="$busy $n"
    done <<< "$bindings"
  done < <(printf '%s\n' "$bindings" | cut -f1 | LC_ALL=C sort -u)

  if [ -z "$busy" ] && [ "$unavailable" -eq 1 ]; then
    if [ "$CHECK_COLLISION" -eq 1 ]; then
      echo 'ai-test-local: unknown -- runner status is unavailable; no safe scheduling decision was made.' >&2
      exit 4
    fi
    return 0
  fi

  if [ -z "$busy" ]; then
    [ "$CHECK_COLLISION" -eq 0 ] || printf 'ai-test-local: clear -- this host\x27s runner(s) are idle: %s\n' "$(printf '%s' "$names" | tr '\n' ' ')"
    return 0
  fi
  cat >&2 <<MSG

ai-test-local: refusing to start -- a CI job is running on THIS machine.

  busy runner(s) here:$busy

A local suite series and a CI job on the same host kill each other (see the
2026-08-28 entry in docs/critical-incidents.md). Wait for that job, or run the
series on a different machine. A job on any OTHER runner does not block you.

  --force  run anyway, accepting that both may fail

MSG
  exit 3
}

jflag=()
[ -n "$JOBS" ] && jflag=(-j "$JOBS")

failures=0
started="$(date +%s)"

run_bash_suites() {
  printf '\n===== BASH SUITES (parallel) =====\n'
  bash "$ROOT/tests/run-parallel.sh" "${jflag[@]}" || failures=$((failures + 1))
}

run_reviewer_suites() {
  printf '\n===== REVIEWER SAFETY SUITES (parallel) =====\n'
  bash "$ROOT/tests/run-parallel.sh" "${jflag[@]}" -p 'test-ai-@(grok-review).sh' \
    || failures=$((failures + 1))
}

run_powershell_suites() {
  if ! command -v pwsh >/dev/null 2>&1; then
    printf '\n===== POWERSHELL SUITES skipped: pwsh is not on PATH =====\n'
    return
  fi
  printf '\n===== POWERSHELL SUITES (parallel) =====\n'
  local args=(-NoProfile -File "$ROOT/tests/run-parallel.ps1")
  [ -n "$JOBS" ] && args+=(-Jobs "$JOBS")
  pwsh "${args[@]}" || failures=$((failures + 1))
}

shopt -s extglob
acquire_shared_runtime_lock
refuse_if_local_runner_busy
[ "$CHECK_COLLISION" -eq 0 ] || exit 0
case "$MODE" in
  all)        run_bash_suites; run_powershell_suites ;;
  bash)       run_bash_suites ;;
  powershell) run_powershell_suites ;;
  reviewer)   run_reviewer_suites ;;
esac

wall=$(( $(date +%s) - started ))
printf '\nLOCAL VERIFY SUMMARY mode=%s failing-groups=%s wall=%ss\n' "$MODE" "$failures" "$wall"
[ "$failures" -eq 0 ]
