#!/usr/bin/env bash
# ai-antigravity: Antigravity + Gemini second opinion through the shared path
# (bin/ai-second-opinion). See its --help.
d="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
py=python3; command -v python3 >/dev/null 2>&1 || py=python
exec "$py" "$d/ai-second-opinion" antigravity "$@"
