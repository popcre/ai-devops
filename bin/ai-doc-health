#!/usr/bin/env python3
"""Measure documentation health: size, headers, index freshness, strays, duplicates.

Advisory upkeep tool. Reads a committed .doc-health.json at the repository
root and prints one line per fault: `<check-id> <path> <plain reason>`.
Exit 0 when clean, 1 when any fault, 2 on usage or config error.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fnmatch
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import posixpath
import re
import subprocess
import sys
from pathlib import Path


CONFIG_NAME = ".doc-health.json"
REACHABILITY_CONFIG = ".doc-reachability.json"
INDEX_BANNER = "<!-- generated by ai-doc-health; edit the document headers, not this file -->"
KINDS = ("living", "ops", "spec", "plan", "proof", "archive")
STATUSES = ("current", "open", "done", "stale")
SIZE_EXEMPT_KINDS = ("plan", "proof", "archive")
HEADER_KEYS = ("summary", "kind", "status", "read-when")
HEADER_WINDOW = 2048
SUMMARY_MAX = 160
POINTER_MAX_BYTES = 600
CHECK_ORDER = (
    "router-size",
    "living-size",
    "header-missing",
    "index-stale",
    "unreachable",
    "root-stray",
    "handoff-old",
    "dup-in-repo",
    "dup-across",
    "status-stale",
)
DEFAULTS = {
    "exclude": [],
    "router": "AGENTS.md",
    "router_max_bytes": 30000,
    "living_max_bytes": 60000,
    "handoff_dir": "HANDOFF.d",
    "handoff_max_age_days": 30,
    "index": "docs/INDEX.md",
    "header_exempt": ["AGENTS.md", "CLAUDE.md", "README.md", "HANDOFF.md", "HANDOFF.d/**"],
    "root_markdown_allow": ["AGENTS.md", "CLAUDE.md", "README.md", "HANDOFF.md", "plan_*.md"],
    "status_stale_days": 120,
}
LIST_KEYS = ("exclude", "header_exempt", "root_markdown_allow")
INT_KEYS = ("router_max_bytes", "living_max_bytes", "handoff_max_age_days", "status_stale_days")
STR_KEYS = ("router", "handoff_dir", "index")


class ConfigError(RuntimeError):
    pass


def git(repo: Path, *args: str) -> str:
    proc = subprocess.run(
        ["git", "-C", str(repo), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.returncode:
        detail = proc.stderr.decode("utf-8", "replace").strip()
        raise ConfigError(f"git {' '.join(args)} failed: {detail}")
    return proc.stdout.decode("utf-8", "replace")


def normalize(path: str) -> str:
    value = posixpath.normpath(path.replace("\\", "/"))
    return "" if value == "." else value


def glob_regex(pattern: str) -> re.Pattern[str]:
    out = []
    i = 0
    pattern = normalize(pattern) if not pattern.endswith("/**") else normalize(pattern[:-3]) + "/**"
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    return re.compile("".join(out) + r"\Z")


def matches(path: str, patterns: list[re.Pattern[str]]) -> bool:
    return any(p.match(path) for p in patterns)


def load_config(repo: Path) -> dict:
    path = repo / CONFIG_NAME
    if not path.is_file():
        raise ConfigError(f"Committed config not found: {path}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ConfigError(f"Cannot read config {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise ConfigError("Config must be a JSON object")
    config = dict(DEFAULTS)
    config.update(data)
    for key in LIST_KEYS:
        value = config[key]
        if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
            raise ConfigError(f"Config '{key}' must be a list of strings")
    for key in INT_KEYS:
        value = config[key]
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise ConfigError(f"Config '{key}' must be a non-negative whole number")
    for key in STR_KEYS:
        if not isinstance(config[key], str) or not config[key]:
            raise ConfigError(f"Config '{key}' must be a non-empty string")
    for key in STR_KEYS:
        config[key] = normalize(config[key])
    return config


def tracked_markdown(repo: Path, exclude: list[re.Pattern[str]]) -> list[str]:
    raw = git(repo, "ls-files", "-z")
    files = []
    for name in raw.split("\0"):
        if not name or not name.lower().endswith(".md"):
            continue
        name = normalize(name)
        if matches(name, exclude):
            continue
        if (repo / name).is_file():
            files.append(name)
    return sorted(set(files))


def read_bytes(repo: Path, path: str) -> bytes:
    try:
        return (repo / path).read_bytes()
    except OSError:
        return b""


def unquote_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        inner = value[1:-1]
        if value[0] == '"':
            inner = inner.replace("\\n", "\n").replace("\\t", "\t").replace('\\"', '"').replace("\\\\", "\\")
        else:
            inner = inner.replace("''", "'")
        return inner
    return value


def parse_header(data: bytes) -> tuple[dict[str, str] | None, str]:
    """Return (header, problem). Only the first HEADER_WINDOW bytes are read."""
    text = data[:HEADER_WINDOW].decode("utf-8", "replace").replace("\r\n", "\n")
    if text.startswith("﻿"):
        text = text[1:]
    if not text.startswith("---\n"):
        return None, "no header"
    end = text.find("\n---\n", 3)
    if end < 0 and text.endswith("\n---"):
        end = len(text) - 4
    if end < 0:
        return None, "header is not closed in the first 2 KB"
    header: dict[str, str] = {}
    last: str | None = None
    for line in text[4:end + 1].split("\n"):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t":
            if last is None:
                return None, "malformed header"
            header[last] = (header[last] + "\n" + line.strip()).strip()
            continue
        match = re.match(r"([A-Za-z0-9_-]+):(?:\s+(.*))?$", line)
        if not match:
            return None, "malformed header"
        last = match.group(1)
        value = (match.group(2) or "").strip()
        if value in (">", "|", ">-", "|-"):
            value = ""
        header[last] = unquote_value(value)
    return header, ""


def header_problem(header: dict[str, str] | None, problem: str) -> str:
    if header is None:
        return problem
    for key in HEADER_KEYS:
        if not collapse(header.get(key, "")):
            return f"header key '{key}' is missing"
    if header["kind"] not in KINDS:
        return f"header kind '{collapse(header['kind'])[:40]}' is not one of {', '.join(KINDS)}"
    if header["status"] not in STATUSES:
        return f"header status '{collapse(header['status'])[:40]}' is not one of {', '.join(STATUSES)}"
    if len(collapse(header["summary"])) > SUMMARY_MAX:
        return f"header summary is longer than {SUMMARY_MAX} characters"
    return ""


def collapse(text: str) -> str:
    return " ".join(text.split())


def cell(text: str) -> str:
    return collapse(text).replace("|", "\\|")


def link_target(index_path: str, doc: str) -> str:
    rel = posixpath.relpath(doc, posixpath.dirname(index_path) or ".")
    return rel.replace(" ", "%20").replace("(", "%28").replace(")", "%29")


def build_index(index_path: str, headers: dict[str, dict[str, str]]) -> str:
    lines = [INDEX_BANNER, "", "# Document index", ""]
    lines.append("Read the summary; open a document only when it matches your task.")
    for kind in KINDS:
        rows = sorted(path for path, header in headers.items() if header["kind"] == kind)
        if not rows:
            continue
        lines += ["", f"## {kind}", "", "| File | Status | Summary | Read when |", "|---|---|---|---|"]
        for path in rows:
            header = headers[path]
            label = path.replace("|", "\\|").replace("[", "\\[").replace("]", "\\]")
            lines.append(
                f"| [{label}]({link_target(index_path, path)}) | {header['status']} | "
                f"{cell(header['summary'])} | {cell(header['read-when'])} |"
            )
    return "\n".join(lines) + "\n"


def load_reachability():
    tool = Path(__file__).resolve().parent / "ai-doc-reachability"
    if not tool.is_file():
        raise ConfigError(f"ai-doc-reachability not found beside ai-doc-health: {tool}")
    loader = importlib.machinery.SourceFileLoader("ai_doc_reachability", str(tool))
    spec = importlib.util.spec_from_loader("ai_doc_reachability", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["ai_doc_reachability"] = module
    loader.exec_module(module)
    return module


def unreachable_docs(repo: Path) -> list[str]:
    module = load_reachability()
    try:
        config = module.load_config(repo, REACHABILITY_CONFIG)
        files = module.tracked_markdown(repo, config["exclude"])
        graph, _inbound = module.build_graph(repo, files)
        reachable, _roots = module.reachable_from_roots(graph, config["roots"])
    except module.CheckError as exc:
        raise ConfigError(f"ai-doc-reachability: {exc}") from exc
    return sorted(path for path in files if path not in reachable and (repo / path).is_file())


def handoff_date(name: str) -> dt.date | None:
    match = re.match(r"(\d{4})-(\d{2})-(\d{2})", posixpath.basename(name))
    if not match:
        return None
    try:
        return dt.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
    except ValueError:
        return None


def recently_committed(repo: Path, days: int, today: dt.date) -> set[str] | None:
    """Paths touched by a commit in the window, or None when history is unusable."""
    try:
        if git(repo, "rev-parse", "--is-shallow-repository").strip() == "true":
            return None
        since = (today - dt.timedelta(days=days)).isoformat()
        raw = git(repo, "log", f"--since={since}T00:00:00", "--name-only", "--format=", "-z", "HEAD")
        dirty = git(repo, "status", "--porcelain", "-z", "--untracked-files=no")
    except ConfigError:
        return None
    seen = {normalize(p) for p in re.split(r"[\0\n]", raw) if p}
    for entry in dirty.split("\0"):
        if len(entry) > 3:
            seen.add(normalize(entry[3:]))
    return seen


def sibling_hashes(repo: Path, siblings: list[str], fallback_exclude: list[str]) -> dict[str, str]:
    """Map content hash -> '<sibling>/<path>' for sibling documents that are not pointers."""
    found: dict[str, str] = {}
    own = repo.resolve()
    for raw in sorted(set(siblings)):
        sibling = Path(raw).resolve()
        if sibling == own or not (sibling / ".git").exists():
            continue
        patterns = fallback_exclude
        try:
            patterns = load_config(sibling)["exclude"]
        except ConfigError:
            pass
        try:
            files = tracked_markdown(sibling, [glob_regex(p) for p in patterns])
        except ConfigError:
            continue
        for path in files:
            data = read_bytes(sibling, path)
            if len(data) < POINTER_MAX_BYTES:
                continue
            found.setdefault(hashlib.sha256(data).hexdigest(), f"{sibling.name}/{path}")
    return found


def run(repo: Path, args: argparse.Namespace) -> tuple[list[tuple[str, str, str]], bool]:
    config = load_config(repo)
    today = dt.date.fromisoformat(args.today) if args.today else dt.date.today()
    exclude = [glob_regex(p) for p in config["exclude"]]
    exempt = [glob_regex(p) for p in config["header_exempt"]]
    files = tracked_markdown(repo, exclude)
    index_path = config["index"]
    router = config["router"]
    handoff_prefix = config["handoff_dir"].rstrip("/") + "/"
    faults: list[tuple[str, str, str]] = []
    contents = {path: read_bytes(repo, path) for path in files}

    router_file = repo / router
    if router_file.is_file():
        size = router_file.stat().st_size
        if size > config["router_max_bytes"]:
            faults.append(("router-size", router, f"{size} bytes, over the {config['router_max_bytes']} byte budget"))

    headers: dict[str, dict[str, str]] = {}
    for path in files:
        if path == index_path or path == router or matches(path, exempt) or path.startswith(handoff_prefix):
            continue
        header, problem = parse_header(contents[path])
        problem = header_problem(header, problem)
        if problem:
            faults.append(("header-missing", path, problem))
        else:
            headers[path] = header
        size = len(contents[path])
        kind = header.get("kind") if header and not problem else None
        if size > config["living_max_bytes"] and kind not in SIZE_EXEMPT_KINDS:
            faults.append(
                ("living-size", path, f"{size} bytes, over the {config['living_max_bytes']} byte budget for living documents")
            )

    wanted = build_index(index_path, headers)
    index_file = repo / index_path
    wrote = False
    if args.fix_index:
        current = index_file.read_bytes() if index_file.is_file() else None
        if current != wanted.encode("utf-8"):
            index_file.parent.mkdir(parents=True, exist_ok=True)
            index_file.write_bytes(wanted.encode("utf-8"))
            wrote = True
    if not index_file.is_file():
        faults.append(("index-stale", index_path, "index file is missing; run ai-doc-health --fix-index"))
    elif index_file.read_bytes() != wanted.encode("utf-8"):
        faults.append(("index-stale", index_path, "differs from the document headers; run ai-doc-health --fix-index"))

    if (repo / REACHABILITY_CONFIG).is_file():
        for path in unreachable_docs(repo):
            if not matches(path, exclude):
                faults.append(("unreachable", path, "no chain of links from a root document reaches this file"))

    allow = config["root_markdown_allow"]
    for path in files:
        if "/" not in path and not any(fnmatch.fnmatchcase(path, pattern) for pattern in allow):
            faults.append(("root-stray", path, "Markdown file at the repository root that the allow list does not name"))

    for path in files:
        if not path.startswith(handoff_prefix):
            continue
        made = handoff_date(path)
        if made is None:
            faults.append(("handoff-old", path, "no date in name"))
        else:
            age = (today - made).days
            if age > config["handoff_max_age_days"]:
                faults.append(
                    ("handoff-old", path, f"{age} days old, over {config['handoff_max_age_days']}; successor review due")
                )

    by_hash: dict[str, str] = {}
    hashes: dict[str, str] = {}
    for path in files:
        digest = hashlib.sha256(contents[path]).hexdigest()
        hashes[path] = digest
        if not contents[path].strip():
            continue
        if digest in by_hash:
            faults.append(("dup-in-repo", path, f"identical to {by_hash[digest]}"))
        else:
            by_hash[digest] = path

    if args.siblings:
        other = sibling_hashes(repo, args.siblings, config["exclude"])
        for path in files:
            # Header-exempt files (the static HANDOFF.md pointer, for one) are identical by design.
            if len(contents[path]) < POINTER_MAX_BYTES or path.startswith(handoff_prefix) or matches(path, exempt):
                continue
            if hashes[path] in other:
                faults.append(("dup-across", path, f"identical to {other[hashes[path]]}"))

    if config["status_stale_days"]:
        recent = recently_committed(repo, config["status_stale_days"], today)
        if recent is not None:
            for path, header in headers.items():
                if header["status"] in ("open", "current") and path not in recent:
                    faults.append(
                        (
                            "status-stale",
                            path,
                            f"status is {header['status']} but no commit in {config['status_stale_days']} days; re-confirm",
                        )
                    )

    faults.sort(key=lambda fault: (CHECK_ORDER.index(fault[0]), fault[1]))
    return faults, wrote


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default=".", help="Git repository to check")
    parser.add_argument("--json", action="store_true", help="Print faults as a JSON list")
    parser.add_argument("--fix-index", action="store_true", help="Rewrite the index from document headers")
    parser.add_argument("--siblings", nargs="*", default=[], help="Sibling repositories for the cross-repo duplicate check")
    parser.add_argument("--today", default=os.environ.get("AI_DOC_HEALTH_TODAY"), help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    repo = Path(args.repo).resolve()
    try:
        if not (repo / ".git").exists():
            raise ConfigError(f"Not a Git working tree: {repo}")
        faults, wrote = run(repo, args)
    except (ConfigError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps([{"check": c, "path": p, "reason": r} for c, p, r in faults], indent=2))
    else:
        for check, path, reason in faults:
            print(f"{check} {path} {reason}")
    if wrote:
        print("index rewritten", file=sys.stderr)
    print(f"{len(faults)} fault(s)" if faults else "clean", file=sys.stderr)
    return 1 if faults else 0


if __name__ == "__main__":
    raise SystemExit(main())
