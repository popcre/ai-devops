#!/usr/bin/env bash
# ai-review-sandbox — make a linked Git worktree reviewable by a single-directory reviewer.
#
# WHY THIS EXISTS
#
# Every delegated reviewer we drive (GLM/OpenCode, Kimi, Qwen, Grok, Codex,
# DeepSeek) is given exactly ONE directory as its boundary. That is fine in an
# ordinary clone, where `.git/` sits inside that directory. It is NOT fine in a
# linked worktree: there `.git` is a one-line FILE pointing at
# `<main-repo>/.git/worktrees/<name>`, which is outside the boundary. The
# reviewer's first `git`-adjacent read is refused and the run dies before any
# code is read — observed on 2026-08-17 as "GLM's first review attempt stopped
# before reading code because this worktree's Git control files live outside its
# review boundary".
#
# None of those tools accept a second directory, so the boundary cannot simply be
# widened. Instead this script hands the reviewer a SELF-CONTAINED, disposable
# snapshot of the worktree: its own `.git/` inside the boundary, checked out at
# the worktree's HEAD, with the worktree's uncommitted edits and untracked files
# reproduced on top. The reviewer sees exactly the code under review and never
# needs to look outside its own directory.
#
# Since v1.5.0 the snapshot is BOUNDED (issue #711): instead of a full clone
# carrying the repository's entire history (~50 MB × thousands of copies filled
# the disk), it is built by a shallow `git fetch --depth N` over file://, where
# N is measured from the source so the fetch covers exactly the ancestry the
# evidence tools read back: the chain from HEAD down past the fork point of
# every base-ref candidate ai-review-packet's resolver considers
# (origin/main, origin/master, main, master, plus the caller's explicit
# AI_REVIEW_SANDBOX_BASE hint). Every want is a SHA pinned BEFORE the fetch, so
# ref identities are frozen against concurrent commits exactly as the old
# captured-refs transaction was, and every carried ref's merge-base is re-proved
# in the snapshot after the fetch: any mismatch aborts the build rather than
# publishing evidence whose comparison could be silently mis-scoped.
#
#   ai-review-sandbox ensure <repo-root> <tag>   # print the directory to review; create/refresh it
#   ai-review-sandbox ensure-copy <repo-root> <tag> # always create a disposable snapshot
#   ai-review-sandbox ensure-code-only <repo-root> <tag> --paths-file <JSON> [--base REF]
#   ai-review-sandbox verify-code-only <snapshot> [--assert-head <original-SHA>]
#   ai-review-sandbox refresh-copy <repo-root> <tag> <managed-copy> # refresh a recorded stable path
#   ai-review-sandbox with-copy <repo-root> <tag> -- <command>... # create, run command, delete before return
#   ai-review-sandbox remove-recorded <tag> <managed-copy> # remove that exact recorded stable path
#   ai-review-sandbox path   <repo-root> <tag>   # print it without creating anything
#   ai-review-sandbox remove <repo-root> <tag>   # delete the snapshot, if any
#   ai-review-sandbox is-worktree <dir>          # exit 0 when <dir> is a linked worktree
#
# SELF-CLEANUP (issue #711 Phase 2): the run that creates a snapshot deletes it
# before returning. `with-copy` is the guaranteed form: it arms an EXIT/INT/TERM
# trap that removes the snapshot on success, failure, and abort. One-shot
# wrappers that call `ensure-copy` themselves must mirror that trap (see
# bin/ai-claude-review). Session wrappers delete at session end.
#
# AI_KEEP_SANDBOX=1 skips every delete and prints the retained path on stderr —
# debugging only. Never leave it set in production.
#
# In an ordinary clone every command is a no-op and `ensure`/`path` simply echo
# <repo-root>, so callers can wire this in unconditionally.
#
# <tag> namespaces one caller/session against another (e.g. "glm-authfix").
# Snapshots live under $AI_REVIEW_SANDBOX_DIR and are safe to delete at any time;
# they are never the source of truth and are never pushed anywhere.

set -euo pipefail

VERSION="1.6.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SANDBOX_DIR="${AI_REVIEW_SANDBOX_DIR:-$HOME/.local/state/ai-devops/review-sandboxes}"
MARKER=".ai-review-sandbox"

# Optional caller hint naming the explicit --base ref a packet build will pass
# inside the snapshot (ai-review-packet resolve's `--base`). The snapshot then
# carries that ref too, so an explicit comparison never dies on a bounded
# snapshot. Empty or unresolvable values are ignored with a warning; the packet
# build itself fails loudly if the ref truly matters and is missing.
BASE_HINT="${AI_REVIEW_SANDBOX_BASE:-}"

die()  { printf 'ai-review-sandbox: %s\n' "$1" >&2; exit 1; }
warn() { printf 'ai-review-sandbox: %s\n' "$1" >&2; }

# A linked worktree is exactly the case where `.git` is a file, not a directory.
is_worktree() { [ -f "$1/.git" ] && ! [ -d "$1/.git" ]; }

canon() { (cd "$1" 2>/dev/null && pwd -P) || die "no such directory: $1"; }
canon_quiet() { (cd "$1" 2>/dev/null && pwd -P); }

valid_tag() {
  case "$1" in
    ''|*[!a-zA-Z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# short_name TEXT MAX: TEXT when it fits in MAX characters; otherwise a prefix
# plus a 12-hex hash of the whole TEXT, exactly MAX long. Every path component
# built from a session name, caller, or tag goes through this, so no derived
# path grows with the length of a worktree-derived name.
short_name() { local s="$1" max="$2"; if [ "${#s}" -le "$max" ]; then printf %s "$s"; else printf '%s-%s' "${s:0:$((max-13))}" "$(printf %s "$s" | sha256sum | cut -c1-12)"; fi; }

sandbox_id() { # sandbox_id ROOT TAG -> stable directory name
  local h
  h="$(printf '%s' "$1" | sha256sum | cut -c1-12)"
  # A tag of any length maps to a directory name of at most 77 characters.
  printf '%s-%s' "$(short_name "$2" 64)" "$h"
}

sandbox_path() {
  local root="$SANDBOX_DIR"
  # Git Bash can expose the same Windows directory through equivalent mount,
  # long-name, and 8.3 spellings. Once the managed root exists, publish and
  # persist its physical spelling so later argv conversion cannot change the
  # directory identity recorded for a persistent review.
  [ ! -d "$root" ] || root="$(canon "$root")"
  printf '%s/%s' "$root" "$(sandbox_id "$1" "$2")"
}

# Refuse to touch anything that is not one of ours: a managed snapshot always
# carries the marker file AND lives under the sandbox directory.
is_managed() {
  local d="$1" sandbox_root
  # Git Bash can expose the same Windows directory through both an 8.3 path
  # (RUNNER~1) and its long path (runneradmin). Compare physical paths so a
  # recorded snapshot remains manageable across those equivalent spellings.
  sandbox_root="$(canon_quiet "$SANDBOX_DIR")" || return 1
  d="$(canon_quiet "$d")" || return 1
  case "$d" in "$sandbox_root"/*) ;; *) return 1 ;; esac
  [ -f "$d/$MARKER" ]
}

remove_sandbox() {
  local d="$1"
  [ -e "$d" ] || return 0
  is_managed "$d" || die "refusing to delete $d: it is not a managed review snapshot."
  if [ "${AI_KEEP_SANDBOX:-0}" = 1 ]; then
    warn "AI_KEEP_SANDBOX=1: retaining $d"
    return 0
  fi
  local python event_tool
  python="$(command -v python3 || command -v python)" || die 'sandbox evidence verification requires Python'
  event_tool="$(cd "$(dirname "${BASH_SOURCE[0]}")/../tools" && pwd -P)/reviewer_events.py"
  "$python" "$event_tool" verify-sandbox "$d" >/dev/null || die 'sandbox evidence is not reconciled; retained for local recovery'
  rm -rf "$d" 2>/dev/null || { sleep 1; rm -rf "$d"; } || warn "could not fully remove $d"
  warn "deleted review snapshot $d"
}

remove_partial() { # remove_partial BUILD FINAL — only a uniquely named child beside FINAL
  local build="$1" final="$2"
  [ -e "$build" ] || return 0
  case "$build" in "$final".building.*) rm -rf -- "$build" ;; *) die "refusing to remove unexpected partial snapshot: $build" ;; esac
}

test_progress() { # test_progress — observable work for loaded fixture waits only
  [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] || return 0
  [ -n "${AI_REVIEW_SANDBOX_PROGRESS_FILE:-}" ] || return 0
  printf '.\n' >> "$AI_REVIEW_SANDBOX_PROGRESS_FILE"
}

generated_review_path() { # ROOT RELATIVE_PATH; never exclude source by prefix alone
  case "$2" in
    .ai-review/*|.ai-review-sandbox|AI-REVIEW-SANDBOX.md) return 0 ;;
    # Windows PowerShell writes this module-analysis cache into its CURRENT
    # DIRECTORY whenever LOCALAPPDATA is missing from its environment. It is a
    # tool cache, never source: counting it made the source digest and the
    # snapshot digest disagree, so every review failed snapshot-digest-mismatch
    # while the file sat in a checkout (#754). Exact root path only.
    Microsoft/Windows/PowerShell/ModuleAnalysisCache) [ -f "$1/$2" ] && [ ! -L "$1/$2" ] && return 0 ;;
    .ai-review-*/*)
      [ -f "$1/${2%%/*}/.ai-review-packet" ] && return 0 ;;
  esac
  return 1
}

source_inventory() { # source_inventory ROOT OUTPUT — NUL-safe review-visible tree identity
  local root="$1" output="$2" list diff rel kind bytes digest tree
  list="$(mktemp)"; diff="$(mktemp)"
  tree="$(git -C "$root" rev-parse HEAD^{tree} 2>/dev/null)" \
    || { rm -f "$list" "$diff"; return 1; }
  test_progress || { rm -f "$list" "$diff"; return 1; }
  git -C "$root" diff --binary HEAD > "$diff" 2>/dev/null \
    || { rm -f "$list" "$diff"; return 1; }
  test_progress || { rm -f "$list" "$diff"; return 1; }
  git -C "$root" ls-files --others --exclude-standard -z > "$list" \
    || { rm -f "$list" "$diff"; return 1; }
  test_progress || { rm -f "$list" "$diff"; return 1; }
  : > "$output"
  printf 'head_tree\0%s\0tracked_diff_bytes\0%s\0tracked_diff_sha256\0%s\0' \
    "$tree" "$(wc -c < "$diff" | tr -d ' ')" "$(sha256sum "$diff" | cut -d' ' -f1)" >> "$output"
  test_progress || { rm -f "$list" "$diff"; return 1; }
  while IFS= read -r -d '' rel; do
    if generated_review_path "$root" "$rel"; then continue; fi
    if [ -L "$root/$rel" ]; then
      kind=symlink
      bytes="$(readlink -n "$root/$rel" | wc -c | tr -d ' ')" || { rm -f "$list" "$diff"; return 1; }
      digest="$(readlink -n "$root/$rel" | sha256sum | cut -d' ' -f1)" || { rm -f "$list" "$diff"; return 1; }
    elif [ -f "$root/$rel" ]; then
      [ -r "$root/$rel" ] || { rm -f "$list" "$diff"; return 1; }
      kind=file
      bytes="$(wc -c < "$root/$rel" | tr -d ' ')" || { rm -f "$list" "$diff"; return 1; }
      digest="$(sha256sum "$root/$rel" | cut -d' ' -f1)" || { rm -f "$list" "$diff"; return 1; }
    else
      rm -f "$list" "$diff"
      return 1
    fi
    printf 'path\0%s\0type\0%s\0bytes\0%s\0sha256\0%s\0' \
      "$rel" "$kind" "$bytes" "$digest" >> "$output"
    test_progress || { rm -f "$list" "$diff"; return 1; }
  done < "$list"
  rm -f "$list" "$diff"
}

source_digest() { # source_digest ROOT
  local inventory digest
  inventory="$(mktemp)"
  source_inventory "$1" "$inventory" \
    || { rm -f "$inventory"; die "could not read the complete review-visible source inventory in $1"; }
  digest="$(sha256sum "$inventory" | cut -d' ' -f1)"
  rm -f "$inventory"
  printf '%s' "$digest"
}

# The complete tracked and untracked path inventory is classified before any
# clone, copy, or packet builder can expose a licensed repository. An empty or
# unclassifiable inventory fails closed; Git's quoted display names are never
# parsed as paths.
source_is_private() { # source_is_private ROOT; 0 private, 1 public, 2 unknown
  local root="$1" paths decision python
  python="$(command -v python3 || command -v python)" || return 2
  paths="$(mktemp)" || return 2
  if ! git -C "$root" ls-files -co --exclude-standard -z | "$python" -c '
import sys
names=[n.decode("utf-8", "surrogateescape") for n in sys.stdin.buffer.read().split(b"\0") if n]
if any("\n" in n or "\r" in n for n in names): sys.exit(2)
# Write bytes: a name outside the console code page (observed as U+F00A from
# MSYS filename mangling on Windows) must not crash classification, whose only
# two answers are a complete paths file and a refusal. The inventory is the
# real tracked+untracked set only — no phantom path is invented, so an empty
# repository classifies as none and fails closed below.
sys.stdout.buffer.write(b"\n".join([n.encode("utf-8", "surrogateescape") for n in names]) + b"\n")
' > "$paths"; then rm -f "$paths"; return 2; fi
  # Resolve the gate explicitly, then by PATH (the offline suites stub it
  # there), then beside this script: a review started where bin/ is not on PATH
  # must still classify with its own tree's contract instead of failing closed.
  local gates_bin="${AI_TASK_GATES_BIN:-}"
  [ -n "$gates_bin" ] || gates_bin="$(command -v ai-task-gates 2>/dev/null || true)"
  [ -n "$gates_bin" ] || gates_bin="$SCRIPT_DIR/ai-task-gates"
  [ -x "$gates_bin" ] || return 2
  decision="$(cd "$root" && "$gates_bin" explain --json --paths-from "$paths" 2>/dev/null)" \
    || { rm -f "$paths"; return 2; }
  rm -f "$paths"
  # The privacy verdict is the classified change set, not the remote's shape:
  # both private classes are private (#702 — a formal review snapshots the whole
  # private repository), and an unresolved remote (local path, ssh alias, none)
  # classifies on default paths plus the repository's own declaration, exactly
  # as the task gate itself does for the review action. "none" (empty
  # inventory) is NOT public: the comment above says an empty or unclassifiable
  # inventory fails closed, and the caller treats 2 as refuse-everything.
  printf '%s' "$decision" | jq -e '.effective_class == "private-evidence" or .effective_class == "private-tooling"' >/dev/null 2>&1 && return 0
  printf '%s' "$decision" | jq -e '.effective_class != "none" and (.effective_class|type=="string")' >/dev/null 2>&1 && return 1
  return 2
}

require_public_source() { # ROOT
  local rc=0
  source_is_private "$1" || rc=$?
  case "$rc" in
    0) die "private source requires explicit ensure-code-only export; ordinary review snapshot refused." ;;
    1) return 0 ;;
    *) die "source privacy classification unavailable; review snapshot refused." ;;
  esac
}

run_test_hook() { # deterministic hostile tests; never evaluates text from an environment variable
  local point="$1" root="$2" attempt="$3" hook="${AI_REVIEW_SANDBOX_TEST_HOOK:-}"
  [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "$hook" ] || return 0
  [ -x "$hook" ] || die "test hook is not executable: $hook"
  "$hook" "$point" "$root" "$attempt"
}

copy_untracked() { # copy_untracked SRC DST — reproduce untracked-but-not-ignored files
  local src="$1" dst="$2" rel list
  list="$(mktemp)"
  git -C "$src" ls-files --others --exclude-standard -z > "$list" \
    || { rm -f "$list"; return 1; }
  # An untracked link is not self-contained: even an in-repository absolute
  # target would still point back into the live checkout after cp -P. Refuse
  # every untracked link before copying anything. Tracked links remain exactly
  # as committed and are visible in the review diff.
  while IFS= read -r -d '' rel; do
    [ -L "$src/$rel" ] || continue
    rm -f "$list"
    die "refusing untracked link in review snapshot: $rel"
  done < "$list"
  while IFS= read -r -d '' rel; do
    [ -n "$rel" ] || continue
    # Evidence packets are session-owned generated state. A fresh snapshot must
    # build its own packet and must never copy another live review's packet.
    if generated_review_path "$src" "$rel"; then continue; fi
    [ "${AI_DEVOPS_TEST_MODE:-0}:${AI_REVIEW_SANDBOX_TEST_FAIL_COPY:-}" != "1:$rel" ] \
      || { rm -f "$list"; return 1; }
    mkdir -p "$dst/$(dirname "$rel")" || { rm -f "$list"; return 1; }
    cp -Pp "$src/$rel" "$dst/$rel" 2>/dev/null || { rm -f "$list"; return 1; }
    test_progress || { rm -f "$list"; return 1; }
  done < "$list"
  rm -f "$list"
}

validate_snapshot_links() { # validate_snapshot_links STAGE
  local stage="$1" stage_root link resolved
  stage_root="$(canon "$stage")"
  while IFS= read -r -d '' link; do
    resolved="$(readlink -f "$link" 2>/dev/null || true)"
    case "$resolved" in "$stage_root"/*) ;; *) die "refusing link that escapes review snapshot: ${link#"$stage"/}" ;; esac
  done < <(find "$stage" -path "$stage/.git" -prune -o -type l -print0 2>/dev/null)
}

# --- bounded snapshot construction (issue #711) ------------------------------
#
# A snapshot needs exactly the ancestry the evidence tools read back inside it:
# HEAD's tree (checkout), each carried base ref's tip tree (packet diff), the
# fork point and the connecting commit chains (packet merge-base, `log -1`),
# and HEAD~1 (the packet's no-base fallback). Everything older is dead weight —
# full history is what made 3,950 leftover copies occupy ~192 GB.

source_url() { # source_url ROOT -> file:// URL for the local smart transport
  case "$(uname -s)" in
    CYGWIN*|MINGW*|MSYS*) printf 'file:///%s' "$(cygpath -m "$1")" ;;
    *) printf 'file://%s' "$1" ;;
  esac
}

copy_source_behavior_config() { # copy_source_behavior_config SRC BUILD
  # A local `git clone` copied the source's repo-local config, and the
  # checked-out bytes depend on it (core.autocrlf, eol, filter drivers). An
  # init+fetch build must reproduce those settings or the snapshot's working
  # tree stops matching the source digest. Remotes are deliberately NOT
  # copied: the old flow removed origin but left every other remote behind,
  # while this build starts with none — strictly less exposure.
  local src="$1" dst="$2" line key value
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="${line%% *}"; value="${line#"$key"}"; value="${value# }"
    case "$key" in core.bare|core.worktree) continue ;; esac
    git -C "$dst" config "$key" "$value" 2>/dev/null || true
  done < <(git -C "$src" config --local --get-regexp '^(core|filter|user)\.' 2>/dev/null || true)
}

# Filled by plan_snapshot: parallel arrays — ref path in the snapshot ("" for a
# SHA-only want), pinned tip SHA, and the fork point proven in the source —
# plus the measured fetch depth. plan_snapshot must NEVER be called inside a
# command substitution: the subshell would throw all of this state away and
# the build would fetch nothing (the trap source_digest already avoids for the
# same reason).
SNAP_REFNAMES=() SNAP_REFTIPS=() SNAP_FORKS=() SNAP_DEPTH=5
plan_snapshot() { # plan_snapshot ROOT HEAD -> sets SNAP_* arrays and SNAP_DEPTH
  local root="$1" head="$2" want tip fork m n chain i
  SNAP_REFNAMES=(); SNAP_REFTIPS=(); SNAP_FORKS=(); SNAP_DEPTH=5
  # The explicit hint first: an explicitly requested comparison outranks every
  # default candidate, exactly as the packet resolver orders them.
  if [ -n "$BASE_HINT" ]; then
    tip="$(git -C "$root" rev-parse --verify --quiet "$BASE_HINT^{commit}" 2>/dev/null || true)"
    if [ -z "$tip" ]; then
      warn "ignoring AI_REVIEW_SANDBOX_BASE='$BASE_HINT': it does not resolve in $root"
    else
      fork="$(git -C "$root" merge-base "$head" "$tip" 2>/dev/null || true)"
      if [[ "$BASE_HINT" =~ ^[0-9a-f]{40}$ ]] || [[ "$BASE_HINT" == HEAD* ]]; then
        # A raw SHA or HEAD~N spelling has no ref to recreate; fetching the
        # object is enough for the packet's rev-parse of the same spelling.
        SNAP_REFNAMES+=(""); SNAP_REFTIPS+=("$tip"); SNAP_FORKS+=("$fork")
      else
        case "$BASE_HINT" in
          refs/*) m="$BASE_HINT" ;;
          */*)    m="refs/remotes/$BASE_HINT" ;;
          *)      m="refs/heads/$BASE_HINT" ;;
        esac
        SNAP_REFNAMES+=("$m"); SNAP_REFTIPS+=("$tip"); SNAP_FORKS+=("$fork")
      fi
    fi
  fi
  for want in origin/main origin/master main master; do
    tip="$(git -C "$root" rev-parse --verify --quiet "$want^{commit}" 2>/dev/null || true)"
    [ -n "$tip" ] || continue
    case "$want" in origin/*) m="refs/remotes/$want" ;; *) m="refs/heads/$want" ;; esac
    for i in "${!SNAP_REFNAMES[@]}"; do [ "${SNAP_REFNAMES[$i]}" = "$m" ] && continue 2; done
    fork="$(git -C "$root" merge-base "$head" "$tip" 2>/dev/null || true)"
    # An unrelated candidate is skipped: the packet resolver skips it too (no
    # merge-base means it can never be the comparison base), so resolution in
    # the snapshot stays identical to resolution in the source.
    [ -n "$fork" ] || continue
    SNAP_REFNAMES+=("$m"); SNAP_REFTIPS+=("$tip"); SNAP_FORKS+=("$fork")
  done
  for i in "${!SNAP_FORKS[@]}"; do
    [ -n "${SNAP_FORKS[$i]}" ] || continue
    chain="$(git -C "$root" rev-list --count "${SNAP_FORKS[$i]}..$head" 2>/dev/null || echo 0)"
    n="$(git -C "$root" rev-list --count "${SNAP_FORKS[$i]}..${SNAP_REFTIPS[$i]}" 2>/dev/null || echo 0)"
    [ "$n" -gt "$chain" ] && chain="$n"
    [ "$(( chain + 5 ))" -gt "$SNAP_DEPTH" ] && SNAP_DEPTH="$(( chain + 5 ))"
  done
}

build_snapshot() { # build_snapshot ROOT TAG BUILD DIGEST ATTEMPT
  local root="$1" tag="$2" build="$3" before="$4" attempt="$5"
  local head refspecs=() i carry probe
  head="$(git -C "$root" rev-parse HEAD 2>/dev/null)" \
    || die "worktree $root has no commits yet; there is nothing to snapshot."
  plan_snapshot "$root" "$head"
  # The review head comes first and unconditionally: a linked worktree checked
  # out on a topic branch is on none of the candidate base refs, and without
  # this want the checkout below has nothing to detach at.
  refspecs=("$head")
  for i in "${!SNAP_REFTIPS[@]}"; do
    if [ -n "${SNAP_REFNAMES[$i]}" ]; then
      refspecs+=("+${SNAP_REFTIPS[$i]}:${SNAP_REFNAMES[$i]}")
    else
      refspecs+=("${SNAP_REFTIPS[$i]}")
    fi
  done

  git -c core.longpaths=true init -q "$build" || return 1
  # Park the unborn HEAD on a process-unique branch: fetching a candidate ref
  # into the branch HEAD points at is refused by git, and the default branch
  # name (main/master) is exactly what the candidates are. The name is never
  # fetched into and vanishes when HEAD is detached below.
  git -C "$build" symbolic-ref HEAD "refs/heads/snapshot-workspace-$$" || return 1
  copy_source_behavior_config "$root" "$build"
  # SHA-pinned wants freeze every ref identity against concurrent commits — the
  # property the old captured-refs transaction provided — and
  # uploadpack.allowAnySHA1InWant covers a detached worktree HEAD that sits on
  # no ref at all.
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_REVIEW_SANDBOX_PROGRESS_FILE:-}" ]; then
    git -c core.longpaths=true -c uploadpack.allowAnySHA1InWant=true \
      -C "$build" fetch --progress --depth "$SNAP_DEPTH" --no-tags \
      "$(source_url "$root")" "${refspecs[@]}" 2>> "$AI_REVIEW_SANDBOX_PROGRESS_FILE" || return 1
  else
    git -c core.longpaths=true -c uploadpack.allowAnySHA1InWant=true \
      -C "$build" fetch --quiet --depth "$SNAP_DEPTH" --no-tags \
      "$(source_url "$root")" "${refspecs[@]}" 2>/dev/null || return 1
  fi
  run_test_hook after-clone "$root" "$attempt"
  printf '%s\nsource_digest=%s\nevidence_format=1\n' "$root" "$before" > "$build/$MARKER" || return 1
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_REVIEW_SANDBOX_PROGRESS_FILE:-}" ]; then
    git -C "$build" checkout --progress --detach "$head" \
      2>> "$AI_REVIEW_SANDBOX_PROGRESS_FILE" || return 1
  else
    git -C "$build" checkout --quiet --detach "$head" 2>/dev/null || return 1
  fi

  # Re-prove every frozen ref identity and fork inside the snapshot. A source
  # history rewrite mid-build would otherwise hand the packet a different
  # comparison than the one planned: refuse rather than publish evidence whose
  # scope silently moved.
  for i in "${!SNAP_REFTIPS[@]}"; do
    probe="${SNAP_REFNAMES[$i]}"
    [ -n "$probe" ] || probe="${SNAP_REFTIPS[$i]}"
    [ "$(git -C "$build" rev-parse --verify --quiet "${probe}^{commit}")" = "${SNAP_REFTIPS[$i]}" ] \
      || { warn "snapshot ref $probe is not at the captured tip; refusing."; return 1; }
    if [ -n "${SNAP_FORKS[$i]}" ]; then
      [ "$(git -C "$build" merge-base "$head" "$probe" 2>/dev/null || true)" = "${SNAP_FORKS[$i]}" ] \
        || { warn "snapshot merge-base for $probe moved against the plan; refusing."; return 1; }
    fi
  done

  # Uncommitted edits, then untracked files: together these make the snapshot
  # byte-identical to what a human sees in the worktree.
  carry="$(mktemp)"
  if [ "${AI_DEVOPS_TEST_MODE:-0}:${AI_REVIEW_SANDBOX_TEST_FAIL_DIFF:-0}" = 1:1 ]; then
    rm -f "$carry"; return 1
  fi
  git -C "$root" diff HEAD --binary > "$carry" 2>/dev/null \
    || { rm -f "$carry"; return 1; }
  if [ -s "$carry" ]; then
    git -C "$build" apply "$carry" 2>/dev/null \
      || { rm -f "$carry"; return 1; }
  fi
  rm -f "$carry"
  copy_untracked "$root" "$build" || return 1
  validate_snapshot_links "$build"
  run_test_hook after-copy "$root" "$attempt"

  printf '%s\n' "$MARKER" >> "$build/.git/info/exclude"
  printf 'AI-REVIEW-SANDBOX.md\n' >> "$build/.git/info/exclude"
  # Windows PowerShell drops its module-analysis cache into the CURRENT DIRECTORY
  # when it cannot resolve LocalApplicationData, which is what a reviewer's stripped
  # environment produces. That file is a Windows tool cache, not repository content,
  # but an untracked file is an untracked file: the read-only guard read it as the
  # reviewer editing the tree and discarded four completed reviews. Exclude that one
  # path so a tool cache cannot masquerade as a reviewer edit. Every tracked file and
  # every other untracked file is still compared.
  printf '/Microsoft/Windows/PowerShell/ModuleAnalysisCache\n' >> "$build/.git/info/exclude"
  cat > "$build/AI-REVIEW-SANDBOX.md" <<EOF
# Review snapshot — not the working copy

This directory is a disposable, self-contained snapshot of:

    $root

That path is a linked Git worktree, so its Git control files live outside any
single-directory review boundary. Reviewing it directly fails before any code is
read. This snapshot carries its own \`.git/\` with BOUNDED history — a shallow
fetch covering exactly the change under review, its base branch, and the commits
between them — is checked out at \`$head\`, and reproduces the worktree's
uncommitted edits and untracked files. Repository history older than the change
under review may be absent.

Review the code here as if it were the real worktree. Do not commit, push, or
treat this path as the source of truth: it is rebuilt on demand and deleted when
the review session ends. Refer to files by their path relative to this directory
(that path is identical in the real worktree).

Snapshot tag: $tag
Source digest: $before
EOF
}

# The EXIT trap fires after create_or_refresh's frame is gone (die exits the
# whole script), where its locals are unbound and `set -u` aborts the trap
# before the lock is released. Cleanup state therefore lives in globals that
# outlast the function, and remove_partial runs in a subshell so its own die
# cannot skip the lock release.
SNAPSHOT_LOCK="" SNAPSHOT_STAGE="" SNAPSHOT_BUILD=""
cleanup_snapshot() {
  if [ -n "$SNAPSHOT_BUILD" ]; then ( remove_partial "$SNAPSHOT_BUILD" "$SNAPSHOT_STAGE" ) || true; fi
  if [ -n "$SNAPSHOT_LOCK" ]; then rmdir "$SNAPSHOT_LOCK" 2>/dev/null || true; fi
  SNAPSHOT_LOCK="" SNAPSHOT_BUILD=""
}

create_or_refresh() { # create_or_refresh ROOT TAG STAGE
  local root="$1" tag="$2" stage="$3" lock="$3.lock" before after attempt
  mkdir -p "$SANDBOX_DIR"
  mkdir "$lock" 2>/dev/null || die "snapshot is already being built for tag '$tag': $lock"
  SNAPSHOT_LOCK="$lock" SNAPSHOT_STAGE="$stage" SNAPSHOT_BUILD=""
  trap cleanup_snapshot EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  for attempt in 1 2; do
    before="$(source_digest "$root")"
    SNAPSHOT_BUILD="$stage.building.$$.$attempt"
    [ ! -e "$SNAPSHOT_BUILD" ] || die "partial snapshot path already exists: $SNAPSHOT_BUILD"
    if ! build_snapshot "$root" "$tag" "$SNAPSHOT_BUILD" "$before" "$attempt"; then
      remove_partial "$SNAPSHOT_BUILD" "$stage"; SNAPSHOT_BUILD=""
      die "could not build a complete review snapshot; no partial evidence was published."
    fi
    # OpenCode names a project by origin URL, else the cached .git/opencode,
    # else the root commit. Snapshots have no origin, so every snapshot of one
    # repository would share a project and each server boot would rescan all
    # of them (issue #430). Pin an ID derived from the published path: unique
    # per snapshot, and unchanged when refresh-copy rebuilds the same path.
    printf 'ai-review-sandbox:%s' "$stage" | git hash-object --stdin > "$SNAPSHOT_BUILD/.git/opencode" || {
      remove_partial "$SNAPSHOT_BUILD" "$stage"; SNAPSHOT_BUILD=""
      die "could not record the snapshot's reviewer project identity."
    }
    after="$(source_digest "$root")"
    if [ "$before" = "$after" ]; then
      if [ -e "$stage" ]; then remove_sandbox "$stage"; fi
      mv "$SNAPSHOT_BUILD" "$stage" || die "could not publish the complete review snapshot."
      SNAPSHOT_BUILD=""
      cleanup_snapshot
      trap - EXIT INT TERM
      return 0
    fi
    remove_partial "$SNAPSHOT_BUILD" "$stage"; SNAPSHOT_BUILD=""
    [ "$attempt" -lt 2 ] || die "source changed during both snapshot attempts; review stopped without publishing mixed evidence."
  done
}

cmd_ensure() {
  local root tag stage force_copy="${3:-0}"
  root="$(canon "${1:?usage: ai-review-sandbox ensure <repo-root> <tag>}")"
  tag="${2:?usage: ai-review-sandbox ensure <repo-root> <tag>}"
  valid_tag "$tag" || die "invalid tag '$tag' (use letters, numbers, . _ -)"
  if [ -f "$root/$MARKER" ] && grep -q '"mode": "code-only"' "$root/$MARKER"; then
    [ "$force_copy" = 1 ] || { cmd_verify_code_only "$root"; printf '%s' "$root"; return 0; }
    cmd_clone_code_only "$root" "$tag"
    return 0
  fi
  require_public_source "$root"
  if [ "$force_copy" != 1 ] && ! is_worktree "$root"; then printf '%s' "$root"; return 0; fi
  mkdir -p "$SANDBOX_DIR"
  stage="$(sandbox_path "$root" "$tag")"
  create_or_refresh "$root" "$tag" "$stage"
  printf '%s' "$stage"
}

cmd_clone_code_only() {
  local root="$1" tag="$2" stage build python
  python="$(command -v python3 || command -v python)" || die "Python is required for code-only export."
  "$python" "$SCRIPT_DIR/ai-review-code-only.py" verify "$root" >/dev/null \
    || die "code-only source export is stale."
  mkdir -p "$SANDBOX_DIR"
  stage="$(sandbox_path "$root" "$tag")"
  [ ! -e "$stage" ] || die "code-only snapshot tag already exists."
  build="$stage.building.$$"
  if ! "$python" "$SCRIPT_DIR/ai-review-code-only.py" clone "$root" "$build"; then
    [ ! -e "$build" ] || rm -rf -- "$build"
    rm -f -- "$build.source.json"
    rm -f -- "$build.owners.json"
    die "could not clone sanitized code-only export."
  fi
  mv "$build" "$stage" || die "could not publish sanitized code-only clone."
  mv "$build.source.json" "$stage.source.json" || die "could not publish host-only source binding."
  mv "$build.owners.json" "$stage.owners.json" || die "could not publish host-only evidence ownership."
  cmd_verify_code_only "$stage"
  printf '%s' "$stage"
}

cmd_ensure_code_only() {
  local root tag stage paths python build base=""
  root="$(canon "${1:?usage: ensure-code-only <repo> <tag> --paths-file <JSON>}")"
  tag="${2:?usage: ensure-code-only <repo> <tag> --paths-file <JSON>}"
  [ "${3:-}" = --paths-file ] && [ -f "${4:-}" ] \
    || die "usage: ensure-code-only <repo> <tag> --paths-file <JSON> [--base REF]"
  if [ "$#" -eq 6 ] && [ "$5" = --base ]; then base="$6"
  elif [ "$#" -ne 4 ]; then die "usage: ensure-code-only <repo> <tag> --paths-file <JSON> [--base REF]"; fi
  paths="$(canon "$(dirname "$4")")/$(basename "$4")"
  valid_tag "$tag" || die "invalid tag '$tag'"
  python="$(command -v python3 || command -v python)" || die "Python is required for code-only export."
  mkdir -p "$SANDBOX_DIR"
  stage="$(sandbox_path "$root" "$tag")"
  [ ! -e "$stage" ] || die "code-only export tag already exists; use a fresh tag."
  build="$stage.building.$$"
  [ ! -e "$build" ] || die "partial code-only export already exists."
  local create_args=(create "$root" "$build" "$paths")
  [ -z "$base" ] || create_args+=(--base "$base")
  if ! "$python" "$SCRIPT_DIR/ai-review-code-only.py" "${create_args[@]}"; then
    [ ! -e "$build" ] || rm -rf -- "$build"
    rm -f -- "$build.source.json"
    rm -f -- "$build.owners.json"
    die "code-only export failed; no reviewer directory was published."
  fi
  mv "$build" "$stage" || die "could not publish code-only export."
  mv "$build.source.json" "$stage.source.json" || die "could not publish host-only source binding."
  mv "$build.owners.json" "$stage.owners.json" || die "could not publish host-only evidence ownership."
  "$python" "$SCRIPT_DIR/ai-review-code-only.py" verify "$stage" >/dev/null \
    || die "published code-only export failed verification."
  printf '%s' "$stage"
}

cmd_remove_code_only() {
  local stage python sandbox_root
  stage="$(canon "${1:?usage: remove-code-only <snapshot>}")"
  [ "$#" -eq 1 ] || die "usage: remove-code-only <snapshot>"
  sandbox_root="$(canon "$SANDBOX_DIR")"
  case "$stage" in "$sandbox_root"/*) ;; *) die "code-only export is outside managed storage." ;; esac
  python="$(command -v python3 || command -v python)" || die "Python is required for code-only removal."
  "$python" "$SCRIPT_DIR/ai-review-code-only.py" verify "$stage" >/dev/null \
    || die "code-only export could not be verified; retained for recovery."
  remove_sandbox "$stage"
  [ ! -e "$stage" ] || die "code-only snapshot retained after cleanup failure."
  rm -f -- "$stage.source.json" "$stage.owners.json"
}

cmd_verify_code_only() {
  local stage python
  stage="$(canon "${1:?usage: verify-code-only <snapshot> [--assert-head SHA]}")"; shift
  python="$(command -v python3 || command -v python)" || die "Python is required for code-only verification."
  "$python" "$SCRIPT_DIR/ai-review-code-only.py" verify "$stage" "$@" >/dev/null
}

# Phase 2 self-cleanup: the creating run deletes its snapshot before returning.
# `with-copy` owns the full create → use → delete lifecycle in one process so an
# EXIT/INT/TERM trap is guaranteed. The wrapped command sees the snapshot path
# in AI_REVIEW_SNAPSHOT (and as the first argument after --, when one is given).
WITH_COPY_SNAP="" WITH_COPY_ROOT="" WITH_COPY_TAG=""
with_copy_cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  if [ -n "$WITH_COPY_SNAP" ]; then
    # remove_sandbox is path-guarded and idempotent; never rm -rf a free path.
    ( remove_sandbox "$WITH_COPY_SNAP" ) || true
    WITH_COPY_SNAP=""
  fi
  return "$rc"
}
cmd_with_copy() { # with-copy ROOT TAG -- COMMAND [ARGS...]
  local root tag stage cmd_rc=0
  root="${1:?usage: ai-review-sandbox with-copy <repo-root> <tag> -- <command>...}"
  tag="${2:?usage: ai-review-sandbox with-copy <repo-root> <tag> -- <command>...}"
  shift 2
  [ "${1:-}" = -- ] || die "usage: ai-review-sandbox with-copy <repo-root> <tag> -- <command>..."
  shift
  [ "$#" -ge 1 ] || die "usage: ai-review-sandbox with-copy <repo-root> <tag> -- <command>..."
  # Arm the trap BEFORE create so a signal cannot land between publish and
  # trap install. with_copy_cleanup no-ops while WITH_COPY_SNAP is empty.
  trap with_copy_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  stage="$(cmd_ensure "$root" "$tag" 1)" || die "could not create a disposable review snapshot for $root"
  WITH_COPY_SNAP="$stage" WITH_COPY_ROOT="$root" WITH_COPY_TAG="$tag"
  if [ "${AI_KEEP_SANDBOX:-0}" = 1 ]; then
    warn "AI_KEEP_SANDBOX=1: snapshot kept at $stage"
    export AI_REVIEW_SNAPSHOT="$stage"
    "$@" || cmd_rc=$?
    # Keep the snapshot; disarm trap so cleanup does not try to delete it.
    trap - EXIT INT TERM
    WITH_COPY_SNAP=""
    return "$cmd_rc"
  fi
  export AI_REVIEW_SNAPSHOT="$stage"
  "$@" || cmd_rc=$?
  # Explicit success-path delete; the trap covers aborts and early exits.
  ( remove_sandbox "$stage" ) || true
  WITH_COPY_SNAP=""
  trap - EXIT INT TERM
  return "$cmd_rc"
}

cmd_refresh_copy() { # refresh an exact, already-recorded directory for directory-bound reviewer sessions
  local root tag stage sandbox_root
  root="$(canon "${1:?usage: ai-review-sandbox refresh-copy <repo-root> <tag> <managed-copy>}")"
  tag="${2:?usage: ai-review-sandbox refresh-copy <repo-root> <tag> <managed-copy>}"
  stage="${3:?usage: ai-review-sandbox refresh-copy <repo-root> <tag> <managed-copy>}"
  valid_tag "$tag" || die "invalid tag '$tag' (use letters, numbers, . _ -)"
  require_public_source "$root"
  mkdir -p "$SANDBOX_DIR"; sandbox_root="$(canon "$SANDBOX_DIR")"; stage="$(canon "$stage")"
  case "$stage" in "$sandbox_root"/*) ;; *) die "refusing to refresh $stage: it is outside managed review storage." ;; esac
  is_managed "$stage" || die "refusing to refresh $stage: it is not a managed review snapshot."
  grep -Fqx "Snapshot tag: $tag" "$stage/AI-REVIEW-SANDBOX.md" 2>/dev/null \
    || die "refusing to refresh $stage: its recorded snapshot tag does not match '$tag'."
  create_or_refresh "$root" "$tag" "$stage"
  printf '%s' "$stage"
}

cmd_remove_recorded() {
  local tag stage sandbox_root
  tag="${1:?usage: ai-review-sandbox remove-recorded <tag> <managed-copy>}"
  stage="${2:?usage: ai-review-sandbox remove-recorded <tag> <managed-copy>}"
  valid_tag "$tag" || die "invalid tag '$tag' (use letters, numbers, . _ -)"
  [ -e "$stage" ] || return 0
  mkdir -p "$SANDBOX_DIR"; sandbox_root="$(canon "$SANDBOX_DIR")"; stage="$(canon "$stage")"
  case "$stage" in "$sandbox_root"/*) ;; *) die "refusing to remove $stage: it is outside managed review storage." ;; esac
  is_managed "$stage" || die "refusing to remove $stage: it is not a managed review snapshot."
  grep -Fqx "Snapshot tag: $tag" "$stage/AI-REVIEW-SANDBOX.md" 2>/dev/null \
    || die "refusing to remove $stage: its recorded snapshot tag does not match '$tag'."
  remove_sandbox "$stage"
}

cmd_path() {
  local root tag
  root="$(canon "${1:?usage: ai-review-sandbox path <repo-root> <tag>}")"
  tag="${2:?usage: ai-review-sandbox path <repo-root> <tag>}"
  valid_tag "$tag" || die "invalid tag '$tag'"
  if is_worktree "$root"; then printf '%s' "$(sandbox_path "$root" "$tag")"; else printf '%s' "$root"; fi
}

cmd_remove() {
  local root tag force_copy="${3:-0}"
  root="$(canon "${1:?usage: ai-review-sandbox remove <repo-root> <tag>}")"
  tag="${2:?usage: ai-review-sandbox remove <repo-root> <tag>}"
  valid_tag "$tag" || die "invalid tag '$tag'"
  [ "$force_copy" = 1 ] || is_worktree "$root" || return 0
  local stage="$(sandbox_path "$root" "$tag")"
  if [ -f "$stage/$MARKER" ] && grep -q '"mode": "code-only"' "$stage/$MARKER"; then
    cmd_remove_code_only "$stage"
  else
    remove_sandbox "$stage"
  fi
}

case "${1:-}" in
  ensure)      shift; cmd_ensure "$@" ;;
  ensure-copy) shift; cmd_ensure "${1:-}" "${2:-}" 1 ;;
  ensure-code-only) shift; cmd_ensure_code_only "$@" ;;
  verify-code-only) shift; cmd_verify_code_only "$@" ;;
  remove-code-only) shift; cmd_remove_code_only "$@" ;;
  assert-public) shift; require_public_source "$(canon "${1:?usage: assert-public <repo>}")" ;;
  is-private) shift; source_is_private "$(canon "${1:?usage: is-private <repo>}")" ;;
  refresh-copy) shift; cmd_refresh_copy "$@" ;;
  with-copy)   shift; cmd_with_copy "$@" ;;
  remove-recorded) shift; cmd_remove_recorded "$@" ;;
  path)        shift; cmd_path "$@" ;;
  remove)      shift; cmd_remove "$@" ;;
  remove-copy) shift; cmd_remove "${1:-}" "${2:-}" 1 ;;
  is-worktree) shift; is_worktree "$(canon "${1:?usage: ai-review-sandbox is-worktree <dir>}")" ;;
  digest)      shift; source_digest "$(canon "${1:?usage: ai-review-sandbox digest <dir>}")" ;;
  --version)   printf '%s\n' "$VERSION" ;;
  *) die "usage: ai-review-sandbox {ensure|ensure-copy|refresh-copy|with-copy|remove-recorded|path|remove|remove-copy|is-worktree|digest} ..." ;;
esac
