#!/usr/bin/env bash
# ai-pr-wait — wait for a pull request to reach a terminal outcome, and never
# wait forever on one that has already stopped moving.
#
# WHY THIS EXISTS. A session watching `gh pr view <n> --json state` in a loop is
# blind to the most common way a pull request stops progressing: a merge-queue
# run fails, GitHub ejects the pull request, and its state stays `OPEN`. On
# 2026-08-28 that cost roughly five hours of a session waiting on PR #142 while
# nothing at all was happening. A failing required check has the same shape —
# the pull request sits `OPEN` and no amount of waiting changes it.
#
# So do not hand-roll a wait loop. Use this. It exits on EVERY terminal outcome:
# merged, closed, a failed check, an ejection from the merge queue, or its own
# deadline. Silence from this command means the pull request is genuinely still
# moving.
#
# Usage:
#   ai-pr-wait <pr-number> --timeout-minutes N [--repo OWNER/NAME] [--interval SECONDS] [--api-timeout-seconds N] [--reviewer-approval REPORT]
#
# --timeout-minutes is required (explicit deadline only; #1183 child 3). There
# is no default: a waiter is never started without a deadline the caller named.
#
# A documentation-only change does not wait for checks. This command refuses to
# start a long wait for one, and says so, unless an assigned AI
# reviewer APPROVE of the exact head exists (a plan-review suffices) and you pass
# --reviewer-approval with that report.
#
# Exit status:
#   0  merged
#   1  stopped and will not merge on its own (closed, check failure, ejected)
#   2  deadline reached while still in progress
#   3  usage or environment error
set -uo pipefail

PR=''
REPO=''
TIMEOUT_MINUTES=''
INTERVAL=300
API_TIMEOUT_SECONDS=30
REVIEWER_APPROVAL=''

while [ $# -gt 0 ]; do
  case "$1" in
    --repo|--timeout-minutes|--interval|--api-timeout-seconds|--reviewer-approval)
      option="$1"
      [ $# -ge 2 ] && [ -n "$2" ] || { printf 'ai-pr-wait: %s requires a value\n' "$option" >&2; exit 3; }
      case "$option" in
        --repo) REPO="$2" ;;
        --timeout-minutes) TIMEOUT_MINUTES="$2" ;;
        --interval) INTERVAL="$2" ;;
        --api-timeout-seconds) API_TIMEOUT_SECONDS="$2" ;;
        --reviewer-approval) [ -f "$2" ] || { printf 'ai-pr-wait: --reviewer-approval needs an existing review report\n' >&2; exit 3; }; REVIEWER_APPROVAL="$(realpath -- "$2")" ;;
      esac
      shift 2
      ;;
    -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
    -*) printf 'ai-pr-wait: unknown option %s\n' "$1" >&2; exit 3 ;;
    *) PR="$1"; shift ;;
  esac
done

case "$PR" in
  ''|*[!0-9]*) printf 'ai-pr-wait: give a pull request number\n' >&2; exit 3 ;;
esac
case "$TIMEOUT_MINUTES" in
  '') printf 'ai-pr-wait: --timeout-minutes is required (explicit deadline only; no default)\n' >&2; exit 3 ;;
  0*|*[!0-9]*) printf 'ai-pr-wait: --timeout-minutes must be a positive whole number without leading zeros\n' >&2; exit 3 ;;
esac
case "$INTERVAL" in
  ''|0*|*[!0-9]*) printf 'ai-pr-wait: --interval must be a positive whole number without leading zeros\n' >&2; exit 3 ;;
esac
case "$API_TIMEOUT_SECONDS" in
  ''|0*|*[!0-9]*) printf 'ai-pr-wait: --api-timeout-seconds must be a positive whole number without leading zeros\n' >&2; exit 3 ;;
esac
command -v gh >/dev/null 2>&1 || { printf 'ai-pr-wait: gh is not installed\n' >&2; exit 3; }
command -v jq >/dev/null 2>&1 || { printf 'ai-pr-wait: jq is not installed\n' >&2; exit 3; }
GH_RUNNER="$(command -v gh)"
# GitHub waits poll at most every five minutes and every call goes through the
# machine-wide throttle (2026-09-15 secondary-limit incident, popcre/ai-devops#401).
# During a recorded back-off the throttle exits 75 at once rather than sleeping
# past the per-request timeout; the loop treats that as transient and waits.
if [ "$INTERVAL" -lt 300 ] && [ "${AI_DEVOPS_TEST_MODE:-0}" != 1 ]; then
  printf 'ai-pr-wait: --interval %ss raised to the 300-second GitHub wait minimum\n' "$INTERVAL" >&2
  INTERVAL=300
fi
THROTTLE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)/ai-gh"
GH_COST_READY=0
GH_COST_HELPER="$(dirname "$THROTTLE")/../tools/github-requests/telemetry.sh"
if [ -f "$GH_COST_HELPER" ]; then
  source "$GH_COST_HELPER"
  GH_COST_READY=1
fi
[ -x "$THROTTLE" ] || {
  printf 'ai-pr-wait: ai-gh throttle is missing; no GitHub call was made\n' >&2
  exit 3
}
export AI_GH_REAL_GH="${AI_GH_REAL_GH:-$GH_RUNNER}" AI_GH_NO_WAIT=1
if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ]; then
  if [ -z "${AI_GH_STATE_DIR:-}" ]; then
    AI_GH_STATE_DIR="$(mktemp -d)"; TMP_STATE_DIR="$AI_GH_STATE_DIR"
    trap 'rm -rf "$TMP_STATE_DIR"' EXIT
  fi
  export AI_GH_STATE_DIR AI_GH_MIN_SPACING_SECONDS="${AI_GH_MIN_SPACING_SECONDS:-0}" AI_GH_QUOTA_PROBE_SECONDS="${AI_GH_QUOTA_PROBE_SECONDS:-off}"
fi
GH_RUNNER="$THROTTLE"
# Allowance = the longest the throttle can spend before gh starts (lock wait +
# spacing). Without it the supervisor could kill a healthy call and leave the
# shared lock behind.
[ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && : "${AI_GH_NO_WAIT_LOCK_SECONDS:=1}"
export AI_GH_NO_WAIT_LOCK_SECONDS="${AI_GH_NO_WAIT_LOCK_SECONDS:-10}"
# lock wait + call spacing + the spacing the budget probe adds before the call
# + the time-limited budget probe made while holding the lock
[ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && : "${AI_GH_PROBE_TIMEOUT_SECONDS:=0}"
THROTTLE_ALLOWANCE_SECONDS=$(( AI_GH_NO_WAIT_LOCK_SECONDS + 2 * ${AI_GH_MIN_SPACING_SECONDS:-3} + ${AI_GH_PROBE_TIMEOUT_SECONDS:-15} ))
SUPERVISOR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-process-supervisor"
[ -x "$SUPERVISOR" ] || { printf 'ai-pr-wait: ai-process-supervisor is not installed\n' >&2; exit 3; }
PAGER_SCRIPT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)/tools/github-requests/pr-status-complete.sh"
[ -f "$PAGER_SCRIPT" ] || { printf 'ai-pr-wait: complete status reader is not installed\n' >&2; exit 3; }
BASH_RUNNER="$(command -v bash 2>/dev/null || true)"
[ -n "$BASH_RUNNER" ] || { printf 'ai-pr-wait: bash is not installed\n' >&2; exit 3; }
PYTHON_RUNNER=''
for candidate in python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1 || continue
  PYTHON_RUNNER="$(command -v "$candidate")"
  break
done
[ -n "$PYTHON_RUNNER" ] || { printf 'ai-pr-wait: Python 3.10 or newer is not installed\n' >&2; exit 3; }
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*)
    BASH_RUNNER="$(cygpath -w "$BASH_RUNNER")"
    GH_RUNNER="$(cygpath -w "$GH_RUNNER")"
    PYTHON_RUNNER="$(cygpath -w "$PYTHON_RUNNER")"
    SUPERVISOR="$(cygpath -w "$SUPERVISOR")"
    PAGER_SCRIPT="$(cygpath -w "$PAGER_SCRIPT")"
    ;;
esac

DEADLINE=$(( $(date +%s) + TIMEOUT_MINUTES * 60 ))
WAIT_STARTED_SECONDS=$SECONDS

bounded_gh() {
  local now remaining limit complete_status=0
  if [ "${1:-}" = --complete-status ]; then complete_status=1; shift; fi
  now="$(date +%s)"
  remaining=$(( DEADLINE - now ))
  # 125 means the overall deadline expired before any GitHub process started;
  # 124 remains the supervisor's genuine request-timeout result.
  [ "$remaining" -gt 0 ] || return 125
  # The throttle may spend a few seconds acquiring the shared lock or honouring
  # spacing before gh even starts; add that allowance so a healthy call is never
  # killed as hung (a kill would leave the shared lock behind).
  limit=$(( API_TIMEOUT_SECONDS + THROTTLE_ALLOWANCE_SECONDS ))
  [ "$complete_status" -eq 0 ] || limit="$remaining"
  [ "$limit" -le "$remaining" ] || limit="$remaining"
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_TRACE:-}" ]; then
    printf '%s\n' "$GH_RUNNER" > "$AI_PR_WAIT_TEST_TRACE.resolved"
  fi
  local -a command
  if [ "$complete_status" -eq 1 ]; then
    command=("$PYTHON_RUNNER" "$SUPERVISOR" --timeout-seconds "$limit" -- \
      "$BASH_RUNNER" -c 'runner="$1"; shift; command -v cygpath >/dev/null 2>&1 && runner="$(cygpath -u "$runner")"; exec "$runner" "$@"' bash \
      "$PAGER_SCRIPT" "$GH_RUNNER" "$PYTHON_RUNNER" "$SUPERVISOR" "$BASH_RUNNER" \
      "$OWNER" "$NAME" "$PR" "$DEADLINE" "$API_TIMEOUT_SECONDS" "$THROTTLE_ALLOWANCE_SECONDS" "$SNAP_SOURCE_ARG")
  else
    command=("$PYTHON_RUNNER" "$SUPERVISOR" --timeout-seconds "$limit" -- \
      "$BASH_RUNNER" -c 'runner="$1"; shift; command -v cygpath >/dev/null 2>&1 && runner="$(cygpath -u "$runner")"; if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_TRACE:-}" ]; then printf "%s\n" "$runner" > "$AI_PR_WAIT_TEST_TRACE.child"; fi; exec "$runner" "$@"' bash "$GH_RUNNER" "$@")
  fi
  if [ -n "${SNAP_CONTEXT:-}" ] && [ "$complete_status" -eq 1 ]; then
    local force=()
    local expected_head="${LAST_HEAD:-any}"
    local cache_target="${LAST_HEAD:-discover}"
    # A waiter that has seen queue membership must validate a possible
    # ejection freshly; its own history cannot be delegated to another waiter.
    [ "$WAS_QUEUED" -eq 0 ] || force=(--force-refresh)
    AI_GH_CALLER=ai-pr-wait AI_GH_COST_CONTEXT="${SNAP_CONTEXT:-}" "$PYTHON_RUNNER" "$SNAP_HELPER_ARG" \
      --state-dir "$SNAP_STATE_ARG" --key "v3 $SNAP_CONTEXT $REPO $PR $cache_target" \
      --expected-head "$expected_head" --ttl 10 --wait-seconds "$limit" --cap-supervisor-timeout --defer-source-mark \
      --age-file "$SNAP_AGE_ARG" --source-file "$SNAP_SOURCE_ARG" "${force[@]+"${force[@]}"}" -- "${command[@]}"
  else
    AI_GH_CALLER=ai-pr-wait AI_GH_COST_CONTEXT="${SNAP_CONTEXT:-}" "${command[@]}"
  fi
}

if [ -z "$REPO" ]; then
  REPO="$(bounded_gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)"
  [ -n "$REPO" ] || { printf 'ai-pr-wait: cannot determine the repository; pass --repo\n' >&2; exit 3; }
fi
# Nothing has been waited on yet, so this is the cheapest possible place to
# refuse a wait the change set does not call for.
PR_WAIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# bin/* is symlinked onto PATH, so resolve the real script location before
# looking for the repository's own files; $SCRIPT_DIR is the symlink directory.
REAL_DIR="$PR_WAIT_DIR"
if command -v readlink >/dev/null 2>&1; then
  REAL_DIR_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -z "$REAL_DIR_SOURCE" ] || REAL_DIR="$(cd "$(dirname "$REAL_DIR_SOURCE")" && pwd)"
fi
GATE_LIB=""
for candidate in "$REAL_DIR/.." "$PR_WAIT_DIR/.."; do
  [ -f "$candidate/tools/lib/task-gates.sh" ] || continue
  GATE_LIB="$(cd "$candidate" && pwd)/tools/lib/task-gates.sh"
  break
done
[ -n "$GATE_LIB" ] || { printf 'ai-pr-wait: cannot find the task-gate library; no wait was started.\n' >&2; exit 3; }
if [ -n "$GATE_LIB" ]; then
  # shellcheck source=../tools/lib/task-gates.sh
  . "$GATE_LIB"
  gate_args=()
  [ -z "$REVIEWER_APPROVAL" ] || gate_args=(--reviewer-approval "$REVIEWER_APPROVAL")
  if ! tg_preflight_gate pr-wait "${gate_args[@]+"${gate_args[@]}"}"; then
    # The gate has already said why. Only add the admin-merge shortcut when the
    # change set really is prose; after a class escalation it is wrong advice,
    # and it would be the last line the caller reads.
    GATE_BIN="$(cd "$(dirname "$GATE_LIB")/../../bin" 2>/dev/null && pwd)/ai-task-gates"
    OBSERVED=""
    [ -x "$GATE_BIN" ] && OBSERVED="$("$GATE_BIN" explain --json 2>/dev/null | jq -r '.observed_class // empty' 2>/dev/null | tr -d '\r')"
    if [ "$OBSERVED" = prose ]; then
      # The immediate squash-admin lane skips the offline suites, so its own
      # doc content is never checked anywhere else (#1188). Prove the two
      # whole-repo doc invariants on this tree before offering the shortcut;
      # a refusal here is the fix point, not a reason to wait.
      DOC_SAFETY_BIN="$REAL_DIR/ai-doc-safety"
      DOC_SAFETY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      if [ ! -f "$DOC_SAFETY_BIN" ] || [ -z "$DOC_SAFETY_ROOT" ]; then
        printf 'ai-pr-wait: run `bin/ai-doc-safety` on the exact head worktree before `gh pr merge --squash --admin`; no wait was started.\n' >&2
      elif DOC_SAFETY_OUT="$(bash "$DOC_SAFETY_BIN" "$DOC_SAFETY_ROOT" 2>&1)"; then
        printf 'ai-pr-wait: doc-safety passed on this tree; a documentation-only pull request merges immediately with `gh pr merge --squash --admin`; no wait was started.\n' >&2
      else
        printf 'ai-pr-wait: doc-safety FAILED on this tree; fix the named file before `gh pr merge --squash --admin`:\n%s\nno wait was started.\n' "$DOC_SAFETY_OUT" >&2
      fi
    else
      printf 'ai-pr-wait: no wait was started.\n' >&2
    fi
    exit 3
  fi
fi
OWNER="${REPO%%/*}"
NAME="${REPO##*/}"
SNAP_HELPER="$REAL_DIR/../tools/github-requests/pr_status_singleflight.py"
SNAP_CONTEXT_HELPER=''
SNAP_DEFAULT_DIR="$HOME/.local/state/ai-devops-pr-status"
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*) SNAP_DEFAULT_DIR="$HOME/.ai-devops/pr-status" ;;
esac
SNAP_STATE_DIR="${AI_PR_WAIT_SNAPSHOT_DIR:-$SNAP_DEFAULT_DIR}"
SNAP_CONTEXT=''
LAST_HEAD=''
# The credential-bound read-only context helper is added after P2 lands. Until
# then, sharing is disabled. Test fixtures can supply an opaque context key.
if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_CONTEXT_KEY:-}" ]; then
  SNAP_CONTEXT="$AI_PR_WAIT_TEST_CONTEXT_KEY"
elif [ -x "$REAL_DIR/../tools/github-requests/pr-status-context" ]; then
  SNAP_CONTEXT_HELPER="$REAL_DIR/../tools/github-requests/pr-status-context"
  SNAP_CONTEXT="$("$SNAP_CONTEXT_HELPER" 2>/dev/null || true)"
fi
SNAP_AGE_FILE="$(mktemp "${TMPDIR:-/tmp}/ai-pr-wait-age.XXXXXX")" || exit 3
SNAP_SOURCE_FILE="$(mktemp "${TMPDIR:-/tmp}/ai-pr-wait-source.XXXXXX")" || exit 3
SNAP_HELPER_ARG="$SNAP_HELPER"
SNAP_STATE_ARG="$SNAP_STATE_DIR"
SNAP_AGE_ARG="$SNAP_AGE_FILE"
SNAP_SOURCE_ARG="$SNAP_SOURCE_FILE"
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*)
    SNAP_HELPER_ARG="$(cygpath -w "$SNAP_HELPER")"
    SNAP_STATE_ARG="$(cygpath -w "$SNAP_STATE_DIR")"
    SNAP_AGE_ARG="$(cygpath -w "$SNAP_AGE_FILE")"
    SNAP_SOURCE_ARG="$(cygpath -w "$SNAP_SOURCE_FILE")"
    ;;
esac

say() {
  local rc
  printf '%s\n' "$*"; rc=$?
  if [ "$rc" -ne 0 ] && [ "${PR_WAIT_DELIVERY_BOUNDARY:-unknown}" = terminal_report ]; then PR_WAIT_REPORT_FAILED=1; fi
  if [ "$rc" -ne 0 ] && [ -n "${PR_WAIT_OUTCOME:-}" ]; then PR_WAIT_LOCAL_OUTPUT_FAILED=1; fi
  return "$rc"
}

WAS_QUEUED=0
QUEUED_HEAD=''
LAST=''
API_STDERR=/dev/null
if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_TRACE:-}" ]; then
  API_STDERR="$AI_PR_WAIT_TEST_TRACE.stderr"
else
  API_STDERR="$(mktemp "${TMPDIR:-/tmp}/ai-pr-wait-stderr.XXXXXX")" || {
    printf 'ai-pr-wait: could not create diagnostic file\n' >&2
    exit 3
  }
fi
cleanup_wait_files() {
  rm -f "$SNAP_AGE_FILE"
  rm -f "$SNAP_SOURCE_FILE"
  [ "$API_STDERR" = /dev/null ] || { [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_TRACE:-}" ]; } || rm -f "$API_STDERR"
  [ -z "${TMP_STATE_DIR:-}" ] || rm -rf "$TMP_STATE_DIR"
}
trap cleanup_wait_files EXIT

PR_WAIT_RECEIPT_ID=''
PR_WAIT_OUTCOME=''
PR_WAIT_STARTED_MS=''
PR_WAIT_EVENT_KIND=unknown
PR_WAIT_ELIGIBLE_UTC_MS=''
PR_WAIT_OBSERVED_UTC_MS=''
PR_WAIT_DELIVERED_UTC_MS=''
PR_WAIT_SOURCE_VERIFIED=unknown
PR_WAIT_CLOCK_QUALITY=unknown
PR_WAIT_DELIVERY_BOUNDARY=unknown
PR_WAIT_REPORT_FAILED=0
PR_WAIT_LOCAL_OUTPUT_FAILED=0
PR_WAIT_LOCAL_START_MS=''
PR_WAIT_LOCAL_END_MS=''
PR_WAIT_LOCAL_CLOCK_BASIS=unknown
capture_local_end(){
  [ "$GH_COST_READY" = 1 ] || return 0
  [ -n "$PR_WAIT_RECEIPT_ID" ] || return 0
  [ "$PR_WAIT_LOCAL_OUTPUT_FAILED" -ne 0 ] && return 0
  gh_measure_local_clock
  PR_WAIT_LOCAL_END_MS="${GH_MEASURE_LOCAL_CLOCK_MS:-}"
}
emit_workflow_evidence(){
  [ "$GH_COST_READY" = 1 ] || return 0
  if [ "$PR_WAIT_REPORT_FAILED" != 0 ]; then PR_WAIT_DELIVERY_BOUNDARY=unknown; PR_WAIT_DELIVERED_UTC_MS=''; fi
  gh_measure_source_bookend
  gh_measure_workflow_evidence ai-pr-wait pr_wait "$PR_WAIT_RECEIPT_ID" ||
    printf 'ai-pr-wait: request measurement unavailable: workflow evidence not saved\n' >&2
}
set_event_evidence(){
  PR_WAIT_EVENT_KIND=unknown; PR_WAIT_ELIGIBLE_UTC_MS=''
  local iso candidate converted valid
  iso_ms(){
    local value="${1:-}" seconds roundtrip
    [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 0
    seconds="$(date -u -d "$value" +%s 2>/dev/null)" || return 0
    roundtrip="$(date -u -d "@$seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    [ "$roundtrip" = "$value" ] || return 0
    [ "$seconds" -ge 0 ] || return 0
    printf '%s000' "$seconds"
  }
  case "${1:-}" in
    MERGED) PR_WAIT_EVENT_KIND=pr_merged; iso="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.mergedAt // empty')"; PR_WAIT_ELIGIBLE_UTC_MS="$(iso_ms "$iso")"; [ -n "$PR_WAIT_ELIGIBLE_UTC_MS" ] || PR_WAIT_EVENT_KIND=unknown ;;
    CLOSED) PR_WAIT_EVENT_KIND=pr_closed; iso="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.closedAt // empty')"; PR_WAIT_ELIGIBLE_UTC_MS="$(iso_ms "$iso")"; [ -n "$PR_WAIT_ELIGIBLE_UTC_MS" ] || PR_WAIT_EVENT_KIND=unknown ;;
    CHECKS)
      iso="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest as $pr | $pr.commits.nodes[0].commit as $commit | [$commit.statusCheckRollup.contexts.nodes[]?] as $c | ([ $c[] | select((.conclusion=="FAILURE" or .conclusion=="TIMED_OUT" or (.conclusion=="CANCELLED" and (.isRequired != false or ($pr.headRefOid | type) != "string" or $pr.headRefOid == "" or $commit.oid != $pr.headRefOid)))) | .completedAt]) as $f | if (any($c[]; ((.conclusion==null) and (.state=="FAILURE" or .state=="ERROR"))) or ($f|length == 0) or ([ $f[] | type ] | any(. != "string"))) then empty else $f[] end')"
      valid=1
      [ -n "$iso" ] || valid=0
      while IFS= read -r candidate; do
        converted="$(iso_ms "$candidate")"
        if [[ ! "$converted" =~ ^[0-9]{1,13}$ ]] ||
          { [[ "${PR_WAIT_OBSERVED_UTC_MS:-}" =~ ^[0-9]{1,13}$ ]] && [ "$converted" -gt "$PR_WAIT_OBSERVED_UTC_MS" ]; }; then valid=0; break; fi
        if [ -z "$PR_WAIT_ELIGIBLE_UTC_MS" ] || [ "$converted" -lt "$PR_WAIT_ELIGIBLE_UTC_MS" ]; then PR_WAIT_ELIGIBLE_UTC_MS="$converted"; fi
      done <<< "$iso"
      if [ "$valid" = 1 ]; then PR_WAIT_EVENT_KIND=check_completed; else PR_WAIT_ELIGIBLE_UTC_MS=''; fi
      ;;
  esac
  [ -n "$PR_WAIT_ELIGIBLE_UTC_MS" ] || PR_WAIT_EVENT_KIND=unknown
  if [[ "$PR_WAIT_ELIGIBLE_UTC_MS" =~ ^[0-9]{1,13}$ ]] && [[ "${PR_WAIT_OBSERVED_UTC_MS:-}" =~ ^[0-9]{1,13}$ ]] && [ "$PR_WAIT_ELIGIBLE_UTC_MS" -gt "$PR_WAIT_OBSERVED_UTC_MS" ]; then
    PR_WAIT_EVENT_KIND=unknown; PR_WAIT_ELIGIBLE_UTC_MS=''
  fi
}
if [ "$GH_COST_READY" = 1 ]; then
  gh_measure_source_bookend
  PR_WAIT_RECEIPT_ID="$(gh_measure_workflow_id)" ||
    printf 'ai-pr-wait: request measurement unavailable: workflow ID not created\n' >&2
  gh_measure_clock; PR_WAIT_STARTED_MS="$GH_MEASURE_CLOCK"
  gh_measure_local_clock
  PR_WAIT_LOCAL_START_MS="${GH_MEASURE_LOCAL_CLOCK_MS:-}"
  PR_WAIT_LOCAL_CLOCK_BASIS="${GH_MEASURE_LOCAL_CLOCK_BASIS:-unknown}"
fi
export PR_WAIT_RECEIPT_ID
pr_wait_cleanup(){
  local rc=$? elapsed_ms
  if [ -n "$PR_WAIT_RECEIPT_ID" ] && [ -n "$PR_WAIT_OUTCOME" ]; then
    gh_measure_clock
    elapsed_ms=$(( GH_MEASURE_CLOCK - PR_WAIT_STARTED_MS ))
    [ "$elapsed_ms" -ge 0 ] || elapsed_ms=0
    gh_measure_workflow_outcome ai-pr-wait pr_wait "$PR_WAIT_RECEIPT_ID" "$PR_WAIT_OUTCOME" "$elapsed_ms" ||
      printf 'ai-pr-wait: request measurement unavailable: workflow outcome not saved\n' >&2
    gh_measure_local_observation "$PR_WAIT_RECEIPT_ID" "$PR_WAIT_OUTCOME" "$PR_WAIT_LOCAL_START_MS" "$PR_WAIT_LOCAL_END_MS" "$PR_WAIT_LOCAL_CLOCK_BASIS" "$PR_WAIT_LOCAL_OUTPUT_FAILED" ||
      printf 'ai-pr-wait: request measurement unavailable: local observation not saved\n' >&2
  fi
  cleanup_wait_files
  return "$rc"
}
trap 'pr_wait_cleanup' EXIT

elapsed_seconds() {
  printf '%s' "$(( SECONDS - WAIT_STARTED_SECONDS ))"
}

read_failure_cause() {
  local cause
  cause="$(tr '\r\n' '  ' < "$API_STDERR" 2>/dev/null | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//' | cut -c1-240)"
  if [ -n "$cause" ]; then
    printf '%s' "$cause"
  elif [ "$GH_RC" -eq 124 ]; then
    printf 'request exceeded the %ss API limit' "$API_TIMEOUT_SECONDS"
  elif [ "$GH_RC" -ne 0 ]; then
    printf 'GitHub client exited %s without a diagnostic' "$GH_RC"
  else
    printf 'GitHub returned an empty or invalid pull-request response'
  fi
}

deadline_reached() {
  [ "$(date +%s)" -ge "$DEADLINE" ]
}

wait_for_next_poll() {
  local now remaining delay age
  now="$(date +%s)"
  remaining=$(( DEADLINE - now ))
  [ "$remaining" -gt 0 ] || return 1
  delay="$INTERVAL"
  age="$(cat "$SNAP_AGE_FILE" 2>/dev/null || printf 0)"
  case "$age" in ''|*[!0-9]*) age=0 ;; esac
  [ "$age" -lt "$delay" ] && delay=$(( delay - age ))
  [ "$delay" -le "$remaining" ] || delay="$remaining"
  sleep "$delay"
}

while :; do
  # One GraphQL call carries everything that decides the outcome, including the
  # merge-queue membership that `gh pr view` does not report.
  GH_RC=0
  Q="$(bounded_gh --complete-status 2>"$API_STDERR")"
  GH_RC=$?
  # A fresh throttle state has no verified identity before its first call.
  # Recheck only the local token/cache after a successful response so later
  # polls can share; an unknown identity stays unshared without another API hit.
  if [ "$GH_RC" -eq 0 ] && [ -z "$SNAP_CONTEXT" ] && [ -n "$SNAP_CONTEXT_HELPER" ]; then
    SNAP_CONTEXT="$("$SNAP_CONTEXT_HELPER" 2>/dev/null || true)"
  fi

  if [ -z "$Q" ] || ! printf '%s' "$Q" | jq -e '.data.repository.pullRequest and (.errors | not) and ((.data.repository.pullRequest.state != "OPEN") or (.data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup == null) or ((.data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup.contexts.pageInfo.hasPreviousPage == false) and (.data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup.contexts.totalCount == (.data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup.contexts.nodes | length))))' >/dev/null 2>&1; then
    READ_CAUSE="$(read_failure_cause)"
    if [ "$GH_RC" -eq 125 ] && [ -n "$LAST" ]; then
      PR_WAIT_OUTCOME=deadline
      emit_workflow_evidence
      say "PR #$PR still in progress after ${TIMEOUT_MINUTES}m - giving up rather than waiting silently ($LAST)"
      capture_local_end
      exit 2
    fi
    say "ai-pr-wait: could not read PR #$PR after $(elapsed_seconds)s (transient: $READ_CAUSE); retrying"
    if deadline_reached; then
      PR_WAIT_OUTCOME=deadline
      emit_workflow_evidence
      say "PR #$PR could not be read before the ${TIMEOUT_MINUTES}m deadline - giving up rather than waiting silently"
      capture_local_end
      exit 2
    fi
    wait_for_next_poll || {
      PR_WAIT_OUTCOME=deadline
      emit_workflow_evidence
      say "PR #$PR could not be read before the ${TIMEOUT_MINUTES}m deadline - giving up rather than waiting silently"
      capture_local_end
      exit 2
    }
    continue
  fi

  STATE="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.state')"
  PR_WAIT_OBSERVED_UTC_MS="$(date -u +%s%3N 2>/dev/null || true)"
  LAST_HEAD="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.headRefOid // empty')"
  QUEUED="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.isInMergeQueue')"
  MERGE_SHA="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.mergeCommit.oid // "none"')"
  ROLLUP="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup.state // "NONE"')"
  # Only GitHub's explicit current-PR requirement result can establish an
  # advisory cancellation. Unknown policy or an unbound commit stays terminal.
  # Other failure conclusions retain their existing treatment.
  FAILED="$(printf '%s' "$Q" | jq -r '.data.repository.pullRequest as $pr | $pr.commits.nodes[0].commit as $commit | [ $commit.statusCheckRollup.contexts.nodes[]? | select(.conclusion=="FAILURE" or .conclusion=="TIMED_OUT" or (.conclusion=="CANCELLED" and (.isRequired != false or ($pr.headRefOid | type) != "string" or $pr.headRefOid == "" or $commit.oid != $pr.headRefOid)) or .state=="FAILURE" or .state=="ERROR") | ((.name // .context) + "\t" + (.conclusion // .state // "FAILURE"))] | join("\n")')"

  if [ "$STATE" = "MERGED" ]; then
    set_event_evidence MERGED
    PR_WAIT_OUTCOME=merged
    PR_WAIT_DELIVERY_BOUNDARY=terminal_report
    say "PR #$PR MERGED  merge commit $MERGE_SHA"
    capture_local_end
    PR_WAIT_DELIVERED_UTC_MS="$(date -u +%s%3N 2>/dev/null || true)"
    emit_workflow_evidence
    exit 0
  fi
  if [ "$STATE" = "CLOSED" ]; then
    set_event_evidence CLOSED
    PR_WAIT_OUTCOME=closed
    PR_WAIT_DELIVERY_BOUNDARY=terminal_report
    say "PR #$PR CLOSED without merging - it will not merge on its own"
    capture_local_end
    PR_WAIT_DELIVERED_UTC_MS="$(date -u +%s%3N 2>/dev/null || true)"
    emit_workflow_evidence
    exit 1
  fi

  # The five-hour trap: it was in the queue, it is not any more, and it is still
  # open. GitHub ejected it. Nothing further will happen without a person.
  if [ "$QUEUED" = "true" ]; then
    WAS_QUEUED=1
    QUEUED_HEAD="$LAST_HEAD"
  elif [ "$WAS_QUEUED" -eq 1 ]; then
    # A push can remove a PR from the queue while replacing its head. That is
    # not evidence that GitHub ejected the same queued commit.
    if [ "$LAST_HEAD" != "$QUEUED_HEAD" ]; then
      WAS_QUEUED=0
      QUEUED_HEAD=''
    else
    PR_WAIT_OUTCOME=ejected
    say "PR #$PR was EJECTED from the merge queue and is still OPEN - waiting longer changes nothing."
    say "  Look at the merge_group run, not the pull request run:"
    say "    gh run list --repo $REPO --event merge_group --limit 5"
    capture_local_end
    PR_WAIT_DELIVERED_UTC_MS="$(date -u +%s%3N 2>/dev/null || true)"
    emit_workflow_evidence
    exit 1
    fi
  fi

  if [ -n "$FAILED" ]; then
    set_event_evidence CHECKS
    PR_WAIT_OUTCOME=checks_failed
    PR_WAIT_DELIVERY_BOUNDARY=terminal_report
    say "PR #$PR has failing checks and will not merge:"
    # Action taxonomy (agreed plan §2b): capacity/infra vs result only.
    # Empty-verdict is the review-step carve-out and never a PR test result.
    TAXONOMY="$REAL_DIR/../tools/ci/action-taxonomy.sh"
    [ -f "$TAXONOMY" ] || TAXONOMY="$(dirname "$0")/../tools/ci/action-taxonomy.sh"
    any_capacity=0
    any_result=0
    any_review=0
    while IFS=$'\t' read -r cname cconc; do
      [ -n "$cname" ] || continue
      if [ -f "$TAXONOMY" ]; then
        action="$(bash "$TAXONOMY" check "$cconc" "$cname" 2>/dev/null || printf 'result')"
        detail="$(bash "$TAXONOMY" detail "$cconc" "$cname" 2>/dev/null || printf 'test-failure')"
      else
        action=result
        detail=test-failure
      fi
      say "  - $cname ($cconc)  action=$action  detail=$detail"
      case "$action" in
        capacity/infra) any_capacity=1 ;;
        review-step) any_review=1 ;;
        *) any_result=1 ;;
      esac
    done <<<"$FAILED"
    if [ "$any_capacity" -eq 1 ]; then
      say "  capacity/infra: timeout/kill/rate-limit. A check reported CANCELLED"
      say "  is usually a job timeout, not a test result. Park the merge and"
      say "  retry; do not re-diagnose as broken code. Capacity never invalidates"
      say "  an exact-head approval."
    fi
    if [ "$any_review" -eq 1 ]; then
      say "  review-step: empty reviewer verdict fails the review and reroutes."
      say "  It never reddens the PR test verdict."
    fi
    if [ "$any_result" -eq 1 ]; then
      say "  result: a real test outcome. Diagnose the failing suite."
      if [ "$any_capacity" -eq 1 ]; then
        say "  Mixed run: a real failure is present alongside capacity. Do not"
        say "  park the whole pull request as capacity."
      fi
    fi
    capture_local_end
    PR_WAIT_DELIVERED_UTC_MS="$(date -u +%s%3N 2>/dev/null || true)"
    emit_workflow_evidence
    exit 1
  fi

  NOW="state=$STATE queued=$QUEUED checks=$ROLLUP"
  if [ "$NOW" != "$LAST" ]; then
    say "PR #$PR $NOW"
    LAST="$NOW"
  fi

  if deadline_reached; then
    PR_WAIT_OUTCOME=deadline
    emit_workflow_evidence
    say "PR #$PR still in progress after ${TIMEOUT_MINUTES}m - giving up rather than waiting silently ($NOW)"
    capture_local_end
    exit 2
  fi
  wait_for_next_poll || {
    PR_WAIT_OUTCOME=deadline
    emit_workflow_evidence
    say "PR #$PR still in progress after ${TIMEOUT_MINUTES}m - giving up rather than waiting silently ($NOW)"
    capture_local_end
    exit 2
  }
done
