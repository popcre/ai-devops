#!/usr/bin/env bash
# ai-qwen — Qwen Code delegation in persistent, named sessions.
#
# This is the ONLY supported way for Claude or Codex to drive Qwen headlessly.
# Never call `qwen -p` directly: this script owns the model pin, the read-only
# enforcement, the completion rule, the session bookkeeping, and the worktree
# isolation for write runs.
#
#   ai-qwen new <name>       [--prompt T | --prompt-file F | stdin]   read-only review
#   ai-qwen ask <name>       [--prompt T | --prompt-file F | stdin]   continue its saved mode
#   ai-qwen implement <name> [--prompt T | --prompt-file F | stdin]   create/continue write run
#   ai-qwen reset-context <name> [--prompt T | --prompt-file F]       visible recovery
#   ai-qwen list | show <name> | transcript <name> | delete <name>
#   ai-qwen doctor [--live]
#
# Review sessions are structurally read-only: safe mode disables local hooks,
# extensions, skills, and MCP servers; plan mode plus excluded shell/write/edit
# tools removes every built-in mutation route. Implementation runs require
# Qwen's sandbox and a wrapper-owned disposable Git worktree.
#
# ---------------------------------------------------------------------------
# STEP 0 VERIFICATION — qualified 2026-08-14 against Qwen Code 0.21.11.
# Re-run and update this block on every version bump.
#
#   Exact resume is `--resume SESSION_ID`; `--continue` means newest for the
#     project and is never used. Sessions are directory-bound, so persistent
#     implementation reconstructs the same stable worktree path each turn.
#   `stream-json` is NDJSON. Completion is ONLY a terminal `type:"result"`,
#     `subtype:"success"`, `is_error:false` record. It carries session_id,
#     num_turns, result, usage, permission_denials, and timing.
#   Headless budgets exist and are always set: max session turns, wall time,
#     tool calls, and subagent depth. Exit 55 means a budget ended the run.
#   Reviews use `--safe-mode --approval-mode plan --exclude-tools
#     shell,write,edit` and a post-run tree-state check. Implementation uses
#     `--safe-mode --sandbox --approval-mode yolo` only inside the wrapper-owned
#     disposable worktree. The installed Qwen bundle is additionally hardened
#     so its common child-process sanitizer removes the Coding Plan credential
#     before shell, MCP, discovered-tool, or hook children start. Qwen itself
#     warns that yolo without sandbox executes at process privilege; therefore
#     implement mode refuses to omit sandbox or the installed sanitizer patch.
#   Qwen's own `--worktree` is not used. The wrapper owns base selection,
#     locking, cumulative binary patches, interrupted-work recovery, and cleanup.
#   Installed help and source confirmed all flags above in 0.21.11. A real model
#     proof still requires an authenticated writable QWEN_HOME; `doctor --live`
#     is the required post-install qualification gate.
# ---------------------------------------------------------------------------

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VERSION="0.1.0"

STATE_DIR="${AI_QWEN_STATE_DIR:-$HOME/.local/state/ai-devops/qwen}"
CALLER="${AI_QWEN_CALLER:-claude}"
QWEN_MODEL="${AI_QWEN_MODEL:-qwen3.8-max}"
CFG_DIR="${AI_DEVOPS_CONFIG_DIR:-$HOME/.config/ai-devops}"
TOKEN_FILE="$CFG_DIR/op-service-account"
MCP_ENV="${AI_QWEN_OP_ENV_FILE:-$CFG_DIR/mcp.env}"
QWEN_CODING_PLAN_BASE_URL="${AI_QWEN_CODING_PLAN_BASE_URL:-https://coding-intl.dashscope.aliyuncs.com/v1}"
QWEN_HOME_DIR="${AI_QWEN_HOME:-${QWEN_HOME:-$HOME/.qwen}}"
if [ -n "${AI_QWEN_TEST_DIR:-}" ]; then
  QWEN_BASH_BIN="${AI_QWEN_BASH_BIN:-/usr/bin/bash}"; QWEN_ENV_BIN="${AI_QWEN_ENV_BIN:-/usr/bin/env}"
else
  [ -z "${AI_QWEN_BASH_BIN:-}" ] && [ -z "${AI_QWEN_ENV_BIN:-}" ] && [ -z "${AI_QWEN_BIN:-}" ] && [ -z "${AI_QWEN_OP_BIN:-}" ] \
    || { printf 'ai-qwen: error: executable overrides are test-only; use the repository-owned installers to repair production tools.\n' >&2; exit 1; }
  QWEN_BASH_BIN=/usr/bin/bash; QWEN_ENV_BIN=/usr/bin/env
fi
MAX_TURNS="${AI_QWEN_MAX_TURNS:-30}"
MAX_TOOL_CALLS="${AI_QWEN_MAX_TOOL_CALLS:-80}"
MAX_WALL_TIME="${AI_QWEN_MAX_WALL_TIME:-15m}"

WAIT_TIMEOUT="${AI_QWEN_WAIT_TIMEOUT:-900}"
POLL_INTERVAL="${AI_QWEN_POLL_INTERVAL:-5}"
QWEN_CREDENTIAL_BOUNDARY='
keep_qwen_key="${BAILIAN_CODING_PLAN_API_KEY:-}"
allow_key="$1"; base_url="$2"; model="$3"; qwen_home="$4"; bash_bin="$5"; env_bin="$6"; preload="$7"; secret_file="$8"; shift 8
clean_env=("$env_bin" -i "PATH=${PATH:-}" "HOME=$qwen_home" "USERPROFILE=$qwen_home" "QWEN_HOME=$qwen_home"
  "APPDATA=$qwen_home/appdata" "LOCALAPPDATA=$qwen_home/localappdata" "TEMP=$qwen_home/tmp" "TMP=$qwen_home/tmp" "TMPDIR=$qwen_home/tmp")
for safe_name in SYSTEMROOT COMSPEC PATHEXT USER USERNAME LOGNAME LANG LC_ALL TERM; do
  [ -z "${!safe_name:-}" ] || clean_env+=("$safe_name=${!safe_name}")
done
if [ "$allow_key" = 1 ]; then
  [ -n "$keep_qwen_key" ] && [ -f "$preload" ] && [ -f "$secret_file" ] || exit 86
  printf "%s\n" "$keep_qwen_key" > "$secret_file" || exit 87
  unset BAILIAN_CODING_PLAN_API_KEY keep_qwen_key
  clean_env+=("AI_QWEN_SECRET_FILE=$secret_file" "NODE_OPTIONS=--require=$preload" "OPENAI_BASE_URL=$base_url" "OPENAI_MODEL=$model")
fi
[ -z "${AI_QWEN_TEST_DIR:-}" ] || clean_env+=("AI_QWEN_TEST_DIR=$AI_QWEN_TEST_DIR")
exec "${clean_env[@]}" "$bash_bin" --noprofile --norc -c '\''exec "$@"'\'' qwen-clean "$@"
'

die()  { printf 'ai-qwen: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-qwen: warning: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }
protect_windows_path(){
  local path="$1" kind="${2:-file}" ps helper
  [ -n "${SYSTEMROOT:-}" ] || return 0
  command -v cygpath >/dev/null 2>&1 || return 1
  ps="$(command -v pwsh.exe 2>/dev/null || command -v pwsh 2>/dev/null || command -v powershell.exe 2>/dev/null || true)"; [ -n "$ps" ] || return 1
  helper="$SCRIPT_DIR/windows-private-file.ps1"; [ -f "$helper" ] || return 1
  AI_DEVOPS_PRIVATE_HELPER="$(cygpath -w "$helper")" AI_DEVOPS_PRIVATE_TARGET="$(cygpath -w "$path")" AI_DEVOPS_PRIVATE_KIND="$kind" \
    "$ps" -NoProfile -ExecutionPolicy Bypass -Command '. $env:AI_DEVOPS_PRIVATE_HELPER; if ($env:AI_DEVOPS_PRIVATE_KIND -eq "directory") { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET -Directory } else { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET }' >/dev/null
}
qwen_local() { # qwen_local BINARY ARGS... -- local-only command under the same environment boundary
  local qwen="$1"; shift
  "$QWEN_ENV_BIN" -u BASH_ENV -u ENV "$QWEN_BASH_BIN" --noprofile --norc -c "$QWEN_CREDENTIAL_BOUNDARY" qwen-credential-boundary 0 '' '' "$QWEN_HOME_DIR" "$QWEN_BASH_BIN" "$QWEN_ENV_BIN" /nonexistent /nonexistent "$qwen" "$@"
}

assert_qwen_child_env_hardened() {
  local root="${AI_QWEN_SANITIZER_ROOT:-}" node verify_tool
  if [ -z "$root" ]; then
    if [ -n "${LOCALAPPDATA:-}" ] && [ -d "$LOCALAPPDATA/qwen-code/qwen-code/lib/chunks" ]; then
      root="$LOCALAPPDATA/qwen-code/qwen-code"
    else
      root="$HOME/.local/lib/qwen-code"
    fi
  fi
  [ -d "$root/lib/chunks" ] || return 1
  if [ -x "$root/node/bin/node" ]; then node="$root/node/bin/node"
  elif [ -x "$root/node/node.exe" ]; then node="$root/node/node.exe"
  else return 1; fi
  verify_tool="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools" 2>/dev/null && pwd)/verify-qwen-child-env-sanitizer.mjs"
  [ -f "$verify_tool" ] && "$node" "$verify_tool" "$root" >/dev/null 2>&1
}

qwen_runtime_root() {
  local root="${AI_QWEN_SANITIZER_ROOT:-}"
  if [ -z "$root" ]; then
    if [ -n "${LOCALAPPDATA:-}" ] && [ -d "$LOCALAPPDATA/qwen-code/qwen-code/lib/chunks" ]; then root="$LOCALAPPDATA/qwen-code/qwen-code"
    else root="$HOME/.local/lib/qwen-code"; fi
  fi
  [ -d "$root/bin" ] && [ -d "$root/lib/chunks" ] || return 1
  printf '%s' "$root"
}

qwen_runtime_sha256() {
  local root file rel hash node=""
  root="$(qwen_runtime_root)" || return 1
  if [ -x "$root/node/bin/node" ]; then node="$root/node/bin/node"
  elif [ -x "$root/node/node.exe" ]; then node="$root/node/node.exe"
  else return 1; fi
  {
    while IFS= read -r -d '' file; do rel="${file#"$root"/}"; hash="$(sha256_file "$file")" || exit 1; printf '%s  %s\n' "$hash" "$rel"; done < <(find "$root/bin" "$root/lib" -type f -print0 | sort -z)
    printf '%s  %s\n' "$(sha256_file "$node")" "${node#"$root"/}"
  } | sha256sum | awk '{print $1}'
}

qwen_preloader_sha256() {
  local source_root preload
  source_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)" || return 1
  preload="$source_root/tools/qwen-provider-env-preload.cjs"
  [ -f "$preload" ] && [ ! -L "$preload" ] || return 1
  sha256_file "$preload"
}

secure_qwen_home() {
  mkdir -p "$QWEN_HOME_DIR" "$QWEN_HOME_DIR/appdata" "$QWEN_HOME_DIR/localappdata" "$QWEN_HOME_DIR/tmp" || return 1
  chmod 700 "$QWEN_HOME_DIR" "$QWEN_HOME_DIR/appdata" "$QWEN_HOME_DIR/localappdata" "$QWEN_HOME_DIR/tmp" 2>/dev/null || return 1
  protect_windows_path "$QWEN_HOME_DIR" directory || return 1
  printf 'private home enforced by ai-qwen\n' > "$QWEN_HOME_DIR/.ai-devops-private-home-v1" || return 1
  chmod 600 "$QWEN_HOME_DIR/.ai-devops-private-home-v1" 2>/dev/null || return 1
}

# ---------------------------------------------------------------------------
# Binary resolution covers the official standalone locations and npm installs.
# ---------------------------------------------------------------------------
usable_qwen_bin() {
  [ -x "$1" ] || { case "${1,,}" in *.cmd|*.bat) [ -f "$1" ] ;; *) return 1 ;; esac; }
}
resolve_qwen() {
  if [ -n "${AI_QWEN_BIN:-}" ]; then
    usable_qwen_bin "$AI_QWEN_BIN" || die "AI_QWEN_BIN=$AI_QWEN_BIN is not executable."
    printf '%s' "$AI_QWEN_BIN"; return 0
  fi
  local c physical
  for c in \
           "${LOCALAPPDATA:-}/qwen-code/bin/qwen.exe" \
           "${LOCALAPPDATA:-}/qwen-code/bin/qwen.cmd" \
           "$HOME/.local/bin/qwen" \
           /home/ai/.local/bin/qwen \
           /usr/local/bin/qwen; do
    [ -n "$c" ] && usable_qwen_bin "$c" || continue
    physical="$(readlink -f "$c" 2>/dev/null || true)"
    if [ -n "${LOCALAPPDATA:-}" ] && [ -n "$physical" ]; then
      # Git for Windows can return drive-letter paths for .cmd files while
      # cygpath -u returns /c/...; compare one normalized representation.
      physical="$(cygpath -u "$physical" 2>/dev/null || true)"
    fi
    if [ -n "${LOCALAPPDATA:-}" ]; then
      case "$physical" in "$(cygpath -u "$LOCALAPPDATA")"/qwen-code/bin/qwen.cmd|"$(cygpath -u "$LOCALAPPDATA")"/qwen-code/qwen-code/bin/qwen|"$(cygpath -u "$LOCALAPPDATA")"/qwen-code/qwen-code/bin/qwen.cmd) ;;
        *) continue;; esac
    else
      case "$physical" in "$HOME/.local/bin/qwen"|"$HOME/.local/lib/qwen-code/bin/qwen"|/home/ai/.local/bin/qwen|/home/ai/.local/lib/qwen-code/bin/qwen) ;; *) continue;; esac
    fi
    printf '%s' "$c"; return 0
  done
  die "qwen binary not found. Set AI_QWEN_BIN, or install Qwen Code. Looked on PATH, the official standalone locations, and /usr/local/bin."
}

qwen_procs() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x qwen 2>/dev/null || true
  else
    ps -W 2>/dev/null | grep -i '[q]wen' || true
  fi
}

# ---------------------------------------------------------------------------
# Session identity: repo + caller + name, so Claude and Codex never collide.
# ---------------------------------------------------------------------------
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "ai-qwen must be run inside a git repository."
}

# --- review boundary ----------------------------------------------------------
# A delegated reviewer gets exactly ONE directory. In a linked worktree the
# repository's control files live outside it, so the reviewer is refused on its
# first git-adjacent read and the run dies before any code is read.
# ai-review-sandbox gives every review a private snapshot, including ordinary
# clones, so the live checkout cannot move underneath a running session.
SANDBOX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-sandbox"
[ -x "$SANDBOX_BIN" ] || SANDBOX_BIN="$(command -v ai-review-sandbox 2>/dev/null || true)"
review_boundary() { # review_boundary ROOT TAG -> directory to hand the reviewer
  [ -n "$SANDBOX_BIN" ] || die "ai-review-sandbox is missing; install the toolkit's bin/ on PATH."
  "$SANDBOX_BIN" ensure-copy "$1" "$2" || die "could not prepare a private review snapshot for $1"
}
release_boundary() { # release_boundary ROOT TAG
  [ -n "$SANDBOX_BIN" ] || return 0
  "$SANDBOX_BIN" remove-copy "$1" "$2" || true
}

resolve_trusted_op() {
  local candidate physical
  if [ -n "${AI_QWEN_TEST_DIR:-}" ] && [ -n "${AI_QWEN_OP_BIN:-}" ]; then candidate="$AI_QWEN_OP_BIN"
  else candidate="$(command -v op 2>/dev/null || true)"; fi
  [ -n "$candidate" ] || return 1; physical="$(readlink -f "$candidate" 2>/dev/null || true)"
  if [ -n "${AI_QWEN_TEST_DIR:-}" ]; then case "$physical" in "$AI_QWEN_TEST_DIR"/*) ;; *) return 1;; esac
  elif [ -n "${LOCALAPPDATA:-}" ]; then case "$physical" in "$(cygpath -u "$LOCALAPPDATA")"/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_*/op.exe) ;; *) return 1;; esac
  else [ "$physical" = /usr/bin/op ] || return 1; fi
  [ -f "$physical" ] && [ -x "$physical" ] && printf '%s' "$physical"
}
PACKET_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-packet"
[ -x "$PACKET_BIN" ] || PACKET_BIN="$(command -v ai-review-packet 2>/dev/null || true)"
REVIEW_BASE=""; REVIEW_HEAD=""; PACKET_HASH=""; WORKING_TREE_HASH=""; PACKET_REL=""
prepare_review_identity() { # SOURCE REVIEW_DIR TAG
  local source="$1" dir="$2" tag="$3" packet
  [ -n "$PACKET_BIN" ] || die "ai-review-packet is missing; install the toolkit's bin/ on PATH."
  packet="$($PACKET_BIN build "$dir" "$tag")"
  $PACKET_BIN verify "$packet" >/dev/null || die "review evidence packet failed verification."
  PACKET_REL="$(basename "$packet")"
  REVIEW_BASE="$(sed -n 's/^| \*\*base\*\* | `\([0-9a-f]*\)`.*/\1/p' "$packet/MANIFEST.md" | head -1)"
  REVIEW_HEAD="$(git -C "$source" rev-parse HEAD)"
  PACKET_HASH="$(cat "$packet/MANIFEST.sha256")"
  WORKING_TREE_HASH="$(tree_state "$source")"
  [ -n "$REVIEW_BASE" ] && [ -n "$REVIEW_HEAD" ] && [ -n "$PACKET_HASH" ] && [ -n "$WORKING_TREE_HASH" ] \
    || die "could not bind Qwen review to exact source evidence."
}
refresh_review_boundary() { # refresh_review_boundary ROOT TAG RECORDED
  local root="$1" tag="$2" recorded="$3" refreshed
  if [ "$(cd "$recorded" 2>/dev/null && pwd -P || printf '%s' "$recorded")" = "$(cd "$root" && pwd -P)" ]; then
    printf '%s' "$recorded"; return 0
  fi
  refreshed="$(review_boundary "$root" "$tag")"
  [ "$(cd "$refreshed" && pwd -P)" = "$(cd "$recorded" && pwd -P)" ] || \
    die "review session is bound to $recorded but its private snapshot now resolves to $refreshed. Refusing to split one conversation across two directories."
  printf '%s' "$recorded"
}
legacy_repo_id() { printf '%s' "$1" | tr '\\' '/' | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
repo_id() {
  local root="$1" remote
  root="$(cd "$root" && pwd -P)"
  remote="$(git -C "$root" config --get remote.origin.url 2>/dev/null || echo '')"
  printf '%s' "$(printf '%s\n%s' "$root" "$remote" | sha256sum | cut -c1-12)"
}
repo_remote() { git -C "$1" config --get remote.origin.url 2>/dev/null || true; }
valid_name() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }

meta_path()     { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
impl_dir()      { printf '%s/sessions/%s/%s--%s.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
impl_meta_path(){ printf '%s/metadata.json' "$(impl_dir "$1" "$2")"; }
lock_path()     { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
repolock_path() { printf '%s/locks/repo--%s.lock.d' "$STATE_DIR" "$1"; }
workspace_path(){ printf '%s/worktrees/qwen.%s-%s-%s/wt' "$STATE_DIR" "$1" "$CALLER" "$2"; }

# Portable mutex (flock does not exist in Git Bash); stale locks are reclaimed.
lock_acquire() {
  local dir="$1" label="$2" owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || echo '')"
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then return 1; fi
  warn "reclaiming stale lock $(basename "$dir") (owner pid ${owner:-unknown} is gone)"
  rm -rf "$dir"; mkdir "$dir" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
}
lock_release() { rm -rf "$1" 2>/dev/null || true; }
lock_info() {
  local dir="$1" label pid started now
  label="$(cat "$dir/label" 2>/dev/null || echo unknown)"
  pid="$(cat "$dir/pid" 2>/dev/null || echo '?')"
  if started="$(date -r "$dir" +%s 2>/dev/null)"; then
    now="$(date +%s)"; printf '%s (pid %s, running %ss)' "$label" "$pid" "$((now - started))"
  else printf '%s (pid %s)' "$label" "$pid"; fi
}

write_meta() {
  local f="$1" tmp; mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; chmod 0600 "$tmp" 2>/dev/null || true; mv -f "$tmp" "$f"
}
find_meta_optional() {
  local f old repo remote cand found=""; f="$(impl_meta_path "$1" "$2")"
  [ -f "$f" ] || f="$(meta_path "$1" "$2")"
  if [ ! -f "$f" ]; then
    repo="$(repo_root)"; old="$(meta_path "$(legacy_repo_id "$repo")" "$2")"
    if [ -f "$old" ]; then mkdir -p "$(dirname "$f")"; mv "$old" "$f"; fi
  fi
  if [ ! -f "$f" ]; then
    remote="$(repo_remote "$repo")"
    [ -n "$remote" ] || return 1
    while IFS= read -r cand; do
      [ "$(jq -r '.name // ""' "$cand")" = "$2" ] || continue
      [ "$(jq -r '.caller // ""' "$cand")" = "$CALLER" ] || continue
      [ "$(jq -r '.repo_remote // ""' "$cand")" = "$remote" ] || continue
      [ -z "$found" ] || die "multiple moved-checkout records match session '$2'; refusing an ambiguous migration."
      found="$cand"
    done < <(find "$STATE_DIR/sessions" -type f \( -name "$CALLER--$2.json" -o -path "*/$CALLER--$2.d/metadata.json" \) 2>/dev/null)
    if [ -n "$found" ]; then
      case "$found" in
        */"$CALLER--$2.d/metadata.json") f="$found" ;; # Keep the rid: Qwen binds resume to its stable workspace path.
        *) mkdir -p "$(dirname "$f")"; mv "$found" "$f" ;;
      esac
    fi
  fi
  [ -f "$f" ] || return 1
  printf '%s' "$f"
}
find_meta() {
  local f
  f="$(find_meta_optional "$1" "$2")" || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-qwen list"
  printf '%s' "$f"
}
rid_from_meta() { basename "$(dirname "$(dirname "$1")")"; }

# ---------------------------------------------------------------------------
# The completion rule.
#
# Qwen's stream-json is NDJSON. Completion is proven by its explicit terminal
# success record, never by process exit status alone.
# ---------------------------------------------------------------------------
has_result() { # has_result FILE
  [ -s "$1" ] || return 1
  tail -5 "$1" | jq -e 'select(.type=="result" and .subtype=="success" and .is_error==false and (.session_id|type=="string"))' >/dev/null 2>&1
}
session_id_from() { tail -5 "$1" | jq -r 'select(.type=="result")|.session_id // empty' 2>/dev/null | tail -1; }
model_from() { jq -r 'select(.type=="assistant")|.message.model // empty' "$1" 2>/dev/null | tail -1; }

AWAIT_RESULT_REASON=""
await_result() { # await_result FILE LABEL
  local f="$1" label="$2" waited=0 empty=0 saw=0
  AWAIT_RESULT_REASON=""
  while [ "$waited" -lt "$WAIT_TIMEOUT" ]; do
    has_result "$f" && return 0
    # Fast-fail ONLY if a qwen process was positively seen and then vanished.
    # If detection never matched, we do not trust it and wait the full timeout —
    # a detection miss must never abort a healthy slow run.
    if [ -n "$(qwen_procs)" ]; then saw=1; empty=0
    elif [ "$saw" = 1 ]; then
      empty=$((empty + 1))
      if [ "$empty" -ge 2 ]; then
        note ""
        note "ai-qwen: Qwen is no longer running but never emitted a terminal success result."
        note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
        note "  elapsed  : ${waited}s"
        note "  diagnose : ai-qwen doctor"
        AWAIT_RESULT_REASON="process-ended"
        return 1
      fi
    fi
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
    [ $((waited % 60)) -eq 0 ] && note "  … $label still running (${waited}s)"
  done
  note ""
  note "ai-qwen: no terminal success result after ${WAIT_TIMEOUT}s — the run did not complete."
  note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
  note "  diagnose : ai-qwen doctor"
  note "  Raise the ceiling with AI_QWEN_WAIT_TIMEOUT=<seconds> for a genuinely long run."
  AWAIT_RESULT_REASON="timeout"
  return 1
}

sha256_file() { sha256sum "$1" | awk '{print $1}'; }

valid_impl_record() { # valid_impl_record RID NAME META
  local rid="$1" name="$2" meta="$3" dir manifest patch base
  dir="$(impl_dir "$rid" "$name")"; manifest="$dir/owner.json"; patch="$(jq -r '.canonical_patch // ""' "$meta" 2>/dev/null)"
  same_path "$meta" "$dir/metadata.json" && [ -f "$manifest" ] && [ -f "$patch" ] || return 1
  same_path "$(dirname "$patch")" "$dir" || return 1
  base="$(basename "$patch")"; [ "$base" = cumulative.patch ] || printf '%s' "$base" | grep -Eq '^cumulative-[0-9]+-[0-9a-f]{64}\.patch$' || return 1
  jq -e --arg remote "$(repo_remote "$(repo_root)")" \
    --arg caller "$CALLER" --arg name "$name" --arg patch "$patch" --arg meta "$meta" \
    '.version==2 and .mode=="implement" and .repo_remote==$remote and
     .caller==$caller and .name==$name and (.base_sha|type=="string") and (.base_sha|length==40) and
     (.patch_sha256|type=="string") and (.generation|type=="number") and
     (.continuity_state|type=="string")' "$meta" >/dev/null 2>&1 || return 1
  jq -e --arg dir "$dir" --arg meta "$meta" \
    '.version==1 and .owner_dir==$dir and .metadata==$meta' \
    "$manifest" >/dev/null 2>&1 || return 1
  [ "$(sha256_file "$patch")" = "$(jq -r .patch_sha256 "$meta")" ]
}

write_impl_state() { # RID NAME REPO BASE SID WT TERMINAL CONTINUITY [OLD_META]
  local rid="$1" name="$2" repo="$3" base="$4" sid="$5" wt="$6" terminal="$7" continuity="$8" old="${9:-}"
  local dir meta patch manifest tmp_patch hash now turns generation created old_patch
  dir="$(impl_dir "$rid" "$name")"; meta="$dir/metadata.json"; manifest="$dir/owner.json"
  mkdir -p "$dir"; chmod 0700 "$dir" 2>/dev/null || true
  tmp_patch="$(mktemp "$dir/.cumulative.XXXXXX")" || return 1
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --binary "$base" ) > "$tmp_patch" || { rm -f "$tmp_patch"; return 1; }
  hash="$(sha256_file "$tmp_patch")"; now="$(date -u +%FT%TZ)"
  if [ -n "$old" ] && [ -f "$old" ]; then
    turns=$(( $(jq -r '.turns // 0' "$old") + 1 )); generation=$(( $(jq -r '.generation // 0' "$old") + 1 )); created="$(jq -r .created "$old")"
  else turns=1; generation=1; created="$now"; fi
  patch="$dir/cumulative-$generation-$hash.patch"
  if [ -f "$patch" ]; then [ "$(sha256_file "$patch")" = "$hash" ] || return 1; rm -f "$tmp_patch"
  else mv -f "$tmp_patch" "$patch" || return 1; fi
  chmod 0600 "$patch" 2>/dev/null || true
  [ "${AI_QWEN_TEST_FAIL_STATE:-}" != after-patch ] || return 1
  write_meta "$manifest" "$(jq -n --arg dir "$dir" --arg meta "$meta" \
    '{version:1,owner_dir:$dir,metadata:$meta,patch_pattern:"cumulative-<generation>-<sha256>.patch"}')" || return 1
  old_patch=""; [ -n "$old" ] && [ -f "$old" ] && old_patch="$(jq -r '.canonical_patch // ""' "$old")"
  write_meta "$meta" "$(jq -n --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" \
    --arg name "$name" --arg caller "$CALLER" --arg model "$QWEN_MODEL" --arg base "$base" \
    --arg patch "$patch" --arg hash "$hash" --arg created "$created" --arg updated "$now" \
    --arg terminal "$terminal" --arg continuity "$continuity" --argjson turns "$turns" --argjson generation "$generation" \
    '{version:2,qwen_session_id:$sid,repo:$repo,repo_remote:$remote,name:$name,caller:$caller,mode:"implement",
      model:$model,base_sha:$base,canonical_patch:$patch,patch_sha256:$hash,generation:$generation,turns:$turns,
      created:$created,updated:$updated,last_terminal_state:$terminal,incomplete_state:($terminal!="completed"),
      continuity_state:$continuity,lifecycle_status:(if $continuity=="exact" then "ready" else "recovery-required" end),
      ephemeral_state_notice:"Ignored dependencies, build output, downloads, caches, and secrets are not preserved. Generation is wrapper bookkeeping, not a Qwen turn counter."}')"
  [ -z "$old_patch" ] || [ "$old_patch" = "$patch" ] || rm -f "$old_patch" 2>/dev/null || true
}

reconcile_impl_patches() { # META RESET_ALLOWED
  local meta="$1" reset="${2:-0}" dir canonical generation f base fgen
  dir="$(dirname "$meta")"; canonical="$(jq -r .canonical_patch "$meta")"; generation="$(jq -r .generation "$meta")"
  for f in "$dir"/cumulative-*.patch; do
    [ -f "$f" ] || continue
    same_path "$f" "$canonical" && continue
    base="$(basename "$f")"
    fgen="$(printf '%s' "$base" | sed -nE 's/^cumulative-([0-9]+)-[0-9a-f]{64}\.patch$/\1/p')"
    [ -n "$fgen" ] || return 1
    if [ "$fgen" -gt "$generation" ]; then
      if [ "$reset" = 1 ]; then rm -f "$f" || return 1
      else
        mark_impl_recovery_required "$meta" uncommitted-state-detected || return 1
        return 2
      fi
    else rm -f "$f" || return 1; fi
  done
  return 0
}

mark_impl_recovery_required() { # META TERMINAL
  local meta="$1" terminal="$2" json
  [ -n "$meta" ] && [ -f "$meta" ] || return 1
  json="$(jq --arg u "$(date -u +%FT%TZ)" --arg t "$terminal" \
    '.updated=$u | .last_terminal_state=$t | .incomplete_state=true |
     .continuity_state="recovery-required" | .lifecycle_status="recovery-required"' "$meta")" || return 1
  write_meta "$meta" "$json"
}

# ---------------------------------------------------------------------------
# Turn execution
# ---------------------------------------------------------------------------
RUN_TURN_RC=unavailable
RUN_TURN_PID=""
RUN_TURN_ENV_FILE=""
PLAIN_REVIEW_META=""
PLAIN_REVIEW_OUT=""
cleanup_run_turn_env() {
  [ -z "${RUN_TURN_SECRET_FILE:-}" ] || rm -f -- "$RUN_TURN_SECRET_FILE" 2>/dev/null || true
  RUN_TURN_SECRET_FILE=""
  [ -z "$RUN_TURN_ENV_FILE" ] || rm -f -- "$RUN_TURN_ENV_FILE" 2>/dev/null || true
  RUN_TURN_ENV_FILE=""
}
run_turn() { # run_turn REPO OUT PROMPT_FILE MODE [SESSION_ID]
  local repo="$1" out="$2" pf="$3" mode="$4" sid="${5:-}"
  local qwen qwen_env="" credential_ref="" op_bin="" credential_count=0 preload; qwen="$(resolve_qwen)"
  local args=(--model "$QWEN_MODEL" --output-format stream-json --safe-mode
    --max-session-turns "$MAX_TURNS" --max-wall-time "$MAX_WALL_TIME"
    --max-tool-calls "$MAX_TOOL_CALLS" --max-subagent-depth 1)
  [ -z "$sid" ] || args+=(--resume "$sid")
  if [ "$mode" = review ]; then
    args+=(--approval-mode plan --exclude-tools shell,write,edit)
  elif [ "$mode" = implement ]; then
    # Preserve the complete implementation toolset, including shell and tests.
    # The installer-patched common child sanitizer strips the provider key from
    # every agent-controlled child process before this mode is allowed to run.
    assert_qwen_child_env_hardened || die "Qwen child-process credential hardening was not proven. Re-run the repository-owned provider CLI installer before implementation."
    args+=(--sandbox --approval-mode yolo)
  fi
  # Current Qwen supports stdin, keeping the brief out of the process list.

  [ -x "$QWEN_BASH_BIN" ] && [ -x "$QWEN_ENV_BIN" ] || die "trusted absolute Bash/env executables are required: $QWEN_BASH_BIN and $QWEN_ENV_BIN"
  case "$QWEN_BASH_BIN:$QWEN_ENV_BIN" in /*:/*) ;; *) die 'trusted Bash/env executable paths must be absolute.' ;; esac
  secure_qwen_home || die 'could not enforce private permissions on the dedicated Qwen home before credential resolution.'
  : > "$out"
  [ "$QWEN_CODING_PLAN_BASE_URL" = 'https://coding-intl.dashscope.aliyuncs.com/v1' ] || die 'Qwen Coding Plan endpoint must be the pinned international Alibaba endpoint.'
  preload="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools" 2>/dev/null && pwd)/qwen-provider-env-preload.cjs"
  [ -f "$preload" ] || die 'repository-owned Qwen secret-environment preloader is missing.'
  RUN_TURN_SECRET_FILE="$(mktemp "$QWEN_HOME_DIR/tmp/.qwen-secret.XXXXXX")" || die 'could not reserve private Qwen secret handoff.'
  chmod 600 "$RUN_TURN_SECRET_FILE" 2>/dev/null || die 'could not protect private Qwen secret handoff.'
  protect_windows_path "$RUN_TURN_SECRET_FILE" file || die 'could not enforce private Qwen secret-handoff ACL.'
  set +e
  [ -f "$MCP_ENV" ] && credential_count="$(grep -c '^BAILIAN_CODING_PLAN_API_KEY=' "$MCP_ENV" 2>/dev/null || true)"
  if [ "$credential_count" = 1 ] && grep -q '^BAILIAN_CODING_PLAN_API_KEY=op://' "$MCP_ENV"; then
    op_bin="$(resolve_trusted_op 2>/dev/null || true)"
    [ -n "$op_bin" ] && [ -x "$op_bin" ] || die "1Password CLI is required to resolve the managed Qwen Coding Plan credential."
    local op_service_token="${OP_SERVICE_ACCOUNT_TOKEN:-}"
    [ -n "$op_service_token" ] || [ ! -s "$TOKEN_FILE" ] || op_service_token="$(<"$TOKEN_FILE")"
    credential_ref="$(sed -n 's/^BAILIAN_CODING_PLAN_API_KEY=//p' "$MCP_ENV" | tail -1)"
    case "$credential_ref" in op://*) ;; *) die "managed Qwen credential is not a 1Password reference." ;; esac
    qwen_env="$(mktemp)"; RUN_TURN_ENV_FILE="$qwen_env"; printf 'BAILIAN_CODING_PLAN_API_KEY=%s\n' "$credential_ref" > "$qwen_env"; chmod 600 "$qwen_env" 2>/dev/null || true
    # op run inherits its own environment. Remove shell startup hooks before
    # launching either op or its Bash child, then the boundary removes every
    # credential-shaped variable except Qwen's key before exec.
    case "$op_bin" in /*) ;; *) die 'resolved 1Password executable path must be absolute.' ;; esac
    ( [ -z "$op_service_token" ] || export OP_SERVICE_ACCOUNT_TOKEN="$op_service_token"; cd "$repo" && exec "$QWEN_ENV_BIN" -u BASH_ENV -u ENV "$op_bin" run --env-file "$qwen_env" -- "$QWEN_BASH_BIN" --noprofile --norc -c "$QWEN_CREDENTIAL_BOUNDARY" qwen-credential-boundary 1 "$QWEN_CODING_PLAN_BASE_URL" "$QWEN_MODEL" "$QWEN_HOME_DIR" "$QWEN_BASH_BIN" "$QWEN_ENV_BIN" "$preload" "$RUN_TURN_SECRET_FILE" "$qwen" "${args[@]}" < "$pf" ) > "$out" 2>"$out.err" &
  else
    die "governed Qwen authentication is unavailable. $MCP_ENV must contain exactly one BAILIAN_CODING_PLAN_API_KEY=op:// reference; no provider call was made."
  fi
  RUN_TURN_PID=$!
  wait "$RUN_TURN_PID"
  RUN_TURN_RC=$?
  RUN_TURN_PID=""
  cleanup_run_turn_env
  [ -z "${AI_QWEN_TEST_POST_TURN_ENV_FILE:-}" ] || env | sort > "$AI_QWEN_TEST_POST_TURN_ENV_FILE"
  set -e
  return 0
}

child_pids() { # child_pids PARENT
  if ps -W >/dev/null 2>&1; then
    ps -W 2>/dev/null | awk -v p="$1" 'NR>1 && $2==p {print $1}'
  else
    ps -eo pid=,ppid= 2>/dev/null | awk -v p="$1" '$2==p {print $1}'
  fi
}

signal_run_tree() { # signal_run_tree SIGNAL PID
  local signal="$1" pid="$2" child
  for child in $(child_pids "$pid"); do signal_run_tree "$signal" "$child"; done
  kill "-$signal" "$pid" 2>/dev/null || true
}

stop_run_turn() {
  if [ -n "$RUN_TURN_PID" ]; then
    local pid="$RUN_TURN_PID" i
    signal_run_tree TERM "$pid"
    for i in 1 2 3 4 5; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && signal_run_tree KILL "$pid"
    set +e; wait "$pid" 2>/dev/null; set -e
    RUN_TURN_PID=""
  fi
  cleanup_run_turn_env
}

record_existing_review_recovery() { # META OUT REASON
  local meta="$1" out="$2" reason="$3" pending
  pending="${meta%.json}.pending.jsonl"
  cp "$out" "$pending" 2>/dev/null || : > "$pending"
  chmod 600 "$pending" 2>/dev/null || true
  write_meta "$meta" "$(jq --arg u "$(date -u +%FT%TZ)" --arg p "$pending" --arg r "$reason" '.status="recovery-required" | .failure_reason=$r | .recovery_stream=$p | .updated=$u' "$meta")"
}
cancel_plain_turn() {
  stop_run_turn
  [ -z "$PLAIN_REVIEW_META" ] || record_existing_review_recovery "$PLAIN_REVIEW_META" "$PLAIN_REVIEW_OUT" interrupted-provider-turn || true
  exit 130
}
trap cleanup_run_turn_env EXIT

# ---------------------------------------------------------------------------
# THE REVIEW-OUTPUT CONTRACT (shared-db issue #1220)
#
# Two separate defects were observed in one night, both of which let a wrapper
# exit 0 with no usable review:
#
#  1. SILENCE READ AS APPROVE. A run ended after 637 seconds of provider time
#     having written one assistant message ("let me verify a couple of
#     environmental facts before finalizing findings") and no findings. The
#     wrapper printed telemetry and exited 0. A caller reading only the exit code,
#     or only stdout, cannot tell that from a clean review.
#
#  2. THE BODY THROWN AWAY. A run DID produce a full review -- five findings and a
#     hand-traced coverage statement -- and the wrapper printed only:
#         ## Verdict
#         VERDICT: APPROVE
#     because `sed -n '/^## Verdict/,$p'` prints from the heading to the END and
#     discards everything above it. The body survived only in the raw stream. A
#     caller quoting stdout as the review evidence would have posted a bare
#     two-line APPROVE as the audit record for a change one step from a
#     production write.
#
# In this repository's workflows a review is a MERGE GATE, and both failure modes
# are biased toward "looks approved". So:
#
#   * the FULL text is printed, never the tail from a heading; and
#   * a turn with no answer text, or with no '## Verdict' heading, is reported as
#     a wrapper failure, not as a review that found nothing.
# ---------------------------------------------------------------------------

# Set by extract_answer: empty on success, otherwise why this turn produced no
# usable review. A global rather than an exit status because finish_turn also runs
# on the implement lifecycle path, where aborting early would skip artifact export.
ANSWER_DEFECT=""

extract_answer() { # extract_answer FILE
  local text verdict_count terminal
  ANSWER_DEFECT=""
  text="$(jq -r 'select(.type=="result" and .is_error==false) | .result // ""' "$1" 2>/dev/null | sed 's/\r$//' | sed '/^$/d')"
  if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
    ANSWER_DEFECT="the provider produced no answer text at all (it ended mid-run)"
  else
    verdict_count="$(printf '%s\n' "$text" | grep -Ec '^## Verdict[[:space:]]*$' || true)"
    terminal="$(printf '%s\n' "$text" | sed '/^[[:space:]]*$/d' | tail -n 2)"
    if [ "$verdict_count" -ne 1 ]; then
      ANSWER_DEFECT="the answer must contain exactly one standalone '## Verdict' heading (found $verdict_count)"
    elif ! printf '%s\n' "$terminal" | grep -Eq '^## Verdict[[:space:]]*$' || ! printf '%s\n' "$terminal" | tail -n 1 | grep -Eq '^(APPROVE|REJECT|BLOCKED)$'; then
      ANSWER_DEFECT="the final two nonblank lines must be '## Verdict' and exactly APPROVE, REJECT, or BLOCKED"
    fi
  fi
  # ALWAYS the whole body. Findings routinely sit ABOVE the verdict heading, and
  # printing only the tail is how a complete review became a two-line APPROVE.
  printf '%s\n' "$text"
}

# Report the defect loudly on stderr and return non-zero. Never downgrades to success.
report_answer_defect() { # report_answer_defect NAME STREAM_PATH
  [ -n "$ANSWER_DEFECT" ] || return 0
  printf 'ai-qwen: error: no usable review for %s: %s\n' "${1:-this turn}" "$ANSWER_DEFECT" >&2
  printf 'ai-qwen: this is a WRAPPER/PROVIDER failure, not a clean review. Silence is not approval.\n' >&2
  printf 'ai-qwen: do NOT record this as a verdict. Re-run it, or replace the reviewer.\n' >&2
  [ -n "${2:-}" ] && printf 'ai-qwen: raw provider stream: %s\n' "$2" >&2
  return 1
}

PROMPT_FOOTER="

---
Formatting requirement: put all findings and narration first. The final two
nonblank lines must be the heading followed by exactly one word: APPROVE,
REJECT, or BLOCKED. Example:
## Verdict
APPROVE
Do not use any other verdict heading or put text after the verdict word."

build_prompt_file() {
  local dest="$1" body="$1.body"
  if [ -n "${OPT_PROMPT_FILE:-}" ]; then
    [ -f "$OPT_PROMPT_FILE" ] || die "prompt file not found: $OPT_PROMPT_FILE"
    cat "$OPT_PROMPT_FILE" > "$body"
  elif [ -n "${OPT_PROMPT:-}" ]; then printf '%s\n' "$OPT_PROMPT" > "$body"
  elif [ ! -t 0 ]; then cat > "$body"
  else die "no prompt given. Use --prompt TEXT, --prompt-file FILE, or pipe it on stdin."
  fi
  [ -s "$body" ] || die "the prompt is empty."
  if [ -n "$PACKET_REL" ]; then
    printf 'Read %s/MANIFEST.md first and verify its sealed evidence before judging the code.\n\n' "$PACKET_REL" > "$dest"
    cat "$body" >> "$dest"; rm -f "$body"
  else mv -f "$body" "$dest"; fi
  printf '%s' "$PROMPT_FOOTER" >> "$dest"
}

verify_returned_model() { # verify_returned_model STREAM
  local returned; returned="$(model_from "$1")"
  [ "$returned" = "$QWEN_MODEL" ] || die "Qwen returned model '${returned:-unavailable}'; expected the pinned model $QWEN_MODEL."
}

# Defence in depth: excluded tools are the guarantee. Hash the complete tracked
# diff and every untracked file so a review cannot hide a content change inside
# a path that was already dirty before it started.
reject_special_untracked() {
  local repo="$1"
  find "$repo" -xdev -path "$repo/.git" -prune -o \
    ! -type f ! -type d ! -type l -print0 \
    | while IFS= read -r -d '' special; do
        local rel="${special#"$repo"/}"
        git -C "$repo" check-ignore -q -- "$rel" 2>/dev/null && continue
        printf 'ai-qwen: refusing special untracked evidence: %s\n' "$rel" >&2
        return 1
      done
}
tree_state() {
  local repo="$1"
  reject_special_untracked "$repo" || return 1
  {
    git -C "$repo" diff --binary HEAD 2>/dev/null
    git -C "$repo" ls-files -z --others --exclude-standard 2>/dev/null \
      | while IFS= read -r -d '' f; do
          local fd before after path_state hash
          [ ! -L "$repo/$f" ] && [ -f "$repo/$f" ] || { printf 'ai-qwen: refusing linked or non-regular untracked evidence: %s\n' "$f" >&2; return 1; }
          exec {fd}<"$repo/$f" || { printf 'ai-qwen: could not bind untracked evidence: %s\n' "$f" >&2; return 1; }
          before="$(stat -Lc '%F:%d:%i:%h:%s:%y:%z' "/proc/$BASHPID/fd/$fd" 2>/dev/null || true)"
          path_state="$(stat -Lc '%F:%d:%i:%h:%s:%y:%z' "$repo/$f" 2>/dev/null || true)"
          case "$before" in 'regular file:'*':1:'*) ;; *) exec {fd}<&-; printf 'ai-qwen: refusing untracked evidence without one regular-file identity: %s\n' "$f" >&2; return 1;; esac
          [ "$before" = "$path_state" ] && [ ! -L "$repo/$f" ] || { exec {fd}<&-; printf 'ai-qwen: untracked evidence identity changed before hashing: %s\n' "$f" >&2; return 1; }
          hash="$(sha256sum <&$fd | awk '{print $1}')" || { exec {fd}<&-; return 1; }
          after="$(stat -Lc '%F:%d:%i:%h:%s:%y:%z' "/proc/$BASHPID/fd/$fd" 2>/dev/null || true)"; path_state="$(stat -Lc '%F:%d:%i:%h:%s:%y:%z' "$repo/$f" 2>/dev/null || true)"
          exec {fd}<&-
          [ "$before" = "$after" ] && [ "$before" = "$path_state" ] && [ ! -L "$repo/$f" ] || { printf 'ai-qwen: untracked evidence changed during hashing: %s\n' "$f" >&2; return 1; }
          printf 'UNTRACKED %q %s\n' "$f" "$hash"
        done
  } | sha256sum | awk '{print $1}'
}

reviews_dir() {
  local repo="$1" rel=".ai/reviews/$2" root physical
  root="$(cd "$repo" && pwd -P)" || { printf ''; return; }
  if [ -e "$repo/.ai" ]; then physical="$(cd "$repo/.ai" && pwd -P)" || { printf ''; return; }; case "$physical" in "$root"/*) ;; *) printf ''; return ;; esac; fi
  if [ -e "$repo/.ai/reviews" ]; then physical="$(cd "$repo/.ai/reviews" && pwd -P)" || { printf ''; return; }; case "$physical" in "$root"/*) ;; *) printf ''; return ;; esac; fi
  ! git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 \
    && git -C "$repo" check-ignore --no-index -q -- "$rel" 2>/dev/null \
    && [ ! -L "$repo/.ai" ] && [ ! -L "$repo/.ai/reviews" ] \
    && printf '%s/.ai/reviews' "$repo" || printf ''
}
write_review_file() {
  local repo="$1" name="$2" f="$3" status="${4:-accepted}" dir ts out base
  ts="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  if [ "$status" = accepted ]; then base="qwen-${name}-${ts}.md"; else base="qwen-${name}-incomplete-${ts}.md"; fi
  dir="$(reviews_dir "$repo" "$base")"
  if [ -z "$dir" ]; then
    warn "not writing a review file: '.ai/reviews' is not git-ignored in $repo. Add '.ai/reviews/' to .gitignore."
    return 0
  fi
  mkdir -p "$dir"; out="$dir/$base"
  {
    if [ "$status" = accepted ]; then echo "# Qwen review — $name"; else echo "# Qwen incomplete review — $name"; fi
    echo
    [ "$status" = accepted ] || { echo "- Status: \`NOT ACCEPTED — invalid or missing terminal verdict\`"; echo; }
    echo "- Repo: \`$repo\`"
    echo "- Branch: \`$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')\`"
    echo "- Session: \`$(session_id_from "$f")\`"
    echo "- Model requested: \`$QWEN_MODEL\`; returned: \`$(model_from "$f")\`"
    echo "- Turns: \`$(jq -r 'select(.type=="result")|.num_turns // "unavailable"' "$f" | tail -1)\`"
    echo "- Usage: \`$(jq -c 'select(.type=="result")|.usage // {}' "$f" | tail -1)\`"
    echo; echo "---"; echo
    jq -r 'select(.type=="result" and .is_error==false) | .result // ""' "$f" 2>/dev/null
  } > "$out"
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
ai-qwen $VERSION — Qwen Code delegation in persistent, named sessions.

  ai-qwen new <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-qwen ask <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-qwen implement <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-qwen reset-context <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-qwen list | show <name> | transcript <name> | delete <name>
  ai-qwen doctor [--live]

'new' creates a STRUCTURALLY read-only review. 'ask' continues the saved mode:
read-only for reviews, but an implementation continuation (write run) for an
implementation session. 'implement' creates or continues an isolated write
session. Each write turn uses a new disposable worktree reconstructed from the
immutable base and cumulative patch. Ignored build and dependency state does
not persist. No patch is applied to the live repository automatically. Model is
pinned ($QWEN_MODEL). Every run is bounded by turns, tool calls, and wall time.

Environment:
  AI_QWEN_CALLER       'claude' (default) or 'codex' — keeps sessions separate
  AI_QWEN_BIN          explicit path to the qwen binary
  AI_QWEN_MODEL        model pin ($QWEN_MODEL)
  AI_QWEN_MAX_TURNS    maximum session turns ($MAX_TURNS)
  AI_QWEN_MAX_TOOL_CALLS maximum tool calls ($MAX_TOOL_CALLS)
  AI_QWEN_MAX_WALL_TIME wall-clock limit ($MAX_WALL_TIME)
  AI_QWEN_WAIT_TIMEOUT seconds to wait for completion ($WAIT_TIMEOUT)
  AI_QWEN_STATE_DIR    session state ($STATE_DIR)
EOF
}

doctor_worktrees() {
  local root owner repo wt pid state expected
  root="$STATE_DIR/worktrees"; [ -d "$root" ] || return 0
  while IFS= read -r owner; do
    repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
    wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
    pid="$(jq -r '.pid // ""' "$owner" 2>/dev/null)"
    state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
    expected="${wt%/wt}/owner.json"
    if [ "$owner" != "$expected" ] || [ "${wt#"$root"/}" = "$wt" ] || [ ! -d "$repo/.git" ]; then
      warn "ambiguous Qwen worktree owner record left untouched: $owner"; continue
    fi
    if [ "$state" = preserved-recovery ]; then
      warn "preserved Qwen recovery worktree left untouched: $wt"; continue
    fi
    [ "$state" = active ] || { warn "unknown Qwen worktree state left untouched: $owner"; continue; }
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    git -C "$repo" worktree list --porcelain 2>/dev/null | grep -Fxq "worktree $wt" \
      || { warn "unregistered Qwen worktree record left untouched: $owner"; continue; }
    warn "removing stale wrapper-owned Qwen worktree: $wt"
    cleanup_wt "$repo" "$wt" "$owner"
  done < <(find "$root" -type f -name owner.json 2>/dev/null)
}

cmd_doctor() {
  local live=0 qwen rc=0 runtime_sha="" preloader_sha=""
  [ "${1:-}" = "--live" ] && live=1
  secure_qwen_home || die 'could not enforce private permissions on the dedicated Qwen home before checking the session store.'
  need jq; qwen="$(resolve_qwen)"
  echo "qwen binary   : $qwen"
  echo "qwen version  : $(qwen_local "$qwen" --version 2>&1 | head -1)"
  if runtime_sha="$(qwen_runtime_sha256)" && [ -n "$runtime_sha" ]; then
    echo "qwen runtime sha256: $runtime_sha"
  else
    echo "qwen runtime sha256: UNAVAILABLE"
    rc=1
  fi
  if preloader_sha="$(qwen_preloader_sha256)" && [ -n "$preloader_sha" ]; then
    echo "qwen preloader sha256: $preloader_sha"
  else
    echo "qwen preloader sha256: UNAVAILABLE"
    rc=1
  fi
  echo "caller        : $CALLER"
  echo "state dir     : $STATE_DIR"
  echo "model pin     : $QWEN_MODEL"
  if [ -f "$MCP_ENV" ] && grep -q '^BAILIAN_CODING_PLAN_API_KEY=op://' "$MCP_ENV"; then
    echo "credential    : managed 1Password reference"
    echo "endpoint      : $QWEN_CODING_PLAN_BASE_URL"
  else
    echo "credential    : provider-managed or unavailable"
  fi
  echo "read-only     : safe mode + plan mode + shell/write/edit excluded"
  if assert_qwen_child_env_hardened 2>/dev/null; then
    echo "child secrets : HARDENED (Coding Plan key stripped from Qwen tool children)"
  else
    echo "child secrets : FAILED — rerun the repository-owned provider CLI installer"; rc=1
  fi
  echo "implement     : full Qwen tools + sandbox + disposable Git worktree"
  echo "budgets       : turns=$MAX_TURNS tools=$MAX_TOOL_CALLS wall=$MAX_WALL_TIME"
  echo
  if qwen_local "$qwen" sessions list --json --limit 1 >/dev/null 2>&1; then
    echo "session store : OK"
  else
    echo "session store : FAILED"; rc=1
  fi
  if [ "$live" = 1 ]; then
    local tmp; tmp="$(mktemp)"; printf 'Reply with exactly: OK\n' > "$tmp.p"
    echo -n "live probe    : "
    run_turn "$(pwd)" "$tmp" "$tmp.p" review >/dev/null || true
    if has_result "$tmp" && verify_returned_model "$tmp"; then echo "OK"; else echo "FAILED — terminal success and exact pinned model were not both proven"; rc=1; fi
    rm -f "$tmp" "$tmp.p" "$tmp.err" 2>/dev/null || true
  fi
  doctor_worktrees
  return $rc
}

# One implementation lifecycle owns artifact export, worktree cleanup, temporary
# files, and the repository lock. Signal handlers only record cancellation and
# exit; this finalizer does every state-changing cleanup action exactly once.
LIFECYCLE_ACTIVE=0
LIFECYCLE_MODE=""
LIFECYCLE_STATE="failed"
LIFECYCLE_NAME=""
LIFECYCLE_REPO=""
LIFECYCLE_WT=""
LIFECYCLE_OWNER=""
LIFECYCLE_BASE=""
LIFECYCLE_PF=""
LIFECYCLE_OUT=""
LIFECYCLE_LOCK=""
LIFECYCLE_SESSION_LOCK=""
LIFECYCLE_COMMAND_RC="unavailable"
LIFECYCLE_ARTIFACT_DURABLE=0
LIFECYCLE_PRESERVE=0
LIFECYCLE_RID=""
LIFECYCLE_META=""
LIFECYCLE_REVIEW_DIR=""

record_new_review_recovery() { # META REPO NAME REVIEW_DIR OUT REASON
  local meta="$1" repo="$2" name="$3" review_dir="$4" out="$5" reason="$6" pending sid now
  mkdir -p "$(dirname "$meta")"
  pending="${meta%.json}.pending.jsonl"; sid="$(session_id_from "$out")"; [ -n "$sid" ] || sid=unavailable; now="$(date -u +%FT%TZ)"
  cp "$out" "$pending" 2>/dev/null || : > "$pending"
  chmod 600 "$pending" 2>/dev/null || true
  write_meta "$meta" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg name "$name" \
    --arg caller "$CALLER" --arg model "$QWEN_MODEL" --arg review_dir "$review_dir" --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" \
    --arg packet "$PACKET_HASH" --arg tree "$WORKING_TREE_HASH" --arg pending "$pending" --arg reason "$reason" --arg now "$now" \
    '{qwen_session_id:$sid,repo:$repo,repo_remote:$remote,name:$name,caller:$caller,mode:"review",status:"recovery-required",model:$model,
      review_dir:$review_dir,base:$base,head:$head,packet_sha256:$packet,working_tree_sha256:$tree,evidence_generation:1,
      recovery_stream:$pending,failure_reason:$reason,created:$now,updated:$now,turns:0}')"
}
LIFECYCLE_SID=""
LIFECYCLE_PRIOR_TREE=""

classify_incomplete_state() { # classify_incomplete_state OUTPUT STDERR AWAIT_REASON
  local out="$1" err="$2" reason="$3"
  [ "$LIFECYCLE_STATE" = cancelled ] && { printf 'cancelled'; return; }
  if { [ -s "$out" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$out"; } \
    || { [ -s "$err" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$err"; }; then
    printf 'usage-limit'
  elif [ "$LIFECYCLE_COMMAND_RC" != unavailable ] && [ "$LIFECYCLE_COMMAND_RC" -ne 0 ] 2>/dev/null; then
    printf 'failed'
  elif [ "$reason" = timeout ]; then
    printf 'timed-out'
  else
    printf 'failed'
  fi
}

valid_owner_record() { # valid_owner_record REPO WORKTREE OWNER [STATE]
  local repo="$1" wt="$2" owner="$3" wanted="${4:-}" root expected recorded_repo recorded_wt state
  [ -n "$repo" ] && [ -n "$wt" ] && [ -n "$owner" ] && [ -f "$owner" ] || return 1
  root="${STATE_DIR%/}/worktrees"
  case "$wt" in "$root"/qwen.*/wt) ;; *) return 1 ;; esac
  expected="${wt%/wt}/owner.json"
  [ "$owner" = "$expected" ] || return 1
  recorded_repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
  recorded_wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
  state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
  [ "$recorded_repo" = "$repo" ] && same_path "$recorded_wt" "$wt" || return 1
  [ -z "$wanted" ] || [ "$state" = "$wanted" ]
}

same_path() { # same_path A B - accounts for Git Bash /tmp to Windows argv conversion
  local a="$1" b="$2"
  if command -v cygpath >/dev/null 2>&1; then
    a="$(cygpath -aw "$a" 2>/dev/null | tr '\\' '/' || printf '%s' "$a")"
    b="$(cygpath -aw "$b" 2>/dev/null | tr '\\' '/' || printf '%s' "$b")"
  fi
  [ "$a" = "$b" ]
}

mark_preserved() { # mark_preserved OWNER
  local owner="$1" json
  json="$(jq '.state="preserved-recovery"' "$owner" 2>/dev/null)" || return 1
  write_meta "$owner" "$json" || return 1
  [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ]
}

safe_report_detail() { # safe_report_detail TERMINAL_STATE
  case "$1" in
    usage-limit) printf 'Qwen reported a usage or billing limit.' ;;
    timed-out)   printf 'The wrapper deadline passed without the required terminal record.' ;;
    cancelled)   printf 'The wrapper received an interrupt or termination request.' ;;
    *)           printf 'Qwen did not emit the required terminal completion record.' ;;
  esac
}

artifact_dir() { # artifact_dir REPO EXACT-BASENAME
  local dir
  [ "${AI_QWEN_TEST_FAIL_EXPORT:-}" = destination ] && return 1
  dir="$(reviews_dir "$1" "$2")"
  if [ -z "$dir" ]; then
    dir="$STATE_DIR/recovery-patches"
    mkdir -p "$dir" 2>/dev/null || return 1
  fi
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 0700 "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

emit_implementation_artifact() { # REPO NAME WT BASE OWNER KIND STATE RC OUT [PRIOR_TREE]
  local repo="$1" name="$2" wt="$3" base="$4" owner="$5" kind="$6" state="$7" rc="$8" out="$9"
  local prior="${10:-$base}" dir ts suffix patch report turn_patch="" patch_tmp turn_tmp="" report_tmp sid summary detail
  valid_owner_record "$repo" "$wt" "$owner" active || {
    warn "refusing artifact export from an ambiguous Qwen worktree owner record: $owner"
    return 1
  }
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  [ "$kind" = incomplete ] && suffix=.incomplete || suffix=""
  dir="$(artifact_dir "$repo" "qwen-${name}-${ts}${suffix}.patch")" || return 1
  patch="$dir/qwen-${name}-${ts}${suffix}.patch"
  report="$dir/qwen-${name}-${ts}.incomplete.md"
  patch_tmp="$(mktemp "$dir/.qwen-patch.XXXXXX")" || return 1
  chmod 0600 "$patch_tmp" 2>/dev/null || true
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --binary "$base" ) > "$patch_tmp" 2>/dev/null \
    || { rm -f "$patch_tmp"; return 1; }
  if [ ! -s "$patch_tmp" ]; then
    rm -f "$patch_tmp"
    [ "$kind" = incomplete ] && note "ai-qwen: failed before changes (terminal state: $state); no empty patch was created." \
      || warn "the implement run produced no changes."
    return 2
  fi
  if [ "$kind" = incomplete ]; then
    if [ "$prior" != "$base" ]; then
      turn_patch="$dir/qwen-${name}-${ts}.turn.incomplete.patch"
      turn_tmp="$(mktemp "$dir/.qwen-turn-patch.XXXXXX")" || { rm -f "$patch_tmp"; return 1; }
      ( cd "$wt" && git diff --binary "$prior" ) > "$turn_tmp" 2>/dev/null || { rm -f "$patch_tmp" "$turn_tmp"; return 1; }
      [ -s "$turn_tmp" ] || { rm -f "$turn_tmp"; turn_patch=""; }
    fi
    report_tmp="$(mktemp "$dir/.qwen-report.XXXXXX")" || { rm -f "$patch_tmp" "${turn_tmp:-}"; return 1; }
    chmod 0600 "$report_tmp" 2>/dev/null || true
    sid="$(session_id_from "$out")"; [ -n "$sid" ] || sid=unavailable
    summary="$(cd "$wt" && git diff --stat "$prior" 2>/dev/null | head -40 | cut -c1-240)"
    detail="$(safe_report_detail "$state")"
    {
      echo "# INCOMPLETE Qwen implementation - $name"; echo
      echo "This work is INCOMPLETE. It is not proof that the task is correct, tested, or safe."; echo
      echo "- Job: \`$name\`"
      echo "- Repository: \`$repo\`"
      echo "- Base SHA: \`$base\`"
      echo "- Model requested: \`$QWEN_MODEL\`; returned: \`$(model_from "$out")\`"
      echo "- Terminal state: \`$state\`"
      echo "- Command exit status: \`$rc\`"
      echo "- Qwen session ID: \`$sid\`"
      echo "- Usage: \`$(jq -c 'select(.type=="result")|.usage // {}' "$out" 2>/dev/null | tail -1)\`"
      echo "- Tests: not confirmed complete"
      echo "- Patch: \`$patch\`"
      [ -z "$turn_patch" ] || echo "- This turn only: \`$turn_patch\`"
      echo "- Safe detail: $detail"; echo
      echo "## Changed-file summary"; echo; echo '```text'
      printf '%s\n' "${summary:-Git recorded changes, but no bounded stat text was available.}"
      echo '```'; echo
      echo "## Recovery"; echo
      echo "1. Inspect cumulative work: \`git apply --stat '$patch'\`"
      [ -z "$turn_patch" ] || echo "2. Inspect only this failed turn: \`git apply --stat '$turn_patch'\`"
      echo "3. Verify the cumulative patch against the captured base: \`git apply --check '$patch'\`"
      echo "4. Never apply an incomplete patch without reviewing every change and running the required tests."
    } > "$report_tmp" || { rm -f "$patch_tmp" "${turn_tmp:-}" "$report_tmp"; return 1; }
  fi
  if [ "${AI_QWEN_TEST_FAIL_EXPORT:-}" = move ]; then
    rm -f "$patch_tmp" "${turn_tmp:-}" "${report_tmp:-}"
    return 1
  fi
  mv "$patch_tmp" "$patch" || { rm -f "$patch_tmp" "${turn_tmp:-}" "${report_tmp:-}"; return 1; }
  if [ "$kind" = incomplete ]; then
    [ -z "$turn_patch" ] || mv "$turn_tmp" "$turn_patch" || { rm -f "$turn_tmp" "$patch" "$report_tmp"; return 1; }
    mv "$report_tmp" "$report" || { rm -f "$report_tmp" "$patch"; return 1; }
    note "ai-qwen: $state with partial changes; command remains unsuccessful."
    note "INCOMPLETE patch written: $patch"
    note "INCOMPLETE report written: $report"
    [ -z "$turn_patch" ] || note "THIS-TURN patch written: $turn_patch"
    note "  inspect: git apply --stat '$patch'"
    note "  verify:  git apply --check '$patch'"
  else
    note "patch written: $patch"
    note "  review it, then:  git apply --check '$patch' && git apply '$patch'"
  fi
  return 0
}

lifecycle_finalize() { # lifecycle_finalize ORIGINAL_EXIT_STATUS
  local original="${1:-1}" artifact_rc=0 state_rc=0 final continuity
  final="$original"
  [ "$LIFECYCLE_ACTIVE" = 1 ] || return "$original"
  LIFECYCLE_ACTIVE=0
  if [ "$LIFECYCLE_MODE" = implement ] && [ -n "$LIFECYCLE_WT" ]; then
    if [ "$LIFECYCLE_STATE" = completed ]; then
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" complete completed "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" || artifact_rc=$?
    else
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" incomplete "$LIFECYCLE_STATE" "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" \
        "${LIFECYCLE_PRIOR_TREE:-$LIFECYCLE_BASE}" || artifact_rc=$?
    fi
    if [ "$artifact_rc" = 0 ] || [ "$artifact_rc" = 2 ]; then
      continuity=exact
      [ "$LIFECYCLE_STATE" = completed ] || continuity=recovery-required
      [ -n "$LIFECYCLE_SID" ] || LIFECYCLE_SID="$(session_id_from "$LIFECYCLE_OUT")"
      [ -n "$LIFECYCLE_SID" ] || continuity=recovery-required
      write_impl_state "$LIFECYCLE_RID" "$LIFECYCLE_NAME" "$LIFECYCLE_REPO" \
        "$LIFECYCLE_BASE" "${LIFECYCLE_SID:-unavailable}" "$LIFECYCLE_WT" \
        "$LIFECYCLE_STATE" "$continuity" "$LIFECYCLE_META" || state_rc=1
      if [ "$state_rc" = 1 ]; then
        final=1
        if mark_impl_recovery_required "$LIFECYCLE_META" state-save-failed; then
          warn "canonical Qwen state could not be saved. The prior proven code was kept and exact-session resume is blocked."
        else
          LIFECYCLE_PRESERVE=1; mark_preserved "$LIFECYCLE_OWNER" || true
          warn "canonical Qwen state and recovery metadata could not be saved. Recovery worktree: $LIFECYCLE_WT"
        fi
      fi
    fi
    if [ "$artifact_rc" = 1 ]; then
      LIFECYCLE_PRESERVE=1; final=1
      mark_preserved "$LIFECYCLE_OWNER" || true
      warn "could not safely export Qwen's work. The exact recovery worktree remains at: $LIFECYCLE_WT"
      warn "after recovery, remove it with: git -C '$LIFECYCLE_REPO' worktree remove '$LIFECYCLE_WT'"
    elif [ "$artifact_rc" = 0 ] && [ "$state_rc" = 0 ]; then
      LIFECYCLE_ARTIFACT_DURABLE=1
    fi
    [ "$LIFECYCLE_PRESERVE" = 1 ] || cleanup_wt "$LIFECYCLE_REPO" "$LIFECYCLE_WT" "$LIFECYCLE_OWNER"
  fi
  rm -f "$LIFECYCLE_PF" "$LIFECYCLE_OUT" "$LIFECYCLE_OUT.err" 2>/dev/null || true
  [ -z "$LIFECYCLE_LOCK" ] || lock_release "$LIFECYCLE_LOCK"
  [ -z "$LIFECYCLE_SESSION_LOCK" ] || lock_release "$LIFECYCLE_SESSION_LOCK"
  return "$final"
}

lifecycle_exit_trap() {
  local original=$? final
  trap - EXIT HUP INT TERM
  set +e
  cleanup_run_turn_env
  lifecycle_finalize "$original"; final=$?
  exit "$final"
}

lifecycle_cancel() {
  LIFECYCLE_STATE=cancelled
  LIFECYCLE_COMMAND_RC=130
  stop_run_turn
  if [ "$LIFECYCLE_MODE" = review ] && [ -n "$LIFECYCLE_META" ]; then
    record_new_review_recovery "$LIFECYCLE_META" "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_REVIEW_DIR" "$LIFECYCLE_OUT" interrupted-provider-turn || true
  fi
  exit 130
}

start_session() { # start_session NAME MODE
  local name="$1" mode="$2" repo rid meta pf out rid_lock sid rc before after wt="" base="" owner="" source_head_before="" source_tree_before=""
  valid_name "$name" || die "invalid session name '$name' (letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(meta_path "$rid" "$name")"
  [ "$mode" = implement ] && meta="$(impl_meta_path "$rid" "$name")"
  [ -f "$meta" ] && die "session '$name' already exists here. Continue it with: ai-qwen ask $name"

  rid_lock="$(repolock_path "$rid")"
  lock_acquire "$rid_lock" "$mode:$name" || die "another Qwen run is already active in this repository: $(lock_info "$rid_lock").
  Do not start a second one; wait for it, or continue it with 'ask'."
  LIFECYCLE_LOCK="$rid_lock"
  trap lifecycle_exit_trap EXIT
  trap lifecycle_cancel HUP INT TERM
  LIFECYCLE_ACTIVE=1; LIFECYCLE_MODE="$mode"; LIFECYCLE_STATE=failed
  LIFECYCLE_NAME="$name"; LIFECYCLE_REPO="$repo"; LIFECYCLE_WT=""
  LIFECYCLE_OWNER=""; LIFECYCLE_BASE=""; LIFECYCLE_PF=""; LIFECYCLE_OUT=""
  LIFECYCLE_COMMAND_RC=unavailable; LIFECYCLE_ARTIFACT_DURABLE=0; LIFECYCLE_PRESERVE=0
  LIFECYCLE_RID="$rid"; LIFECYCLE_META=""; LIFECYCLE_SID=""
  LIFECYCLE_PRIOR_TREE=""

  local workdir="$repo"
  if [ "$mode" != implement ]; then
    source_head_before="$(git -C "$repo" rev-parse HEAD)"
    source_tree_before="$(tree_state "$repo")"
    [ -z "${AI_QWEN_TEST_PRE_SNAPSHOT_MARKER:-}" ] || printf reached > "$AI_QWEN_TEST_PRE_SNAPSHOT_MARKER"
    [ -z "${AI_QWEN_TEST_PRE_SNAPSHOT_DELAY:-}" ] || sleep "$AI_QWEN_TEST_PRE_SNAPSHOT_DELAY"
    workdir="$(review_boundary "$repo" "qwen-$name")"
    LIFECYCLE_REVIEW_DIR="$workdir"
    prepare_review_identity "$repo" "$workdir" "qwen-$CALLER-$name"
    if [ "$source_head_before" != "$(git -C "$repo" rev-parse HEAD)" ] || [ "$source_tree_before" != "$(tree_state "$repo")" ]; then
      die "the source repository changed while Qwen evidence was being prepared; no provider call was made. Start a new named Qwen review."
    fi
  fi
  if [ "$mode" = implement ]; then
    base="$(git -C "$repo" rev-parse HEAD)"
    wt="$(workspace_path "$rid" "$name")"
    [ ! -e "${wt%/wt}" ] || die "the stable disposable Qwen workspace path is still occupied: ${wt%/wt}"
    mkdir -p "${wt%/wt}"
    git -c core.longpaths=true -C "$repo" worktree add -q --detach "$wt" >/dev/null 2>&1 \
      || die "could not create an isolated worktree for the implement run."
    git -C "$wt" config core.longpaths true
    owner="${wt%/wt}/owner.json"
    LIFECYCLE_WT="$wt"; LIFECYCLE_OWNER="$owner"; LIFECYCLE_BASE="$base"
    write_meta "$owner" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg repo "$repo" --arg wt "$wt" --arg pid "$$" --arg state active \
      '{version:1,repo:$repo,worktree:$wt,pid:$pid,state:$state}')"
    workdir="$wt"
    note "implement run isolated in a throwaway worktree: $wt"
  fi

  pf="$(mktemp)"; LIFECYCLE_PF="$pf"
  out="$(mktemp)"; LIFECYCLE_OUT="$out"
  build_prompt_file "$pf"
  before="$(tree_state "$workdir")"

  note "Qwen $mode '$name' starting (model $QWEN_MODEL)…"
  if [ "$mode" = review ]; then
    LIFECYCLE_META="$meta"
    record_new_review_recovery "$meta" "$repo" "$name" "$workdir" "$out" turn_in_progress
    write_meta "$meta" "$(jq '.status="turn_in_progress"' "$meta")"
  fi
  run_turn "$workdir" "$out" "$pf" "$mode"; rc="$RUN_TURN_RC"
  LIFECYCLE_COMMAND_RC="$rc"
  [ "$mode" != review ] || record_new_review_recovery "$meta" "$repo" "$name" "$workdir" "$out" provider_turn_pending_local_validation
  if ! await_result "$out" "$mode '$name'"; then
    LIFECYCLE_STATE="$(classify_incomplete_state "$out" "$out.err" "$AWAIT_RESULT_REASON")"
    note "  qwen exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    exit 1
  fi
  verify_returned_model "$out"

  if [ "$mode" = review ] && { [ "$source_head_before" != "$(git -C "$repo" rev-parse HEAD)" ] || [ "$source_tree_before" != "$(tree_state "$repo")" ]; }; then
    die "the source repository changed during the Qwen turn; the stale response was rejected. Start a new named Qwen review."
  fi

  sid="$(session_id_from "$out")"
  [ -n "$sid" ] || die "Qwen returned no session id."
  LIFECYCLE_STATE=completed
  LIFECYCLE_SID="$sid"

  after="$(tree_state "$workdir")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Qwen review changed the working tree. The agent profile's tool
  restriction is not holding — do not trust further reviews until this is understood.
  Inspect: git -C $repo status"
  fi

  # #1220: keep the lifecycle bookkeeping, THEN fail. Aborting on the spot would
  # skip lifecycle_finalize and lose the run's own record of what happened.
  finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  if [ "$mode" = review ] && [ "${FINISH_RC:-0}" = 0 ]; then
    rm -f "$(jq -r '.recovery_stream // empty' "$meta")"
    write_meta "$meta" "$(jq --arg sid "$sid" --arg u "$(date -u +%FT%TZ)" '.qwen_session_id=$sid | .status="active" | del(.failure_reason,.recovery_stream) | .updated=$u | .turns=1' "$meta")"
  fi
  lifecycle_finalize 0
  [ "${FINISH_RC:-0}" = 0 ] || exit "$FINISH_RC"
}

cleanup_wt() { # cleanup_wt REPO WORKTREE OWNER
  local repo="${1:-}" wt="${2:-}" owner="${3:-}"
  [ -n "$wt" ] || return 0
  valid_owner_record "$repo" "$wt" "$owner" || {
    warn "ambiguous Qwen worktree owner record left untouched: ${owner:-unavailable}"
    return 1
  }
  [ -f "$owner" ] && [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ] && return 0
  git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
  git -C "$repo" worktree prune >/dev/null 2>&1 || true
  if git -C "$repo" worktree list 2>/dev/null | grep -qF "$wt"; then
    warn "the throwaway worktree $wt is STILL registered — remove it before continuing."
    return 1
  fi
  # `git worktree remove --force` can leave ignored build/dependency files behind.
  # The owner record and validated wrapper-only path make this narrow cleanup safe.
  rm -rf "$wt" 2>/dev/null || true
  rm -f "$owner" 2>/dev/null || true
  rmdir "${wt%/wt}" 2>/dev/null || true
}

cmd_ask() {
  local name="$1" repo rid meta sid pf out rc before after sess_lock rid_lock mode workdir current_head current_tree expected_head expected_tree expected_packet source_head_before source_tree_before status pending
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(find_meta "$rid" "$name")"
  sid="$(jq -r .qwen_session_id "$meta")"; mode="$(jq -r .mode "$meta")"
  if [ "$mode" = implement ]; then rid="$(rid_from_meta "$meta")"; continue_implementation "$name" "$rid" "$meta"; return; fi
  status="$(jq -r '.status // "active"' "$meta")"
  [ "$status" = active ] || die "review session '$name' requires recovery ($status) because its provider conversation may have advanced beyond accepted evidence. Inspect the recorded recovery_stream, then delete and start a new named Qwen review."

  expected_head="$(jq -r '.head // empty' "$meta")"; expected_tree="$(jq -r '.working_tree_sha256 // empty' "$meta")"; expected_packet="$(jq -r '.packet_sha256 // empty' "$meta")"
  [ -n "$expected_head" ] && [ -n "$expected_tree" ] && [ -n "$expected_packet" ] \
    || die "review session '$name' predates exact evidence binding and cannot be resumed safely. Start a new named Qwen review."
  current_head="$(git -C "$repo" rev-parse HEAD)"; current_tree="$(tree_state "$repo")"
  if [ "$current_head" != "$expected_head" ] || [ "$current_tree" != "$expected_tree" ]; then
    die "review session '$name' is bound to different code evidence.
  reviewed HEAD: $expected_head
  current HEAD : $current_head
The committed, dirty, or untracked source state changed. Start a new named Qwen review; no provider call was made."
  fi

  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$rid")"
  lock_acquire "$sess_lock" "ask:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "ask:$name"; then
    lock_release "$sess_lock"; die "another Qwen run is active in this repository: $(lock_info "$rid_lock")"
  fi
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT
  trap cancel_plain_turn HUP INT TERM

  pf="$(mktemp)"; out="$(mktemp)"
  note "Qwen '$name' continuing session $sid…"
  workdir="$(jq -r '.review_dir // empty' "$meta")"
  if [ -z "$workdir" ]; then
    if [ -f "$repo/.git" ]; then
      workdir="$($SANDBOX_BIN ensure "$repo" "qwen-$name")"
    else
      workdir="$repo"
    fi
    write_meta "$meta" "$(MSYS2_ARG_CONV_EXCL='*' jq --arg d "$workdir" '.review_dir=$d | .boundary_migration_warned=true' "$meta")"
    warn "session '$name' predates recorded private snapshots and remains bound to its original review directory. Delete and recreate it when convenient; until then, do not move or update an ordinary checkout during a turn."
  fi
  source_head_before="$current_head"; source_tree_before="$current_tree"
  workdir="$(refresh_review_boundary "$repo" "qwen-$name" "$workdir")"
  [ -z "${AI_QWEN_TEST_PRE_FOLLOWUP_PACKET_MARKER:-}" ] || printf reached > "$AI_QWEN_TEST_PRE_FOLLOWUP_PACKET_MARKER"
  [ -z "${AI_QWEN_TEST_PRE_FOLLOWUP_PACKET_DELAY:-}" ] || sleep "$AI_QWEN_TEST_PRE_FOLLOWUP_PACKET_DELAY"
  prepare_review_identity "$repo" "$workdir" "qwen-$CALLER-$name"
  [ "$source_head_before" = "$(git -C "$repo" rev-parse HEAD)" ] && [ "$source_tree_before" = "$(tree_state "$repo")" ] \
    || die "the source repository changed while rebuilding the sealed Qwen evidence; no provider call was made. Start a new named Qwen review."
  [ "$REVIEW_HEAD" = "$expected_head" ] && [ "$WORKING_TREE_HASH" = "$expected_tree" ] && [ "$PACKET_HASH" = "$expected_packet" ] \
    || die "review session '$name' no longer reproduces its exact sealed evidence; no provider call was made. Start a new named Qwen review."
  build_prompt_file "$pf"
  before="$(tree_state "$workdir")"
  PLAIN_REVIEW_META="$meta"; PLAIN_REVIEW_OUT="$out"
  record_existing_review_recovery "$meta" "$out" turn_in_progress
  write_meta "$meta" "$(jq '.status="turn_in_progress"' "$meta")"
  run_turn "$workdir" "$out" "$pf" "$mode" "$sid"; rc="$RUN_TURN_RC"
  pending="${meta%.json}.pending.jsonl"
  record_existing_review_recovery "$meta" "$out" provider_turn_pending_local_validation
  if ! await_result "$out" "'$name'"; then
    note "  qwen exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi
  verify_returned_model "$out"
  if [ "$source_head_before" != "$(git -C "$repo" rev-parse HEAD)" ] || [ "$source_tree_before" != "$(tree_state "$repo")" ]; then
    die "the source repository changed during the Qwen turn; the stale response was rejected. Start a new named Qwen review."
  fi
  after="$(tree_state "$workdir")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Qwen review changed the working tree. Inspect: git -C $repo status"
  fi
  FINISH_RC=0
  finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  if [ "$FINISH_RC" = 0 ]; then
    rm -f "$pending"
    write_meta "$meta" "$(jq --arg u "$(date -u +%FT%TZ)" '.status="active" | del(.failure_reason,.recovery_stream) | .updated=$u | .turns=(.turns+1)' "$meta")"
    PLAIN_REVIEW_META=""; PLAIN_REVIEW_OUT=""
    rm -f "$pf" "$out" "$out.err"
  else
    # #1220: report_answer_defect just named "$out" as the place the review body
    # can still be recovered from. Deleting it here would destroy the only copy.
    rm -f "$pf"
    exit "$FINISH_RC"
  fi
}

continue_implementation() { # NAME RID META [RESET]
  local name="$1" rid="$2" meta="$3" reset="${4:-0}" repo sid base patch expected actual sess_lock rid_lock wt owner pf out rc rrc=0
  [ "$(jq -r '.version // 1' "$meta")" = 2 ] || die "session '$name' is a legacy one-shot implementation and cannot be guessed or resumed.
  Archive it with 'ai-qwen transcript $name', delete it with 'ai-qwen delete $name', then start persistent work with 'ai-qwen implement <new-name>'."
  valid_impl_record "$rid" "$name" "$meta" || die "persistent implementation state for '$name' failed ownership, identity, or patch validation. No Qwen turn was started."
  reconcile_impl_patches "$meta" "$reset" || rrc=$?
  [ "$rrc" != 2 ] || die "session '$name' has an uncommitted newer state artifact from an interrupted save. Exact-session resume is blocked. Run: ai-qwen reset-context $name --prompt 'Restate the task and continue from the prior proven code.'"
  [ "$rrc" = 0 ] || die "persistent implementation patch reconciliation failed; no Qwen turn was started."
  if [ "$reset" != 1 ]; then
    [ "$(jq -r .continuity_state "$meta")" = exact ] || die "session '$name' requires recovery because conversation and canonical code may differ. Exact-session resume is blocked. Run: ai-qwen reset-context $name --prompt 'Restate the task and continue from the reconstructed code.'"
  fi
  repo="$(repo_root)"; sid="$(jq -r .qwen_session_id "$meta")"; base="$(jq -r .base_sha "$meta")"; patch="$(jq -r .canonical_patch "$meta")"
  git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || die "recorded immutable base $base is unavailable."
  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$rid")"
  lock_acquire "$sess_lock" "implement-continuation:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "implement-continuation:$name"; then lock_release "$sess_lock"; die "another Qwen run is active: $(lock_info "$rid_lock")"; fi
  LIFECYCLE_SESSION_LOCK="$sess_lock"; LIFECYCLE_LOCK="$rid_lock"
  trap lifecycle_exit_trap EXIT; trap lifecycle_cancel INT TERM
  LIFECYCLE_ACTIVE=1; LIFECYCLE_MODE=implement; LIFECYCLE_STATE=failed; LIFECYCLE_NAME="$name"; LIFECYCLE_REPO="$repo"
  LIFECYCLE_BASE="$base"; LIFECYCLE_RID="$rid"; LIFECYCLE_META="$meta"; LIFECYCLE_SID="$sid"
  LIFECYCLE_COMMAND_RC=unavailable; LIFECYCLE_ARTIFACT_DURABLE=0; LIFECYCLE_PRESERVE=0
  wt="$(workspace_path "$rid" "$name")"
  [ ! -e "${wt%/wt}" ] || die "the stable disposable Qwen workspace path is still occupied: ${wt%/wt}"
  mkdir -p "${wt%/wt}"
  git -c core.longpaths=true -C "$repo" worktree add -q --detach "$wt" "$base" >/dev/null 2>&1 || die "could not reconstruct the disposable implementation workspace."
  git -C "$wt" config core.longpaths true
  owner="${wt%/wt}/owner.json"; LIFECYCLE_WT="$wt"; LIFECYCLE_OWNER="$owner"
  write_meta "$owner" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg repo "$repo" --arg wt "$wt" --arg pid "$$" '{version:1,repo:$repo,worktree:$wt,pid:$pid,state:"active"}')"
  git -C "$wt" apply --check "$patch" >/dev/null 2>&1 && git -C "$wt" apply "$patch" >/dev/null 2>&1 || die "canonical patch cannot be applied to immutable base $base."
  git -C "$wt" add -A >/dev/null 2>&1
  expected="$(jq -r .patch_sha256 "$meta")"; actual="$(mktemp)"
  git -C "$wt" diff --binary "$base" > "$actual"; [ "$(sha256_file "$actual")" = "$expected" ] || die "reconstructed source hash does not equal the canonical patch hash."
  rm -f "$actual"
  LIFECYCLE_PRIOR_TREE="$(git -C "$wt" write-tree)" || die "could not capture the proven pre-turn source tree."
  pf="$(mktemp)"; out="$(mktemp)"; LIFECYCLE_PF="$pf"; LIFECYCLE_OUT="$out"; build_prompt_file "$pf"
  { printf '%s\n\n' "NOTICE: This implementation continuation (write run) uses a newly reconstructed workspace. Git-visible source is exact. Ignored dependencies, build output, downloads, caches, and secrets did not persist. Recreate what is needed and rerun tests."; cat "$pf"; } > "$pf.notice"; mv "$pf.notice" "$pf"
  if [ "$reset" = 1 ]; then
    note "Qwen CONTEXT RESET (write run) '$name': preserving canonical code but starting a new conversation generation."
    LIFECYCLE_SID=""; run_turn "$wt" "$out" "$pf" implement
  else
    note "Qwen implementation continuation (write run) '$name' resuming exact session $sid in a disposable workspace."
    run_turn "$wt" "$out" "$pf" implement "$sid"
  fi
  rc="$RUN_TURN_RC"; LIFECYCLE_COMMAND_RC="$rc"
  if ! await_result "$out" "implementation continuation '$name'"; then
    LIFECYCLE_STATE="$(classify_incomplete_state "$out" "$out.err" "$AWAIT_RESULT_REASON")"; exit 1
  fi
  verify_returned_model "$out"
  if [ "$reset" = 1 ]; then LIFECYCLE_SID="$(session_id_from "$out")"
  else [ "$(session_id_from "$out")" = "$sid" ] || die "Qwen returned a different session id; refusing to advance canonical state."; fi
  # #1220: on the IMPLEMENT path the deliverable is the patch, so a missing verdict
  # must never abort before lifecycle_finalize exports it. Record, export, then fail.
  LIFECYCLE_STATE=completed
  FINISH_RC=0; finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  lifecycle_finalize 0
  [ "$FINISH_RC" = 0 ] || exit "$FINISH_RC"
}

finish_turn() {
  local repo="$1" name="$2" out="$3" path rc=0 artifact_status=accepted
  ANSWER_DEFECT=""
  if [ "${OPT_JSON:-0}" = 1 ]; then extract_answer "$out" >/dev/null; cat "$out"; else extract_answer "$out"; fi
  [ -z "$ANSWER_DEFECT" ] || artifact_status=incomplete
  path="$(write_review_file "$repo" "$name" "$out" "$artifact_status")"
  [ -n "$path" ] && note "saved: $path"
  jq -r 'select(.type=="result") | "usage: input=\(.usage.input_tokens // "?") output=\(.usage.output_tokens // "?") turns=\(.num_turns // "?")"' "$out" 2>/dev/null | tail -1 >&2
  note "model: requested=$QWEN_MODEL returned=$(model_from "$out")"
  # Issue #1220: a turn with no answer, or no verdict, must NOT read as a clean
  # review. Returns non-zero so the caller can exit non-zero; the raw stream is
  # named so the review body can still be recovered when the provider wrote one.
  report_answer_defect "$name" "$out" || rc=4
  return "$rc"
}

cmd_list() {
  local repo rid remote f stored_rid
  repo="$(repo_root)"; rid="$(repo_id "$repo")"; remote="$(repo_remote "$repo")"
  printf '%-24s %-8s %-11s %-46s %6s\n' NAME CALLER MODE SESSION TURNS
  [ -d "$STATE_DIR/sessions" ] || return 0
  while IFS= read -r f; do
    stored_rid="$(basename "$(dirname "$f")")"
    [ "$(basename "$f")" != metadata.json ] || stored_rid="$(basename "$(dirname "$(dirname "$f")")")"
    if [ "$stored_rid" != "$rid" ]; then
      [ -n "$remote" ] && [ "$(jq -r '.repo_remote // ""' "$f" 2>/dev/null)" = "$remote" ] || continue
    fi
    jq -r '[.name,.caller,.mode,.qwen_session_id,(.turns|tostring)]|@tsv' "$f" \
      | awk -F'\t' '{printf "%-24s %-8s %-11s %-46s %6s\n",$1,$2,$3,$4,$5}'
  done < <(find "$STATE_DIR/sessions" -type f \( -name '*.json' ! -name owner.json -o -name metadata.json \) -print 2>/dev/null | sort -u)
}
cmd_show()   { jq . "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; }
cmd_delete() {
  local rid meta dir manifest sess_lock f base
  rid="$(repo_id "$(repo_root)")"; meta="$(find_meta "$rid" "$1")"
  [ "$(jq -r '.mode // ""' "$meta")" != implement ] || rid="$(rid_from_meta "$meta")"
  sess_lock="$(lock_path "$rid" "$1")"
  [ ! -d "$sess_lock" ] || die "session '$1' has an active turn and cannot be deleted."
  if [ "$(jq -r '.version // 1' "$meta")" = 2 ] && [ "$(jq -r .mode "$meta")" = implement ]; then
    dir="$(impl_dir "$rid" "$1")"; manifest="$dir/owner.json"
    same_path "$meta" "$dir/metadata.json" && [ -f "$manifest" ] || die "refusing to delete untrusted implementation state."
    jq -e --arg dir "$dir" --arg meta "$meta" '.version==1 and .owner_dir==$dir and .metadata==$meta' "$manifest" >/dev/null 2>&1 \
      || die "refusing to delete an implementation directory with an invalid owner manifest."
    for f in "$dir"/* "$dir"/.[!.]*; do
      [ -e "$f" ] || continue; base="$(basename "$f")"
      case "$base" in
        owner.json|metadata.json|cumulative.patch|.tmp.*|.cumulative.*) ;;
        cumulative-*.patch) printf '%s' "$base" | grep -Eq '^cumulative-[0-9]+-[0-9a-f]{64}\.patch$' \
          || die "implementation state directory contains an unowned file and was left in place: $f" ;;
        *) die "implementation state directory contains an unowned file and was left in place: $f" ;;
      esac
    done
    rm -f "$dir"/metadata.json "$dir"/owner.json "$dir"/cumulative.patch "$dir"/cumulative-*.patch "$dir"/.tmp.* "$dir"/.cumulative.*
    rmdir "$dir" || die "implementation state directory contains unowned files and was left in place: $dir"
  else rm -f "$meta"; release_boundary "$(repo_root)" "qwen-$1"; fi
  note "deleted local session record '$1'. Human-facing review and patch files were kept."
}
cmd_transcript() {
  local sid qwen repo dir out tmp source base; repo="$(repo_root)"
  sid="$(jq -r .qwen_session_id "$(find_meta "$(repo_id "$repo")" "$1")")"
  qwen="$(resolve_qwen)"
  base="qwen-$1-$(date -u +%Y%m%dT%H%M%SZ)-$$.jsonl"; dir="$(reviews_dir "$repo" "$base")"; [ -n "$dir" ] || die "cannot export: exact destination is not safely git-ignored."
  mkdir -p "$dir"; out="$dir/$base"; tmp="$out.partial"
  [ ! -e "$out" ] || die "refusing to replace existing archive: $out"
  source="$(qwen_local "$qwen" sessions list --json --limit 1000 2>/dev/null | jq -r --arg sid "$sid" 'select(.sessionId==$sid)|.filePath' | tail -1)"
  [ -n "$source" ] || die "Qwen session $sid was not found in its project-scoped store."
  if command -v cygpath >/dev/null 2>&1 && printf '%s' "$source" | grep -Eq '^[A-Za-z]:|\\'; then source="$(cygpath -u "$source")"; fi
  [ -f "$source" ] || die "Qwen session file is missing: $source"
  cp "$source" "$tmp" || { rm -f "$tmp"; die "could not copy the Qwen session transcript"; }
  chmod 0600 "$tmp" 2>/dev/null || true; mv "$tmp" "$out"
  note "Qwen transcript copy written inside the ignored review directory: $out"
}

cmd_implement() {
  local name="$1" rid meta=""
  rid="$(repo_id "$(repo_root)")"
  meta="$(find_meta_optional "$rid" "$name")" || meta=""
  if [ -n "$meta" ]; then
    if [ "$(jq -r '.mode // ""' "$meta")" = implement ]; then
      rid="$(rid_from_meta "$meta")"; continue_implementation "$name" "$rid" "$meta"
    else
      die "session '$name' is a review session. Choose a different name for implementation."
    fi
  elif [ -f "$(meta_path "$rid" "$name")" ]; then
    meta="$(meta_path "$rid" "$name")"
    [ "$(jq -r '.mode // ""' "$meta")" = implement ] && continue_implementation "$name" "$rid" "$meta"
    die "session '$name' is a review session. Choose a different name for implementation."
  else start_session "$name" implement; fi
}

cmd_reset_context() {
  local rid meta
  rid="$(repo_id "$(repo_root)")"; meta="$(find_meta "$rid" "$1")"
  [ "$(jq -r '.mode // ""' "$meta")" = implement ] || die "reset-context applies only to implementation sessions."
  rid="$(rid_from_meta "$meta")"
  continue_implementation "$1" "$rid" "$meta" 1
}

# ---------------------------------------------------------------------------
CMD="${1:-}"; shift || true
ARG=""; OPT_PROMPT=""; OPT_PROMPT_FILE=""; OPT_JSON=0; OPT_LIVE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt)      OPT_PROMPT="${2:-}"; shift 2 ;;
    --prompt-file) OPT_PROMPT_FILE="${2:-}"; shift 2 ;;
    --json)        OPT_JSON=1; shift ;;
    --live)        OPT_LIVE="--live"; shift ;;
    -h|--help)     usage; exit 0 ;;
    --*)           die "unknown option '$1'. This wrapper deliberately does not forward arbitrary qwen flags; if you need a capability it lacks, say so rather than calling qwen directly." ;;
    *)             [ -z "$ARG" ] && ARG="$1" || die "unexpected argument '$1'"; shift ;;
  esac
done
need jq

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-qwen new <name> …";       start_session "$ARG" review ;;
  implement)  [ -n "$ARG" ] || die "usage: ai-qwen implement <name> …"; cmd_implement "$ARG" ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-qwen ask <name> …";       cmd_ask "$ARG" ;;
  list)       cmd_list ;;
  show)       [ -n "$ARG" ] || die "usage: ai-qwen show <name>";        cmd_show "$ARG" ;;
  transcript) [ -n "$ARG" ] || die "usage: ai-qwen transcript <name>";  cmd_transcript "$ARG" ;;
  delete)     [ -n "$ARG" ] || die "usage: ai-qwen delete <name>";      cmd_delete "$ARG" ;;
  reset-context) [ -n "$ARG" ] || die "usage: ai-qwen reset-context <name> …"; cmd_reset_context "$ARG" ;;
  doctor)     cmd_doctor "$OPT_LIVE" ;;
  -h|--help|help|"") usage; [ -z "$CMD" ] && exit 2 || exit 0 ;;
  *)          printf 'unknown command: %s\n\n' "$CMD" >&2; usage >&2; exit 2 ;;
esac
