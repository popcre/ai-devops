#!/usr/bin/env bash
# ai-install-post-merge-hook - install or remove the managed reviewer
# auto-requalification post-merge hook (#804).
#
# WHY THIS EXISTS
# Pulling new reviewer wrapper code invalidates the affected reviewer's live
# qualification; without the hook it stays quarantined until a person
# re-qualifies by hand. Both installers and uninstall.sh call this one script
# so the ownership rules exist exactly once and can be behaviorally tested:
#
#   - a hook carrying the managed marker is refreshed (or removed) by us;
#   - a hook without the marker is foreign and is never touched;
#   - removal additionally requires the bytes to still match the shipped
#     hooks/post-merge, so a drifted managed hook is preserved for review.
#
# Exit status is nonzero whenever an owned action fails; --dry-run writes
# nothing and only prints what it would do.
set -euo pipefail

VERSION="1.0.0"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE=install
REPO=""
DRY_RUN=0

die() { printf 'ai-install-post-merge-hook: error: %s\n' "$*" >&2; exit 1; }
note() { printf 'ai-install-post-merge-hook: %s\n' "$*"; }

usage() {
  cat <<EOF
Usage:
  ai-install-post-merge-hook [--repo PATH]            install or refresh
  ai-install-post-merge-hook --remove [--repo PATH]   remove when owned
  ai-install-post-merge-hook --dry-run [--remove] [--repo PATH]
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:-}"; shift 2 ;;
    --remove) MODE=remove; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option '$1'." ;;
  esac
done
[ -n "$REPO" ] || REPO="$REPO_ROOT"

hook_source="$REPO_ROOT/hooks/post-merge"
[ -f "$hook_source" ] || die "shipped hooks/post-merge is missing from $REPO_ROOT."
git_dir="$(git -C "$REPO" rev-parse --git-common-dir 2>/dev/null)" || die "not a git repository: $REPO"
case "$git_dir" in /*) ;; *) git_dir="$REPO/$git_dir" ;; esac
hooks_dir="$git_dir/hooks"
hook_target="$hooks_dir/post-merge"
marker='^# ai-devops-managed: reviewer auto-requalification'

managed() {
  [ -f "$hook_target" ] && grep -q "$marker" "$hook_target" 2>/dev/null
}

act() { # DESCRIPTION COMMAND...
  local description="$1"; shift
  if [ "$DRY_RUN" -eq 1 ]; then
    note "[dry-run] $description"
  else
    "$@"
    note "$description"
  fi
}

case "$MODE" in
  install)
    if [ -e "$hook_target" ] && ! managed; then
      note "leaving foreign post-merge hook untouched: $hook_target"
      exit 0
    fi
    [ "$DRY_RUN" -eq 1 ] || mkdir -p "$hooks_dir"
    act "installed post-merge reviewer auto-requalification hook: $hook_target" \
      cp "$hook_source" "$hook_target"
    [ "$DRY_RUN" -eq 1 ] || chmod +x "$hook_target"
    ;;
  remove)
    if ! managed; then
      note "no owned post-merge hook present at $hook_target"
      exit 0
    fi
    if ! cmp -s "$hook_source" "$hook_target"; then
      note "preserving drifted managed post-merge hook for review: $hook_target"
      exit 0
    fi
    act "removed owned post-merge hook: $hook_target" \
      rm -f -- "$hook_target"
    ;;
esac
