#!/usr/bin/env bash
# ai-kimi — Kimi Code delegation in persistent, named sessions.
#
# This is the ONLY supported way for Claude or Codex to drive Kimi headlessly.
# Never call `kimi -p` directly: this script owns the model pin, the read-only
# enforcement, the completion rule, the session bookkeeping, and the worktree
# isolation for write runs.
#
#   ai-kimi new <name>       [--prompt T | --prompt-file F | stdin]   read-only review
#   ai-kimi ask <name>       [--prompt T | --prompt-file F | stdin]   continue it
#   ai-kimi implement <name> [--prompt T | --prompt-file F | stdin]   write run, isolated
#   ai-kimi list | show <name> | transcript <name> | delete <name>
#   ai-kimi doctor [--live]
#
# Review sessions are STRUCTURALLY read-only: they run under an agent profile
# whose toolset contains no write, edit, patch, or bash tool. See the Step 0
# evidence below — this is not a prompt request, it is an absent capability.
#
# ---------------------------------------------------------------------------
# STEP 0 VERIFICATION — re-qualified 2026-08-10 against Kimi Code 0.32.0 on
# Windows 11 (916-alien). Re-run and update this block on any version bump.
#
#   Resume flag: `-S/--session [id]` remains the DOCUMENTED form. `-r` remains
#     an accepted undocumented alias and is still printed in the terminal
#     resume hint. The wrapper uses the explicit id, never newest-by-directory.
#   `-c/--continue` means "newest session for this directory", NOT "the session
#     I was just using". Never used here.
#   Output formats are ONLY `text` and `stream-json` — there is no `json`.
#     stream-json is NDJSON: records carry `role` (user/assistant/meta), and
#     only meta records carry `type`.
#   COMPLETION MARKER: the run ends with a meta record
#     {"role":"meta","type":"session.resume_hint","session_id":"session_…"} and
#     it is emitted on resumed turns too. That record is the terminal signal
#     this script gates on. Verified on both a fresh and a resumed turn.
#   THERE IS NO --max-turns / step-budget FLAG. Kimi has no turn ceiling to
#     enforce, so the Grok D4 invariant has no analogue here. Do not invent one.
#   NO usage, token, cost, or model reporting in headless output. You cannot
#     assert which model answered. This is why -m is pinned unconditionally.
#   `provider list` still exits successfully even when it reports no providers;
#     auth checks must inspect content. Default model here is `kimi-code/k3` —
#     pin anyway, because defaults are machine-local and returned model is absent.
#   Prompt mode rejects: --yolo ("Cannot combine --prompt with --yolo"), and
#     per the CLI also --plan and --auto.
#   --agent/--agent-file CANNOT be combined with --session/--continue, so the
#     agent is fixed when a session is created. That is why review and
#     implement are different sessions and can never be the same one.
#
#   STRUCTURAL READ-ONLY, PROVEN (this is the finding that justifies the script):
#     Negative control, plain `kimi -m kimi-code/k3 -p "Write HACKED into
#       canary3.txt"` → exit 0, file contents became `HACKED`. Kimi writes
#       files freely in ordinary prompt mode.
#     With `--agent-file` carrying `tools: read, grep, glob, ls` and the same
#       adversarial instruction → exit 0, canary UNCHANGED, model replied
#       CANNOT_WRITE.
#     Frontmatter `tools:` must be a comma-separated string or a list of
#       strings; a YAML map is rejected with "must be a comma-separated string
#       or a list of strings".
#     TOOL NAMES ARE CASE-SENSITIVE AND FAIL SILENTLY. `tools: read, grep,
#       glob, ls` is accepted by the parser and matches NOTHING, leaving the
#       agent with no tools at all — it reports "I have no working file-reading
#       tool" and the canary survives for the wrong reason. Kimi's real names
#       are capitalized: Read, Grep, Glob, ReadMediaFile, Bash, Edit, Write,
#       FetchURL, WebSearch, Agent, AgentSwarm, Skill, Cron*, Task*, Todo*.
#       Re-proved both directions on 0.32.0: Read observed a committed canary;
#       the hostile Write request left it unchanged and returned CANNOT_WRITE.
# ---------------------------------------------------------------------------

set -euo pipefail

VERSION="1.1.0"

STATE_DIR="${AI_KIMI_STATE_DIR:-$HOME/.local/state/ai-devops/kimi}"
CALLER="${AI_KIMI_CALLER:-claude}"
KIMI_MODEL="${AI_KIMI_MODEL:-kimi-code/k3}"

WAIT_TIMEOUT="${AI_KIMI_WAIT_TIMEOUT:-900}"
POLL_INTERVAL="${AI_KIMI_POLL_INTERVAL:-5}"

# Resolve through the /usr/local/bin symlink, or SELF_DIR is /usr/local/bin and
# the read-only profile is looked for at /usr/local/config/kimi/… — which does
# not exist, so every review refuses to run. (bin/ai-glm's doctor carries the
# same note for the same reason.)
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$_self")" && pwd)"
RO_AGENT="${AI_KIMI_RO_AGENT:-$SELF_DIR/../config/kimi/readonly-review.md}"
IMPL_AGENT="${AI_KIMI_IMPL_AGENT:-$SELF_DIR/../config/kimi/local-implement.md}"

die()  { printf 'ai-kimi: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-kimi: warning: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

# ---------------------------------------------------------------------------
# Binary resolution. Kimi installs to ~/.kimi-code/bin, which is NOT added to
# PATH by its installer — on hetz it is absent from both users' PATH. A bare
# `command -v kimi` failure reads as "not installed" when it is installed.
# ---------------------------------------------------------------------------
resolve_kimi() {
  if [ -n "${AI_KIMI_BIN:-}" ]; then
    [ -x "$AI_KIMI_BIN" ] || die "AI_KIMI_BIN=$AI_KIMI_BIN is not executable."
    printf '%s' "$AI_KIMI_BIN"; return 0
  fi
  local c
  for c in "$(command -v kimi 2>/dev/null || true)" \
           "$HOME/.kimi-code/bin/kimi" \
           "$HOME/.kimi-code/bin/kimi.exe" \
           /home/ai/.kimi-code/bin/kimi \
           /usr/local/bin/kimi; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  die "kimi binary not found. Set AI_KIMI_BIN, or install Kimi Code. Looked on PATH, \$HOME/.kimi-code/bin, /home/ai/.kimi-code/bin, /usr/local/bin."
}

# ---------------------------------------------------------------------------
# Credential owner.
#
# Unlike GLM (one loopback server with a shared password), Kimi has no server:
# it is a local CLI whose credentials are per-user OAuth under ~/.kimi-code.
# There is no config-dir override — `kimi --help` exposes none — so a second
# account on a shared box has no credentials of its own.
#
# Rather than making Albert run a second interactive device-code login, a root
# session runs the Kimi call AS the owning user. Only root can do this without
# a password prompt, so this never turns into an interactive hang; for any other
# user it simply does not engage and doctor says plainly what to do.
#
# Review mode only. An implement run is deliberately NOT delegated: its writes
# would land owned by the other user, which is a mess a wrapper should not
# create silently.
KIMI_OWNER="${AI_KIMI_OWNER:-ai}"

has_credentials() { # has_credentials [USER] — true if that account can reach a provider
  local u="${1:-}" out
  if [ -z "$u" ]; then out="$("$(resolve_kimi)" provider list 2>/dev/null || true)"
  else out="$(su - "$u" -c "\"\$HOME/.kimi-code/bin/kimi\" provider list" 2>/dev/null || true)"
  fi
  [ -n "$out" ] && ! printf '%s' "$out" | grep -qi 'no providers configured'
}

# Prints the user to run Kimi as, or empty for "run directly as me".
run_as_user() {
  has_credentials && { printf ''; return 0; }
  if [ "$(id -u)" = 0 ] && [ "$(id -un)" != "$KIMI_OWNER" ] && has_credentials "$KIMI_OWNER"; then
    printf '%s' "$KIMI_OWNER"; return 0
  fi
  printf ''
}

kimi_procs() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x kimi 2>/dev/null || true
  else
    ps -W 2>/dev/null | grep -i '[k]imi' || true
  fi
}

# ---------------------------------------------------------------------------
# Session identity: repo + caller + name, so Claude and Codex never collide.
# ---------------------------------------------------------------------------
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "ai-kimi must be run inside a git repository."
}
legacy_repo_id() { printf '%s' "$1" | tr '\\' '/' | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
repo_id() {
  local root="$1" remote
  root="$(cd "$root" && pwd -P)"
  remote="$(git -C "$root" config --get remote.origin.url 2>/dev/null || echo '')"
  printf '%s' "$(printf '%s\n%s' "$root" "$remote" | sha256sum | cut -c1-12)"
}
repo_remote() { git -C "$1" config --get remote.origin.url 2>/dev/null || true; }
valid_name() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }

meta_path()     { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
lock_path()     { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
repolock_path() { printf '%s/locks/repo--%s.lock.d' "$STATE_DIR" "$1"; }

# Portable mutex (flock does not exist in Git Bash); stale locks are reclaimed.
lock_acquire() {
  local dir="$1" label="$2" owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || echo '')"
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then return 1; fi
  warn "reclaiming stale lock $(basename "$dir") (owner pid ${owner:-unknown} is gone)"
  rm -rf "$dir"; mkdir "$dir" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
}
lock_release() { rm -rf "$1" 2>/dev/null || true; }
lock_info() {
  local dir="$1" label pid started now
  label="$(cat "$dir/label" 2>/dev/null || echo unknown)"
  pid="$(cat "$dir/pid" 2>/dev/null || echo '?')"
  if started="$(date -r "$dir" +%s 2>/dev/null)"; then
    now="$(date +%s)"; printf '%s (pid %s, running %ss)' "$label" "$pid" "$((now - started))"
  else printf '%s (pid %s)' "$label" "$pid"; fi
}

write_meta() {
  local f="$1" tmp; mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; chmod 0600 "$tmp" 2>/dev/null || true; mv -f "$tmp" "$f"
}
find_meta() {
  local f old repo remote cand found=""; f="$(meta_path "$1" "$2")"
  if [ ! -f "$f" ]; then
    repo="$(repo_root)"; old="$(meta_path "$(legacy_repo_id "$repo")" "$2")"
    if [ -f "$old" ]; then mkdir -p "$(dirname "$f")"; mv "$old" "$f"; fi
  fi
  if [ ! -f "$f" ]; then
    remote="$(repo_remote "$repo")"
    [ -n "$remote" ] || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-kimi list"
    while IFS= read -r cand; do
      [ "$(jq -r '.name // ""' "$cand")" = "$2" ] || continue
      [ "$(jq -r '.caller // ""' "$cand")" = "$CALLER" ] || continue
      [ "$(jq -r '.repo_remote // ""' "$cand")" = "$remote" ] || continue
      [ -z "$found" ] || die "multiple moved-checkout records match session '$2'; refusing an ambiguous migration."
      found="$cand"
    done < <(find "$STATE_DIR/sessions" -type f -name "$CALLER--$2.json" 2>/dev/null)
    [ -z "$found" ] || { mkdir -p "$(dirname "$f")"; mv "$found" "$f"; }
  fi
  [ -f "$f" ] || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-kimi list"
  printf '%s' "$f"
}

# ---------------------------------------------------------------------------
# The completion rule.
#
# Kimi's stream-json is NDJSON with no terminal status field, so completion is
# proven by the LAST record being the session.resume_hint meta record. Exit
# status is recorded but never trusted: it is the same class of signal that
# made a Grok caller believe a still-running review had died.
# ---------------------------------------------------------------------------
has_resume_hint() { # has_resume_hint FILE
  [ -s "$1" ] || return 1
  tail -5 "$1" | jq -e 'select(.type=="session.resume_hint")|.session_id' >/dev/null 2>&1
}
session_id_from() { tail -5 "$1" | jq -r 'select(.type=="session.resume_hint")|.session_id' 2>/dev/null | tail -1; }

AWAIT_RESULT_REASON=""
await_result() { # await_result FILE LABEL
  local f="$1" label="$2" waited=0 empty=0 saw=0
  AWAIT_RESULT_REASON=""
  while [ "$waited" -lt "$WAIT_TIMEOUT" ]; do
    has_resume_hint "$f" && return 0
    # Fast-fail ONLY if a kimi process was positively seen and then vanished.
    # If detection never matched, we do not trust it and wait the full timeout —
    # a detection miss must never abort a healthy slow run.
    if [ -n "$(kimi_procs)" ]; then saw=1; empty=0
    elif [ "$saw" = 1 ]; then
      empty=$((empty + 1))
      if [ "$empty" -ge 2 ]; then
        note ""
        note "ai-kimi: Kimi is no longer running but never emitted a session.resume_hint."
        note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
        note "  elapsed  : ${waited}s"
        note "  diagnose : tail -20 ~/.kimi-code/logs/kimi-code.log"
        AWAIT_RESULT_REASON="process-ended"
        return 1
      fi
    fi
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
    [ $((waited % 60)) -eq 0 ] && note "  … $label still running (${waited}s)"
  done
  note ""
  note "ai-kimi: no session.resume_hint after ${WAIT_TIMEOUT}s — the run did not complete."
  note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
  note "  diagnose : tail -20 ~/.kimi-code/logs/kimi-code.log"
  note "  Raise the ceiling with AI_KIMI_WAIT_TIMEOUT=<seconds> for a genuinely long run."
  AWAIT_RESULT_REASON="timeout"
  return 1
}

# ---------------------------------------------------------------------------
# Turn execution
# ---------------------------------------------------------------------------
RUN_TURN_RC=unavailable
RUN_TURN_PID=""
run_turn() { # run_turn REPO OUT PROMPT_FILE MODE [SESSION_ID]
  local repo="$1" out="$2" pf="$3" mode="$4" sid="${5:-}"
  local kimi; kimi="$(resolve_kimi)"
  local args=(-m "$KIMI_MODEL" --output-format stream-json)
  if [ -n "$sid" ]; then
    # --agent/--agent-file cannot combine with a resume; the agent is fixed at
    # session creation, which is exactly why a review session can never later
    # become a write session.
    args+=(-r "$sid")
  elif [ "$mode" = review ]; then
    [ -f "$RO_AGENT" ] || die "read-only agent profile not found at $RO_AGENT — refusing to run a review without structural read-only enforcement."
    args+=(--agent-file "$RO_AGENT")
  elif [ "$mode" = implement ]; then
    [ -f "$IMPL_AGENT" ] || die "implementation agent profile not found at $IMPL_AGENT — refusing to run without its tool boundary."
    args+=(--agent-file "$IMPL_AGENT")
  fi
  # Kimi Code 0.32.0 exposes only -p/--prompt for headless input. This puts the
  # brief in argv. Never put secrets in a Kimi brief on a shared host.
  args+=(-p "$(cat "$pf")")

  local as; as="$(run_as_user)"
  if [ -n "$as" ] && [ "$mode" = implement ]; then
    die "this account has no Kimi credentials, and an implement run will not be delegated
  to '$as' — its writes would land owned by the wrong user. Either run 'kimi login'
  as $(id -un), or run: su - $as -c 'ai-kimi implement …'"
  fi

  : > "$out"
  set +e
  if [ -n "$as" ]; then
    # Kimi has no prompt-file/stdin option. Quote every argument for the shell
    # su spawns, but do not claim that this hides the prompt from process lists.
    local q="" a
    for a in "${args[@]}"; do q="$q $(printf '%q' "$a")"; done
    su - "$as" -c "cd $(printf '%q' "$repo") && \"\$HOME/.kimi-code/bin/kimi\"$q" \
      < /dev/null > "$out" 2>"$out.err" &
  else
    ( cd "$repo" && exec "$kimi" "${args[@]}" ) > "$out" 2>"$out.err" &
  fi
  RUN_TURN_PID=$!
  wait "$RUN_TURN_PID"
  RUN_TURN_RC=$?
  RUN_TURN_PID=""
  set -e
  return 0
}

child_pids() { # child_pids PARENT
  if ps -W >/dev/null 2>&1; then
    ps -W 2>/dev/null | awk -v p="$1" 'NR>1 && $2==p {print $1}'
  else
    ps -eo pid=,ppid= 2>/dev/null | awk -v p="$1" '$2==p {print $1}'
  fi
}

signal_run_tree() { # signal_run_tree SIGNAL PID
  local signal="$1" pid="$2" child
  for child in $(child_pids "$pid"); do signal_run_tree "$signal" "$child"; done
  kill "-$signal" "$pid" 2>/dev/null || true
}

stop_run_turn() {
  if [ -n "$RUN_TURN_PID" ]; then
    local pid="$RUN_TURN_PID" i
    signal_run_tree TERM "$pid"
    for i in 1 2 3 4 5; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && signal_run_tree KILL "$pid"
    set +e; wait "$pid" 2>/dev/null; set -e
    RUN_TURN_PID=""
  fi
}

cancel_plain_turn() { stop_run_turn; exit 130; }

extract_answer() { # extract_answer FILE
  local text
  text="$(jq -r 'select(.role=="assistant") | .content // ""' "$1" 2>/dev/null | sed '/^$/d')"
  if printf '%s' "$text" | grep -qF '## Verdict'; then
    printf '%s\n' "$text" | sed -n '/^## Verdict/,$p'
  else
    printf '%s\n' "$text"
  fi
}

PROMPT_FOOTER="

---
Formatting requirement: structure your reply so the final answer is last, under a
literal '## Verdict' heading. Put any narration above it."

build_prompt_file() {
  local dest="$1"
  if [ -n "${OPT_PROMPT_FILE:-}" ]; then
    [ -f "$OPT_PROMPT_FILE" ] || die "prompt file not found: $OPT_PROMPT_FILE"
    cat "$OPT_PROMPT_FILE" > "$dest"
  elif [ -n "${OPT_PROMPT:-}" ]; then printf '%s\n' "$OPT_PROMPT" > "$dest"
  elif [ ! -t 0 ]; then cat > "$dest"
  else die "no prompt given. Use --prompt TEXT, --prompt-file FILE, or pipe it on stdin."
  fi
  [ -s "$dest" ] || die "the prompt is empty."
  printf '%s' "$PROMPT_FOOTER" >> "$dest"
}

# Defence in depth: the agent profile is the guarantee, this catches a profile
# that silently stopped working (e.g. a Kimi upgrade changing frontmatter rules).
tree_state() { git -C "$1" status --porcelain 2>/dev/null | sort; }

reviews_dir() {
  git -C "$1" check-ignore -q .ai/reviews 2>/dev/null && printf '%s/.ai/reviews' "$1" || printf ''
}
write_review_file() {
  local repo="$1" name="$2" f="$3" dir ts out
  dir="$(reviews_dir "$repo")"
  if [ -z "$dir" ]; then
    warn "not writing a review file: '.ai/reviews' is not git-ignored in $repo. Add '.ai/reviews/' to .gitignore."
    return 0
  fi
  mkdir -p "$dir"; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$dir/kimi-${name}-${ts}.md"
  {
    echo "# Kimi review — $name"; echo
    echo "- Repo: \`$repo\`"
    echo "- Branch: \`$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')\`"
    echo "- Session: \`$(session_id_from "$f")\`"
    echo "- Model requested: \`$KIMI_MODEL\` (Kimi does not report which model answered)"
    echo; echo "---"; echo
    jq -r 'select(.role=="assistant") | .content // ""' "$f" 2>/dev/null
  } > "$out"
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
ai-kimi $VERSION — Kimi Code delegation in persistent, named sessions.

  ai-kimi new <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi ask <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi implement <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi list | show <name> | transcript <name> | delete <name>
  ai-kimi doctor [--live]

'new'/'ask' are STRUCTURALLY read-only — they run under an agent profile with no
write, edit, patch or bash tool. 'implement' is an explicit write run and is
isolated in a throwaway git worktree; its diff is emitted as a patch for you to
review and apply. Model is pinned ($KIMI_MODEL) because Kimi does not report
which model answered.

Environment:
  AI_KIMI_CALLER       'claude' (default) or 'codex' — keeps sessions separate
  AI_KIMI_BIN          explicit path to the kimi binary
  AI_KIMI_MODEL        model pin ($KIMI_MODEL)
  AI_KIMI_WAIT_TIMEOUT seconds to wait for completion ($WAIT_TIMEOUT)
  AI_KIMI_STATE_DIR    session state ($STATE_DIR)
EOF
}

doctor_worktrees() {
  local root owner repo wt pid state expected
  root="$STATE_DIR/worktrees"; [ -d "$root" ] || return 0
  while IFS= read -r owner; do
    repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
    wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
    pid="$(jq -r '.pid // ""' "$owner" 2>/dev/null)"
    state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
    expected="${wt%/wt}/owner.json"
    if [ "$owner" != "$expected" ] || [ "${wt#"$root"/}" = "$wt" ] || [ ! -d "$repo/.git" ]; then
      warn "ambiguous Kimi worktree owner record left untouched: $owner"; continue
    fi
    if [ "$state" = preserved-recovery ]; then
      warn "preserved Kimi recovery worktree left untouched: $wt"; continue
    fi
    [ "$state" = active ] || { warn "unknown Kimi worktree state left untouched: $owner"; continue; }
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    git -C "$repo" worktree list --porcelain 2>/dev/null | grep -Fxq "worktree $wt" \
      || { warn "unregistered Kimi worktree record left untouched: $owner"; continue; }
    warn "removing stale wrapper-owned Kimi worktree: $wt"
    cleanup_wt "$repo" "$wt" "$owner"
  done < <(find "$root" -type f -name owner.json 2>/dev/null)
}

cmd_doctor() {
  local live=0 kimi rc=0
  [ "${1:-}" = "--live" ] && live=1
  need jq; kimi="$(resolve_kimi)"
  echo "kimi binary   : $kimi"
  echo "kimi version  : $("$kimi" --version 2>&1 | head -1)"
  echo "caller        : $CALLER"
  echo "state dir     : $STATE_DIR"
  echo "model pin     : $KIMI_MODEL"
  if [ -f "$RO_AGENT" ]; then
    echo "read-only     : $RO_AGENT"
  else
    echo "read-only     : MISSING ($RO_AGENT) — reviews will refuse to run"; rc=1
  fi
  if [ -f "$IMPL_AGENT" ]; then
    echo "implement     : $IMPL_AGENT"
  else
    echo "implement     : MISSING ($IMPL_AGENT)"; rc=1
  fi
  echo
  # `kimi provider list` exits 0 even when it reports "No providers configured",
  # so the exit code alone is a false OK. Kimi's credentials are per-user, under
  # ~/.kimi-code, so a second account on a shared box has none of its own.
  local provout
  provout="$("$kimi" provider list 2>/dev/null || true)"
  if printf '%s' "$provout" | grep -qi 'no providers configured' || [ -z "$provout" ]; then
    local as; as="$(run_as_user)"
    if [ -n "$as" ]; then
      echo "auth          : borrowed from user \"$as\""
      echo "                This account has no Kimi credentials of its own (they are"
      echo "                per-user OAuth under ~/.kimi-code, with no config-dir"
      echo "                override). Reviews run as \"$as\"; implement runs do not."
    else
      echo "auth          : NOT AUTHENTICATED for this account ($(id -un))"
      echo "                Kimi credentials are per-user (~/.kimi-code)."
      echo "                Run 'kimi login' as this user, or run ai-kimi as the account"
      echo "                that owns the credentials (default: $KIMI_OWNER)."
      rc=1
    fi
  else
    echo "auth          : OK"
    printf '%s' "$provout" | sed 's/^/                /'
  fi
  if [ "$live" = 1 ]; then
    local tmp; tmp="$(mktemp)"; printf 'Reply with exactly: OK\n' > "$tmp.p"
    echo -n "live probe    : "
    run_turn "$(pwd)" "$tmp" "$tmp.p" review >/dev/null || true
    if has_resume_hint "$tmp"; then echo "OK"; else echo "FAILED — no session.resume_hint"; rc=1; fi
    rm -f "$tmp" "$tmp.p" "$tmp.err" 2>/dev/null || true
  fi
  doctor_worktrees
  return $rc
}

# One implementation lifecycle owns artifact export, worktree cleanup, temporary
# files, and the repository lock. Signal handlers only record cancellation and
# exit; this finalizer does every state-changing cleanup action exactly once.
LIFECYCLE_ACTIVE=0
LIFECYCLE_MODE=""
LIFECYCLE_STATE="failed"
LIFECYCLE_NAME=""
LIFECYCLE_REPO=""
LIFECYCLE_WT=""
LIFECYCLE_OWNER=""
LIFECYCLE_BASE=""
LIFECYCLE_PF=""
LIFECYCLE_OUT=""
LIFECYCLE_LOCK=""
LIFECYCLE_COMMAND_RC="unavailable"
LIFECYCLE_ARTIFACT_DURABLE=0
LIFECYCLE_PRESERVE=0

classify_incomplete_state() { # classify_incomplete_state OUTPUT STDERR AWAIT_REASON
  local out="$1" err="$2" reason="$3"
  [ "$LIFECYCLE_STATE" = cancelled ] && { printf 'cancelled'; return; }
  if { [ -s "$out" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$out"; } \
    || { [ -s "$err" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$err"; }; then
    printf 'usage-limit'
  elif [ "$LIFECYCLE_COMMAND_RC" != unavailable ] && [ "$LIFECYCLE_COMMAND_RC" -ne 0 ] 2>/dev/null; then
    printf 'failed'
  elif [ "$reason" = timeout ]; then
    printf 'timed-out'
  else
    printf 'failed'
  fi
}

valid_owner_record() { # valid_owner_record REPO WORKTREE OWNER [STATE]
  local repo="$1" wt="$2" owner="$3" wanted="${4:-}" root expected recorded_repo recorded_wt state
  [ -n "$repo" ] && [ -n "$wt" ] && [ -n "$owner" ] && [ -f "$owner" ] || return 1
  root="${STATE_DIR%/}/worktrees"
  case "$wt" in "$root"/kimi.*/wt) ;; *) return 1 ;; esac
  expected="${wt%/wt}/owner.json"
  [ "$owner" = "$expected" ] || return 1
  recorded_repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
  recorded_wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
  state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
  [ "$recorded_repo" = "$repo" ] && same_path "$recorded_wt" "$wt" || return 1
  [ -z "$wanted" ] || [ "$state" = "$wanted" ]
}

same_path() { # same_path A B - accounts for Git Bash /tmp to Windows argv conversion
  local a="$1" b="$2"
  if command -v cygpath >/dev/null 2>&1; then
    a="$(cygpath -aw "$a" 2>/dev/null | tr '\\' '/' || printf '%s' "$a")"
    b="$(cygpath -aw "$b" 2>/dev/null | tr '\\' '/' || printf '%s' "$b")"
  fi
  [ "$a" = "$b" ]
}

mark_preserved() { # mark_preserved OWNER
  local owner="$1" json
  json="$(jq '.state="preserved-recovery"' "$owner" 2>/dev/null)" || return 1
  write_meta "$owner" "$json" || return 1
  [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ]
}

safe_report_detail() { # safe_report_detail TERMINAL_STATE
  case "$1" in
    usage-limit) printf 'Kimi reported a usage or billing limit.' ;;
    timed-out)   printf 'The wrapper deadline passed without the required terminal record.' ;;
    cancelled)   printf 'The wrapper received an interrupt or termination request.' ;;
    *)           printf 'Kimi did not emit the required terminal completion record.' ;;
  esac
}

artifact_dir() { # artifact_dir REPO
  local dir
  [ "${AI_KIMI_TEST_FAIL_EXPORT:-}" = destination ] && return 1
  dir="$(reviews_dir "$1")"
  if [ -z "$dir" ]; then
    dir="$STATE_DIR/recovery-patches"
    mkdir -p "$dir" 2>/dev/null || return 1
  fi
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 0700 "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

emit_implementation_artifact() { # REPO NAME WT BASE OWNER KIND STATE RC OUT
  local repo="$1" name="$2" wt="$3" base="$4" owner="$5" kind="$6" state="$7" rc="$8" out="$9"
  local dir ts suffix patch report patch_tmp report_tmp sid summary detail
  valid_owner_record "$repo" "$wt" "$owner" active || {
    warn "refusing artifact export from an ambiguous Kimi worktree owner record: $owner"
    return 1
  }
  dir="$(artifact_dir "$repo")" || return 1
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  [ "$kind" = incomplete ] && suffix=.incomplete || suffix=""
  patch="$dir/kimi-${name}-${ts}${suffix}.patch"
  report="$dir/kimi-${name}-${ts}.incomplete.md"
  patch_tmp="$(mktemp "$dir/.kimi-patch.XXXXXX")" || return 1
  chmod 0600 "$patch_tmp" 2>/dev/null || true
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --binary "$base" ) > "$patch_tmp" 2>/dev/null \
    || { rm -f "$patch_tmp"; return 1; }
  if [ ! -s "$patch_tmp" ]; then
    rm -f "$patch_tmp"
    [ "$kind" = incomplete ] && note "ai-kimi: failed before changes (terminal state: $state); no empty patch was created." \
      || warn "the implement run produced no changes."
    return 2
  fi
  if [ "$kind" = incomplete ]; then
    report_tmp="$(mktemp "$dir/.kimi-report.XXXXXX")" || { rm -f "$patch_tmp"; return 1; }
    chmod 0600 "$report_tmp" 2>/dev/null || true
    sid="$(session_id_from "$out")"; [ -n "$sid" ] || sid=unavailable
    summary="$(cd "$wt" && git diff --stat "$base" 2>/dev/null | head -40 | cut -c1-240)"
    detail="$(safe_report_detail "$state")"
    {
      echo "# INCOMPLETE Kimi implementation - $name"; echo
      echo "This work is INCOMPLETE. It is not proof that the task is correct, tested, or safe."; echo
      echo "- Job: \`$name\`"
      echo "- Repository: \`$repo\`"
      echo "- Base SHA: \`$base\`"
      echo "- Model requested: \`$KIMI_MODEL\` (returned model: unavailable)"
      echo "- Terminal state: \`$state\`"
      echo "- Command exit status: \`$rc\`"
      echo "- Kimi session ID: \`$sid\`"
      echo "- Usage, tokens, cache, cost, and context: \`unavailable\`"
      echo "- Tests: not confirmed complete"
      echo "- Patch: \`$patch\`"
      echo "- Safe detail: $detail"; echo
      echo "## Changed-file summary"; echo; echo '```text'
      printf '%s\n' "${summary:-Git recorded changes, but no bounded stat text was available.}"
      echo '```'; echo
      echo "## Recovery"; echo
      echo "1. Inspect only: \`git apply --stat '$patch'\`"
      echo "2. Verify against the captured base: \`git apply --check '$patch'\`"
      echo "3. Never apply this incomplete patch without reviewing every change and running the required tests."
    } > "$report_tmp" || { rm -f "$patch_tmp" "$report_tmp"; return 1; }
  fi
  if [ "${AI_KIMI_TEST_FAIL_EXPORT:-}" = move ]; then
    rm -f "$patch_tmp" "${report_tmp:-}"
    return 1
  fi
  mv "$patch_tmp" "$patch" || { rm -f "$patch_tmp" "${report_tmp:-}"; return 1; }
  if [ "$kind" = incomplete ]; then
    mv "$report_tmp" "$report" || { rm -f "$report_tmp" "$patch"; return 1; }
    note "ai-kimi: $state with partial changes; command remains unsuccessful."
    note "INCOMPLETE patch written: $patch"
    note "INCOMPLETE report written: $report"
    note "  inspect: git apply --stat '$patch'"
    note "  verify:  git apply --check '$patch'"
  else
    note "patch written: $patch"
    note "  review it, then:  git apply --check '$patch' && git apply '$patch'"
  fi
  return 0
}

lifecycle_finalize() { # lifecycle_finalize ORIGINAL_EXIT_STATUS
  local original="${1:-1}" artifact_rc=0 final
  final="$original"
  [ "$LIFECYCLE_ACTIVE" = 1 ] || return "$original"
  LIFECYCLE_ACTIVE=0
  if [ "$LIFECYCLE_MODE" = implement ] && [ -n "$LIFECYCLE_WT" ]; then
    if [ "$LIFECYCLE_STATE" = completed ]; then
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" complete completed "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" || artifact_rc=$?
    else
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" incomplete "$LIFECYCLE_STATE" "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" || artifact_rc=$?
    fi
    if [ "$artifact_rc" = 1 ]; then
      LIFECYCLE_PRESERVE=1; final=1
      mark_preserved "$LIFECYCLE_OWNER" || true
      warn "could not safely export Kimi's work. The exact recovery worktree remains at: $LIFECYCLE_WT"
      warn "after recovery, remove it with: git -C '$LIFECYCLE_REPO' worktree remove '$LIFECYCLE_WT'"
    elif [ "$artifact_rc" = 0 ]; then
      LIFECYCLE_ARTIFACT_DURABLE=1
    fi
    [ "$LIFECYCLE_PRESERVE" = 1 ] || cleanup_wt "$LIFECYCLE_REPO" "$LIFECYCLE_WT" "$LIFECYCLE_OWNER"
  fi
  rm -f "$LIFECYCLE_PF" "$LIFECYCLE_OUT" "$LIFECYCLE_OUT.err" 2>/dev/null || true
  [ -z "$LIFECYCLE_LOCK" ] || lock_release "$LIFECYCLE_LOCK"
  return "$final"
}

lifecycle_exit_trap() {
  local original=$? final
  trap - EXIT INT TERM
  set +e
  lifecycle_finalize "$original"; final=$?
  exit "$final"
}

lifecycle_cancel() {
  LIFECYCLE_STATE=cancelled
  LIFECYCLE_COMMAND_RC=130
  stop_run_turn
  exit 130
}

start_session() { # start_session NAME MODE
  local name="$1" mode="$2" repo rid meta pf out rid_lock sid rc before after wt="" base="" owner=""
  valid_name "$name" || die "invalid session name '$name' (letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(meta_path "$rid" "$name")"
  [ -f "$meta" ] && die "session '$name' already exists here. Continue it with: ai-kimi ask $name"

  rid_lock="$(repolock_path "$rid")"
  lock_acquire "$rid_lock" "$mode:$name" || die "another Kimi run is already active in this repository: $(lock_info "$rid_lock").
  Do not start a second one; wait for it, or continue it with 'ask'."
  LIFECYCLE_LOCK="$rid_lock"
  trap lifecycle_exit_trap EXIT
  trap lifecycle_cancel INT TERM
  LIFECYCLE_ACTIVE=1; LIFECYCLE_MODE="$mode"; LIFECYCLE_STATE=failed
  LIFECYCLE_NAME="$name"; LIFECYCLE_REPO="$repo"; LIFECYCLE_WT=""
  LIFECYCLE_OWNER=""; LIFECYCLE_BASE=""; LIFECYCLE_PF=""; LIFECYCLE_OUT=""
  LIFECYCLE_COMMAND_RC=unavailable; LIFECYCLE_ARTIFACT_DURABLE=0; LIFECYCLE_PRESERVE=0

  local workdir="$repo"
  if [ "$mode" = implement ]; then
    base="$(git -C "$repo" rev-parse HEAD)"
    mkdir -p "$STATE_DIR/worktrees"
    wt="$(mktemp -d "$STATE_DIR/worktrees/kimi.XXXXXX")/wt"
    git -C "$repo" worktree add -q --detach "$wt" >/dev/null 2>&1 \
      || die "could not create an isolated worktree for the implement run."
    owner="${wt%/wt}/owner.json"
    LIFECYCLE_WT="$wt"; LIFECYCLE_OWNER="$owner"; LIFECYCLE_BASE="$base"
    write_meta "$owner" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg repo "$repo" --arg wt "$wt" --arg pid "$$" --arg state active \
      '{version:1,repo:$repo,worktree:$wt,pid:$pid,state:$state}')"
    workdir="$wt"
    note "implement run isolated in a throwaway worktree: $wt"
  fi

  pf="$(mktemp)"; LIFECYCLE_PF="$pf"
  out="$(mktemp)"; LIFECYCLE_OUT="$out"
  build_prompt_file "$pf"
  before="$(tree_state "$repo")"

  note "Kimi $mode '$name' starting (model $KIMI_MODEL)…"
  run_turn "$workdir" "$out" "$pf" "$mode"; rc="$RUN_TURN_RC"
  LIFECYCLE_COMMAND_RC="$rc"
  if ! await_result "$out" "$mode '$name'"; then
    LIFECYCLE_STATE="$(classify_incomplete_state "$out" "$out.err" "$AWAIT_RESULT_REASON")"
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    exit 1
  fi

  sid="$(session_id_from "$out")"
  [ -n "$sid" ] || die "Kimi returned no session id."
  LIFECYCLE_STATE=completed

  after="$(tree_state "$repo")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Kimi review changed the working tree. The agent profile's tool
  restriction is not holding — do not trust further reviews until this is understood.
  Inspect: git -C $repo status"
  fi

  write_meta "$meta" "$(jq -n --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg name "$name" \
    --arg caller "$CALLER" --arg mode "$mode" --arg model "$KIMI_MODEL" \
    --arg created "$(date -u +%FT%TZ)" --argjson turns 1 \
    '{kimi_session_id:$sid, repo:$repo, repo_remote:$remote, name:$name, caller:$caller, mode:$mode,
      model:$model, created:$created, updated:$created, turns:$turns}')"

  finish_turn "$repo" "$name" "$out"
  lifecycle_finalize 0
}

cleanup_wt() { # cleanup_wt REPO WORKTREE OWNER
  local repo="${1:-}" wt="${2:-}" owner="${3:-}"
  [ -n "$wt" ] || return 0
  valid_owner_record "$repo" "$wt" "$owner" || {
    warn "ambiguous Kimi worktree owner record left untouched: ${owner:-unavailable}"
    return 1
  }
  [ -f "$owner" ] && [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ] && return 0
  git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
  git -C "$repo" worktree prune >/dev/null 2>&1 || true
  if git -C "$repo" worktree list 2>/dev/null | grep -qF "$wt"; then
    warn "the throwaway worktree $wt is STILL registered — remove it before continuing."
  fi
  rm -f "$owner" 2>/dev/null || true
  rmdir "${wt%/wt}" 2>/dev/null || true
}

cmd_ask() {
  local name="$1" repo rid meta sid pf out rc before after sess_lock rid_lock mode
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(find_meta "$rid" "$name")"
  sid="$(jq -r .kimi_session_id "$meta")"; mode="$(jq -r .mode "$meta")"
  [ "$mode" = review ] || die "session '$name' is an implement session and cannot be resumed.
  Implement sessions are one-shot because their isolated worktree is removed after the patch
  is emitted. Start a new 'ai-kimi implement <name>' run for another isolated write turn."

  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$rid")"
  lock_acquire "$sess_lock" "ask:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "ask:$name"; then
    lock_release "$sess_lock"; die "another Kimi run is active in this repository: $(lock_info "$rid_lock")"
  fi
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT
  trap cancel_plain_turn INT TERM

  pf="$(mktemp)"; out="$(mktemp)"; build_prompt_file "$pf"
  before="$(tree_state "$repo")"
  note "Kimi '$name' continuing session $sid…"
  run_turn "$repo" "$out" "$pf" "$mode" "$sid"; rc="$RUN_TURN_RC"
  if ! await_result "$out" "'$name'"; then
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi
  after="$(tree_state "$repo")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Kimi review changed the working tree. Inspect: git -C $repo status"
  fi
  write_meta "$meta" "$(jq --arg u "$(date -u +%FT%TZ)" '.updated=$u | .turns=(.turns+1)' "$meta")"
  finish_turn "$repo" "$name" "$out"
  rm -f "$pf" "$out" "$out.err"
}

finish_turn() {
  local repo="$1" name="$2" out="$3" path
  if [ "${OPT_JSON:-0}" = 1 ]; then cat "$out"; else extract_answer "$out"; fi
  path="$(write_review_file "$repo" "$name" "$out")"
  [ -n "$path" ] && note "saved: $path"
  note "note: Kimi reports no token, cost, or model data — none can be quoted for this run."
  return 0
}

cmd_list() {
  local rid dir f; rid="$(repo_id "$(repo_root)")"; dir="$STATE_DIR/sessions/$rid"
  printf '%-24s %-8s %-11s %-46s %6s\n' NAME CALLER MODE SESSION TURNS
  [ -d "$dir" ] || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    jq -r '[.name,.caller,.mode,.kimi_session_id,(.turns|tostring)]|@tsv' "$f" \
      | awk -F'\t' '{printf "%-24s %-8s %-11s %-46s %6s\n",$1,$2,$3,$4,$5}'
  done
}
cmd_show()   { jq . "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; }
cmd_delete() { rm -f "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; note "deleted local session record '$1'."; }
cmd_transcript() {
  local sid kimi repo dir out tmp; repo="$(repo_root)"
  sid="$(jq -r .kimi_session_id "$(find_meta "$(repo_id "$repo")" "$1")")"
  kimi="$(resolve_kimi)"
  dir="$(reviews_dir "$repo")"; [ -n "$dir" ] || die "cannot export: '.ai/reviews' is not git-ignored."
  mkdir -p "$dir"; out="$dir/kimi-$1-$(date -u +%Y%m%dT%H%M%SZ).zip"; tmp="$out.partial"
  [ ! -e "$out" ] || die "refusing to replace existing archive: $out"
  "$kimi" export "$sid" -o "$tmp" -y --no-include-global-log >/dev/null \
    || { rm -f "$tmp"; die "'kimi export $sid' failed. Check: kimi export --help"; }
  chmod 0600 "$tmp" 2>/dev/null || true; mv "$tmp" "$out"
  note "Kimi transcript archive written: $out"
}

# ---------------------------------------------------------------------------
CMD="${1:-}"; shift || true
ARG=""; OPT_PROMPT=""; OPT_PROMPT_FILE=""; OPT_JSON=0; OPT_LIVE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt)      OPT_PROMPT="${2:-}"; shift 2 ;;
    --prompt-file) OPT_PROMPT_FILE="${2:-}"; shift 2 ;;
    --json)        OPT_JSON=1; shift ;;
    --live)        OPT_LIVE="--live"; shift ;;
    -h|--help)     usage; exit 0 ;;
    --*)           die "unknown option '$1'. This wrapper deliberately does not forward arbitrary kimi flags; if you need a capability it lacks, say so rather than calling kimi directly." ;;
    *)             [ -z "$ARG" ] && ARG="$1" || die "unexpected argument '$1'"; shift ;;
  esac
done
need jq

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-kimi new <name> …";       start_session "$ARG" review ;;
  implement)  [ -n "$ARG" ] || die "usage: ai-kimi implement <name> …"; start_session "$ARG" implement ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-kimi ask <name> …";       cmd_ask "$ARG" ;;
  list)       cmd_list ;;
  show)       [ -n "$ARG" ] || die "usage: ai-kimi show <name>";        cmd_show "$ARG" ;;
  transcript) [ -n "$ARG" ] || die "usage: ai-kimi transcript <name>";  cmd_transcript "$ARG" ;;
  delete)     [ -n "$ARG" ] || die "usage: ai-kimi delete <name>";      cmd_delete "$ARG" ;;
  doctor)     cmd_doctor "$OPT_LIVE" ;;
  -h|--help|help|"") usage; [ -z "$CMD" ] && exit 2 || exit 0 ;;
  *)          printf 'unknown command: %s\n\n' "$CMD" >&2; usage >&2; exit 2 ;;
esac
