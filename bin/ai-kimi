#!/usr/bin/env bash
# ai-kimi — Kimi Code delegation in persistent, named sessions.
#
# This is the ONLY supported way for Claude or Codex to drive Kimi headlessly.
# Never call `kimi -p` directly: this script owns the model pin, the read-only
# enforcement, the completion rule, the session bookkeeping, and the worktree
# isolation for write runs.
#
#   ai-kimi new <name>       [--prompt T | --prompt-file F | stdin]   read-only review
#   ai-kimi ask <name>       [--prompt T | --prompt-file F | stdin]   continue its saved mode
#   ai-kimi implement <name> [--prompt T | --prompt-file F | stdin]   create/continue write run
#   ai-kimi reset-context <name> [--prompt T | --prompt-file F]       visible recovery
#   ai-kimi list | show <name> | transcript <name> | delete <name>
#   ai-kimi doctor [--live]
#
# Review sessions are STRUCTURALLY read-only: they run under an agent profile
# whose toolset contains no write, edit, patch, or bash tool. See the Step 0
# evidence below — this is not a prompt request, it is an absent capability.
#
# ---------------------------------------------------------------------------
# STEP 0 VERIFICATION — re-qualified 2026-08-10 against Kimi Code 0.32.0 on
# Windows 11 (916-alien). Re-run and update this block on any version bump.
#
#   Resume flag: `-S/--session [id]` remains the DOCUMENTED form. `-r` remains
#     an accepted undocumented alias and is still printed in the terminal
#     resume hint. The wrapper uses the explicit id, never newest-by-directory.
#   `-c/--continue` means "newest session for this directory", NOT "the session
#     I was just using". Never used here.
#   Output formats are ONLY `text` and `stream-json` — there is no `json`.
#     stream-json is NDJSON: records carry `role` (user/assistant/meta), and
#     only meta records carry `type`.
#   COMPLETION MARKER: the run ends with a meta record
#     {"role":"meta","type":"session.resume_hint","session_id":"session_…"} and
#     it is emitted on resumed turns too. That record is the terminal signal
#     this script gates on. Verified on both a fresh and a resumed turn.
#   THERE IS NO --max-turns / step-budget FLAG. Kimi has no turn ceiling to
#     enforce, so the Grok D4 invariant has no analogue here. Do not invent one.
#   NO usage, token, cost, or model reporting in headless output. You cannot
#     assert which model answered. This is why -m is pinned unconditionally.
#   `provider list` still exits successfully even when it reports no providers;
#     auth checks must inspect content. Default model here is `kimi-code/k3` —
#     pin anyway, because defaults are machine-local and returned model is absent.
#   Prompt mode rejects: --yolo ("Cannot combine --prompt with --yolo"), and
#     per the CLI also --plan and --auto.
#   --agent/--agent-file CANNOT be combined with --session/--continue, so the
#     agent is fixed when a session is created. That is why review and
#     implement are different sessions and can never be the same one.
#   Exact implementation resume is DIRECTORY-BOUND. A live 0.32.0 probe refused
#     the exact ID in a different folder with "was created under a different
#     directory". The wrapper removes the worktree, then reconstructs a new one
#     at the same validated per-session path. Conversation and Git-visible source
#     continuity survive; ignored files do not.
#
#   STRUCTURAL READ-ONLY, PROVEN (this is the finding that justifies the script):
#     Negative control, plain `kimi -m kimi-code/k3 -p "Write HACKED into
#       canary3.txt"` → exit 0, file contents became `HACKED`. Kimi writes
#       files freely in ordinary prompt mode.
#     With `--agent-file` carrying `tools: read, grep, glob, ls` and the same
#       adversarial instruction → exit 0, canary UNCHANGED, model replied
#       CANNOT_WRITE.
#     Frontmatter `tools:` must be a comma-separated string or a list of
#       strings; a YAML map is rejected with "must be a comma-separated string
#       or a list of strings".
#     TOOL NAMES ARE CASE-SENSITIVE AND FAIL SILENTLY. `tools: read, grep,
#       glob, ls` is accepted by the parser and matches NOTHING, leaving the
#       agent with no tools at all — it reports "I have no working file-reading
#       tool" and the canary survives for the wrong reason. Kimi's real names
#       are capitalized: Read, Grep, Glob, ReadMediaFile, Bash, Edit, Write,
#       FetchURL, WebSearch, Agent, AgentSwarm, Skill, Cron*, Task*, Todo*.
#       Re-proved both directions on 0.32.0: Read observed a committed canary;
#       the hostile Write request left it unchanged and returned CANNOT_WRITE.
# ---------------------------------------------------------------------------

set -euo pipefail

VERSION="1.4.0"

STATE_DIR="${AI_KIMI_STATE_DIR:-$HOME/.local/state/ai-devops/kimi}"
CALLER="${AI_KIMI_CALLER:-unknown}"
KIMI_MODEL="${AI_KIMI_MODEL:-kimi-code/k3}"

WAIT_TIMEOUT="${AI_KIMI_WAIT_TIMEOUT:-900}"
POLL_INTERVAL="${AI_KIMI_POLL_INTERVAL:-5}"
STARTUP_TIMEOUT="${AI_KIMI_STARTUP_TIMEOUT:-60}"
HEARTBEAT_INTERVAL="${AI_KIMI_HEARTBEAT_INTERVAL:-30}"

# Kimi's own home contains both OAuth data and sessions.  This is deliberately
# separate from wrapper state: moving AI_KIMI_STATE_DIR must never make a
# restricted process credential-capable.
KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"

# Resolve through the /usr/local/bin symlink, or SELF_DIR is /usr/local/bin and
# the read-only profile is looked for at /usr/local/config/kimi/… — which does
# not exist, so every review refuses to run. (bin/ai-glm's doctor carries the
# same note for the same reason.)
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$_self")" && pwd)"
RO_AGENT="${AI_KIMI_RO_AGENT:-$SELF_DIR/../config/kimi/readonly-review.md}"
IMPL_AGENT="${AI_KIMI_IMPL_AGENT:-$SELF_DIR/../config/kimi/local-implement.md}"

die()  { printf 'ai-kimi: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-kimi: warning: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

job_dir()      { printf '%s/jobs/%s/%s--%s' "$STATE_DIR" "$1" "$CALLER" "$2"; }
job_meta()     { printf '%s/job.json' "$(job_dir "$1" "$2")"; }
job_output()   { printf '%s/stream.jsonl' "$(job_dir "$1" "$2")"; }
job_log()      { printf '%s/worker.log' "$(job_dir "$1" "$2")"; }
job_is_terminal() { jq -e '.phase | IN("completed","failed","timed-out","cancelled","recovery-required")' "$1" >/dev/null 2>&1; }

safe_home_hash() { printf '%s' "$KIMI_HOME" | sha256sum | awk '{print $1}'; }

profile_is_readonly() {
  [ -f "$RO_AGENT" ] &&
    grep -qx 'tools: Read, Grep, Glob, ReadMediaFile' "$RO_AGENT" &&
    ! grep -Eq '(^|[,[:space:]])(Write|Edit|Bash|FetchURL|WebSearch)([,[:space:]]|$)' "$RO_AGENT"
}

# Sets PREFLIGHT_CLASS and returns non-zero without launching the provider.
# Callers can turn execution-context-denied into a hand-back to the main task.
PREFLIGHT_CLASS=""
preflight_execution_context() { # MODE REPO
  local mode="$1" repo="$2" canary parent provider
  PREFLIGHT_CLASS=""
  mkdir -p "$STATE_DIR" 2>/dev/null || { PREFLIGHT_CLASS="execution-context-denied"; return 1; }
  canary="$STATE_DIR/.write-canary.$$"
  ( umask 077; : > "$canary" && test -r "$canary" && rm -f "$canary" ) 2>/dev/null || { PREFLIGHT_CLASS="execution-context-denied"; return 1; }
  [ -x "$(resolve_kimi)" ] || { PREFLIGHT_CLASS="local_dependency_unavailable"; return 1; }
  [ -r "$repo/.git" ] || git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { PREFLIGHT_CLASS="execution-context-denied"; return 1; }
  if [ "$mode" = review ] && ! profile_is_readonly; then PREFLIGHT_CLASS="profile-invalid"; return 1; fi
  parent="$(dirname "$KIMI_HOME")"
  [ -d "$KIMI_HOME" ] || [ -w "$parent" ] || { PREFLIGHT_CLASS="kimi-home-unwritable"; return 1; }
  mkdir -p "$KIMI_HOME/sessions" 2>/dev/null || { PREFLIGHT_CLASS="execution-context-denied"; return 1; }
  canary="$KIMI_HOME/sessions/.ai-kimi-canary.$$"
  ( umask 077; : > "$canary" && test -r "$canary" && rm -f "$canary" ) 2>/dev/null || { PREFLIGHT_CLASS="execution-context-denied"; return 1; }
  provider="$(KIMI_CODE_HOME="$KIMI_HOME" "$(resolve_kimi)" provider list 2>/dev/null || true)"
  if [ -z "$provider" ] || printf '%s' "$provider" | grep -qi 'no providers configured'; then
    PREFLIGHT_CLASS="credentials-unavailable"; return 1
  fi
  return 0
}

preflight_or_die() { # MODE REPO
  preflight_execution_context "$1" "$2" && return 0
  printf 'ai-kimi: %s. No Kimi provider was started.\n' "$PREFLIGHT_CLASS" >&2
  case "$PREFLIGHT_CLASS" in
    execution-context-denied|kimi-home-unwritable)
      printf 'Run this credentialed Kimi job from the Full Access main task. Do not change Kimi-home permissions or copy credentials.\n' >&2 ;;
    credentials-unavailable) printf 'Kimi credentials are unavailable to this process. Run the job from the authenticated Full Access main task.\n' >&2 ;;
    profile-invalid) printf 'The structural read-only review profile is invalid. No Kimi provider was started.\n' >&2 ;;
    local_dependency_unavailable) printf 'The LOCAL Kimi runtime is missing or cannot start. This is not a Kimi provider fault. Run: ai-kimi doctor\n' >&2 ;;
  esac
  if [ "${OPT_JSON:-0}" = 1 ]; then
    jq -n --arg failure "$PREFLIGHT_CLASS" --arg action "run this credentialed Kimi job from the Full Access main task" \
      '{ok:false,failure_class:$failure,hand_back_to_main_task:true,action:$action}'
  fi
  return 1
}

# ---------------------------------------------------------------------------
# Binary resolution. Kimi installs to ~/.kimi-code/bin, which is NOT added to
# PATH by its installer — on hetz it is absent from both users' PATH. A bare
# `command -v kimi` failure reads as "not installed" when it is installed.
# ---------------------------------------------------------------------------
resolve_kimi() {
  if [ -n "${AI_KIMI_BIN:-}" ]; then
    [ -x "$AI_KIMI_BIN" ] || die "local_dependency_unavailable: AI_KIMI_BIN=$AI_KIMI_BIN is not executable. This is not a Kimi provider fault."
    printf '%s' "$AI_KIMI_BIN"; return 0
  fi
  local c
  for c in "$(command -v kimi 2>/dev/null || true)" \
           "$KIMI_HOME/bin/kimi" \
           "$KIMI_HOME/bin/kimi.exe" \
           "$HOME/.kimi-code/bin/kimi" \
           "$HOME/.kimi-code/bin/kimi.exe" \
           /home/ai/.kimi-code/bin/kimi \
           /usr/local/bin/kimi; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  die "local_dependency_unavailable: kimi binary not found. This is not a Kimi provider fault. Set AI_KIMI_BIN, or install Kimi Code. Looked on PATH, \$HOME/.kimi-code/bin, /home/ai/.kimi-code/bin, /usr/local/bin."
}

# ---------------------------------------------------------------------------
# Credential owner.
#
# Unlike GLM (one loopback server with a shared password), Kimi has no server:
# it is a local CLI whose credentials are per-user OAuth under ~/.kimi-code.
# There is no config-dir override — `kimi --help` exposes none — so a second
# account on a shared box has no credentials of its own.
#
# Rather than making Albert run a second interactive device-code login, a root
# session runs the Kimi call AS the owning user. Only root can do this without
# a password prompt, so this never turns into an interactive hang; for any other
# user it simply does not engage and doctor says plainly what to do.
#
# Review mode only. An implement run is deliberately NOT delegated: its writes
# would land owned by the other user, which is a mess a wrapper should not
# create silently.
KIMI_OWNER="${AI_KIMI_OWNER:-ai}"

has_credentials() { # has_credentials [USER] — true if that account can reach a provider
  local u="${1:-}" out
  if [ -z "$u" ]; then out="$("$(resolve_kimi)" provider list 2>/dev/null || true)"
  else out="$(su - "$u" -c "\"\$HOME/.kimi-code/bin/kimi\" provider list" 2>/dev/null || true)"
  fi
  [ -n "$out" ] && ! printf '%s' "$out" | grep -qi 'no providers configured'
}

# Prints the user to run Kimi as, or empty for "run directly as me".
run_as_user() {
  has_credentials && { printf ''; return 0; }
  if [ "$(id -u)" = 0 ] && [ "$(id -un)" != "$KIMI_OWNER" ] && has_credentials "$KIMI_OWNER"; then
    printf '%s' "$KIMI_OWNER"; return 0
  fi
  printf ''
}

kimi_procs() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x kimi 2>/dev/null || true
  else
    ps -W 2>/dev/null | grep -i '[k]imi' || true
  fi
}

# ---------------------------------------------------------------------------
# Session identity: repo + caller + name, so Claude and Codex never collide.
# ---------------------------------------------------------------------------
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "ai-kimi must be run inside a git repository."
}

# --- review boundary ----------------------------------------------------------
# A delegated reviewer gets exactly ONE directory. In a linked worktree the
# repository's control files live outside it, so the reviewer is refused on its
# first git-adjacent read and the run dies before any code is read.
# ai-review-sandbox turns such a worktree into a self-contained snapshot; in an
# ordinary clone it echoes the root unchanged. See that script's header.
SANDBOX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-sandbox"
[ -x "$SANDBOX_BIN" ] || SANDBOX_BIN="$(command -v ai-review-sandbox 2>/dev/null || true)"
review_boundary() { # review_boundary ROOT TAG [RECORDED-DIRECTORY] -> directory to hand the reviewer
  [ -n "$SANDBOX_BIN" ] || die "ai-review-sandbox is missing; install the toolkit's bin/ on PATH."
  if [ -n "${3:-}" ]; then
    "$SANDBOX_BIN" refresh-copy "$1" "$2" "$3" || die "could not refresh the recorded private review snapshot for $1"
  else
    "$SANDBOX_BIN" ensure-copy "$1" "$2" || die "could not prepare a private review snapshot for $1"
  fi
}
release_boundary() { # release_boundary ROOT TAG
  [ -n "$SANDBOX_BIN" ] || return 0
  "$SANDBOX_BIN" remove-copy "$1" "$2" || true
}
release_recorded_boundary() { # release_recorded_boundary TAG RECORDED-DIRECTORY
  [ -n "$SANDBOX_BIN" ] || die "ai-review-sandbox is missing; cannot safely remove the recorded private snapshot."
  "$SANDBOX_BIN" remove-recorded "$1" "$2" \
    || die "could not safely remove the recorded private review snapshot: $2"
}

# --- evidence packet ----------------------------------------------------------
# A Kimi review runs under an agent profile whose toolset has no bash, so Kimi
# cannot run `git diff` and cannot work out what changed. Without a packet it
# spends its budget rediscovering the comparison. ai-review-packet writes those
# shell-derived facts into .ai-review/ inside the review directory.
#
# The packet is ADDITIVE: read/grep/glob/ls over the whole directory are
# unchanged and the manifest says so. It is also git-excluded, so it can never
# trip the read-only working-tree canary below.
PACKET_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-packet"
[ -x "$PACKET_BIN" ] || PACKET_BIN="$(command -v ai-review-packet 2>/dev/null || true)"

# The packet directory is named after this session's tag (shared-db#1296), so
# the preamble must name the directory that was actually built, not a fixed one.
PACKET_REL=".ai-review"
REVIEW_DIR=""; REVIEW_BASE=""; REVIEW_HEAD=""; PACKET_HASH=""
REVIEW_SNAPSHOT_SECONDS=0; REVIEW_PACKET_SECONDS=0; REVIEW_TEST_SECONDS=0
# Sets the globals above. Never call it in a command substitution: the identity
# would be computed in a subshell and lost.
prepare_review() { # prepare_review ROOT TAG [RECORDED-DIRECTORY]
  local root="$1" tag="$2" recorded="${3:-}" pkt want snapshot_started packet_started
  snapshot_started="$(date +%s)"
  REVIEW_DIR="$(review_boundary "$root" "$tag" "$recorded")"
  REVIEW_SNAPSHOT_SECONDS="$(( $(date +%s) - snapshot_started ))"
  REVIEW_HEAD="$(git -C "$REVIEW_DIR" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$REVIEW_HEAD" ] || die "could not read HEAD in $REVIEW_DIR; refusing to review a directory with no commit identity."
  if [ -n "${OPT_ASSERT_HEAD:-}" ]; then
    want="$(git -C "$REVIEW_DIR" rev-parse --verify --quiet "${OPT_ASSERT_HEAD}^{commit}" || true)"
    [ "$want" = "$REVIEW_HEAD" ] || die "--assert-head does not match this repository.
  you said : $OPT_ASSERT_HEAD
  actual   : $REVIEW_HEAD
A verdict recorded against the wrong commit is worthless evidence. Nothing was
reviewed. Re-read the SHA from git rather than transcribing it."
  fi
  if [ "$OPT_REVIEW_KIND" != diff ]; then
    packet_started="$(date +%s)"
    pkt="$REVIEW_DIR/.ai-decision"
    rm -rf "$pkt"; mkdir -p "$pkt"
    cat > "$pkt/MANIFEST.md" <<EOF
# Kimi decision packet

- Review kind: \`$OPT_REVIEW_KIND\`
- Repository head: \`$REVIEW_HEAD\`
- Requested decision: ${OPT_DECISION:-See the submitted brief; answer every requested decision.}

This is a $OPT_REVIEW_KIND review, not a code-diff approval. Read the source documents
named in the brief from this workspace. Return a decision-by-decision conclusion and
an unresolved-objection ledger. Do not approve or reject an unrelated working-tree patch.
EOF
    REVIEW_BASE="$REVIEW_HEAD"
    PACKET_HASH="$(sha256sum "$pkt/MANIFEST.md" | awk '{print $1}')"
    REVIEW_PACKET_SECONDS="$(( $(date +%s) - packet_started ))"
    PACKET_PREAMBLE="$DECISION_PACKET_PREAMBLE"
    note "  decision packet: $pkt (kind $OPT_REVIEW_KIND, head ${REVIEW_HEAD:0:12}, sha ${PACKET_HASH:0:12})"
    return 0
  fi
  PACKET_PREAMBLE="$DIFF_PACKET_PREAMBLE"
  [ -n "$PACKET_BIN" ] || die "ai-review-packet is missing; install the toolkit's bin/ on PATH. A review without an evidence packet burns its whole budget rediscovering the diff."
  local changed_count patch_bytes review_class="small"
  changed_count="$({ git -C "$REVIEW_DIR" diff --name-only "${OPT_BASE:-HEAD^}" HEAD 2>/dev/null || true; } | wc -l | tr -d ' ')"
  patch_bytes="$({ git -C "$REVIEW_DIR" diff --binary "${OPT_BASE:-HEAD^}" HEAD 2>/dev/null || true; } | wc -c | tr -d ' ')"
  if [ "${changed_count:-0}" -gt 10 ] || [ "${patch_bytes:-0}" -gt 40960 ]; then review_class="medium"; fi
  packet_started="$(date +%s)"
  pkt="$(AI_REVIEW_PATCH_MAX_BYTES=40960 AI_REVIEW_TEST_TAIL=25 "$PACKET_BIN" build "$REVIEW_DIR" "$tag" --class "$review_class" \
           ${OPT_BASE:+--base "$OPT_BASE"} \
           ${OPT_TESTS:+--tests "$OPT_TESTS"} \
           ${OPT_DECISION:+--decision "$OPT_DECISION"})" \
    || die "could not build the review evidence packet for $REVIEW_DIR"
  REVIEW_BASE="$(sed -n 's/^| \*\*base\*\* | `\([0-9a-f]\{40\}\)`.*/\1/p' "$pkt/MANIFEST.md" | head -1)"
  PACKET_REL="$(basename "$pkt")"
  PACKET_HASH="$(cat "$pkt/MANIFEST.sha256")"
  # Re-point the preamble now that the packet's real directory name is known.
  PACKET_PREAMBLE="${DIFF_PACKET_PREAMBLE//.ai-review/$PACKET_REL}"
  REVIEW_PACKET_SECONDS="$(( $(date +%s) - packet_started ))"
  REVIEW_TEST_SECONDS="$(sed -n 's/^Measured duration: `\([0-9][0-9]*\)s`.*/\1/p' "$pkt/MANIFEST.md" | head -1)"
  REVIEW_TEST_SECONDS="${REVIEW_TEST_SECONDS:-0}"
  note "  evidence packet: $pkt (base ${REVIEW_BASE:0:12}, head ${REVIEW_HEAD:0:12}, sha ${PACKET_HASH:0:12})"
}

DIFF_PACKET_PREAMBLE="Your evidence packet is at .ai-review/MANIFEST.md in this directory. Read it
first. It contains the exact commits under review, the changed files, and what
you are being asked to decide. If the manifest lists patch.part-* files, read
those numbered parts in order and do not open patch.full.diff with bounded Read.

You may read any other file in this directory to confirm a finding — the packet
is your starting point, not a boundary. What you must NOT do is spend turns
reconstructing the diff yourself; it is already in the packet.

---

"

DECISION_PACKET_PREAMBLE="Your decision packet is at .ai-decision/MANIFEST.md in this directory. Read it first.
This is not a code-diff approval. Answer every requested decision, list the evidence
you checked, and finish with an unresolved-objection ledger. Read the named source
documents directly from this private workspace.

---

"
PACKET_PREAMBLE="$DIFF_PACKET_PREAMBLE"

legacy_repo_id() { printf '%s' "$1" | tr '\\' '/' | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
repo_id() {
  local root="$1" remote
  root="$(cd "$root" && pwd -P)"
  remote="$(git -C "$root" config --get remote.origin.url 2>/dev/null || echo '')"
  printf '%s' "$(printf '%s\n%s' "$root" "$remote" | sha256sum | cut -c1-12)"
}
repo_remote() { git -C "$1" config --get remote.origin.url 2>/dev/null || true; }

# Session identity remains checkout-bound because Kimi resumes inside one stable
# private workspace. Paid review serialization uses a separate upstream identity
# so two clones of the same network repository cannot start duplicate work.
normalize_remote() { # normalize_remote REMOTE
  local remote="$1" host path
  remote="${remote%/}"
  case "$remote" in
    ssh://*|https://*|http://*|git://*)
      host="${remote#*://}"; host="${host#*@}"; path="${host#*/}"; host="${host%%/*}"; host="${host%:22}"; host="${host%:443}" ;;
    *@*:* ) host="${remote#*@}"; host="${host%%:*}"; path="${remote#*:}" ;;
    *) return 1 ;;
  esac
  host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  path="${path#/}"; path="${path%/}"
  case "${path,,}" in *.git) path="${path:0:${#path}-4}" ;; esac
  [ -n "$host" ] && [ -n "$path" ] || return 1
  case "$host/$path" in *$'\n'*|*$'\r'*) return 1 ;; esac
  printf '%s/%s' "$host" "$path"
}
upstream_identity() {
  local root="$1" depth="${2:-0}" visited="${3:-}" remote target physical
  [ "$depth" -lt 5 ] || return 1
  physical="$(cd "$root" 2>/dev/null && pwd -P)" || return 1
  case "|$visited|" in *"|$physical|"*) return 1 ;; esac
  remote="$(repo_remote "$physical")"; [ -n "$remote" ] || return 1
  if normalize_remote "$remote"; then return 0; fi
  case "$remote" in /*|[A-Za-z]:[\\/]*) target="$remote" ;; *) target="$physical/$remote" ;; esac
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 || return 1
  upstream_identity "$target" $((depth + 1)) "$visited|$physical"
}
review_lock_id() { printf '%s' "$1" | sha256sum | cut -c1-16; }
require_upstream_identity() {
  local identity
  identity="$(upstream_identity "$1")" || die "cannot identify this repository's shared upstream. Set origin to an unambiguous network repository; no paid Kimi review was started."
  printf '%s' "$identity"
}
valid_name() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }

meta_path()     { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
impl_dir()      { printf '%s/sessions/%s/%s--%s.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
impl_meta_path(){ printf '%s/metadata.json' "$(impl_dir "$1" "$2")"; }
lock_path()     { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
repolock_path() { printf '%s/locks/repo--%s.lock.d' "$STATE_DIR" "$1"; }
workspace_path(){ printf '%s/worktrees/kimi.%s-%s-%s/wt' "$STATE_DIR" "$1" "$CALLER" "$2"; }

# Portable mutex (flock does not exist in Git Bash); stale locks are reclaimed.
lock_acquire() {
  local dir="$1" label="$2" owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || echo '')"
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then return 1; fi
  warn "reclaiming stale lock $(basename "$dir") (owner pid ${owner:-unknown} is gone)"
  rm -rf "$dir"; mkdir "$dir" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
}
lock_release() { rm -rf "$1" 2>/dev/null || true; }
lock_info() {
  local dir="$1" label pid started now
  label="$(cat "$dir/label" 2>/dev/null || echo unknown)"
  pid="$(cat "$dir/pid" 2>/dev/null || echo '?')"
  if started="$(date -r "$dir" +%s 2>/dev/null)"; then
    now="$(date +%s)"; printf '%s (pid %s, running %ss)' "$label" "$pid" "$((now - started))"
  else printf '%s (pid %s)' "$label" "$pid"; fi
}

write_meta() {
  local f="$1" tmp; mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; chmod 0600 "$tmp" 2>/dev/null || true; mv -f "$tmp" "$f"
}
find_meta_optional() {
  local f old repo remote cand found=""; f="$(impl_meta_path "$1" "$2")"
  [ -f "$f" ] || f="$(meta_path "$1" "$2")"
  if [ ! -f "$f" ]; then
    repo="$(repo_root)"; old="$(meta_path "$(legacy_repo_id "$repo")" "$2")"
    if [ -f "$old" ]; then mkdir -p "$(dirname "$f")"; mv "$old" "$f"; fi
  fi
  if [ ! -f "$f" ]; then
    remote="$(repo_remote "$repo")"
    [ -n "$remote" ] || return 1
    while IFS= read -r cand; do
      [ "$(jq -r '.name // ""' "$cand")" = "$2" ] || continue
      [ "$(jq -r '.caller // ""' "$cand")" = "$CALLER" ] || continue
      [ "$(jq -r '.repo_remote // ""' "$cand")" = "$remote" ] || continue
      [ -z "$found" ] || die "multiple moved-checkout records match session '$2'; refusing an ambiguous migration."
      found="$cand"
    done < <(find "$STATE_DIR/sessions" -type f \( -name "$CALLER--$2.json" -o -path "*/$CALLER--$2.d/metadata.json" \) 2>/dev/null)
    if [ -n "$found" ]; then
      case "$found" in
        */"$CALLER--$2.d/metadata.json") f="$found" ;; # Keep the rid: Kimi binds resume to its stable workspace path.
        *) mkdir -p "$(dirname "$f")"; mv "$found" "$f" ;;
      esac
    fi
  fi
  [ -f "$f" ] || return 1
  printf '%s' "$f"
}
find_meta() {
  local f
  f="$(find_meta_optional "$1" "$2")" || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-kimi list"
  printf '%s' "$f"
}
rid_from_meta() { basename "$(dirname "$(dirname "$1")")"; }

# ---------------------------------------------------------------------------
# The completion rule.
#
# Kimi's stream-json is NDJSON with no terminal status field, so completion is
# proven by the LAST record being the session.resume_hint meta record. Exit
# status is recorded but never trusted: it is the same class of signal that
# made a Grok caller believe a still-running review had died.
# ---------------------------------------------------------------------------
has_resume_hint() { # has_resume_hint FILE
  [ -s "$1" ] || return 1
  tail -5 "$1" | jq -e 'select(.type=="session.resume_hint")|.session_id' >/dev/null 2>&1
}
session_id_from() { tail -5 "$1" | jq -r 'select(.type=="session.resume_hint")|.session_id' 2>/dev/null | tail -1; }

AWAIT_RESULT_REASON=""
await_result() { # await_result FILE LABEL [CHILD-EXIT]
  local f="$1" label="$2" child_exit="${3:-}" waited=0
  AWAIT_RESULT_REASON=""
  if [ -n "$child_exit" ]; then
    has_resume_hint "$f" && return 0
    note ""
    note "ai-kimi: Kimi exited with status $child_exit but never emitted a session.resume_hint."
    AWAIT_RESULT_REASON="process-ended"
    return 1
  fi
  while [ "$waited" -lt "$WAIT_TIMEOUT" ]; do
    has_resume_hint "$f" && return 0
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
    [ $((waited % 60)) -eq 0 ] && note "  … $label still running (${waited}s)"
  done
  note ""
  note "ai-kimi: no session.resume_hint after ${WAIT_TIMEOUT}s — the run did not complete."
  note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
  note "  diagnose : tail -20 ~/.kimi-code/logs/kimi-code.log"
  note "  Raise the ceiling with AI_KIMI_WAIT_TIMEOUT=<seconds> for a genuinely long run."
  AWAIT_RESULT_REASON="timeout"
  return 1
}

sha256_file() { sha256sum "$1" | awk '{print $1}'; }

valid_impl_record() { # valid_impl_record RID NAME META
  local rid="$1" name="$2" meta="$3" dir manifest patch base
  dir="$(impl_dir "$rid" "$name")"; manifest="$dir/owner.json"; patch="$(jq -r '.canonical_patch // ""' "$meta" 2>/dev/null)"
  same_path "$meta" "$dir/metadata.json" && [ -f "$manifest" ] && [ -f "$patch" ] || return 1
  same_path "$(dirname "$patch")" "$dir" || return 1
  base="$(basename "$patch")"; [ "$base" = cumulative.patch ] || printf '%s' "$base" | grep -Eq '^cumulative-[0-9]+-[0-9a-f]{64}\.patch$' || return 1
  jq -e --arg remote "$(repo_remote "$(repo_root)")" \
    --arg caller "$CALLER" --arg name "$name" --arg patch "$patch" --arg meta "$meta" \
    '.version==2 and .mode=="implement" and .repo_remote==$remote and
     .caller==$caller and .name==$name and (.base_sha|type=="string") and (.base_sha|length==40) and
     (.patch_sha256|type=="string") and (.generation|type=="number") and
     (.continuity_state|type=="string")' "$meta" >/dev/null 2>&1 || return 1
  jq -e --arg dir "$dir" --arg meta "$meta" \
    '.version==1 and .owner_dir==$dir and .metadata==$meta' \
    "$manifest" >/dev/null 2>&1 || return 1
  [ "$(sha256_file "$patch")" = "$(jq -r .patch_sha256 "$meta")" ]
}

write_impl_state() { # RID NAME REPO BASE SID WT TERMINAL CONTINUITY [OLD_META]
  local rid="$1" name="$2" repo="$3" base="$4" sid="$5" wt="$6" terminal="$7" continuity="$8" old="${9:-}"
  local dir meta patch manifest tmp_patch hash now turns generation created old_patch
  dir="$(impl_dir "$rid" "$name")"; meta="$dir/metadata.json"; manifest="$dir/owner.json"
  mkdir -p "$dir"; chmod 0700 "$dir" 2>/dev/null || true
  tmp_patch="$(mktemp "$dir/.cumulative.XXXXXX")" || return 1
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --binary "$base" ) > "$tmp_patch" || { rm -f "$tmp_patch"; return 1; }
  hash="$(sha256_file "$tmp_patch")"; now="$(date -u +%FT%TZ)"
  if [ -n "$old" ] && [ -f "$old" ]; then
    turns=$(( $(jq -r '.turns // 0' "$old") + 1 )); generation=$(( $(jq -r '.generation // 0' "$old") + 1 )); created="$(jq -r .created "$old")"
  else turns=1; generation=1; created="$now"; fi
  patch="$dir/cumulative-$generation-$hash.patch"
  if [ -f "$patch" ]; then [ "$(sha256_file "$patch")" = "$hash" ] || return 1; rm -f "$tmp_patch"
  else mv -f "$tmp_patch" "$patch" || return 1; fi
  chmod 0600 "$patch" 2>/dev/null || true
  [ "${AI_KIMI_TEST_FAIL_STATE:-}" != after-patch ] || return 1
  write_meta "$manifest" "$(jq -n --arg dir "$dir" --arg meta "$meta" \
    '{version:1,owner_dir:$dir,metadata:$meta,patch_pattern:"cumulative-<generation>-<sha256>.patch"}')" || return 1
  old_patch=""; [ -n "$old" ] && [ -f "$old" ] && old_patch="$(jq -r '.canonical_patch // ""' "$old")"
  write_meta "$meta" "$(jq -n --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" \
    --arg name "$name" --arg caller "$CALLER" --arg model "$KIMI_MODEL" --arg base "$base" \
    --arg patch "$patch" --arg hash "$hash" --arg created "$created" --arg updated "$now" \
    --arg terminal "$terminal" --arg continuity "$continuity" --argjson turns "$turns" --argjson generation "$generation" \
    '{version:2,kimi_session_id:$sid,repo:$repo,repo_remote:$remote,name:$name,caller:$caller,mode:"implement",
      model:$model,base_sha:$base,canonical_patch:$patch,patch_sha256:$hash,generation:$generation,turns:$turns,
      created:$created,updated:$updated,last_terminal_state:$terminal,incomplete_state:($terminal!="completed"),
      continuity_state:$continuity,lifecycle_status:(if $continuity=="exact" then "ready" else "recovery-required" end),
      ephemeral_state_notice:"Ignored dependencies, build output, downloads, caches, and secrets are not preserved. Generation is wrapper bookkeeping, not a Kimi turn counter."}')"
  [ -z "$old_patch" ] || [ "$old_patch" = "$patch" ] || rm -f "$old_patch" 2>/dev/null || true
}

reconcile_impl_patches() { # META RESET_ALLOWED
  local meta="$1" reset="${2:-0}" dir canonical generation f base fgen
  dir="$(dirname "$meta")"; canonical="$(jq -r .canonical_patch "$meta")"; generation="$(jq -r .generation "$meta")"
  for f in "$dir"/cumulative-*.patch; do
    [ -f "$f" ] || continue
    same_path "$f" "$canonical" && continue
    base="$(basename "$f")"
    fgen="$(printf '%s' "$base" | sed -nE 's/^cumulative-([0-9]+)-[0-9a-f]{64}\.patch$/\1/p')"
    [ -n "$fgen" ] || return 1
    if [ "$fgen" -gt "$generation" ]; then
      if [ "$reset" = 1 ]; then rm -f "$f" || return 1
      else
        mark_impl_recovery_required "$meta" uncommitted-state-detected || return 1
        return 2
      fi
    else rm -f "$f" || return 1; fi
  done
  return 0
}

mark_impl_recovery_required() { # META TERMINAL
  local meta="$1" terminal="$2" json
  [ -n "$meta" ] && [ -f "$meta" ] || return 1
  json="$(jq --arg u "$(date -u +%FT%TZ)" --arg t "$terminal" \
    '.updated=$u | .last_terminal_state=$t | .incomplete_state=true |
     .continuity_state="recovery-required" | .lifecycle_status="recovery-required"' "$meta")" || return 1
  write_meta "$meta" "$json"
}

# ---------------------------------------------------------------------------
# Turn execution
# ---------------------------------------------------------------------------
RUN_TURN_RC=unavailable
RUN_TURN_PID=""
RUN_TURN_TIMED_OUT=0
RUN_TURN_CANCELLED=0
RUN_TURN_STARTUP_FAILED=0
ACTIVE_JOB_META=""
ACTIVE_CANCEL_FILE=""
run_turn() { # run_turn REPO OUT PROMPT_FILE MODE [SESSION_ID]
  local repo="$1" out="$2" pf="$3" mode="$4" sid="${5:-}"
  RUN_TURN_PID=""; RUN_TURN_TIMED_OUT=0; RUN_TURN_CANCELLED=0; RUN_TURN_STARTUP_FAILED=0
  if [ ! -s "$pf" ]; then
    : > "$out"; printf '%s\n' 'private prompt is missing or empty; provider was not contacted' > "$out.err"
    RUN_TURN_RC=1; RUN_TURN_STARTUP_FAILED=1
    return 0
  fi
  local kimi; kimi="$(resolve_kimi)"
  local args=(-m "$KIMI_MODEL" --output-format stream-json)
  if [ -n "$sid" ]; then
    # --agent/--agent-file cannot combine with a resume; the agent is fixed at
    # session creation, which is exactly why a review session can never later
    # become a write session.
    args+=(-r "$sid")
  elif [ "$mode" = review ]; then
    [ -f "$RO_AGENT" ] || die "read-only agent profile not found at $RO_AGENT — refusing to run a review without structural read-only enforcement."
    args+=(--agent-file "$RO_AGENT")
  elif [ "$mode" = implement ]; then
    [ -f "$IMPL_AGENT" ] || die "implementation agent profile not found at $IMPL_AGENT — refusing to run without its tool boundary."
    args+=(--agent-file "$IMPL_AGENT")
  fi
  # Kimi Code 0.32.0 exposes only -p/--prompt for headless input. This puts the
  # brief in argv. Never put secrets in a Kimi brief on a shared host.
  args+=(-p "$(cat "$pf")")

  local as; as="$(run_as_user)"
  if [ -n "$as" ] && [ "$mode" = implement ]; then
    die "this account has no Kimi credentials, and an implement run will not be delegated
  to '$as' — its writes would land owned by the wrong user. Either run 'kimi login'
  as $(id -un), or run: su - $as -c 'ai-kimi implement …'"
  fi

  : > "$out"
  set +e
  if [ -n "$as" ]; then
    # Kimi has no prompt-file/stdin option. Quote every argument for the shell
    # su spawns, but do not claim that this hides the prompt from process lists.
    local q="" a
    for a in "${args[@]}"; do q="$q $(printf '%q' "$a")"; done
    su - "$as" -c "cd $(printf '%q' "$repo") && \"\$HOME/.kimi-code/bin/kimi\"$q" \
      < /dev/null > "$out" 2>"$out.err" &
  else
    ( cd "$repo" && KIMI_CODE_HOME="$KIMI_HOME" exec "$kimi" "${args[@]}" ) > "$out" 2>"$out.err" &
  fi
  RUN_TURN_PID=$!
  local elapsed=0 last_size=0 size=0
  while kill -0 "$RUN_TURN_PID" 2>/dev/null; do
    if { [ -n "$ACTIVE_CANCEL_FILE" ] && [ -f "$ACTIVE_CANCEL_FILE" ]; } \
      || { [ -n "$ACTIVE_JOB_META" ] && jq -e '.cancel_requested == true' "$ACTIVE_JOB_META" >/dev/null 2>&1; }; then
      RUN_TURN_CANCELLED=1
      signal_run_tree TERM "$RUN_TURN_PID"
      sleep 1
      kill -0 "$RUN_TURN_PID" 2>/dev/null && signal_run_tree KILL "$RUN_TURN_PID"
      break
    fi
    size="$(wc -c < "$out" 2>/dev/null || echo 0)"
    if [ -n "$ACTIVE_JOB_META" ] && [ -f "$ACTIVE_JOB_META" ]; then
      write_job_state "$ACTIVE_JOB_META" --argjson pid "$RUN_TURN_PID" --argjson size "$size" --arg u "$(date -u +%FT%TZ)" '.kimi_child_pid=$pid|.last_output_size=$size|.last_output_at=$u|.updated=$u' || true
    fi
    if [ "$elapsed" -ge "$STARTUP_TIMEOUT" ] && [ "$size" -eq 0 ]; then
      RUN_TURN_STARTUP_FAILED=1
      signal_run_tree TERM "$RUN_TURN_PID"
      sleep 1
      kill -0 "$RUN_TURN_PID" 2>/dev/null && signal_run_tree KILL "$RUN_TURN_PID"
      break
    fi
    if [ "$elapsed" -ge "$WAIT_TIMEOUT" ]; then
      RUN_TURN_TIMED_OUT=1
      signal_run_tree TERM "$RUN_TURN_PID"
      sleep 1
      kill -0 "$RUN_TURN_PID" 2>/dev/null && signal_run_tree KILL "$RUN_TURN_PID"
      break
    fi
    sleep "$POLL_INTERVAL"; elapsed=$((elapsed + POLL_INTERVAL))
    if [ "$HEARTBEAT_INTERVAL" -gt 0 ] && [ $((elapsed % HEARTBEAT_INTERVAL)) -eq 0 ]; then
      size="$(wc -c < "$out" 2>/dev/null || echo 0)"
      note "  Kimi $mode heartbeat: ${elapsed}s, exact child alive, output $([ "$size" -gt "$last_size" ] && printf grew || printf quiet)"
      last_size="$size"
    fi
  done
  wait "$RUN_TURN_PID"
  RUN_TURN_RC=$?
  [ "$RUN_TURN_TIMED_OUT" = 1 ] && RUN_TURN_RC=124
  RUN_TURN_PID=""
  set -e
  return 0
}

child_pids() { # child_pids PARENT
  if ps -W >/dev/null 2>&1; then
    ps -W 2>/dev/null | awk -v p="$1" 'NR>1 && $2==p {print $1}'
  else
    ps -eo pid=,ppid= 2>/dev/null | awk -v p="$1" '$2==p {print $1}'
  fi
}

signal_run_tree() { # signal_run_tree SIGNAL PID
  local signal="$1" pid="$2" child
  for child in $(child_pids "$pid"); do signal_run_tree "$signal" "$child"; done
  kill "-$signal" "$pid" 2>/dev/null || true
}

stop_run_turn() {
  if [ -n "$RUN_TURN_PID" ]; then
    local pid="$RUN_TURN_PID" i
    signal_run_tree TERM "$pid"
    for i in 1 2 3 4 5; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && signal_run_tree KILL "$pid"
    set +e; wait "$pid" 2>/dev/null; set -e
    RUN_TURN_PID=""
  fi
}

cancel_plain_turn() { stop_run_turn; exit 130; }

# ---------------------------------------------------------------------------
# THE REVIEW-OUTPUT CONTRACT (shared-db issue #1220)
#
# Two separate defects were observed in one night, both of which let a wrapper
# exit 0 with no usable review:
#
#  1. SILENCE READ AS APPROVE. A run ended after 637 seconds of provider time
#     having written one assistant message ("let me verify a couple of
#     environmental facts before finalizing findings") and no findings. The
#     wrapper printed telemetry and exited 0. A caller reading only the exit code,
#     or only stdout, cannot tell that from a clean review.
#
#  2. THE BODY THROWN AWAY. A run DID produce a full review -- five findings and a
#     hand-traced coverage statement -- and the wrapper printed only:
#         ## Verdict
#         VERDICT: APPROVE
#     because `sed -n '/^## Verdict/,$p'` prints from the heading to the END and
#     discards everything above it. The body survived only in the raw stream. A
#     caller quoting stdout as the review evidence would have posted a bare
#     two-line APPROVE as the audit record for a change one step from a
#     production write.
#
# In this repository's workflows a review is a MERGE GATE, and both failure modes
# are biased toward "looks approved". So:
#
#   * the FULL text is printed, never the tail from a heading; and
#   * a turn with no answer text, or with no '## Verdict' heading, is reported as
#     a wrapper failure, not as a review that found nothing.
# ---------------------------------------------------------------------------

# Set by extract_answer: empty on success, otherwise why this turn produced no
# usable review. A global rather than an exit status because finish_turn also runs
# on the implement lifecycle path, where aborting early would skip artifact export.
ANSWER_DEFECT=""

extract_answer() { # extract_answer FILE
  local text
  ANSWER_DEFECT=""
  text="$(jq -r 'select(.role=="assistant") | .content // ""' "$1" 2>/dev/null | sed '/^$/d')"
  if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
    ANSWER_DEFECT="the provider produced no answer text at all (it ended mid-run)"
  elif ! printf '%s' "$text" | grep -qF '## Verdict'; then
    ANSWER_DEFECT="the answer carries no '## Verdict' heading, so no verdict was reached"
  fi
  # ALWAYS the whole body. Findings routinely sit ABOVE the verdict heading, and
  # printing only the tail is how a complete review became a two-line APPROVE.
  printf '%s\n' "$text"
}

# Report the defect loudly on stderr and return non-zero. Never downgrades to success.
report_answer_defect() { # report_answer_defect NAME STREAM_PATH
  [ -n "$ANSWER_DEFECT" ] || return 0
  printf 'ai-kimi: error: no usable review for %s: %s\n' "${1:-this turn}" "$ANSWER_DEFECT" >&2
  printf 'ai-kimi: this is a WRAPPER/PROVIDER failure, not a clean review. Silence is not approval.\n' >&2
  printf 'ai-kimi: do NOT record this as a verdict. Re-run it, or replace the reviewer.\n' >&2
  [ -n "${2:-}" ] && printf 'ai-kimi: raw provider stream: %s\n' "$2" >&2
  return 1
}

PROMPT_FOOTER="

---
Formatting requirement: structure your reply so the final answer is last, under a
literal '## Verdict' heading. Put any narration above it."
DECISION_FOOTER="

---
Formatting requirement: answer every requested decision, then finish under a literal
'## Unresolved objections' heading. Write 'None' there only when no material objection remains."

build_prompt_file() {
  local dest="$1" body
  body="$dest.body"
  if [ -n "${OPT_PROMPT_FILE:-}" ]; then
    [ -f "$OPT_PROMPT_FILE" ] || die "prompt file not found: $OPT_PROMPT_FILE"
    cat "$OPT_PROMPT_FILE" > "$body"
  elif [ -n "${OPT_PROMPT:-}" ]; then printf '%s\n' "$OPT_PROMPT" > "$body"
  elif [ ! -t 0 ]; then cat > "$body"
  else die "no prompt given. Use --prompt TEXT, --prompt-file FILE, or pipe it on stdin."
  fi
  [ -s "$body" ] || die "the prompt is empty."
  # A review gets the packet preamble first; an implement run does not (it has a
  # shell and works in its own worktree, so there is nothing to hand it).
  if [ -n "$PACKET_HASH" ]; then printf '%s' "$PACKET_PREAMBLE" > "$dest"; else : > "$dest"; fi
  cat "$body" >> "$dest"
  rm -f "$body"
  if [ "${OPT_REVIEW_KIND:-diff}" = diff ]; then printf '%s' "$PROMPT_FOOTER" >> "$dest"
  else printf '%s' "$DECISION_FOOTER" >> "$dest"; fi
}

# Defence in depth: the agent profile is the guarantee, this catches a profile
# that silently stopped working (e.g. a Kimi upgrade changing frontmatter rules).
tree_state() { git -C "$1" status --porcelain 2>/dev/null | sort; }

review_destination_safe() { # REPO EXACT-DESTINATION
  local repo="$1" out="$2" rel physical_ai physical_reviews physical_repo
  case "$out" in "$repo"/.ai/reviews/*) ;; *) return 1 ;; esac
  rel="${out#"$repo"/}"
  # A tracked destination is committable even when --no-index also matches an
  # ignore rule.  Never recreate a tracked historical report.
  git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && return 1
  git -C "$repo" check-ignore --no-index -q -- "$rel" 2>/dev/null || return 1
  # Refuse a symlink/junction-like path component.  Review output must stay
  # physically inside the repository or in the wrapper's private state.
  [ ! -L "$repo/.ai" ] && [ ! -L "$repo/.ai/reviews" ] || return 1
  physical_repo="$(cd "$repo" && pwd -P)" || return 1
  if [ -e "$repo/.ai" ]; then
    physical_ai="$(cd "$repo/.ai" && pwd -P)" || return 1
    case "$physical_ai" in "$physical_repo"/*) ;; *) return 1 ;; esac
  fi
  if [ -e "$repo/.ai/reviews" ]; then
    physical_reviews="$(cd "$repo/.ai/reviews" && pwd -P)" || return 1
    case "$physical_reviews" in "$physical_repo"/*) ;; *) return 1 ;; esac
  fi
  return 0
}

reviews_dir() { # REPO EXACT-BASENAME
  local repo="$1" base="${2:-.ai-kimi-ignore-probe.md}" out
  out="$repo/.ai/reviews/$base"
  review_destination_safe "$repo" "$out" && printf '%s/.ai/reviews' "$repo" || printf ''
}

assistant_text() { jq -r 'select(.role=="assistant") | .content // ""' "$1" 2>/dev/null; }

review_answer_defect() { # STREAM -> reason or empty
  local text
  text="$(assistant_text "$1")"
  if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then printf 'missing-answer'
  elif ! printf '%s' "$text" | grep -qF '## Verdict'; then printf 'missing-verdict'
  else printf ''
  fi
}

FINAL_CANONICAL=""; FINAL_MIRROR=""; FINAL_HASH=""; FINAL_KIND=""
render_review_artifact() { # META STREAM KIND REASON
  local meta="$1" stream="$2" kind="$3" reason="$4" out tmp name repo sid rc head jobid
  out="$(jq -r '.artifact_paths.canonical // ""' "$meta")"
  [ -n "$out" ] || return 1
  case "$(basename "$out")" in review-*.md) ;; *) return 1 ;; esac
  same_path "$(dirname "$out")" "$(dirname "$meta")" || return 1
  [ ! -e "$out" ] || return 1
  tmp="$(mktemp "$(dirname "$out")/.review.XXXXXX")" || return 1
  chmod 0600 "$tmp" 2>/dev/null || true
  name="$(jq -r .name "$meta")"; repo="$(jq -r .repo "$meta")"
  sid="$(session_id_from "$stream")"; [ -n "$sid" ] || sid=unavailable
  rc="$(jq -r '.exit_code // "unavailable"' "$meta")"
  head="$(jq -r '.head // "unavailable"' "$meta")"; jobid="$(jq -r .job_id "$meta")"
  {
    if [ "$kind" = complete ]; then
      echo "# Kimi review — $name"
    else
      echo "# INCOMPLETE — NO VERDICT — Kimi review $name"
      echo
      echo "This is recovery evidence only. It cannot approve a change or satisfy a review gate."
    fi
    echo
    echo "- Job: \`$jobid\`"
    echo "- Repository at launch: \`$repo\`"
    echo "- Reviewed head: \`$head\`"
    echo "- Kimi session: \`$sid\`"
    echo "- Model requested: \`$KIMI_MODEL\` (returned model, tokens, cache, and cost: unavailable)"
    echo "- Artifact kind: \`$kind\`"
    echo "- Terminal reason: \`${reason:-session.resume_hint}\`"
    echo "- Command exit status: \`$rc\`"
    echo "- Raw stream: \`$stream\`"
    echo "- Provider stderr: \`$stream.err\`"
    echo; echo "---"; echo
    assistant_text "$stream"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$out" || { rm -f "$tmp"; return 1; }
  FINAL_CANONICAL="$out"; FINAL_HASH="$(sha256_file "$out")"; FINAL_KIND="$kind"; FINAL_MIRROR=""
  return 0
}

mirror_review_artifact() { # META CANONICAL
  local meta="$1" canonical="$2" repo name stamp base dir out tmp
  repo="$(jq -r .repo "$meta")"; [ -e "$repo/.git" ] || { warn "repository copy is gone; canonical review kept at $canonical"; return 0; }
  name="$(jq -r .name "$meta")"; stamp="$(basename "$canonical" .md | sed 's/^review-//')"
  base="kimi-${name}-${stamp}.md"; dir="$(reviews_dir "$repo" "$base")"
  if [ -z "$dir" ]; then warn "not mirroring review: exact destination '$repo/.ai/reviews/$base' is not safely git-ignored"; return 0; fi
  mkdir -p "$dir" || return 1; out="$dir/$base"; [ ! -e "$out" ] || { warn "not overwriting existing review mirror: $out"; return 0; }
  tmp="$(mktemp "$dir/.kimi-review.XXXXXX")" || return 1; cp "$canonical" "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$out" || { rm -f "$tmp"; return 1; }
  FINAL_MIRROR="$out"
}

finalize_review_artifact() { # META STREAM KIND REASON
  local meta="$1" stream="$2" kind="$3" reason="$4"
  [ "${AI_KIMI_TEST_FAIL_ARTIFACT:-0}" != 1 ] || return 1
  render_review_artifact "$meta" "$stream" "$kind" "$reason" || return 1
  mirror_review_artifact "$meta" "$FINAL_CANONICAL" || warn "repository mirror failed; canonical review kept at $FINAL_CANONICAL"
  return 0
}

# Foreground implementation conversations still get a human-facing transcript.
# Durable review jobs use finalize_review_artifact instead and never call this.
write_review_file() { # REPO NAME STREAM
  local repo="$1" name="$2" stream="$3" stamp base dir out tmp
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"; base="kimi-${name}-${stamp}.md"; dir="$(reviews_dir "$repo" "$base")"
  [ -n "$dir" ] || { warn "not writing transcript: exact destination is not safely git-ignored"; return 0; }
  mkdir -p "$dir" || return 1; out="$dir/$base"; tmp="$(mktemp "$dir/.kimi-turn.XXXXXX")" || return 1
  { echo "# Kimi turn — $name"; echo; assistant_text "$stream"; } > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$out" || { rm -f "$tmp"; return 1; }; printf '%s' "$out"
}

# ---------------------------------------------------------------------------
# Durable review jobs.  The worker, not the foreground command, owns the Kimi
# child and the final state.  Metadata is an allowlist: never add prompts,
# raw environment values, or credential-file names here.
# ---------------------------------------------------------------------------
write_job_state() { # META JSON-PATCH
  local meta="$1" next
  shift
  next="$(jq "$@" "$meta")" || return 1
  write_meta "$meta" "$next"
}

create_review_job() { # NAME REPO RID MODE SESSION-ID PROMPT-FILE
  local name="$1" repo="$2" rid="$3" mode="$4" sid="$5" pf="$6" dir meta now jobid stamp canonical upstream
  dir="$(job_dir "$rid" "$name")"; meta="$dir/job.json"
  mkdir -p "$dir" || die "could not create durable Kimi job state."
  chmod 0700 "$dir" 2>/dev/null || true
  now="$(date -u +%FT%TZ)"; jobid="${rid}-${CALLER}-${name}"; upstream="$(require_upstream_identity "$repo")"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"; canonical="$dir/review-$stamp.md"
  write_meta "$meta" "$(jq -n --arg id "$jobid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg upstream "$upstream" \
    --arg head "$(git -C "$repo" rev-parse HEAD)" --arg caller "$CALLER" --arg name "$name" --arg mode "$mode" \
    --arg sid "$sid" --arg model "$KIMI_MODEL" --arg home_hash "$(safe_home_hash)" --arg created "$now" \
    --arg out "$dir/stream.jsonl" --arg log "$dir/worker.log" --arg canonical "$canonical" --arg cancel "$dir/cancel.request" \
    '{version:1,job_id:$id,repo:$repo,repo_remote:$remote,upstream_identity:$upstream,head:$head,caller:$caller,name:$name,mode:$mode,
      kimi_session_id:(if $sid=="" then null else $sid end),model:$model,kimi_home_sha256:$home_hash,
      created:$created,updated:$created,phase:"preflight",worker_pid:null,kimi_child_pid:null,
      last_output_at:null,last_output_size:0,terminal_reason:null,exit_code:null,
      cancel_request:$cancel,artifact_paths:{stream:$out,log:$log,canonical:$canonical,repository:null},
      artifact_kind:null,artifact_sha256:null}')"
}

launch_review_worker() { # JOB-DIR PROMPT-FILE
  local dir="$1" pf="$2" pid="" bash_bin win_dir win_pf win_self ps_bash ps_dir ps_pf ps_self
  [ "${AI_KIMI_TEST_FAIL_WORKER_START:-0}" != 1 ] || return 1
  if [ "${AI_KIMI_TEST_DIRECT_WORKER:-0}" = 1 ]; then
    [ "${AI_KIMI_TEST_MODE:-0}" = 1 ] || return 1
    nohup bash "$_self" __review-worker "$dir" "$pf" </dev/null >>"$dir/worker.log" 2>&1 &
    printf '%s' "$!"
    return 0
  fi
  # Start-Process is the Windows primitive that survives a Git-Bash/Codex
  # caller boundary and does not show a console.  The generated launcher has
  # only paths, never a prompt or credentials.
  if command -v powershell.exe >/dev/null 2>&1; then
    local launcher="$dir/launch-worker.ps1" bootstrap="$dir/launch-bootstrap.ps1"
    bash_bin="$(command -v bash)"
    command -v cygpath >/dev/null 2>&1 && bash_bin="$(cygpath -w "$bash_bin")"
    win_dir="$dir"; win_pf="$pf"; win_self="$SELF_DIR/ai-kimi"
    if command -v cygpath >/dev/null 2>&1; then
      win_dir="$(cygpath -w "$dir")"; win_pf="$(cygpath -w "$pf")"; win_self="$(cygpath -w "$SELF_DIR/ai-kimi")"
    fi
    ps_bash="${bash_bin//\'/\'\'}"; ps_dir="${win_dir//\'/\'\'}"; ps_pf="${win_pf//\'/\'\'}"; ps_self="${win_self//\'/\'\'}"
    printf '%s\n' '$ErrorActionPreference="Stop"' \
      "\$env:AI_KIMI_WORKER_DIR='$ps_dir'" \
      "\$env:AI_KIMI_WORKER_PROMPT='$ps_pf'" \
      "\$argLine='\"$ps_self\" __review-worker-env'" \
      "\$p=Start-Process -FilePath '$ps_bash' -ArgumentList \$argLine -WindowStyle Hidden -RedirectStandardOutput '$ps_dir\\worker.log' -RedirectStandardError '$ps_dir\\worker.err' -PassThru" \
      '[Console]::Write($p.Id)' > "$launcher"
    printf '%s\n' '$ErrorActionPreference="Stop"' \
      '$psi = [System.Diagnostics.ProcessStartInfo]::new()' \
      "\$psi.FileName = 'powershell.exe'" \
      "\$psi.Arguments = '-NoProfile -ExecutionPolicy Bypass -File \"$ps_dir\\launch-worker.ps1\"'" \
      '$psi.UseShellExecute = $true' \
      '$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden' \
      '[System.Diagnostics.Process]::Start($psi) | Out-Null' > "$bootstrap"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$bootstrap" </dev/null >/dev/null 2>&1 || return 1
    pid=0
  else
    nohup bash "$_self" __review-worker "$dir" "$pf" </dev/null >>"$(job_log "$(basename "$(dirname "$dir")")" "$(basename "$dir" | sed "s/^$CALLER--//")")" 2>&1 &
    pid=$!
  fi
  printf '%s' "$pid"
}

cleanup_review_transients() { # JOB-DIR PROMPT-FILE
  rm -f -- "$2" "$1/launch-worker.ps1" "$1/launch-bootstrap.ps1" 2>/dev/null || true
}

release_review_worker_resources() { # JOB-DIR PROMPT-FILE REPO-LOCK JOB-META
  # A terminal phase is a readiness contract: callers may immediately start
  # the next paid turn.  Release the exact repository lock before publishing
  # that phase so a loaded machine cannot observe "completed" while cleanup is
  # still holding the lock.  The delay is a deterministic regression hook.
  if [ "${AI_KIMI_TEST_TERMINAL_CLEANUP_DELAY:-0}" -gt 0 ] 2>/dev/null; then
    sleep "$AI_KIMI_TEST_TERMINAL_CLEANUP_DELAY"
  fi
  cleanup_review_transients "$1" "$2"
  lock_release "$3"
  # Test-only fault injection proves that a failed deletion can never be
  # published as terminal readiness. A directory at the launcher path models
  # an undeletable transient without depending on host ACL behavior.
  [ "${AI_KIMI_TEST_FAIL_TERMINAL_CLEANUP:-0}" != 1 ] || mkdir -p "$1/launch-worker.ps1"
  if [ -e "$2" ] || [ -e "$1/launch-worker.ps1" ] \
    || [ -e "$1/launch-bootstrap.ps1" ] || [ -d "$3" ]; then
    write_job_state "$4" --arg u "$(date -u +%FT%TZ)" \
      '.phase="recovery-required"|.terminal_reason="transient-cleanup-failed"|.exit_code=2|.updated=$u' \
      || true
    return 1
  fi
  trap - EXIT
}

review_worker() { # JOB-DIR PROMPT-FILE
  local dir="$1" pf="$2" meta out repo workdir repo_lock name mode sid before source_before rc reason new_sid stale=false provider_started provider_seconds defect terminal_phase
  meta="$dir/job.json"; [ -f "$meta" ] || exit 2
  repo="$(jq -r .repo "$meta")"; name="$(jq -r .name "$meta")"; mode="$(jq -r .mode "$meta")"
  workdir="$(jq -r '.review_workspace // .repo' "$meta")"
  repo_lock="$(jq -r '.repo_lock // ""' "$meta")"
  if [ -n "$repo_lock" ] && [ -d "$repo_lock" ]; then printf '%s\n' "$$" > "$repo_lock/pid"; fi
  # The worker owns these transients after startup acknowledgement. Keep their
  # cleanup in the emergency EXIT path as well as each explicit terminal path.
  trap 'cleanup_review_transients "$dir" "$pf"; lock_release "$repo_lock"' EXIT
  sid="$(jq -r '.kimi_session_id // ""' "$meta")"; out="$(jq -r .artifact_paths.stream "$meta")"
  ACTIVE_JOB_META="$meta"; ACTIVE_CANCEL_FILE="$(jq -r .cancel_request "$meta")"
  write_job_state "$meta" --arg p "$$" --arg u "$(date -u +%FT%TZ)" '.phase="starting"|.worker_pid=($p|tonumber)|.updated=$u' || exit 2
  before="$(tree_state "$workdir")"; source_before="$(tree_state "$repo")"
  write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" '.phase="running"|.updated=$u' || exit 2
  provider_started="$(date +%s)"
  run_turn "$workdir" "$out" "$pf" "$mode" "$sid"; rc="$RUN_TURN_RC"
  provider_seconds="$(( $(date +%s) - provider_started ))"
  write_job_state "$meta" --argjson seconds "$provider_seconds" --arg u "$(date -u +%FT%TZ)" '.timing.provider_seconds=$seconds|.timing.model_steps="unavailable"|.updated=$u' || exit 2
  if [ "$RUN_TURN_CANCELLED" = 1 ] || [ -f "$ACTIVE_CANCEL_FILE" ] \
    || jq -e '.cancel_requested == true' "$meta" >/dev/null 2>&1; then
    write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --argjson rc "$rc" '.phase="finalizing"|.terminal_reason="cancelled-by-user"|.exit_code=$rc|.updated=$u' || exit 2
    if ! finalize_review_artifact "$meta" "$out" incomplete cancelled-by-user; then
      release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
      write_job_state "$meta" '.phase="recovery-required"|.terminal_reason="artifact-write-failed"'
      exit 2
    fi
    release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
    write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg c "$FINAL_CANONICAL" --arg m "$FINAL_MIRROR" --arg h "$FINAL_HASH" '.phase="cancelled"|.updated=$u|.artifact_paths.canonical=$c|.artifact_paths.repository=(if $m=="" then null else $m end)|.artifact_kind="incomplete"|.artifact_sha256=$h' || exit 2
    exit 1
  fi
  if has_resume_hint "$out"; then
    new_sid="$(session_id_from "$out")"
    [ -n "$new_sid" ] || reason=malformed-output
    if [ "$mode" = review ] && [ "$before" != "$(tree_state "$workdir")" ]; then
      reason=readonly-tree-changed
    fi
    defect="$(review_answer_defect "$out")"; [ -n "${reason:-}" ] || [ -z "$defect" ] || reason="$defect"
    if [ -n "${reason:-}" ]; then
      write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg r "$reason" --argjson rc "$rc" '.phase="finalizing"|.terminal_reason=$r|.exit_code=$rc|.updated=$u' || exit 2
      if ! finalize_review_artifact "$meta" "$out" incomplete "$reason"; then
        release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
        write_job_state "$meta" '.phase="recovery-required"|.terminal_reason="artifact-write-failed"'
        exit 2
      fi
      release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
      write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg c "$FINAL_CANONICAL" --arg m "$FINAL_MIRROR" --arg h "$FINAL_HASH" '.phase="failed"|.updated=$u|.artifact_paths.canonical=$c|.artifact_paths.repository=(if $m=="" then null else $m end)|.artifact_kind="incomplete"|.artifact_sha256=$h' || exit 2
      exit 1
    fi
    [ "$source_before" = "$(tree_state "$repo")" ] || stale=true
    write_meta "$(meta_path "$(repo_id "$repo")" "$name")" "$(jq -n --arg sid "$new_sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg upstream "$(jq -r .upstream_identity "$meta")" --arg workspace "$workdir" --arg kind "$(jq -r '.review_kind // "diff"' "$meta")" --arg base "$(jq -r '.base // ""' "$meta")" --arg head "$(jq -r '.head // ""' "$meta")" --arg name "$name" --arg caller "$CALLER" --arg mode "$mode" --arg model "$KIMI_MODEL" --arg created "$(date -u +%FT%TZ)" '{kimi_session_id:$sid,repo:$repo,repo_remote:$remote,upstream_identity:$upstream,review_workspace:$workspace,review_kind:$kind,base:$base,head:$head,name:$name,caller:$caller,mode:$mode,model:$model,created:$created,updated:$created,turns:1}')"
    write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --argjson rc "$rc" '.phase="finalizing"|.terminal_reason="session.resume_hint"|.exit_code=$rc|.updated=$u' || exit 2
    if ! finalize_review_artifact "$meta" "$out" complete session.resume_hint; then
      release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
      write_job_state "$meta" '.phase="recovery-required"|.terminal_reason="artifact-write-failed"'
      exit 2
    fi
    release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
    write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg sid "$new_sid" --arg c "$FINAL_CANONICAL" --arg m "$FINAL_MIRROR" --arg h "$FINAL_HASH" --argjson stale "$stale" '.phase="completed"|.kimi_session_id=$sid|.updated=$u|.source_checkout_changed=$stale|.artifact_paths.canonical=$c|.artifact_paths.repository=(if $m=="" then null else $m end)|.artifact_kind="complete"|.artifact_sha256=$h' || exit 2
    exit 0
  fi
  reason="provider-process-failed"
  [ "$RUN_TURN_TIMED_OUT" = 1 ] && reason="timed-out"
  [ "$RUN_TURN_STARTUP_FAILED" = 1 ] && reason="startup-timeout"
  grep -Eqi 'created under a different directory' "$out" "$out.err" 2>/dev/null && reason="directory-mismatch"
  grep -Eqi 'EPERM|EACCES|permission denied|mkdir' "$out" "$out.err" 2>/dev/null && reason="execution-context-denied"
  grep -Eqi 'usage limit|billing cycle|quota (reached|exceeded)|purchase extra usage' "$out" "$out.err" 2>/dev/null && reason="usage-limit"
  [ "$reason" = provider-process-failed ] && grep -Eqi 'auth|credential|provider|no providers' "$out" "$out.err" 2>/dev/null && reason="credentials-unavailable"
  terminal_phase="failed"; [ "$reason" = timed-out ] && terminal_phase="timed-out"
  write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg r "$reason" --argjson rc "$rc" '.phase="finalizing"|.terminal_reason=$r|.exit_code=$rc|.updated=$u' || exit 2
  if ! finalize_review_artifact "$meta" "$out" incomplete "$reason"; then
    release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
    write_job_state "$meta" '.phase="recovery-required"|.terminal_reason="artifact-write-failed"'
    exit 2
  fi
  release_review_worker_resources "$dir" "$pf" "$repo_lock" "$meta" || exit 2
  write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg phase "$terminal_phase" --arg c "$FINAL_CANONICAL" --arg m "$FINAL_MIRROR" --arg h "$FINAL_HASH" '.phase=$phase|.updated=$u|.artifact_paths.canonical=$c|.artifact_paths.repository=(if $m=="" then null else $m end)|.artifact_kind="incomplete"|.artifact_sha256=$h' || exit 2
  exit 1
}

start_review_job() { # NAME [CONTINUE]
  local name="$1" cont="${2:-0}" repo rid upstream lockid existing sid stored_upstream recorded_workspace="" pf dir pid repo_lock prep_started prep_seconds source_before_prepare startup_waited=0 phase
  valid_name "$name" || die "invalid session name '$name' (letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"; dir="$(job_dir "$rid" "$name")"
  if [ -f "$dir/job.json" ] && ! job_is_terminal "$dir/job.json"; then
    jq -r '.job_id' "$dir/job.json"; return 0
  fi
  upstream="$(require_upstream_identity "$repo")"; lockid="$(review_lock_id "$upstream")"
  repo_lock="$(repolock_path "$lockid")"
  lock_acquire "$repo_lock" "review:$name" || die "another Kimi run is already active in this repository: $(lock_info "$repo_lock")"
  trap "lock_release '$repo_lock'" EXIT
  sid=""
  if [ "$cont" = 1 ]; then
    existing="$(find_meta "$rid" "$name")"; sid="$(jq -r .kimi_session_id "$existing")"
    stored_upstream="$(jq -r '.upstream_identity // empty' "$existing")"
    [ -n "$stored_upstream" ] || die "review session '$name' predates durable upstream binding and cannot be resumed safely. Start a new named Kimi review."
    [ "$upstream" = "$stored_upstream" ] || die "review session '$name' belongs to a different shared upstream. Restore its original origin or start a new named Kimi review; no provider call was made."
    recorded_workspace="$(jq -r '.review_workspace // empty' "$existing")"
    [ -n "$recorded_workspace" ] || die "review session '$name' has no recorded stable workspace and cannot be resumed safely. Start a new named Kimi review."
    [ -n "$OPT_REVIEW_KIND" ] || OPT_REVIEW_KIND="$(jq -r '.review_kind // "diff"' "$existing")"
  elif [ -f "$(meta_path "$rid" "$name")" ]; then
    die "session '$name' already exists. Use: ai-kimi ask $name"
  fi
  preflight_or_die review "$repo" || { lock_release "$repo_lock"; return 1; }
  prep_started="$(date +%s)"
  source_before_prepare="$(tree_state "$repo")"
  if [ -n "$OPT_TESTS" ] && printf '%s' "$OPT_TESTS" | grep -Eqi 'test-ai-kimi|test-all|full[ -]?suite'; then
    warn "a broad test command will run synchronously before Kimi: $OPT_TESTS"
    warn "use a focused command for an ordinary review; broad suites belong to an explicit final check."
  fi
  OPT_REVIEW_KIND="${OPT_REVIEW_KIND:-diff}"
  prepare_review "$repo" "kimi-$CALLER-$name" "$recorded_workspace"
  if [ "$source_before_prepare" != "$(tree_state "$repo")" ]; then
    release_boundary "$repo" "kimi-$CALLER-$name"
    die "source-checkout-changed while the private review snapshot was being prepared; retry from a stable checkout."
  fi
  prep_seconds="$(( $(date +%s) - prep_started ))"
  pf="$(mktemp "$STATE_DIR/.kimi-prompt.XXXXXX")"
  # From this point until a worker is proven started, every shell error must
  # remove the private prompt and fixed-name launchers as well as the repo lock.
  # The worker takes ownership only after the startup acknowledgement below.
  trap "cleanup_review_transients '$dir' '$pf'; lock_release '$repo_lock'" EXIT
  chmod 0600 "$pf" 2>/dev/null || true; build_prompt_file "$pf"
  create_review_job "$name" "$repo" "$rid" review "$sid" "$pf"
  write_job_state "$dir/job.json" --arg workspace "$REVIEW_DIR" --arg lock "$repo_lock" --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" --arg packet "$PACKET_HASH" --arg kind "$OPT_REVIEW_KIND" --argjson prep "$prep_seconds" --argjson snapshot "$REVIEW_SNAPSHOT_SECONDS" --argjson packet_seconds "$REVIEW_PACKET_SECONDS" --argjson tests "$REVIEW_TEST_SECONDS" '.review_workspace=$workspace|.repo_lock=$lock|.base=$base|.head=$head|.packet_sha256=$packet|.review_kind=$kind|.timing={snapshot_seconds:$snapshot,test_seconds:$tests,packet_seconds:$packet_seconds,pre_provider_seconds:$prep,provider_seconds:null,model_steps:"unavailable"}'
  if ! pid="$(launch_review_worker "$dir" "$pf")"; then
    lock_release "$repo_lock"
    write_job_state "$dir/job.json" --arg u "$(date -u +%FT%TZ)" '.phase="failed"|.terminal_reason="worker-start-failed"|.updated=$u'
    cleanup_review_transients "$dir" "$pf"
    die "could not start durable Kimi worker"
  fi
  [ -n "$pid" ] || { lock_release "$repo_lock"; write_job_state "$dir/job.json" '.phase="failed"|.terminal_reason="worker-start-failed"'; cleanup_review_transients "$dir" "$pf"; die "could not start durable Kimi worker"; }
  while [ "$startup_waited" -lt "$STARTUP_TIMEOUT" ]; do
    phase="$(jq -r .phase "$dir/job.json")"
    [ "$phase" != preflight ] && break
    sleep 1; startup_waited=$((startup_waited+1))
  done
  if [ "${phase:-preflight}" = preflight ]; then
    lock_release "$repo_lock"
    write_job_state "$dir/job.json" --arg u "$(date -u +%FT%TZ)" '.phase="failed"|.terminal_reason="worker-start-failed"|.updated=$u'
    # The detached bootstrap exceeded the bounded acknowledgement window.
    # Removing its exact prompt makes an abnormally late worker fail closed
    # before contacting Kimi; run_turn refuses a missing or empty prompt.
    cleanup_review_transients "$dir" "$pf"
    die "detached worker did not acknowledge startup within ${STARTUP_TIMEOUT}s"
  fi
  trap - EXIT
  jq -r '.job_id' "$dir/job.json"
}

job_for_name() {
  local repo rid exact fallback remote found candidate
  repo="$(repo_root)"; rid="$(repo_id "$repo")"; exact="$(job_meta "$rid" "$1")"; fallback="$exact"; [ -f "$exact" ] && { printf '%s' "$exact"; return; }
  remote="$(repo_remote "$repo")"; found=""
  while IFS= read -r candidate; do
    [ "$(jq -r '.name // ""' "$candidate" 2>/dev/null)" = "$1" ] || continue
    [ "$(jq -r '.caller // ""' "$candidate" 2>/dev/null)" = "$CALLER" ] || continue
    [ -n "$remote" ] && [ "$(jq -r '.repo_remote // ""' "$candidate" 2>/dev/null)" = "$remote" ] || continue
    [ -z "$found" ] || die "more than one durable job named '$1' matches this repository remote"
    found="$candidate"
  done < <(find "$STATE_DIR/jobs" -type f -name job.json -print 2>/dev/null)
  [ -n "$found" ] && printf '%s' "$found" || printf '%s' "$fallback"
}
require_job_for_name() {
  local meta
  meta="$(job_for_name "$1")"
  [ -f "$meta" ] || die "no durable job '$1' for caller '$CALLER' in this repository. Start it with: ai-kimi start $1 --prompt-file <brief>"
  printf '%s' "$meta"
}
terminal_guidance() {
  case "$1" in
    usage-limit) note "ai-kimi: Kimi refused the run because the account usage limit was reached. The incomplete artifact preserves any partial answer; retry after quota is available." ;;
    timed-out|startup-timeout) note "ai-kimi: the provider did not finish before the safety deadline. The incomplete artifact preserves the available evidence." ;;
    directory-mismatch) note "ai-kimi: Kimi rejected the private review directory. Start a new review after checking the saved paths." ;;
    credentials-unavailable) note "ai-kimi: Kimi credentials or provider access were unavailable." ;;
    execution-context-denied) note "ai-kimi: run this credentialed Kimi job from the Full Access main task." ;;
    readonly-tree-changed) note "ai-kimi: the read-only restriction is not holding. This review is invalid." ;;
    missing-answer|missing-verdict|malformed-output) note "ai-kimi: Kimi stopped without a usable review verdict. The incomplete artifact is evidence only." ;;
    worker-start-failed) note "ai-kimi: the detached worker could not start; no provider review occurred." ;;
    artifact-write-failed) note "ai-kimi: the permanent review artifact could not be written. Raw evidence remains in the job directory; run: ai-kimi recover $2" ;;
    cancelled-by-user) note "ai-kimi: the review was cancelled. The incomplete artifact preserves any partial answer." ;;
    *) note "ai-kimi: Kimi ended without the required session.resume_hint terminal record or a proven usable verdict. The incomplete artifact preserves the available evidence." ;;
  esac
}
display_review_job() { # META
  local meta="$1" artifact expected actual kind
  artifact="$(jq -r '.artifact_paths.canonical // ""' "$meta")"; expected="$(jq -r '.artifact_sha256 // ""' "$meta")"
  [ -n "$artifact" ] && [ -f "$artifact" ] || { terminal_guidance artifact-write-failed "$(jq -r .name "$meta")"; return 1; }
  actual="$(sha256_file "$artifact")"; [ -n "$expected" ] && [ "$actual" = "$expected" ] || { note "ai-kimi: saved review artifact failed its integrity check: $artifact"; return 1; }
  cat "$artifact"
  note "canonical artifact: $artifact"
  [ "$(jq -r '.artifact_paths.repository // ""' "$meta")" = "" ] || note "repository mirror: $(jq -r .artifact_paths.repository "$meta")"
  note "note: Kimi reports no token, cost, or returned-model data; none is claimed for this run."
  kind="$(jq -r '.artifact_kind // "incomplete"' "$meta")"; [ "$kind" = complete ]
}
cmd_wait_job() { # NAME
  local meta out waited=0 phase size
  meta="$(require_job_for_name "$1")"
  out="$(jq -r .artifact_paths.stream "$meta")"
  while ! job_is_terminal "$meta"; do
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
    [ "$waited" -lt "$WAIT_TIMEOUT" ] || die "wait limit reached; worker continues. Use: ai-kimi status $1"
    if [ $((waited % HEARTBEAT_INTERVAL)) -eq 0 ]; then phase="$(jq -r .phase "$meta")"; size="$(wc -c < "$out" 2>/dev/null || echo 0)"; note "job $1: $phase, ${waited}s, output ${size} bytes"; fi
  done
  display_review_job "$meta" && return 0
  terminal_guidance "$(jq -r '.terminal_reason // "failed"' "$meta")" "$1"
  return 1
}
cmd_status_job() { local meta; meta="$(require_job_for_name "$1")" || return 1; jq '{job_id,phase,created,updated,terminal_reason,exit_code,worker_pid,kimi_child_pid,last_output_size,review_kind,timing,source_checkout_changed,artifact_kind,artifact_sha256,artifact_paths}' "$meta"; }
cmd_logs_job() { local meta f; meta="$(require_job_for_name "$1")" || return 1; f="$(jq -r .artifact_paths.log "$meta")"; [ -f "$f" ] || die "durable job '$1' has no readable log artifact."; tail -100 "$f"; }
cmd_result_job() { local meta; meta="$(require_job_for_name "$1")"; job_is_terminal "$meta" || die "job '$1' is still running."; display_review_job "$meta" && return 0; terminal_guidance "$(jq -r '.terminal_reason // "failed"' "$meta")" "$1"; return 1; }
cmd_cancel_job() {
  local meta request waited=0
  meta="$(require_job_for_name "$1")"; job_is_terminal "$meta" && { jq . "$meta"; return 0; }
  request="$(jq -r .cancel_request "$meta")"
  printf '%s\n' "$(date -u +%FT%TZ)" > "$request.tmp"
  mv "$request.tmp" "$request"
  write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" '.cancel_requested=true|.cancel_requested_at=$u|.updated=$u'
  while ! job_is_terminal "$meta" && [ "$waited" -lt "$STARTUP_TIMEOUT" ]; do sleep 1; waited=$((waited+1)); done
  if ! job_is_terminal "$meta"; then
    write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" '.phase="recovery-required"|.terminal_reason="cancel-request-unconfirmed"|.updated=$u'
  fi
  jq . "$meta"
}
cmd_recover_job() {
  local meta out reason artifact defect kind phase prior_reason
  meta="$(require_job_for_name "$1")"; out="$(jq -r .artifact_paths.stream "$meta")"
  prior_reason="$(jq -r '.terminal_reason // ""' "$meta")"
  artifact="$(jq -r '.artifact_paths.canonical // ""' "$meta")"
  if [ -f "$artifact" ]; then
    kind="$(jq -r '.artifact_kind // ""' "$meta")"
    if [ "$prior_reason" != session.resume_hint ]; then kind=incomplete; phase=recovery-required
    elif [ -z "$kind" ] && has_resume_hint "$out" && [ -z "$(review_answer_defect "$out")" ] && grep -q '^# Kimi review' "$artifact"; then kind=complete; phase=completed
    else kind="${kind:-incomplete}"; phase="$(jq -r .phase "$meta")"; [ "$phase" = completed ] || phase=recovery-required
    fi
    write_job_state "$meta" --arg h "$(sha256_file "$artifact")" --arg k "$kind" --arg p "$phase" '.artifact_sha256=$h|.artifact_kind=$k|.phase=$p'
    jq . "$meta"; [ "$kind" = complete ] && return 0 || return 1
  fi
  reason="worker-ended-without-terminal-proof"; has_resume_hint "$out" && reason="terminal-stream-needs-worker-finalization"
  write_job_state "$meta" --arg u "$(date -u +%FT%TZ)" --arg r "$reason" '.phase="recovery-required"|.terminal_reason=$r|.exit_code=(.exit_code // 1)|.updated=$u'
  kind=incomplete; phase=recovery-required
  defect="$(review_answer_defect "$out")"
  if [ "$prior_reason" = session.resume_hint ] && has_resume_hint "$out" && [ -z "$defect" ]; then kind=complete; phase=completed; reason=session.resume_hint; fi
  finalize_review_artifact "$meta" "$out" "$kind" "$reason" || die "recovery could not write the permanent artifact; raw stream kept at $out"
  write_job_state "$meta" --arg c "$FINAL_CANONICAL" --arg m "$FINAL_MIRROR" --arg h "$FINAL_HASH" --arg k "$kind" --arg p "$phase" --arg r "$reason" '.artifact_paths.canonical=$c|.artifact_paths.repository=(if $m=="" then null else $m end)|.artifact_kind=$k|.artifact_sha256=$h|.phase=$p|.terminal_reason=$r'
  jq . "$meta"; [ "$kind" = complete ]
}

# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
ai-kimi $VERSION — Kimi Code delegation in persistent, named sessions.

  ai-kimi new <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi ask <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi start <name>     [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi wait|status|logs|result|cancel|recover <name>
  ai-kimi implement <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi reset-context <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi list | show <name> | transcript <name> | delete <name>
  ai-kimi doctor [--live]

Review evidence options for \`new\` and review-mode \`ask\`:
  --base REF           base of the comparison in the evidence packet
  --tests CMD          run CMD and record its exact result in the packet
  --decision TEXT      the one-sentence decision being asked for
  --assert-head SHA    refuse unless the repository is really at SHA
  --review-kind KIND   diff | plan | architecture | analysis (default: diff)

'new' creates a STRUCTURALLY read-only review. 'ask' continues the saved mode:
read-only for reviews, but an implementation continuation (write run) for an
implementation session. 'implement' creates or continues an isolated write
session. Each write turn uses a new disposable worktree reconstructed from the
immutable base and cumulative patch. Ignored build and dependency state does
not persist. No patch is applied to the live repository automatically. Model is
pinned ($KIMI_MODEL) because Kimi does not report which model answered.

Environment:
  AI_KIMI_CALLER       required: 'claude' or 'codex' — keeps sessions separate
  AI_KIMI_BIN          explicit path to the kimi binary
  AI_KIMI_MODEL        model pin ($KIMI_MODEL)
  AI_KIMI_WAIT_TIMEOUT seconds to wait for completion ($WAIT_TIMEOUT)
  AI_KIMI_STARTUP_TIMEOUT startup deadline ($STARTUP_TIMEOUT)
  AI_KIMI_HEARTBEAT_INTERVAL durable job heartbeat interval ($HEARTBEAT_INTERVAL)
  AI_KIMI_STATE_DIR    session state ($STATE_DIR)
  KIMI_CODE_HOME       Kimi OAuth and session home ($KIMI_HOME; credential-bearing)
EOF
}

doctor_worktrees() {
  local root owner repo wt pid state expected
  root="$STATE_DIR/worktrees"; [ -d "$root" ] || return 0
  while IFS= read -r owner; do
    repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
    wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
    pid="$(jq -r '.pid // ""' "$owner" 2>/dev/null)"
    state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
    expected="${wt%/wt}/owner.json"
    if [ "$owner" != "$expected" ] || [ "${wt#"$root"/}" = "$wt" ] || [ ! -d "$repo/.git" ]; then
      warn "ambiguous Kimi worktree owner record left untouched: $owner"; continue
    fi
    if [ "$state" = preserved-recovery ]; then
      warn "preserved Kimi recovery worktree left untouched: $wt"; continue
    fi
    [ "$state" = active ] || { warn "unknown Kimi worktree state left untouched: $owner"; continue; }
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    git -C "$repo" worktree list --porcelain 2>/dev/null | grep -Fxq "worktree $wt" \
      || { warn "unregistered Kimi worktree record left untouched: $owner"; continue; }
    warn "removing stale wrapper-owned Kimi worktree: $wt"
    cleanup_wt "$repo" "$wt" "$owner"
  done < <(find "$root" -type f -name owner.json 2>/dev/null)
}

cmd_doctor() {
  local live=0 kimi rc=0
  [ "${1:-}" = "--live" ] && live=1
  need jq; kimi="$(resolve_kimi)"
  echo "kimi binary   : $kimi"
  echo "kimi version  : $("$kimi" --version 2>&1 | head -1)"
  echo "caller        : $CALLER"
  echo "state dir     : $STATE_DIR"
  echo "Kimi home     : $KIMI_HOME (credential-bearing; path is not copied)"
  echo "model pin     : $KIMI_MODEL"
  if profile_is_readonly; then
    echo "read-only     : PASS ($RO_AGENT)"
  else
    echo "read-only     : FAIL ($RO_AGENT) — profile is missing or grants a write/shell/network tool"; rc=1
  fi
  if preflight_execution_context review "$(pwd)"; then
    echo "preflight     : PASS (state, Kimi home, provider, and safe session write canary)"
  else
    echo "preflight     : FAIL ($PREFLIGHT_CLASS)"
    case "$PREFLIGHT_CLASS" in execution-context-denied|kimi-home-unwritable) echo "                Run credentialed Kimi jobs from the Full Access main task.";; esac
    rc=1
  fi
  if [ -f "$IMPL_AGENT" ]; then
    echo "implement     : $IMPL_AGENT"
  else
    echo "implement     : MISSING ($IMPL_AGENT)"; rc=1
  fi
  echo
  # `kimi provider list` exits 0 even when it reports "No providers configured",
  # so the exit code alone is a false OK. Kimi's credentials are per-user, under
  # ~/.kimi-code, so a second account on a shared box has none of its own.
  local provout
  provout="$("$kimi" provider list 2>/dev/null || true)"
  if printf '%s' "$provout" | grep -qi 'no providers configured' || [ -z "$provout" ]; then
    local as; as="$(run_as_user)"
    if [ -n "$as" ]; then
      echo "auth          : borrowed from user \"$as\""
      echo "                This account has no Kimi credentials of its own (they are"
      echo "                per-user OAuth under ~/.kimi-code, with no config-dir"
      echo "                override). Reviews run as \"$as\"; implement runs do not."
    else
      echo "auth          : NOT AUTHENTICATED for this account ($(id -un))"
      echo "                Kimi credentials are per-user (~/.kimi-code)."
      echo "                Run 'kimi login' as this user, or run ai-kimi as the account"
      echo "                that owns the credentials (default: $KIMI_OWNER)."
      rc=1
    fi
  else
    echo "auth          : OK"
    printf '%s' "$provout" | sed 's/^/                /'
  fi
  if [ "$live" = 1 ]; then
    local tmp; tmp="$(mktemp)"; printf 'Reply with exactly: OK\n' > "$tmp.p"
    echo -n "live probe    : "
    run_turn "$(pwd)" "$tmp" "$tmp.p" review >/dev/null || true
    if has_resume_hint "$tmp"; then echo "OK"; else echo "FAILED — no session.resume_hint"; rc=1; fi
    rm -f "$tmp" "$tmp.p" "$tmp.err" 2>/dev/null || true
  fi
  doctor_worktrees
  return $rc
}

# One implementation lifecycle owns artifact export, worktree cleanup, temporary
# files, and the repository lock. Signal handlers only record cancellation and
# exit; this finalizer does every state-changing cleanup action exactly once.
LIFECYCLE_ACTIVE=0
LIFECYCLE_MODE=""
LIFECYCLE_STATE="failed"
LIFECYCLE_NAME=""
LIFECYCLE_REPO=""
LIFECYCLE_WT=""
LIFECYCLE_OWNER=""
LIFECYCLE_BASE=""
LIFECYCLE_PF=""
LIFECYCLE_OUT=""
LIFECYCLE_LOCK=""
LIFECYCLE_SESSION_LOCK=""
LIFECYCLE_COMMAND_RC="unavailable"
LIFECYCLE_ARTIFACT_DURABLE=0
LIFECYCLE_PRESERVE=0
LIFECYCLE_RID=""
LIFECYCLE_META=""
LIFECYCLE_SID=""
LIFECYCLE_PRIOR_TREE=""

classify_incomplete_state() { # classify_incomplete_state OUTPUT STDERR AWAIT_REASON
  local out="$1" err="$2" reason="$3"
  [ "$LIFECYCLE_STATE" = cancelled ] && { printf 'cancelled'; return; }
  if { [ -s "$out" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$out"; } \
    || { [ -s "$err" ] && grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)' "$err"; }; then
    printf 'usage-limit'
  elif [ "$RUN_TURN_TIMED_OUT" = 1 ] || [ "$reason" = timeout ]; then
    printf 'timed-out'
  elif [ "$LIFECYCLE_COMMAND_RC" != unavailable ] && [ "$LIFECYCLE_COMMAND_RC" -ne 0 ] 2>/dev/null; then
    printf 'failed'
  else
    printf 'failed'
  fi
}

valid_owner_record() { # valid_owner_record REPO WORKTREE OWNER [STATE]
  local repo="$1" wt="$2" owner="$3" wanted="${4:-}" root expected recorded_repo recorded_wt state
  [ -n "$repo" ] && [ -n "$wt" ] && [ -n "$owner" ] && [ -f "$owner" ] || return 1
  root="${STATE_DIR%/}/worktrees"
  case "$wt" in "$root"/kimi.*/wt) ;; *) return 1 ;; esac
  expected="${wt%/wt}/owner.json"
  [ "$owner" = "$expected" ] || return 1
  recorded_repo="$(jq -r '.repo // ""' "$owner" 2>/dev/null)"
  recorded_wt="$(jq -r '.worktree // ""' "$owner" 2>/dev/null)"
  state="$(jq -r '.state // ""' "$owner" 2>/dev/null)"
  [ "$recorded_repo" = "$repo" ] && same_path "$recorded_wt" "$wt" || return 1
  [ -z "$wanted" ] || [ "$state" = "$wanted" ]
}

same_path() { # same_path A B - accounts for Git Bash /tmp to Windows argv conversion
  local a="$1" b="$2"
  if command -v cygpath >/dev/null 2>&1; then
    a="$(cygpath -aw "$a" 2>/dev/null | tr '\\' '/' || printf '%s' "$a")"
    b="$(cygpath -aw "$b" 2>/dev/null | tr '\\' '/' || printf '%s' "$b")"
  fi
  [ "$a" = "$b" ]
}

mark_preserved() { # mark_preserved OWNER
  local owner="$1" json
  json="$(jq '.state="preserved-recovery"' "$owner" 2>/dev/null)" || return 1
  write_meta "$owner" "$json" || return 1
  [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ]
}

safe_report_detail() { # safe_report_detail TERMINAL_STATE
  case "$1" in
    usage-limit) printf 'Kimi reported a usage or billing limit.' ;;
    timed-out)   printf 'The wrapper deadline passed without the required terminal record.' ;;
    cancelled)   printf 'The wrapper received an interrupt or termination request.' ;;
    *)           printf 'Kimi did not emit the required terminal completion record.' ;;
  esac
}

artifact_dir() { # artifact_dir REPO EXACT-BASENAME
  local dir
  [ "${AI_KIMI_TEST_FAIL_EXPORT:-}" = destination ] && return 1
  dir="$(reviews_dir "$1" "$2")"
  if [ -z "$dir" ]; then
    dir="$STATE_DIR/recovery-patches"
    mkdir -p "$dir" 2>/dev/null || return 1
  fi
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 0700 "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

emit_implementation_artifact() { # REPO NAME WT BASE OWNER KIND STATE RC OUT [PRIOR_TREE]
  local repo="$1" name="$2" wt="$3" base="$4" owner="$5" kind="$6" state="$7" rc="$8" out="$9"
  local prior="${10:-$base}" dir ts suffix patch report turn_patch="" patch_tmp turn_tmp="" report_tmp sid summary detail
  valid_owner_record "$repo" "$wt" "$owner" active || {
    warn "refusing artifact export from an ambiguous Kimi worktree owner record: $owner"
    return 1
  }
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  [ "$kind" = incomplete ] && suffix=.incomplete || suffix=""
  dir="$(artifact_dir "$repo" "kimi-${name}-${ts}${suffix}.patch")" || return 1
  patch="$dir/kimi-${name}-${ts}${suffix}.patch"
  report="$dir/kimi-${name}-${ts}.incomplete.md"
  patch_tmp="$(mktemp "$dir/.kimi-patch.XXXXXX")" || return 1
  chmod 0600 "$patch_tmp" 2>/dev/null || true
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --binary "$base" ) > "$patch_tmp" 2>/dev/null \
    || { rm -f "$patch_tmp"; return 1; }
  if [ ! -s "$patch_tmp" ]; then
    rm -f "$patch_tmp"
    [ "$kind" = incomplete ] && note "ai-kimi: failed before changes (terminal state: $state); no empty patch was created." \
      || warn "the implement run produced no changes."
    return 2
  fi
  if [ "$kind" = incomplete ]; then
    if [ "$prior" != "$base" ]; then
      turn_patch="$dir/kimi-${name}-${ts}.turn.incomplete.patch"
      turn_tmp="$(mktemp "$dir/.kimi-turn-patch.XXXXXX")" || { rm -f "$patch_tmp"; return 1; }
      ( cd "$wt" && git diff --binary "$prior" ) > "$turn_tmp" 2>/dev/null || { rm -f "$patch_tmp" "$turn_tmp"; return 1; }
      [ -s "$turn_tmp" ] || { rm -f "$turn_tmp"; turn_patch=""; }
    fi
    report_tmp="$(mktemp "$dir/.kimi-report.XXXXXX")" || { rm -f "$patch_tmp" "${turn_tmp:-}"; return 1; }
    chmod 0600 "$report_tmp" 2>/dev/null || true
    sid="$(session_id_from "$out")"; [ -n "$sid" ] || sid=unavailable
    summary="$(cd "$wt" && git diff --stat "$prior" 2>/dev/null | head -40 | cut -c1-240)"
    detail="$(safe_report_detail "$state")"
    {
      echo "# INCOMPLETE Kimi implementation - $name"; echo
      echo "This work is INCOMPLETE. It is not proof that the task is correct, tested, or safe."; echo
      echo "- Job: \`$name\`"
      echo "- Repository: \`$repo\`"
      echo "- Base SHA: \`$base\`"
      echo "- Model requested: \`$KIMI_MODEL\` (returned model: unavailable)"
      echo "- Terminal state: \`$state\`"
      echo "- Command exit status: \`$rc\`"
      echo "- Kimi session ID: \`$sid\`"
      echo "- Usage, tokens, cache, cost, and context: \`unavailable\`"
      echo "- Tests: not confirmed complete"
      echo "- Patch: \`$patch\`"
      [ -z "$turn_patch" ] || echo "- This turn only: \`$turn_patch\`"
      echo "- Safe detail: $detail"; echo
      echo "## Changed-file summary"; echo; echo '```text'
      printf '%s\n' "${summary:-Git recorded changes, but no bounded stat text was available.}"
      echo '```'; echo
      echo "## Recovery"; echo
      echo "1. Inspect cumulative work: \`git apply --stat '$patch'\`"
      [ -z "$turn_patch" ] || echo "2. Inspect only this failed turn: \`git apply --stat '$turn_patch'\`"
      echo "3. Verify the cumulative patch against the captured base: \`git apply --check '$patch'\`"
      echo "4. Never apply an incomplete patch without reviewing every change and running the required tests."
    } > "$report_tmp" || { rm -f "$patch_tmp" "${turn_tmp:-}" "$report_tmp"; return 1; }
  fi
  if [ "${AI_KIMI_TEST_FAIL_EXPORT:-}" = move ]; then
    rm -f "$patch_tmp" "${turn_tmp:-}" "${report_tmp:-}"
    return 1
  fi
  mv "$patch_tmp" "$patch" || { rm -f "$patch_tmp" "${turn_tmp:-}" "${report_tmp:-}"; return 1; }
  if [ "$kind" = incomplete ]; then
    [ -z "$turn_patch" ] || mv "$turn_tmp" "$turn_patch" || { rm -f "$turn_tmp" "$patch" "$report_tmp"; return 1; }
    mv "$report_tmp" "$report" || { rm -f "$report_tmp" "$patch"; return 1; }
    note "ai-kimi: $state with partial changes; command remains unsuccessful."
    note "INCOMPLETE patch written: $patch"
    note "INCOMPLETE report written: $report"
    [ -z "$turn_patch" ] || note "THIS-TURN patch written: $turn_patch"
    note "  inspect: git apply --stat '$patch'"
    note "  verify:  git apply --check '$patch'"
  else
    note "patch written: $patch"
    note "  review it, then:  git apply --check '$patch' && git apply '$patch'"
  fi
  return 0
}

lifecycle_finalize() { # lifecycle_finalize ORIGINAL_EXIT_STATUS
  local original="${1:-1}" artifact_rc=0 state_rc=0 final continuity
  final="$original"
  [ "$LIFECYCLE_ACTIVE" = 1 ] || return "$original"
  LIFECYCLE_ACTIVE=0
  if [ "$LIFECYCLE_MODE" = implement ] && [ -n "$LIFECYCLE_WT" ]; then
    if [ "$LIFECYCLE_STATE" = completed ]; then
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" complete completed "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" || artifact_rc=$?
    else
      emit_implementation_artifact "$LIFECYCLE_REPO" "$LIFECYCLE_NAME" "$LIFECYCLE_WT" \
        "$LIFECYCLE_BASE" "$LIFECYCLE_OWNER" incomplete "$LIFECYCLE_STATE" "$LIFECYCLE_COMMAND_RC" "$LIFECYCLE_OUT" \
        "${LIFECYCLE_PRIOR_TREE:-$LIFECYCLE_BASE}" || artifact_rc=$?
    fi
    if [ "$artifact_rc" = 0 ] || [ "$artifact_rc" = 2 ]; then
      continuity=exact
      [ "$LIFECYCLE_STATE" = completed ] || continuity=recovery-required
      [ -n "$LIFECYCLE_SID" ] || LIFECYCLE_SID="$(session_id_from "$LIFECYCLE_OUT")"
      [ -n "$LIFECYCLE_SID" ] || continuity=recovery-required
      write_impl_state "$LIFECYCLE_RID" "$LIFECYCLE_NAME" "$LIFECYCLE_REPO" \
        "$LIFECYCLE_BASE" "${LIFECYCLE_SID:-unavailable}" "$LIFECYCLE_WT" \
        "$LIFECYCLE_STATE" "$continuity" "$LIFECYCLE_META" || state_rc=1
      if [ "$state_rc" = 1 ]; then
        final=1
        if mark_impl_recovery_required "$LIFECYCLE_META" state-save-failed; then
          warn "canonical Kimi state could not be saved. The prior proven code was kept and exact-session resume is blocked."
        else
          LIFECYCLE_PRESERVE=1; mark_preserved "$LIFECYCLE_OWNER" || true
          warn "canonical Kimi state and recovery metadata could not be saved. Recovery worktree: $LIFECYCLE_WT"
        fi
      fi
    fi
    if [ "$artifact_rc" = 1 ]; then
      LIFECYCLE_PRESERVE=1; final=1
      mark_preserved "$LIFECYCLE_OWNER" || true
      warn "could not safely export Kimi's work. The exact recovery worktree remains at: $LIFECYCLE_WT"
      warn "after recovery, remove it with: git -C '$LIFECYCLE_REPO' worktree remove '$LIFECYCLE_WT'"
    elif [ "$artifact_rc" = 0 ] && [ "$state_rc" = 0 ]; then
      LIFECYCLE_ARTIFACT_DURABLE=1
    fi
    [ "$LIFECYCLE_PRESERVE" = 1 ] || cleanup_wt "$LIFECYCLE_REPO" "$LIFECYCLE_WT" "$LIFECYCLE_OWNER"
  fi
  rm -f "$LIFECYCLE_PF" "$LIFECYCLE_OUT" "$LIFECYCLE_OUT.err" 2>/dev/null || true
  [ -z "$LIFECYCLE_LOCK" ] || lock_release "$LIFECYCLE_LOCK"
  [ -z "$LIFECYCLE_SESSION_LOCK" ] || lock_release "$LIFECYCLE_SESSION_LOCK"
  return "$final"
}

lifecycle_exit_trap() {
  local original=$? final
  trap - EXIT INT TERM
  set +e
  lifecycle_finalize "$original"; final=$?
  exit "$final"
}

lifecycle_cancel() {
  LIFECYCLE_STATE=cancelled
  LIFECYCLE_COMMAND_RC=130
  stop_run_turn
  exit 130
}

start_session() { # start_session NAME MODE
  local name="$1" mode="$2" repo rid lockid upstream="" meta pf out rid_lock sid rc before after wt="" base="" owner=""
  valid_name "$name" || die "invalid session name '$name' (letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(meta_path "$rid" "$name")"
  [ "$mode" = implement ] && meta="$(impl_meta_path "$rid" "$name")"
  [ -f "$meta" ] && die "session '$name' already exists here. Continue it with: ai-kimi ask $name"

  lockid="$rid"
  if [ "$mode" = review ]; then
    upstream="$(require_upstream_identity "$repo")"
    lockid="$(review_lock_id "$upstream")"
  fi
  rid_lock="$(repolock_path "$lockid")"
  lock_acquire "$rid_lock" "$mode:$name" || die "another Kimi run is already active in this repository: $(lock_info "$rid_lock").
  Do not start a second one; wait for it, or continue it with 'ask'."
  LIFECYCLE_LOCK="$rid_lock"
  trap lifecycle_exit_trap EXIT
  trap lifecycle_cancel INT TERM
  LIFECYCLE_ACTIVE=1; LIFECYCLE_MODE="$mode"; LIFECYCLE_STATE=failed
  LIFECYCLE_NAME="$name"; LIFECYCLE_REPO="$repo"; LIFECYCLE_WT=""
  LIFECYCLE_OWNER=""; LIFECYCLE_BASE=""; LIFECYCLE_PF=""; LIFECYCLE_OUT=""
  LIFECYCLE_COMMAND_RC=unavailable; LIFECYCLE_ARTIFACT_DURABLE=0; LIFECYCLE_PRESERVE=0
  LIFECYCLE_RID="$rid"; LIFECYCLE_META=""; LIFECYCLE_SID=""
  LIFECYCLE_PRIOR_TREE=""

  local workdir="$repo"
  if [ "$mode" != implement ]; then
    prepare_review "$repo" "kimi-$name"   # sets REVIEW_DIR/BASE/HEAD/PACKET_HASH
    workdir="$REVIEW_DIR"
  fi
  if [ "$mode" = implement ]; then
    base="$(git -C "$repo" rev-parse HEAD)"
    wt="$(workspace_path "$rid" "$name")"
    [ ! -e "${wt%/wt}" ] || die "the stable disposable Kimi workspace path is still occupied: ${wt%/wt}"
    mkdir -p "${wt%/wt}"
    git -c core.longpaths=true -C "$repo" worktree add -q --detach "$wt" >/dev/null 2>&1 \
      || die "could not create an isolated worktree for the implement run."
    git -C "$wt" config core.longpaths true
    owner="${wt%/wt}/owner.json"
    LIFECYCLE_WT="$wt"; LIFECYCLE_OWNER="$owner"; LIFECYCLE_BASE="$base"
    write_meta "$owner" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg repo "$repo" --arg wt "$wt" --arg pid "$$" --arg state active \
      '{version:1,repo:$repo,worktree:$wt,pid:$pid,state:$state}')"
    workdir="$wt"
    note "implement run isolated in a throwaway worktree: $wt"
  fi

  pf="$(mktemp)"; LIFECYCLE_PF="$pf"
  out="$(mktemp)"; LIFECYCLE_OUT="$out"
  build_prompt_file "$pf"
  before="$(tree_state "$repo")"

  note "Kimi $mode '$name' starting (model $KIMI_MODEL)…"
  run_turn "$workdir" "$out" "$pf" "$mode"; rc="$RUN_TURN_RC"
  LIFECYCLE_COMMAND_RC="$rc"
  if ! await_result "$out" "$mode '$name'" "$rc"; then
    LIFECYCLE_STATE="$(classify_incomplete_state "$out" "$out.err" "$AWAIT_RESULT_REASON")"
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    exit 1
  fi

  sid="$(session_id_from "$out")"
  [ -n "$sid" ] || die "Kimi returned no session id."
  LIFECYCLE_STATE=completed
  LIFECYCLE_SID="$sid"

  after="$(tree_state "$repo")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Kimi review changed the working tree. The agent profile's tool
  restriction is not holding — do not trust further reviews until this is understood.
  Inspect: git -C $repo status"
  fi

  if [ "$mode" = review ]; then
    write_meta "$meta" "$(jq -n --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg name "$name" \
    --arg caller "$CALLER" --arg mode "$mode" --arg model "$KIMI_MODEL" --arg upstream "$upstream" \
    --arg created "$(date -u +%FT%TZ)" --argjson turns 1 \
    --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" --arg pkthash "$PACKET_HASH" \
    '{kimi_session_id:$sid, repo:$repo, repo_remote:$remote, name:$name, caller:$caller, mode:$mode,
      model:$model, upstream_identity:$upstream, created:$created, updated:$created, turns:$turns,
      base:$base, head:$head, packet_sha256:$pkthash}')"
  fi

  # #1220: keep the lifecycle bookkeeping, THEN fail. Aborting on the spot would
  # skip lifecycle_finalize and lose the run's own record of what happened.
  finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  lifecycle_finalize 0
  [ "${FINISH_RC:-0}" = 0 ] || exit "$FINISH_RC"
}

cleanup_wt() { # cleanup_wt REPO WORKTREE OWNER
  local repo="${1:-}" wt="${2:-}" owner="${3:-}"
  [ -n "$wt" ] || return 0
  valid_owner_record "$repo" "$wt" "$owner" || {
    warn "ambiguous Kimi worktree owner record left untouched: ${owner:-unavailable}"
    return 1
  }
  [ -f "$owner" ] && [ "$(jq -r '.state // ""' "$owner" 2>/dev/null)" = preserved-recovery ] && return 0
  git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
  git -C "$repo" worktree prune >/dev/null 2>&1 || true
  if git -C "$repo" worktree list 2>/dev/null | grep -qF "$wt"; then
    warn "the throwaway worktree $wt is STILL registered — remove it before continuing."
    return 1
  fi
  # `git worktree remove --force` can leave ignored build/dependency files behind.
  # The owner record and validated wrapper-only path make this narrow cleanup safe.
  rm -rf "$wt" 2>/dev/null || true
  rm -f "$owner" 2>/dev/null || true
  rmdir "${wt%/wt}" 2>/dev/null || true
}

cmd_ask() {
  local name="$1" repo rid lockid meta sid pf out rc before after sess_lock rid_lock mode prev_head stored_upstream current_upstream recorded_workspace
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(find_meta "$rid" "$name")"
  sid="$(jq -r .kimi_session_id "$meta")"; mode="$(jq -r .mode "$meta")"
  if [ "$mode" = implement ]; then rid="$(rid_from_meta "$meta")"; continue_implementation "$name" "$rid" "$meta"; return; fi

  stored_upstream="$(jq -r '.upstream_identity // empty' "$meta")"
  [ -n "$stored_upstream" ] || die "review session '$name' predates durable upstream binding and cannot be resumed safely. Start a new named Kimi review."
  current_upstream="$(require_upstream_identity "$repo")"
  [ "$current_upstream" = "$stored_upstream" ] || die "review session '$name' belongs to a different shared upstream. Restore its original origin or start a new named Kimi review; no provider call was made."
  lockid="$(review_lock_id "$stored_upstream")"
  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$lockid")"
  lock_acquire "$sess_lock" "ask:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "ask:$name"; then
    lock_release "$sess_lock"; die "another Kimi run is active in this repository: $(lock_info "$rid_lock")"
  fi
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT
  trap cancel_plain_turn INT TERM

  pf="$(mktemp)"; out="$(mktemp)"
  recorded_workspace="$(jq -r '.review_workspace // empty' "$meta")"
  [ -n "$recorded_workspace" ] || die "review session '$name' has no recorded stable workspace and cannot be resumed safely. Start a new named Kimi review."
  prepare_review "$repo" "kimi-$CALLER-$name" "$recorded_workspace"
  # A continuation that silently moved to a different commit would let a verdict
  # about one head be recorded against another.
  prev_head="$(jq -r '.head // ""' "$meta")"
  if [ -n "$prev_head" ] && [ "$prev_head" != "$REVIEW_HEAD" ]; then
    warn "the repository moved since session '$name' started.
  reviewed at: $prev_head
  now at     : $REVIEW_HEAD
The earlier evidence is STALE and cannot approve this head. The packet has been
rebuilt for the new head; treat any verdict from this session as applying to
$REVIEW_HEAD only."
  fi
  build_prompt_file "$pf"
  before="$(tree_state "$REVIEW_DIR")"
  note "Kimi '$name' continuing session $sid…"
  run_turn "$REVIEW_DIR" "$out" "$pf" "$mode" "$sid"; rc="$RUN_TURN_RC"
  if ! await_result "$out" "'$name'" "$rc"; then
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi
  after="$(tree_state "$REVIEW_DIR")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Kimi review changed the working tree. Inspect: git -C $repo status"
  fi
  write_meta "$meta" "$(jq --arg u "$(date -u +%FT%TZ)" '.updated=$u | .turns=(.turns+1)' "$meta")"
  FINISH_RC=0
  finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  if [ "$FINISH_RC" = 0 ]; then
    rm -f "$pf" "$out" "$out.err"
  else
    # #1220: report_answer_defect just named "$out" as the place the review body
    # can still be recovered from. Deleting it here would destroy the only copy.
    rm -f "$pf"
    exit "$FINISH_RC"
  fi
}

continue_implementation() { # NAME RID META [RESET]
  local name="$1" rid="$2" meta="$3" reset="${4:-0}" repo sid base patch expected actual sess_lock rid_lock wt owner pf out rc rrc=0
  [ "$(jq -r '.version // 1' "$meta")" = 2 ] || die "session '$name' is a legacy one-shot implementation and cannot be guessed or resumed.
  Archive it with 'ai-kimi transcript $name', delete it with 'ai-kimi delete $name', then start persistent work with 'ai-kimi implement <new-name>'."
  valid_impl_record "$rid" "$name" "$meta" || die "persistent implementation state for '$name' failed ownership, identity, or patch validation. No Kimi turn was started."
  reconcile_impl_patches "$meta" "$reset" || rrc=$?
  [ "$rrc" != 2 ] || die "session '$name' has an uncommitted newer state artifact from an interrupted save. Exact-session resume is blocked. Run: ai-kimi reset-context $name --prompt 'Restate the task and continue from the prior proven code.'"
  [ "$rrc" = 0 ] || die "persistent implementation patch reconciliation failed; no Kimi turn was started."
  if [ "$reset" != 1 ]; then
    [ "$(jq -r .continuity_state "$meta")" = exact ] || die "session '$name' requires recovery because conversation and canonical code may differ. Exact-session resume is blocked. Run: ai-kimi reset-context $name --prompt 'Restate the task and continue from the reconstructed code.'"
  fi
  repo="$(repo_root)"; sid="$(jq -r .kimi_session_id "$meta")"; base="$(jq -r .base_sha "$meta")"; patch="$(jq -r .canonical_patch "$meta")"
  git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || die "recorded immutable base $base is unavailable."
  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$rid")"
  lock_acquire "$sess_lock" "implement-continuation:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "implement-continuation:$name"; then lock_release "$sess_lock"; die "another Kimi run is active: $(lock_info "$rid_lock")"; fi
  LIFECYCLE_SESSION_LOCK="$sess_lock"; LIFECYCLE_LOCK="$rid_lock"
  trap lifecycle_exit_trap EXIT; trap lifecycle_cancel INT TERM
  LIFECYCLE_ACTIVE=1; LIFECYCLE_MODE=implement; LIFECYCLE_STATE=failed; LIFECYCLE_NAME="$name"; LIFECYCLE_REPO="$repo"
  LIFECYCLE_BASE="$base"; LIFECYCLE_RID="$rid"; LIFECYCLE_META="$meta"; LIFECYCLE_SID="$sid"
  LIFECYCLE_COMMAND_RC=unavailable; LIFECYCLE_ARTIFACT_DURABLE=0; LIFECYCLE_PRESERVE=0
  wt="$(workspace_path "$rid" "$name")"
  [ ! -e "${wt%/wt}" ] || die "the stable disposable Kimi workspace path is still occupied: ${wt%/wt}"
  mkdir -p "${wt%/wt}"
  git -c core.longpaths=true -C "$repo" worktree add -q --detach "$wt" "$base" >/dev/null 2>&1 || die "could not reconstruct the disposable implementation workspace."
  git -C "$wt" config core.longpaths true
  owner="${wt%/wt}/owner.json"; LIFECYCLE_WT="$wt"; LIFECYCLE_OWNER="$owner"
  write_meta "$owner" "$(MSYS2_ARG_CONV_EXCL='*' jq -n --arg repo "$repo" --arg wt "$wt" --arg pid "$$" '{version:1,repo:$repo,worktree:$wt,pid:$pid,state:"active"}')"
  git -C "$wt" apply --check "$patch" >/dev/null 2>&1 && git -C "$wt" apply "$patch" >/dev/null 2>&1 || die "canonical patch cannot be applied to immutable base $base."
  git -C "$wt" add -A >/dev/null 2>&1
  expected="$(jq -r .patch_sha256 "$meta")"; actual="$(mktemp)"
  git -C "$wt" diff --binary "$base" > "$actual"; [ "$(sha256_file "$actual")" = "$expected" ] || die "reconstructed source hash does not equal the canonical patch hash."
  rm -f "$actual"
  LIFECYCLE_PRIOR_TREE="$(git -C "$wt" write-tree)" || die "could not capture the proven pre-turn source tree."
  pf="$(mktemp)"; out="$(mktemp)"; LIFECYCLE_PF="$pf"; LIFECYCLE_OUT="$out"; build_prompt_file "$pf"
  { printf '%s\n\n' "NOTICE: This implementation continuation (write run) uses a newly reconstructed workspace. Git-visible source is exact. Ignored dependencies, build output, downloads, caches, and secrets did not persist. Recreate what is needed and rerun tests."; cat "$pf"; } > "$pf.notice"; mv "$pf.notice" "$pf"
  if [ "$reset" = 1 ]; then
    note "Kimi CONTEXT RESET (write run) '$name': preserving canonical code but starting a new conversation generation."
    LIFECYCLE_SID=""; run_turn "$wt" "$out" "$pf" implement
  else
    note "Kimi implementation continuation (write run) '$name' resuming exact session $sid in a disposable workspace."
    run_turn "$wt" "$out" "$pf" implement "$sid"
  fi
  rc="$RUN_TURN_RC"; LIFECYCLE_COMMAND_RC="$rc"
  if ! await_result "$out" "implementation continuation '$name'"; then
    LIFECYCLE_STATE="$(classify_incomplete_state "$out" "$out.err" "$AWAIT_RESULT_REASON")"; exit 1
  fi
  if [ "$reset" = 1 ]; then LIFECYCLE_SID="$(session_id_from "$out")"
  else [ "$(session_id_from "$out")" = "$sid" ] || die "Kimi returned a different session id; refusing to advance canonical state."; fi
  # #1220: on the IMPLEMENT path the deliverable is the patch, so a missing verdict
  # must never abort before lifecycle_finalize exports it. Record, export, then fail.
  LIFECYCLE_STATE=completed
  FINISH_RC=0; finish_turn "$repo" "$name" "$out" || FINISH_RC=$?
  lifecycle_finalize 0
  [ "$FINISH_RC" = 0 ] || exit "$FINISH_RC"
}

finish_turn() {
  local repo="$1" name="$2" out="$3" path
  ANSWER_DEFECT=""
  if [ "${OPT_JSON:-0}" = 1 ]; then cat "$out"; else extract_answer "$out"; fi
  path="$(write_review_file "$repo" "$name" "$out")"
  [ -n "$path" ] && note "saved: $path"
  note "note: Kimi reports no token, cost, or model data — none can be quoted for this run."
  # Issue #1220: a turn with no answer, or no verdict, must NOT read as a clean
  # review. Returns non-zero so the caller can exit non-zero; the raw stream is
  # named so the review body can still be recovered when the provider wrote one.
  report_answer_defect "$name" "$out" || return 4
  return 0
}

cmd_list() {
  local repo rid remote f stored_rid
  repo="$(repo_root)"; rid="$(repo_id "$repo")"; remote="$(repo_remote "$repo")"
  printf '%-24s %-8s %-11s %-46s %6s\n' NAME CALLER MODE SESSION TURNS
  [ -d "$STATE_DIR/sessions" ] || return 0
  while IFS= read -r f; do
    stored_rid="$(basename "$(dirname "$f")")"
    [ "$(basename "$f")" != metadata.json ] || stored_rid="$(basename "$(dirname "$(dirname "$f")")")"
    if [ "$stored_rid" != "$rid" ]; then
      [ -n "$remote" ] && [ "$(jq -r '.repo_remote // ""' "$f" 2>/dev/null)" = "$remote" ] || continue
    fi
    jq -r '[.name,.caller,.mode,.kimi_session_id,(.turns|tostring)]|@tsv' "$f" \
      | awk -F'\t' '{printf "%-24s %-8s %-11s %-46s %6s\n",$1,$2,$3,$4,$5}'
  done < <(find "$STATE_DIR/sessions" -type f \( -name '*.json' ! -name owner.json -o -name metadata.json \) -print 2>/dev/null | sort -u)
}
cmd_show()   { jq . "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; }
cmd_delete() {
  local rid meta dir manifest sess_lock f base recorded_workspace
  rid="$(repo_id "$(repo_root)")"; meta="$(find_meta "$rid" "$1")"
  [ "$(jq -r '.mode // ""' "$meta")" != implement ] || rid="$(rid_from_meta "$meta")"
  sess_lock="$(lock_path "$rid" "$1")"
  [ ! -d "$sess_lock" ] || die "session '$1' has an active turn and cannot be deleted."
  if [ "$(jq -r '.version // 1' "$meta")" = 2 ] && [ "$(jq -r .mode "$meta")" = implement ]; then
    dir="$(impl_dir "$rid" "$1")"; manifest="$dir/owner.json"
    same_path "$meta" "$dir/metadata.json" && [ -f "$manifest" ] || die "refusing to delete untrusted implementation state."
    jq -e --arg dir "$dir" --arg meta "$meta" '.version==1 and .owner_dir==$dir and .metadata==$meta' "$manifest" >/dev/null 2>&1 \
      || die "refusing to delete an implementation directory with an invalid owner manifest."
    for f in "$dir"/* "$dir"/.[!.]*; do
      [ -e "$f" ] || continue; base="$(basename "$f")"
      case "$base" in
        owner.json|metadata.json|cumulative.patch|.tmp.*|.cumulative.*) ;;
        cumulative-*.patch) printf '%s' "$base" | grep -Eq '^cumulative-[0-9]+-[0-9a-f]{64}\.patch$' \
          || die "implementation state directory contains an unowned file and was left in place: $f" ;;
        *) die "implementation state directory contains an unowned file and was left in place: $f" ;;
      esac
    done
    rm -f "$dir"/metadata.json "$dir"/owner.json "$dir"/cumulative.patch "$dir"/cumulative-*.patch "$dir"/.tmp.* "$dir"/.cumulative.*
    rmdir "$dir" || die "implementation state directory contains unowned files and was left in place: $dir"
  else
    recorded_workspace="$(jq -r '.review_workspace // empty' "$meta")"
    if [ -n "$recorded_workspace" ]; then
      release_recorded_boundary "kimi-$CALLER-$1" "$recorded_workspace"
    else
      release_boundary "$(repo_root)" "kimi-$CALLER-$1"
    fi
    rm -f "$meta"
  fi
  note "deleted local session record '$1'. Human-facing review and patch files were kept."
}
cmd_transcript() {
  local sid kimi repo dir out tmp base; repo="$(repo_root)"
  sid="$(jq -r .kimi_session_id "$(find_meta "$(repo_id "$repo")" "$1")")"
  kimi="$(resolve_kimi)"
  base="kimi-$1-$(date -u +%Y%m%dT%H%M%SZ)-$$.zip"; dir="$(reviews_dir "$repo" "$base")"; [ -n "$dir" ] || die "cannot export: exact destination is not safely git-ignored."
  mkdir -p "$dir"; out="$dir/$base"; tmp="$out.partial"
  [ ! -e "$out" ] || die "refusing to replace existing archive: $out"
  "$kimi" export "$sid" -o "$tmp" -y --no-include-global-log >/dev/null \
    || { rm -f "$tmp"; die "'kimi export $sid' failed. Check: kimi export --help"; }
  chmod 0600 "$tmp" 2>/dev/null || true; mv "$tmp" "$out"
  note "Kimi transcript archive written: $out"
}

cmd_implement() {
  local name="$1" rid meta=""
  rid="$(repo_id "$(repo_root)")"
  meta="$(find_meta_optional "$rid" "$name")" || meta=""
  if [ -n "$meta" ]; then
    if [ "$(jq -r '.mode // ""' "$meta")" = implement ]; then
      rid="$(rid_from_meta "$meta")"; continue_implementation "$name" "$rid" "$meta"
    else
      die "session '$name' is a review session. Choose a different name for implementation."
    fi
  elif [ -f "$(meta_path "$rid" "$name")" ]; then
    meta="$(meta_path "$rid" "$name")"
    [ "$(jq -r '.mode // ""' "$meta")" = implement ] && continue_implementation "$name" "$rid" "$meta"
    die "session '$name' is a review session. Choose a different name for implementation."
  else start_session "$name" implement; fi
}

cmd_reset_context() {
  local rid meta
  rid="$(repo_id "$(repo_root)")"; meta="$(find_meta "$rid" "$1")"
  [ "$(jq -r '.mode // ""' "$meta")" = implement ] || die "reset-context applies only to implementation sessions."
  rid="$(rid_from_meta "$meta")"
  continue_implementation "$1" "$rid" "$meta" 1
}

# ---------------------------------------------------------------------------
CMD="${1:-}"; shift || true
# Private worker entrypoint. It is intentionally not documented as public API.
if [ "$CMD" = "__review-worker" ]; then
  need jq
  [ $# -eq 2 ] || exit 2
  review_worker "$1" "$2"
  exit $?
fi
if [ "$CMD" = "__review-worker-env" ]; then
  need jq
  [ -n "${AI_KIMI_WORKER_DIR:-}" ] && [ -n "${AI_KIMI_WORKER_PROMPT:-}" ] || exit 2
  worker_dir="$AI_KIMI_WORKER_DIR"; worker_prompt="$AI_KIMI_WORKER_PROMPT"
  if command -v cygpath >/dev/null 2>&1; then
    worker_dir="$(cygpath -u "$worker_dir")"; worker_prompt="$(cygpath -u "$worker_prompt")"
  fi
  review_worker "$worker_dir" "$worker_prompt"
  exit $?
fi
ARG=""; OPT_PROMPT=""; OPT_PROMPT_FILE=""; OPT_JSON=0; OPT_LIVE=""
OPT_BASE=""; OPT_TESTS=""; OPT_DECISION=""; OPT_ASSERT_HEAD=""
OPT_REVIEW_KIND=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt)      OPT_PROMPT="${2:-}"; shift 2 ;;
    --prompt-file) OPT_PROMPT_FILE="${2:-}"; shift 2 ;;
    --base)        OPT_BASE="${2:-}"; shift 2 ;;
    --tests)       OPT_TESTS="${2:-}"; shift 2 ;;
    --decision)    OPT_DECISION="${2:-}"; shift 2 ;;
    --assert-head) OPT_ASSERT_HEAD="${2:-}"; shift 2 ;;
    --review-kind) OPT_REVIEW_KIND="${2:-}"; shift 2 ;;
    --json)        OPT_JSON=1; shift ;;
    --live)        OPT_LIVE="--live"; shift ;;
    -h|--help)     usage; exit 0 ;;
    --*)           die "unknown option '$1'. This wrapper deliberately does not forward arbitrary kimi flags; if you need a capability it lacks, say so rather than calling kimi directly." ;;
    *)             [ -z "$ARG" ] && ARG="$1" || die "unexpected argument '$1'"; shift ;;
  esac
done
case "$OPT_REVIEW_KIND" in ""|diff|plan|architecture|analysis) ;; *) die "--review-kind must be diff, plan, architecture, or analysis";; esac
case "$CMD" in new|start|ask|implement|reset-context|doctor)
  [ "$CALLER" != unknown ] || die "AI_KIMI_CALLER must be set explicitly to codex or claude; credentialed execution never guesses the caller." ;;
esac
case "$CALLER" in codex|claude|unknown) ;; *) die "AI_KIMI_CALLER must be codex or claude";; esac
need jq

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-kimi new <name> …";       start_review_job "$ARG"; cmd_wait_job "$ARG" ;;
  start)      [ -n "$ARG" ] || die "usage: ai-kimi start <name> …";     if [ -f "$(meta_path "$(repo_id "$(repo_root)")" "$ARG")" ]; then start_review_job "$ARG" 1; else start_review_job "$ARG"; fi ;;
  implement)  [ -n "$ARG" ] || die "usage: ai-kimi implement <name> …"; cmd_implement "$ARG" ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-kimi ask <name> …";       if [ -f "$(meta_path "$(repo_id "$(repo_root)")" "$ARG")" ] && [ "$(jq -r .mode "$(meta_path "$(repo_id "$(repo_root)")" "$ARG")")" = review ]; then start_review_job "$ARG" 1; cmd_wait_job "$ARG"; else cmd_ask "$ARG"; fi ;;
  wait)       [ -n "$ARG" ] || die "usage: ai-kimi wait <name>";         cmd_wait_job "$ARG" ;;
  status)     [ -n "$ARG" ] || die "usage: ai-kimi status <name>";       cmd_status_job "$ARG" ;;
  logs)       [ -n "$ARG" ] || die "usage: ai-kimi logs <name>";         cmd_logs_job "$ARG" ;;
  result)     [ -n "$ARG" ] || die "usage: ai-kimi result <name>";       cmd_result_job "$ARG" ;;
  cancel)     [ -n "$ARG" ] || die "usage: ai-kimi cancel <name>";       cmd_cancel_job "$ARG" ;;
  recover)    [ -n "$ARG" ] || die "usage: ai-kimi recover <name>";      cmd_recover_job "$ARG" ;;
  list)       cmd_list ;;
  show)       [ -n "$ARG" ] || die "usage: ai-kimi show <name>";        cmd_show "$ARG" ;;
  transcript) [ -n "$ARG" ] || die "usage: ai-kimi transcript <name>";  cmd_transcript "$ARG" ;;
  delete)     [ -n "$ARG" ] || die "usage: ai-kimi delete <name>";      cmd_delete "$ARG" ;;
  reset-context) [ -n "$ARG" ] || die "usage: ai-kimi reset-context <name> …"; cmd_reset_context "$ARG" ;;
  doctor)     cmd_doctor "$OPT_LIVE" ;;
  -h|--help|help|"") usage; [ -z "$CMD" ] && exit 2 || exit 0 ;;
  *)          printf 'unknown command: %s\n\n' "$CMD" >&2; usage >&2; exit 2 ;;
esac
