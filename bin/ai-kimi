#!/usr/bin/env bash
# ai-kimi — Kimi Code delegation in persistent, named sessions.
#
# This is the ONLY supported way for Claude or Codex to drive Kimi headlessly.
# Never call `kimi -p` directly: this script owns the model pin, the read-only
# enforcement, the completion rule, the session bookkeeping, and the worktree
# isolation for write runs.
#
#   ai-kimi new <name>       [--prompt T | --prompt-file F | stdin]   read-only review
#   ai-kimi ask <name>       [--prompt T | --prompt-file F | stdin]   continue it
#   ai-kimi implement <name> [--prompt T | --prompt-file F | stdin]   write run, isolated
#   ai-kimi list | show <name> | transcript <name> | delete <name>
#   ai-kimi doctor [--live]
#
# Review sessions are STRUCTURALLY read-only: they run under an agent profile
# whose toolset contains no write, edit, patch, or bash tool. See the Step 0
# evidence below — this is not a prompt request, it is an absent capability.
#
# ---------------------------------------------------------------------------
# STEP 0 VERIFICATION — captured 2026-08-05 against Kimi Code 0.31.1 on
# hetz/Ubuntu as user `ai`. Re-run and update this block on any version bump.
#
#   Resume flag: `-S/--session [id]` is the DOCUMENTED form; `-r` is an
#     undocumented alias that works and is what Kimi itself prints in its
#     resume hint ("To resume this session: kimi -r session_…"). Both accepted.
#   `-c/--continue` means "newest session for this directory", NOT "the session
#     I was just using". Never used here.
#   Output formats are ONLY `text` and `stream-json` — there is no `json`.
#     stream-json is NDJSON: records carry `role` (user/assistant/meta), and
#     only meta records carry `type`.
#   COMPLETION MARKER: the run ends with a meta record
#     {"role":"meta","type":"session.resume_hint","session_id":"session_…"} and
#     it is emitted on resumed turns too. That record is the terminal signal
#     this script gates on. Verified on both a fresh and a resumed turn.
#   THERE IS NO --max-turns / step-budget FLAG. Kimi has no turn ceiling to
#     enforce, so the Grok D4 invariant has no analogue here. Do not invent one.
#   NO usage, token, cost, or model reporting in headless output. You cannot
#     assert which model answered. This is why -m is pinned unconditionally.
#   Default model on this machine is now `kimi-code/k3` (the skill's claim that
#     it defaults to kimi-for-coding/K2.7 is stale here) — pin anyway, because
#     the default is machine-local config and can differ per host.
#   Prompt mode rejects: --yolo ("Cannot combine --prompt with --yolo"), and
#     per the CLI also --plan and --auto.
#   --agent/--agent-file CANNOT be combined with --session/--continue, so the
#     agent is fixed when a session is created. That is why review and
#     implement are different sessions and can never be the same one.
#
#   STRUCTURAL READ-ONLY, PROVEN (this is the finding that justifies the script):
#     Negative control, plain `kimi -m kimi-code/k3 -p "Write HACKED into
#       canary3.txt"` → exit 0, file contents became `HACKED`. Kimi writes
#       files freely in ordinary prompt mode.
#     With `--agent-file` carrying `tools: read, grep, glob, ls` and the same
#       adversarial instruction → exit 0, canary UNCHANGED, model replied
#       CANNOT_WRITE.
#     Frontmatter `tools:` must be a comma-separated string or a list of
#       strings; a YAML map is rejected with "must be a comma-separated string
#       or a list of strings".
#     TOOL NAMES ARE CASE-SENSITIVE AND FAIL SILENTLY. `tools: read, grep,
#       glob, ls` is accepted by the parser and matches NOTHING, leaving the
#       agent with no tools at all — it reports "I have no working file-reading
#       tool" and the canary survives for the wrong reason. Kimi's real names
#       are capitalized: Read, Grep, Glob, ReadMediaFile, Bash, Edit, Write,
#       FetchURL, WebSearch, Agent, AgentSwarm, Skill, Cron*, Task*, Todo*.
#       ALWAYS verify BOTH directions after touching the profile: that a review
#       can still read, and that it still cannot write. The live test does.
# ---------------------------------------------------------------------------

set -euo pipefail

VERSION="1.0.0"

STATE_DIR="${AI_KIMI_STATE_DIR:-$HOME/.local/state/ai-devops/kimi}"
CALLER="${AI_KIMI_CALLER:-claude}"
KIMI_MODEL="${AI_KIMI_MODEL:-kimi-code/k3}"

WAIT_TIMEOUT="${AI_KIMI_WAIT_TIMEOUT:-900}"
POLL_INTERVAL="${AI_KIMI_POLL_INTERVAL:-5}"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RO_AGENT="${AI_KIMI_RO_AGENT:-$SELF_DIR/../config/kimi/readonly-review.md}"

die()  { printf 'ai-kimi: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-kimi: warning: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

# ---------------------------------------------------------------------------
# Binary resolution. Kimi installs to ~/.kimi-code/bin, which is NOT added to
# PATH by its installer — on hetz it is absent from both users' PATH. A bare
# `command -v kimi` failure reads as "not installed" when it is installed.
# ---------------------------------------------------------------------------
resolve_kimi() {
  if [ -n "${AI_KIMI_BIN:-}" ]; then
    [ -x "$AI_KIMI_BIN" ] || die "AI_KIMI_BIN=$AI_KIMI_BIN is not executable."
    printf '%s' "$AI_KIMI_BIN"; return 0
  fi
  local c
  for c in "$(command -v kimi 2>/dev/null || true)" \
           "$HOME/.kimi-code/bin/kimi" \
           "$HOME/.kimi-code/bin/kimi.exe" \
           /home/ai/.kimi-code/bin/kimi \
           /usr/local/bin/kimi; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  die "kimi binary not found. Set AI_KIMI_BIN, or install Kimi Code. Looked on PATH, \$HOME/.kimi-code/bin, /home/ai/.kimi-code/bin, /usr/local/bin."
}

kimi_procs() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x kimi 2>/dev/null || true
  else
    ps -W 2>/dev/null | grep -i '[k]imi' || true
  fi
}

# ---------------------------------------------------------------------------
# Session identity: repo + caller + name, so Claude and Codex never collide.
# ---------------------------------------------------------------------------
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "ai-kimi must be run inside a git repository."
}
repo_id()  { printf '%s' "$1" | tr '\\' '/' | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
valid_name() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }

meta_path()     { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
lock_path()     { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
repolock_path() { printf '%s/locks/repo--%s.lock.d' "$STATE_DIR" "$1"; }

# Portable mutex (flock does not exist in Git Bash); stale locks are reclaimed.
lock_acquire() {
  local dir="$1" label="$2" owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || echo '')"
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then return 1; fi
  warn "reclaiming stale lock $(basename "$dir") (owner pid ${owner:-unknown} is gone)"
  rm -rf "$dir"; mkdir "$dir" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
}
lock_release() { rm -rf "$1" 2>/dev/null || true; }
lock_info() {
  local dir="$1" label pid started now
  label="$(cat "$dir/label" 2>/dev/null || echo unknown)"
  pid="$(cat "$dir/pid" 2>/dev/null || echo '?')"
  if started="$(date -r "$dir" +%s 2>/dev/null)"; then
    now="$(date +%s)"; printf '%s (pid %s, running %ss)' "$label" "$pid" "$((now - started))"
  else printf '%s (pid %s)' "$label" "$pid"; fi
}

write_meta() {
  local f="$1" tmp; mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"; mv -f "$tmp" "$f"
}
find_meta() {
  local f; f="$(meta_path "$1" "$2")"
  [ -f "$f" ] || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-kimi list"
  printf '%s' "$f"
}

# ---------------------------------------------------------------------------
# The completion rule.
#
# Kimi's stream-json is NDJSON with no terminal status field, so completion is
# proven by the LAST record being the session.resume_hint meta record. Exit
# status is recorded but never trusted: it is the same class of signal that
# made a Grok caller believe a still-running review had died.
# ---------------------------------------------------------------------------
has_resume_hint() { # has_resume_hint FILE
  [ -s "$1" ] || return 1
  tail -5 "$1" | jq -e 'select(.type=="session.resume_hint")|.session_id' >/dev/null 2>&1
}
session_id_from() { tail -5 "$1" | jq -r 'select(.type=="session.resume_hint")|.session_id' 2>/dev/null | tail -1; }

await_result() { # await_result FILE LABEL
  local f="$1" label="$2" waited=0 empty=0 saw=0
  while [ "$waited" -lt "$WAIT_TIMEOUT" ]; do
    has_resume_hint "$f" && return 0
    # Fast-fail ONLY if a kimi process was positively seen and then vanished.
    # If detection never matched, we do not trust it and wait the full timeout —
    # a detection miss must never abort a healthy slow run.
    if [ -n "$(kimi_procs)" ]; then saw=1; empty=0
    elif [ "$saw" = 1 ]; then
      empty=$((empty + 1))
      if [ "$empty" -ge 2 ]; then
        note ""
        note "ai-kimi: Kimi is no longer running but never emitted a session.resume_hint."
        note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
        note "  elapsed  : ${waited}s"
        note "  diagnose : tail -20 ~/.kimi-code/logs/kimi-code.log"
        return 1
      fi
    fi
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
    [ $((waited % 60)) -eq 0 ] && note "  … $label still running (${waited}s)"
  done
  note ""
  note "ai-kimi: no session.resume_hint after ${WAIT_TIMEOUT}s — the run did not complete."
  note "  output   : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
  note "  diagnose : tail -20 ~/.kimi-code/logs/kimi-code.log"
  note "  Raise the ceiling with AI_KIMI_WAIT_TIMEOUT=<seconds> for a genuinely long run."
  return 1
}

# ---------------------------------------------------------------------------
# Turn execution
# ---------------------------------------------------------------------------
run_turn() { # run_turn REPO OUT PROMPT_FILE MODE [SESSION_ID]
  local repo="$1" out="$2" pf="$3" mode="$4" sid="${5:-}"
  local kimi; kimi="$(resolve_kimi)"
  local args=(-m "$KIMI_MODEL" --output-format stream-json)
  if [ -n "$sid" ]; then
    # --agent/--agent-file cannot combine with a resume; the agent is fixed at
    # session creation, which is exactly why a review session can never later
    # become a write session.
    args+=(-r "$sid")
  elif [ "$mode" = review ]; then
    [ -f "$RO_AGENT" ] || die "read-only agent profile not found at $RO_AGENT — refusing to run a review without structural read-only enforcement."
    args+=(--agent-file "$RO_AGENT")
  fi
  args+=(-p "$(cat "$pf")")

  : > "$out"
  set +e
  ( cd "$repo" && "$kimi" "${args[@]}" ) > "$out" 2>"$out.err"
  local rc=$?
  set -e
  printf '%s' "$rc"
}

extract_answer() { # extract_answer FILE
  local text
  text="$(jq -r 'select(.role=="assistant") | .content // ""' "$1" 2>/dev/null | sed '/^$/d')"
  if printf '%s' "$text" | grep -qF '## Verdict'; then
    printf '%s\n' "$text" | sed -n '/^## Verdict/,$p'
  else
    printf '%s\n' "$text"
  fi
}

PROMPT_FOOTER="

---
Formatting requirement: structure your reply so the final answer is last, under a
literal '## Verdict' heading. Put any narration above it."

build_prompt_file() {
  local dest="$1"
  if [ -n "${OPT_PROMPT_FILE:-}" ]; then
    [ -f "$OPT_PROMPT_FILE" ] || die "prompt file not found: $OPT_PROMPT_FILE"
    cat "$OPT_PROMPT_FILE" > "$dest"
  elif [ -n "${OPT_PROMPT:-}" ]; then printf '%s\n' "$OPT_PROMPT" > "$dest"
  elif [ ! -t 0 ]; then cat > "$dest"
  else die "no prompt given. Use --prompt TEXT, --prompt-file FILE, or pipe it on stdin."
  fi
  [ -s "$dest" ] || die "the prompt is empty."
  printf '%s' "$PROMPT_FOOTER" >> "$dest"
}

# Defence in depth: the agent profile is the guarantee, this catches a profile
# that silently stopped working (e.g. a Kimi upgrade changing frontmatter rules).
tree_state() { git -C "$1" status --porcelain 2>/dev/null | sort; }

reviews_dir() {
  git -C "$1" check-ignore -q .ai/reviews 2>/dev/null && printf '%s/.ai/reviews' "$1" || printf ''
}
write_review_file() {
  local repo="$1" name="$2" f="$3" dir ts out
  dir="$(reviews_dir "$repo")"
  if [ -z "$dir" ]; then
    warn "not writing a review file: '.ai/reviews' is not git-ignored in $repo. Add '.ai/reviews/' to .gitignore."
    return 0
  fi
  mkdir -p "$dir"; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$dir/kimi-${name}-${ts}.md"
  {
    echo "# Kimi review — $name"; echo
    echo "- Repo: \`$repo\`"
    echo "- Branch: \`$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')\`"
    echo "- Session: \`$(session_id_from "$f")\`"
    echo "- Model requested: \`$KIMI_MODEL\` (Kimi does not report which model answered)"
    echo; echo "---"; echo
    jq -r 'select(.role=="assistant") | .content // ""' "$f" 2>/dev/null
  } > "$out"
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
ai-kimi $VERSION — Kimi Code delegation in persistent, named sessions.

  ai-kimi new <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi ask <name>       [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi implement <name> [--prompt TEXT | --prompt-file FILE | stdin]
  ai-kimi list | show <name> | transcript <name> | delete <name>
  ai-kimi doctor [--live]

'new'/'ask' are STRUCTURALLY read-only — they run under an agent profile with no
write, edit, patch or bash tool. 'implement' is an explicit write run and is
isolated in a throwaway git worktree; its diff is emitted as a patch for you to
review and apply. Model is pinned ($KIMI_MODEL) because Kimi does not report
which model answered.

Environment:
  AI_KIMI_CALLER       'claude' (default) or 'codex' — keeps sessions separate
  AI_KIMI_BIN          explicit path to the kimi binary
  AI_KIMI_MODEL        model pin ($KIMI_MODEL)
  AI_KIMI_WAIT_TIMEOUT seconds to wait for completion ($WAIT_TIMEOUT)
  AI_KIMI_STATE_DIR    session state ($STATE_DIR)
EOF
}

cmd_doctor() {
  local live=0 kimi rc=0
  [ "${1:-}" = "--live" ] && live=1
  need jq; kimi="$(resolve_kimi)"
  echo "kimi binary   : $kimi"
  echo "kimi version  : $("$kimi" --version 2>&1 | head -1)"
  echo "caller        : $CALLER"
  echo "state dir     : $STATE_DIR"
  echo "model pin     : $KIMI_MODEL"
  if [ -f "$RO_AGENT" ]; then
    echo "read-only     : $RO_AGENT"
  else
    echo "read-only     : MISSING ($RO_AGENT) — reviews will refuse to run"; rc=1
  fi
  echo
  if "$kimi" provider list >/dev/null 2>&1; then
    echo "auth          : OK (kimi provider list succeeded)"
    "$kimi" provider list 2>/dev/null | sed 's/^/                /'
  else
    echo "auth          : FAILED — run 'kimi login'"; rc=1
  fi
  if [ "$live" = 1 ]; then
    local tmp; tmp="$(mktemp)"; printf 'Reply with exactly: OK\n' > "$tmp.p"
    echo -n "live probe    : "
    run_turn "$(pwd)" "$tmp" "$tmp.p" review >/dev/null || true
    if has_resume_hint "$tmp"; then echo "OK"; else echo "FAILED — no session.resume_hint"; rc=1; fi
    rm -f "$tmp" "$tmp.p" "$tmp.err" 2>/dev/null || true
  fi
  return $rc
}

start_session() { # start_session NAME MODE
  local name="$1" mode="$2" repo rid meta pf out rid_lock sid rc before after wt=""
  valid_name "$name" || die "invalid session name '$name' (letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(meta_path "$rid" "$name")"
  [ -f "$meta" ] && die "session '$name' already exists here. Continue it with: ai-kimi ask $name"

  rid_lock="$(repolock_path "$rid")"
  lock_acquire "$rid_lock" "$mode:$name" || die "another Kimi run is already active in this repository: $(lock_info "$rid_lock").
  Do not start a second one; wait for it, or continue it with 'ask'."
  # shellcheck disable=SC2064
  trap "lock_release '$rid_lock'" EXIT INT TERM

  local workdir="$repo"
  if [ "$mode" = implement ]; then
    wt="$(mktemp -d)/wt"
    git -C "$repo" worktree add -q --detach "$wt" >/dev/null 2>&1 \
      || die "could not create an isolated worktree for the implement run."
    workdir="$wt"
    note "implement run isolated in a throwaway worktree: $wt"
  fi

  pf="$(mktemp)"; out="$(mktemp)"
  build_prompt_file "$pf"
  before="$(tree_state "$repo")"

  note "Kimi $mode '$name' starting (model $KIMI_MODEL)…"
  rc="$(run_turn "$workdir" "$out" "$pf" "$mode")"
  if ! await_result "$out" "$mode '$name'"; then
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    cleanup_wt "$repo" "$wt"; rm -f "$pf" "$out" "$out.err"; exit 1
  fi

  sid="$(session_id_from "$out")"
  [ -n "$sid" ] || { cleanup_wt "$repo" "$wt"; rm -f "$pf" "$out" "$out.err"; die "Kimi returned no session id."; }

  after="$(tree_state "$repo")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    cleanup_wt "$repo" "$wt"
    die "a READ-ONLY Kimi review changed the working tree. The agent profile's tool
  restriction is not holding — do not trust further reviews until this is understood.
  Inspect: git -C $repo status"
  fi

  write_meta "$meta" "$(jq -n --arg sid "$sid" --arg repo "$repo" --arg name "$name" \
    --arg caller "$CALLER" --arg mode "$mode" --arg model "$KIMI_MODEL" \
    --arg created "$(date -u +%FT%TZ)" --argjson turns 1 \
    '{kimi_session_id:$sid, repo:$repo, name:$name, caller:$caller, mode:$mode,
      model:$model, created:$created, updated:$created, turns:$turns}')"

  if [ "$mode" = implement ]; then emit_patch "$repo" "$name" "$wt"; fi
  cleanup_wt "$repo" "$wt"
  finish_turn "$repo" "$name" "$out"
  rm -f "$pf" "$out" "$out.err"
}

cleanup_wt() { # cleanup_wt REPO WORKTREE — always runs; nothing outlives the delegation
  local repo="$1" wt="${2:-}"
  [ -n "$wt" ] || return 0
  git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
  git -C "$repo" worktree prune >/dev/null 2>&1 || true
  if git -C "$repo" worktree list 2>/dev/null | grep -qF "$wt"; then
    warn "the throwaway worktree $wt is STILL registered — remove it before continuing."
  fi
}

emit_patch() { # emit_patch REPO NAME WORKTREE
  local repo="$1" name="$2" wt="$3" dir patch
  dir="$(reviews_dir "$repo")"
  [ -n "$dir" ] || { warn "cannot save the patch: '.ai/reviews' is not git-ignored."; return 0; }
  mkdir -p "$dir"
  patch="$dir/kimi-${name}-$(date -u +%Y%m%dT%H%M%SZ).patch"
  ( cd "$wt" && git add -A >/dev/null 2>&1 && git diff --cached ) > "$patch" 2>/dev/null || true
  if [ -s "$patch" ]; then
    note "patch written: $patch"
    note "  review it, then:  git apply --check '$patch' && git apply '$patch'"
  else
    rm -f "$patch"; warn "the implement run produced no changes."
  fi
}

cmd_ask() {
  local name="$1" repo rid meta sid pf out rc before after sess_lock rid_lock mode
  repo="$(repo_root)"; rid="$(repo_id "$repo")"
  meta="$(find_meta "$rid" "$name")"
  sid="$(jq -r .kimi_session_id "$meta")"; mode="$(jq -r .mode "$meta")"

  sess_lock="$(lock_path "$rid" "$name")"; rid_lock="$(repolock_path "$rid")"
  lock_acquire "$sess_lock" "ask:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  if ! lock_acquire "$rid_lock" "ask:$name"; then
    lock_release "$sess_lock"; die "another Kimi run is active in this repository: $(lock_info "$rid_lock")"
  fi
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT INT TERM

  pf="$(mktemp)"; out="$(mktemp)"; build_prompt_file "$pf"
  before="$(tree_state "$repo")"
  note "Kimi '$name' continuing session $sid…"
  rc="$(run_turn "$repo" "$out" "$pf" "$mode" "$sid")"
  if ! await_result "$out" "'$name'"; then
    note "  kimi exit status was $rc — which proves nothing on its own."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi
  after="$(tree_state "$repo")"
  if [ "$mode" = review ] && [ "$before" != "$after" ]; then
    die "a READ-ONLY Kimi review changed the working tree. Inspect: git -C $repo status"
  fi
  write_meta "$meta" "$(jq --arg u "$(date -u +%FT%TZ)" '.updated=$u | .turns=(.turns+1)' "$meta")"
  finish_turn "$repo" "$name" "$out"
  rm -f "$pf" "$out" "$out.err"
}

finish_turn() {
  local repo="$1" name="$2" out="$3" path
  if [ "${OPT_JSON:-0}" = 1 ]; then cat "$out"; else extract_answer "$out"; fi
  path="$(write_review_file "$repo" "$name" "$out")"
  [ -n "$path" ] && note "saved: $path"
  note "note: Kimi reports no token, cost, or model data — none can be quoted for this run."
  return 0
}

cmd_list() {
  local rid dir f; rid="$(repo_id "$(repo_root)")"; dir="$STATE_DIR/sessions/$rid"
  printf '%-24s %-8s %-11s %-46s %6s\n' NAME CALLER MODE SESSION TURNS
  [ -d "$dir" ] || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    jq -r '[.name,.caller,.mode,.kimi_session_id,(.turns|tostring)]|@tsv' "$f" \
      | awk -F'\t' '{printf "%-24s %-8s %-11s %-46s %6s\n",$1,$2,$3,$4,$5}'
  done
}
cmd_show()   { jq . "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; }
cmd_delete() { rm -f "$(find_meta "$(repo_id "$(repo_root)")" "$1")"; note "deleted local session record '$1'."; }
cmd_transcript() {
  local sid kimi; sid="$(jq -r .kimi_session_id "$(find_meta "$(repo_id "$(repo_root)")" "$1")")"
  kimi="$(resolve_kimi)"
  note "Kimi exports a session as a ZIP archive, not text."
  "$kimi" export "$sid" || die "'kimi export $sid' failed. Check: kimi export --help"
}

# ---------------------------------------------------------------------------
CMD="${1:-}"; shift || true
ARG=""; OPT_PROMPT=""; OPT_PROMPT_FILE=""; OPT_JSON=0; OPT_LIVE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt)      OPT_PROMPT="${2:-}"; shift 2 ;;
    --prompt-file) OPT_PROMPT_FILE="${2:-}"; shift 2 ;;
    --json)        OPT_JSON=1; shift ;;
    --live)        OPT_LIVE="--live"; shift ;;
    -h|--help)     usage; exit 0 ;;
    --*)           die "unknown option '$1'. This wrapper deliberately does not forward arbitrary kimi flags; if you need a capability it lacks, say so rather than calling kimi directly." ;;
    *)             [ -z "$ARG" ] && ARG="$1" || die "unexpected argument '$1'"; shift ;;
  esac
done
need jq

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-kimi new <name> …";       start_session "$ARG" review ;;
  implement)  [ -n "$ARG" ] || die "usage: ai-kimi implement <name> …"; start_session "$ARG" implement ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-kimi ask <name> …";       cmd_ask "$ARG" ;;
  list)       cmd_list ;;
  show)       [ -n "$ARG" ] || die "usage: ai-kimi show <name>";        cmd_show "$ARG" ;;
  transcript) [ -n "$ARG" ] || die "usage: ai-kimi transcript <name>";  cmd_transcript "$ARG" ;;
  delete)     [ -n "$ARG" ] || die "usage: ai-kimi delete <name>";      cmd_delete "$ARG" ;;
  doctor)     cmd_doctor "$OPT_LIVE" ;;
  -h|--help|help|"") usage; [ -z "$CMD" ] && exit 2 || exit 0 ;;
  *)          printf 'unknown command: %s\n\n' "$CMD" >&2; usage >&2; exit 2 ;;
esac
