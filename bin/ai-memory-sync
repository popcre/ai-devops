#!/usr/bin/env bash
# ai-memory-sync — transactional two-way sync with the governed private hub.
set -uo pipefail

MODE="${1:-sync}"
shift || true
[[ "$MODE" == "sync" || "$MODE" == "pull" || "$MODE" == "forget" || "$MODE" == "--dry-run" ]] || {
  echo "usage: ai-memory-sync [sync|pull|--dry-run]" >&2
  echo "       ai-memory-sync forget <project> <file.md> \"<reason>\"" >&2
  exit 2
}
if [[ "$MODE" == "forget" && "$#" -lt 3 ]]; then
  echo "usage: ai-memory-sync forget <project> <file.md> \"<reason>\"" >&2
  exit 2
fi

if [[ -n "${USERPROFILE:-}" ]] && command -v cygpath >/dev/null 2>&1; then
  BASE_HOME="$(cygpath -u "$USERPROFILE")"
else
  BASE_HOME="$HOME"
fi

TOOL_ROOT="${AI_MEMORY_TOOL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
REMOTE="${AI_MEMORY_REMOTE:-https://github.com/u2giants/ai-devops-memory.git}"
HUB="${AI_MEMORY_HUB:-$BASE_HOME/.cache/ai-devops-memory-private}"
LOG="${AI_MEMORY_LOG:-$BASE_HOME/.cache/ai-memory-sync.log}"
SYNC="$TOOL_ROOT/bin/ai-sync-memory"
HEALTH="$TOOL_ROOT/bin/ai-memory-health"
HOST="$(hostname)"
DRY=""
[[ "$MODE" == "--dry-run" ]] && DRY="--dry-run"

mkdir -p "$(dirname "$LOG")"
log() { printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$HOST" "$*" | tee -a "$LOG"; }
fail() { log "FAILED: $*" >&2; exit 1; }

canonical_remote() {
  printf '%s' "$1" | sed -E \
    -e 's#^git@github\.com:#github.com/#' \
    -e 's#^https?://github\.com/#github.com/#' \
    -e 's#\.git$##' \
    -e 's#/$##'
}

if [[ "${AI_MEMORY_TEST_MODE:-}" != "1" ]]; then
  [[ "$(canonical_remote "$REMOTE")" == "github.com/u2giants/ai-devops-memory" ]] ||
    fail "remote is not the canonical private memory repository"
fi
[[ -x "$SYNC" || -f "$SYNC" ]] || fail "memory copy tool is missing: $SYNC"
[[ -x "$HEALTH" || -f "$HEALTH" ]] || fail "memory health tool is missing: $HEALTH"
command -v git >/dev/null 2>&1 || fail "git is unavailable"

# Privacy must be proven, not inferred from a repository name. Tests may replace
# GitHub with a local bare remote only when both explicit test flags are set.
if [[ "${AI_MEMORY_TEST_MODE:-}" == "1" && "${AI_MEMORY_TEST_PRIVATE:-}" == "1" ]]; then
  :
else
  command -v gh >/dev/null 2>&1 || fail "GitHub CLI is required to verify private visibility"
  private="$(gh api repos/u2giants/ai-devops-memory --jq '.private' 2>/dev/null)" ||
    fail "could not verify private hub visibility"
  [[ "$private" == "true" ]] || fail "memory hub is not private"
fi

lock="$HUB.lock"
if ! mkdir "$lock" 2>/dev/null; then fail "another memory sync holds $lock"; fi
trap 'rmdir "$lock" 2>/dev/null || true' EXIT

if [[ ! -d "$HUB/.git" ]]; then
  [[ -e "$HUB" ]] && fail "hub path exists but is not a Git repository: $HUB"
  log "clone private hub"
  git clone -q -c core.longpaths=true "$REMOTE" "$HUB" || fail "private hub clone failed"
fi

origin="$(git -C "$HUB" config --get remote.origin.url 2>/dev/null || true)"
if [[ "${AI_MEMORY_TEST_MODE:-}" != "1" ]]; then
  [[ "$(canonical_remote "$origin")" == "$(canonical_remote "$REMOTE")" ]] ||
    fail "existing hub clone points at the wrong remote"
fi
git -C "$HUB" config core.longpaths true || fail "could not enable long paths"

log "fetch private hub"
git -C "$HUB" fetch -q origin main || fail "fetch failed; no local or hub memory was changed"

if [[ -n "$(git -C "$HUB" status --porcelain)" ]]; then
  git -C "$HUB" add -A -- memory || fail "could not stage interrupted recovery state"
  git -C "$HUB" -c user.name="ai-memory-sync" \
    -c user.email="ai-memory-sync@users.noreply.github.com" \
    commit -q -m "preserve interrupted memory sync from $HOST" ||
    fail "could not commit interrupted recovery state"
  interrupted_sha="$(git -C "$HUB" rev-parse HEAD)"
  git -C "$HUB" update-ref "refs/ai-memory/rejected/$interrupted_sha" "$interrupted_sha" ||
    fail "could not preserve interrupted recovery commit"
  log "preserved interrupted state at refs/ai-memory/rejected/$interrupted_sha"
  git -C "$HUB" reset -q --hard origin/main || fail "could not restore clean remote base after preserving state"
fi

if git -C "$HUB" rev-parse --verify HEAD >/dev/null 2>&1; then
  local_sha="$(git -C "$HUB" rev-parse HEAD)"
  remote_sha="$(git -C "$HUB" rev-parse origin/main)"
  if [[ "$local_sha" != "$remote_sha" ]]; then
    if git -C "$HUB" merge-base --is-ancestor origin/main HEAD; then
      log "retry preserved commit $local_sha"
      git -C "$HUB" push origin HEAD:main ||
        fail "preserved commit still cannot be pushed; it remains at $local_sha"
    else
      # A previous rejected writer is never discarded. Give its exact tree a
      # durable recovery ref, then rebuild a fresh union from remote + machine.
      git -C "$HUB" update-ref "refs/ai-memory/rejected/$local_sha" "$local_sha" ||
        fail "could not preserve divergent commit $local_sha"
      log "preserved divergent commit at refs/ai-memory/rejected/$local_sha"
    fi
  fi
fi

git -C "$HUB" checkout -q -B main origin/main || fail "could not establish clean remote base"

if [[ "$MODE" == "forget" ]]; then
  AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" forget "$@" || fail "tombstone creation failed"
fi

log "union private hub into machine"
AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" pull $DRY || fail "incoming union failed"
[[ "$MODE" == "pull" ]] && { log "pull complete"; exit 0; }

if [[ "$MODE" != "forget" ]]; then
  log "union machine into private hub"
  AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" push $DRY || fail "outgoing union failed"
fi
[[ -n "$DRY" ]] && { log "dry run complete"; exit 0; }

mapfile -d '' changed < <(git -C "$HUB" diff --name-only -z -- memory)
mapfile -d '' untracked < <(git -C "$HUB" ls-files --others --exclude-standard -z -- memory)
changed+=("${untracked[@]}")

SECRET_RE='ops_[A-Za-z0-9]{20}|gh[pousr]_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|xox[baprs]-[A-Za-z0-9-]{10}|sk-[A-Za-z0-9]{20}|eyJ[A-Za-z0-9_-]{18,}\.[A-Za-z0-9_-]{18,}\.'
hits=()
for relative in "${changed[@]}"; do
  [[ -n "$relative" && -f "$HUB/$relative" ]] || continue
  grep -Eq "$SECRET_RE" "$HUB/$relative" && hits+=("$relative")
done
if ((${#hits[@]})); then
  log "BLOCKED: secret-pattern detector rejected ${#hits[@]} outgoing file(s):"
  printf '  %s\n' "${hits[@]}" | tee -a "$LOG" >&2
  exit 1
fi

bash "$HEALTH" --repo-root "$HUB" --hub-only --coverage-only --ignore-sync-state >/dev/null ||
  fail "private hub health rejected the outgoing union"

if git -C "$HUB" diff --quiet -- memory && ((${#untracked[@]} == 0)); then
  log "sync complete; union already converged"
  exit 0
fi

git -C "$HUB" add -A -- memory || fail "could not stage private memory union"
git -C "$HUB" -c user.name="ai-memory-sync" \
  -c user.email="ai-memory-sync@users.noreply.github.com" \
  commit -q -m "memory sync from $HOST" || fail "could not commit private memory union"
commit_sha="$(git -C "$HUB" rev-parse HEAD)"
if ! git -C "$HUB" push origin HEAD:main; then
  fail "push rejected; commit $commit_sha is preserved and no older state was copied"
fi

bash "$HEALTH" --repo-root "$HUB" --hub-only --coverage-only >/dev/null ||
  fail "post-push private hub health failed"
log "sync complete at $commit_sha"
