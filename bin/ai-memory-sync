#!/usr/bin/env bash
# ai-memory-sync — transactional two-way sync with the governed private hub.
set -uo pipefail

MODE="${1:-sync}"
shift || true
[[ "$MODE" == "sync" || "$MODE" == "pull" || "$MODE" == "forget" ||
   "$MODE" == "sync-if-stale" || "$MODE" == "--dry-run" ]] || {
  echo "usage: ai-memory-sync [sync|sync-if-stale|pull|--dry-run]" >&2
  echo "       ai-memory-sync forget <project> <file.md> \"<reason>\"" >&2
  exit 2
}
if [[ "$MODE" == "forget" && "${1:-}" == "--batch" && "$#" -ne 2 ]]; then
  echo "usage: ai-memory-sync forget --batch <list-file>" >&2
  exit 2
fi
if [[ "$MODE" == "forget" && "${1:-}" != "--batch" && "$#" -lt 3 ]]; then
  echo "usage: ai-memory-sync forget <project> <file.md> \"<reason>\"" >&2
  echo "       ai-memory-sync forget --batch <list-file>" >&2
  exit 2
fi

if [[ -n "${USERPROFILE:-}" ]]; then
  if command -v cygpath >/dev/null 2>&1; then
    BASE_HOME="$(cygpath -u "$USERPROFILE")"
  else
    BASE_HOME="/$(printf '%s' "$USERPROFILE" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#\L\1#')"
  fi
else
  BASE_HOME="$HOME"
fi
MACHINE_CLAUDE_HOME="${CLAUDE_HOME:-$BASE_HOME/.claude}"

TOOL_ROOT="${AI_MEMORY_TOOL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# Prefer SSH for the private hub when a key exists. Windows Credential Manager
# is not available in SSH logons, so HTTPS + Git Credential Manager hangs on a
# credential prompt (wincredman cannot persist). The same key works in both
# interactive and SSH sessions. Explicit AI_MEMORY_REMOTE always wins.
if [[ -n "${AI_MEMORY_REMOTE:-}" ]]; then
  REMOTE="$AI_MEMORY_REMOTE"
elif [[ -f "$BASE_HOME/.ssh/id_ed25519" || -f "$BASE_HOME/.ssh/id_rsa" ]]; then
  REMOTE="git@github.com:u2giants/ai-devops-memory.git"
else
  REMOTE="https://github.com/u2giants/ai-devops-memory.git"
fi
HUB="${AI_MEMORY_HUB:-$BASE_HOME/.cache/ai-devops-memory-private}"
LOG="${AI_MEMORY_LOG:-$BASE_HOME/.cache/ai-memory-sync.log}"
SYNC="$TOOL_ROOT/bin/ai-sync-memory"
HEALTH="$TOOL_ROOT/bin/ai-memory-health"
WINPATH="${AI_MEMORY_WINPATH:-$TOOL_ROOT/bin/ai-winpath}"
HOST="$(hostname)"
DRY=""
[[ "$MODE" == "--dry-run" ]] && DRY="--dry-run"

# This tool is automated. Never hang on a credential or askpass prompt.
export GIT_TERMINAL_PROMPT=0
export GCM_INTERACTIVE=never

# Interactive Claude uses ~/.claude/projects (a junction is fine there). Over
# SSH, Windows path APIs refuse the untrusted mount point. Use the physical
# target so every consumer sees the same memory without a per-run override.
MACHINE_PROJECTS="$("$WINPATH" "$MACHINE_CLAUDE_HOME/projects" 2>/dev/null || printf '%s\n' "$MACHINE_CLAUDE_HOME/projects")"
[[ -n "$MACHINE_PROJECTS" ]] || MACHINE_PROJECTS="$MACHINE_CLAUDE_HOME/projects"
export AI_MEMORY_CLAUDE_PROJECTS="$MACHINE_PROJECTS"

mkdir -p "$(dirname "$LOG")"
log() { printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$HOST" "$*" | tee -a "$LOG"; }
fail() { log "FAILED: $*" >&2; exit 1; }

# Memory is the slow half of a dotfiles sync: it fetches the private hub, unions
# every project both ways, audits health, then commits and pushes. Nothing about
# it needs to run several times an hour. `sync-if-stale` runs a real sync only
# when the last successful one is older than AI_MEMORY_MAX_AGE_HOURS (default
# 24), so an ordinary sync stays fast and memory still converges daily.
STAMP="${AI_MEMORY_STAMP:-$BASE_HOME/.cache/ai-memory-sync.last-success}"
MAX_AGE_HOURS="${AI_MEMORY_MAX_AGE_HOURS:-24}"
if [[ "$MODE" == "sync-if-stale" ]]; then
  MODE="sync"
  if [[ -f "$STAMP" ]]; then
    last="$(cat "$STAMP" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    if [[ "$last" =~ ^[0-9]+$ ]] && (( now - last < MAX_AGE_HOURS * 3600 )); then
      log "memory sync skipped; last success was $(( (now - last) / 60 )) minute(s) ago (threshold ${MAX_AGE_HOURS}h). Run 'ai-memory-sync sync' to force one."
      exit 0
    fi
  fi
fi
stamp_success() { date +%s > "$STAMP" 2>/dev/null || true; }

canonical_remote() {
  printf '%s' "$1" | sed -E \
    -e 's#^git@github\.com:#github.com/#' \
    -e 's#^https?://github\.com/#github.com/#' \
    -e 's#\.git$##' \
    -e 's#/$##'
}

if [[ "${AI_MEMORY_TEST_MODE:-}" != "1" ]]; then
  [[ "$(canonical_remote "$REMOTE")" == "github.com/u2giants/ai-devops-memory" ]] ||
    fail "remote is not the canonical private memory repository"
fi
[[ -x "$SYNC" || -f "$SYNC" ]] || fail "memory copy tool is missing: $SYNC"
[[ -x "$HEALTH" || -f "$HEALTH" ]] || fail "memory health tool is missing: $HEALTH"
command -v git >/dev/null 2>&1 || fail "git is unavailable"

# Privacy must be proven, not inferred from a repository name. Tests may replace
# GitHub with a local bare remote only when both explicit test flags are set.
# Live runs prove it without the GitHub API: unauthenticated HTTPS must not
# reach the hub, and the configured remote must. That works over SSH, where gh
# OAuth is session-isolated or stale and GCM/wincredman cannot persist.
# Tests keep the shared ai-gh transport path (with a fake visibility read).
if [[ "${AI_MEMORY_TEST_MODE:-}" == "1" && "${AI_MEMORY_TEST_PRIVATE:-}" == "1" ]]; then
  :
elif [[ "${AI_MEMORY_TEST_MODE:-}" == "1" ]]; then
  [[ -x "$TOOL_ROOT/bin/ai-gh" ]] || fail "shared GitHub transport is required to verify private visibility"
  private="$(AI_GH_CALLER=ai-memory-sync "$TOOL_ROOT/bin/ai-gh" api repos/u2giants/ai-devops-memory --jq '.private' 2>/dev/null)" ||
    fail "could not verify private hub visibility"
  [[ "$private" == "true" ]] || fail "memory hub is not private"
else
  # The probe must see the repository exactly as an anonymous outsider would.
  # A url.<base>.insteadOf rewrite (e.g. https://github.com/ -> git@github.com:)
  # would route this "is it public?" check through an authenticated transport
  # and false-positive "publicly readable" on every run (#1646). An empty
  # `-c url...insteadOf=` does NOT override a multivar rewrite; dropping the
  # global/system config for this one call does.
  if GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_NOSYSTEM=1 \
      GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
      git -c credential.helper= -c core.askPass= \
      ls-remote https://github.com/u2giants/ai-devops-memory.git HEAD >/dev/null 2>&1; then
    fail "memory hub is publicly readable; refusing to sync"
  fi
  GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
    git ls-remote "$REMOTE" HEAD >/dev/null 2>&1 ||
    fail "could not verify private hub visibility"
fi

lock="$HUB.lock"
if ! mkdir "$lock" 2>/dev/null; then fail "another memory sync holds $lock"; fi
trap 'rmdir "$lock" 2>/dev/null || true' EXIT

if [[ ! -d "$HUB/.git" ]]; then
  [[ -e "$HUB" ]] && fail "hub path exists but is not a Git repository: $HUB"
  log "clone private hub"
  git clone -q -c core.longpaths=true "$REMOTE" "$HUB" || fail "private hub clone failed"
fi

origin="$(git -C "$HUB" config --get remote.origin.url 2>/dev/null || true)"
if [[ "${AI_MEMORY_TEST_MODE:-}" != "1" ]]; then
  [[ "$(canonical_remote "$origin")" == "$(canonical_remote "$REMOTE")" ]] ||
    fail "existing hub clone points at the wrong remote"
  # Same repo, different transport: prefer the configured REMOTE. HTTPS + GCM
  # cannot persist credentials in SSH logons (wincredman) and hangs; SSH works
  # in both interactive and SSH sessions when a key exists.
  if [[ -n "$origin" && "$origin" != "$REMOTE" ]]; then
    git -C "$HUB" remote set-url origin "$REMOTE" || fail "could not update hub remote"
    log "hub remote re-pointed at $REMOTE"
  fi
fi
git -C "$HUB" config core.longpaths true || fail "could not enable long paths"

log "fetch private hub"
GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
  git -C "$HUB" fetch -q origin main || fail "fetch failed; no local or hub memory was changed"

if [[ -n "$(git -C "$HUB" status --porcelain)" ]]; then
  git -C "$HUB" add -A -- memory || fail "could not stage interrupted recovery state"
  git -C "$HUB" -c user.name="ai-memory-sync" \
    -c user.email="ai-memory-sync@users.noreply.github.com" \
    commit -q -m "preserve interrupted memory sync from $HOST" ||
    fail "could not commit interrupted recovery state"
  interrupted_sha="$(git -C "$HUB" rev-parse HEAD)"
  git -C "$HUB" update-ref "refs/ai-memory/rejected/$interrupted_sha" "$interrupted_sha" ||
    fail "could not preserve interrupted recovery commit"
  log "preserved interrupted state at refs/ai-memory/rejected/$interrupted_sha"
  git -C "$HUB" reset -q --hard origin/main || fail "could not restore clean remote base after preserving state"
fi

if git -C "$HUB" rev-parse --verify HEAD >/dev/null 2>&1; then
  local_sha="$(git -C "$HUB" rev-parse HEAD)"
  remote_sha="$(git -C "$HUB" rev-parse origin/main)"
  if [[ "$local_sha" != "$remote_sha" ]]; then
    if git -C "$HUB" merge-base --is-ancestor origin/main HEAD; then
      log "retry preserved commit $local_sha"
      git -C "$HUB" push origin HEAD:main ||
        fail "preserved commit still cannot be pushed; it remains at $local_sha"
    else
      # A previous rejected writer is never discarded. Give its exact tree a
      # durable recovery ref, then rebuild a fresh union from remote + machine.
      git -C "$HUB" update-ref "refs/ai-memory/rejected/$local_sha" "$local_sha" ||
        fail "could not preserve divergent commit $local_sha"
      log "preserved divergent commit at refs/ai-memory/rejected/$local_sha"
    fi
  fi
fi

git -C "$HUB" checkout -q -B main origin/main || fail "could not establish clean remote base"

if [[ "$MODE" == "forget" ]]; then
  AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" forget "$@" || fail "tombstone creation failed"
fi

log "union private hub into machine"
AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" pull $DRY || fail "incoming union failed"
[[ "$MODE" == "pull" ]] && { log "pull complete"; exit 0; }

# A clean restore has installed the managed Claude skills but Claude has not
# created any per-project memory directories yet. The private hub clone and its
# health check are the complete safe seed in that state. Do not turn a missing
# project into an outgoing empty sync, and do not relax the wrong-home guard for
# an unrecognized Claude home.
machine_memory_found=0
for machine_memory in "$MACHINE_PROJECTS"/*/memory; do
  [[ -d "$machine_memory" ]] || continue
  machine_memory_found=1
  break
done
if [[ "$machine_memory_found" -eq 0 && "$MODE" != "forget" ]]; then
  [[ -d "$MACHINE_CLAUDE_HOME/skills" ]] ||
    fail "no local project memory exists and $MACHINE_CLAUDE_HOME is not a toolkit-managed Claude home"
  bash "$HEALTH" --repo-root "$HUB" --hub-only --coverage-only --ignore-sync-state >/dev/null ||
    fail "private hub health rejected the fresh-machine seed"
  log "fresh-machine seed complete; private hub is ready and no local project memory exists yet"
  exit 0
fi

# A forget run publishes the machine's memory too, when this machine has any.
# Skipping the outgoing union left the hub holding whatever it already had, so a
# forget could never repair an index the machine had already healed - and the
# health gate then rejected the very transaction meant to fix it.
if [[ "$MODE" != "forget" || "$machine_memory_found" -eq 1 ]]; then
  log "union machine into private hub"
  AI_MEMORY_HUB_ROOT="$HUB" bash "$SYNC" push $DRY || fail "outgoing union failed"
fi
[[ -n "$DRY" ]] && { log "dry run complete"; exit 0; }

mapfile -d '' changed < <(git -C "$HUB" diff --name-only -z -- memory)
mapfile -d '' untracked < <(git -C "$HUB" ls-files --others --exclude-standard -z -- memory)
changed+=("${untracked[@]}")

SECRET_RE='ops_[A-Za-z0-9]{20}|gh[pousr]_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|xox[baprs]-[A-Za-z0-9-]{10}|sk-[A-Za-z0-9]{20}|eyJ[A-Za-z0-9_-]{18,}\.[A-Za-z0-9_-]{18,}\.'
hits=()
for relative in "${changed[@]}"; do
  [[ -n "$relative" && -f "$HUB/$relative" ]] || continue
  grep -Eq "$SECRET_RE" "$HUB/$relative" && hits+=("$relative")
done
if ((${#hits[@]})); then
  log "BLOCKED: secret-pattern detector rejected ${#hits[@]} outgoing file(s):"
  printf '  %s\n' "${hits[@]}" | tee -a "$LOG" >&2
  exit 1
fi

bash "$HEALTH" --repo-root "$HUB" --hub-only --coverage-only --ignore-sync-state >/dev/null ||
  fail "private hub health rejected the outgoing union"

if git -C "$HUB" diff --quiet -- memory && ((${#untracked[@]} == 0)); then
  stamp_success
  log "sync complete; union already converged"
  exit 0
fi

git -C "$HUB" add -A -- memory || fail "could not stage private memory union"
git -C "$HUB" -c user.name="ai-memory-sync" \
  -c user.email="ai-memory-sync@users.noreply.github.com" \
  commit -q -m "memory sync from $HOST" || fail "could not commit private memory union"
commit_sha="$(git -C "$HUB" rev-parse HEAD)"
if ! GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
    git -C "$HUB" push origin HEAD:main; then
  fail "push rejected; commit $commit_sha is preserved and no older state was copied"
fi

bash "$HEALTH" --repo-root "$HUB" --hub-only --coverage-only >/dev/null ||
  fail "post-push private hub health failed"
stamp_success
log "sync complete at $commit_sha"
