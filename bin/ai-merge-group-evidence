#!/usr/bin/env bash
# ai-merge-group-evidence — prove, from inside a merge-queue run, that the
# queued pull request's own head commit already carries the full verification
# this repository chose not to repeat on the queue.
#
# WHY THIS EXISTS. Issue #204 removed the long Windows jobs from `merge_group`
# and removed `windows-offline` from the ruleset's required contexts: a required
# check that never reports on a merge group hangs every queue entry for the full
# 120-minute `check_response_timeout_minutes`. The trade was deliberate and it
# works — merge-group runs since 2026-09-03 have a p90 of 12.3 minutes — but it
# left the Windows proof resting on an *assumption*: that the pull-request run
# on the exact queued head commit passed. Nothing checked it. A pull request
# whose Windows verification never ran, ran on an earlier commit, or ran and
# failed could still reach the queue and merge on the strength of a green Linux
# gate alone. GitHub's squash merge queue creates a new single-parent commit;
# the pull-request head is deliberately not its ancestor.
#
# This command closes that gap without putting the long jobs back on the queue.
# It is fail-closed: silence is never evidence, a run on a different commit is
# never evidence, and unfinished required coverage is never evidence. A completed
# equivalent hosted safety lane can cover its redundant original lane only when
# every other reported job is already complete and clean.
#
# Usage:
#   ai-merge-group-evidence --ref <merge-group-ref> --merge-group-sha <sha>
#     [--repo OWNER/NAME] [--workflow verify.yml] [--require <job-name>]...
#
# `--require` may be repeated; each named job must have concluded `success` in
# the pull-request run on the queued head commit. With no `--require`, the run's
# own conclusion is the only requirement.
# Windows jobs intentionally skipped for prose-only changes are accepted only
# after classifying the real, pinned PR diff with the same classifier as CI.
# Missing jobs, failed jobs, unknown paths and code changes remain fail-closed.
# The hosted reviewer fallback runs the identical Codex/Grok suites. Its success
# may replace only the delayed/cancelled/skipped original safety lane; failed
# assertions and missing or unfinished other jobs are never waived.
#
# Exit status:
#   0  the queued commit carries matching, complete, successful evidence
#   1  evidence is missing, stale, mismatched, or unsuccessful
#   2  usage or environment error (never treated as evidence)
set -uo pipefail

REF=''
MERGE_GROUP_SHA=''
REPO=''
WORKFLOW='verify.yml'
REQUIRED_JOBS=()

die() { printf 'ai-merge-group-evidence: %s\n' "$1" >&2; exit 2; }
reject() { printf 'ai-merge-group-evidence: %s\n' "$1" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --ref|--merge-group-sha|--repo|--workflow|--require)
      option="$1"
      [ $# -ge 2 ] && [ -n "$2" ] || die "$option requires a value"
      case "$option" in
        --ref) REF="$2" ;;
        --merge-group-sha) MERGE_GROUP_SHA="$2" ;;
        --repo) REPO="$2" ;;
        --workflow) WORKFLOW="$2" ;;
        --require) REQUIRED_JOBS+=("$2") ;;
      esac
      shift 2 ;;
    -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
done

[ -n "$REF" ] || die 'a merge-group ref is required (--ref)'
[ -n "$MERGE_GROUP_SHA" ] || die 'the merge-group commit is required (--merge-group-sha)'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GH="$ROOT/bin/ai-gh"
[ -x "$GH" ] || die 'the shared GitHub transport is not available'
gh_call() { AI_GH_CALLER=ai-merge-group-evidence "$GH" "$@"; }
command -v git >/dev/null 2>&1 || die 'git is not available'
command -v jq >/dev/null 2>&1 || die 'jq is not available'

# refs/heads/gh-readonly-queue/main/pr-357-<base sha>. Anything else is not a
# merge-queue ref, and guessing a pull-request number from it would be worse
# than refusing.
case "$REF" in
  *gh-readonly-queue/*/pr-*) : ;;
  *) die "not a merge-queue ref: $REF" ;;
esac
tail_part="${REF##*/pr-}"
PR_NUMBER="${tail_part%%-*}"
case "$PR_NUMBER" in
  ''|*[!0-9]*) die "could not read a pull-request number from $REF" ;;
esac

REPO_ARGS=()
[ -n "$REPO" ] && REPO_ARGS=(--repo "$REPO")

# A squash merge-group commit has one parent and a new tree. The REST
# commit-to-pulls association is empty while that synthetic commit is still in
# the queue, so it cannot gate the live build. Read the PR's current head and
# its live merge-group commit atomically from GraphQL. GitHub removes/rebuilds
# the queue entry when the PR head changes; matching this workflow's SHA to the
# live entry therefore binds the evidence query to this exact queued version.
[ -n "$REPO" ] || REPO="$(gh_call repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)"
[ -n "$REPO" ] || die 'could not determine the GitHub repository'
REPO_OWNER="${REPO%%/*}"
REPO_NAME="${REPO#*/}"
[ -n "$REPO_OWNER" ] && [ -n "$REPO_NAME" ] && [ "$REPO_OWNER" != "$REPO_NAME" ] || die "invalid GitHub repository $REPO"
read_queue_state() {
  gh_call api graphql -f query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){headRefOid baseRefOid mergeQueueEntry{headCommit{oid}}}}}' -F owner="$REPO_OWNER" -F name="$REPO_NAME" -F number="$PR_NUMBER" 2>/dev/null |
    jq -er 'if (.errors // [] | length) > 0 then error("GraphQL errors") else [.data.repository.pullRequest.headRefOid,.data.repository.pullRequest.mergeQueueEntry.headCommit.oid,.data.repository.pullRequest.baseRefOid]|join("|") end' 2>/dev/null | tr -d '\r'
}
QUEUE_STATE="$(read_queue_state)"
IFS='|' read -r HEAD_SHA QUEUED_GROUP BASE_SHA <<EOF
$QUEUE_STATE
EOF
case "$HEAD_SHA" in
  ''|*[!0-9a-fA-F]*) die "could not read the head commit of pull request $PR_NUMBER" ;;
esac
[ -n "$QUEUED_GROUP" ] || reject "pull request $PR_NUMBER has no readable live merge-queue entry"
[ "$QUEUED_GROUP" = "$MERGE_GROUP_SHA" ] || reject "pull request $PR_NUMBER is now queued as $QUEUED_GROUP, not workflow commit $MERGE_GROUP_SHA; its evidence would be stale"

PROSE_ONLY=unknown
classify_queued_change() {
  [ "$PROSE_ONLY" = unknown ] || return 0
  case "$BASE_SHA" in ''|*[!0-9a-fA-F]*) reject 'the queued PR base is unreadable; skipped Windows jobs cannot prove coverage' ;; esac
  [ "${#BASE_SHA}" -eq 40 ] || reject 'the queued PR base is not an exact commit'
  local root paths classification current_state
  root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
  [ -f "$root/tools/ci/classify-changes.sh" ] || reject 'the CI change classifier is missing; skipped Windows jobs cannot prove coverage'
  # Triple-dot is the PR patch against its recorded target, not local main.
  # No rename detection: moving a script into docs still includes its deletion.
  paths="$(git diff --no-renames --name-only "$BASE_SHA...$HEAD_SHA" -- 2>/dev/null)" || reject 'the queued PR diff is unavailable; skipped Windows jobs cannot prove coverage'
  [ -n "$paths" ] || reject 'the queued PR diff is empty; skipped Windows jobs cannot prove coverage'
  classification="$(printf '%s\n' "$paths" | bash "$root/tools/ci/classify-changes.sh" pull_request)" || reject 'the queued PR classification failed'
  # Bind the path classification to the same source/base/queue state as the run.
  current_state="$(read_queue_state)" || reject 'the queue identity could not be rechecked after classification'
  [ "$current_state" = "$QUEUE_STATE" ] || reject 'the queued source or base changed during path classification'
  PROSE_ONLY=false
  if printf '%s\n' "$classification" | grep -qx 'prose_only=true'; then PROSE_ONLY=true; fi
}

RUNS="$(gh_call run list ${REPO_ARGS[@]+"${REPO_ARGS[@]}"} --workflow "$WORKFLOW" --event pull_request --commit "$HEAD_SHA" --limit 20 --json databaseId,conclusion,status --jq '.[] | [.databaseId, .status, .conclusion] | @tsv' 2>/dev/null)"
[ -n "$RUNS" ] || reject "no $WORKFLOW run exists for head commit $HEAD_SHA of pull request $PR_NUMBER"

read_jobs() {
  gh_call run view "$1" ${REPO_ARGS[@]+"${REPO_ARGS[@]}"} --json jobs --jq '.jobs[] | [.name, (if .conclusion==null or .conclusion=="" then "pending" else .conclusion end), .status] | @tsv' 2>/dev/null
}

equivalent_fallback_proven() { # completed same-run replacement, never a failed assertion
  local jobs job conclusion status
  jobs="$(printf '%s\n' "$1" | sed 's/\r$//')"
  # P6: the hosted Codex and Grok suites are independent jobs. Both must have
  # succeeded to replace the original reviewer lane. Every other reported job
  # must already be complete and clean. Explicitly require the core jobs too;
  # an incomplete API response is not coverage.
  for job in windows-reviewer-fallback-codex windows-reviewer-fallback-grok windows-offline linux-offline 'fast-classifier / select' 'fast-classifier / validate'; do
    printf '%s\n' "$jobs" | awk -F'\t' -v want="$job" '$1==want && $2=="success" && $3=="completed" {found=1} END {exit !found}' || return 1
  done
  printf '%s\n' "$jobs" | awk -F'\t' '$1=="windows-reviewer-safety" {found=1} END {exit !found}' || return 1
  while IFS="$(printf '\t')" read -r job conclusion status; do
    [ -n "$job" ] || continue
    if [ "$job" = windows-reviewer-safety ]; then
      case "$status:$conclusion" in
        queued:pending|in_progress:pending|completed:cancelled|completed:skipped|completed:success) continue ;;
        *) return 1 ;;
      esac
    fi
    [ "$status" = completed ] || return 1
    case "$conclusion" in success|skipped) ;; *) return 1 ;; esac
  done <<EOF
$jobs
EOF
}

# Advisory lanes run with continue-on-error and sit outside verification-closure
# (verify.yml windows-offline-warpbuild-proof, capacity-capped BYOC pool). While
# one is still queued the whole run reads "queued", which used to stall every
# merge for hours. Such a run is evidence only when verification-closure has
# already succeeded and every NON-advisory job is complete and clean; anything
# else stays fail-closed.
ADVISORY_JOB_PREFIX='windows-offline-warpbuild-proof ('
advisory_only_pending() {
  local jobs job conclusion status
  jobs="$(printf '%s\n' "$1" | sed 's/\r$//')"
  # An incomplete API response is not coverage: the closure and core jobs must
  # each be present and successful, never merely absent.
  for job in verification-closure linux-offline 'fast-classifier / select' 'fast-classifier / validate'; do
    printf '%s\n' "$jobs" | awk -F'\t' -v want="$job" '$1==want && $2=="success" && $3=="completed" {found=1} END {exit !found}' || return 1
  done
  while IFS="$(printf '\t')" read -r job conclusion status; do
    [ -n "$job" ] || continue
    case "$job" in "$ADVISORY_JOB_PREFIX"*) continue ;; esac
    [ "$status" = completed ] || return 1
    case "$conclusion" in success|skipped) ;; *) return 1 ;; esac
  done <<EOF
$jobs
EOF
}

# A cancelled overall run may retain complete required coverage. Admit ONLY
# real same-run advisory job cancellations proven non-required by live GitHub.
read_cancel_policy() (
  local temp python context state deadline
  local -a command
  python="$(command -v python3 || command -v python)" || return 1
  temp="$(mktemp -d)" || return 1
  trap 'rm -rf "$temp"' EXIT
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && [ -n "${AI_PR_WAIT_TEST_CONTEXT_KEY:-}" ]; then
    context="$AI_PR_WAIT_TEST_CONTEXT_KEY"
  else
    context="$("$ROOT/tools/github-requests/pr-status-context" 2>/dev/null)" || context=''
  fi
  deadline=$(( $(date +%s) + 180 ))
  command=("$python" "$ROOT/bin/ai-process-supervisor" --timeout-seconds 180 -- bash "$ROOT/tools/github-requests/pr-status-complete.sh" "$GH" "$python" "$ROOT/bin/ai-process-supervisor"
    "$(command -v bash)" "$REPO_OWNER" "$REPO_NAME" "$PR_NUMBER" "$deadline" 30 10 "$temp/source")
  if [ -z "$context" ]; then
    # Repository/app credentials need not have a numeric /user identity. As
    # ai-pr-wait does, retain the same complete bounded frontdoor transaction
    # without sharing a cache across unknown credential contexts.
    AI_GH_CALLER=ai-merge-group-evidence "${command[@]}" || {
      printf 'ai-merge-group-evidence: current cancellation policy transport unavailable\n' >&2
      return 1
    }
    return
  fi
  state="${AI_PR_WAIT_SNAPSHOT_DIR:-$HOME/.local/state/ai-devops-pr-status}"
  AI_GH_CALLER=ai-merge-group-evidence "$python" "$ROOT/tools/github-requests/pr_status_singleflight.py" \
    --state-dir "$state" --key "v3 $context $REPO $PR_NUMBER $HEAD_SHA" \
    --expected-head "$HEAD_SHA" --ttl 10 --wait-seconds 180 --cap-supervisor-timeout --defer-source-mark \
    --age-file "$temp/age" --source-file "$temp/source" --force-refresh -- "${command[@]}"
)
cancelled_advisory_proven() {
  local id="$1" run workflow jobs policy attempt
  run="$(gh_call api "repos/$REPO/actions/runs/$id" 2>/dev/null)" || return 1
  printf '%s' "$run" | jq -e --argjson id "$id" --arg head "$HEAD_SHA" --arg repo "$REPO" \
    '.id==$id and .head_sha==$head and .head_repository.full_name==$repo and .repository.full_name==$repo and .event=="pull_request" and .status=="completed" and .conclusion=="cancelled" and (.run_attempt|type)=="number" and .run_attempt>0 and (.workflow_id|type)=="number"' >/dev/null || return 1
  workflow="$(gh_call api "repos/$REPO/actions/workflows/$(printf '%s' "$run" | jq -r .workflow_id)" 2>/dev/null)" || return 1
  printf '%s' "$workflow" | jq -e --arg path ".github/workflows/$WORKFLOW" --argjson id "$(printf '%s' "$run" | jq -r .workflow_id)" '.id==$id and .path==$path' >/dev/null || return 1
  attempt="$(printf '%s' "$run" | jq -r .run_attempt)"
  jobs="$(gh_call api --paginate --slurp "repos/$REPO/actions/runs/$id/attempts/$attempt/jobs?per_page=100" 2>/dev/null)" || return 1
  # Stable complete total/positive unique IDs and original mandatory coverage.
  printf '%s' "$jobs" | jq -e --argjson id "$id" --argjson attempt "$attempt" --arg head "$HEAD_SHA" '
    .[0].total_count as $total | type=="array" and length>0 and
    all(.[]; .total_count==$total and (.jobs|type)=="array") and
    ([.[].jobs[]]|length)==$total and $total>0 and ([.[].jobs[].id]|unique|length)==$total and
    all(.[].jobs[]; (.id|type)=="number" and .id>0 and .run_id==$id and .run_attempt==$attempt and .head_sha==$head and .status=="completed" and (.name|type)=="string" and (.conclusion=="success" or .conclusion=="skipped" or .conclusion=="cancelled"))' >/dev/null || return 1
  printf '%s' "$jobs" | jq -e '[.[].jobs[]] as $jobs | all(["verification-closure","linux-offline","fast-classifier / select","fast-classifier / validate","windows-offline","windows-reviewer-safety"][]; . as $name | [$jobs[]|select(.name==$name)] as $matches | ($matches|length)==1 and $matches[0].conclusion=="success") and any($jobs[];.conclusion=="cancelled")' >/dev/null || return 1
  policy="$(read_cancel_policy)" || return 1
  printf '%s' "$policy" | jq -e --arg head "$HEAD_SHA" --argjson jobs "$jobs" --arg repo "$REPO" --argjson run "$id" '
    .data.repository.pullRequest.commits.nodes[0].commit.statusCheckRollup.contexts as $c |
    (.errors|not) and .data.repository.pullRequest.state=="OPEN" and
    .data.repository.pullRequest.headRefOid==$head and .data.repository.pullRequest.commits.nodes[0].commit.oid==$head and
    $c.pageInfo.hasPreviousPage==false and $c.totalCount==($c.nodes|length) and
    all($jobs[].jobs[]|select(.conclusion=="cancelled"); . as $job |
      [$c.nodes[]|select(.name==$job.name)] as $matches |
      ($matches|length)==1 and $matches[0].isRequired==false and $matches[0].status=="COMPLETED" and $matches[0].conclusion=="CANCELLED" and
      $matches[0].detailsUrl==("https://github.com/"+$repo+"/actions/runs/"+($run|tostring)+"/job/"+($job.id|tostring)))' >/dev/null || return 1
  [ "$(gh_call api "repos/$REPO/actions/runs/$id" --jq '.run_attempt' 2>/dev/null)" = "$attempt" ] || return 1
  [ "$(read_queue_state)" = "$QUEUE_STATE" ] || return 1
}
RUN_ID=''
FALLBACK_RUNS=' '
ADVISORY_RUNS=' '
CANCELLED_ADVISORY_RUNS=' '
while IFS="$(printf '\t')" read -r id status conclusion; do
  [ -n "$id" ] || continue
  if [ "$status:$conclusion" != completed:success ]; then
    # A passing replacement can cover the original lane's queue delay or
    # cancellation. A failed run or assertion is never overridden.
    case "$status:$conclusion" in queued:*|in_progress:*|completed:cancelled)
      candidate_jobs="$(read_jobs "$id")"
      if equivalent_fallback_proven "$candidate_jobs"; then
        [ "$(read_queue_state)" = "$QUEUE_STATE" ] || reject 'the queued source or base changed during fallback verification'
        FALLBACK_RUNS="$FALLBACK_RUNS$id "
        RUN_ID="$id"
        continue
      fi
      if [ "$status:$conclusion" = completed:cancelled ] && cancelled_advisory_proven "$id"; then
        CANCELLED_ADVISORY_RUNS="$CANCELLED_ADVISORY_RUNS$id "
        RUN_ID="$id"
        printf 'ai-merge-group-evidence: run %s has complete original required coverage and exact GitHub non-required cancellations\n' "$id"
        continue
      fi
      if [ "$status" != completed ] && advisory_only_pending "$candidate_jobs"; then
        [ "$(read_queue_state)" = "$QUEUE_STATE" ] || reject 'the queued source or base changed during advisory-lane verification'
        printf 'ai-merge-group-evidence: run %s complete except advisory %s* jobs\n' "$id" "$ADVISORY_JOB_PREFIX"
        ADVISORY_RUNS="$ADVISORY_RUNS$id "
        RUN_ID="$id"
        continue
      fi ;;
    esac
  fi
  [ "$status" = 'completed' ] || reject "the $WORKFLOW run $id for head commit $HEAD_SHA has not finished ($status); an unfinished run is not evidence"
  [ "$conclusion" = 'success' ] || reject "the $WORKFLOW run $id for head commit $HEAD_SHA concluded $conclusion"
  RUN_ID="$id"
done <<EOF
$RUNS
EOF

[ -n "$RUN_ID" ] || reject "no usable $WORKFLOW run for head commit $HEAD_SHA"

if [ "${#REQUIRED_JOBS[@]}" -gt 0 ]; then
  JOBS="$(read_jobs "$RUN_ID")"
  [ -n "$JOBS" ] || reject "run $RUN_ID reports no jobs; its coverage cannot be confirmed"
  if [[ "$FALLBACK_RUNS" = *" $RUN_ID "* ]]; then
    equivalent_fallback_proven "$JOBS" || reject 'the qualified fallback or other exact-head job evidence changed'
  fi
  if [[ "$ADVISORY_RUNS" = *" $RUN_ID "* ]]; then
    advisory_only_pending "$JOBS" || reject 'the advisory-lane exact-head job evidence changed'
  fi
  if [[ "$CANCELLED_ADVISORY_RUNS" = *" $RUN_ID "* ]]; then
    cancelled_advisory_proven "$RUN_ID" || reject 'the current same-run cancellation policy or original coverage changed'
  fi
  for job in "${REQUIRED_JOBS[@]}"; do
    line="$(printf '%s\n' "$JOBS" | awk -F'\t' -v want="$job" '$1 == want { print $2; exit }')"
    [ -n "$line" ] || reject "run $RUN_ID never ran the required job $job on head commit $HEAD_SHA"
    if [ "$job" = windows-reviewer-safety ] && [ "$line" != success ] && equivalent_fallback_proven "$JOBS"; then
      [ "$(read_queue_state)" = "$QUEUE_STATE" ] || reject 'the queued source or base changed during fallback verification'
      printf 'ai-merge-group-evidence: exact-head hosted reviewer fallbacks supply the identical reviewer suites for PR %s\n' "$PR_NUMBER"
      continue
    fi
    if [ "$line" = skipped ]; then
      case "$job" in
        windows-offline|windows-reviewer-safety)
          classify_queued_change
          if [ "$PROSE_ONLY" = true ]; then
            printf 'ai-merge-group-evidence: %s intentionally skipped for verified prose-only PR %s\n' "$job" "$PR_NUMBER"
            continue
          fi ;;
      esac
    fi
    [ "$line" = 'success' ] || reject "the required job $job concluded $line in run $RUN_ID"
  done
fi

printf 'ai-merge-group-evidence: pull request %s head %s verified by %s run %s\n' "$PR_NUMBER" "$HEAD_SHA" "$WORKFLOW" "$RUN_ID"
