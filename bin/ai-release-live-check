#!/usr/bin/env bash
# ai-release-live-check — one real, cheap review of a fixed tiny fixture from an
# exact candidate commit, on Ubuntu and on Windows host 4837, recorded as GitHub
# commit statuses that `ai-task-gates authorize-install` requires before a
# release touching shared review code is installed (#1783,
# plan_release-live-review-check.md).
set -uo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
REPO_SLUG="${AI_RELEASE_LIVE_CHECK_REPO:-popcre/ai-devops}"
TRUSTED_LOGIN=u2giants
WINDOWS_HOST="${AI_RELEASE_LIVE_CHECK_WINDOWS_HOST:-4837}"
WINDOWS_CHECKOUT="${AI_RELEASE_LIVE_CHECK_WINDOWS_CHECKOUT:-C:/repos/ai-devops}"
CONTEXT_PREFIX=ai-devops/live-review
DEFAULT_PROVIDER=deepseek
LEG_TIMEOUT="${AI_RELEASE_LIVE_CHECK_TIMEOUT:-900}"
[[ "$LEG_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo 'ai-release-live-check: AI_RELEASE_LIVE_CHECK_TIMEOUT must be whole seconds' >&2; exit 2; }

die() { printf 'ai-release-live-check: %s\n' "$*" >&2; exit 2; }
usage() {
  cat <<'EOF'
Usage: ai-release-live-check run    --target-head SHA [--provider P]
       ai-release-live-check fleet  --target-head SHA [--provider P]   (Ubuntu review host only)
       ai-release-live-check verify --target-head SHA
run    one real review of the fixture from candidate SHA on this OS; prints one JSON line.
fleet  run on this Ubuntu host and on Windows host 4837, then post both commit statuses.
verify exit 0 only when linux and windows statuses on SHA are success by u2giants
       (success is posted only for an APPROVE of the benign fixture).
EOF
}

os_name() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) echo windows ;; Linux) echo linux ;; *) echo other ;; esac; }
est_now() { TZ=America/New_York date '+%Y-%m-%d %-I:%M %p %Z'; }

json_line() { # ok verdict elapsed detail
  jq -nc --arg os "$(os_name)" --arg host "$(hostname)" --arg target "$target" --arg provider "$provider" \
    --argjson ok "$1" --arg verdict "$2" --argjson elapsed "$3" --arg detail "$4" \
    '{os:$os,host:$host,target:$target,provider:$provider,ok:$ok,verdict:$verdict,elapsed:$elapsed,detail:$detail}'
}

make_fixture() { # DIR -> two-commit repo with a one-line docstring change
  git init -q -b main "$1" && (
    cd "$1" || exit 1
    git config user.name 'release live check'; git config user.email 'live-check@invalid'
    git config core.autocrlf false
    printf '.ai/\n' > .gitignore
    printf 'def add(a, b):\n    return a + b\n' > calc.py
    git add .gitignore calc.py && git commit -qm 'fixture base'
    printf 'def add(a, b):\n    """Return the sum of a and b."""\n    return a + b\n' > calc.py
    git commit -qam 'fixture: add docstring'
  )
}

cmd_run() {
  local out rc report verdict start elapsed
  work=""; cand=""; added=0
  [ "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" = "$target" ] && [ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ] && cand="$ROOT"
  work="$(mktemp -d)" || die 'cannot create a scratch folder'
  trap '[ "$added" -eq 0 ] || git -C "$ROOT" worktree remove --force "$cand" >/dev/null 2>&1; rm -rf "$work"' EXIT
  if [ -z "$cand" ]; then
    git -C "$ROOT" cat-file -e "$target^{commit}" 2>/dev/null || { json_line false '' 0 'target commit not present; fetch origin main first'; rm -rf "$work"; return 1; }
    cand="$work/candidate"
    git -C "$ROOT" -c core.hooksPath="$work" worktree add -q --detach "$cand" "$target" >/dev/null 2>&1 || { json_line false '' 0 'cannot create candidate worktree'; rm -rf "$work"; return 1; }
    added=1
  fi
  if ! make_fixture "$work/fixture"; then
    [ "$added" -eq 0 ] || git -C "$ROOT" worktree remove --force "$cand" >/dev/null 2>&1; rm -rf "$work"
    json_line false "" 0 "cannot build fixture"; return 1
  fi
  start=$SECONDS
  out="$(cd "$work/fixture" && PATH="$cand/bin:$PATH" timeout "$LEG_TIMEOUT" "$cand/bin/ai-review" "$provider" diff-review --base HEAD~1 2>&1)"; rc=$?
  elapsed=$((SECONDS - start))
  report="$(printf '%s\n' "$out" | tr -d '\r' | awk 'NF{l=$0} END{print l}')"
  verdict=""
  if [ -f "$report" ]; then
    # Read every `## Verdict` block; a report whose blocks disagree is
    # CONTRADICTORY and fails, so a stray early APPROVE can never pass.
    verdict="$(tr -d '\r' < "$report" | awk '/^##[[:space:]]+Verdict/{f=1;next} f&&NF{gsub(/[^A-Z]/," ");split($0,w," ");print w[1];f=0}' | sort -u)"
    [ "$(printf '%s' "$verdict" | grep -c .)" -le 1 ] || verdict=CONTRADICTORY
  fi
  [ "$added" -eq 0 ] || git -C "$ROOT" worktree remove --force "$cand" >/dev/null 2>&1
  rm -rf "$work"
  # The fixture is a harmless docstring change, so only APPROVE is a pass; a
  # REVISE or REJECT means the candidate's reviewer misjudges a benign diff.
  if [ "$rc" -eq 0 ] && [ "$verdict" = APPROVE ]; then
    json_line true "$verdict" "$elapsed" 'real review approved the benign fixture'
    return 0
  fi
  if [ "$rc" -eq 0 ] && [[ "$verdict" =~ ^(REVISE|REJECT)$ ]]; then
    json_line false "$verdict" "$elapsed" "real review returned $verdict on the benign fixture; only APPROVE passes"
    return 1
  fi
  json_line false "$verdict" "$elapsed" "ai-review exit $rc: $(printf '%s' "$out" | tr -d '\r' | grep -v '^[[:space:]]*$' | tail -n 3 | tr '\n' ' ' | cut -c1-300)"
  return 1
}

# The leg runs the CANDIDATE's own copy of this script from a detached worktree
# of the target, so the check under test is the one being released.
leg_script() { # CHECKOUT
  cat <<EOF
set -uo pipefail
cd '$1' || { echo '{"ok":false,"detail":"installed checkout missing"}'; exit 1; }
git fetch -q --no-tags origin refs/heads/main:refs/remotes/origin/main || { echo '{"ok":false,"detail":"fetch failed"}'; exit 1; }
git merge-base --is-ancestor '$target' refs/remotes/origin/main || { echo '{"ok":false,"detail":"target not in origin/main"}'; exit 1; }
boot="\$(mktemp -d)" || { echo '{"ok":false,"detail":"mktemp failed"}'; exit 1; }
trap 'git worktree remove --force "\$boot/c" >/dev/null 2>&1; rm -rf "\$boot"' EXIT
git -c core.hooksPath="\$boot" worktree add -q --detach "\$boot/c" '$target' >/dev/null 2>&1 || { echo '{"ok":false,"detail":"cannot create boot worktree"}'; exit 1; }
bash "\$boot/c/bin/ai-release-live-check" run --target-head '$target' --provider '$provider'; rc=\$?
git worktree remove --force "\$boot/c" >/dev/null 2>&1; rm -rf "\$boot"
exit \$rc
EOF
}

post_status() { # OS JSON — success only for an APPROVE result from that OS for this exact target
  local state desc
  if printf '%s' "$2" | jq -e --arg os "$1" --arg t "$target" --arg p "$provider" \
      '.ok==true and .os==$os and .target==$t and .provider==$p and .verdict=="APPROVE"' >/dev/null 2>&1; then
    state=success
  else state=failure; fi
  desc="$(printf '%s' "$2" | jq -r '"\(.host // "?") \(.provider // "") \(.verdict // "") \(.elapsed // 0)s"' 2>/dev/null || echo 'no result') $(est_now)"
  "$ROOT/bin/ai-gh" api -X POST "repos/$REPO_SLUG/statuses/$target" -f state="$state" -f context="$CONTEXT_PREFIX/$1" \
    -f description="${desc:0:140}" >/dev/null || { printf 'ai-release-live-check: could not post %s status\n' "$1" >&2; return 1; }
  printf '%s %s: %s\n' "$1" "$state" "$2"
  [ "$state" = success ]
}

cmd_fleet() {
  local linux_json windows_json fail=0
  [ "$(os_name)" = linux ] || die 'fleet runs from an Ubuntu review host'
  case "$(hostname | tr '[:upper:]' '[:lower:]')" in *edge-alien*|*envy*) die 'this host is not a review host' ;; esac
  [ "$("$ROOT/bin/ai-gh" api user -q .login 2>/dev/null)" = "$TRUSTED_LOGIN" ] || die "the GitHub CLI must be signed in as $TRUSTED_LOGIN to record the result"
  linux_json="$(leg_script "$ROOT" | timeout $((LEG_TIMEOUT + 300)) bash | tail -n 1)"
  windows_json="$(leg_script "$WINDOWS_CHECKOUT" | timeout $((LEG_TIMEOUT + 300)) ssh -o BatchMode=yes -o ConnectTimeout=20 "$WINDOWS_HOST" '"C:\Program Files\Git\bin\bash.exe" -l -s' 2>/dev/null | tr -d '\r' | tail -n 1)"
  [ -n "$windows_json" ] || windows_json='{"ok":false,"host":"4837","detail":"Windows host unreachable or no result"}'
  post_status linux "$linux_json" || fail=1
  post_status windows "$windows_json" || fail=1
  return "$fail"
}

fetch_statuses() {
  "$ROOT/bin/ai-gh" api "repos/$REPO_SLUG/commits/$target/statuses?per_page=100" 2>/dev/null
}

cmd_verify() {
  local statuses os row bad=0
  statuses="$(fetch_statuses)" || { echo 'ai-release-live-check: cannot read commit statuses' >&2; return 1; }
  for os in linux windows; do
    # The newest status by the trusted login wins; other authors are ignored.
    row="$(printf '%s' "$statuses" | jq -r --arg c "$CONTEXT_PREFIX/$os" --arg l "$TRUSTED_LOGIN" \
      '[.[] | select(.context==$c and .creator.login==$l)] | sort_by(.created_at) | last | .state // "missing"')" || row=missing
    printf '%s/%s: %s\n' "$CONTEXT_PREFIX" "$os" "$row"
    [ "$row" = success ] || bad=1
  done
  return "$bad"
}

# Sourced by the tests to exercise post_status without a fleet run.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

sub="${1:-}"; [ $# -gt 0 ] && shift
target=""; provider="$DEFAULT_PROVIDER"
while [ $# -gt 0 ]; do
  case "$1" in
    --target-head) [ $# -ge 2 ] || die '--target-head needs a SHA'; target="$2"; shift 2 ;;
    --provider) [ $# -ge 2 ] || die '--provider needs a name'; provider="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ "$provider" =~ ^[a-z0-9-]+$ ]] || die 'bad provider name'
case "$sub" in
  run|fleet|verify)
    [[ "$target" =~ ^[0-9a-f]{40}$ ]] || die '--target-head must be a full lowercase SHA'
    "cmd_$sub" ;;
  -h|--help|'') usage; [ -n "$sub" ] ;;
  *) die "unknown subcommand: $sub" ;;
esac
