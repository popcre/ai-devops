#!/usr/bin/env bash
# ai-codex-review — fail-closed, read-only Codex review of an exact source state.
set -euo pipefail
umask 077

VERSION="2.1.0"
MODELS_ENV="${AI_DEVOPS_MODELS_ENV:-/etc/ai-devops/models.env}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX="${AI_REVIEW_SANDBOX_BIN:-$SCRIPT_DIR/ai-review-sandbox}"
PACKET="${AI_REVIEW_PACKET_BIN:-$SCRIPT_DIR/ai-review-packet}"
LIFECYCLE="${AI_REVIEW_LIFECYCLE_BIN:-$SCRIPT_DIR/ai-review-lifecycle}"
CALLER="${AI_CODEX_REVIEW_CALLER:-codex}"
CODEX_CMD='codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox read-only -c model_reasoning_effort=medium'
REVIEW_TIMEOUT="${AI_CODEX_REVIEW_TIMEOUT:-1800}"

die(){ printf 'ai-codex-review: error: %s\n' "$*" >&2; exit 1; }
load_codex_command(){
  local count line
  [ -f "$MODELS_ENV" ] || return 0
  count="$(grep -c '^CODEX_CMD=' "$MODELS_ENV" 2>/dev/null || true)"; [ "$count" -le 1 ] || die "duplicate CODEX_CMD entries in $MODELS_ENV"
  [ "$count" = 1 ] || return 0
  line="$(grep '^CODEX_CMD=' "$MODELS_ENV")"
  case "$line" in CODEX_CMD=\'*\') CODEX_CMD="${line#CODEX_CMD=\'}"; CODEX_CMD="${CODEX_CMD%\'}";; *) die "CODEX_CMD in $MODELS_ENV must be one single-quoted data value.";; esac
  case "$CODEX_CMD" in *\'*) die "CODEX_CMD in $MODELS_ENV contains an embedded quote.";; esac
}
protect_windows_path(){
  local path="$1" kind="${2:-file}" ps helper
  [ -n "${SYSTEMROOT:-}" ] || return 0
  command -v cygpath >/dev/null 2>&1 || return 1
  ps="$(command -v pwsh.exe 2>/dev/null || command -v pwsh 2>/dev/null || command -v powershell.exe 2>/dev/null || true)"; [ -n "$ps" ] || return 1
  helper="$SCRIPT_DIR/windows-private-file.ps1"; [ -f "$helper" ] || return 1
  AI_DEVOPS_PRIVATE_HELPER="$(cygpath -w "$helper")" AI_DEVOPS_PRIVATE_TARGET="$(cygpath -w "$path")" AI_DEVOPS_PRIVATE_KIND="$kind" \
    "$ps" -NoProfile -ExecutionPolicy Bypass -Command '. $env:AI_DEVOPS_PRIVATE_HELPER; if ($env:AI_DEVOPS_PRIVATE_KIND -eq "directory") { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET -Directory } else { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET }' >/dev/null
}
secure_review_directory(){ chmod 700 "$1" 2>/dev/null && protect_windows_path "$1" directory; }
usage(){ cat <<'EOF'
Usage: ai-codex-review <plan-review|diff-review|security-review|visual-review|final-check> [--tests <command>]
       ai-codex-review doctor

The review runs in a complete disposable snapshot under Codex's read-only
sandbox. Success requires an exact verdict, atomic report, lifecycle terminal
record, and current source identity.
EOF
}

validate_command(){
  local physical test_root physical_dir physical_base
  case "$REVIEW_TIMEOUT" in ''|0|*[!0-9]*) die 'AI_CODEX_REVIEW_TIMEOUT must be a positive whole number of seconds.';; esac
  load_codex_command
  read -r -a CODEX_ARGS <<< "$CODEX_CMD"
  [ "${#CODEX_ARGS[@]}" -eq 9 ] || die 'CODEX_CMD must be the exact governed Codex review command.'
  [ "${CODEX_ARGS[1]}" = exec ] && [ "${CODEX_ARGS[2]}" = -m ] && [ "${CODEX_ARGS[3]}" = gpt-5.6-sol ] \
    && [ "${CODEX_ARGS[4]}" = --skip-git-repo-check ] && [ "${CODEX_ARGS[5]}" = --sandbox ] && [ "${CODEX_ARGS[6]}" = read-only ] && [ "${CODEX_ARGS[7]}" = -c ] \
    || die 'CODEX_CMD must preserve the exact model and read-only sandbox argument order.'
  case "${CODEX_ARGS[8]}" in model_reasoning_effort=low|model_reasoning_effort=medium) ;; *) die 'CODEX_CMD must explicitly pin model_reasoning_effort=low or medium.';; esac
  if [ -n "${AI_CODEX_REVIEW_TEST_DIR:-}" ]; then
    physical="$(readlink -f "${CODEX_ARGS[0]}" 2>/dev/null || true)"; test_root="$(cd "$AI_CODEX_REVIEW_TEST_DIR" 2>/dev/null && pwd -P || true)"
    [ -n "$physical" ] && [ -n "$test_root" ] || die 'could not resolve the test Codex executable boundary.'
    # Git Bash can spell the same Windows path as /tmp/..., D:/..., /d/...,
    # or a mixed-case native path. Convert both sides through an absolute
    # Windows spelling before enforcing the test-only executable boundary.
    # cygpath conversion alone is insufficient on GitHub's Windows runner
    # because readlink and pwd can choose different aliases for the same /tmp
    # tree. Resolve each directory through Git Bash's canonical Windows view.
    if command -v cygpath >/dev/null 2>&1; then
      physical_base="$(basename "$physical")"
      physical_dir="$(cd -P "$(dirname "$physical")" 2>/dev/null && pwd -W 2>/dev/null || true)"
      test_root="$(cd -P "$test_root" 2>/dev/null && pwd -W 2>/dev/null || true)"
      [ -n "$physical_dir" ] && [ -n "$physical_base" ] && [ -n "$test_root" ] \
        || die 'could not canonicalize the Windows test Codex executable boundary.'
      physical="$physical_dir/$physical_base"
      physical="${physical,,}"; test_root="${test_root,,}"
    fi
    case "$physical" in "$test_root"/*) ;; *) die "test Codex executable escaped AI_CODEX_REVIEW_TEST_DIR (executable=$physical boundary=$test_root).";; esac
  else
    case "${CODEX_ARGS[0]}" in codex|codex.exe) ;; *) die 'production CODEX_CMD must invoke the governed codex executable directly.';; esac
  fi
  command -v "${CODEX_ARGS[0]}" >/dev/null 2>&1 || die "Codex command not found: ${CODEX_ARGS[0]}"
  command -v timeout >/dev/null 2>&1 || die 'timeout is required for bounded Codex reviews.'
}

doctor(){
  validate_command
  "$SANDBOX" --version >/dev/null
  "$PACKET" --version >/dev/null
  "$LIFECYCLE" --version >/dev/null
  printf 'PASS provider=codex sandbox=read-only reasoning=explicit command=%s\n' "${CODEX_ARGS[0]}"
}

MODE="${1:-}"
case "$MODE" in
  doctor) shift; [ "$#" -eq 0 ] || die 'usage: ai-codex-review doctor'; doctor; exit 0;;
  plan-review|diff-review|security-review|visual-review|final-check) ;;
  ''|-h|--help|help) usage; exit 0;;
  *) usage >&2; exit 2;;
esac

shift
TESTS_COMMAND=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tests)
      [ -z "$TESTS_COMMAND" ] || die '--tests may be supplied only once.'
      [ "$#" -ge 2 ] && [ -n "$2" ] || die '--tests requires a non-empty command.'
      TESTS_COMMAND="$2"; shift 2;;
    *) die "unknown option: $1";;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'must be run inside a Git repository.'
REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT"
validate_command

REPORT_DIR="$REPO_ROOT/.ai/reviews"
[ ! -L "$REPO_ROOT/.ai" ] && [ ! -L "$REPORT_DIR" ] || die 'refusing a linked .ai report destination.'
git check-ignore -q .ai/reviews/ai-codex-review-probe \
  || die '.ai/reviews must be Git-ignored before a review can write there.'
mkdir -p "$REPORT_DIR"; [ ! -L "$REPORT_DIR" ] || die 'report destination became a link.'
secure_review_directory "$REPORT_DIR" || die 'could not enforce private review storage.'

RUN_ID="$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM"
OUT="$REPORT_DIR/codex-${MODE}-${RUN_ID}.md"; OUT_REL="${OUT#"$REPO_ROOT"/}"
git check-ignore --no-index -q -- "$OUT_REL" || die "exact report destination is not Git-ignored: $OUT_REL"
! git ls-files --error-unmatch -- "$OUT_REL" >/dev/null 2>&1 || die "exact report destination is tracked: $OUT_REL"
[ ! -e "$OUT" ] && [ ! -L "$OUT" ] || die "unique report collision: $OUT"
TAG="codex-${MODE}-${RUN_ID}"; STARTED="$(date +%s)"
STATE=""; REVIEW_DIR=""; PACKET_DIR=""; TMP_OUT=""; TMP_ERR=""; TMP_REPORT=""; PROVIDER_PID=""; FAILURE_REPORT=""
cleanup(){
  [ -z "$TMP_OUT" ] || rm -f "$TMP_OUT"
  [ -z "$TMP_ERR" ] || rm -f "$TMP_ERR"
  [ -z "$TMP_REPORT" ] || rm -f "$TMP_REPORT"
  [ -z "$REVIEW_DIR" ] || "$PACKET" remove "$REVIEW_DIR" "$TAG" >/dev/null 2>&1 || true
  "$SANDBOX" remove-copy "$REPO_ROOT" "$TAG" >/dev/null 2>&1 || true
}
trap cleanup EXIT

preserve_failure_diagnostic(){ # FAILURE_CLASS
  local failure="$1" path tmp
  [ -n "$TMP_ERR" ] && [ -f "$TMP_ERR" ] || return 1
  path="$REPORT_DIR/codex-${MODE}-failed-${RUN_ID}.log"
  [ ! -e "$path" ] && [ ! -L "$path" ] || return 1
  git check-ignore --no-index -q -- "${path#"$REPO_ROOT"/}" || return 1
  tmp="$(mktemp "$REPORT_DIR/.codex-failure.XXXXXX")" || return 1
  {
    printf 'Codex review failure\nrun: %s\nmode: %s\nfailure: %s\nhead: %s\n\nSanitized provider diagnostics (last 32768 bytes):\n' "$RUN_ID" "$MODE" "$failure" "$(jq -r '.head // "unknown"' "$STATE" 2>/dev/null || printf unknown)"
    tail -c 32768 "$TMP_ERR" | sed -E 's/((API[_-]?KEY|TOKEN|SECRET|PASSWORD)[[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig; s/(Bearer[[:space:]]+)[A-Za-z0-9._~+\/-]+/\1[REDACTED]/Ig'
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null && protect_windows_path "$tmp" file && mv "$tmp" "$path" && protect_windows_path "$path" file || { rm -f "$tmp"; return 1; }
  FAILURE_REPORT="$path"; printf '%s' "$path"
}

stop_provider_tree(){ # TIMEOUT_PID
  local pid="$1" i
  [ -n "$pid" ] || return 0
  # GNU timeout owns a separate process group unless --foreground is used.
  # Signal that whole group so the CLI and any subprocess it is currently
  # waiting on cannot survive an interrupted wrapper.
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  for i in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep .1; done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
}

interrupt_review(){
  trap - HUP INT TERM
  stop_provider_tree "$PROVIDER_PID"
  PROVIDER_PID=""
  local elapsed=$(( $(date +%s) - STARTED )) report=""
  report="$(preserve_failure_diagnostic interrupted || true)"
  if [ -n "$STATE" ] && [ -f "$STATE" ] && [ "$(jq -r '.status // ""' "$STATE" 2>/dev/null || true)" = running ]; then
    if [ -n "$report" ]; then "$LIFECYCLE" fail --state "$STATE" --elapsed "$elapsed" --failure interrupted --report "$report" >/dev/null 2>&1 || true
    else "$LIFECYCLE" fail --state "$STATE" --elapsed "$elapsed" --failure interrupted >/dev/null 2>&1 || true; fi
  fi
  exit 130
}
trap interrupt_review HUP INT TERM

STATE="$($LIFECYCLE begin --provider codex --repo "$REPO_ROOT" --run-id "$RUN_ID" --caller "$CALLER" --preflight standard)" \
  || die 'provider preflight failed; no review was assigned.'
REVIEW_DIR="$($SANDBOX ensure-copy "$REPO_ROOT" "$TAG")" \
  || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure snapshot-failed >/dev/null 2>&1 || true; die 'could not create the review snapshot.'; }

case "$MODE" in
  plan-review) DECISION='Judge the implementation plan for missing cases, unsafe assumptions, forgotten files, and test gaps.';;
  diff-review) DECISION='Judge the complete change for correctness, regressions, data exposure, and missing tests.';;
  security-review) DECISION='Judge only security risks: authorization, data leakage, injection, secrets, file boundaries, and permissions.';;
  visual-review) DECISION='Judge UI/visual test impact, responsiveness, accessibility, and missing visual proof.';;
  final-check) DECISION='Give the final go/no-go judgment for shipping this exact source state.';;
esac
if [ -n "${AI_REVIEW_BRIEF_FILE:-}" ]; then
  [ -f "$AI_REVIEW_BRIEF_FILE" ] && [ ! -L "$AI_REVIEW_BRIEF_FILE" ] || die 'AI_REVIEW_BRIEF_FILE is not a regular file.'
  DECISION="$DECISION

Follow this exact stage brief and treat its named prior artifact as the input contract:

$(cat "$AI_REVIEW_BRIEF_FILE")"
fi
PACKET_ARGS=(build "$REVIEW_DIR" "$TAG" --decision "$DECISION" --class medium)
[ -z "$TESTS_COMMAND" ] || PACKET_ARGS+=(--tests "$TESTS_COMMAND")
PACKET_DIR="$($PACKET "${PACKET_ARGS[@]}")" \
  || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$(( $(date +%s)-STARTED ))" --failure packet-failed >/dev/null 2>&1 || true; die 'could not build exact review evidence.'; }
"$PACKET" verify "$PACKET_DIR" >/dev/null \
  || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$(( $(date +%s)-STARTED ))" --failure packet-invalid >/dev/null 2>&1 || true; die 'review evidence failed verification.'; }

PROMPT="You are performing a READ-ONLY $MODE. Do not edit, create, commit, push, merge, or delete files.

Read $PACKET_DIR/MANIFEST.md first. It binds the exact whole-source digest and
change evidence. You may read any file under $REVIEW_DIR to verify the change,
including every untracked file listed by the manifest.

$DECISION

Return findings with file and line evidence. End with a literal heading and one
allowed word exactly as follows:

## Verdict
APPROVE|REJECT|BLOCKED"

TMP_OUT="$(mktemp "$REPORT_DIR/.codex-output.XXXXXX")"
TMP_ERR="$(mktemp "$REPORT_DIR/.codex-error.XXXXXX")"
chmod 600 "$TMP_OUT" "$TMP_ERR" 2>/dev/null || die 'could not protect temporary provider output.'
set +e
# A sealed repository review needs Codex authentication, but no user-configured
# MCP servers. Loading them adds unrelated network capabilities and can expose
# secret-bearing launcher arguments through terminal-title control sequences.
printf '%s\n' "$PROMPT" | timeout "$REVIEW_TIMEOUT" "${CODEX_ARGS[@]}" --ignore-user-config --cd "$REVIEW_DIR" - > "$TMP_OUT" 2> "$TMP_ERR" & PROVIDER_PID=$!
wait "$PROVIDER_PID"; PROVIDER_RC=$?; PROVIDER_PID=""
set -e
ELAPSED="$(( $(date +%s)-STARTED ))"

if [ "$PROVIDER_RC" -ne 0 ]; then
  FAILURE_REPORT="$(preserve_failure_diagnostic provider-failed || true)"
  if [ -n "$FAILURE_REPORT" ]; then "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure provider-failed --report "$FAILURE_REPORT" >/dev/null 2>&1 || true
  else "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure provider-failed >/dev/null 2>&1 || true; fi
  die "Codex exited nonzero ($PROVIDER_RC); no successful report was published. Diagnostic: ${FAILURE_REPORT:-unavailable}"
fi
EXPECTED_DIGEST="$(sed -n 's/^source_digest=//p' "$REVIEW_DIR/.ai-review-sandbox")"
ACTUAL_DIGEST="$($SANDBOX digest "$REVIEW_DIR")" \
  || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure snapshot-unreadable >/dev/null 2>&1 || true; die 'could not verify the review snapshot after Codex returned.'; }
[ -n "$EXPECTED_DIGEST" ] && [ "$EXPECTED_DIGEST" = "$ACTUAL_DIGEST" ] \
  || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure reviewer-write-detected >/dev/null 2>&1 || true; die 'Codex changed its read-only snapshot; response rejected.'; }
[ -s "$TMP_OUT" ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure empty-response >/dev/null 2>&1 || true; die 'Codex returned an empty response.'; }
FINAL_TWO="$(tr -d '\r' < "$TMP_OUT" | sed '/^[[:space:]]*$/d' | tail -n 2)"; HEADING_COUNT="$(grep -c '^## Verdict\r\{0,1\}$' "$TMP_OUT" || true)"
case "$FINAL_TWO" in $'## Verdict\nAPPROVE') VERDICT=APPROVE;; $'## Verdict\nREJECT') VERDICT=REJECT;; $'## Verdict\nBLOCKED') VERDICT=BLOCKED;; *) "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure missing-verdict >/dev/null 2>&1 || true; die 'Codex verdict must be the one final two-line section.';; esac
[ "$HEADING_COUNT" -eq 1 ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure missing-verdict >/dev/null 2>&1 || true; die 'Codex returned multiple verdict sections.'; }

TMP_REPORT="$(mktemp "$REPORT_DIR/.codex-report.XXXXXX")"
chmod 600 "$TMP_REPORT" 2>/dev/null || die 'could not protect temporary report output.'
{
  printf '# Codex review — %s\n\n' "$MODE"
  printf '| field | value |\n|---|---|\n'
  printf '| repository | `%s` |\n| reviewed commit | `%s` |\n| source digest | `%s` |\n' "$REPO_ROOT" "$(jq -r .head "$STATE")" "$(jq -r .source_digest "$STATE")"
  printf '| run | `%s` |\n| caller | `%s` |\n| elapsed seconds | `%s` |\n| sandbox | `read-only` |\n\n' "$RUN_ID" "$CALLER" "$ELAPSED"
  printf '## Result\n\n'; cat "$TMP_OUT"
} > "$TMP_REPORT"
[ -s "$TMP_REPORT" ] || die 'report assembly produced an empty file.'
mv "$TMP_REPORT" "$OUT"; TMP_REPORT=""
chmod 600 "$OUT" 2>/dev/null || die 'could not protect the completed report.'
protect_windows_path "$OUT" file || die 'could not enforce the completed report Windows ACL.'

FINAL_STATE=""
if ! FINAL_STATE="$($LIFECYCLE finish --state "$STATE" --verdict "$VERDICT" --report "$OUT" --elapsed "$ELAPSED")"; then
  mv "$OUT" "$OUT.accounting-failed" 2>/dev/null || true
  die 'review result exists, but lifecycle accounting failed; it is not an accepted report.'
fi
[ "$(jq -r .stale <<<"$FINAL_STATE")" = false ] && [ "$(jq -r .verdict <<<"$FINAL_STATE")" = "$VERDICT" ] \
  || { mv "$OUT" "$OUT.stale" 2>/dev/null || true; die 'source changed during review; the report was blocked as stale.'; }

printf '%s\n' "$OUT"
