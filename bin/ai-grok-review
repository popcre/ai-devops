#!/usr/bin/env bash
# ai-grok-review — read-only Grok reviews in persistent, named sessions.
#
# This is the ONLY supported way for Claude or Codex to talk to Grok. Never call
# `grok --single`, `grok -p`, or `grok --resume` directly: this script owns the
# model pin, the permission set, the turn bound, the completion rule, and the
# session bookkeeping, and every one of those exists because getting it wrong
# cost real money on 2026-08-05 (~1.9M tokens, ~$1.28, two runs that returned
# nothing). See plan_ai-grok-review.md and skills/shared/grok-cli/SKILL.md.
#
#   ai-grok-review new <name> [--prompt T | --prompt-file F | stdin] [--max-turns N]
#   ai-grok-review ask <name> [--prompt T | --prompt-file F | stdin] [--max-turns N]
#   ai-grok-review list | show <name> | transcript <name> | delete <name>
#   ai-grok-review doctor [--live]
#
# Model, permission set, --no-memory and --cwd are fixed when a session is
# created and are deliberately NOT overridable per call: a stable request prefix
# is what makes prompt caching work, and a fixed permission set is what keeps a
# review read-only. --max-turns IS overridable per call: it is a runtime bound,
# not part of the cached prefix, and turn-limit recovery depends on raising it.
#
# ---------------------------------------------------------------------------
# STEP 0 VERIFICATION — captured 2026-08-05 against Grok 0.2.118 (1e1687c1cf)
# on hetz/Ubuntu as user `ai`. Re-run and update this block on any version bump.
#
#   Flags confirmed present in `grok --help`:
#     --cwd, --model, -p/--single, --prompt-file, -r/--resume, --max-turns,
#     --permission-mode, --allow, --deny, --tools, --disallowed-tools,
#     --disable-web-search, --no-memory, --output-format, --sandbox
#   --resume + -p COMPOSE: verified. Turn 2 of session
#     019fd4e9-28d9-77c3-81f7-9fc9ca72fa7a returned the same sessionId, answered
#     from turn 1's context, and reported cache_read_input_tokens=23168.
#   --output-format json emits ONE JSON object (`jq -s length` == 1), NOT NDJSON.
#     The NDJSON formats are the separately-named streaming-json and
#     streaming-messages-json. So a plain `jq .stopReason` is correct here.
#   Result keys observed:
#     text, thought, sessionId, stopReason, num_turns, requestId, usage,
#     modelUsage, total_cost_usd, total_cost_usd_ticks
#     There is NO top-level `model` field; the real model id is the modelUsage
#     key (`grok-4.5-build` for `--model grok-4.5`).
#   Success stopReason observed: "end_turn" on 2026-08-05 and "EndTurn" on
#     2026-08-10. Both are terminal success spellings from Grok 0.2.118.
#   `grok doctor` is a TERMINAL diagnostic ("Check terminal, clipboard, color,
#     and input support") — it is not an auth check at all. This is the whole
#     explanation for the 2026-08-05 "not authenticated" contradiction.
#   `grok export` exists and exports a session transcript as Markdown, so
#     `transcript` is implementable after all (the plan had dropped it).
#   `--prompt-file` exists, so a large brief never goes through argv/ARG_MAX.
#   Re-verified 2026-08-22 on Windows against Grok 1.0.5 (5115b46bc9):
#     `inspect --json`, `--no-subagents`, `--disallowed-tools`, `--deny`,
#     `GROK_HOME`, and every GROK_CLAUDE_*/GROK_CURSOR_* compatibility cell
#     used below are accepted. The live isolated doctor returned terminal JSON.
#   Re-qualified 2026-09-03 on Windows against Grok Build 1.0.13 (issue #251):
#     the full flag surface used below (`--cwd`, `--model`, `-p/--single`,
#     `--prompt-file`, `-r/--resume`, `--max-turns`, `--permission-mode`,
#     `--allow`, `--deny`, `--disallowed-tools`, `--no-subagents`,
#     `--disable-web-search`, `--no-memory`, `--output-format json`) and the
#     `inspect`, `models`, `export`, `sessions` and `update` subcommands are
#     still present and unchanged in meaning. `grok update --version <X>` is the
#     documented exact-version install path and is what the installers use.
#     1.0.6-1.0.13 add vendor-side reliability (transient inference retries,
#     length-truncation continuation, durable session saves, corrected server
#     usage/context accounting, Windows home/worktree fixes, faster MCP and
#     subagent startup). NONE of it replaces a control here: a provider retry is
#     not proof of remote cancellation, of owned local process completion, of
#     read-only scope, or of correct billing. The supported version is now a
#     repository fact in config/provider-cli-versions.json and is enforced
#     BEFORE any paid turn, so an unqualified build cannot spend money against a
#     contract nobody verified. The 1.0.11 headless permission startup hint and
#     `--always-approve` / `--permission-mode auto` are deliberately NOT used:
#     the frozen explicit allow/deny profile below already prevents prompts, and
#     convenience is never a reason to widen reviewer authority.
#   NOTE: the early-return bug did NOT reproduce on a small 33s prompt — the
#     file was complete when the command returned. The wait loop is harmless
#     when the bug is absent (first poll succeeds) and load-bearing when it is
#     present, which is exactly why completion is proven from the JSON.
# ---------------------------------------------------------------------------

set -euo pipefail

VERSION="1.1.0"

STATE_DIR="${AI_GROK_STATE_DIR:-$HOME/.local/state/ai-devops/grok}"
CALLER="${AI_GROK_CALLER:-claude}"

# Frozen review prefix. Changing any of this mid-workstream throws away the
# provider cache; broadening it turns a read-only review into something else.
# --disable-web-search closes a real scope leak: under --allow Read alone, Grok
# has been observed using web_fetch during a purely local repository review.
GROK_MODEL="${AI_GROK_MODEL:-grok-4.6}"
GROK_PERMS=(--permission-mode default --allow Read --allow Grep
            --deny Edit --deny Bash --deny 'MCPTool(*)'
            --disallowed-tools search_tool,use_tool,Agent --no-subagents
            --disable-web-search --no-memory)
# Grok otherwise imports Claude/Cursor extensions from the operator's home.
# Those MCP servers and hooks can start processes before the model turn even
# though the review's tool allowlist is read-only. Keep reviewer launches
# isolated without changing the operator's normal interactive Grok settings.
GROK_ISOLATION_ENV=(
  GROK_CLAUDE_SKILLS_ENABLED=false GROK_CLAUDE_RULES_ENABLED=false
  GROK_CLAUDE_AGENTS_ENABLED=false GROK_CLAUDE_MCPS_ENABLED=false
  GROK_CLAUDE_HOOKS_ENABLED=false GROK_CLAUDE_SESSIONS_ENABLED=false
  GROK_CURSOR_SKILLS_ENABLED=false GROK_CURSOR_RULES_ENABLED=false
  GROK_CURSOR_AGENTS_ENABLED=false GROK_CURSOR_MCPS_ENABLED=false
  GROK_CURSOR_HOOKS_ENABLED=false GROK_CURSOR_SESSIONS_ENABLED=false
  GROK_CODEX_SESSIONS_ENABLED=false
)

DEFAULT_MAX_TURNS="${AI_GROK_MAX_TURNS:-20}"
WAIT_TIMEOUT="${AI_GROK_WAIT_TIMEOUT:-900}"
ISOLATION_TIMEOUT="${AI_GROK_ISOLATION_TIMEOUT:-30}"
POLL_INTERVAL="${AI_GROK_POLL_INTERVAL:-5}"
HEARTBEAT_INTERVAL="${AI_GROK_HEARTBEAT_INTERVAL:-60}"
RUN_TURN_RC=0
ACTIVE_GROK_CHILD=''
ACTIVE_GROK_STOP_DIR=''
ACTIVE_GROK_STOP_FILE=''
ACTIVE_GROK_NATIVE_STOP_FILE=''
ACTIVE_ISOLATED_CWD=''
ACTIVE_ISOLATED_HOME=''
ACTIVE_PAID_LOCK=''
ACTIVE_SESSION_LOCK=''
ACTIVE_TURN_RECORD=''
PENDING_REVIEW_BASE=''
PENDING_REVIEW_DIR=''
PROMPT_BODY_DIGEST=''

die()  { printf 'ai-grok-review: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-grok-review: warning: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }

# ---------------------------------------------------------------------------
# Grok binary resolution.
#
# Do NOT rely on PATH. On hetz, grok lives at /home/ai/.local/bin/grok, which is
# not on root's PATH — and the toolkit is installed for both users. A bare
# `command -v grok` failure there reads as "broken install" when the binary is
# present and fine.
# ---------------------------------------------------------------------------
resolve_grok() {
  if [ -n "${AI_GROK_BIN:-}" ]; then
    [ -x "$AI_GROK_BIN" ] || die "local_dependency_unavailable: AI_GROK_BIN=$AI_GROK_BIN is not executable. This is not a Grok provider fault."
    printf '%s' "$AI_GROK_BIN"; return 0
  fi
  local c
  for c in "$(command -v grok 2>/dev/null || true)" \
           "$HOME/.local/bin/grok" \
           "$HOME/.grok/bin/grok" \
           "$HOME/.grok/bin/grok.exe" \
           /home/ai/.local/bin/grok \
           /usr/local/bin/grok; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  die "local_dependency_unavailable: grok binary not found. This is not a Grok provider fault. Set AI_GROK_BIN, or install Grok. Looked on PATH, \$HOME/.local/bin, \$HOME/.grok/bin, /home/ai/.local/bin, /usr/local/bin."
}

# ---------------------------------------------------------------------------
# Exact supported Grok version. One source of truth: config/provider-cli-versions.json.
#
# Presence-based checks are what let a machine sit on an unqualified build while
# this wrapper claimed a contract verified against a different one (issue #251).
# Everything below — the single terminal JSON object, the accepted stop reasons,
# the modelUsage-keyed model identity, the usage/cost fields, session resume —
# is qualified against exactly one build, so an off-policy build fails BEFORE a
# paid turn rather than producing results nobody qualified.
# ---------------------------------------------------------------------------
version_tool() {
  local self real dir
  self="${BASH_SOURCE[0]}"
  real="$(readlink -f "$self" 2>/dev/null || true)"
  [ -n "$real" ] && self="$real"
  dir="$(cd "$(dirname "$self")" && pwd)"
  if [ -x "$dir/ai-provider-version" ]; then printf '%s' "$dir/ai-provider-version"; return 0; fi
  command -v ai-provider-version 2>/dev/null || true
}

supported_grok_version() {
  local tool; tool="$(version_tool)"
  [ -n "$tool" ] && [ -x "$tool" ]     || die 'ai-provider-version is missing; refusing paid work without the exact supported Grok version.'
  "$tool" required grok
}

installed_grok_version() { # installed_grok_version BINARY
  local tool raw; tool="$(version_tool)"
  raw="$("$1" --version 2>/dev/null | head -1 || true)"
  [ -n "$raw" ] || { printf ''; return 0; }
  "$tool" parse "$raw"
}

require_supported_grok_version() { # require_supported_grok_version BINARY
  local want have; want="$(supported_grok_version)"
  [ -n "$want" ] || die 'the provider version policy pins no Grok version; refusing paid work against an unqualified build.'
  have="$(installed_grok_version "$1")"
  [ -n "$have" ] || die "could not read a version from the Grok binary ($1); refusing paid work against an unidentified build."
  [ "$have" = "$want" ] && return 0
  die "unqualified Grok version: installed $have, this repository qualifies exactly $want. Run the provider installer (or 'grok update --version $want') before paid reviewer work. Refusing to spend money against a contract nobody verified."
}

# Process diagnostics only — NEVER a completion signal.
#
# `pgrep -af grok` matches any command line containing "grok", including this
# script and its parent shell, so it self-matches and is useless unmodified.
# Match the process NAME, and fall back to Git Bash's `ps -W` on Windows where
# pgrep does not exist.
grok_procs() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x grok 2>/dev/null || pgrep -f '[g]rok-[0-9]' 2>/dev/null || true
  else
    ps -W 2>/dev/null | grep -i '[g]rok' || true
  fi
}

# ---------------------------------------------------------------------------
# Repository + session identity. Keyed by repo + caller + name so Claude and
# Codex can use the same short name in one repo without colliding.
# ---------------------------------------------------------------------------
repo_root() {
  git rev-parse --show-toplevel 2>/dev/null \
    || die "ai-grok-review must be run inside a git repository."
}


# --- review boundary ----------------------------------------------------------
# A delegated reviewer gets exactly ONE directory. In a linked worktree the
# repository's control files live outside it, so the reviewer is refused on its
# first git-adjacent read and the run dies before any code is read.
# ai-review-sandbox gives every review a private snapshot, including ordinary
# clones, so the live checkout cannot move underneath a running session.
SANDBOX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-sandbox"
[ -x "$SANDBOX_BIN" ] || SANDBOX_BIN="$(command -v ai-review-sandbox 2>/dev/null || true)"
review_boundary() { # review_boundary ROOT TAG -> directory to hand the reviewer
  [ -n "$SANDBOX_BIN" ] || die "ai-review-sandbox is missing; install the toolkit's bin/ on PATH."
  "$SANDBOX_BIN" ensure-copy "$1" "$2" || die "could not prepare a private review snapshot for $1"
}
release_boundary() { # release_boundary ROOT TAG
  [ -n "$SANDBOX_BIN" ] || return 0
  "$SANDBOX_BIN" remove-copy "$1" "$2" || true
}

# --- evidence packet ----------------------------------------------------------
# Grok reviews run with --deny Bash, so Grok cannot run `git diff` and cannot
# work out what changed. Left to itself it reconstructs the comparison by
# reading and grepping: 20 turns, ~3M tokens, no verdict (2026-08-16/17).
# ai-review-packet writes those shell-derived facts into .ai-review/ inside the
# review directory. The packet is ADDITIVE — Read and Grep over the whole
# directory are unchanged, and the manifest says so explicitly.
PACKET_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-packet"
[ -x "$PACKET_BIN" ] || PACKET_BIN="$(command -v ai-review-packet 2>/dev/null || true)"

# The packet directory is named after this session's tag (shared-db#1296), so
# the preamble must name the directory that was actually built, not a fixed one.
PACKET_REL=".ai-review"
REVIEW_DIR=""; REVIEW_BASE=""; REVIEW_HEAD=""; PACKET_HASH=""
# Sets the globals above. Never call it in a command substitution — the identity
# would be computed in a subshell and lost, which is the whole failure this
# replaces (agents hand-expanding short SHAs into wrong full ones).
prepare_review() { # prepare_review ROOT TAG [RECORDED_BOUNDARY]
  local root="$1" tag="$2" recorded="${3:-}" pkt refreshed
  if [ -z "$recorded" ]; then
    REVIEW_DIR="$(review_boundary "$root" "$tag")"
  elif [ "$(cd "$recorded" 2>/dev/null && pwd -P || printf '%s' "$recorded")" = "$(cd "$root" && pwd -P)" ]; then
    REVIEW_DIR="$recorded"
  else
    refreshed="$(review_boundary "$root" "$tag")"
    [ "$(cd "$refreshed" && pwd -P)" = "$(cd "$recorded" && pwd -P)" ] || \
      die "session '${tag#grok-}' is bound to $recorded but its private snapshot now resolves to $refreshed. Refusing to split one conversation across two directories."
    REVIEW_DIR="$recorded"
  fi

  # Identity comes from Git, in this wrapper, always. A caller-supplied SHA is
  # only ever an assertion to CHECK (--assert-head), never a source of truth.
  REVIEW_HEAD="$(git -C "$REVIEW_DIR" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$REVIEW_HEAD" ] || die "could not read HEAD in $REVIEW_DIR; refusing to review a directory with no commit identity."
  if [ -n "${OPT_ASSERT_HEAD:-}" ]; then
    local want; want="$(git -C "$REVIEW_DIR" rev-parse --verify --quiet "${OPT_ASSERT_HEAD}^{commit}" || true)"
    [ "$want" = "$REVIEW_HEAD" ] || die "--assert-head does not match this repository.
  you said : $OPT_ASSERT_HEAD
  actual   : $REVIEW_HEAD
A verdict recorded against the wrong commit is worthless evidence. Nothing was
reviewed. Re-read the SHA from git rather than transcribing it."
  fi

  [ -n "$PACKET_BIN" ] || die "ai-review-packet is missing; install the toolkit's bin/ on PATH. A review without an evidence packet burns its whole budget rediscovering the diff."
  pkt="$("$PACKET_BIN" build "$REVIEW_DIR" "$tag" --class small \
           ${OPT_BASE:+--base "$OPT_BASE"} \
           ${OPT_TESTS:+--tests "$OPT_TESTS"} \
           ${OPT_DECISION:+--decision "$OPT_DECISION"})" \
    || die "could not build the review evidence packet for $REVIEW_DIR"
  REVIEW_BASE="$(sed -n 's/^| \*\*base\*\* | `\([0-9a-f]\{40\}\)`.*/\1/p' "$pkt/MANIFEST.md" | head -1)"
  PACKET_REL="$(basename "$pkt")"
  PACKET_HASH="$(cat "$pkt/MANIFEST.sha256")"
  note "  evidence packet: $pkt (base ${REVIEW_BASE:0:12}, head ${REVIEW_HEAD:0:12}, sha ${PACKET_HASH:0:12})"
}

PACKET_PREAMBLE="Your evidence packet is at .ai-review/MANIFEST.md in this directory. Read it
first. It contains the exact commits under review, the changed files, the full
patch, and what you are being asked to decide.

You may read any other file in this directory to confirm a finding — the packet
is your starting point, not a boundary. What you must NOT do is spend turns
reconstructing the diff yourself; it is already in .ai-review/patch.diff.

---

"

legacy_repo_id() { printf '%s' "$1" | tr '\\' '/' | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
repo_id() {
  local root="$1" remote
  root="$(cd "$root" && pwd -P)"
  remote="$(git -C "$root" config --get remote.origin.url 2>/dev/null || echo '')"
  printf '%s' "$(printf '%s\n%s' "$root" "$remote" | sha256sum | cut -c1-12)"
}
repo_remote() { git -C "$1" config --get remote.origin.url 2>/dev/null || true; }

# The checkout-bound repo_id above deliberately remains the session identity.
# Paid work needs a second identity shared by every clone of one upstream.
normalize_remote() { # normalize_remote REMOTE -> canonical network identity
  local remote="$1" host path
  remote="${remote%/}"
  case "$remote" in
    git@*:* ) host="${remote#git@}"; host="${host%%:*}"; path="${remote#*:}" ;;
    ssh://*|https://*|http://*|git://*)
      host="${remote#*://}"; host="${host#*@}"; path="${host#*/}"; host="${host%%/*}"; host="${host%:22}"; host="${host%:443}" ;;
    *) return 1 ;;
  esac
  host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  path="${path#/}"; path="${path%/}"; path="${path%.git}"
  [ -n "$host" ] && [ -n "$path" ] || return 1
  case "$host/$path" in *$'\n'*|*$'\r'*) return 1 ;; esac
  printf '%s/%s' "$host" "$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')"
}

upstream_identity() { # upstream_identity ROOT [DEPTH] [VISITED]
  local root="$1" depth="${2:-0}" visited="${3:-}" remote target physical
  [ "$depth" -lt 5 ] || return 1
  physical="$(cd "$root" 2>/dev/null && pwd -P)" || return 1
  case "|$visited|" in *"|$physical|"*) return 1 ;; esac
  remote="$(repo_remote "$physical")"; [ -n "$remote" ] || return 1
  if normalize_remote "$remote"; then return 0; fi
  case "$remote" in
    /*|[A-Za-z]:[\\/]*|.*) target="$remote" ;;
    *) target="$physical/$remote" ;;
  esac
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 || return 1
  upstream_identity "$target" $((depth + 1)) "$visited|$physical"
}

review_lock_id() { printf '%s' "$1" | sha256sum | cut -c1-16; }
require_upstream_identity() {
  local identity
  identity="$(upstream_identity "$1")" || die "cannot identify this repository's shared upstream. Set origin to an unambiguous network repository; no paid Grok call was started."
  printf '%s' "$identity"
}

valid_name() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

meta_path() { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }

# Checkout-local legacy session lock path (read compatibility only).
lock_path()      { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }
# Legacy repository-wide paid-work lock path (read compatibility only).
repolock_path()  { printf '%s/locks/repo--%s.lock.d' "$STATE_DIR" "$1"; }
# Current locks deliberately separate mutable session ownership from exact-work
# idempotency. Both identities retain normalized upstream equivalence across
# clones; neither serializes unrelated work in one repository.
session_lock_path() { # session_lock_path UPSTREAM CALLER NAME
  local id; id="$(printf 'grok\n%s\n%s\n%s' "$1" "$2" "$3" | sha256sum | cut -c1-24)"
  printf '%s/locks/session--%s.lock.d' "$STATE_DIR" "$id"
}
session_record_path() { # durable logical-name collision guard
  local id; id="$(printf 'grok\n%s\n%s\n%s' "$1" "$2" "$3" | sha256sum | cut -c1-24)"
  printf '%s/session-records/%s' "$STATE_DIR" "$id"
}
turn_record_path() { # durable next-turn collision guard, independent of prompt digest
  local id; id="$(printf 'grok\n%s\n%s\n%s\n%s' "$1" "$2" "$3" "$4" | sha256sum | cut -c1-28)"
  printf '%s/turn-records/%s' "$STATE_DIR" "$id"
}
work_lock_path() { printf '%s/locks/work--%s.lock.d' "$STATE_DIR" "$1"; }
work_identity() { # immutable exact provider-call contract; never stores prompt text
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s' "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" | sha256sum | cut -c1-32
}

legacy_paid_lock_guard() { # legacy_paid_lock_guard UPSTREAM CALLER SESSION
  local wanted_upstream="$1" wanted_caller="$2" wanted_session="$3" lock schema upstream caller session
  for lock in "$STATE_DIR"/locks/repo--*.lock.d; do
    [ -d "$lock" ] || continue
    schema="$(cat "$lock/schema" 2>/dev/null || true)"
    upstream="$(cat "$lock/upstream" 2>/dev/null || true)"
    caller="$(cat "$lock/caller" 2>/dev/null || true)"
    session="$(cat "$lock/session" 2>/dev/null || true)"
    if [ "$schema" = 2 ] && [ -n "$upstream" ] && [ -n "$caller" ] && [ -n "$session" ]; then
      if [ "$upstream" = "$wanted_upstream" ] && [ "$caller" = "$wanted_caller" ] && [ "$session" = "$wanted_session" ]; then
        warn "legacy Grok protection for this exact session is retained: $(basename "$lock"). Reconcile that session before retrying it."
        return 1
      fi
      continue
    fi
    warn "an ambiguous legacy Grok paid-work lock is present: $(basename "$lock"). Its exact session/job cannot be proved safely, so paid work remains fail-closed until operator reconciliation."
    return 1
  done
  return 0
}

# Portable mutex: `flock` does not exist in Git Bash, so this is an atomic mkdir
# plus a pid file. A dead repository-lock owner does not prove the paid remote
# turn stopped, so that lock is retained for manual reconciliation. Session
# locks remain separately scoped and can be released by their owning wrapper.
lock_acquire() { # lock_acquire DIR LABEL [UPSTREAM] [SESSION] [SOURCE] [WORK_ID] [PROMPT_DIGEST] [SOURCE_ID] [TURN]
  local dir="$1" label="$2" upstream="${3:-}" session="${4:-}" source="${5:-}" work_id="${6:-}" prompt_digest="${7:-}" source_id="${8:-}" turn="${9:-}" owner quarantine moved_owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"
    printf '%s\n' "$label" > "$dir/label"
    [ -z "$upstream" ] || {
      printf '3\n' > "$dir/schema"
      printf '%s\n' "$upstream" > "$dir/upstream"
      printf '%s\n' "$CALLER" > "$dir/caller"
      printf '%s\n' "$session" > "$dir/session"
      printf '%s\n' "$source" > "$dir/source"
      date -u +%FT%TZ > "$dir/started"
      [ -z "$work_id" ] || printf '%s\n' "$work_id" > "$dir/work_id"
      [ -z "$prompt_digest" ] || printf '%s\n' "$prompt_digest" > "$dir/prompt_digest"
      [ -z "$source_id" ] || printf '%s\n' "$source_id" > "$dir/source_identity"
      [ -z "$turn" ] || printf '%s\n' "$turn" > "$dir/turn"
    }
    return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || echo '')"
  if [ -f "$dir/remote-uncertain" ]; then
    warn "an interrupted Grok turn has unconfirmed provider state; paid work remains blocked. Inspect $(basename "$dir") before reconciling it manually."
    return 1
  fi
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
    return 1
  fi
  if [ -z "$owner" ] || ! [[ "$owner" =~ ^[0-9]+$ ]]; then
    warn "malformed lock $(basename "$dir") blocks paid work; inspect it manually."
    return 1
  fi
  case "$(basename "$dir")" in
    work--*.lock.d)
      if [ ! -f "$dir/provider-contacted" ]; then
        quarantine="$dir.abandoned.$$.$RANDOM"
        mv "$dir" "$quarantine" 2>/dev/null || return 1
        moved_owner="$(cat "$quarantine/pid" 2>/dev/null || true)"
        if [ "$moved_owner" != "$owner" ] || kill -0 "$moved_owner" 2>/dev/null; then
          [ -e "$dir" ] || mv "$quarantine" "$dir" 2>/dev/null || true
          warn "exact-work lock ownership changed during pre-provider recovery: $(basename "$dir")"
          return 1
        fi
        rm -rf -- "$quarantine"
        warn "reclaimed a genuinely abandoned exact-work lock that never contacted Grok"
        lock_acquire "$@"
        return $?
      fi ;;
  esac
  warn "the local owner of $(basename "$dir") is gone, but remote completion is unconfirmed; paid work remains blocked pending manual reconciliation."
  date -u +%FT%TZ > "$dir/remote-uncertain"
  return 1
}

logical_session_meta() { # logical_session_meta UPSTREAM CALLER NAME
  local wanted_upstream="$1" wanted_caller="$2" wanted_name="$3" f remote identity
  for f in "$STATE_DIR"/sessions/*/*.json; do
    [ -f "$f" ] || continue
    [ "$(jq -r '.caller // empty' "$f" 2>/dev/null)" = "$wanted_caller" ] || continue
    [ "$(jq -r '.name // empty' "$f" 2>/dev/null)" = "$wanted_name" ] || continue
    remote="$(jq -r '.repo_remote // empty' "$f" 2>/dev/null)"
    identity="$(normalize_remote "$remote" 2>/dev/null || true)"
    [ "$identity" = "$wanted_upstream" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

reserve_new_session() { # reserve_new_session UPSTREAM NAME CONTRACT SOURCE PROMPT_DIGEST
  local upstream="$1" name="$2" contract="$3" source_id="$4" prompt_digest="$5" dir existing pending
  dir="$(session_record_path "$upstream" "$CALLER" "$name")"; mkdir -p "$(dirname "$dir")"
  if [ ! -d "$dir" ]; then
    pending="$dir.pending.$$.$RANDOM"; mkdir "$pending" || return 1
    if ! { printf '1\n' > "$pending/schema" \
      && printf '%s\n' "$upstream" > "$pending/upstream" \
      && printf '%s\n' "$CALLER" > "$pending/caller" \
      && printf '%s\n' "$name" > "$pending/session" \
      && printf '%s\n' "$contract" > "$pending/contract" \
      && [ "${AI_GROK_TEST_RESERVATION_WRITE_FAILURE:-}" != session ] \
      && printf '%s\n' "$source_id" > "$pending/source_identity" \
      && printf '%s\n' "$prompt_digest" > "$pending/prompt_digest" \
      && date -u +%FT%TZ > "$pending/created"; }; then
      rm -rf -- "$pending"; return 1
    fi
    mv "$pending" "$dir" 2>/dev/null || { rm -rf -- "$pending"; return 1; }
    return 0
  fi
  existing="$(cat "$dir/contract" 2>/dev/null || true)"
  [ "$existing" = "$contract" ] && return 0
  warn "session-name collision: '$name' is already reserved for a materially different new-review contract. Choose a different name; the existing conversation is not changed."
  return 1
}

reserve_session_turn() { # reserve_session_turn UPSTREAM NAME TURN CONTRACT SOURCE PROMPT_DIGEST
  local upstream="$1" name="$2" turn="$3" contract="$4" source_id="$5" prompt_digest="$6" dir existing owner quarantine pending
  dir="$(turn_record_path "$upstream" "$CALLER" "$name" "$turn")"; mkdir -p "$(dirname "$dir")"
  if [ -d "$dir" ] && [ ! -f "$dir/provider-contacted" ]; then
    # The caller already owns the exact-session mutex. Therefore no legitimate
    # creator of this same turn can still be running. Quarantine the whole
    # no-contact record, including schema-1 crash-window records with no PID.
    quarantine="$dir.preprovider.$$.$RANDOM"
    mv "$dir" "$quarantine" 2>/dev/null || return 1
    if [ -f "$quarantine/provider-contacted" ]; then
      [ -e "$dir" ] || mv "$quarantine" "$dir" 2>/dev/null || true
      return 1
    fi
    rm -rf -- "$quarantine"
    warn "reclaimed a session-turn reservation that never contacted Grok"
  fi
  if [ ! -d "$dir" ]; then
    pending="$dir.pending.$$.$RANDOM"; mkdir "$pending" || return 1
    if ! { printf '1\n' > "$pending/schema" \
      && printf '%s\n' "$upstream" > "$pending/upstream" \
      && printf '%s\n' "$CALLER" > "$pending/caller" \
      && printf '%s\n' "$$" > "$pending/pid" \
      && printf '%s\n' "$name" > "$pending/session" \
      && printf '%s\n' "$turn" > "$pending/turn" \
      && printf '%s\n' "$contract" > "$pending/contract" \
      && [ "${AI_GROK_TEST_RESERVATION_WRITE_FAILURE:-}" != turn ] \
      && printf '%s\n' "$source_id" > "$pending/source_identity" \
      && printf '%s\n' "$prompt_digest" > "$pending/prompt_digest" \
      && date -u +%FT%TZ > "$pending/created"; }; then
      rm -rf -- "$pending"; return 1
    fi
    mv "$pending" "$dir" 2>/dev/null || { rm -rf -- "$pending"; return 1; }
    return 0
  fi
  existing="$(cat "$dir/contract" 2>/dev/null || true)"
  [ "$existing" = "$contract" ] && return 0
  warn "continuation-turn collision: session '$name' turn $turn is already reserved for materially different work. Its prior provider outcome may be unconfirmed; reconcile it before advancing this session."
  return 1
}
lock_release() { # only the creating wrapper may release it
  local dir="$1" owner
  [ -d "$dir" ] || return 0
  [ ! -f "$dir/remote-uncertain" ] || return 0
  owner="$(cat "$dir/pid" 2>/dev/null || true)"
  [ "$owner" = "$$" ] && rm -rf "$dir" 2>/dev/null || true
}
mark_remote_uncertain() { # retain paid-work lock after local interruption
  local dir="$1"
  [ -d "$dir" ] || return 0
  [ "$(cat "$dir/pid" 2>/dev/null || true)" = "$$" ] || return 0
  # Offline hostile test hook. Even if this write fails, callers disable normal
  # EXIT cleanup first, so the paid-work lock itself remains fail-closed.
  [ "${AI_GROK_TEST_MARK_FAILURE:-0}" != 1 ] || return 1
  date -u +%FT%TZ > "$dir/remote-uncertain"
}

preserve_uncertain_paid_turn() { # preserve lock before any fallible tree cleanup
  local rid_lock="$1" sess_lock="${2:-}"
  # Disable normal EXIT deletion first. If even the marker write fails, the
  # repository lock itself remains as the fail-closed paid-work barrier.
  trap - EXIT
  mark_remote_uncertain "$rid_lock" \
    || warn 'could not write the uncertainty marker; retaining the paid-work lock for manual reconciliation.'
  [ -z "$sess_lock" ] || lock_release "$sess_lock"
  stop_active_grok_tree \
    || warn 'could not confirm local reviewer-tree termination; paid work remains blocked for manual reconciliation.'
}

session_lock_acquire() { # local-only serialization; paid uncertainty is owned by the repository lock
  local dir="$1" label="$2" owner quarantine moved_owner
  mkdir -p "$(dirname "$dir")"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"; return 0
  fi
  owner="$(cat "$dir/pid" 2>/dev/null || true)"
  [[ "$owner" =~ ^[0-9]+$ ]] || { warn "malformed session lock $(basename "$dir") blocks this session."; return 1; }
  kill -0 "$owner" 2>/dev/null && return 1
  quarantine="$dir.stale.$$.$RANDOM"
  mv "$dir" "$quarantine" 2>/dev/null || return 1
  moved_owner="$(cat "$quarantine/pid" 2>/dev/null || true)"
  if [ "$moved_owner" != "$owner" ] || kill -0 "$moved_owner" 2>/dev/null; then
    [ -e "$dir" ] || mv "$quarantine" "$dir" 2>/dev/null || true
    warn "session lock ownership changed during recovery: $(basename "$dir")"
    return 1
  fi
  rm -rf -- "$quarantine"
  mkdir "$dir" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$dir/pid"; printf '%s\n' "$label" > "$dir/label"
  warn "reclaimed a stale local-only session lock from process $owner"
}

clear_active_stop_file() {
  [ -z "$ACTIVE_GROK_STOP_FILE" ] || rm -f -- "$ACTIVE_GROK_STOP_FILE" 2>/dev/null || true
  [ -z "$ACTIVE_GROK_STOP_DIR" ] || rmdir "$ACTIVE_GROK_STOP_DIR" 2>/dev/null || true
  ACTIVE_GROK_STOP_DIR=''
  ACTIVE_GROK_STOP_FILE=''
  ACTIVE_GROK_NATIVE_STOP_FILE=''
}

prepare_active_stop_file() {
  ACTIVE_GROK_STOP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ai-grok-review-stop.XXXXXX")" \
    || die 'could not reserve a process-supervisor stop directory.'
  chmod 700 "$ACTIVE_GROK_STOP_DIR" 2>/dev/null || true
  ACTIVE_GROK_STOP_FILE="$ACTIVE_GROK_STOP_DIR/stop"
  ACTIVE_GROK_NATIVE_STOP_FILE="$ACTIVE_GROK_STOP_FILE"
  if command -v cygpath >/dev/null 2>&1; then
    ACTIVE_GROK_NATIVE_STOP_FILE="$(cygpath -w "$ACTIVE_GROK_STOP_FILE" 2>/dev/null || true)"
  fi
  [ -n "$ACTIVE_GROK_NATIVE_STOP_FILE" ] || die 'could not translate the process-supervisor stop-file path.'
}

clear_active_grok() {
  clear_active_stop_file
  [ -z "$ACTIVE_ISOLATED_CWD" ] || rmdir "$ACTIVE_ISOLATED_CWD" 2>/dev/null || true
  if [ -n "$ACTIVE_ISOLATED_HOME" ]; then
    case "$ACTIVE_ISOLATED_HOME" in
      "$STATE_DIR"/runtime-home.*)
        [ -L "$ACTIVE_ISOLATED_HOME" ] || rm -rf -- "$ACTIVE_ISOLATED_HOME" 2>/dev/null || true
        ;;
      *) warn "refusing to remove unexpected isolated user-home path: $ACTIVE_ISOLATED_HOME" ;;
    esac
  fi
  ACTIVE_GROK_CHILD=''; ACTIVE_ISOLATED_CWD=''; ACTIVE_ISOLATED_HOME=''
}

request_active_grok_stop() {
  local child="$ACTIVE_GROK_CHILD" i
  [ -n "$child" ] && [ -n "$ACTIVE_GROK_STOP_FILE" ] || return 1
  printf 'stop\n' > "$ACTIVE_GROK_STOP_FILE" 2>/dev/null || return 1
  for i in 1 2 3 4 5; do kill -0 "$child" 2>/dev/null || break; sleep 1; done
  kill -0 "$child" 2>/dev/null && return 1
  wait "$child" 2>/dev/null || true
  ACTIVE_GROK_CHILD=''
  clear_active_grok
}

stop_active_grok_tree() {
  local child="$ACTIVE_GROK_CHILD" i windows_pid
  # A signal can land after the neutral profile is created but between the
  # inspection and paid children, or just after a child is reaped. Cleanup is
  # still required even when there is no PID left to terminate.
  [ -n "$child" ] || { clear_active_grok; return 0; }
  case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*|CYGWIN*)
      # Git Bash signals can target the native supervisor's console group and
      # kill this wrapper. Translate the MSYS PID before taskkill owns the
      # Windows tree fallback; never guess at a native PID.
      windows_pid="$(cat "/proc/$child/winpid" 2>/dev/null || true)"
      case "$windows_pid" in
        ''|*[!0-9]*) warn "could not resolve native Windows PID for reviewer child $child; leaving paid work blocked for reconciliation."; return 1 ;;
      esac
      if ! MSYS2_ARG_CONV_EXCL='*' taskkill.exe /PID "$windows_pid" /T /F >/dev/null 2>&1; then
        warn "native Windows tree termination failed for reviewer child $child; leaving paid work blocked for reconciliation."
        return 1
      fi
      for i in 1 2 3 4 5; do kill -0 "$child" 2>/dev/null || break; sleep 1; done
      if kill -0 "$child" 2>/dev/null; then
        warn "native Windows reviewer child $child did not exit after tree termination; leaving paid work blocked for reconciliation."
        return 1
      fi
      ;;
    *)
      kill -TERM "$child" 2>/dev/null || true
      for i in 1 2 3 4 5; do kill -0 "$child" 2>/dev/null || break; sleep 1; done
      kill -KILL "$child" 2>/dev/null || true
      ;;
  esac
  wait "$child" 2>/dev/null || true
  clear_active_grok
}

on_paid_signal() {
  # Same ordering contract as preserve_uncertain_paid_turn: EXIT cleanup is
  # disarmed first, then paid-work uncertainty is recorded, and only afterwards
  # is the fallible process-tree stop attempted. A local stop never proves the
  # provider stopped, so the marker must not depend on cleanup succeeding.
  trap - EXIT INT TERM
  [ -z "$ACTIVE_PAID_LOCK" ] || mark_remote_uncertain "$ACTIVE_PAID_LOCK" \
    || warn 'could not write the uncertainty marker; retaining the paid-work lock for manual reconciliation.'
  [ -z "$ACTIVE_SESSION_LOCK" ] || lock_release "$ACTIVE_SESSION_LOCK"
  if request_active_grok_stop || stop_active_grok_tree; then
    warn 'local wrapper stopped and its Grok process tree was terminated; provider cancellation is not confirmed and remote work may still run and bill. Paid work remains blocked pending manual reconciliation.'
  else
    warn 'local wrapper stopped but could not confirm termination of its Grok process tree; remote work may still run and bill. Paid work remains blocked pending manual reconciliation.'
    clear_active_stop_file
  fi
  exit 130
}

lock_info() { # lock_info DIR -> "label (pid, Ns ago)"
  local dir="$1" label pid age started now
  label="$(cat "$dir/label" 2>/dev/null || echo unknown)"
  pid="$(cat "$dir/pid" 2>/dev/null || echo '?')"
  if started="$(date -r "$dir" +%s 2>/dev/null)"; then
    now="$(date +%s)"; age=$((now - started))
    printf '%s (pid %s, running %ss)' "$label" "$pid" "$age"
  else
    printf '%s (pid %s)' "$label" "$pid"
  fi
}

write_meta() { # write_meta FILE JSON  (atomic: temp + mv on one filesystem)
  local f="$1" tmp
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f"
}

find_meta() {
  local f old repo remote cand found=""; f="$(meta_path "$1" "$2")"
  if [ ! -f "$f" ]; then
    repo="$(repo_root)"; old="$(meta_path "$(legacy_repo_id "$repo")" "$2")"
    if [ -f "$old" ]; then mkdir -p "$(dirname "$f")"; mv "$old" "$f"; fi
  fi
  if [ ! -f "$f" ]; then
    remote="$(repo_remote "$repo")"
    [ -n "$remote" ] || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-grok-review list"
    while IFS= read -r cand; do
      [ "$(jq -r '.name // ""' "$cand")" = "$2" ] || continue
      [ "$(jq -r '.caller // ""' "$cand")" = "$CALLER" ] || continue
      [ "$(jq -r '.repo_remote // ""' "$cand")" = "$remote" ] || continue
      [ -z "$found" ] || die "multiple moved-checkout records match session '$2'; refusing an ambiguous migration."
      found="$cand"
    done < <(find "$STATE_DIR/sessions" -type f -name "$CALLER--$2.json" 2>/dev/null)
    [ -z "$found" ] || { mkdir -p "$(dirname "$f")"; mv "$found" "$f"; }
  fi
  [ -f "$f" ] || die "no session '$2' for caller '$CALLER' in this repository. Try: ai-grok-review list"
  printf '%s' "$f"
}

# ---------------------------------------------------------------------------
# The completion rule (the reason this script exists).
#
# A run is finished ONLY when the output file parses as JSON and carries a
# terminal stopReason. Exit status proves nothing: the launcher has been
# observed exiting ~25-30s in while the sandboxed binary kept working for
# another 1-3 minutes, leaving a 0-byte file behind exit 0. Grok's own log is
# not an oracle either — it reported `handle_prompt.done ok:true` for two runs
# that were `cancelled` and for one whose output never reached its caller.
# ---------------------------------------------------------------------------
await_result() { # await_result FILE LABEL -> 0 done, 1 not-done/timeout
  local f="$1" label="$2" waited=0 empty_checks=0 saw_proc=0 next_heartbeat="$HEARTBEAT_INTERVAL" bytes
  while [ "$waited" -lt "$WAIT_TIMEOUT" ]; do
    if [ -s "$f" ] && jq -e 'has("stopReason")' "$f" >/dev/null 2>&1; then
      return 0
    fi
    # Fast-fail when a run is definitively dead, so a crash at second 2 does not
    # cost a full timeout of waiting.
    #
    # CRITICAL SAFETY CONDITION: only ever fast-fail if we have POSITIVELY SEEN a
    # Grok process during this wait and it then disappeared. If detection never
    # matched anything, we do not trust it and we wait the full timeout instead.
    # Without this guard the optimisation destroys the very case the wait exists
    # for: the orphaned worker is named `grok-<version>-<arch>` under `bwrap`,
    # not `grok`, so a detection miss would abort a perfectly healthy slow run
    # and reintroduce "Grok returned nothing" — the original bug, self-inflicted.
    if [ -n "$(grok_procs)" ]; then
      saw_proc=1; empty_checks=0
    elif [ "$saw_proc" = 1 ]; then
      empty_checks=$((empty_checks + 1))
      if [ "$empty_checks" -ge 2 ]; then
        note ""
        note "ai-grok-review: Grok is no longer running but produced no complete result."
        note "  output file : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
        note "  elapsed     : ${waited}s"
        note "  diagnose    : tail -20 ~/.grok/logs/unified.jsonl"
        return 1
      fi
    fi
    sleep "$POLL_INTERVAL"
    waited=$((waited + POLL_INTERVAL))
    if [ "$waited" -ge "$next_heartbeat" ]; then
      bytes="$(wc -c < "$f" 2>/dev/null || echo 0)"
      note "  … $label: ${waited}s elapsed; local wrapper is waiting for terminal Grok result (${bytes} output bytes). This does not prove provider activity."
      next_heartbeat=$((next_heartbeat + HEARTBEAT_INTERVAL))
    fi
  done
  note ""
  note "ai-grok-review: no terminal JSON after ${WAIT_TIMEOUT}s."
  note "  output file : $f ($(wc -c < "$f" 2>/dev/null || echo 0) bytes)"
  note "  diagnose    : tail -20 ~/.grok/logs/unified.jsonl"
  note "  processes   : $(grok_procs | tr '\n' ' ')"
  note "  Raise the ceiling with AI_GROK_WAIT_TIMEOUT=<seconds> if the run is genuinely long."
  stop_active_grok_tree
  return 1
}

# ---------------------------------------------------------------------------
# Turn execution
# ---------------------------------------------------------------------------
run_turn() { # run_turn REPO OUT PROMPT_FILE MAX_TURNS [SESSION_ID]
  local repo="$1" out="$2" pf="$3" turns="$4" sid="${5:-}"
  local grok supervisor python_bin bash_bin; local -a grok_command; grok="$(resolve_grok)"
  # Before anything billable. An unqualified build never reaches the provider.
  require_supported_grok_version "$grok"
  supervisor="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-process-supervisor"
  if [ ! -x "$supervisor" ]; then
    # Ubuntu installs this wrapper as a symlink into /usr/local/bin. Resolve
    # that link back to the repository so the internal Python helper beside
    # the real wrapper cannot be omitted from an otherwise valid install.
    local real_self; real_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
    [ -z "$real_self" ] || supervisor="$(dirname "$real_self")/ai-process-supervisor"
  fi
  [ -x "$supervisor" ] || supervisor="$(command -v ai-process-supervisor 2>/dev/null || true)"
  [ -n "$supervisor" ] && [ -x "$supervisor" ] || die 'ai-process-supervisor is missing; refusing paid work without process-tree ownership.'
  for python_bin in python3 python; do
    command -v "$python_bin" >/dev/null 2>&1 || continue
    "$python_bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1 && break
  done
  [ -n "${python_bin:-}" ] && "$python_bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1 \
    || die 'Python 3.10 or newer is required for safe Grok process-tree supervision.'
  grok_command=("$grok")
  case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*|CYGWIN*) [ ! -f "${grok}.exe" ] || { grok="${grok}.exe"; grok_command=("$grok"); } ;;
  esac
  case "$(uname -s 2>/dev/null || true):${grok,,}" in
    MINGW*:*.exe|MINGW*:*.com|MINGW*:*.bat|MINGW*:*.cmd|MSYS*:*.exe|MSYS*:*.com|MSYS*:*.bat|MSYS*:*.cmd|CYGWIN*:*.exe|CYGWIN*:*.com|CYGWIN*:*.bat|CYGWIN*:*.cmd) ;;
    MINGW*:*|MSYS*:*|CYGWIN*:*)
      # The process supervisor is native Windows Python. A bare `bash` makes
      # CreateProcess search the Windows PATH, where WSL or an app-execution
      # alias can win over the Git Bash that owns this wrapper. Pin the exact
      # current Bash executable and translate only that executable for Python.
      bash_bin="${BASH:-$(command -v bash 2>/dev/null || true)}"
      [ -n "$bash_bin" ] || die 'could not resolve the current Bash executable for the Grok script launcher.'
      if command -v cygpath >/dev/null 2>&1; then
        bash_bin="$(cygpath -w "$bash_bin" 2>/dev/null || true)"
      fi
      [ -n "$bash_bin" ] || die 'could not translate the current Bash executable for the Grok script launcher.'
      grok_command=("$bash_bin" "$grok") ;;
  esac
  local isolated_home="$STATE_DIR/isolated-home" auth_source="${AI_GROK_AUTH_HOME:-$HOME/.grok}/auth.json"
  mkdir -p "$isolated_home"; chmod 700 "$isolated_home" 2>/dev/null || true
  if [ -f "$auth_source" ]; then
    if [ ! -L "$isolated_home/auth.json" ] || [ ! "$auth_source" -ef "$isolated_home/auth.json" ]; then
      rm -f -- "$isolated_home/auth.json"
      ln -s "$auth_source" "$isolated_home/auth.json" 2>/dev/null || true
      # Default Git Bash can implement `ln -s` as a byte copy. Reject that
      # shape and use a same-volume hard link so there is still one credential
      # inode, not a stale second secret. Linux keeps the real symlink.
      if [ ! -L "$isolated_home/auth.json" ]; then
        rm -f -- "$isolated_home/auth.json"
        ln "$auth_source" "$isolated_home/auth.json" 2>/dev/null || true
      fi
    fi
    [ "$auth_source" -ef "$isolated_home/auth.json" ] \
      || die 'could not create a same-inode authentication link for the isolated Grok runtime; refusing to copy or persist credentials.'
  else
    rm -f -- "$isolated_home/auth.json"
  fi
  ACTIVE_ISOLATED_CWD="$(mktemp -d "${TMPDIR:-/tmp}/ai-grok-review-cwd.XXXXXX")"
  ACTIVE_ISOLATED_HOME="$(mktemp -d "$STATE_DIR/runtime-home.XXXXXX")"
  chmod 700 "$ACTIVE_ISOLATED_HOME" 2>/dev/null || true
  # GROK_HOME isolates Grok's own state, but Grok 1.0.5 also discovers Claude
  # plugins directly from the operating-system user home. Give only the Grok
  # child a neutral user home so an installed Claude plugin cannot inject hooks
  # or tools into paid reviewer work. Keep the owning wrapper's HOME unchanged.
  local -a isolation_home_env=(
    "HOME=$ACTIVE_ISOLATED_HOME" "GROK_HOME=$isolated_home"
    "XDG_CONFIG_HOME=$ACTIVE_ISOLATED_HOME/.config"
    "XDG_CACHE_HOME=$ACTIVE_ISOLATED_HOME/.cache"
    "XDG_DATA_HOME=$ACTIVE_ISOLATED_HOME/.local/share"
  )
  case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*|CYGWIN*)
      local isolated_native_home="$isolated_home" isolated_native_user_home="$ACTIVE_ISOLATED_HOME"
      if command -v cygpath >/dev/null 2>&1; then
        isolated_native_home="$(cygpath -w "$isolated_home")"
        isolated_native_user_home="$(cygpath -w "$ACTIVE_ISOLATED_HOME")"
      fi
      isolation_home_env=(
        "HOME=$isolated_native_user_home" "GROK_HOME=$isolated_native_home"
        "USERPROFILE=$isolated_native_user_home"
        "XDG_CONFIG_HOME=$isolated_native_user_home\\.config"
        "XDG_CACHE_HOME=$isolated_native_user_home\\.cache"
        "XDG_DATA_HOME=$isolated_native_user_home\\.local\\share"
        "APPDATA=$isolated_native_user_home\\AppData\\Roaming"
        "LOCALAPPDATA=$isolated_native_user_home\\AppData\\Local"
      )
      ;;
  esac
  local inspect inspect_rc=0 inspect_waited=0 inspect_stopped=0; inspect="$(mktemp)"
  prepare_active_stop_file
  env "${isolation_home_env[@]}" "${GROK_ISOLATION_ENV[@]}" "$python_bin" "$supervisor" --stop-file "$ACTIVE_GROK_NATIVE_STOP_FILE" -- \
    "${grok_command[@]}" --cwd "$ACTIVE_ISOLATED_CWD" inspect --json > "$inspect" 2>"$inspect.err" &
  ACTIVE_GROK_CHILD=$!
  while kill -0 "$ACTIVE_GROK_CHILD" 2>/dev/null; do
    if [ "$inspect_waited" -ge "$ISOLATION_TIMEOUT" ]; then
      if request_active_grok_stop || stop_active_grok_tree; then
        inspect_stopped=1
      else
        warn 'could not confirm termination of the timed-out local isolation inspection.'
        clear_active_stop_file
      fi
      rm -f "$inspect" "$inspect.err"
      if [ "$inspect_stopped" -eq 1 ]; then
        die "Grok isolation inspection exceeded ${ISOLATION_TIMEOUT}s and its process tree was terminated; refusing paid reviewer work."
      fi
      die "Grok isolation inspection exceeded ${ISOLATION_TIMEOUT}s and its process-tree termination is unconfirmed; refusing paid reviewer work."
    fi
    sleep 1; inspect_waited=$((inspect_waited + 1))
  done
  set +e; wait "$ACTIVE_GROK_CHILD"; inspect_rc=$?; set -e
  ACTIVE_GROK_CHILD=''
  clear_active_stop_file
  if [ "$inspect_rc" -ne 0 ]; then
    if [ "${AI_GROK_TEST_MODE:-}" = 1 ]; then
      note '  test diagnostic: isolation inspection stderr follows'
      sed -n '1,80p' "$inspect.err" >&2 2>/dev/null || true
    fi
    rm -f "$inspect" "$inspect.err"; clear_active_grok
    die "Grok isolation inspection failed locally (exit $inspect_rc); refusing paid reviewer work."
  fi
  if ! jq -e '
      (.mcpServers | type) == "array" and
      (.hooks | type) == "array" and
      (.plugins | type) == "array" and
      (.externalCompat.cells | type) == "array" and
      ([.mcpServers[]? | select((.compatibilityStatus // "enabled") != "disabled")] | length) == 0 and
      ([.hooks[]? as $hook | select(
        (($hook.compatibilityStatus // "") != "disabled") and
        ((
          (($hook.source.path // "") | test("[\\\\/]\\.claude([\\\\/]|$)"; "i")) and
          ([.externalCompat.cells[] | select(.vendor == "claude" and .surface == "hooks" and .enabled == false)] | length) == 0
        ) or (
          (($hook.source.path // "") | test("[\\\\/]\\.cursor([\\\\/]|$)"; "i")) and
          ([.externalCompat.cells[] | select(.vendor == "cursor" and .surface == "hooks" and .enabled == false)] | length) == 0
        ) or (
          (($hook.source.path // "") | test("[\\\\/]\\.claude([\\\\/]|$)|[\\\\/]\\.cursor([\\\\/]|$)"; "i")) | not
        ))
      )] | length) == 0 and
      (.plugins | length) == 0 and
      ([.externalCompat.cells[]? | select(.enabled == true)] | length) == 0
    ' "$inspect" >/dev/null 2>&1; then
    if [ "${AI_GROK_TEST_MODE:-}" = 1 ]; then
      note '  test diagnostic: rejected isolation inspection JSON follows'
      sed -n '1,80p' "$inspect" >&2 2>/dev/null || true
      sed -n '1,80p' "$inspect.err" >&2 2>/dev/null || true
    fi
    rm -f "$inspect" "$inspect.err"; clear_active_grok
    die 'Grok isolation inspection found an enabled MCP, hook, plugin, or compatibility import; refusing paid reviewer work.'
  fi
  rm -f "$inspect" "$inspect.err"
  local args=(--cwd "$ACTIVE_ISOLATED_CWD" --model "$GROK_MODEL" --prompt-file "$pf"
              --max-turns "$turns" "${GROK_PERMS[@]}" --output-format json)
  [ -n "$sid" ] && args+=(--resume "$sid")

  : > "$out"
  prepare_active_stop_file
  [ -z "$ACTIVE_PAID_LOCK" ] || date -u +%FT%TZ > "$ACTIVE_PAID_LOCK/provider-contacted"
  [ -z "$ACTIVE_TURN_RECORD" ] || date -u +%FT%TZ > "$ACTIVE_TURN_RECORD/provider-contacted"
  set +e
  env "${isolation_home_env[@]}" "${GROK_ISOLATION_ENV[@]}" "$python_bin" "$supervisor" --stop-file "$ACTIVE_GROK_NATIVE_STOP_FILE" -- "${grok_command[@]}" "${args[@]}" > "$out" 2>"$out.err" &
  local child=$! rc waited=0 next_heartbeat="$HEARTBEAT_INTERVAL" bytes
  ACTIVE_GROK_CHILD="$child"
  while kill -0 "$child" 2>/dev/null; do
    if [ "$waited" -ge "$WAIT_TIMEOUT" ]; then
      note "  Grok command exceeded the configured ${WAIT_TIMEOUT}s limit; stopping the local process."
      note "  This does not prove the provider stopped, so paid work remains blocked for reconciliation."
      # Let the native supervisor terminate its own Windows Job Object. Sending
      # TERM from Git Bash to a native Python PID can signal the surrounding
      # console process group on hosted Windows and kill the caller as well.
      if ! request_active_grok_stop && ! stop_active_grok_tree; then
        # Both stop paths failed. Drop only the temporary supervisor stop state
        # so a later prepare_active_stop_file cannot orphan this directory. The
        # paid-work lock stays blocked; cleanup never releases uncertainty.
        clear_active_stop_file
      fi
      RUN_TURN_RC=124
      set -e
      return 0
    fi
    sleep "$POLL_INTERVAL"
    waited=$((waited + POLL_INTERVAL))
    if [ "$waited" -ge "$next_heartbeat" ]; then
      bytes="$(wc -c < "$out" 2>/dev/null || echo 0)"
      note "  … Grok command: ${waited}s elapsed; local process is running and terminal result is pending (${bytes} output bytes). This does not prove provider activity."
      next_heartbeat=$((next_heartbeat + HEARTBEAT_INTERVAL))
    fi
  done
  wait "$child"; rc=$?
  # The supervisor's exit proves its entire owned process tree is gone. Disarm
  # the PID immediately so a later timeout/signal cannot target a reused PID.
  ACTIVE_GROK_CHILD=''
  set -e
  # rc is recorded, never trusted: exit 0 with an empty file is the normal
  # appearance of the early-return bug.
  RUN_TURN_RC="$rc"
  # The owned process tree is fully reaped, so the temporary operating-system
  # user profile is no longer needed. Remove it before result/session parsing:
  # those later fail-closed checks must not be able to strand ambient-state
  # isolation directories.
  clear_active_grok
}

# The frozen prefix, minus --max-turns, for the stability assertion. --max-turns
# is a runtime bound outside the cached prefix and is legitimately overridable.
frozen_prefix() {
  printf '%s|%s' "$GROK_MODEL" "$(printf '%s ' "${GROK_PERMS[@]}")"
}

# ---------------------------------------------------------------------------
# Result interpretation
# ---------------------------------------------------------------------------
handle_stop_reason() { # handle_stop_reason FILE NAME MAX_TURNS -> 0 ok, 1 fail
  local f="$1" name="$2" turns="$3" sr sid used
  sr="$(jq -r '.stopReason // "missing"' "$f")"
  sid="$(jq -r '.sessionId // ""' "$f")"
  used="$(jq -r '.num_turns // "?"' "$f")"
  case "$sr" in
    end_turn|EndTurn|stop|completed)
      return 0 ;;
    cancelled)
      note ""
      note "ai-grok-review: Grok cancelled without a final answer."
      note "  stopReason  : $sr"
      note "  session     : ${sid:-unknown} (saved as '$name')"
      note ""
      note "Grok may not resume a cancelled session cleanly. Do not broaden"
      note "permissions or keep retrying an empty resume. Start a fresh named session"
      note "and include the last verified evidence in its brief."
      return 1 ;;
    max_turns|max_turns_reached|max-turns*)
      note ""
      note "ai-grok-review: Grok stopped WITHOUT a final answer — the turn budget ran out."
      note "  stopReason  : $sr"
      note "  turns used  : $used of $turns"
      note "  session     : ${sid:-unknown} (saved as '$name')"
      note ""
      note "  This is NOT a permissions problem. A denied tool does not cancel a run —"
      note "  Grok says so and continues with its other tools. Do NOT broaden permissions."
      note ""
      note "  Do not raise the turn ceiling automatically. Check whether the brief was"
      note "  vague, the change was too large, or the reviewer wandered. Narrow the"
      note "  review and start a fresh, exact-scope session only after correcting that cause."
      return 1 ;;
    *)
      note "ai-grok-review: unrecognised stopReason '$sr' — refusing to guess. Inspect: $f"
      return 1 ;;
  esac
}

report_usage() { # report_usage FILE
  jq -r '"tokens: \(.usage.total_tokens // "?") "
       + "(uncached in: \(.usage.input_tokens // "?"), cached: \(.usage.cache_read_input_tokens // 0)) "
       + "turns: \(.num_turns // "?") "
       + "cost: $\(.total_cost_usd // 0) "
       + "model: \((.modelUsage // {} | keys | first) // "unknown")"' "$1" >&2
}

# Grok's `text` concatenates progress narration with the final answer, so every
# prompt this script sends asks for a delimiter and extraction happens on it.
VERDICT_MARKER='## Verdict'
# Emitting ONLY the verdict section throws away the findings. Measured on
# 2026-08-18: a real review produced 42 lines of evidenced defects above the
# heading and the caller saw the two words "## Verdict / REJECT" — a verdict
# with no reasons is not actionable, and the reasons were correct. Keep the
# verdict last (governance reads the tail) but never discard the findings.
#
# THE ORDER WAS INVERTED AND THE COMMENT ABOVE WAS THE ONLY THING THAT SAID SO
# (fixed 2026-09-01). The verdict section printed FIRST and the findings after it,
# so the terminal line of stdout was never the verdict. run-governed-review.mjs in
# u2giants/shared-db requires the verdict to be the LAST non-empty line and records
# nothing otherwise, so every governed review assigned to this wrapper failed with
# "did not produce a recordable terminal verdict (exit 0)" while the review itself
# had completed correctly. Observed twice on shared-db PR #2068 and reproduced with
# a one-line probe. Findings first, verdict last -- both still kept.
extract_answer() { # extract_answer FILE
  local text; text="$(jq -r '.text // ""' "$1")"
  if printf '%s' "$text" | grep -qF "$VERDICT_MARKER"; then
    printf '### Findings and reasoning (everything the reviewer said before its verdict)\n\n'
    printf '%s\n' "$text" | sed -n "1,/^${VERDICT_MARKER}/p" | sed "/^${VERDICT_MARKER}/d"
    printf '
---
'
    printf '%s\n' "$text" | sed -n "/^${VERDICT_MARKER}/,\$p"
  else
    warn "Grok's reply has no '$VERDICT_MARKER' section; emitting the whole response including any progress narration."
    printf '%s\n' "$text"
  fi
}

PROMPT_FOOTER="

---
Formatting requirement: structure your reply so the final answer is last, under a
literal '## Verdict' heading. Put any narration of what you are reading above it.
Do not put the verdict anywhere else."

build_prompt_file() { # build_prompt_file DEST  (reads --prompt/--prompt-file/stdin)
  local dest="$1"
  printf 'Your evidence packet is at %s/%s/MANIFEST.md. Read it first.\nIt contains the exact commits under review, the changed files, the full patch, and what you are being asked to decide.\n\nYou may read any other file under %s to confirm a finding; the packet is your starting point, not a boundary. Do not reconstruct the diff because it is already in %s/%s/patch.diff.\n\n---\n\n' \
    "$REVIEW_DIR" "$PACKET_REL" "$REVIEW_DIR" "$REVIEW_DIR" "$PACKET_REL" > "$dest"
  dest="$dest.body"
  if [ -n "${OPT_PROMPT_FILE:-}" ]; then
    [ -f "$OPT_PROMPT_FILE" ] || die "prompt file not found: $OPT_PROMPT_FILE"
    cat "$OPT_PROMPT_FILE" > "$dest"
  elif [ -n "${OPT_PROMPT:-}" ]; then
    printf '%s\n' "$OPT_PROMPT" > "$dest"
  elif [ ! -t 0 ]; then
    cat > "$dest"
  else
    die "no prompt given. Use --prompt TEXT, --prompt-file FILE, or pipe it on stdin."
  fi
  [ -s "$dest" ] || die "the prompt is empty."
  PROMPT_BODY_DIGEST="$(sha256sum "$dest" | awk '{print $1}')"
  cat "$dest" >> "${dest%.body}"
  rm -f "$dest"
  printf '%s' "$PROMPT_FOOTER" >> "${dest%.body}"
}

# Refuse to write review artifacts into a repo that would commit them.
reviews_dir() { # reviews_dir REPO EXACT-BASENAME -> path, or empty if unsafe
  local repo="$1" rel=".ai/reviews/$2" root physical
  if ! git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 \
    && git -C "$repo" check-ignore --no-index -q -- "$rel" 2>/dev/null \
    && [ ! -L "$repo/.ai" ] && [ ! -L "$repo/.ai/reviews" ]; then
    root="$(cd "$repo" && pwd -P)" || { printf ''; return; }
    if [ -e "$repo/.ai" ]; then physical="$(cd "$repo/.ai" && pwd -P)" || { printf ''; return; }; case "$physical" in "$root"/*) ;; *) printf ''; return ;; esac; fi
    if [ -e "$repo/.ai/reviews" ]; then physical="$(cd "$repo/.ai/reviews" && pwd -P)" || { printf ''; return; }; case "$physical" in "$root"/*) ;; *) printf ''; return ;; esac; fi
    printf '%s/.ai/reviews' "$repo"
  else
    printf ''
  fi
}

preflight_review_file() { # preflight_review_file REPO NAME
  local repo="$1" name="$2"
  PENDING_REVIEW_BASE="grok-${name}-$(date -u +%Y%m%dT%H%M%SZ)-$$.md"
  PENDING_REVIEW_DIR="$(reviews_dir "$repo" "$PENDING_REVIEW_BASE")"
  [ -n "$PENDING_REVIEW_DIR" ] || die "refusing Grok review: exact report destination is unsafe in $repo. Add '.ai/reviews/' to .gitignore and remove any exact destination from Git tracking before retrying."
}

write_review_file() { # write_review_file REPO NAME FILE -> prints path or nothing
  local repo="$1" name="$2" f="$3" dir ts out base
  ts="$(date -u +%Y%m%dT%H%M%SZ)-$$"; base="${PENDING_REVIEW_BASE:-grok-${name}-${ts}.md}"; dir="$(reviews_dir "$repo" "$base")"
  if [ -z "$dir" ]; then
    warn "refusing Grok review: exact report destination is unsafe in $repo. Add '.ai/reviews/' to .gitignore and remove any exact destination from Git tracking before retrying."
    return 1
  fi
  [ -z "$PENDING_REVIEW_DIR" ] || [ "$dir" = "$PENDING_REVIEW_DIR" ] || { warn 'refusing Grok review: report destination changed after preflight.'; return 1; }
  mkdir -p "$dir"
  out="$dir/$base"
  {
    echo "# Grok review — $name"
    echo
    echo "- Repo: \`$repo\`"
    echo "- Branch: \`$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')\`"
    echo "- Session: \`$(jq -r '.sessionId // "?"' "$f")\`"
    echo "- Model: \`$(jq -r '(.modelUsage // {} | keys | first) // "?"' "$f")\`"
    echo "- stopReason: \`$(jq -r '.stopReason // "?"' "$f")\` · turns: $(jq -r '.num_turns // "?"' "$f")"
    echo "- Tokens: $(jq -r '.usage.total_tokens // "?"' "$f") (cached $(jq -r '.usage.cache_read_input_tokens // 0' "$f")) · cost: \$$(jq -r '.total_cost_usd // 0' "$f")"
    echo
    echo "---"
    echo
    jq -r '.text // ""' "$f"
  } > "$out"
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
ai-grok-review $VERSION — read-only Grok reviews in persistent, named sessions.

  ai-grok-review new <name>  [--prompt TEXT | --prompt-file FILE | stdin] [--max-turns N]
  ai-grok-review ask <name>  [--prompt TEXT | --prompt-file FILE | stdin] [--max-turns N]
  ai-grok-review list
  ai-grok-review show <name>
  ai-grok-review transcript <name>
  ai-grok-review delete <name>
  ai-grok-review doctor [--live]

Options:
  --prompt TEXT        the brief (small briefs only; prefer --prompt-file)
  --prompt-file FILE   the brief, read from a file (no argv size limit)
  --max-turns N        turn ceiling for THIS call (default $DEFAULT_MAX_TURNS)
  --base REF           base of the comparison in the evidence packet
  --tests CMD          run CMD and record its exact result in the packet
  --decision TEXT      the one-sentence decision being asked for
  --assert-head SHA    refuse unless the repository is really at SHA. The wrapper
                       always derives identity itself; this only CHECKS a caller's
                       claim, so a mistyped SHA can never enter the evidence.
  --json               print the raw Grok result instead of the extracted answer

Reviews are read-only: Edit and Bash are denied and web search is disabled.
Model, permissions and --no-memory are fixed and cannot be overridden per call.
Reviews are not globally or repository-wide serialized. Only the same exact
session/turn or an idempotently identical submission is serialized; independent
reviews may run concurrently, including in the same logical repository.

Environment:
  AI_GROK_CALLER       'claude' (default) or 'codex' — keeps sessions separate
  AI_GROK_BIN          explicit path to the grok binary
  AI_GROK_MAX_TURNS    default turn ceiling ($DEFAULT_MAX_TURNS)
  AI_GROK_WAIT_TIMEOUT seconds to wait for a terminal result ($WAIT_TIMEOUT)
  AI_GROK_STATE_DIR    session state ($STATE_DIR)
EOF
}

cmd_doctor() {
  local live=0 grok rc=0 repo upstream workid live_lock
  [ "${1:-}" = "--live" ] && live=1
  need jq
  grok="$(resolve_grok)"
  local want_version have_version
  want_version="$(supported_grok_version 2>/dev/null || true)"
  have_version="$(installed_grok_version "$grok" 2>/dev/null || true)"
  echo "grok binary   : $grok"
  echo "grok version  : $("$grok" --version 2>&1 | head -1)"
  if [ -z "$want_version" ]; then
    echo "version policy: UNREADABLE — config/provider-cli-versions.json is missing or malformed; paid work will refuse to start."
    rc=1
  elif [ "$have_version" = "$want_version" ]; then
    echo "version policy: OK (exactly $want_version, the qualified build)"
  else
    echo "version policy: UNQUALIFIED — installed ${have_version:-unknown}, requires exactly $want_version."
    echo "                Paid reviewer work will refuse to start. Fix with the provider"
    echo "                installer, or 'grok update --version $want_version'."
    rc=1
  fi
  echo "caller        : $CALLER"
  echo "state dir     : $STATE_DIR"
  echo "model         : $GROK_MODEL"
  echo "permissions   : ${GROK_PERMS[*]}"
  echo "isolation     : verified before every paid turn (neutral cwd; MCPs, hooks, plugins, compat imports, MCP meta-tools, and subagents disabled)"
  echo "max turns     : $DEFAULT_MAX_TURNS   wait timeout: ${WAIT_TIMEOUT}s"
  echo
  # Auth: `grok doctor` is a TERMINAL diagnostic and has reported "not
  # authenticated" while real calls worked. `grok models` is the cheap check.
  # A billable probe happens only under --live.
  if "$grok" models >/dev/null 2>&1; then
    echo "auth          : OK (grok models succeeded)"
  else
    echo "auth          : AMBIGUOUS — 'grok models' failed."
    echo "                Do NOT conclude a login is needed from 'grok doctor' alone;"
    echo "                it only checks terminal/clipboard/color support."
    echo "                Re-run with --live for a real (billable) probe."
    rc=1
  fi
  if [ "$live" = 1 ]; then
    repo="$(repo_root)"; upstream="$(require_upstream_identity "$repo")"
    workid="$(work_identity "$upstream" "$CALLER" doctor doctor-live doctor-live doctor-live doctor-live 1)"; live_lock="$(work_lock_path "$workid")"
    legacy_paid_lock_guard "$upstream" "$CALLER" doctor-live || die 'legacy Grok work may still be running; refusing a duplicate billable doctor.'
    lock_acquire "$live_lock" doctor-live "$upstream" doctor-live "$repo" "$workid" doctor-live doctor-live 1 || die "this exact Grok live probe is already protected: $(lock_info "$live_lock")"
    ACTIVE_PAID_LOCK="$live_lock"; ACTIVE_SESSION_LOCK=''
    trap "lock_release '$live_lock'" EXIT
    trap 'on_paid_signal' INT TERM
    echo -n "live probe    : "
    local tmp; tmp="$(mktemp)"
    printf 'Reply with exactly: OK\n' > "$tmp.prompt"
    run_turn "$(pwd)" "$tmp" "$tmp.prompt" 2 || true
    if [ "$RUN_TURN_RC" != 124 ] && jq -e 'has("stopReason")' "$tmp" >/dev/null 2>&1; then
      echo "OK ($(jq -r '.stopReason' "$tmp"), cost \$$(jq -r '.total_cost_usd // 0' "$tmp"))"
      lock_release "$live_lock"; ACTIVE_PAID_LOCK=''; trap - EXIT INT TERM
    else
      echo "FAILED — no terminal JSON"; trap - EXIT INT TERM; mark_remote_uncertain "$live_lock"; ACTIVE_PAID_LOCK=''; rc=1
    fi
    clear_active_grok
    rm -f "$tmp" "$tmp.prompt" "$tmp.err" 2>/dev/null || true
  fi
  return $rc
}

cmd_new() {
  local name="$1" repo rid upstream meta existing pf out sess_lock rid_lock sid rc turns prompt_digest options_digest source_id workid
  # The version gate runs before any state is created -- no session lock, no
  # private snapshot, no evidence packet, no durable session record. Refusing
  # after those exist would leave a reservation behind for a run that never
  # contacted the provider, and the obvious retry under the same name would then
  # be rejected for a contract mismatch.
  require_supported_grok_version "$(resolve_grok)"

  valid_name "$name" || die "invalid session name '$name' (use letters, digits, . _ -)"
  repo="$(repo_root)"; rid="$(repo_id "$repo")"; upstream="$(require_upstream_identity "$repo")"
  meta="$(meta_path "$rid" "$name")"
  [ -f "$meta" ] && die "session '$name' already exists here. Continue it with: ai-grok-review ask $name"
  existing="$(logical_session_meta "$upstream" "$CALLER" "$name" 2>/dev/null || true)"
  [ -z "$existing" ] || die "session-name collision: '$name' already identifies a durable Grok conversation for this caller and logical repository. Continue it from its recorded checkout or choose a different name."

  turns="${OPT_MAX_TURNS:-$DEFAULT_MAX_TURNS}"
  sess_lock="$(session_lock_path "$upstream" "$CALLER" "$name")"
  session_lock_acquire "$sess_lock" "new:$name" || die "session '$name' already has an owner: $(lock_info "$sess_lock")"
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'" EXIT

  pf="$(mktemp)"; out="$(mktemp)"

  note "Grok review '$name' starting (model $GROK_MODEL, max-turns $turns, read-only)…"
  preflight_review_file "$repo" "$name"
  prepare_review "$repo" "grok-$name"   # sets REVIEW_DIR/BASE/HEAD/PACKET_HASH
  build_prompt_file "$pf"
  prompt_digest="$PROMPT_BODY_DIGEST"; options_digest="$(printf '%s\n%s\n%s\n%s' "$OPT_BASE" "$OPT_TESTS" "$OPT_DECISION" "$OPT_ASSERT_HEAD" | sha256sum | awk '{print $1}')"
  source_id="${REVIEW_HEAD}:$(sha256sum "$REVIEW_DIR/$PACKET_REL/patch.diff" | awk '{print $1}'):${options_digest}"
  workid="$(work_identity "$upstream" "$CALLER" new "$name" "$GROK_MODEL" "$source_id" "$prompt_digest" 1)"; rid_lock="$(work_lock_path "$workid")"
  if ! reserve_new_session "$upstream" "$name" "$workid" "$source_id" "$prompt_digest"; then lock_release "$sess_lock"; exit 1; fi
  if ! legacy_paid_lock_guard "$upstream" "$CALLER" "$name"; then lock_release "$sess_lock"; die "legacy Grok work protects this exact session; refusing a duplicate paid review."; fi
  if ! lock_acquire "$rid_lock" "new:$name" "$upstream" "$name" "$repo" "$workid" "$prompt_digest" "$source_id" 1; then
    lock_release "$sess_lock"
    die "this exact Grok review submission is already active or retained: $(lock_info "$rid_lock"). Status: ai-grok-review list"
  fi
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT
  ACTIVE_PAID_LOCK="$rid_lock"; ACTIVE_SESSION_LOCK="$sess_lock"
  trap 'on_paid_signal' INT TERM
  run_turn "$REVIEW_DIR" "$out" "$pf" "$turns"; rc="$RUN_TURN_RC"
  if [ "$rc" = 124 ] || ! await_result "$out" "review '$name'"; then
    preserve_uncertain_paid_turn "$rid_lock" "$sess_lock"
    note "  grok exit status was $rc - which proves nothing; see the note above."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    if [ "$rc" = 124 ]; then
      note "  Do not retry while this paid turn is unconfirmed; reconcile the retained lock first."
    else
      note "  A first turn that completes but delivers no output has been seen before"
      note "  (session 019fd4ae…, 2026-08-05). Retry once; if it recurs, inspect the log."
    fi
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi

  sid="$(jq -r '.sessionId // ""' "$out")"
  [ -n "$sid" ] && [ "$sid" != null ] || { rm -f "$pf" "$out" "$out.err"; die "Grok returned no sessionId; cannot continue this workstream."; }

  write_meta "$meta" "$(MSYS2_ARG_CONV_EXCL='*' jq -n \
    --arg sid "$sid" --arg repo "$repo" --arg remote "$(repo_remote "$repo")" --arg name "$name" --arg caller "$CALLER" \
    --arg prefix "$(frozen_prefix)" --arg created "$(date -u +%FT%TZ)" \
    --arg review_dir "$REVIEW_DIR" --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" --arg pkthash "$PACKET_HASH" \
    --argjson turns 1 \
    --argjson tokens "$(jq '.usage.total_tokens // 0' "$out")" \
    --argjson cost "$(jq '.total_cost_usd // 0' "$out")" \
    --arg stop "$(jq -r '.stopReason // "?"' "$out")" \
    '{grok_session_id:$sid, repo:$repo, repo_remote:$remote, name:$name, caller:$caller,
      frozen_prefix:$prefix, created:$created, updated:$created,
      review_dir:$review_dir, base:$base, head:$head, packet_sha256:$pkthash,
      turns:$turns, total_tokens:$tokens, total_cost_usd:$cost, last_stop_reason:$stop}')"

  finish_turn "$repo" "$name" "$out" "$turns"
  local st=$?
  rm -f "$pf" "$out" "$out.err"
  return $st
}

cmd_ask() {
  local name="$1" repo rid upstream meta pf out sid rc turns sess_lock rid_lock boundary prompt_digest options_digest source_id workid next_turn
  # The version gate runs before any state is created -- no session lock, no
  # private snapshot, no evidence packet, no durable session record. Refusing
  # after those exist would leave a reservation behind for a run that never
  # contacted the provider, and the obvious retry under the same name would then
  # be rejected for a contract mismatch.
  require_supported_grok_version "$(resolve_grok)"

  repo="$(repo_root)"; rid="$(repo_id "$repo")"; upstream="$(require_upstream_identity "$repo")"
  meta="$(find_meta "$rid" "$name")"
  sid="$(jq -r .grok_session_id "$meta")"
  turns="${OPT_MAX_TURNS:-$DEFAULT_MAX_TURNS}"

  # The frozen prefix must not have drifted since the session was created.
  local want got
  want="$(jq -r .frozen_prefix "$meta")"; got="$(frozen_prefix)"
  [ "$want" = "$got" ] || die "the frozen review prefix changed since session '$name' was created.
  was: $want
  now: $got
  Continuing would silently discard the provider cache. Start a new session instead."

  sess_lock="$(session_lock_path "$upstream" "$CALLER" "$name")"
  session_lock_acquire "$sess_lock" "ask:$name" || die "session '$name' already has a turn running: $(lock_info "$sess_lock")"
  # shellcheck disable=SC2064
  trap "lock_release '$sess_lock'" EXIT

  pf="$(mktemp)"; out="$(mktemp)"

  note "Grok review '$name' continuing session $sid (max-turns $turns)…"
  preflight_review_file "$repo" "$name"
  boundary="$(jq -r '.review_dir // empty' "$meta")"
  if [ -z "$boundary" ]; then
    # Sessions created before issue #53 used the live checkout for ordinary
    # clones and the deterministic snapshot for linked worktrees.
    if [ -f "$repo/.git" ]; then
      boundary="$($SANDBOX_BIN ensure "$repo" "grok-$name")"
    else
      boundary="$repo"
    fi
    write_meta "$meta" "$(MSYS2_ARG_CONV_EXCL='*' jq --arg d "$boundary" '.review_dir=$d | .boundary_migration_warned=true' "$meta")"
    warn "session '$name' predates recorded private snapshots and remains bound to its original review directory. Delete and recreate it when convenient; until then, do not move or update an ordinary checkout during a turn."
  fi
  prepare_review "$repo" "grok-$name" "$boundary"
  # A continuation that silently moved to a different commit would let a verdict
  # about one head be recorded against another. Say so rather than proceed.
  local prev_head; prev_head="$(jq -r '.head // ""' "$meta")"
  if [ -n "$prev_head" ] && [ "$prev_head" != "$REVIEW_HEAD" ]; then
    warn "the repository moved since session '$name' started.
  reviewed at: $prev_head
  now at     : $REVIEW_HEAD
The earlier evidence is STALE and cannot approve this head. The packet has been
rebuilt for the new head; treat any verdict from this session as applying to
$REVIEW_HEAD only."
  fi
  build_prompt_file "$pf"
  next_turn="$(( $(jq -r '.turns // 0' "$meta") + 1 ))"
  prompt_digest="$PROMPT_BODY_DIGEST"; options_digest="$(printf '%s\n%s\n%s\n%s' "$OPT_BASE" "$OPT_TESTS" "$OPT_DECISION" "$OPT_ASSERT_HEAD" | sha256sum | awk '{print $1}')"
  source_id="${REVIEW_HEAD}:$(sha256sum "$REVIEW_DIR/$PACKET_REL/patch.diff" | awk '{print $1}'):${options_digest}"
  workid="$(work_identity "$upstream" "$CALLER" ask "$name" "$sid" "$source_id" "$prompt_digest" "$next_turn")"; rid_lock="$(work_lock_path "$workid")"
  if ! reserve_session_turn "$upstream" "$name" "$next_turn" "$workid" "$source_id" "$prompt_digest"; then lock_release "$sess_lock"; exit 1; fi
  ACTIVE_TURN_RECORD="$(turn_record_path "$upstream" "$CALLER" "$name" "$next_turn")"
  if ! legacy_paid_lock_guard "$upstream" "$CALLER" "$name"; then lock_release "$sess_lock"; die "legacy Grok work protects this exact session; refusing a duplicate continuation."; fi
  if ! lock_acquire "$rid_lock" "ask:$name" "$upstream" "$name" "$repo" "$workid" "$prompt_digest" "$source_id" "$next_turn"; then
    lock_release "$sess_lock"
    die "this exact Grok continuation turn is already active or retained: $(lock_info "$rid_lock"). Status: ai-grok-review list"
  fi
  trap "lock_release '$sess_lock'; lock_release '$rid_lock'" EXIT
  ACTIVE_PAID_LOCK="$rid_lock"; ACTIVE_SESSION_LOCK="$sess_lock"
  trap 'on_paid_signal' INT TERM
  run_turn "$REVIEW_DIR" "$out" "$pf" "$turns" "$sid"; rc="$RUN_TURN_RC"
  if [ "$rc" = 124 ] || ! await_result "$out" "review '$name'"; then
    preserve_uncertain_paid_turn "$rid_lock" "$sess_lock"
    note "  grok exit status was $rc - which proves nothing."
    [ -s "$out.err" ] && { note "  stderr:"; sed 's/^/    /' "$out.err" >&2; }
    if [ "$rc" = 124 ]; then
      note "  Do not retry while this paid turn is unconfirmed; reconcile the retained lock first."
    elif [ ! -s "$out" ]; then
      note ""
      note "  An empty RESUME is a known 0.2.118 behaviour after a session was cancelled."
      note "  Do not keep retrying this session: start a fresh one with"
      note "    ai-grok-review new ${name}-2 --prompt-file <brief>"
    fi
    rm -f "$pf" "$out" "$out.err"; exit 1
  fi

  write_meta "$meta" "$(jq \
    --arg updated "$(date -u +%FT%TZ)" \
    --argjson tokens "$(jq '.usage.total_tokens // 0' "$out")" \
    --argjson cost "$(jq '.total_cost_usd // 0' "$out")" \
    --arg stop "$(jq -r '.stopReason // "?"' "$out")" \
    --arg head "$REVIEW_HEAD" --arg base "$REVIEW_BASE" --arg pkthash "$PACKET_HASH" \
    '.head=$head | .base=$base | .packet_sha256=$pkthash |
     .updated=$updated | .turns=(.turns+1)
     | .total_tokens=(.total_tokens+$tokens)
     | .total_cost_usd=(.total_cost_usd+$cost)
     | .last_stop_reason=$stop' "$meta")"

  finish_turn "$repo" "$name" "$out" "$turns"
  local st=$?
  rm -f "$pf" "$out" "$out.err"
  return $st
}

finish_turn() { # finish_turn REPO NAME OUT MAX_TURNS
  local repo="$1" name="$2" out="$3" turns="$4" path
  report_usage "$out"
  if ! handle_stop_reason "$out" "$name" "$turns"; then
    clear_active_grok
    return 1
  fi
  if ! path="$(write_review_file "$repo" "$name" "$out")"; then
    clear_active_grok
    return 1
  fi
  if [ "${OPT_JSON:-0}" = 1 ]; then
    cat "$out"
  else
    extract_answer "$out"
  fi
  [ -n "$path" ] && note "review saved: $path"
  clear_active_grok
  return 0
}

cmd_list() {
  local rid dir f lock upstream session caller source pid started state started_epoch now elapsed protection digest
  rid="$(repo_id "$(repo_root)")"
  printf '%s\n' 'ACTIVE REVIEWS AND RETAINED EXACT-WORK PROTECTIONS (all repositories for this OS account)'
  printf '%-34s %-24s %-8s %-10s %-12s %-20s %-9s %s\n' REPOSITORY SESSION CALLER STATE DIGEST STARTED ELAPSED SOURCE
  for lock in "$STATE_DIR"/locks/work--*.lock.d "$STATE_DIR"/locks/repo--*.lock.d; do
    [ -d "$lock" ] || continue
    upstream="$(cat "$lock/upstream" 2>/dev/null || true)"; session="$(cat "$lock/session" 2>/dev/null || true)"
    caller="$(cat "$lock/caller" 2>/dev/null || true)"; source="$(cat "$lock/source" 2>/dev/null || true)"
    pid="$(cat "$lock/pid" 2>/dev/null || true)"; started="$(cat "$lock/started" 2>/dev/null || true)"
    if [ -z "$upstream" ] || [ -z "$session" ] || ! [[ "$pid" =~ ^[0-9]+$ ]]; then
      warn "malformed active lock $(basename "$lock") is blocking paid work"
      continue
    fi
    kill -0 "$pid" 2>/dev/null && state=active || state=stopped
    [ ! -f "$lock/remote-uncertain" ] || state=retained
    digest="$(cat "$lock/prompt_digest" 2>/dev/null || true)"; digest="${digest:0:12}"; [ -n "$digest" ] || digest=legacy
    elapsed='?'
    if started_epoch="$(date -d "$started" +%s 2>/dev/null)"; then
      now="$(date +%s)"; elapsed="$((now - started_epoch))s"
    fi
    printf '%-34s %-24s %-8s %-10s %-12s %-20s %-9s %s (pid %s)\n' "$upstream" "$session" "$caller" "$state" "$digest" "$started" "$elapsed" "$source" "$pid"
  done
  printf '\n%s\n' 'COMPLETED SESSIONS (this checkout)'
  dir="$STATE_DIR/sessions/$rid"
  printf '%-24s %-8s %-38s %6s %10s %9s  %s\n' NAME CALLER SESSION TURNS TOKENS COST STOP
  [ -d "$dir" ] || return 0
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    jq -r '[.name, .caller, .grok_session_id, (.turns|tostring),
            (.total_tokens|tostring), ("$" + (.total_cost_usd|tostring)),
            .last_stop_reason] | @tsv' "$f" \
      | awk -F'\t' '{printf "%-24s %-8s %-38s %6s %10s %9s  %s\n",$1,$2,$3,$4,$5,$6,$7}'
  done
}

cmd_show() {
  local rid; rid="$(repo_id "$(repo_root)")"
  jq . "$(find_meta "$rid" "$1")"
}

cmd_transcript() {
  # Implementable after all: `grok export` exports a session transcript as
  # Markdown. (The plan had dropped this on the assumption that ai-glm's
  # HTTP-API version could not be ported — Step 0 found the subcommand.)
  local rid sid grok
  rid="$(repo_id "$(repo_root)")"
  sid="$(jq -r .grok_session_id "$(find_meta "$rid" "$1")")"
  grok="$(resolve_grok)"
  GROK_HOME="$STATE_DIR/isolated-home" env "${GROK_ISOLATION_ENV[@]}" "$grok" export "$sid" 2>/dev/null \
    || die "'grok export $sid' failed. Verify the subcommand with: grok export --help"
}

cmd_delete() {
  local rid meta name="$1" lock session caller source upstream record; rid="$(repo_id "$(repo_root)")"; upstream="$(require_upstream_identity "$(repo_root)")"
  for lock in "$STATE_DIR"/locks/work--*.lock.d "$STATE_DIR"/locks/repo--*.lock.d; do
    [ -d "$lock" ] || continue
    session="$(cat "$lock/session" 2>/dev/null || true)"; caller="$(cat "$lock/caller" 2>/dev/null || true)"; source="$(cat "$lock/source" 2>/dev/null || true)"
    if [ "$session" = "$name" ] && [ "$caller" = "$CALLER" ] && [ "$(cd "$source" 2>/dev/null && pwd -P || printf '%s' "$source")" = "$(cd "$(repo_root)" && pwd -P)" ]; then
      die "session '$name' is active. Local deletion is refused because provider cancellation is not confirmed; the remote turn may still run and bill."
    fi
  done
  meta="$(find_meta "$rid" "$name")"
  rm -f "$meta"
  record="$(session_record_path "$upstream" "$CALLER" "$name")"
  [ ! -d "$record" ] || rm -rf -- "$record"
  for record in "$STATE_DIR"/turn-records/*; do
    [ -d "$record" ] || continue
    [ "$(cat "$record/upstream" 2>/dev/null || true)" = "$upstream" ] || continue
    [ "$(cat "$record/caller" 2>/dev/null || true)" = "$CALLER" ] || continue
    [ "$(cat "$record/session" 2>/dev/null || true)" = "$name" ] || continue
    rm -rf -- "$record"
  done
  release_boundary "$(repo_root)" "grok-$name"   # disposable snapshot, never outlives its session
  note "deleted local session record '$name' (Grok provider history is untouched)."
}

# ---------------------------------------------------------------------------
# Argument parsing. There is deliberately NO passthrough of arbitrary grok
# flags: a passthrough is a drift hatch, and the next session under pressure
# would use it to pass --permission-mode auto, which is exactly what happened.
# ---------------------------------------------------------------------------
CMD="${1:-}"; shift || true
ARG=""
OPT_PROMPT=""; OPT_PROMPT_FILE=""; OPT_MAX_TURNS=""; OPT_JSON=0; OPT_LIVE=""
OPT_BASE=""; OPT_TESTS=""; OPT_DECISION=""; OPT_ASSERT_HEAD=""

while [ $# -gt 0 ]; do
  case "$1" in
    --prompt)       OPT_PROMPT="${2:-}"; shift 2 ;;
    --prompt-file)  OPT_PROMPT_FILE="${2:-}"; shift 2 ;;
    --max-turns)    OPT_MAX_TURNS="${2:-}"; shift 2 ;;
    --base)         OPT_BASE="${2:-}"; shift 2 ;;
    --tests)        OPT_TESTS="${2:-}"; shift 2 ;;
    --decision)     OPT_DECISION="${2:-}"; shift 2 ;;
    --assert-head)  OPT_ASSERT_HEAD="${2:-}"; shift 2 ;;
    --json)         OPT_JSON=1; shift ;;
    --live)         OPT_LIVE="--live"; shift ;;
    -h|--help)      usage; exit 0 ;;
    --*)            die "unknown option '$1'. This wrapper deliberately does not forward arbitrary grok flags; if you need a capability it lacks, say so rather than calling grok directly." ;;
    *)              [ -z "$ARG" ] && ARG="$1" || die "unexpected argument '$1'"; shift ;;
  esac
done

if [ -n "$OPT_MAX_TURNS" ]; then
  case "$OPT_MAX_TURNS" in
    ''|*[!0-9]*) die "--max-turns must be a positive integer" ;;
    *) [ "$OPT_MAX_TURNS" -ge 1 ] || die "--max-turns must be >= 1" ;;
  esac
fi

need jq

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-grok-review new <name> …"; cmd_new "$ARG" ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-grok-review ask <name> …"; cmd_ask "$ARG" ;;
  list)       cmd_list ;;
  show)       [ -n "$ARG" ] || die "usage: ai-grok-review show <name>"; cmd_show "$ARG" ;;
  transcript) [ -n "$ARG" ] || die "usage: ai-grok-review transcript <name>"; cmd_transcript "$ARG" ;;
  delete)     [ -n "$ARG" ] || die "usage: ai-grok-review delete <name>"; cmd_delete "$ARG" ;;
  doctor)     cmd_doctor "$OPT_LIVE" ;;
  -h|--help|help|"") usage; [ -z "$CMD" ] && exit 2 || exit 0 ;;
  *)          printf 'unknown command: %s\n\n' "$CMD" >&2; usage >&2; exit 2 ;;
esac
