#!/usr/bin/env bash
# ai-review — the only supported approval-gate front door.
set -euo pipefail
_ai_st="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools/lib/session-tmp.sh"; if [ -f "$_ai_st" ]; then . "$_ai_st"; ai_session_tmp_wrap review "$(readlink -f "${BASH_SOURCE[0]}")" "$@"; fi; unset _ai_st  # own temp root, deleted on exit
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
usage(){ printf '%s\n' 'Usage: ai-review <provider> <plan-review|diff-review|security-review|visual-review|final-check> [--tests CMD] [--base REF] [--assert-head SHA] [--force] [--additional-reviewer]' '       ai-review deepseek <diff-review|security-review|final-check> --code-only --paths-file JSON [--base REF] [--assert-head SHA] [--action-profile NAME --action-manifest PRIVATE_JSON]' '       ai-review <provider> <mode> --reviewer-approval <assigned AI reviewer exact-head APPROVE report> [review options]' '       [--implementer ENGINE] names the implementing engine recorded for gate independence (default: AI_IMPLEMENTER_ENGINE, else detected)' '       Private code-only reviews use the attachment-only DeepSeek reviewer; CLI reviewers have no proven source-read boundary.' '       [--operation NAME] asks the reviewer for the exact line "Approved NAME." (legacy-managed-launcher-refresh|first-managed-install|partial-managed-launcher-recovery|stale-linux-manifest-recovery)' '       [--detach] sends the review and returns at once with a run id (observation week); ai-review outcome <id> [--wait SECONDS] reads it' '       Exit 75: every rotation reviewer is skipped for this session. Exit 77: this reviewer is skipped for this session.' '       ai-review doctor'; }
# bin/* is symlinked onto PATH, so resolve the real script location before
# looking for the repository's own files; $SCRIPT_DIR is the symlink directory.
REAL_DIR="$ROOT"
if command -v readlink >/dev/null 2>&1; then
  REAL_DIR_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -z "$REAL_DIR_SOURCE" ] || REAL_DIR="$(cd "$(dirname "$REAL_DIR_SOURCE")" && pwd)"
fi
# #1531: the reviewer must see the public code enforcing its action scope.
# Fixed installed paths only: never attach the private operational manifest.
action_review_evidence_args(){
  local evidence_root relative file
  evidence_root="$(cd "$REAL_DIR/.." && pwd -P)" || return 1
  action_evidence_args=()
  for relative in tools/review_action_profile.py config/review-action-profiles.json bin/ai-review-code-only.py bin/ai-task-gates; do
    file="$evidence_root/$relative"
    [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] && [ "$(realpath -- "$file")" = "$file" ] || return 1
    action_evidence_args+=(--file "$file")
  done
  if [[ "${action_profile:-}" = oracle-native-alternate-serialization-v1 || "${action_profile:-}" = oracle-native-alternate-serialization-v2 ]]; then
    local oracle_sources=(tools/oracle_native_alternate_profile.py tools/oracle_native_alternate_guardian.py tools/oracle_native_alternate_runtime.py bin/ai-oracle-native-alternate)
    [ "$action_profile" != oracle-native-alternate-serialization-v2 ] || oracle_sources=(tools/oracle_native_alternate_v2_profile.py tools/oracle_native_alternate_v2_guardian.py tools/oracle_native_alternate_v2_runtime.py bin/ai-oracle-native-alternate-v2)
    oracle_sources+=(tools/oracle_native_alternate_output.py tools/oracle_native_alternate_control.py)
    for relative in "${oracle_sources[@]}"; do
      file="$evidence_root/$relative"
      [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] && [ "$(realpath -- "$file")" = "$file" ] || return 1
      action_evidence_args+=(--file "$file")
    done
  fi
}
# Per-session skip list and detached runs (plan_reviewer-observation-week
# steps 2-3). The calling session id is resolved once here and inherited by
# the pool, the engine, the lifecycle and the scoreboard.
SKIP_LIB="$REAL_DIR/../tools/lib/review-session-skip.sh"; [ -f "$SKIP_LIB" ] || SKIP_LIB="$ROOT/../tools/lib/review-session-skip.sh"
# shellcheck source=../tools/lib/review-session-skip.sh
load_skip_lib(){ # only reviews and outcomes need it; doctor stays usable without it
  [ -z "${SKIP_LIB_LOADED:-}" ] || return 0
  . "$SKIP_LIB" 2>/dev/null || { printf 'ai-review: cannot load the session skip list.\n' >&2; exit 3; }
  review_export_caller_session_id  # validates an inherited id too
  SKIP_LIB_LOADED=1
}
DETACH_DIR="${AI_REVIEW_DETACH_DIR:-$HOME/.local/state/ai-devops/review-detached}"
detach_lifecycle_state(){ # ID -> lifecycle state file carrying that detach id
  local dir="${AI_REVIEW_LIFECYCLE_DIR:-$HOME/.local/state/ai-devops/review-lifecycle}/runs"
  [ -d "$dir" ] || return 1
  grep -rlE --include='*.json' "\"detach_id\": ?\"$1\"" "$dir" 2>/dev/null | head -1 | grep .
}
review_outcome(){ # ID [--wait SECONDS]
  local id="${1:-}" wait_s=0 rec state status verdict report pid waited=0
  [[ "$id" =~ ^d[0-9A-Za-z-]{6,80}$ ]] || { printf 'ai-review: outcome needs a detached run id.\n' >&2; return 2; }
  shift
  if [ "${1:-}" = --wait ]; then wait_s="${2:-}"; case "$wait_s" in ''|*[!0-9]*) printf 'ai-review: --wait needs seconds.\n' >&2; return 2;; esac; fi
  rec="$DETACH_DIR/$id.json"
  [ -f "$rec" ] || { printf 'ai-review: no detached run %s on this machine.\n' "$id" >&2; return 2; }
  # Single writers: the request record is written once by the caller, the
  # pid and result files only by the detached run itself.
  local result="$DETACH_DIR/$id.result.json"
  while :; do
    status=pending
    if [ -f "$result" ]; then status=finished
    elif [ -f "$DETACH_DIR/$id.pid" ]; then
      pid="$(tr -cd '0-9' < "$DETACH_DIR/$id.pid" 2>/dev/null || true)"
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null && [ ! -f "$result" ]; then status=lost; fi
    fi
    [ "$status" = pending ] && [ "$waited" -lt "$wait_s" ] || break
    sleep 5; waited=$((waited + 5))
  done
  state="$(detach_lifecycle_state "$id" || true)"
  report=""; verdict=""
  if [ -n "$state" ]; then
    verdict="$(jq -r '.verdict // empty' "$state" 2>/dev/null || true)"
    report="$(jq -r '.report_path // empty' "$state" 2>/dev/null || true)"
    [ "$(jq -r '.status // empty' "$state" 2>/dev/null)" != running ] || verdict=""
  fi
  case "$status" in
    pending) [ -n "$verdict" ] || verdict=pending ;;
    lost) [ -n "$verdict" ] || verdict=BLOCKED ;;
    *)
      if [ -z "$verdict" ]; then
        # No lifecycle: refused before dispatch, or an earlier pass was reused.
        report="$(jq -r '.report // empty' "$result" 2>/dev/null | tr -d '\r' || true)"
        if [ "$(jq -r '.exit_code' "$result" 2>/dev/null | tr -d '\r')" = 0 ] && [ -n "$report" ] && [ -f "$report" ]; then verdict=APPROVE; else verdict=BLOCKED; fi
      fi ;;
  esac
  printf '%s\n' "$verdict"
  [ -z "$report" ] || printf 'report: %s\n' "$report"
  printf 'log: %s\n' "$(jq -r '.log // empty' "$rec" 2>/dev/null)"
  return 0
}
orig_args=("$@")
pool_provider=""
review_provider="${1:-}"
case "${1:-}" in
  outcome) shift; load_skip_lib; review_outcome "$@"; exit $? ;;
  claude)
    # Claude left the reviewer pool (owner instruction 2026-09-30). The registry
    # is the gate even for the legacy wrapper name, so a test fixture may still
    # exercise the adapter while the shipped registry refuses the provider.
    REGISTRY=""
    for candidate in "$REAL_DIR/../config/reviewer-registry.json" "$ROOT/../config/reviewer-registry.json"; do
      [ -f "$candidate" ] && REGISTRY="$candidate" && break
    done
    [ -z "${AI_REVIEW_REGISTRY_FILE:-}" ] || REGISTRY="$AI_REVIEW_REGISTRY_FILE"
    registry_state=""
    [ -z "$REGISTRY" ] || registry_state="$(jq -r --arg p claude '.providers[$p].registry_state // "absent"' "$REGISTRY" 2>/dev/null || true)"
    if [ "$registry_state" != "registered" ]; then
      printf 'ai-review: error: claude is not a registered reviewer (registry state: %s). The registry decides the pool; never flip a state to make a review succeed.\n' "${registry_state:-registry-not-found}" >&2
      exit 2
    fi
    wrapper="${AI_CLAUDE_REVIEW_BIN:-$ROOT/ai-claude-review}" ;;
  codex) wrapper="${AI_CODEX_REVIEW_BIN:-$ROOT/ai-codex-review}" ;;
  deepseek)
    [ -z "${AI_DEEPSEEK_REVIEW_BIN:-}" ] || [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] || { printf 'ai-review: private reviewer substitution is a test hook only.\n' >&2; exit 2; }
    wrapper="${AI_DEEPSEEK_REVIEW_BIN:-$REAL_DIR/ai-deepseek-agent}" ;;
  doctor)
    # Doctor runs before any gate and must answer "who can review here".
    # The rotation section comes from the same preflight every session
    # trusts; providers listed in config/reviewer-membership-scope.json
    # (gate helpers such as codex) are excluded there so a session never
    # reads a gate helper as a drawable reviewer.
    doctor_rc=0
    _scope=""
    for _c in "$REAL_DIR/../config/reviewer-membership-scope.json" "$ROOT/../config/reviewer-membership-scope.json"; do
      [ ! -f "$_c" ] || { _scope="$_c"; break; }
    done
    printf 'Rotation reviewers (allocator pool; usable=true means drawable now; gate helpers are excluded):\n'
    if [ -z "$_scope" ]; then
      printf 'ai-review: doctor: cannot find config/reviewer-membership-scope.json; rotation section unavailable.\n' >&2
      doctor_rc=1
    else
      "${AI_REVIEW_PREFLIGHT_BIN:-$ROOT/ai-review-preflight}" status \
        | jq -c --slurpfile scope "$_scope" 'select(.registry_state == "registered") | select((.provider as $p | $scope[0].outside_allocator | has($p)) | not)' \
        || doctor_rc=$?
    fi
    printf 'Approval-gate helpers (approval gates only, never a rotation reviewer):\n'
    "${AI_CLAUDE_REVIEW_BIN:-$ROOT/ai-claude-review}" doctor || doctor_rc=$?
    "${AI_CODEX_REVIEW_BIN:-$ROOT/ai-codex-review}" doctor || doctor_rc=$?
    exit "$doctor_rc" ;;
  -h|--help|help|'') usage; exit 0 ;;
  *)
    # Every other name is a pool candidate. Eligibility comes from the
    # reviewer registry, never from a hardcoded list: health is not
    # membership, and membership is not health (the lifecycle preflight
    # owns health and quarantine). Unknown names land here too, so the
    # registry — not this case pattern — delivers the refusal.
    REGISTRY=""
    for candidate in "$REAL_DIR/../config/reviewer-registry.json" "$ROOT/../config/reviewer-registry.json"; do
      [ -f "$candidate" ] && REGISTRY="$candidate" && break
    done
    registry_state=""
    [ -z "$REGISTRY" ] || registry_state="$(jq -r --arg p "$1" '.providers[$p].registry_state // "absent"' "$REGISTRY" 2>/dev/null || true)"
    if [ "$registry_state" != "registered" ]; then
      printf 'ai-review: error: %s is not a registered reviewer (registry state: %s). The registry decides the pool; never flip a state to make a review succeed.\n' "${1:-unknown}" "${registry_state:-registry-not-found}" >&2
      exit 2
    fi
    pool_provider="$1"
    # The pool adapter substitution is a TEST HOOK on the approval-gate path:
    # an env swap here would bypass every guarantee the adapter provides, so
    # it requires an explicit AI_POOL_TEST_HOOKS=1 (offline suites set it).
    if [ -n "${AI_REVIEW_POOL_BIN:-}" ] && [ "${AI_POOL_TEST_HOOKS:-0}" != 1 ]; then
      printf 'ai-review: error: AI_REVIEW_POOL_BIN is a test hook; set AI_POOL_TEST_HOOKS=1 to substitute the pool adapter.\n' >&2
      exit 2
    fi
    wrapper="${AI_REVIEW_POOL_BIN:-$ROOT/ai-review-pool}" ;;
esac
shift; mode="${1:-}"; [ "$#" -gt 0 ] && shift
case "$mode" in plan-review|diff-review|security-review|visual-review|final-check) ;; *) usage >&2; exit 2;; esac
detach=0; implementer="${AI_IMPLEMENTER_ENGINE:-}"; reviewer_approval=""; code_only=0; action_profile=""; action_manifest=""; operation=""; paths_file=""; review_base=""; review_head=""; tests_command=""; force_review=0; additional_reviewer=0; wrapper_args=()
[ -n "$pool_provider" ] && wrapper_args+=("$pool_provider")
wrapper_args+=("$mode")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --reviewer-approval)
      [ "$#" -ge 2 ] && [ -f "$2" ] || { usage >&2; exit 2; }
      reviewer_approval="$(realpath -- "$2")"; shift 2 ;;
    --implementer)
      [ "$#" -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || { usage >&2; exit 2; }
      implementer="$2"; shift 2 ;;
    --operation)
      [ "$#" -ge 2 ] && [ -z "$operation" ] || { usage >&2; exit 2; }
      operation="$2"; shift 2 ;;
    --force)
      force_review=1; shift ;;
    --detach)
      detach=1; shift ;;
    --additional-reviewer)
      additional_reviewer=1; shift ;;
    --action-profile|--action-manifest)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
      case "$1" in --action-profile) action_profile="$2" ;; --action-manifest) action_manifest="$2" ;; esac
      shift 2 ;;
    --code-only)
      [ "$code_only" -eq 0 ] || { usage >&2; exit 2; }
      code_only=1; shift ;;
    --paths-file)
      [ "$#" -ge 2 ] && [ -n "$2" ] && [ -z "$paths_file" ] || { usage >&2; exit 2; }
      paths_file="$2"; shift 2 ;;
    --tests|--base|--assert-head)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
      case "$1" in --tests) tests_command="$2" ;; --base) review_base="$2" ;; --assert-head) review_head="$2" ;; esac
      wrapper_args+=("$1" "$2"); shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [ -n "$operation" ]; then
  OP_LIB="$REAL_DIR/../tools/lib/review-operation.sh"; [ -f "$OP_LIB" ] || OP_LIB="$ROOT/../tools/lib/review-operation.sh"
  # shellcheck source=../tools/lib/review-operation.sh
  . "$OP_LIB" || { printf 'ai-review: cannot load the review operation list.\n' >&2; exit 3; }
  review_operation_valid "$operation" || { printf 'ai-review: unknown --operation %s; no reviewer was started.\n' "$operation" >&2; exit 2; }
  [ "$code_only" -eq 0 ] && [ "$mode" = final-check ] || { printf 'ai-review: --operation needs the final-check exact-head review mode.\n' >&2; exit 2; }
fi
# Only an explicit --operation reaches the wrappers; an inherited value never does.
export AI_REVIEW_OPERATION="$operation"
[ -z "$action_profile$action_manifest" ] || { [ "$code_only" -eq 1 ] && [ -n "$action_profile" ] && [ -f "$action_manifest" ] || { usage >&2; exit 2; }; }
[ "$code_only" -eq 1 ] || { [ -z "$paths_file" ] || { usage >&2; exit 2; }; }
# Behaviour capabilities (#1834) come from one registry field, never a name branch.
CAP_LIB="$REAL_DIR/../tools/lib/review-capabilities.sh"; [ -f "$CAP_LIB" ] || CAP_LIB="$ROOT/../tools/lib/review-capabilities.sh"
CAP_JSON="$(dirname "$CAP_LIB")/../../config/review-runner-doors.json"
# shellcheck source=../tools/lib/review-capabilities.sh
. "$CAP_LIB" 2>/dev/null && [ -f "$CAP_JSON" ] || { printf 'ai-review: cannot load the review capability registry.\n' >&2; exit 3; }
# attachment_only_code_review: the provider owns the private --code-only
# attachment route (product invariant), and its ordinary reviews go to the pool.
attachment_route=0
review_capability "$CAP_JSON" "$review_provider" attachment_only_code_review && attachment_route=1
if [ "$attachment_route" = 1 ] && [ "$code_only" -ne 1 ]; then
  # Ordinary DeepSeek reviews dispatch through the shared review runner's
  # OpenCode door, the same pool path as the other rotation reviewers. The
  # --code-only attachment-only route stays below and is chosen only with
  # that flag (private source; see docs/development.md).
  REGISTRY=""
  for candidate in "$REAL_DIR/../config/reviewer-registry.json" "$ROOT/../config/reviewer-registry.json"; do
    [ -f "$candidate" ] && REGISTRY="$candidate" && break
  done
  [ -z "${AI_REVIEW_REGISTRY_FILE:-}" ] || REGISTRY="$AI_REVIEW_REGISTRY_FILE"
  registry_state=""
  [ -z "$REGISTRY" ] || registry_state="$(jq -r --arg p "$review_provider" '.providers[$p].registry_state // "absent"' "$REGISTRY" 2>/dev/null || true)"
  if [ "$registry_state" != "registered" ]; then
    printf 'ai-review: error: %s is not a registered reviewer (registry state: %s). The registry decides the pool; never flip a state to make a review succeed.\n' "$review_provider" "${registry_state:-registry-not-found}" >&2
    exit 2
  fi
  if [ -n "${AI_REVIEW_POOL_BIN:-}" ] && [ "${AI_POOL_TEST_HOOKS:-0}" != 1 ]; then
    printf 'ai-review: error: AI_REVIEW_POOL_BIN is a test hook; set AI_POOL_TEST_HOOKS=1 to substitute the pool adapter.\n' >&2
    exit 2
  fi
  pool_provider="$review_provider"
  wrapper="${AI_REVIEW_POOL_BIN:-$ROOT/ai-review-pool}"
  wrapper_args=("$review_provider" "${wrapper_args[@]}")
fi
# A reviewer that already failed in this calling session is never drawn again
# by it (plan_reviewer-observation-week step 2). Exit 75 when every rotation
# reviewer is skipped (the week's merge gate consumes it), 77 otherwise.
load_skip_lib
if [ -n "$pool_provider" ] && [ "$code_only" -eq 0 ] && skip_has "$AI_CALLER_SESSION_ID" "$pool_provider"; then
  skip_detail="$(skip_reason "$AI_CALLER_SESSION_ID" "$pool_provider")"
  skip_at="${skip_detail#* }"
  skip_when="$(TZ=EST5EDT date -d "$skip_at" '+%-I:%M %p %Z' 2>/dev/null || printf '%s' "$skip_at")"
  printf 'ai-review: %s skipped for this session (%s, %s)\n' "$pool_provider" "${skip_detail%% *}" "$skip_when" >&2
  skip_remaining=""; skip_members=""
  skip_registry="$REAL_DIR/../config/reviewer-registry.json"; [ -z "${AI_REVIEW_REGISTRY_FILE:-}" ] || skip_registry="$AI_REVIEW_REGISTRY_FILE"
  skip_scope="$REAL_DIR/../config/reviewer-membership-scope.json"
  for skip_p in $(jq -r --slurpfile scope "$skip_scope" '.providers|to_entries[]|select(.value.registry_state=="registered")|.key as $k|select(($scope[0].outside_allocator//{})|has($k)|not)|$k' "$skip_registry" 2>/dev/null | tr -d '\r'); do
    skip_members="$skip_members $skip_p"
    skip_has "$AI_CALLER_SESSION_ID" "$skip_p" || skip_remaining="$skip_remaining $skip_p"
  done
  if [ -z "$skip_members" ]; then
    # Fail closed: an unreadable roster is never "every reviewer skipped".
    printf 'ai-review: cannot read the rotation roster; this reviewer stays skipped.\n' >&2
    exit 77
  fi
  if [ -z "$skip_remaining" ]; then
    printf 'ai-review: all reviewers skipped this session\n' >&2
    # The week's merge gate accepts this as the head's review evidence.
    skip_head="$(git rev-parse HEAD 2>/dev/null || true)"
    if [[ "$skip_head" =~ ^[0-9a-f]{40}$ ]] && mkdir -p "$DETACH_DIR" 2>/dev/null; then
      skip_id="s$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM"
      jq -nc --arg id "$skip_id" --arg head "$skip_head" --arg repo "$(git rev-parse --show-toplevel 2>/dev/null)" \
        --arg csid "$AI_CALLER_SESSION_ID" --arg now "$(date -u +%FT%TZ)" \
        '{id:$id,status:"all-skipped",head:$head,repo:$repo,caller_session_id:$csid,at:$now}' > "$DETACH_DIR/$skip_id.json" 2>/dev/null || true
    fi
    exit 75
  fi
  printf 'ai-review: reviewers not skipped this session:%s\n' "$skip_remaining" >&2
  exit 77
fi
if [ "$detach" = 1 ] && { [ -z "$pool_provider" ] || [ "$code_only" -ne 0 ]; }; then
  printf 'ai-review: --detach applies only to pool reviewers.\n' >&2; exit 2
fi
# --detach (step 3): everything a review does today still happens (receipt,
# packet, sandbox, verdict record, incident package); only the caller stops
# waiting. The same front door re-runs without --detach in the background.
maybe_detach(){
  [ "$detach" = 1 ] || return 0
  local id rec log a; local -a child_args=()
  for a in "${orig_args[@]}"; do [ "$a" = --detach ] || child_args+=("$a"); done
  id="d$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM"
  mkdir -p "$DETACH_DIR" || { printf 'ai-review: cannot create the detached run store.\n' >&2; exit 3; }
  rec="$DETACH_DIR/$id.json"; log="$DETACH_DIR/$id.log"
  jq -nc --arg id "$id" --arg p "$pool_provider" --arg m "$mode" --arg repo "$(git rev-parse --show-toplevel 2>/dev/null)" --arg head "$(git rev-parse HEAD 2>/dev/null)" \
    --arg csid "$AI_CALLER_SESSION_ID" --arg log "$log" --arg now "$(date -u +%FT%TZ)" \
    '{id:$id,status:"pending",provider:$p,mode:$m,repo:$repo,head:$head,caller_session_id:$csid,log:$log,started_at:$now}' > "$rec"
  local self; self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "$0")"
  local launcher=(nohup); command -v setsid >/dev/null 2>&1 && launcher=(setsid nohup)
  # This process's session temp root is deleted when it exits; the detached
  # run must make its own.
  if [ -n "${AI_SESSION_TMP_ROOT:-}" ] && [ "${TMPDIR:-}" = "$AI_SESSION_TMP_ROOT" ]; then
    launcher=(env -u TMPDIR -u TMP -u TEMP -u AI_SESSION_TMP_ROOT "${launcher[@]}")
  fi
  AI_REVIEW_DETACH_ID="$id" AI_REVIEW_DETACH_BASE="$DETACH_DIR/$id" \
  "${launcher[@]}" bash -c '
    base="$AI_REVIEW_DETACH_BASE"; printf "%s\n" "$$" > "$base.pid"
    out="$(mktemp)"
    "$@" > "$out"; rc=$?
    cat "$out"; report="$(tail -n 1 "$out" | tr -d "\r")"; rm -f "$out"
    jq -nc --argjson rc "$rc" --arg report "$report" --arg now "$(date -u +%FT%TZ)" \
      "{exit_code:\$rc,report:(if \$report==\"\" then null else \$report end),finished_at:\$now}" > "$base.result.tmp" \
      && mv -f "$base.result.tmp" "$base.result.json"
  ' ai-review-detached "$self" "${child_args[@]}" > "$log" 2>&1 < /dev/null &
  printf 'ai-review: detached %s %s run %s; read it with: ai-review outcome %s\n' "$pool_provider" "$mode" "$id" "$id" >&2
  printf '%s\n' "$id"
  exit 0
}
# Detach before the slower checks: the background run repeats every one of
# them, and a refusal there is reported by ai-review outcome as BLOCKED.
maybe_detach
# --force (#1428) only means something to the pool adapter: it bypasses the
# reuse of an earlier passing report for the same reviewer, mode and source.
if [ "$force_review" = 1 ]; then
  [ -n "$pool_provider" ] && [ "$code_only" -eq 0 ] || { printf 'ai-review: --force applies only to pool reviewers.\n' >&2; exit 2; }
  wrapper_args+=(--force)
fi
[ "$additional_reviewer" = 0 ] || { [ -n "$pool_provider" ] && [ "$code_only" -eq 0 ]; } \
  || { printf 'ai-review: --additional-reviewer applies only to pool reviewers.\n' >&2; exit 2; }
# No extra reviewer on a head that already passed (#1429). When ANY reviewer
# already holds a verified APPROVE for this exact head, whole-source digest,
# mode and base, that pass is returned instead of starting another paid
# review. --additional-reviewer (a second opinion on purpose, which also
# bypasses the pool's same-reviewer reuse) and --force dispatch anyway;
# --tests, --operation, --reviewer-approval and a carried brief ask a different question and
# are never answered from an earlier pass. A lookup error dispatches normally
# and says so. It is CALLED only after the inherited Git locations are
# cleared, the implementer is resolved, and the private-source check and task
# gate ran (plan reviews are never gated), so a pass is never bound to
# another tree.
return_existing_pass(){
  # A governed caller (shared-db) needs THIS provider's own fresh decision and
  # the source receipt only a fresh run publishes; handing it another
  # reviewer's earlier pass left the receipt missing (#1783).
  [ -z "${AI_REVIEW_SOURCE_RECEIPT_FILE:-}" ] || return 0
  { [ -n "$pool_provider" ] && [ "$code_only" -eq 0 ] && [ "$additional_reviewer" = 0 ] && [ "$force_review" = 0 ] \
    && [ -z "$tests_command" ] && [ -z "$operation" ] && [ -z "$reviewer_approval" ] \
    && [ -z "${AI_REVIEW_BRIEF_FILE:-}" ]; } || return 0
  local passed_repo passed_rc=3 passed_json="" passed_report passed_by
  passed_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$passed_repo" ] && { [ -z "$review_head" ] || [ "$(git rev-parse --verify --quiet --end-of-options "$review_head^{commit}" 2>/dev/null)" = "$(git rev-parse HEAD 2>/dev/null)" ]; }; then
    passed_json="$(AI_REVIEW_IMPLEMENTER="$implementer" "$REAL_DIR/ai-review-preflight" passed-head "$passed_repo" "$mode" ${review_base:+--base "$review_base"} 2>/dev/null)" && passed_rc=0 || passed_rc=$?
  fi
  case "$passed_rc" in
    0)
      passed_report="$(jq -r '.report // empty' <<<"$passed_json" 2>/dev/null || true)"
      passed_by="$(jq -r '.provider // empty' <<<"$passed_json" 2>/dev/null || true)"
      if [ -n "$passed_report" ]; then
        printf 'ai-review: this exact head already passed %s review by %s; returning that pass instead of a new reviewer. Pass --additional-reviewer for another reviewer.\n' "$mode" "$passed_by" >&2
        printf '%s\n' "$passed_report"
        exit 0
      fi ;;
    1) ;;
    *) printf 'ai-review: passed-head lookup unavailable; dispatching the requested reviewer.\n' >&2 ;;
  esac
}
# An explicit additional reviewer must also skip the pool's own reuse.
[ "$additional_reviewer" = 0 ] || [ "$force_review" = 1 ] || wrapper_args+=(--force)
[ -z "${AI_REVIEW_SOURCE_RECEIPT_FILE:-}" ] || [ -z "$pool_provider" ] || [ "$code_only" -ne 0 ] || [ "$force_review" = 1 ] \
  || [ "$additional_reviewer" = 1 ] || wrapper_args+=(--force)
if [ "$code_only" -eq 1 ]; then
  [ "$attachment_route" = 1 ] || { printf 'ai-review: code-only mode requires the attachment-only DeepSeek reviewer.\n' >&2; exit 2; }
  jq -e --arg p "$review_provider" '.providers[$p].registry_state == "registered"' "$REAL_DIR/../config/reviewer-registry.json" >/dev/null 2>&1 || { printf 'ai-review: DeepSeek is not currently registered for review.\n' >&2; exit 3; }
  case "$mode" in diff-review|security-review|final-check) ;; *) usage >&2; exit 2 ;; esac
  [ -n "$paths_file" ] && [ -f "$paths_file" ] && [ -z "$tests_command" ] || {
    printf 'ai-review: code-only review requires an exact JSON paths file and does not accept a tests command.\n' >&2
    exit 2
  }
  paths_file="$(cd "$(dirname "$paths_file")" && pwd -P)/$(basename "$paths_file")"
fi
SANDBOX="$REAL_DIR/ai-review-sandbox"
# Git location variables override `git -C` and would aim every later Git call —
# source resolution, the synthetic export's head capture, the packet build, and
# the provider launch — at whatever repository a hook or wrapper inherited,
# binding the sealed verdict to the wrong tree. This front door reviews the
# checkout it was invoked in; inherited locations are stripped whole
# (exact-head review, 2026-09-25).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_ALTERNATE_OBJECT_DIRECTORIES
# Generic pay-per-use API keys never reach a reviewer: each reviewer uses its
# subscription login or its own protected store (owner lock 2026-10-07, #1427).
unset OPENAI_API_KEY CODEX_API_KEY GEMINI_API_KEY GOOGLE_API_KEY AI_GEMINI_KEY AI_QWEN_KEY ANTHROPIC_API_KEY
source_root="$(git rev-parse --show-toplevel 2>/dev/null)" || { printf 'ai-review: cannot resolve the source repository.\n' >&2; exit 3; }
if "$SANDBOX" is-private "$source_root" >/dev/null; then
  private_source=1
else
  private_rc=$?
  [ "$private_rc" -eq 1 ] || { printf 'ai-review: private-source classification failed; no reviewer was started.\n' >&2; exit 3; }
  private_source=0
fi
# A retained code-only export contains only approved code, so it classifies
# public — but it stands in for a private source and its sidecars point back
# at the original tree, so a directory-bound CLI reviewer launched inside it
# is refused exactly like the private source it represents (exact-head
# review, 2026-09-25).
if [ "$private_source" -eq 0 ] && [ -f "$source_root/.ai-review-sandbox" ] \
  && jq -e '.mode == "code-only"' "$source_root/.ai-review-sandbox" >/dev/null 2>&1; then
  private_source=1
fi
if [ "$private_source" -eq 1 ] && [ "$code_only" -ne 1 ]; then
  printf 'ai-review: private source requires the code-only attachment route; no reviewer was started.\n' >&2
  exit 3
fi
# The approval gate is the front door, so the task gate belongs here: a review
# the change set does not call for must not reach a provider wrapper at all.
GATE_LIB=""
for candidate in "$REAL_DIR/.." "$ROOT/.."; do
  [ -f "$candidate/tools/lib/task-gates.sh" ] || continue
  GATE_LIB="$(cd "$candidate" && pwd)/tools/lib/task-gates.sh"
  break
done
[ -n "$GATE_LIB" ] || { printf 'ai-review: cannot find the task-gate library; no reviewer was started.\n' >&2; exit 3; }
# shellcheck source=../tools/lib/task-gates.sh
. "$GATE_LIB"
# The provider wrappers call `ai-review-lifecycle begin`, which runs the gate
# again. It cannot see the mode or the reviewer approval from there, so hand both
# on. This is the only supported front door, so this is the only place they
# can come from.
export AI_REVIEW_GATE_MODE="$mode"
# The implementing engine is recorded on the lifecycle row so a reviewer
# approval can prove the reviewer engine differs from it (#996). The wrapper
# `caller` label is session isolation, not engine identity.
if [ -z "$implementer" ]; then
  if [ "${CLAUDECODE:-}" = 1 ]; then implementer=claude
  elif [ -n "${CODEX_THREAD_ID:-}${CODEX_SANDBOX:-}" ]; then implementer=codex
  fi
fi
export AI_REVIEW_IMPLEMENTER="$implementer"
export AI_REVIEW_REVIEWER_APPROVAL="$reviewer_approval"
# A plan review runs before the work exists and is how a session decides what
# the work is. Gating it on the class of a change set that has not been
# written yet would refuse the very step that sets the class.
sweep_orphans() {
  # Parent orphan sweep (issue #711 Phase 3): a killed wrapper never runs its
  # cleanup trap, so every supported dispatch sweeps managed review snapshots
  # past the orphan age on its way in. Bounded, best-effort (it cannot refuse
  # or delay the review), logged on stderr, and never run under
  # AI_DEVOPS_TEST_MODE so offline suites keep the machine-global sandbox root
  # untouched. Hard-pinned here, not env-substitutable: this is the
  # approval-gate path, and a swapped sweep binary must not be reachable by an
  # environment variable.
  [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] && return 0
  "$REAL_DIR/ai-review-sandbox" sweep-orphans || true
}
if [ "$mode" = plan-review ]; then return_existing_pass; sweep_orphans; exec "$wrapper" "${wrapper_args[@]}"; fi
# The sealed attachment-only route is its own gate action: the formal review
# action stays forbidden for private classes, while code-only-review opens only
# when the repository's own declaration carries the synthetic-fixtures-only
# boundary that route promises.
gate_action=review
[ "$code_only" -eq 0 ] || gate_action=code-only-review
gate_args=()
[ -z "$reviewer_approval" ] || gate_args=(--reviewer-approval "$reviewer_approval")
tg_preflight_gate "$gate_action" "${gate_args[@]+"${gate_args[@]}"}" || { printf 'ai-review: no reviewer was started.\n' >&2; exit 3; }
return_existing_pass
sweep_orphans
if [ "$code_only" -eq 1 ]; then
  native_code_only=0
  if python3 -c 'import os; raise SystemExit(0 if os.name == "posix" and hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY") else 1)'; then native_code_only=1; fi
  if [ -n "$action_profile" ] && ! python3 -c 'import os, sys; raise SystemExit(0 if sys.platform == "linux" and os.name == "posix" and hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY") else 1)'; then
    printf 'ai-review: isolated action profile requires supported Linux custody; no export or reviewer was started.\n' >&2
    exit 3
  fi
  umask 077
  # The private source never becomes a provider working directory. The exporter
  # admits only explicitly selected code and binds it to the full source state.
  source_head="$(git -C "$source_root" rev-parse HEAD 2>/dev/null)" || { printf 'ai-review: cannot resolve the source HEAD.\n' >&2; exit 3; }
  [ -z "$review_head" ] || [ "$review_head" = "$source_head" ] || { printf 'ai-review: original HEAD differs from --assert-head.\n' >&2; exit 3; }
  tag="code-only-$(date +%s)-$$-$RANDOM"
  export_args=(ensure-code-only "$source_root" "$tag" --paths-file "$paths_file")
  [ -z "$review_base" ] || export_args+=(--base "$review_base")
  [[ "$action_profile" != oracle-native-alternate-serialization-v1 && "$action_profile" != oracle-native-alternate-serialization-v2 ]] || export_args+=(--action-profile "$action_profile")
  snapshot="$("$SANDBOX" "${export_args[@]}")" || { printf 'ai-review: code-only export refused; no reviewer was started.\n' >&2; exit 3; }
  "$SANDBOX" verify-code-only "$snapshot" --assert-head "$source_head" >/dev/null || { "$SANDBOX" remove-code-only "$snapshot" >/dev/null 2>&1 || true; printf 'ai-review: code-only source verification refused; no reviewer was started.\n' >&2; exit 3; }
  synthetic_head="$(git -C "$snapshot" rev-parse HEAD 2>/dev/null)" || { "$SANDBOX" remove-code-only "$snapshot" >/dev/null 2>&1 || true; printf 'ai-review: code-only export has no HEAD.\n' >&2; exit 3; }
  case "$mode" in
    diff-review) code_prompt='Review the exact selected code change for correctness and regressions. Use only the attached synthetic packet. State concrete findings with file and line evidence.' ;;
    security-review) code_prompt='Review the exact selected code change for security, data leakage, permissions, and trust-boundary defects. Use only the attached synthetic packet. State concrete findings with file and line evidence.' ;;
    final-check) code_prompt='Perform a final correctness and security check of the exact selected code change. Use only the attached synthetic packet. State concrete findings with file and line evidence.' ;;
  esac
  code_prompt="$code_prompt Original source HEAD: $source_head. Synthetic review HEAD: $synthetic_head. Cite both identities in your findings."
  if [ "$native_code_only" -eq 0 ]; then
    printf 'ai-review: selected-code advisory review only on this platform; no original-source lifecycle or action authority.\n' >&2
    result_file="$(mktemp)" || exit 3
    trap 'rm -f -- "$result_file"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if ( cd "$snapshot" && AI_DEEPSEEK_CALLER="$implementer" "$wrapper" send "$code_prompt" --review --model deepseek-flash --base HEAD~1 --assert-head "$synthetic_head" --governed-verdict "$synthetic_head" ) > "$result_file"; then provider_rc=0; else provider_rc=$?; fi
    "$SANDBOX" verify-code-only "$snapshot" --assert-head "$source_head" >/dev/null || { rm -f "$result_file"; printf 'ai-review: source or export changed; advisory verdict refused.\n' >&2; exit 3; }
    if [ "$provider_rc" -ne 0 ]; then rm -f "$result_file"; exit "$provider_rc"; fi
    grep -Fxq "VERDICT: APPROVE $synthetic_head" "$result_file" || { cat "$result_file"; rm -f "$result_file"; printf 'ai-review: selected-code advisory returned a non-approving verdict.\n' >&2; exit 3; }
    cat "$result_file"; rm -f "$result_file"
    exit 0
  fi
  lifecycle="$REAL_DIR/ai-review-lifecycle"
  lifecycle_args=(begin --provider "$review_provider" --repo "$source_root" --run-id "$tag" --caller "$implementer" --code-only-export "$snapshot")
  [ -z "$action_profile" ] || lifecycle_args+=(--action-profile "$action_profile" --action-manifest "$action_manifest")
  lifecycle_state="$(AI_REVIEW_LIFECYCLE_OWNER_PID=$$ "$lifecycle" "${lifecycle_args[@]}")" || { printf 'ai-review: prospective original-source lifecycle refused; no reviewer was started.\n' >&2; exit 3; }
  if [ -n "$action_profile" ]; then
    descriptor="$(jq -r .action_profile_binding.manifest_descriptor_sha256 "$lifecycle_state")"
    target_identity="$(jq -r .action_profile_binding.target_ref_sha256 "$lifecycle_state")"
    if [[ "$action_profile" = oracle-native-alternate-serialization-v1 || "$action_profile" = oracle-native-alternate-serialization-v2 ]]; then
      oracle_prompt_script=oracle_native_alternate_profile.py
      [ "$action_profile" != oracle-native-alternate-serialization-v2 ] || oracle_prompt_script=oracle_native_alternate_v2_profile.py
      code_prompt="$code_prompt $(python3 "$REAL_DIR/../tools/$oracle_prompt_script" prompt "$lifecycle_state")"
    else
    code_prompt="$code_prompt Review approval is requested ONLY for action profile $action_profile, database rehearsal on isolated destination identity sha256:$target_identity schema dflow_prod, entrypoint scripts/cutover-rehearsal/orchestrator.py, TIMING_ONLY, credentials disabled, no application callback, mandatory original restoration. Private operational inputs were validated locally and are not attached. Exact canonical operational descriptor sha256: $descriptor. Approval never authorizes production or grants root action permission. If approving, include the exact standalone line: Action scope: $action_profile descriptor sha256:$descriptor."
    fi
  fi
  lifecycle_started=$SECONDS
  result_file=""; error_file=""; diagnostics_printed=0
  code_only_abort() {
    "$lifecycle" fail --state "$lifecycle_state" --elapsed "$((SECONDS-lifecycle_started))" --failure incomplete-code-only-invocation >/dev/null 2>&1 || true
    if [ "$diagnostics_printed" -eq 0 ] && [ -s "$error_file" ]; then cat "$error_file" >&2 || true; fi
    rm -f -- "$result_file" "$error_file"
  }
  trap code_only_abort EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  action_evidence_args=()
  if [ -n "$action_profile" ]; then
    action_review_evidence_args || { printf 'ai-review: installed public action-scope evidence unavailable; no provider was dispatched.\n' >&2; exit 3; }
    action_evidence_dir="$(mktemp -d "$snapshot/.ai-review-action-scope.XXXXXXXX")" || exit 3
    action_evidence_file="$action_evidence_dir/evidence.json"
    python3 "$REAL_DIR/../tools/review_action_profile.py" evidence "$lifecycle_state" --manifest "$action_manifest" --profile "$action_profile" > "$action_evidence_file" || { printf 'ai-review: native private action evidence refused; no provider was dispatched.\n' >&2; exit 3; }
    action_evidence_sha256="$(sha256sum "$action_evidence_file" | cut -d' ' -f1)" || exit 3
    action_evidence_args+=(--file "$action_evidence_file")
    code_prompt="$code_prompt The additional attachments are the actual installed public enforcement implementation and profile; they contain no private operational inputs. Inspect their scope validation, immutable input/target binding and fail-closed admission rather than treating generic rehearsal capability as permission to issue credentials or invoke an application."
    if [[ "$action_profile" = oracle-native-alternate-serialization-v1 || "$action_profile" = oracle-native-alternate-serialization-v2 ]]; then
      code_prompt="$code_prompt Attached Oracle facts are stat/metadata only; capture byte hashes are claimed and unverified before approved execution. Both current-purpose registration and one-use action approval must be explicitly scoped. No private control values or capture bytes are attached."
    else
    code_prompt="$code_prompt The attached native-validated-private-action-commitment is an allowlisted non-authorizing projection produced after fresh native validation of all actual private inputs. Its opaque descriptor commitment is intentionally not remotely recomputable: private values remain local. Judge whether the reviewed implementation and attached enforcement safely constrain that committed action. Any approval is conditional on the native finish and initial-forward/original-restoration checks revalidating the same commitment, genuine provider completion and installed profile; it is neither independent remote inspection of private values nor evidence of a rehearsal already run. The future provider completion/admission receipts do not exist before your verdict. Do not request private manifests, credentials or row data; withhold approval if the conditional enforcement is insufficient."
    fi
  fi
  result_file="$(mktemp)" || { printf 'ai-review: cannot reserve private review output.\n' >&2; exit 3; }
  error_file="$(mktemp)" || { printf 'ai-review: cannot reserve private reviewer diagnostics.\n' >&2; exit 3; }
  if ( cd "$snapshot" && AI_DEEPSEEK_CALLER="$implementer" "$wrapper" send "$code_prompt" "${action_evidence_args[@]+"${action_evidence_args[@]}"}" --review --model deepseek-flash --base HEAD~1 --assert-head "$synthetic_head" --governed-verdict "$synthetic_head" ) > "$result_file" 2>"$error_file"; then provider_rc=0; else provider_rc=$?; fi
  cat "$error_file" >&2
  diagnostics_printed=1
  if [ -n "$action_profile" ] && [ "$(sha256sum "$action_evidence_file" | cut -d' ' -f1)" != "$action_evidence_sha256" ]; then
    printf 'ai-review: native action evidence changed during review; verdict refused.\n' >&2
    exit 3
  fi
  # DeepSeek retains its packet and transcript under this sanitized repository.
  # Keep it after dispatch, including a failed or stale response, for recovery.
  "$SANDBOX" verify-code-only "$snapshot" --assert-head "$source_head" >/dev/null || { rm -f "$result_file"; printf 'ai-review: source or export changed during code-only review; verdict refused. Retained evidence: %s\n' "$snapshot" >&2; exit 3; }
  if [ "$provider_rc" -ne 0 ]; then
    rm -f "$result_file"
    printf 'ai-review: reviewer did not return an authorizing verdict. Retained evidence: %s\n' "$snapshot" >&2
    exit "$provider_rc"
  fi
  provider_session="$(sed -n 's/^SESSION_ID: //p' "$error_file")"
  report_file="$snapshot/.ai-review-lifecycle/$tag/report.txt"
  completion="$(python3 "$REAL_DIR/ai-review-code-only.py" lifecycle-proof "$lifecycle_state" "$provider_session" "$report_file" --publish "$result_file")" || { printf 'ai-review: native provider completion proof refused; verdict has no authority.\n' >&2; exit 3; }
  terminal_state="$("$lifecycle" finish --state "$lifecycle_state" --provider-session "$provider_session" --verdict "$(jq -r .verdict <<<"$completion")" --report "$report_file" --elapsed "$((SECONDS-lifecycle_started))")" || exit 3
  # The lifecycle is already terminal; retain it while cleaning standalone IO.
  trap 'rm -f -- "$result_file" "$error_file"' EXIT
  jq -e '.status=="completed" and .stale==false and .verdict=="APPROVE"' <<<"$terminal_state" >/dev/null || { printf 'ai-review: completed review is non-authorizing.\n' >&2; exit 3; }
  printf 'Original-source lifecycle report: %s\n' "$report_file" >&2
  cat "$result_file" || { rm -f "$result_file"; printf 'ai-review: could not publish verified review output.\n' >&2; exit 3; }
  rm -f "$result_file" "$error_file"
  exit 0
fi
exec "$wrapper" "${wrapper_args[@]}"
