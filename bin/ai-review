#!/usr/bin/env bash
# ai-review — the only supported approval-gate front door.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
usage(){ printf '%s\n' 'Usage: ai-review <provider> <plan-review|diff-review|security-review|visual-review|final-check> [--tests CMD] [--base REF] [--assert-head SHA]' '       ai-review <provider> <mode> --owner-request "<why Albert asked for it>" [review options]' '       Providers: claude|codex (full mode wrappers) plus every reviewer registered in config/reviewer-registry.json (grok, muse, qwen, gemini; pool adapter, read-only session runners).' '       ai-review doctor'; }
# bin/* is symlinked onto PATH, so resolve the real script location before
# looking for the repository's own files; $SCRIPT_DIR is the symlink directory.
REAL_DIR="$ROOT"
if command -v readlink >/dev/null 2>&1; then
  REAL_DIR_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -z "$REAL_DIR_SOURCE" ] || REAL_DIR="$(cd "$(dirname "$REAL_DIR_SOURCE")" && pwd)"
fi
# Phase 3 orphan sweep (issue #711): parents drop abandoned review snapshots
# before starting a new one. Bounded (sandbox root only) and best-effort —
# never fails or delays the approval path. Housekeeping only: not the evidence
# AI_REVIEW_SANDBOX_BIN hook.
"$REAL_DIR/ai-review-sandbox" sweep-orphans || true
pool_provider=""
case "${1:-}" in
  claude) wrapper="${AI_CLAUDE_REVIEW_BIN:-$ROOT/ai-claude-review}" ;;
  codex) wrapper="${AI_CODEX_REVIEW_BIN:-$ROOT/ai-codex-review}" ;;
  doctor) "$ROOT/ai-claude-review" doctor; "$ROOT/ai-codex-review" doctor; exit 0 ;;
  -h|--help|help|'') usage; exit 0 ;;
  *)
    # Every other name is a pool candidate. Eligibility comes from the
    # reviewer registry, never from a hardcoded list: health is not
    # membership, and membership is not health (the lifecycle preflight
    # owns health and quarantine). Unknown names land here too, so the
    # registry — not this case pattern — delivers the refusal.
    REGISTRY=""
    for candidate in "$REAL_DIR/../config/reviewer-registry.json" "$ROOT/../config/reviewer-registry.json"; do
      [ -f "$candidate" ] && REGISTRY="$candidate" && break
    done
    registry_state=""
    [ -z "$REGISTRY" ] || registry_state="$(jq -r --arg p "$1" '.providers[$p].registry_state // "absent"' "$REGISTRY" 2>/dev/null || true)"
    if [ "$registry_state" != "registered" ]; then
      printf 'ai-review: error: %s is not a registered reviewer (registry state: %s). The registry decides the pool; never flip a state to make a review succeed.\n' "${1:-unknown}" "${registry_state:-registry-not-found}" >&2
      exit 2
    fi
    pool_provider="$1"
    # The pool adapter substitution is a TEST HOOK on the approval-gate path:
    # an env swap here would bypass every guarantee the adapter provides, so
    # it requires an explicit AI_POOL_TEST_HOOKS=1 (offline suites set it).
    if [ -n "${AI_REVIEW_POOL_BIN:-}" ] && [ "${AI_POOL_TEST_HOOKS:-0}" != 1 ]; then
      printf 'ai-review: error: AI_REVIEW_POOL_BIN is a test hook; set AI_POOL_TEST_HOOKS=1 to substitute the pool adapter.\n' >&2
      exit 2
    fi
    wrapper="${AI_REVIEW_POOL_BIN:-$ROOT/ai-review-pool}" ;;
esac
shift; mode="${1:-}"; [ "$#" -gt 0 ] && shift
case "$mode" in plan-review|diff-review|security-review|visual-review|final-check) ;; *) usage >&2; exit 2;; esac
owner_request=""; wrapper_args=()
[ -n "$pool_provider" ] && wrapper_args+=("$pool_provider")
wrapper_args+=("$mode")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --owner-request)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
      owner_request="$2"; shift 2 ;;
    --tests|--base|--assert-head)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
      wrapper_args+=("$1" "$2"); shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
# The approval gate is the front door, so the task gate belongs here: a review
# the change set does not call for must not reach a provider wrapper at all.
GATE_LIB=""
for candidate in "$REAL_DIR/.." "$ROOT/.."; do
  [ -f "$candidate/tools/lib/task-gates.sh" ] || continue
  GATE_LIB="$(cd "$candidate" && pwd)/tools/lib/task-gates.sh"
  break
done
[ -n "$GATE_LIB" ] || { printf 'ai-review: cannot find the task-gate library; no reviewer was started.\n' >&2; exit 3; }
# shellcheck source=../tools/lib/task-gates.sh
. "$GATE_LIB"
# The provider wrappers call `ai-review-lifecycle begin`, which runs the gate
# again. It cannot see the mode or the owner request from there, so hand both
# on. This is the only supported front door, so this is the only place they
# can come from.
export AI_REVIEW_GATE_MODE="$mode"
export AI_REVIEW_OWNER_REQUEST="$owner_request"
# A plan review runs before the work exists and is how a session decides what
# the work is. Gating it on the class of a change set that has not been
# written yet would refuse the very step that sets the class.
if [ "$mode" = plan-review ]; then exec "$wrapper" "${wrapper_args[@]}"; fi
gate_args=()
[ -z "$owner_request" ] || gate_args=(--owner-request "$owner_request")
tg_preflight_gate review "${gate_args[@]+"${gate_args[@]}"}" || { printf 'ai-review: no reviewer was started.\n' >&2; exit 3; }
exec "$wrapper" "${wrapper_args[@]}"
