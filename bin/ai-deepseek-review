#!/usr/bin/env bash
# ai-deepseek-review — read-only DeepSeek second-opinion code review.
#
# Usage:
#   ai-deepseek-review diff-review
#   ai-deepseek-review security-review
#   ai-deepseek-review final-check
#
# Behaviour mirrors bin/ai-codex-review, but sends the review to the DeepSeek
# API (OpenAI-compatible /chat/completions) instead of running a local CLI
# agent. Reviews are READ-ONLY: this script never commits, pushes, merges, or
# deletes anything, and instructs the model to do the same.
#
# Secret handling follows the ai-glm-agent pattern: if DEEPSEEK_API_KEY is not
# already in the environment, self-resolve it from 1Password via the shared
# ~/.config/ai-devops/mcp.env reference file and re-exec once under `op run`.

set -uo pipefail

MODE="${1:-}"
CFG_DIR="${AI_DEVOPS_CONFIG_DIR:-$HOME/.config/ai-devops}"
TOKEN_FILE="$CFG_DIR/op-service-account"
MCP_ENV="$CFG_DIR/mcp.env"
MODEL="${DEEPSEEK_MODEL:-deepseek-chat}"
BASE_URL="${DEEPSEEK_BASE_URL:-https://api.deepseek.com}"

usage() {
  cat <<EOF
Usage: ai-deepseek-review <mode>

Modes:
  diff-review       Review the current git diff
  security-review   Security-focused review of the current diff
  final-check       Final go/no-go readiness review

Reviews are read-only. Output is saved under .ai/reviews/ and printed.
EOF
}

case "$MODE" in
  diff-review|security-review|final-check) ;;
  ""|-h|--help|help) usage; exit 0 ;;
  *) echo "Unknown mode: $MODE" >&2; echo >&2; usage >&2; exit 2 ;;
esac

# --- Resolve DEEPSEEK_API_KEY from 1Password if not already in the environment ---
if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
  if [ -n "${AI_DEEPSEEK_REEXEC:-}" ]; then
    echo "Error: DEEPSEEK_API_KEY resolved EMPTY from $MCP_ENV after 'op run'." >&2
    echo "       Check the DEEPSEEK_API_KEY reference in config/mcp.env.example." >&2
    exit 1
  fi
  command -v op >/dev/null 2>&1 || { echo "Error: 1Password CLI (op) is required." >&2; exit 1; }
  [ -s "$TOKEN_FILE" ] || { echo "Error: missing 1Password service-account token file: $TOKEN_FILE" >&2; exit 1; }
  [ -f "$MCP_ENV" ] || { echo "Error: missing managed 1Password reference file: $MCP_ENV" >&2; exit 1; }
  export OP_SERVICE_ACCOUNT_TOKEN AI_DEEPSEEK_REEXEC=1
  OP_SERVICE_ACCOUNT_TOKEN="$(<"$TOKEN_FILE")"
  exec op run --env-file "$MCP_ENV" -- "$0" "$MODE"
fi

command -v curl >/dev/null 2>&1 || { echo "Error: curl is required." >&2; exit 1; }

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ai-deepseek-review must be run inside a git repository." >&2
  exit 1
fi
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

REVIEW_DIR="$REPO_ROOT/.ai/reviews"
mkdir -p "$REVIEW_DIR"
TS="$(date +%Y%m%d-%H%M%S)"
OUT="$REVIEW_DIR/${TS}-deepseek-${MODE}.md"

DIFF="$(git --no-pager diff HEAD 2>/dev/null)"
if [ -z "$DIFF" ]; then
  echo "No staged/unstaged changes vs HEAD; nothing to review." >&2
  exit 0
fi

READONLY_GUARD='You are performing a READ-ONLY review. Do not instruct anyone to run commands that modify files; only produce the written review below.'

case "$MODE" in
  diff-review)
    INSTRUCT="Review this git DIFF. Focus on correctness, regressions, missing tests, and general code quality. End with a verdict: APPROVE / APPROVE WITH CHANGES / BLOCK."
    ;;
  security-review)
    INSTRUCT="Perform a SECURITY-ONLY review of this diff: auth bypass, data leakage, unsafe SQL, secrets committed in code, unsafe file access, and permission mistakes. List concrete findings with severity. End with a verdict: APPROVE / APPROVE WITH CHANGES / BLOCK."
    ;;
  final-check)
    INSTRUCT="Perform a FINAL go/no-go readiness check on this diff. Summarize remaining risks and give a clear GO or NO-GO with reasons."
    ;;
esac

PROMPT="$READONLY_GUARD

Repository: $REPO_ROOT
Review mode: $MODE

$INSTRUCT

--- DIFF ---
$DIFF
--- END DIFF ---"

PYTHON=""
if command -v python3 >/dev/null 2>&1; then PYTHON=python3; elif command -v python >/dev/null 2>&1; then PYTHON=python; fi
[ -n "$PYTHON" ] || { echo "Error: Python is required to call the DeepSeek API." >&2; exit 1; }

echo "Running DeepSeek review ($MODE) against $MODEL..." >&2

REQUEST_FILE="$(mktemp)"
RESPONSE_FILE="$(mktemp)"
trap 'rm -f "$REQUEST_FILE" "$RESPONSE_FILE"' EXIT

MODEL="$MODEL" "$PYTHON" - "$PROMPT" > "$REQUEST_FILE" <<'PY'
import json, os, sys
print(json.dumps({
  "model": os.environ["MODEL"],
  "messages": [{"role": "user", "content": sys.argv[1]}],
  "stream": False,
}))
PY

HTTP_CODE="$(curl -sS -o "$RESPONSE_FILE" -w '%{http_code}' \
  "$BASE_URL/chat/completions" \
  -H "Authorization: Bearer $DEEPSEEK_API_KEY" \
  -H "Content-Type: application/json" \
  -d @"$REQUEST_FILE")"

if [ "$HTTP_CODE" != "200" ]; then
  echo "Error: DeepSeek API returned HTTP $HTTP_CODE:" >&2
  cat "$RESPONSE_FILE" >&2
  exit 1
fi

REVIEW_TEXT="$("$PYTHON" -c '
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
print(data["choices"][0]["message"]["content"])
' "$RESPONSE_FILE")"

{
  echo "# DeepSeek review - $MODE"
  echo
  echo "- Repo: \`$REPO_ROOT\`"
  echo "- Branch: \`$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\`"
  echo "- Timestamp: $TS"
  echo "- Model: \`$MODEL\`"
  echo
  echo "---"
  echo
  echo "$REVIEW_TEXT"
} > "$OUT"

echo "$OUT"