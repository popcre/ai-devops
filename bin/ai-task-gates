#!/usr/bin/env bash
# ai-task-gates — declare a task class, then prove the real change set still
# matches it before anything expensive or risky starts.
#
# The problem this solves: prose describing a gate does not stop a session from
# selecting a stronger gate than its diff needs, and nothing durable records
# "this is a documentation-only task" so the claim can be rechecked later.
#
#   ai-task-gates start --class prose --reason "trim AGENTS.md"
#   ai-task-gates check --before review
#
# `check` recomputes the complete working change set — committed branch changes
# plus staged, unstaged, untracked, deleted, both sides of a rename, and
# submodule changes — resolves the central contract plus any consumer
# declaration, and refuses to let the protected action start on a mismatch.
#
# Exit status
#   0  allowed
#   1  usage or internal error
#   3  blocked: a stronger gate is required, or the action is forbidden
#   4  cannot classify: fail closed
set -uo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# bin/* is symlinked onto PATH, so resolve the real script location before
# looking for the repository's own files; $SCRIPT_DIR is the symlink directory.
REAL_DIR="$SCRIPT_DIR"
if command -v readlink >/dev/null 2>&1; then
  REAL_DIR_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -z "$REAL_DIR_SOURCE" ] || REAL_DIR="$(cd "$(dirname "$REAL_DIR_SOURCE")" && pwd)"
fi
ROOT=""
for candidate in "$REAL_DIR/.." "$SCRIPT_DIR/.."; do
  [ -f "$candidate/tools/lib/task-gates.sh" ] || continue
  ROOT="$(cd "$candidate" && pwd)"
  break
done
# A gate that cannot find its own library must say so, not quietly allow.
[ -n "$ROOT" ] || { printf 'ai-task-gates: cannot find tools/lib/task-gates.sh\n' >&2; exit 4; }
# shellcheck source=../tools/lib/task-gates.sh
. "$ROOT/tools/lib/task-gates.sh"
# shellcheck source=../tools/lib/observation-week.sh
. "$ROOT/tools/lib/observation-week.sh"

POLICY_FILE="${AI_TASK_GATES_FILE:-$ROOT/config/task-gates.json}"
STATE_DIR="${AI_TASK_GATES_DIR:-$HOME/.local/state/ai-devops/task-gates}"
REPO_POLICY_BIN="${AI_REPO_POLICY_BIN:-$SCRIPT_DIR/ai-repo-policy}"
CONSUMER_FILE_NAME=".ai-devops/task-gates.json"

EX_BLOCKED=3
EX_UNCLASSIFIED=4

die(){ printf 'ai-task-gates: error: %s\n' "$*" >&2; exit 1; }
need_value(){ [ $# -ge 2 ] && [ -n "$2" ] || die "$1 requires a value."; }
fail_closed(){ printf 'ai-task-gates: cannot classify: %s\n' "$*" >&2; exit "$EX_UNCLASSIFIED"; }
blocked(){ printf '%s\n' "$*" >&2; exit "$EX_BLOCKED"; }

# Reviewer observation week (plan_reviewer-observation-week step 4). Only
# while a valid window file is live: a code ship whose exact head was sent for
# review without an APPROVE yet (a --detach run, or ai-review exit 75) is a
# MERGE-UNREVIEWED merge; reviewer code and toolkit installs are frozen. shared-db, production, infrastructure and deployment classes are
# never admitted by the window and keep their gates unchanged.
observation_week_check(){ # ACTION EFFECTIVE_CLASS
  local action="$1" effective="$2" head evidence
  if ! ow_window_live; then
    case "$OW_WHY" in "no window file") ;; *) printf 'ai-task-gates: note: observation week not applied (%s); full gating applies.\n' "$OW_WHY" >&2 ;; esac
    return 0
  fi
  case "$action" in review|code-only-review|pr-wait) return 0 ;; esac
  case "$effective" in
    reviewer-safety|installation)
      blocked "$(printf 'ai-task-gates: STOP before "%s". Reviewer observation week (%s to %s): reviewer-code changes and toolkit installs are frozen. Log the failure with ai-reviewer-issue and use only the allowed operations in plan_reviewer-observation-week.md section 11.' "$action" "$OW_START" "$OW_END")" ;;
  esac
  [ "$action" = ship ] && ow_class_allowed "$effective" || return 0
  case "$effective" in code|prose) ;; *) return 0 ;; esac
  head="$(git -C "$TOPLEVEL" rev-parse HEAD 2>/dev/null || true)"
  evidence="$(ow_head_evidence "$head" || true)"
  case "$evidence" in
    approved\ *) printf 'ai-task-gates: observation week: head %s has an APPROVE (%s); normal merge.\n' "$head" "${evidence#approved }" ;;
    detached\ *|all-skipped\ *)
      printf 'MERGE-UNREVIEWED\n'
      printf 'ai-task-gates: observation week: merge on green CI, add label unreviewed-week, and put this line in the squash body:\n'
      if [ "${evidence%% *}" = detached ]; then
        printf 'Unreviewed merge (observation week, run %s)\n' "${evidence#detached }"
      else
        printf 'Unreviewed merge (observation week, all-skipped)\n'
      fi ;;
    *)
      # Ordinary code and prose need no review (rotation rule 14), so the week never
      # blocks it; without evidence there is simply no unreviewed-week tag.
      printf 'ai-task-gates: observation week: head %s was never sent for review; ordinary code needs none (reviewer-rotation-rules rule 14), so no unreviewed-week label. To add it to the week'"'"'s data, run ai-review <reviewer> final-check --detach first.\n' "${head:-unknown}" ;;
  esac
  return 0
}

# Keep the terminal report-shape check alongside the lifecycle verdict check.
# Provider adapters may put blank lines around a structured verdict, but the
# last nonblank line must be the token and the preceding nonblank line its
# exact heading; any prose or contradictory trailing material fails closed.
report_has_terminal_approve(){
  local report="${1:-}"
  [ -f "$report" ] || return 1
  awk '
    { sub(/\r$/, "") }
    $0 !~ /^[[:space:]]*$/ { previous = last; last = $0 }
    END { exit !(last == "APPROVE" && previous == "## Verdict") }
  ' "$report"
}

usage(){
  cat <<'EOF'
usage: ai-task-gates <command> [options]

  start --class CLASS [--reason TEXT] [--base REF]
        Record the intended task class for this repository and worktree.
  check --before ACTION [--acknowledge TEXT]
        [--small-owner-entry ISSUE_URL --row-count N --owner-quote TEXT]
        [--target-head SHA] [--installed-checkout PATH] [--installed-launcher PATH]
        [--first-install] [--application-release-target MANIFEST]
        [--action-manifest-stdin --action-stage initial-forward|original-restoration]
        [--application-workflow-target .ai-devops/application-workflow-target.json]
        Recompute the change set and decide whether ACTION may start.
  authorize-install --target-head SHA --installed-checkout PATH
        --installed-launcher PATH --review-report PATH --reviewer-approval REPORT
        [--legacy-migration|--first-install|--recover-launchers|--stale-manifest-recovery]
        Issue one-use authority for an exact reviewed toolkit release.
  install-verify --phase preflight|resume|stages-complete|finalize --target-head SHA
        --installed-checkout PATH --installed-launcher /usr/local/bin/ai-task-gates
        [--caller-pinned] [--stage-report PATH]
        Guard the Linux checkout update and installation transaction.
  explain [--json] [--base REF] [--paths-from FILE|-]
        Show the resolved identity, change set, class, and gates.
  status | end
        Show or clear the recorded intent for this repository and worktree.
  classify EVENT
        Legacy coarse CI classification; reads paths on stdin.
  version

ACTION is one of: review code-only-review pr-wait ship deploy database infrastructure production
  shared-db-promotion application-workflow

shared-db-promotion is the one owner-authorized (Albert, 2026-10-02) launch of
shared-db's merged-preview run that starts its automatic production promotion
workflow for an approved, merged change. It opens only for the shared-db class
in a repository whose policy requires production-promotion-authorization; it
never allows a manual production command or a bypass of the workflow.
EOF
}

# --------------------------------------------------------------------------
# Contract loading
# --------------------------------------------------------------------------
# Strip CR in the shell rather than through a tr process: each extra process
# costs a visible fraction of a second under Git Bash on Windows. The sentinel
# keeps trailing blank lines exact, and jq's own exit status is returned.
jqr(){
  local out rc
  out="$(jq -r "$@"; rc=$?; printf x; exit "$rc")"; rc=$?
  out="${out%x}"; printf '%s' "${out//$'\r'/}"; return "$rc"
}
require_jq(){ command -v jq >/dev/null 2>&1 || die 'jq is required.'; }

load_policy(){
  [ -f "$POLICY_FILE" ] || fail_closed "policy file not found: $POLICY_FILE"
  jq -e '.schema_version == 1 and (.change_classes|type=="object") and (.rules|type=="array") and (.default|type=="object")' \
    "$POLICY_FILE" >/dev/null 2>&1 || fail_closed "invalid task-gate contract: $POLICY_FILE"
  load_class_table
  validate_action_gates
  # Loaded here, in the main shell: merged_gate runs in command substitutions.
  # Always reread, as every other part of the contract is.
  TG_TABLE_LOADED=""; load_rule_table
  TG_CONSUMER_LOADED=""; [ -z "$CONSUMER_FILE" ] || load_consumer_table
}

# Per-action proof bindings must name real actions and real classes before any
# check consults them: an entry that silently never matches would quietly drop
# the requirement it was written to carry.
validate_action_gates(){
  local line action class
  while IFS=$'\t' read -r action class; do
    [ -n "$action" ] || continue
    valid_action "$action" || fail_closed "action_gates names undeclared action '$action'."
    valid_class "$class" || fail_closed "action_gates names undeclared class '$class' for action '$action'."
  done < <(jqr '.action_gates // {} | to_entries[] | .key as $a | (.value.require_gate // {}) | keys[] | [$a,.] | @tsv' "$POLICY_FILE")
  # An owner release names an action, a protected class, and the gate a
  # repository must declare for that class. Each part must be real, or a typo
  # would silently leave the release unreachable or mis-scoped. It opens only
  # with an explicit owner authorization; no AI reviewer verdict (#2041).
  local gate
  while IFS=$'\t' read -r action class gate; do
    [ -n "$action" ] || continue
    valid_action "$action" || fail_closed "owner_release names undeclared action '$action'."
    valid_class "$class" || fail_closed "owner_release names undeclared class '$class' for action '$action'."
    case "$class" in
      private-evidence|reviewer-safety) fail_closed "owner_release cannot open the sealed '$class' class." ;;
    esac
    if [ "$class" = infrastructure ]; then
      [ "$action" = production ] && [ "$gate" = reviewed-production-dispatch ] \
        || fail_closed 'owner_release cannot broaden the closed u2giants/ansible production boundary.'
    fi
    [ -n "$gate" ] || fail_closed "owner_release for '$action'/'$class' names no gate."
  done < <(jqr '.owner_release // {} | to_entries[] | .key as $a | .value | to_entries[] | [$a,.key,(.value|tostring)] | @tsv' "$POLICY_FILE")
  # The two closed DesignFlow native fixture-profile routes cannot broaden.
  while IFS=$'\t' read -r action class gate; do
    [ -n "$action" ] || continue
    case "$action/$class/$gate" in
      database/private-evidence/synthetic-fixtures-only) ;;
      database/reviewer-safety/reviewed-generated-definition-fixture-only) ;;
      */private-evidence/*) fail_closed "native_profile_release cannot broaden the closed private-evidence database boundary." ;;
      */reviewer-safety/*) fail_closed 'native_profile_release cannot broaden the closed generated reviewer-safety boundary.' ;;
      *) fail_closed "native_profile_release names an unsupported route '$action/$class'." ;;
    esac
  done < <(jqr '.native_profile_release // {} | to_entries[] | .key as $a | .value | to_entries[] | [$a,.key,(.value|tostring)] | @tsv' "$POLICY_FILE")
}

# The class table is read once. Classification asks for a rank on every rule of
# every changed path, and a jq process per question is slow enough on Windows to
# be felt as a pause before every gate.
declare -A TG_RANK=() TG_PROT=() TG_ACTION=()
load_class_table(){
  local class rank protected action
  TG_RANK=(); TG_PROT=(); TG_ACTION=()
  while IFS= read -r action; do
    [ -n "$action" ] || continue
    TG_ACTION["$action"]=1
  done < <(jqr '.actions|arrays|.[]|strings' "$POLICY_FILE")
  while IFS=$'	' read -r class rank protected; do
    [ -n "$class" ] || continue
    TG_RANK["$class"]="$rank"; TG_PROT["$class"]="$protected"
  done < <(jqr '.change_classes|to_entries[]|[.key,(.value.rank|tostring),(.value.protected|tostring)]|@tsv' "$POLICY_FILE")
  [ "${#TG_RANK[@]}" -gt 0 ] || fail_closed "no change classes declared in $POLICY_FILE"
}
class_rank(){ printf '%s' "${TG_RANK[$1]:-}"; }
class_protected(){ printf '%s' "${TG_PROT[$1]:-}"; }
valid_class(){ [ -n "${TG_RANK[$1]:-}" ]; }
valid_action(){ [ -n "${1:-}" ] && [ -n "${TG_ACTION[$1]:-}" ]; }

# The central path rules and gates are read in one jq pass, the consumer
# declaration in another, instead of one jq per rule per question: merged_gate
# alone asked up to a dozen times per call (#1355). A contract whose values
# could not survive the row format (non-string match or value, newline, or
# the unit separator) keeps the per-question readers, which stay the reference.
TG_TABLE_LOADED=""; TG_TABLE_OK=0; TG_CONSUMER_LOADED=""
declare -a TG_MATCHES=()
declare -A TG_ROWS=() TG_CONSUMER_ROWS=()
tg_rows_filter='
  def ok: type=="string" and (test("[\n\u001f]")|not);
  def gate($k): (.gates//{}) | to_entries[] | .key as $c | .value
    | ((.required//[])[] | [$k,"required",$c,.]), ((.forbidden_actions//[])[] | [$k,"forbidden",$c,.]);
  def paths($k): (.paths//[])[] | [$k,"path","",([.glob,.class]|@tsv)];
  def rows: (.default | paths("D"), gate("D")), (.rules[] | .match as $m | paths("R"+$m), gate("R"+$m));
  if $consumer then (if . == null or . == false then error("not a declaration") else {default:., rules:[]} end) else . end
  | if ([rows[]] + [.rules[].match] | all(ok)) and ((.default.gates//{}|keys) + [.rules[]|.gates//{}|keys[]] | all(ok))
  then "OK", (.rules[] | ["M","match","",.match]), rows else "FALLBACK" end
  | if type=="array" then join("\u001f") else . end'
tg_table_rows(){ # tg_table_rows FILE ASSOC CONSUMER; fills ASSOC[key]; returns 1 for a fallback contract
  local -n rows="$2"; local status key kind class value
  { IFS= read -r status || return 1
    [ "$status" = OK ] || return 1
    while IFS=$'\x1f' read -r key kind class value; do
      if [ "$key" = M ]; then TG_MATCHES+=("$value"); continue; fi
      rows["$key"$'\x1f'"$kind"$'\x1f'"$class"]+="$value"$'\n'
    done
  } < <(jqr --argjson consumer "$3" "$tg_rows_filter" "$1" 2>/dev/null || printf 'FALLBACK\n')
}
load_rule_table(){
  # Keyed on the file: install checks swap POLICY_FILE between revisions.
  [ "$TG_TABLE_LOADED" = "$POLICY_FILE" ] && return 0
  TG_TABLE_LOADED="$POLICY_FILE"; TG_MATCHES=(); TG_ROWS=()
  if tg_table_rows "$POLICY_FILE" TG_ROWS false; then TG_TABLE_OK=1; else TG_TABLE_OK=0; TG_MATCHES=(); TG_ROWS=(); fi
}
load_consumer_table(){
  [ "$TG_CONSUMER_LOADED" = "$CONSUMER_FILE" ] && return 0
  TG_CONSUMER_LOADED="$CONSUMER_FILE"; TG_CONSUMER_ROWS=()
  [ -f "$CONSUMER_FILE" ] || return 0
  local -a saved=("${TG_MATCHES[@]+"${TG_MATCHES[@]}"}")
  # The consumer file is read as the "default" of its own table.
  tg_table_rows "$CONSUMER_FILE" TG_CONSUMER_ROWS true \
    || TG_CONSUMER_ROWS=([fallback]=1)
  TG_MATCHES=("${saved[@]+"${saved[@]}"}")
}

# Every path rule that applies to this identity: central defaults first, then
# every matching central rule, then the consumer declaration. Resolution takes
# the STRONGEST class per path across all of them, so a later source can only
# strengthen a class and can never weaken one.
applicable_path_rules(){
  local identity="$1" pattern
  load_rule_table; load_consumer_table
  if [ "$TG_TABLE_OK" = 1 ] && [ -z "${TG_CONSUMER_ROWS[fallback]:-}" ]; then
    printf '%s' "${TG_ROWS[D$'\x1f'path$'\x1f']:-}"
    for pattern in "${TG_MATCHES[@]+"${TG_MATCHES[@]}"}"; do
      [ -n "$pattern" ] || continue
      tg_identity_match "$pattern" "$identity" || continue
      printf '%s' "${TG_ROWS[R$pattern$'\x1f'path$'\x1f']:-}"
    done
    printf '%s' "${TG_CONSUMER_ROWS[D$'\x1f'path$'\x1f']:-}"
    return 0
  fi
  jqr '.default.paths[]|[.glob,.class]|@tsv' "$POLICY_FILE"
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    tg_identity_match "$pattern" "$identity" || continue
    jqr --arg m "$pattern" '.rules[]|select(.match==$m)|(.paths//[])[]|[.glob,.class]|@tsv' "$POLICY_FILE"
  done < <(jqr '.rules[].match' "$POLICY_FILE")
  [ -f "$CONSUMER_FILE" ] || return 0
  # resolve_repo already refused a declaration that is not valid JSON.
  jqr '(.paths//[])[]|[.glob,.class]|@tsv' "$CONSUMER_FILE" 2>/dev/null
}

# Merged gate for one class: union of required proofs and forbidden actions
# from the central default, every matching central rule, and the consumer file.
merged_gate(){
  local identity="$1" class="$2" pattern kind
  load_rule_table; load_consumer_table
  if [ "$TG_TABLE_OK" = 1 ] && [ -z "${TG_CONSUMER_ROWS[fallback]:-}" ]; then
    for kind in required forbidden; do
      {
        printf '%s' "${TG_ROWS[D$'\x1f'$kind$'\x1f'$class]:-}"
        for pattern in "${TG_MATCHES[@]+"${TG_MATCHES[@]}"}"; do
          [ -n "$pattern" ] || continue
          tg_identity_match "$pattern" "$identity" || continue
          printf '%s' "${TG_ROWS[R$pattern$'\x1f'$kind$'\x1f'$class]:-}"
        done
        printf '%s' "${TG_CONSUMER_ROWS[D$'\x1f'$kind$'\x1f'$class]:-}"
      } | LC_ALL=C sort -u | sed "s/^/$kind\t/"
    done
    return 0
  fi
  {
    jqr --arg c "$class" '(.default.gates[$c].required//[])[]' "$POLICY_FILE"
    while IFS= read -r pattern; do
      [ -n "$pattern" ] || continue
      tg_identity_match "$pattern" "$identity" || continue
      jqr --arg m "$pattern" --arg c "$class" \
        '.rules[]|select(.match==$m)|(.gates[$c].required//[])[]' "$POLICY_FILE"
    done < <(jqr '.rules[].match' "$POLICY_FILE")
    [ -f "$CONSUMER_FILE" ] && jqr --arg c "$class" '(.gates[$c].required//[])[]' "$CONSUMER_FILE" 2>/dev/null
  } | LC_ALL=C sort -u | sed 's/^/required\t/'
  {
    jqr --arg c "$class" '(.default.gates[$c].forbidden_actions//[])[]' "$POLICY_FILE"
    while IFS= read -r pattern; do
      [ -n "$pattern" ] || continue
      tg_identity_match "$pattern" "$identity" || continue
      jqr --arg m "$pattern" --arg c "$class" \
        '.rules[]|select(.match==$m)|(.gates[$c].forbidden_actions//[])[]' "$POLICY_FILE"
    done < <(jqr '.rules[].match' "$POLICY_FILE")
    [ -f "$CONSUMER_FILE" ] && jqr --arg c "$class" '(.gates[$c].forbidden_actions//[])[]' "$CONSUMER_FILE" 2>/dev/null
  } | LC_ALL=C sort -u | sed 's/^/forbidden\t/'
}

# --------------------------------------------------------------------------
# Repository context
# --------------------------------------------------------------------------
IDENTITY=""; IDENTITY_RESOLVED=false; TOPLEVEL=""; CONSUMER_FILE=""; BASE_REF=""

resolve_repo(){
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail_closed 'not inside a Git repository.'
  TOPLEVEL="$(git rev-parse --show-toplevel)"
  IDENTITY="$(tg_identity)"
  case "$IDENTITY" in local/*) IDENTITY_RESOLVED=false ;; *) IDENTITY_RESOLVED=true ;; esac
  CONSUMER_FILE="$TOPLEVEL/$CONSUMER_FILE_NAME"
  # Validate here, in the main shell. The readers below run inside command
  # substitutions, where an exit would end only the subshell and the run would
  # quietly continue on the central rules alone - dropping exactly the stricter
  # local rules a corrupt declaration should have made us stop for.
  # A declaration the one-pass table reader accepted is valid JSON; only a
  # fallback needs the separate parse.
  load_consumer_table
  if [ -n "${TG_CONSUMER_ROWS[fallback]:-}" ] && ! jq -e . "$CONSUMER_FILE" >/dev/null 2>&1; then
    fail_closed "consumer declaration is not valid JSON: $CONSUMER_FILE"
  fi
}

# The base to diff committed work against. An explicit --base wins, then the
# base recorded by `start`, then the merge base with the repository's own main
# branch. A repository with no base (fresh, detached, no upstream) is not an
# error: the working tree alone is then the whole change set.
resolve_base(){
  local requested="$1" recorded main
  if [ -n "$requested" ]; then
    BASE_REF="$(git rev-parse --verify --quiet "$requested^{commit}" 2>/dev/null)" \
      || fail_closed "base ref not found: $requested"
    return 0
  fi
  recorded="$(state_field base)"
  if [ -n "$recorded" ] && git rev-parse --verify --quiet "$recorded^{commit}" >/dev/null 2>&1; then
    BASE_REF="$(git rev-parse "$recorded^{commit}")"; return 0
  fi
  main=""
  if [ -x "$REPO_POLICY_BIN" ]; then
    main="$("$REPO_POLICY_BIN" 2>/dev/null | jqr '.main_branch // empty' 2>/dev/null || true)"
  fi
  [ -n "$main" ] || main=main
  for candidate in "origin/$main" "$main"; do
    git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null 2>&1 || continue
    BASE_REF="$(git merge-base HEAD "$candidate" 2>/dev/null || true)"
    [ -n "$BASE_REF" ] && return 0
  done
  BASE_REF=""
}

# The complete observed change set. Rename detection is disabled on purpose so
# that both the deleted source and the added destination are classified: a
# migration renamed to a Markdown note must not become a prose-only task.
change_set(){
  local status_line path
  if [ -n "$BASE_REF" ]; then
    git diff --no-renames --name-only "$BASE_REF" HEAD 2>/dev/null || true
  fi
  while IFS= read -r -d '' status_line; do
    path="${status_line:3}"
    [ -n "$path" ] || continue
    printf '%s\n' "$path"
  done < <(git status --porcelain=v1 -z --untracked-files=all --no-renames 2>/dev/null)
  # A modified submodule appears above as its own path; also surface a
  # submodule whose recorded commit moved without a worktree status entry.
  git diff --no-renames --name-only --ignore-submodules=none HEAD 2>/dev/null || true
}

# --------------------------------------------------------------------------
# Classification
# --------------------------------------------------------------------------
OBSERVED_CLASS=""; OBSERVED_RANK=0; CHANGED_PATHS=""; CHANGED_COUNT=0
declare -a CONTRIBUTORS=()

classify_paths(){
  local identity="$1" paths="$2" fallback rules path glob class rank best best_rank i compiled=0
  local -a rule_regexes=() rule_classes=() rule_ranks=()
  fallback="$(jqr '.default.fallback_class' "$POLICY_FILE")"
  valid_class "$fallback" || fail_closed "fallback_class '$fallback' is not a declared change class"
  rules="$(applicable_path_rules "$identity")"

  OBSERVED_CLASS=""; OBSERVED_RANK=0; CONTRIBUTORS=(); CHANGED_COUNT=0; RAW_ARCHIVE_PATHS=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    CHANGED_COUNT=$((CHANGED_COUNT + 1))
    # Raw chat/transcript archives may never enter a change set (AGENTS.md:
    # "never open or commit raw transcript .jsonl"). Path shape is the proof,
    # matched case-insensitively: on case-insensitive filesystems .JSONL,
    # Transcripts/ and CHAT_ARCHIVES/ name the same files as their lowercase
    # spellings, so a case-sensitive match would let them evade the rule.
    if raw_archive_path "$path"; then
      RAW_ARCHIVE_PATHS="${RAW_ARCHIVE_PATHS}${path}"$'\n'
    fi
    # Compile the applicable rules once for the complete path set. Calling
    # tg_glob_match for every path/rule pair starts a Bash command substitution
    # for each comparison, which dominates large --paths-from inputs on Windows.
    # Keep rule order and strongest-class resolution exactly as before.
    if [ "$compiled" -eq 0 ]; then
      while IFS=$'\t' read -r glob class; do
        [ -n "$glob" ] || continue
        valid_class "$class" || fail_closed "path rule '$glob' names undeclared class '$class'"
        rule_regexes+=("$(tg_glob_regex "$glob")")
        rule_classes+=("$class")
        rule_ranks+=("${TG_RANK[$class]}")
      done <<< "$rules"
      compiled=1
    fi
    # The fallback applies only when nothing matched. Seeding `best` with it
    # would silently swallow every class weaker than the fallback.
    best=""; best_rank=-1
    for ((i=0; i<${#rule_regexes[@]}; i++)); do
      [[ "$path" =~ ${rule_regexes[$i]} ]] || continue
      class="${rule_classes[$i]}"
      rank="${rule_ranks[$i]}"
      if [ "$rank" -gt "$best_rank" ]; then best="$class"; best_rank="$rank"; fi
    done
    if [ -z "$best" ]; then best="$fallback"; best_rank="${TG_RANK[$fallback]}"; fi
    CONTRIBUTORS+=("$best	$path")
    if [ "$best_rank" -gt "$OBSERVED_RANK" ]; then OBSERVED_CLASS="$best"; OBSERVED_RANK="$best_rank"; fi
  done <<< "$paths"

  # private-evidence is sticky across a change set: one licensed path means the
  # whole change set stays inside private-evidence, even when a higher-ranked
  # tooling exception matched other paths. Without this, a tooling-plus-rows
  # change would resolve to the tooling class and could start a review.
  # Keep the highest path rank so a real scope escalation is still reported.
  local contributor
  for contributor in "${CONTRIBUTORS[@]}"; do
    case "$contributor" in
      private-evidence$'\t'*)
        OBSERVED_CLASS=private-evidence
        break
        ;;
    esac
  done

  if [ "$CHANGED_COUNT" -eq 0 ]; then
    OBSERVED_CLASS="none"; OBSERVED_RANK=0
  fi
}

# --------------------------------------------------------------------------
# never-open-raw-transcript-archives. One matcher, one refusal message, used
# by check, explain, authorize-install and install-verify so no command path
# can enforce a different rule than classify_paths recorded.
# --------------------------------------------------------------------------

# Path shape of a raw transcript/chat archive. Case-insensitive so .JSONL,
# Transcripts/ and CHAT_ARCHIVES/ cannot evade the rule on the
# case-insensitive filesystems these archives actually live on.
raw_archive_path(){
  case "${1,,}" in
    *.jsonl|*.jsonl.gz|transcripts/*|*/transcripts/*|chat_archives/*|*/chat_archives/*) return 0 ;;
  esac
  return 1
}

# refuse_raw_archives ACTION PATHS — block when any newline-separated path is
# a raw transcript/chat archive. This gate is enforced for every action,
# whether or not a policy lists it: the path shape is the proof.
refuse_raw_archives(){
  local action="$1" paths="$2" path found=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if raw_archive_path "$path"; then
      found="${found}${path}"$'\n'
    fi
  done <<< "$paths"
  [ -n "$found" ] || return 0
  blocked "$(printf 'ai-task-gates: STOP before "%s". The change set contains raw transcript or chat archives, which "never-open-raw-transcript-archives" forbids in any repository:\n%s' "$action" "$found")"
}

# refuse_release_raw_archives ACTION OLD TARGET — the same refusal for a
# committed release range (install verification), NUL-separated so Git never
# quotes a path out of the match.
refuse_release_raw_archives(){
  local action="$1" old="$2" target="$3" paths
  [ "$old" != "$target" ] || return 0
  paths="$(git -C "$TOPLEVEL" diff --no-renames --name-only -z "$old" "$target" 2>/dev/null | tr '\0' '\n')" || return 0
  refuse_raw_archives "$action" "$paths"
}

# check_change_set ACTION REQUESTED_BASE — the change set `check` will judge,
# resolved before any action-specific argument, declaration, or class check so
# a raw transcript archive refusal names the archive itself instead of a
# weaker misdirection. Deploy resolves its start-head base exactly as the
# deploy pre-checks in cmd_check will, so the scan and `prepare` agree.
check_change_set(){
  local action="$1" req_base="$2" start_head
  resolve_repo
  if [ "$action" = deploy ] && [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]]; then
    start_head="$(state_field start_head)"
    if [ -n "$start_head" ] && [ -z "$req_base" ]; then req_base="$start_head"; fi
  fi
  resolve_base "$req_base"
  change_set | LC_ALL=C sort -u
}

# --------------------------------------------------------------------------
# Intent state. Kept in the user state root, never inside the repository, so it
# can never be committed as project state. The key is the canonical identity
# plus the worktree path, so two linked worktrees of one clone stay isolated.
# --------------------------------------------------------------------------
state_key(){ printf '%s\0%s' "$IDENTITY" "$TOPLEVEL" | sha256sum | cut -d' ' -f1; }
state_path(){ printf '%s/%s.json' "$STATE_DIR" "$(state_key)"; }

state_field(){
  local file; file="$(state_path)"
  [ -f "$file" ] || return 0
  jqr --arg f "$1" '.[$f] // empty' "$file" 2>/dev/null || true
}

state_write(){
  local file; file="$(state_path)"
  mkdir -p "$STATE_DIR" || die "cannot create state directory: $STATE_DIR"
  chmod 0700 "$STATE_DIR" 2>/dev/null || true
  local temporary
  temporary="$(umask 077; mktemp "$STATE_DIR/.task-state.XXXXXX")" || return 1
  if printf '%s\n' "$1" > "$temporary" && mv -f "$temporary" "$file"; then return 0; fi
  rm -f "$temporary"; return 1
}

state_record_override(){
  local kind="$1" action="$2" reason="$3" observed="$4" file
  file="$(state_path)"
  [ -f "$file" ] || return 0
  local row
  row="$(jq --arg k "$kind" --arg a "$action" --arg r "$reason" --arg o "$observed" \
     --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     '.overrides = ((.overrides // []) + [{kind:$k,action:$a,reason:$r,observed_class:$o,at:$t}])' \
     "$file")" || return 1
  state_write "$row"
}

# An approval is a reviewer report the lifecycle recorded as a completed,
# non-stale APPROVE of this repository key, head, and source digest, whose
# recorded implementer_engine differs from its provider (#996). Live actions
# need review_mode final-check or security-review; review, pr-wait, and
# code-only-review also accept plan-review, which is itself ungated.
# Usage: reviewer_approval_summary REPORT ACTION HEAD WORKTREE
reviewer_approval_summary(){
  local report="$1" action="$2" head="$3" worktree="$4" action_manifest_file="${5:-}" action_stage="${6:-initial-forward}" publish_admission="${7:-0}" identity key digest report_hash lifecycle_root state row mode
  [ -f "$report" ] && [ ! -L "$report" ] || return 1
  report="$(cd "$(dirname "$report")" && pwd -P)/$(basename "$report")" || return 1
  report_hash="$(sha256sum "$report" | cut -d' ' -f1)" || return 1
  identity="$("$SCRIPT_DIR/ai-review-lifecycle" identity "$worktree" 2>/dev/null)" || return 1
  key="$(jq -r '.repository_key // ""' <<<"$identity")"; digest="$(jq -r '.source_digest // ""' <<<"$identity")"
  [ -n "$key" ] && [ -n "$digest" ] || return 1
  lifecycle_root="${AI_REVIEW_LIFECYCLE_DIR:-$HOME/.local/state/ai-devops/review-lifecycle}"
  row=""
  for state in "$lifecycle_root/runs/$key/"*/*/*.json; do
    [ -f "$state" ] || continue
    if jq -e --arg h "$head" --arg p "$report" --arg s "$report_hash" --arg d "$digest" --arg k "$key" '
      .status=="completed" and .verdict=="APPROVE" and .stale==false and .head==$h
      and .repository_key==$k and .source_digest==$d and .report_path==$p and .report_sha256==$s
      and (.provider|type=="string" and length>0) and (.implementer_engine|type=="string" and length>0)
      and ((.provider|ascii_downcase) != (.implementer_engine|ascii_downcase))' "$state" >/dev/null 2>&1; then row="$state"; break; fi
  done
  [ -n "$row" ] || return 1
  # local-tests: a release action in a class that requires local tests needs a
  # review record that carries a passing test run with its output digest.
  # Return 2 (not 1) here so callers can refuse with a message that names the
  # missing test evidence instead of reporting the approval itself as absent.
  if [ "${LOCAL_TESTS_REQUIRED:-0}" = 1 ]; then
    jq -e '(.tests.exit==0) and (.tests.output_sha256|type=="string" and test("^[0-9a-f]{64}$"))' "$row" >/dev/null 2>&1 || return 2
  fi
  local oracle_script="" generated_binding=""
  if [ "$action" = database ] && [ -n "$action_manifest_file" ] && python3 "$REAL_DIR/../tools/review_action_profile.py" generated-select < "$action_manifest_file" >/dev/null 2>&1; then
    [ "$action_stage" = initial-forward ] || return 1
    generated_binding="$(python3 "$REAL_DIR/../tools/review_action_profile.py" generated-preaction "$row" < "$action_manifest_file" 2>/dev/null)" || return 1
  fi
  if [ "$action" = offline-private-capture-transform ]; then
    jq -e ' .evidence_scope=="selected-code" and .code_only!=null and .code_only_export!=null' "$row" >/dev/null || return 1
  fi
  if [ -z "$generated_binding" ] && jq -e '.code_only!=null or .code_only_export!=null or .evidence_scope=="selected-code"' "$row" >/dev/null; then
    [ -n "$action_manifest_file" ] || return 1
    if [ "$action" = offline-private-capture-transform ]; then
      case "$(jq -r .action_profile_binding.profile "$row")" in
        oracle-native-alternate-serialization-v1) oracle_script=oracle_native_alternate_profile.py ;;
        oracle-native-alternate-serialization-v2) oracle_script=oracle_native_alternate_v2_profile.py ;;
        *) return 1 ;;
      esac
      jq -e '.action_profile_binding.action=="offline-private-capture-transform"' "$row" >/dev/null || return 1
      python3 "$REAL_DIR/../tools/$oracle_script" preaction "$row" --stage "$action_stage" < "$action_manifest_file" >/dev/null 2>&1 || return 1
    else
      [ "$action" = database ] || return 1
      jq -e '.action_profile_binding.profile=="shared-db-770-isolated-timing-rehearsal-v1" and .action_profile_binding.action=="database"' "$row" >/dev/null || return 1
      python3 "$REAL_DIR/../tools/review_action_profile.py" preaction "$row" --stage "$action_stage" < "$action_manifest_file" >/dev/null 2>&1 || return 1
    fi
  fi
  [ -z "$action_manifest_file" ] || [ -n "$generated_binding" ] || jq -e '.action_profile_binding!=null and .evidence_scope=="selected-code"' "$row" >/dev/null || return 1
  mode="$(jq -r '.review_mode // ""' "$row")"
  case "$action" in
    review|pr-wait|code-only-review) case "$mode" in plan-review|diff-review|security-review|visual-review|final-check) ;; *) return 1 ;; esac ;;
    *) [ "$mode" = final-check ] || [ "$mode" = security-review ] || return 1 ;;
  esac
  if [ "$publish_admission" = 1 ] && [ -z "$generated_binding" ]; then
    [ -n "$action_manifest_file" ] || return 1
    if [ "$action" = offline-private-capture-transform ]; then
      python3 "$REAL_DIR/../tools/$oracle_script" preaction "$row" --stage "$action_stage" --admit < "$action_manifest_file" >/dev/null 2>&1 || return 1
    else
      [ "$action" = database ] || return 1
      python3 "$REAL_DIR/../tools/review_action_profile.py" preaction "$row" --stage "$action_stage" --admit < "$action_manifest_file" >/dev/null 2>&1 || return 1
    fi
  fi
  if [ -n "$generated_binding" ]; then
    # Existing state_record_override stores this immutable input/source audit
    # binding. Repeated checks freshly validate; no token or consumption state.
    jq -r --arg a "$action" --arg m "$mode" --arg x "$report_hash" --arg binding "$generated_binding" \
      '"APPROVE by \(.provider) (implementer \(.implementer_engine), run \(.run_id), \($m)) for \($a) at \(.head) report sha256:\($x) generated-audit:\($binding)"' "$row"
    return 0
  fi
  jq -r --arg a "$action" --arg m "$mode" --arg x "$report_hash" \
    '"APPROVE by \(.provider) (implementer \(.implementer_engine), run \(.run_id), \($m)) for \($a) at \(.head) report sha256:\($x)"' "$row"
}

# approval_refused ACTION RC MESSAGE: refuse an approval that failed
# reviewer_approval_summary. RC 2 is that function's local-tests evidence
# check; its refusal must name the missing test evidence rather than report
# the approval itself as absent.
approval_refused(){
  local action="$1" rc="$2"; shift 2
  if [ "$rc" -eq 2 ]; then
    blocked "$(printf 'ai-task-gates: STOP before "%s". The reviewer approval carries no passing local-tests evidence: its lifecycle record must hold a passing tests run (tests.exit==0 with a 64-hex tests.output_sha256, recorded by ai-review-lifecycle record-tests from the review snapshot before dispatch). Run the repository tests through the review (--tests), obtain that APPROVE, and re-run with --reviewer-approval <that report>.' "$action")"
  fi
  blocked "$@"
}

# decide_local_tests_required ACTION REQUIRED_GATES_CSV [APPROVAL_MANDATORY]
# Decide the local-tests evidence requirement BEFORE an approval call site: a
# release whose required gates pair local-tests with a reviewer-approval gate —
# or whose call site requires the approval unconditionally
# (APPROVAL_MANDATORY=1) — needs passing test evidence in that approval.
# review, pr-wait, and code-only-review PRODUCE or wait on the approval, so
# they are never gated. A decision only raises the requirement: a later call
# site in the same invocation can never lower it.
decide_local_tests_required(){
  local action="$1" gates="${2:-}" mandatory="${3:-0}"
  case "$action" in
    review|code-only-review|pr-wait) LOCAL_TESTS_REQUIRED=0; return 0 ;;
  esac
  if printf '%s\n' "$gates" | tr ',' '\n' | grep -qx local-tests \
     && { [ "$mandatory" = 1 ] || printf '%s\n' "$gates" | tr ',' '\n' | grep -Eq '^(assigned-ai-reviewer-approval|exact-resource-and-action-ai-reviewer-approval|exact-head-independent-review)$'; }; then
    LOCAL_TESTS_REQUIRED=1
  fi
}
# Every approval call site must be preceded by a decide_local_tests_required
# in its function; the task-gates unit test enforces that source ordering.

# Application source-release admission is a closed four-target map. Backend's
# existing proof path is unchanged; only the three new targets get extra proofs.
APP_RELEASE_MANIFEST_PATH='.ai-devops/application-release-target.json'
APP_RELEASE_CONSUMER_GATE='cloud-build-release-review'
APP_RELEASE_EXPECTED_TARGET='{"schema_version":1,"repository":"popcre/designflow-backend","route":"cloud-build-branch-push","branch":"sandbox-albert","project":"lithe-breaker-323913","region":"us-east4","service":"popcre-albert-core-sandbox"}'
APP_RELEASE_MANIFEST_BLOB=''; APP_RELEASE_CONSUMER_BLOB=''; APP_RELEASE_HEAD=''
APP_RELEASE_PREFLIGHT=''; APP_RELEASE_PROOF=''
APP_RELEASE_SERVICES='{"popcre/designflow-backend":"popcre-albert-core-sandbox","popcre/designflow-frontend":"popcre-albert-frontend-sandbox","popcre/designflow-item-master":"popcre-albert-item-sandbox","popcre/designflow-tracking":"popcre-albert-tracking-sandbox"}'

application_release_supplement(){
  local py
  py="$(command -v python3 || command -v python)" || return 1
  "$py" "$ROOT/tools/application_source_release.py" "$@"
}

application_release_contributor_gates(){
  local contributor cls
  for contributor in "${CONTRIBUTORS[@]}"; do
    contributor="$(printf '%b' "$contributor")"
    cls="${contributor%%$'\t'*}"
    merged_gate "$IDENTITY" "$cls"
  done
}

validate_application_release_policy(){
  jq -e --argjson services "$APP_RELEASE_SERVICES" '
    .application_source_releases as $r
    | .owner_release as $rr
    | ($r|type=="object") and (($r|keys)==($services|keys))
    and all($services|to_entries[]; . as $entry | $r[$entry.key]
      | type=="object"
        and (keys==["manifest_path","required_consumer_gate","target"])
        and .manifest_path==".ai-devops/application-release-target.json"
        and .required_consumer_gate=="cloud-build-release-review"
        and .target=={"schema_version":1,"repository":$entry.key,"route":"cloud-build-branch-push","branch":"sandbox-albert","project":"lithe-breaker-323913","region":"us-east4","service":$entry.value})
    and ($rr.deploy.deployment == null)
  ' "$POLICY_FILE" >/dev/null 2>&1 \
    || fail_closed 'application source-release policy is missing, open, or differs from its four exact approved sandbox targets.'
}

application_release_json_valid(){ # RELATIVE_PATH ROLE
  local relative="$1" role="$2" py
  py="$(command -v python3 || command -v python)" || return 1
  "$py" - "$TOPLEVEL" "$relative" "$role" "$APP_RELEASE_EXPECTED_TARGET" "$APP_RELEASE_CONSUMER_GATE" <<'PY'
import json, pathlib, stat, sys

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result

try:
    root = pathlib.Path(sys.argv[1]).resolve(strict=True)
    relative = pathlib.PurePosixPath(sys.argv[2])
    if relative.is_absolute() or ".." in relative.parts:
        raise ValueError("unsafe relative path")
    path = root.joinpath(*relative.parts)
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ValueError("not a regular nonsymlink file")
    path.resolve(strict=True).relative_to(root)
    with path.open("r", encoding="utf-8") as source:
        value = json.load(source, object_pairs_hook=unique_object)
    if sys.argv[3] == "manifest":
        expected = json.loads(sys.argv[4], object_pairs_hook=unique_object)
        keys = {"schema_version", "repository", "route", "branch", "project", "region", "service"}
        if type(value) is not dict or set(value) != keys:
            raise ValueError("manifest keys do not match")
        if type(value["schema_version"]) is not int or value["schema_version"] != 1:
            raise ValueError("manifest schema version is not integer 1")
        if any(type(value[key]) is not str for key in keys - {"schema_version"}):
            raise ValueError("manifest fields must be strings")
        if value != expected:
            raise ValueError("manifest differs from approved target")
    else:
        if type(value) is not dict:
            raise ValueError("consumer declaration is not an object")
        gates = value.get("gates")
        deployment = gates.get("deployment") if type(gates) is dict else None
        required = deployment.get("required") if type(deployment) is dict else None
        if type(required) is not list or any(type(item) is not str for item in required):
            raise ValueError("consumer deployment gate list is invalid")
        if sys.argv[5] not in required:
            raise ValueError("consumer deployment gate is absent")
except (OSError, ValueError, TypeError, KeyError):
    sys.exit(1)
PY
}

application_release_file_blob(){ # REPOSITORY_RELATIVE_PATH
  local relative="$1" file="$TOPLEVEL/$1" tree mode head_blob work_blob
  tree="$(git -C "$TOPLEVEL" ls-tree HEAD -- "$relative" 2>/dev/null)" || return 1
  mode="${tree%% *}"
  case "$mode" in 100644|100755) ;; *) return 1 ;; esac
  git -C "$TOPLEVEL" diff --quiet HEAD -- "$relative" || return 1
  head_blob="$(git -C "$TOPLEVEL" rev-parse "HEAD:$relative" 2>/dev/null)" || return 1
  work_blob="$(git -C "$TOPLEVEL" hash-object -- "$file" 2>/dev/null)" || return 1
  [ "$head_blob" = "$work_blob" ] || return 1
  printf '%s' "$head_blob"
}

application_release_validate_target(){ # SUPPLIED_PATH EFFECTIVE_CLASS
  local supplied="$1" effective="$2" origin contributor proof consumer_relative="$CONSUMER_FILE_NAME"
  validate_application_release_policy
  [ "$supplied" = "$APP_RELEASE_MANIFEST_PATH" ] \
    || blocked 'ai-task-gates: STOP. Application release manifest path differs from the centrally approved path.'
  jq -e --arg id "$IDENTITY" 'has($id)' <<< "$APP_RELEASE_SERVICES" >/dev/null && [ "$effective" = deployment ] \
    || blocked 'ai-task-gates: STOP. Application source release is limited to canonical popcre/designflow-backend or the three exact new sandbox targets with effective class deployment.'
  APP_RELEASE_EXPECTED_TARGET="$(jq -c --arg id "$IDENTITY" '.application_source_releases[$id].target' "$POLICY_FILE")"
  origin="$(git -C "$TOPLEVEL" remote get-url origin 2>/dev/null || true)"
  case "$origin" in
    "https://github.com/$IDENTITY"|"https://github.com/$IDENTITY.git"|\
    "git@github.com:$IDENTITY"|"git@github.com:$IDENTITY.git"|\
    "ssh://git@github.com/$IDENTITY"|"ssh://git@github.com/$IDENTITY.git") ;;
    *) blocked 'ai-task-gates: STOP. Application source release requires the exact canonical GitHub origin.' ;;
  esac
  application_release_json_valid "$consumer_relative" consumer \
    || blocked 'ai-task-gates: STOP. The committed consumer declaration must be a contained regular file and require cloud-build-release-review for deployment.'
  APP_RELEASE_CONSUMER_BLOB="$(application_release_file_blob "$consumer_relative")" \
    || blocked 'ai-task-gates: STOP. The consumer deployment gate must be a clean file committed at HEAD.'
  application_release_json_valid "$APP_RELEASE_MANIFEST_PATH" manifest \
    || blocked 'ai-task-gates: STOP. The application release manifest is missing, malformed, duplicated, dirty, symlinked, outside the repository, or differs from the exact approved target.'
  APP_RELEASE_MANIFEST_BLOB="$(application_release_file_blob "$APP_RELEASE_MANIFEST_PATH")" \
    || blocked 'ai-task-gates: STOP. The application release manifest must be a regular clean file committed at HEAD.'
  APP_RELEASE_HEAD="$(git -C "$TOPLEVEL" rev-parse HEAD 2>/dev/null)" \
    || blocked 'ai-task-gates: STOP. Application release source HEAD is unavailable.'
  if [ "$IDENTITY" != popcre/designflow-backend ]; then
    [ "$APP_RELEASE_PREFLIGHT" = "$IDENTITY" ] \
      || blocked 'ai-task-gates: STOP. New application release did not pass pre-discovery confinement.'
    for contributor in "${CONTRIBUTORS[@]}"; do
      case "$(printf '%b' "$contributor")" in
        shared-db$'\t'*|infrastructure$'\t'*|production$'\t'*|private-evidence$'\t'*)
          blocked 'ai-task-gates: STOP. New application source release cannot contain structural, infrastructure, production or private-evidence contributors.' ;;
      esac
    done
    proof="$(application_release_supplement prove "$TOPLEVEL" "$IDENTITY" "$(state_field base)")" \
      || blocked 'ai-task-gates: STOP. New application source-release proof refused.'
    [ -z "$APP_RELEASE_PROOF" ] || [ "$APP_RELEASE_PROOF" = "$proof" ] \
      || blocked 'ai-task-gates: STOP. Application context or fresh remote proof moved during admission.'
    APP_RELEASE_PROOF="$proof"
  fi
}

application_release_finish(){ # EFFECTIVE_CLASS
  local effective="$1" head summary reason state
  # No AI reviewer verdict gates an application source release (#2041).
  head="$(git -C "$TOPLEVEL" rev-parse HEAD 2>/dev/null)" \
    || blocked 'ai-task-gates: STOP. Application release source HEAD is unavailable.'
  [ "$head" = "$APP_RELEASE_HEAD" ] \
    || blocked 'ai-task-gates: STOP. Application source changed after target validation.'
  summary="no-reviewer-gate(#2041)"
  application_release_validate_target "$APP_RELEASE_MANIFEST_PATH" "$effective"
  [ "$APP_RELEASE_HEAD" = "$head" ] \
    || blocked 'ai-task-gates: STOP. Application source moved during release proof validation.'
  reason="head=$head manifest_blob=$APP_RELEASE_MANIFEST_BLOB consumer_blob=$APP_RELEASE_CONSUMER_BLOB approval=$summary"
  if [ "$IDENTITY" != popcre/designflow-backend ]; then
    reason="$reason repository=$IDENTITY target=$APP_RELEASE_EXPECTED_TARGET proof=$APP_RELEASE_PROOF"
  fi
  state_record_override application-source-release deploy "$reason" "$effective" \
    && state="$(state_path)" \
    && jq -e --arg r "$reason" --arg c "$effective" \
      '.overrides | any(.kind=="application-source-release" and .action=="deploy" and .observed_class==$c and .reason==$r)' \
      "$state" >/dev/null 2>&1 \
    || blocked 'ai-task-gates: STOP. The exact application source-release proof could not be recorded; nothing was released.'
  printf 'ai-task-gates: application source release may start only through the Cloud Build branch-source push: %s\n' "$summary"
  printf 'ai-task-gates: recorded exact application source-release override for HEAD %s and manifest blob %s.\n' "$head" "$APP_RELEASE_MANIFEST_BLOB"
}

# Ordinary application-owned rows use an authenticated application workflow,
# never the SQL/structure or cloud-action gates. This is deliberately one target.
application_workflow_finish(){ # MANIFEST EFFECTIVE_CLASS
  local manifest="$1" effective="$2" head blob summary reason state py
  [ "$IDENTITY" = popcre/designflow-backend ] \
    || blocked 'ai-task-gates: STOP. Application workflow requires canonical popcre/designflow-backend.'
  case "$(git -C "$TOPLEVEL" remote get-url origin 2>/dev/null)" in
    https://github.com/popcre/designflow-backend|https://github.com/popcre/designflow-backend.git|git@github.com:popcre/designflow-backend|git@github.com:popcre/designflow-backend.git|ssh://git@github.com/popcre/designflow-backend|ssh://git@github.com/popcre/designflow-backend.git) ;;
    *) blocked 'ai-task-gates: STOP. Application workflow origin is not canonical.' ;;
  esac
  case "$effective" in reviewer-safety|ui-live-workflow) ;; *) blocked 'ai-task-gates: STOP. Application workflow requires reviewer-safety or ui-live-workflow; stronger/private classes stay sealed.' ;; esac
  if merged_gate "$IDENTITY" "$effective" | grep -qx $'forbidden\tapplication-workflow'; then
    blocked 'ai-task-gates: STOP. A repository-specific application-workflow prohibition remains binding.'
  fi
  [ "$manifest" = .ai-devops/application-workflow-target.json ] \
    || blocked 'ai-task-gates: STOP. Application workflow manifest path is not canonical.'
  py="$(command -v python3 || command -v python)" \
    || blocked 'ai-task-gates: STOP. Application workflow validator runtime is unavailable.'
  "$py" "$REAL_DIR/../tools/application_workflow_target.py" "$TOPLEVEL" "$manifest" \
    || blocked 'ai-task-gates: STOP. Application workflow manifest is malformed, unsafe, or differs from the closed sandbox target.'
  blob="$(application_release_file_blob "$manifest")" \
    || blocked 'ai-task-gates: STOP. Application workflow manifest must be clean and committed at HEAD.'
  head="$(git -C "$TOPLEVEL" rev-parse HEAD)"
  # No AI reviewer verdict gates the application workflow (#2041).
  summary="no-reviewer-gate(#2041)"
  reason="head=$head manifest_blob=$blob approval=$summary"
  state_record_override application-workflow application-workflow "$reason" "$effective" \
    && state="$(state_path)" \
    && jq -e --arg r "$reason" --arg c "$effective" '.overrides | any(.kind=="application-workflow" and .action=="application-workflow" and .observed_class==$c and .reason==$r)' "$state" >/dev/null \
    || blocked 'ai-task-gates: STOP. Application workflow receipt could not be persisted.'
  [ "$(git -C "$TOPLEVEL" rev-parse HEAD)" = "$head" ] \
    && "$py" "$REAL_DIR/../tools/application_workflow_target.py" "$TOPLEVEL" "$manifest" \
    && [ "$(application_release_file_blob "$manifest")" = "$blob" ] \
    || blocked 'ai-task-gates: STOP. Application workflow source or review changed during admission.'
  printf 'ai-task-gates: authenticated HTS sandbox workflow may start; no SQL, cloud mutation, manual promotion, operative Apply/Save or production action is admitted.\n'
}

# A small owner-requested entry is optional history only (owner ruling
# 2026-10-14: database writes skip the second AI). If passed, it records the
# issue/row-count/quote digest in task state. It is no longer required to open
# the database action. Usage: small_owner_entry_summary ACTION ISSUE_URL ROWS QUOTE CLASS
OWNER_LOGINS='["u2giants","popcre"]'
small_owner_entry_summary(){
  local action="$1" url="$2" rows="$3" quote="$4" class="$5" repo num json text
  _soe_stop(){ printf 'ai-task-gates: STOP. %s\n' "$*" >&2; return 1; }
  [ "$action" = database ] || { _soe_stop '--small-owner-entry applies only to --before database.'; return 1; }
  case "$class" in none|prose|code) ;; *) _soe_stop "A small owner entry is row data only; the \"$class\" change set is out of scope for this optional path."; return 1 ;; esac
  [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/issues/[1-9][0-9]*$ ]] \
    || { _soe_stop '--small-owner-entry needs a GitHub issue URL (https://github.com/OWNER/REPO/issues/N).'; return 1; }
  repo="${BASH_REMATCH[1]}"; num="${url##*/}"
  [ "${repo,,}" = "${IDENTITY,,}" ] || { _soe_stop "The owner-request issue must belong to $IDENTITY (got $repo)."; return 1; }
  [[ "$rows" =~ ^[1-9][0-9]?$ ]] && [ "$rows" -le 10 ] \
    || { _soe_stop "A small owner entry needs --row-count between 1 and 10 (got \"$rows\")."; return 1; }
  local squeezed="${quote//[[:space:]]/}"
  [ "${#squeezed}" -ge 12 ] && [[ "$quote" != *$'\n'* ]] && [[ "$quote" != *$'\r'* ]] \
    || { _soe_stop 'A small owner entry needs a one-line --owner-quote of at least 12 non-space characters with the owner request verbatim.'; return 1; }
  [ -f "$(state_path)" ] || { _soe_stop 'A small owner entry needs a declared task (ai-task-gates start) so the release is recorded.'; return 1; }
  json="$(AI_GH_CALLER=ai-task-gates "$SCRIPT_DIR/ai-gh" issue view "$num" -R "$repo" --json url,author,body,comments 2>/dev/null)" \
    || { _soe_stop "Issue $url could not be read from GitHub."; return 1; }
  jq -e --arg u "$url" '.url == $u and (.body|type=="string")' >/dev/null 2>&1 <<<"$json" \
    || { _soe_stop "GitHub did not return issue $url."; return 1; }
  text="$(jq -r --argjson owners "$OWNER_LOGINS" '
    ([{author:.author, user:.user, body:.body}] + (.comments // []))[]
    | select((.author.login // .user.login // "" | ascii_downcase) as $l | $owners | index($l))
    | .body // empty' <<<"$json" | tr -d '\r')"
  grep -qF -- "$quote" <<<"$text" \
    || { _soe_stop "Issue $url does not quote the owner request verbatim in owner-authored text (--owner-quote not found)."; return 1; }
  printf 'small owner entry %s, %s row(s), quote sha256:%s verified in issue; caller must run one guarded transaction asserting exactly %s row(s) after target-database proof' \
    "$url" "$rows" "$(printf '%s' "$quote" | sha256sum | cut -d' ' -f1)" "$rows"
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
cmd_start(){
  local class="" reason="" base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --class) need_value "$@"; class="$2"; shift 2 ;;
      --reason) need_value "$@"; reason="$2"; shift 2 ;;
      --base) need_value "$@"; base="$2"; shift 2 ;;
      *) die "unknown option for start: $1" ;;
    esac
  done
  [ -n "$class" ] || die 'start requires --class.'
  require_jq; load_policy; resolve_repo
  valid_class "$class" || die "unknown change class: $class (valid: $(jqr '.change_classes|keys_unsorted|join(", ")' "$POLICY_FILE"))"
  resolve_base "$base"
  state_write "$(jq -nc \
    --arg v 1 --arg identity "$IDENTITY" --arg worktree "$TOPLEVEL" \
    --arg class "$class" --arg reason "$reason" --arg base "$BASE_REF" \
    --arg start_head "$(git -C "$TOPLEVEL" rev-parse HEAD)" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema_version:($v|tonumber),identity:$identity,worktree:$worktree,declared_class:$class,reason:$reason,base:$base,start_head:$start_head,started_at:$at,overrides:[]}')"
  printf 'task class "%s" recorded for %s (%s)\n' "$class" "$IDENTITY" "$TOPLEVEL"
  [ -n "$BASE_REF" ] && printf 'base: %s\n' "${BASE_REF:0:12}"
  # A repository that ships reviewer tooling states its platform obligations
  # at task start, before any edit (#1783): fixes on one OS kept breaking the other.
  if [ -f "$TOPLEVEL/config/reviewer-platform-brief.txt" ]; then
    printf '\n'; cat "$TOPLEVEL/config/reviewer-platform-brief.txt"
  fi
  return 0
}

cmd_status(){
  require_jq; load_policy; resolve_repo
  local file; file="$(state_path)"
  if [ ! -f "$file" ]; then printf 'no task class recorded for %s (%s)\n' "$IDENTITY" "$TOPLEVEL"; return 0; fi
  cat "$file"
}

cmd_end(){
  require_jq; load_policy; resolve_repo
  rm -f "$(state_path)"
  printf 'task class cleared for %s (%s)\n' "$IDENTITY" "$TOPLEVEL"
}

prepare(){
  local base="$1" paths_from="$2"
  require_jq; load_policy; resolve_repo
  if [ -n "$paths_from" ]; then
    if [ "$paths_from" = - ]; then CHANGED_PATHS="$(cat)"; else
      [ -f "$paths_from" ] || die "paths file not found: $paths_from"
      CHANGED_PATHS="$(cat "$paths_from")"
    fi
    BASE_REF=""
  else
    resolve_base "$base"
    CHANGED_PATHS="$(change_set | LC_ALL=C sort -u)"
  fi
  classify_paths "$IDENTITY" "$CHANGED_PATHS"
}

# A review classifies the same unchanged inventory about ten times (packet
# build, resolve, verify, and snapshot copies, on both the preflight and the
# review path), and every run costs dozens of processes: ~7 s each under Git
# Bash on Windows (#1355). `explain --paths-from FILE` is a pure function of
# the bytes hashed below, so a result is reused only when every one of them is
# byte-identical: this program and its library, the central policy, the
# consumer declaration, the recorded task state, the repository identity and
# top level, the requested output form, and the exact path inventory. Any
# change is a new key. Only a successful result is stored, in the same private
# state directory that already holds the recorded task class. Set
# AI_TASK_GATES_EXPLAIN_CACHE=0 to disable.
explain_cache_key(){ # explain_cache_key AS_JSON PATHS_FILE
  local f state; local -a present=()
  state="$(state_path)" || return 1
  {
    printf 'ai-task-gates-explain-cache-v1\0%s\0%s\0%s\0%s\0' "$1" "$IDENTITY" "$TOPLEVEL" "$POLICY_FILE"
    for f in "${BASH_SOURCE[0]}" "$ROOT/tools/lib/task-gates.sh" "$POLICY_FILE" "$CONSUMER_FILE" "$state"; do
      if [ -f "$f" ]; then printf 'file\0%s\0' "$f"; present+=("$f"); else printf 'absent\0%s\0' "$f"; fi
    done
    # One process hashes every present file; its per-file lines carry the
    # names, so a file moving between slots still changes the key.
    sha256sum -- "${present[@]}" || return 1
    # Callers write the inventory to a fresh temporary file each time, so
    # only its bytes, never its name, are part of the key.
    printf 'inventory\0'; sha256sum < "$2" || return 1
  } | sha256sum | cut -d' ' -f1
}

# Gates this tool actually checks. Anything else a policy lists is recorded
# and printed under "not checked by this tool"; it is never claimed as satisfied
# or enforced here. Keep this list in step with the enforcement code paths.
GATE_ENFORCED_RE='^(never-open-raw-transcript-archives|current-chat-resource-and-action-authorization|synthetic-fixtures-only|reviewed-private-data-writer|production-promotion-authorization|oracle-native-alternate(-v2)?-descriptor-only-admission)$'
# split_required_gates CSV -> REQUIRED_CHECKED (enforced here) and REQUIRED_UNCHECKED
# Owner ruling 2026-10-29 (#2041, "skinny" review): review is advice, never a
# gate. No class requires an AI reviewer verdict in any repository. A reviewer
# gate that a policy (or an older consumer declaration) still lists is
# reported as waived and never enforced. Production keeps its owner
# authorization gate (current-chat-resource-and-action-authorization).
REVIEWER_GATE_RE='^(assigned-ai-reviewer-approval|exact-head-independent-review|exact-resource-and-action-ai-reviewer-approval|release-marker-review|reviewed-toolkit-installation|reviewed-generated-definition-fixture-only)$'
# Identity aliases come from config/repository-coverage.json ("aliases" per
# repository): a checkout whose origin still reads the pre-transfer name
# u2giants/shared-db is the same repository and keeps the same gates (#1962).
canonical_identity(){
  local coverage="$ROOT/config/repository-coverage.json" canonical=""
  [ -f "$coverage" ] && canonical="$(jq -r --arg id "$IDENTITY" '[.repositories[]? | select((.aliases // []) | index($id)) | .identity][0] // empty' "$coverage" 2>/dev/null | tr -d '\r')"
  printf '%s' "${canonical:-$IDENTITY}"
}
split_required_gates(){
  local all="$1" checked
  REQUIRED_WAIVED="$(printf '%s\n' "$all" | tr ',' '\n' | grep -E "$REVIEWER_GATE_RE" | paste -sd, - || true)"
  all="$(printf '%s\n' "$all" | tr ',' '\n' | grep -vE "$REVIEWER_GATE_RE" | grep -v '^$' | paste -sd, - || true)"
  checked="$(printf '%s\n' "$all" | tr ',' '\n' | grep -E "$GATE_ENFORCED_RE" || true)"
  REQUIRED_CHECKED="$(printf '%s\n' "$checked" | grep -v '^$' | paste -sd, - || true)"
  REQUIRED_UNCHECKED="$(printf '%s\n' "$all" | tr ',' '\n' | grep -v '^$' | grep -vxF "$(printf '%s\n' "$REQUIRED_CHECKED" | tr ',' '\n')" | paste -sd, - || true)"
}

cmd_explain_cached(){
  local arg as_json=false paths_from="" other=false key="" dir file out rc
  local -a args=("$@")
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --paths-from) paths_from="${2:-}"; shift 2 2>/dev/null || shift ;;
      *) other=true; shift ;;
    esac
  done
  if [ "${AI_TASK_GATES_EXPLAIN_CACHE:-1}" = 0 ] || [ "$other" = true ] \
     || [ -z "$paths_from" ] || [ "$paths_from" = - ] || [ ! -f "$paths_from" ]; then
    cmd_explain "${args[@]+"${args[@]}"}"; return
  fi
  require_jq; resolve_repo
  dir="$STATE_DIR/explain-cache"
  key="$(explain_cache_key "$as_json" "$paths_from")" || key=""
  case "$key" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
    *) cmd_explain "${args[@]}"; return ;;
  esac
  file="$dir/$key"
  if [ -f "$file" ] && [ ! -L "$file" ]; then cat "$file"; return; fi
  out="$(cmd_explain "${args[@]}"; rc=$?; printf x; exit "$rc")"; rc=$?
  out="${out%x}"; printf '%s' "$out"
  [ "$rc" -eq 0 ] || return "$rc"
  # An input that changed while the answer was computed would file a new
  # answer under the old key; store only when the key still holds.
  [ "$(explain_cache_key "$as_json" "$paths_from" 2>/dev/null)" = "$key" ] || return 0
  # A failed store only loses the reuse; it never changes the answer.
  ( umask 077; mkdir -p "$dir" 2>/dev/null && chmod 0700 "$dir" 2>/dev/null
    tmp="$(mktemp "$dir/.tmp.XXXXXX" 2>/dev/null)" || exit 0
    printf '%s' "$out" > "$tmp" && mv -f "$tmp" "$file" || rm -f "$tmp"
    find "$dir" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null ) || true
  return 0
}

# AI_TASK_GATES_INPUTS_TO=FILE (#1355): after a successful explain, name every
# file the answer depended on, one absolute path per line, so a caller that
# reuses the answer can prove each one is unchanged. This includes the state
# file under whatever HOME a launcher set. The answer itself is unchanged; an
# unwritable list leaves the caller without one, and it then never reuses.
explain_write_inputs(){
  local out="${AI_TASK_GATES_INPUTS_TO:-}" f
  [ -n "$out" ] || return 0
  [ -n "$TOPLEVEL" ] || resolve_repo
  { for f in "$REAL_DIR/$(basename "${BASH_SOURCE[0]}")" "$ROOT/tools/lib/task-gates.sh" "$POLICY_FILE" "$CONSUMER_FILE" "$(state_path)"; do
      case "$f" in /*) ;; *) f="$PWD/$f" ;; esac
      printf '%s\n' "$f"
    done; } > "$out" 2>/dev/null || { rm -f "$out" 2>/dev/null; return 0; }
}

cmd_explain(){
  local as_json=false base="" paths_from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --base) need_value "$@"; base="$2"; shift 2 ;;
      --paths-from) need_value "$@"; paths_from="$2"; shift 2 ;;
      *) die "unknown option for explain: $1" ;;
    esac
  done
  prepare "$base" "$paths_from"
  local declared effective required_gate effective_gate required forbidden line reviewer_release=0
  declared="$(state_field declared_class)"
  effective="$OBSERVED_CLASS"
  if [ -n "$declared" ]; then
    valid_class "$declared" || fail_closed "recorded task class '$declared' is not a declared change class (stale or corrupt state)."
    if [ "$OBSERVED_CLASS" = none ] || [ "${TG_RANK[$declared]}" -gt "$OBSERVED_RANK" ]; then
      effective="$declared"
    fi
  fi
  # Same sticky rule as check: one licensed path keeps private-evidence.
  local contributor
  for contributor in "${CONTRIBUTORS[@]+"${CONTRIBUTORS[@]}"}"; do
    case "$contributor" in
      private-evidence$'\t'*)
        effective=private-evidence
        break
        ;;
    esac
  done
  required_gate="$({
    [ "$OBSERVED_CLASS" = none ] || merged_gate "$IDENTITY" "$OBSERVED_CLASS"
    [ -z "$declared" ] || [ "$declared" = "$OBSERVED_CLASS" ] || merged_gate "$IDENTITY" "$declared"
    for line in "${CONTRIBUTORS[@]}"; do
      if [ "${line%%$'\t'*}" = reviewer-safety ]; then reviewer_release=1; break; fi
    done
    [ "$declared" = reviewer-safety ] && reviewer_release=1
    [ "$reviewer_release" -eq 0 ] || merged_gate "$IDENTITY" reviewer-safety
  } 2>/dev/null | LC_ALL=C sort -u)"
  effective_gate="$(merged_gate "$IDENTITY" "$effective" 2>/dev/null || true)"
  local required_full="" unchecked_required=""
  required_full="$(printf '%s\n' "$required_gate" | sed -n 's/^required\t//p' | paste -sd, -)"; split_required_gates "$required_full"; required="$REQUIRED_CHECKED"; unchecked_required="$REQUIRED_UNCHECKED"
  forbidden="$(printf '%s\n' "$effective_gate" | sed -n 's/^forbidden\t//p' | paste -sd, -)"

  if [ "$as_json" = true ]; then
    printf '%s\n' "$(printf '%s\n' "${CONTRIBUTORS[@]+"${CONTRIBUTORS[@]}"}" | jq -R -s --arg identity "$IDENTITY" \
      --arg resolved "$IDENTITY_RESOLVED" --arg worktree "$TOPLEVEL" --arg base "$BASE_REF" \
      --arg observed "$OBSERVED_CLASS" --arg declared "$declared" --arg effective "$effective" --arg policy "$POLICY_FILE" \
      --arg required "$required" --arg unchecked "$unchecked_required" --arg forbidden "$forbidden" --arg count "$CHANGED_COUNT" \
      --arg waived "${REQUIRED_WAIVED:-}" --arg rawarch "${RAW_ARCHIVE_PATHS:-}" '
      {schema_version:1,
       repository:$identity, identity_resolved:($resolved=="true"), worktree:$worktree,
       base:$base, policy_file:$policy,
       changed_count:($count|tonumber),
       declared_class:(if $declared=="" then null else $declared end),
       observed_class:$observed,
       effective_class:$effective,
       required_gates:(if $required=="" then [] else ($required|split(",")) end),
       unchecked_gates:(if $unchecked=="" then [] else ($unchecked|split(",")) end),
       waived_gates:(if $waived=="" then [] else ($waived|split(",")) end),
       forbidden_actions:(if $forbidden=="" then [] else ($forbidden|split(",")) end),
       raw_archive_paths:($rawarch|split("\n")|map(select(length>0))),
       changes:[splits("\n")|select(length>0)|split("\t")|{class:.[0],path:.[1]}]}')"
    return 0
  fi

  printf 'repository       : %s%s\n' "$IDENTITY" "$([ "$IDENTITY_RESOLVED" = true ] || printf ' (unresolved remote)')"
  printf 'worktree         : %s\n' "$TOPLEVEL"
  printf 'base             : %s\n' "${BASE_REF:-<none>}"
  printf 'declared class   : %s\n' "${declared:-<not declared>}"
  printf 'observed class   : %s (%s changed path(s))\n' "$OBSERVED_CLASS" "$CHANGED_COUNT"
  printf 'effective class  : %s\n' "$effective"
  printf 'required gates   : %s\n' "${required:-<none>}"
  [ -z "${unchecked_required:-}" ] || printf 'not checked by this tool: %s\n' "$unchecked_required"
  printf 'forbidden actions: %s\n' "${forbidden:-<none>}"
  if [ -n "${RAW_ARCHIVE_PATHS:-}" ]; then
    printf 'raw archives     : %s\n' "$(printf '%s' "$RAW_ARCHIVE_PATHS" | sed '/^$/d' | paste -sd' ' -)"
    printf '%s\n' '                 raw transcript or chat archives found; never-open-raw-transcript-archives refuses every action until they leave the change set.'
  fi
  if [ "$CHANGED_COUNT" -gt 0 ]; then
    printf 'changes:\n'
    for line in "${CONTRIBUTORS[@]}"; do printf '  %-18s %s\n' "${line%%	*}" "${line#*	}"; done
  fi
}

windows_program_files(){
  if [ -n "${PROGRAMFILES:-${ProgramFiles:-}}" ]; then
    printf '%s\n' "${PROGRAMFILES:-${ProgramFiles:-}}"
  elif [ -f '/c/Program Files/Git/bin/bash.exe' ]; then
    cygpath -aw '/c/Program Files'
  fi
}

windows_launcher_route(){
  local expected_source="$1" installed_launcher="$2" cmd_launcher="$2.cmd"
  local launcher_target expected_target source_path cmd_route expected_programfiles expected_localappdata program_files local_app_data offset
  local bash_home cmd_home expected_home
  local -a bash_lines=() cmd_lines=()
  [ -f "$installed_launcher" ] && [ -f "$cmd_launcher" ] || return 1
  mapfile -t bash_lines < <(tr -d '\r' < "$installed_launcher")
  mapfile -t cmd_lines < <(tr -d '\r' < "$cmd_launcher")
  [ "${#bash_lines[@]}" -eq "${#cmd_lines[@]}" ] || return 1
  case "${#bash_lines[@]}" in 4|6) ;; *) return 1 ;; esac
  [ "${bash_lines[0]}" = '#!/usr/bin/env bash' ] || return 1
  [ "${bash_lines[1]}" = '# Managed by ai-devops install-machine-tools.ps1.' ] || return 1
  [ "${cmd_lines[0]}" = '@echo off' ] || return 1
  [ "${cmd_lines[1]}" = 'rem Managed by ai-devops install-machine-tools.ps1.' ] || return 1
  WINDOWS_RECEIPT_SHA="" WINDOWS_RECEIPT_HASH=""
  offset=2
  if [ "${#bash_lines[@]}" -eq 6 ]; then
    WINDOWS_RECEIPT_SHA="${bash_lines[2]#\# source-sha=}"
    WINDOWS_RECEIPT_HASH="${bash_lines[3]#\# source-hash=}"
    [ "${bash_lines[2]}" = "# source-sha=$WINDOWS_RECEIPT_SHA" ] && [[ "$WINDOWS_RECEIPT_SHA" =~ ^[0-9a-f]{40}$ ]] || return 1
    [ "${bash_lines[3]}" = "# source-hash=$WINDOWS_RECEIPT_HASH" ] && [[ "$WINDOWS_RECEIPT_HASH" =~ ^[0-9a-f]{64}$ ]] || return 1
    [ "${cmd_lines[2]}" = "rem source-sha=$WINDOWS_RECEIPT_SHA" ] || return 1
    [ "${cmd_lines[3]}" = "rem source-hash=$WINDOWS_RECEIPT_HASH" ] || return 1
    offset=4
  fi
  [[ "${bash_lines[$offset]}" =~ ^export\ HOME=\"[^\"]+\"$ ]] || return 1
  [[ "${cmd_lines[$offset]}" =~ ^set\ \"HOME=[^\"]+\"$ ]] || return 1
  bash_home="${bash_lines[$offset]#export HOME=\"}"; bash_home="${bash_home%\"}"
  cmd_home="${cmd_lines[$offset]#set \"HOME=}"; cmd_home="${cmd_home%\"}"
  [ -n "${USERPROFILE:-}" ] || return 1
  expected_home="$(cygpath -wa "$USERPROFILE" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ -n "$expected_home" ] || return 1
  [ "$(cygpath -wa "$bash_home" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_home" ] || return 1
  [ "$(cygpath -wa "$cmd_home" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_home" ] || return 1
  source_path="$(sed -n 's/^exec "\(.*\)" "\$@"$/\1/p' <<< "${bash_lines[$((offset+1))]}")"
  [ -n "$source_path" ] && command -v cygpath >/dev/null 2>&1 || return 1
  launcher_target="$(cygpath -wa "$source_path" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  expected_target="$(cygpath -wa "$expected_source" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ -n "$launcher_target" ] && [ "$launcher_target" = "$expected_target" ] || return 1
  cmd_route="${cmd_lines[$((offset+1))]}"
  program_files="$(windows_program_files)"
  local_app_data="${LOCALAPPDATA:-${LocalAppData:-}}"
  expected_programfiles="\"${program_files}\Git\bin\bash.exe\" \"$source_path\" %*"
  expected_localappdata="\"${local_app_data}\Programs\Git\bin\bash.exe\" \"$source_path\" %*"
  if [ -n "$program_files" ] && [ "$cmd_route" = "$expected_programfiles" ]; then :
  elif [ -n "$local_app_data" ] && [ "$cmd_route" = "$expected_localappdata" ]; then :
  else return 1
  fi
}

windows_partial_launcher_route(){
  local expected_source="$1" launcher="$2" source_path expected_target expected_home line route
  local -a lines=()
  command -v cygpath >/dev/null 2>&1 && [ -n "${USERPROFILE:-}" ] || return 1
  expected_target="$(cygpath -wa "$expected_source" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  expected_home="$(cygpath -wa "$USERPROFILE" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  if [ -f "$launcher" ]; then
    mapfile -t lines < <(tr -d '\r' < "$launcher")
    [ "${#lines[@]}" -eq 4 ] || [ "${#lines[@]}" -eq 6 ] || return 1
    [ "${lines[0]}" = '#!/usr/bin/env bash' ] && [ "${lines[1]}" = '# Managed by ai-devops install-machine-tools.ps1.' ] || return 1
    local offset=2
    if [ "${#lines[@]}" -eq 6 ]; then
      [[ "${lines[2]}" =~ ^\#\ source-sha=[0-9a-f]{40}$ ]] && [[ "${lines[3]}" =~ ^\#\ source-hash=[0-9a-f]{64}$ ]] || return 1
      offset=4
    fi
    [[ "${lines[$offset]}" =~ ^export\ HOME=\"[^\"]+\"$ ]] || return 1
    line="${lines[$offset]#export HOME=\"}"; line="${line%\"}"
    [ "$(cygpath -wa "$line" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_home" ] || return 1
    source_path="$(sed -n 's/^exec "\(.*\)" "\$@"$/\1/p' <<< "${lines[$((offset+1))]}")"
    [ -n "$source_path" ] && [ "$(cygpath -wa "$source_path" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_target" ] || return 1
  else
    mapfile -t lines < <(tr -d '\r' < "$launcher.cmd")
    [ "${#lines[@]}" -eq 4 ] || [ "${#lines[@]}" -eq 6 ] || return 1
    [ "${lines[0]}" = '@echo off' ] && [ "${lines[1]}" = 'rem Managed by ai-devops install-machine-tools.ps1.' ] || return 1
    local offset=2
    if [ "${#lines[@]}" -eq 6 ]; then
      [[ "${lines[2]}" =~ ^rem\ source-sha=[0-9a-f]{40}$ ]] && [[ "${lines[3]}" =~ ^rem\ source-hash=[0-9a-f]{64}$ ]] || return 1
      offset=4
    fi
    [[ "${lines[$offset]}" =~ ^set\ \"HOME=[^\"]+\"$ ]] || return 1
    line="${lines[$offset]#set \"HOME=}"; line="${line%\"}"
    [ "$(cygpath -wa "$line" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_home" ] || return 1
    route="${lines[$((offset+1))]}"
    local cmd_exe
    cmd_exe="$(sed -n 's/^"\([^"]*\)" "[^"]*" %\*$/\1/p' <<< "$route")"
    source_path="$(sed -n 's/^"[^"]*" "\([^"]*\)" %\*$/\1/p' <<< "$route")"
    [ -n "$source_path" ] && [ "$(cygpath -wa "$source_path" 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "$expected_target" ] || return 1
    local program_files
    program_files="$(windows_program_files)"
    [ -n "$program_files" ] && [ "$cmd_exe" = "${program_files}\\Git\\bin\\bash.exe" ] ||
      { [ -n "${LOCALAPPDATA:-${LocalAppData:-}}" ] && [ "$cmd_exe" = "${LOCALAPPDATA:-${LocalAppData:-}}\\Programs\\Git\\bin\\bash.exe" ]; } || return 1
  fi
}

windows_managed_inventory(){
  local launcher_dir="$1" catalog="$2" row name path digest
  local -A found=()
  while IFS= read -r row; do
    [ -n "$row" ] && [[ "$row" != \#* ]] || continue
    name="${row%%$'\t'*}"
    for path in "$launcher_dir/$name" "$launcher_dir/$name.cmd"; do
      [ ! -e "$path" ] && [ ! -L "$path" ] && continue
      [ -f "$path" ] && [ ! -L "$path" ] || return 1
      found["$(basename "$path")"]=1
    done
  done < "$catalog"
  for path in "$launcher_dir"/*; do
    [ -f "$path" ] || continue
    if head -c 256 "$path" | tr -d '\r' | grep -Fq 'Managed by ai-devops install-machine-tools.ps1.'; then
      [ ! -L "$path" ] || return 1
      found["$(basename "$path")"]=1
    fi
  done
  for name in "${!found[@]}"; do
    digest="$(sha256sum "$launcher_dir/$name" | cut -d' ' -f1)" || return 1
    printf '%s\t%s\n' "$name" "$digest"
  done | LC_ALL=C sort
}

toolkit_source_receipt(){
  local installed_root="$1" installed_launcher="$2" installed_head="$3" manifest="$4" expected_source="$1/bin/ai-task-gates"
  local source_hash marker_sha marker_hash cmd_launcher manifest manifest_sha row_hash row_source
  [ -f "$expected_source" ] && [ -f "$installed_launcher" ] || return 1
  source_hash="$(sha256sum "$expected_source" 2>/dev/null | cut -d' ' -f1)"
  [[ "$source_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  if [ -L "$installed_launcher" ]; then
    [ "$(readlink -f "$installed_launcher")" = "$(readlink -f "$expected_source")" ] || return 1
    [ -f "$manifest" ] || return 1
    manifest_sha="$(awk -F '\t' '$1=="meta" && $2=="source_sha" {print $3}' "$manifest")"
    [ "$manifest_sha" = "$installed_head" ] || return 1
    row_hash="$(awk -F '\t' -v p="$installed_launcher" '$1=="symlink" && $2==p {print $4}' "$manifest")"
    row_source="$(awk -F '\t' -v p="$installed_launcher" '$1=="symlink" && $2==p {print $3}' "$manifest")"
    [ "$row_source" = "$expected_source" ] && [ "$row_hash" = "$source_hash" ] || return 1
  else
    windows_launcher_route "$expected_source" "$installed_launcher" || return 1
    [ "$WINDOWS_RECEIPT_SHA" = "$installed_head" ] && [ "$WINDOWS_RECEIPT_HASH" = "$source_hash" ] || return 1
  fi
}

cmd_check(){
  local scoped_skills_plan=""
  local action="" acknowledge="" reviewer_approval="" approval_summary="" base="" start_head="" source_changed_count=0
  local target_head="" installed_checkout="" installed_launcher="" first_install=0
  local small_entry="" small_rows="" small_quote="" action_manifest_stdin=0 action_manifest_file="" action_stage=initial-forward
  local application_release_target="" application_workflow_target="" base_explicit=0 application_release_ready=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --scoped-skills-plan) need_value "$@"; scoped_skills_plan="$2"; shift 2 ;;
      --action-stage) need_value "$@"; action_stage="$2"; shift 2 ;;
      --action-manifest-stdin) action_manifest_stdin=1; shift ;;
      --before) need_value "$@"; action="$2"; shift 2 ;;
      --acknowledge) need_value "$@"; acknowledge="$2"; shift 2 ;;
      --reviewer-approval) need_value "$@"; reviewer_approval="$2"; shift 2 ;;
      --small-owner-entry) need_value "$@"; small_entry="$2"; shift 2 ;;
      --row-count) need_value "$@"; small_rows="$2"; shift 2 ;;
      --owner-quote) need_value "$@"; small_quote="$2"; shift 2 ;;
      --base) need_value "$@"; base="$2"; base_explicit=1; shift 2 ;;
      --target-head) need_value "$@"; target_head="$2"; shift 2 ;;
      --installed-checkout) need_value "$@"; installed_checkout="$2"; shift 2 ;;
      --installed-launcher) need_value "$@"; installed_launcher="$2"; shift 2 ;;
      --first-install) first_install=1; shift ;;
      --application-release-target) need_value "$@"; application_release_target="$2"; shift 2 ;;
      --application-workflow-target) need_value "$@"; application_workflow_target="$2"; shift 2 ;;
      *) die "unknown option for check: $1" ;;
    esac
  done
  [ -n "$action" ] || die 'check requires --before ACTION.'
  if [ -z "$small_entry" ]; then
    [ -z "$small_rows$small_quote" ] || die '--row-count and --owner-quote need --small-owner-entry.'
  else
    [ -z "$reviewer_approval" ] || die '--small-owner-entry and --reviewer-approval are mutually exclusive.'
  fi
  case "$action_stage" in initial-forward) ;; original-restoration) [ "$action_manifest_stdin" -eq 1 ] || die 'restoration stage requires bounded action stdin.' ;; *) die 'unknown bounded action stage.' ;; esac
  if [ "$action_manifest_stdin" -eq 1 ]; then
    { [ "$action" = database ] || [ "$action" = offline-private-capture-transform ]; } && [ -n "$reviewer_approval" ] && [ -z "$base$small_entry" ] || die 'bounded action stdin requires a closed native action, reviewer approval, and unchanged recorded task base.'
    action_manifest_file="$(umask 077; mktemp)" || die 'cannot reserve private action stdin.'
    trap "$(printf 'rm -f -- %q' "$action_manifest_file")" EXIT
    head -c 16777217 > "$action_manifest_file" || die 'cannot retain bounded action stdin.'
    [ "$(wc -c < "$action_manifest_file")" -le 16777216 ] || die 'action stdin exceeds native bound.'
  fi
  # Only this explicit public fixture gets confined Git before discovery/status.
  # Preflight is metadata validation, never action authority or a release token.
  if [ "$action" = database ] && [ -n "$action_manifest_file" ] \
     && /usr/bin/python3 "$ROOT/tools/generated_definition_action.py" generated-select < "$action_manifest_file" >/dev/null 2>&1; then
    [ -z "${BASH_ENV+x}${ENV+x}" ] || blocked 'ai-task-gates: STOP. Generated fixture shell startup environment refused.'
    /usr/bin/python3 "$ROOT/tools/generated_definition_action.py" generated-preflight "$PWD" \
      || blocked 'ai-task-gates: STOP. Generated fixture pre-discovery confinement refused.'
    export PATH=/usr/bin:/bin GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_OPTIONAL_LOCKS=0
    export GIT_NO_REPLACE_OBJECTS=1 GIT_NO_LAZY_FETCH=1 GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2
    export GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false
    export GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=/dev/null
  fi
  if [ -n "$application_release_target" ]; then
    [ "$action" = deploy ] || blocked 'ai-task-gates: STOP. --application-release-target applies only to --before deploy.'
    [ "$base_explicit" -eq 0 ] || blocked 'ai-task-gates: STOP. --application-release-target cannot be combined with explicit --base.'
    [ -z "$acknowledge$small_entry$small_rows$small_quote$target_head$installed_checkout$installed_launcher" ] \
      && [ "$first_install" -eq 0 ] \
      || blocked 'ai-task-gates: STOP. --application-release-target cannot be combined with acknowledge, small-owner-entry, or toolkit installation arguments.'
    # No Git invocation/discovery has happened yet. Backend stays on its
    # original path; a new target must pass confinement before classification.
    APP_RELEASE_PREFLIGHT="$(application_release_supplement preflight "$PWD")" \
      || blocked 'ai-task-gates: STOP. New source-release pre-discovery confinement refused.'
    APP_RELEASE_PROOF=''
  fi
  require_jq; load_policy
  valid_action "$action" || die "unknown action: $action"
  # never-open-raw-transcript-archives is enforced for every action, whether
  # or not a policy lists it. Scan the change set before every
  # action-specific argument, declaration, dispatch, and class check below so
  # the refusal names the archive itself — including before the
  # application-workflow dispatch, which returns without ever reaching a
  # later archive check. A scan that cannot classify (no repository yet)
  # falls through to the same checks it would have mirrored in `prepare`.
  refuse_raw_archives "$action" "$(check_change_set "$action" "$base")"
  if [ "$action" = scoped-skills-install ]; then
    [ -n "$scoped_skills_plan" ] && [ -n "$reviewer_approval" ] \
      && [ -z "$base$acknowledge$small_entry$small_rows$small_quote$target_head$installed_checkout$installed_launcher$application_release_target$application_workflow_target" ] \
      && [ "$first_install" -eq 0 ] && [ "$action_manifest_stdin" -eq 0 ] \
      || blocked 'ai-task-gates: STOP. Scoped skill installation needs only its exact plan and independent approval.'
    resolve_repo
    [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]] || blocked 'ai-task-gates: STOP. Scoped skill installation is ai-devops only.'
    [ "$(state_field declared_class)" = installation ] || blocked 'ai-task-gates: STOP. Scoped skill installation requires a declared installation task.'
    [ "$ROOT" = "$TOPLEVEL" ] && [ "$POLICY_FILE" = "$ROOT/config/task-gates.json" ] || blocked 'ai-task-gates: STOP. Scoped installation requires its candidate gate and policy.'
    python3 "$ROOT/tools/scoped_skills_install.py" validate "$scoped_skills_plan" "$TOPLEVEL" "$reviewer_approval" \
      || blocked 'ai-task-gates: STOP. Scoped source, destinations or snapshot no longer match.'
    decide_local_tests_required deploy "$(merged_gate "$IDENTITY" installation | sed -n 's/^required\t//p' | paste -sd, -)" 1
    approval_summary="$(reviewer_approval_summary "$reviewer_approval" deploy "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL")" \
      || approval_refused deploy $? 'ai-task-gates: STOP. Scoped installation needs exact-source independent APPROVE with bound passing tests.'
    printf 'ai-task-gates: scoped skill installation approved: %s\n' "$approval_summary"
    return 0
  fi
  [ -z "$scoped_skills_plan" ] || die '--scoped-skills-plan requires scoped-skills-install.'
  if [ "$action" = application-workflow ] || [ -n "$application_workflow_target" ]; then
    [ "$action" = application-workflow ] && [ -n "$application_workflow_target" ] \
      && [ -z "$base$acknowledge$small_entry$application_release_target$target_head$installed_checkout$installed_launcher" ] \
      && [ "$first_install" -eq 0 ] && [ "$action_manifest_stdin" -eq 0 ] \
      || blocked 'ai-task-gates: STOP. Application workflow needs only its committed target; alternate action, base or bypass arguments are refused.'
  fi
  if [ "$action" = deploy ]; then
    resolve_repo
    if [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]]; then
      start_head="$(state_field start_head)"
      [ -n "$start_head" ] || blocked 'ai-task-gates: STOP. Toolkit installation requires a task declaration recorded before updating the host checkout.'
      git -C "$TOPLEVEL" merge-base --is-ancestor "$start_head" HEAD 2>/dev/null || blocked 'ai-task-gates: STOP. The pre-update HEAD is not an ancestor of the release to install.'
      if [ -n "$base" ]; then
        [ "$(git -C "$TOPLEVEL" rev-parse --verify --quiet "$base^{commit}" 2>/dev/null)" = "$start_head" ] || blocked 'ai-task-gates: STOP. The requested base differs from the recorded pre-update HEAD.'
      fi
      base="$start_head"
    fi
  fi
  prepare "$base" ""
  if [ "$action" = deploy ] && [ -z "$application_release_target" ]; then
    case "$IDENTITY" in
      popcre/designflow-tracking|popcre/designflow-frontend|popcre/designflow-item-master)
        # Opt-in persists after its declaration becomes upstream. A later
        # ordinary app/pipeline delta cannot fall back to generic deploy and
        # omit the exact-target/fresh-context proof. Backend stays unchanged.
        if merged_gate "$IDENTITY" deployment | grep -Fqx "$(printf 'required\t%s' "$APP_RELEASE_CONSUMER_GATE")"; then
          blocked 'ai-task-gates: STOP. This application requires explicit --application-release-target for its closed source-release lane; generic deploy is refused.'
        fi ;;
    esac
  fi
  # The classified change set must carry no raw transcript archive either.
  # This runs before any full-inventory reclassification below, so the check
  # always judges the original change-set paths — historical files that merely
  # exist in the repository never rewrite the verdict.
  refuse_raw_archives "$action" "${RAW_ARCHIVE_PATHS:-}"
  source_changed_count="$CHANGED_COUNT"
  if [ "$action" = deploy ] && [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]] && [ "$source_changed_count" -eq 0 ]; then
    # No AI reviewer verdict gates a toolkit installation (#2041); the
    # declared installation task and the exact-source checks below remain.
    [ "$(state_field declared_class)" = installation ] || blocked 'ai-task-gates: STOP. Same-source toolkit installation requires a declared installation task.'
    [ -n "$installed_checkout" ] && [ -n "$installed_launcher" ] || blocked 'ai-task-gates: STOP. A same-source toolkit installation needs the installed checkout and launcher paths.'
    local same_root same_head expected_launcher
    same_root="$(cd "$installed_checkout" 2>/dev/null && pwd -P)" || blocked 'ai-task-gates: STOP. Installed checkout path is unavailable.'
    [ "$same_root" = "$(cd "$TOPLEVEL" && pwd -P)" ] || blocked 'ai-task-gates: STOP. Same-source installation must run from the installed checkout.'
    [ "$(git -C "$same_root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" = "$(git -C "$same_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Same-source installation requires a durable primary checkout.'
    same_head="$(git -C "$same_root" rev-parse HEAD 2>/dev/null)" || blocked 'ai-task-gates: STOP. Installed checkout HEAD is unavailable.'
    [ -z "$target_head" ] || [ "$target_head" = "$same_head" ] || blocked 'ai-task-gates: STOP. Same-source target differs from the installed commit.'
    [ "$same_head" = "$start_head" ] && [ "$same_head" = "$(git -C "$TOPLEVEL" rev-parse HEAD)" ] || blocked 'ai-task-gates: STOP. Same-source install does not match the recorded source HEAD.'
    git -C "$same_root" merge-base --is-ancestor "$same_head" refs/remotes/origin/main 2>/dev/null || blocked 'ai-task-gates: STOP. Same-source target is not in the fetched origin/main release history.'
    [ -z "$(git -C "$same_root" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Installed checkout has local changes.'
    [ -z "$(git -C "$TOPLEVEL" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Candidate checkout has local changes.'
    [ -f "$same_root/bin/ai-task-gates" ] || blocked 'ai-task-gates: STOP. Installed gate source is missing.'
    if [[ "$(uname -s)" = MINGW* || "$(uname -s)" = MSYS* || "$(uname -s)" = CYGWIN* ]]; then
      expected_launcher="$HOME/.local/bin/ai-task-gates"
    else
      expected_launcher="/usr/local/bin/ai-task-gates"
    fi
    [ "$installed_launcher" = "$expected_launcher" ] || blocked 'ai-task-gates: STOP. Same-source install must name the canonical launcher.'
    local origin_url
    origin_url="$(git -C "$same_root" config --get remote.origin.url 2>/dev/null || true)"
    case "$origin_url" in
      https://github.com/popcre/ai-devops|https://github.com/popcre/ai-devops.git|git@github.com:popcre/ai-devops|git@github.com:popcre/ai-devops.git|ssh://git@github.com/popcre/ai-devops|ssh://git@github.com/popcre/ai-devops.git|https://github.com/u2giants/ai-devops|https://github.com/u2giants/ai-devops.git|git@github.com:u2giants/ai-devops|git@github.com:u2giants/ai-devops.git|ssh://git@github.com/u2giants/ai-devops|ssh://git@github.com/u2giants/ai-devops.git) ;;
      *) blocked 'ai-task-gates: STOP. Same-source installation requires a supported ai-devops GitHub origin.' ;;
    esac
    if [ "$first_install" -eq 1 ]; then
      [ ! -e "$installed_launcher" ] && [ ! -L "$installed_launcher" ] && [ ! -e "$installed_launcher.cmd" ] || blocked 'ai-task-gates: STOP. A managed launcher already exists; this is not a first install.'
    else
      toolkit_source_receipt "$same_root" "$installed_launcher" "$same_head" /etc/ai-devops/install-manifest.tsv || blocked 'ai-task-gates: STOP. Installed source receipt is missing or differs from the current checkout; start the gate before the next update.'
    fi
  fi
  if [ "$action" = deploy ] && [ "$first_install" -eq 1 ] && [ "$source_changed_count" -gt 0 ]; then
    blocked 'ai-task-gates: STOP. First-install claim cannot replace a nonempty update proof.'
  fi

  # Fail closed where it matters: an unresolvable repository identity must not
  # be allowed to reach a database, deployment, infrastructure, or production
  # helper on central defaults alone.
  if [ "$IDENTITY_RESOLVED" != true ]; then
    case "$action" in
      deploy|database|infrastructure|production|shared-db-promotion|application-workflow|offline-private-capture-transform)
        fail_closed "repository identity is unresolved; refusing to start '$action'." ;;
    esac
  fi

  local declared declared_rank effective effective_rank protected
  declared="$(state_field declared_class)"
  # An action bound to per-action proofs is a property of the whole repository,
  # not of one change set. With nothing observed, judging it against a leftover
  # or absent declaration alone would let a plain `start --class code` open the
  # sealed route in a private repository that never opted in (exact-head review,
  # 2026-09-25). Classify the COMPLETE inventory instead — the same set the
  # private-source front door classifies — so the proof binding is checked
  # against what the repository is, not against what nothing changed into.
  if [ "$OBSERVED_CLASS" = none ] && [ "$action" != deploy ] && [ -n "$(jqr --arg a "$action" '.action_gates[$a] // empty' "$POLICY_FILE")" ]; then
    # The inventory feeds a line-based classifier, and Git's display quoting
    # rewrites non-ASCII and special-character names into spellings no path
    # rule matches, which would drop them to the fallback class and silently
    # skip the proof binding (exact-head review, 2026-09-25). Convert the NUL
    # stream exactly as the sandbox does; a name carrying a CR or LF byte still
    # refuses rather than mis-splitting.
    local inv_python inv_names
    inv_python="$(command -v python3 || command -v python)" \
      || fail_closed "python is required to classify the repository inventory for '$action'."
    if ! inv_names="$(git -C "$TOPLEVEL" ls-files -co --exclude-standard -z | "$inv_python" -c '
import sys
names=[n.decode("utf-8", "surrogateescape") for n in sys.stdin.buffer.read().split(b"\0") if n]
if any("\n" in n or "\r" in n for n in names): sys.exit(2)
sys.stdout.buffer.write(("\n".join(names) + "\n").encode("utf-8", "surrogateescape"))
')"; then
      fail_closed "the repository inventory contains file names this gate cannot represent; refusing to start '$action'."
    fi
    printf 'ai-task-gates: note: no change set observed; classifying the complete inventory for the proof-bound action "%s".\n' "$action" >&2
    local change_set_raw_archives="${RAW_ARCHIVE_PATHS:-}"
    classify_paths "$IDENTITY" "$(printf '%s\n' "$inv_names" | LC_ALL=C sort -u)"
    # never-open-raw-transcript-archives judges the change set only; files
    # that merely exist in the repository's full inventory are not part of it
    # and must not rewrite the change-set verdict.
    RAW_ARCHIVE_PATHS="$change_set_raw_archives"
  fi
  if [ -z "$declared" ]; then
    if [ "$OBSERVED_CLASS" = none ]; then
      case "$action" in
        deploy|database|infrastructure|production|shared-db-promotion|code-only-review|application-workflow)
          fail_closed "no changes and no task class were found; refusing to start '$action' without an explicit declaration." ;;
      esac
      # An action bound to per-action proofs can never take the empty-change-set
      # exit: its action_gates requirement is checked against a classified
      # change set's required proofs, so with nothing observed the binding must
      # refuse instead of silently skipping past the opt-in it exists to enforce.
      if [ -n "$(jqr --arg a "$action" '.action_gates[$a] // empty' "$POLICY_FILE")" ]; then
        fail_closed "no changes and no task class were found; refusing to start '$action': its action_gates proof binding can only be checked against a classified change set."
      fi
      printf 'ai-task-gates: no changes observed; "%s" may start.\n' "$action"; return 0
    fi
    declared="$OBSERVED_CLASS"
    printf 'ai-task-gates: note: no task class was declared; using the observed class "%s".\n' "$OBSERVED_CLASS" >&2
  fi
  valid_class "$declared" || fail_closed "recorded task class '$declared' is not a declared change class (stale or corrupt state)."
  declared_rank="${TG_RANK[$declared]}"
  effective="$OBSERVED_CLASS"; effective_rank="$OBSERVED_RANK"
  if [ "$effective" = none ] || [ "$declared_rank" -gt "$effective_rank" ]; then
    effective="$declared"; effective_rank="$declared_rank"
  fi
  # One licensed path keeps the change set in private-evidence even when a
  # higher-ranked declaration or tooling exception would otherwise win.
  local contributor
  for contributor in "${CONTRIBUTORS[@]}"; do
    case "$contributor" in
      private-evidence$'\t'*)
        effective=private-evidence
        effective_rank="${TG_RANK[private-evidence]}"
        break
        ;;
    esac
  done
  protected="$(class_protected "$effective")"

  # 1. Scope drift: the work grew past what was declared.
  if [ "$OBSERVED_RANK" -gt "$declared_rank" ]; then
    local detail line
    detail=""
    for line in "${CONTRIBUTORS[@]}"; do
      [ "${line%%	*}" = "$OBSERVED_CLASS" ] || continue
      detail="$detail  ${line#*	}"$'\n'
    done
    if [ "$protected" = true ]; then
      blocked "$(printf 'ai-task-gates: STOP before "%s".\n  declared: %s\n  observed: %s (protected)\nThese files escalated the task class:\n%sA protected class cannot be acknowledged or reviewer-approved away. Re-declare the task with `ai-task-gates start --class %s` and do what that class requires, or take these files out of the change set.' \
        "$action" "$declared" "$OBSERVED_CLASS" "$detail" "$OBSERVED_CLASS")"
    fi
    if [ -z "$acknowledge" ]; then
      blocked "$(printf 'ai-task-gates: STOP before "%s".\n  declared: %s\n  observed: %s\nThese files escalated the task class:\n%sRe-declare with `ai-task-gates start --class %s`, or re-run with --acknowledge "<reason>" if the escalation is in scope.' \
        "$action" "$declared" "$OBSERVED_CLASS" "$detail" "$OBSERVED_CLASS")"
    fi
    state_record_override acknowledge "$action" "$acknowledge" "$OBSERVED_CLASS"
    printf 'ai-task-gates: escalation to "%s" acknowledged: %s\n' "$OBSERVED_CLASS" "$acknowledge"
  fi

  if [ "$action" = application-workflow ]; then
    application_workflow_finish "$application_workflow_target" "$effective"
    return 0
  fi
  if [ -n "$application_release_target" ]; then
    application_release_validate_target "$application_release_target" "$effective"
    application_release_ready=1
  fi

  # 1b. The shared-db promotion launch (owner ruling, Albert 2026-10-02: "let AI
  # launch it and remove that rule permanently") belongs to the shared-db class
  # only. No acknowledge or reviewer approval can carry it to another class.
  if [ "$action" = shared-db-promotion ] && [ "$effective" != shared-db ]; then
    blocked "$(printf 'ai-task-gates: STOP. "shared-db-promotion" opens only for the shared-db class; the effective class here is "%s" in %s.' "$effective" "$IDENTITY")"
  fi

  # 2. Forbidden action for the observed class.
  local required_gate effective_gate forbidden required reviewer_release=0 reviewer_gate line
  for line in "${CONTRIBUTORS[@]}"; do
    [ "${line%%$'\t'*}" = reviewer-safety ] && reviewer_release=1
  done
  [ "$declared" = reviewer-safety ] && reviewer_release=1
  if [ "$action" = deploy ] && [ "$reviewer_release" -eq 1 ] && [ "$application_release_ready" -eq 0 ]; then
    blocked 'ai-task-gates: STOP. Reviewer-safety changes cannot use the generic deploy action; use a separate installation task.'
  fi
  required_gate="$({
    [ "$OBSERVED_CLASS" = none ] || merged_gate "$IDENTITY" "$OBSERVED_CLASS"
    [ "$declared" = "$OBSERVED_CLASS" ] || merged_gate "$IDENTITY" "$declared"
    [ "$reviewer_release" -eq 0 ] || merged_gate "$IDENTITY" reviewer-safety
    if [ "$application_release_ready" -eq 1 ] && [ "$IDENTITY" != popcre/designflow-backend ]; then
      # New entries retain every contributing UI/code/security proof even
      # when explicit deployment intent outranks their source path classes.
      application_release_contributor_gates
    fi
  } | LC_ALL=C sort -u)"
  effective_gate="$(merged_gate "$IDENTITY" "$effective")"
  forbidden="$(printf '%s\n' "$effective_gate" | sed -n 's/^forbidden\t//p')"
  local required_full="" unchecked_required=""
  required_full="$(printf '%s\n' "$required_gate" | sed -n 's/^required\t//p' | paste -sd, -)"; split_required_gates "$required_full"; required="$REQUIRED_CHECKED"; unchecked_required="$REQUIRED_UNCHECKED"
  # local-tests evidence must be decided BEFORE the first approval call site in
  # this function's gate sections: the closed offline-native route below calls
  # reviewer_approval_summary and must not skip the evidence check.
  decide_local_tests_required "$action" "$required_full"
  observation_week_check "$action" "$effective"
  if [ "$action" = offline-private-capture-transform ]; then
    [ "$IDENTITY" = u2giants/theoracle ] && [ "$declared" = private-tooling ] && [ "$effective" = private-tooling ] \
      && [ "$action_manifest_stdin" -eq 1 ] && [ "$action_stage" = initial-forward ] \
      && [ -n "$reviewer_approval" ] && [ -z "$acknowledge$small_entry" ] \
      || blocked 'ai-task-gates: STOP. Offline capture transform has only the closed Oracle/private-tooling native route.'
    printf '%s\n' "$effective_gate" | sed -n 's/^required\t//p' | grep -Eqx 'oracle-native-alternate(-v2)?-descriptor-only-admission' \
      || blocked 'ai-task-gates: STOP. Oracle has not opted in to the exact offline native action.'
    approval_summary="$(reviewer_approval_summary "$reviewer_approval" "$action" "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL" "$action_manifest_file" "$action_stage")" \
      || approval_refused "$action" $? 'ai-task-gates: STOP. Genuine independent dual-scoped native registration/action completion is absent.'
    state_record_override reviewer-approval "$action" "$approval_summary" "$effective" \
      && jq -e --arg r "$approval_summary" --arg a "$action" --arg c "$effective" '.overrides | map(select(.kind=="reviewer-approval" and .action==$a and .reason==$r and .observed_class==$c)) | length>0' "$(state_path)" >/dev/null 2>&1 \
      || blocked 'ai-task-gates: STOP. Native action approval persistence/readback failed.'
    local oracle_admission_summary
    oracle_admission_summary="$(reviewer_approval_summary "$reviewer_approval" "$action" "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL" "$action_manifest_file" "$action_stage" 1)" \
      || approval_refused "$action" $? 'ai-task-gates: STOP. Current-purpose registration/one-use admission publication failed.'
    [ "$oracle_admission_summary" = "$approval_summary" ] || blocked 'ai-task-gates: STOP. Oracle approval changed during native admission.'
    jq -e --arg r "$approval_summary" --arg a "$action" --arg c "$effective" '.overrides | map(select(.kind=="reviewer-approval" and .action==$a and .reason==$r and .observed_class==$c)) | length>0' "$(state_path)" >/dev/null 2>&1 \
      || blocked 'ai-task-gates: STOP. Oracle action override changed during native admission.'
    printf 'ai-task-gates: "%s" admitted only for one conditional unqualified offline serialization: %s\n' "$action" "$approval_summary"
    return 0
  fi
  if printf '%s\n' "$forbidden" | grep -qx -- "$action"; then
    # A protected forbidden action stays sealed unless the central policy names
    # an owner release for exactly this action and EFFECTIVE class, and the
    # merged gates for that class declare the release gate (the repository's
    # own declaration, as for code-only-review). The release opens only with an
    # explicit owner authorization (--acknowledge); no AI reviewer verdict is
    # ever required (#2041).
    local release_gate="" native_release=0
    if [ "$protected" = true ]; then
      release_gate="$(jqr --arg a "$action" --arg c "$effective" '.owner_release[$a][$c] // empty' "$POLICY_FILE")"
      if [ -z "$release_gate" ]; then
        # Two closed DesignFlow native fixture-profile routes (#770 isolated
        # timing profile, generated-definition fixture) are admitted only by a
        # native action-profile receipt bound to bounded stdin. They are not a
        # class review requirement: without the receipt the action stays
        # sealed exactly as every other protected forbidden action. Retired
        # with the old reviewer code in phase F of #2041.
        release_gate="$(jqr --arg a "$action" --arg c "$effective" '.native_profile_release[$a][$c] // empty' "$POLICY_FILE")"
        [ -z "$release_gate" ] || native_release=1
      fi
      if [ -n "$release_gate" ] && ! printf '%s\n' "$effective_gate" | sed -n 's/^required\t//p' | grep -qx -- "$release_gate"; then
        release_gate=""; native_release=0
      fi
    fi
    if [ "$native_release" -eq 1 ] && [ "$effective" = private-evidence ]; then
      [ "$action" = database ] && [ "$release_gate" = synthetic-fixtures-only ] \
        && [ "$IDENTITY" = popcre/designflow-backend ] \
        && [ "$action_manifest_stdin" -eq 1 ] && [ -z "$small_entry" ] \
        && [ -z "$acknowledge" ] \
        || { release_gate=""; native_release=0; }
    fi
    if [ "$native_release" -eq 1 ] && [ "$effective" = reviewer-safety ]; then
      [ "$action" = database ] && [ "$release_gate" = reviewed-generated-definition-fixture-only ] \
        && [ "$IDENTITY" = popcre/designflow-backend ] && [ "$declared" = reviewer-safety ] \
        && [ "$action_manifest_stdin" -eq 1 ] && [ "$action_stage" = initial-forward ] \
        && [ -z "$small_entry$acknowledge$target_head$installed_checkout$installed_launcher" ] && [ "$first_install" -eq 0 ] \
        && python3 "$REAL_DIR/../tools/review_action_profile.py" generated-select < "$action_manifest_file" >/dev/null 2>&1 \
        || { release_gate=""; native_release=0; }
    fi
    # The infrastructure production release is pinned to the one repository
    # whose owner ruling opened it (u2giants/ansible, 2026-10-20): canonical
    # origin, a clean declaration committed at HEAD, and a clean HEAD equal to
    # the real GitHub main the apply workflow dispatches. That main is read
    # fresh from the fixed canonical URL with no system, global, or repository
    # Git config (so no insteadOf rewrite or local ref can stand in for it).
    if [ "$effective" = infrastructure ] && [ -n "$release_gate" ]; then
      local infra_origin infra_head infra_main infra_status
      infra_origin="$(git -C "$TOPLEVEL" remote get-url origin 2>/dev/null || true)"
      infra_head="$(git -C "$TOPLEVEL" rev-parse HEAD 2>/dev/null || true)"
      infra_main="$(cd / && env -i PATH=/usr/bin:/bin HOME=/nonexistent GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        timeout 30 git ls-remote --exit-code https://github.com/u2giants/ansible.git refs/heads/main 2>/dev/null \
        | awk 'NR==1 && $2=="refs/heads/main" {print $1}')" || infra_main=""
      [ "$action" = production ] && [ "$release_gate" = reviewed-production-dispatch ] \
        && [ "$IDENTITY" = u2giants/ansible ] \
        && case "$infra_origin" in
             https://github.com/u2giants/ansible|https://github.com/u2giants/ansible.git|\
             git@github.com:u2giants/ansible|git@github.com:u2giants/ansible.git) true ;;
             *) false ;;
           esac \
        && application_release_file_blob "$CONSUMER_FILE_NAME" >/dev/null \
        && infra_status="$(git -C "$TOPLEVEL" status --porcelain --untracked-files=all --ignored 2>/dev/null)" \
        && [ -z "$infra_status" ] \
        && [ -n "$infra_head" ] && [ "$infra_head" = "$infra_main" ] \
        && [ -z "$small_entry$target_head$installed_checkout$installed_launcher" ] \
        && [ "$first_install" -eq 0 ] && [ "$action_manifest_stdin" -eq 0 ] \
        || release_gate=""
    fi
    if [ "$protected" = true ] && [ -z "$release_gate" ]; then
      blocked "$(printf 'ai-task-gates: STOP. "%s" is forbidden for the protected class "%s" in %s.\nA protected forbidden action has no reviewer-approval and no acknowledge path outside its closed owner release.\nNarrow the change set out of protected paths, or change this policy through its own path.' \
        "$action" "$effective" "$IDENTITY")"
    fi
    if [ "$native_release" -eq 1 ]; then
      [ -n "$reviewer_approval" ] \
        || blocked "$(printf 'ai-task-gates: STOP. "%s" for "%s" in %s opens only with its native action-profile receipt (--reviewer-approval with --action-manifest-stdin).' "$action" "$effective" "$IDENTITY")"
      approval_summary="$(reviewer_approval_summary "$reviewer_approval" "$action" "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL" "$action_manifest_file" "$action_stage")" \
        || approval_refused "$action" $? "$(printf 'ai-task-gates: STOP. The native action-profile receipt for "%s" is not a lifecycle-recorded independent APPROVE report for this exact head, source, and action.' "$action")"
      state_record_override reviewer-approval "$action" "$approval_summary" "$effective" \
        && jq -e --arg r "$approval_summary" --arg a "$action" '.overrides | map(select(.kind=="reviewer-approval" and .action==$a and .reason==$r)) | length>0' "$(state_path)" >/dev/null 2>&1 \
        || blocked 'ai-task-gates: STOP. Native reviewer receipt was not persisted; bounded action admission was not issued.'
      local admission_summary
      admission_summary="$(reviewer_approval_summary "$reviewer_approval" "$action" "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL" "$action_manifest_file" "$action_stage" 1)" \
        || approval_refused "$action" $? 'ai-task-gates: STOP. Final native bounded action admission refused after receipt persistence.'
      [ "$admission_summary" = "$approval_summary" ] || blocked 'ai-task-gates: STOP. Bounded approval changed during native admission.'
      printf 'ai-task-gates: "%s" admitted by its native action-profile receipt: %s\n' "$action" "$approval_summary"
      return 0
    fi
    if [ "$action" = database ] && [ "$protected" != true ]; then
      # owner ruling 2026-10-14: "Our own safety rules require a second AI to
      # approve database writes. Remove that rule." Database writes skip the
      # assigned AI reviewer APPROVE. Every other gate stays.
      if [ -n "$small_entry" ]; then
        approval_summary="$(small_owner_entry_summary "$action" "$small_entry" "$small_rows" "$small_quote" "$effective")" || exit "$EX_BLOCKED"
        state_record_override small-owner-entry "$action" "$approval_summary" "$effective" \
          && jq -e --arg r "$approval_summary" '.overrides | map(select(.kind=="small-owner-entry" and .reason==$r)) | length > 0' "$(state_path)" >/dev/null 2>&1 \
          || blocked 'ai-task-gates: STOP. The small owner entry could not be recorded in the task state; nothing was released.'
        printf 'ai-task-gates: "%s" recorded as optional small owner entry (no AI reviewer required): %s\n' "$action" "$approval_summary"
      else
        printf 'ai-task-gates: "%s" allowed without AI reviewer (owner ruling 2026-10-14: database writes skip second-AI approval).\n' "$action"
      fi
      return 0
    fi
    # A toolkit installation of ai-devops itself is the declared installation
    # task's own action: it passed the exact-source checks above and waits for
    # no reviewer verdict and no further owner text (#2041).
    if [ "$action" = deploy ] && [ "$protected" != true ] && [ "$declared" = installation ] \
       && [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]]; then
      [ -z "$(git -C "$TOPLEVEL" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] \
        || blocked 'ai-task-gates: STOP. Candidate checkout has local changes; install only an exact committed target.'
      [ -z "$target_head" ] || [ "$target_head" = "$(git -C "$TOPLEVEL" rev-parse HEAD)" ] \
        || blocked 'ai-task-gates: STOP. The named target differs from the candidate HEAD.'
      if [ -n "$installed_checkout" ]; then
        local inst_root
        inst_root="$(cd "$installed_checkout" 2>/dev/null && pwd -P)" || blocked 'ai-task-gates: STOP. Installed checkout path is unavailable.'
        [ -z "$(git -C "$inst_root" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] \
          || blocked 'ai-task-gates: STOP. Installed checkout has local changes.'
        [ "$(git -C "$inst_root" rev-parse HEAD 2>/dev/null)" = "$(state_field start_head)" ] \
          || blocked 'ai-task-gates: STOP. Installed checkout moved since the installation task was declared.'
      fi
      state_record_override declared-installation "$action" "toolkit installation for declared installation task" "$effective"
      printf 'ai-task-gates: "%s" allowed as a toolkit installation for the declared installation task (no reviewer gate, #2041).\n' "$action"
      return 0
    fi
    # The verification actions (review, pr-wait, code-only-review) mutate
    # nothing; a lifecycle-recorded APPROVE the caller already holds may still
    # lift them on an unprotected class, as an option, never a requirement.
    if [ -z "$acknowledge" ] && [ -n "$reviewer_approval" ] && [ "$protected" != true ] && [ "$action_manifest_stdin" -eq 0 ]; then
      case "$action" in
        review|pr-wait|code-only-review)
          approval_summary="$(reviewer_approval_summary "$reviewer_approval" "$action" "$(git -C "$TOPLEVEL" rev-parse HEAD)" "$TOPLEVEL" "$action_manifest_file" "$action_stage")" \
            || approval_refused "$action" $? "$(printf 'ai-task-gates: STOP. The reviewer approval for "%s" is not a lifecycle-recorded independent APPROVE report for this exact head, source, and action.' "$action")"
          state_record_override reviewer-approval "$action" "$approval_summary" "$effective"
          printf 'ai-task-gates: "%s" allowed by assigned AI reviewer: %s\n' "$action" "$approval_summary"
          return 0 ;;
      esac
    fi
    if [ -z "$acknowledge" ]; then
      blocked "$(printf 'ai-task-gates: STOP. "%s" is not a gate for a "%s" change in %s.\nRequired gates for this class: %s\nTo proceed, the owner must authorize this exact action and resource; re-run with --acknowledge "<owner authorization>". No AI reviewer verdict is required (#2041).' \
        "$action" "$effective" "$IDENTITY" "${required:-<none>}")"
    fi
    [ "$action_manifest_stdin" -eq 0 ] \
      || blocked "$(printf 'ai-task-gates: STOP before "%s". A bounded stdin action cannot take the owner-authorization route.' "$action")"
    state_record_override owner-authorization "$action" "$acknowledge" "$effective" \
      && jq -e --arg r "$acknowledge" --arg a "$action" '.overrides | map(select(.kind=="owner-authorization" and .action==$a and .reason==$r)) | length>0' "$(state_path)" >/dev/null 2>&1 \
      || blocked 'ai-task-gates: STOP. The owner authorization could not be recorded in the task state; nothing was released.'
    printf 'ai-task-gates: "%s" allowed by owner authorization: %s\n' "$action" "$acknowledge"
    return 0
  fi

  # 3. Per-action proof binding. The sealed code-only review route is an
  # action a private class may start without a reviewer approval, but only while
  # the repository's own declaration carries the fixtures boundary the route
  # promises. The binding is proven by the EFFECTIVE class's own merged
  # proofs, never by a stronger declared class's: a private-tooling
  # declaration must not open the route for a sticky private-evidence change.
  local needs_gate effective_required
  needs_gate="$(jqr --arg a "$action" --arg c "$effective" '.action_gates[$a].require_gate[$c] // empty' "$POLICY_FILE")"
  effective_required="$(printf '%s\n' "$effective_gate" | sed -n 's/^required\t//p')"
  if [ -n "$needs_gate" ] && ! printf '%s\n' "$effective_required" | grep -qx -- "$needs_gate"; then
    blocked "$(printf 'ai-task-gates: STOP. "%s" needs the "%s" gate for the class "%s" in %s.\nThis repository has not declared that gate in its own .ai-devops/task-gates.json for that class, so the sealed route is not opened here. Add the declaration through that repository\x27s own reviewed path.' \
      "$action" "$needs_gate" "$effective" "$IDENTITY")"
  fi

  # 4. Production owner authorization (#2041). Where the merged gates require
  # current-chat-resource-and-action-authorization (the production class and
  # the infrastructure repositories), every action except the read-only
  # verification actions needs the owner's explicit authorization of this exact
  # resource and action, passed with --acknowledge and recorded in task state.
  # This replaced the former AI reviewer APPROVE; no reviewer verdict applies.
  if [ "$application_release_ready" -eq 0 ] \
     && printf '%s\n' "$required" | tr ',' '\n' | grep -qx current-chat-resource-and-action-authorization; then
    case "$action" in
      review|code-only-review|pr-wait) ;;
      *)
        [ -n "$acknowledge" ] || blocked "$(printf 'ai-task-gates: STOP before "%s". The "%s" class in %s requires the owner'\''s explicit authorization of this exact resource and action, and none was supplied.\nRequired gates for this class: %s\nTo proceed, re-run with --acknowledge "<owner authorization>". No AI reviewer verdict is required (#2041).' \
          "$action" "$effective" "$IDENTITY" "$required")"
        state_record_override owner-authorization "$action" "$acknowledge" "$effective" \
          && jq -e --arg r "$acknowledge" --arg a "$action" '.overrides | map(select(.kind=="owner-authorization" and .action==$a and .reason==$r)) | length>0' "$(state_path)" >/dev/null 2>&1 \
          || blocked 'ai-task-gates: STOP. The owner authorization could not be recorded in the task state; nothing was released.'
        printf 'ai-task-gates: "%s" allowed by owner authorization: %s\n' "$action" "$acknowledge"
        return 0 ;;
    esac
  fi

  [ -z "$small_entry" ] || printf 'ai-task-gates: note: "%s" is not reviewer-gated here; --small-owner-entry was not needed and was not recorded.\n' "$action" >&2
  if [ "$application_release_ready" -eq 1 ]; then
    application_release_finish "$effective"
    return 0
  fi
  printf 'ai-task-gates: "%s" may start for effective class "%s" in %s.\n' "$action" "$effective" "$IDENTITY"
  [ -n "$required" ] && printf 'required gates: %s\n' "$required"
  [ -z "${REQUIRED_WAIVED:-}" ] || printf 'waived, review is advisory only (owner ruling 2026-10-29, #2041): %s\n' "$REQUIRED_WAIVED"
  [ -z "${unchecked_required:-}" ] || printf 'not checked by this tool: %s\n' "$unchecked_required"
  return 0
}

# --------------------------------------------------------------------------
install_policy_digest(){
  local target="$1" central local_rule
  central="$(git -C "$TOPLEVEL" rev-parse "$target:config/task-gates.json" 2>/dev/null)" || return 1
  local_rule="$(git -C "$TOPLEVEL" rev-parse "$target:.ai-devops/task-gates.json" 2>/dev/null)" || return 1
  printf '%s\n%s\n' "$central" "$local_rule" | sha256sum | cut -d' ' -f1
}

# A Linux install must classify the release against BOTH committed policy
# versions. A target may delete or weaken the rule that protected its source.
install_release_classes(){
  local old="$1" target="$2" paths revision dir policy saved_policy="$POLICY_FILE" saved_consumer="$CONSUMER_FILE"
  [ "$old" != "$target" ] || return 0
  paths="$(git -C "$TOPLEVEL" diff --no-renames --name-only -z "$old" "$target" | python3 -c '
import sys
items = [x.decode("utf-8", "surrogateescape") for x in sys.stdin.buffer.read().split(b"\0") if x]
if any("\n" in x or "\r" in x for x in items): sys.exit(2)
sys.stdout.buffer.write(("\n".join(items) + "\n").encode("utf-8", "surrogateescape"))
')" || fail_closed 'Linux release paths cannot be represented safely.'
  [ -n "$paths" ] || return 0
  for revision in "$old" "$target"; do
    dir="$(mktemp -d)" || fail_closed 'Cannot inspect committed installation policy.'
    git -C "$TOPLEVEL" show "$revision:config/task-gates.json" > "$dir/central.json" 2>/dev/null &&
      git -C "$TOPLEVEL" show "$revision:.ai-devops/task-gates.json" > "$dir/local.json" 2>/dev/null || {
        rm -rf -- "$dir"; fail_closed 'Committed installation policy is missing.';
      }
    POLICY_FILE="$dir/central.json"; CONSUMER_FILE="$dir/local.json"
    load_policy
    classify_paths "$IDENTITY" "$paths"
    local contributor cls
    for contributor in "${CONTRIBUTORS[@]}"; do
      cls="${contributor%%$'\t'*}"
      printf '%s\t%s\n' "$cls" "${TG_PROT[$cls]:-false}"
    done
    rm -rf -- "$dir"
  done
  POLICY_FILE="$saved_policy"; CONSUMER_FILE="$saved_consumer"
  load_policy
}

linux_manifest_receipt(){
  local installed_root="$1" launcher="$2" manifest="$3" sha row_hash row_source old_hash
  [ -f "$manifest" ] && [ -L "$launcher" ] || return 1
  [ "$(readlink -f "$launcher")" = "$(readlink -f "$installed_root/bin/ai-task-gates")" ] || return 1
  sha="$(awk -F '\t' '$1=="meta" && $2=="source_sha" {print $3}' "$manifest")"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 1
  git -C "$installed_root" cat-file -e "$sha^{commit}" 2>/dev/null || return 1
  row_hash="$(awk -F '\t' -v p="$launcher" '$1=="symlink" && $2==p {print $4}' "$manifest")"
  row_source="$(awk -F '\t' -v p="$launcher" '$1=="symlink" && $2==p {print $3}' "$manifest")"
  old_hash="$(git -C "$installed_root" show "$sha:bin/ai-task-gates" 2>/dev/null | sha256sum | cut -d' ' -f1)"
  [ "$row_source" = "$installed_root/bin/ai-task-gates" ] && [ "$row_hash" = "$old_hash" ] || return 1
  printf '%s\n' "$sha"
}

linux_review_authority(){
  local auth="$1" old="$2" target="$3" checkout="$4" launcher="$5" candidate="$6" phase="$7" manifest="$8"
  local report review_root report_hash source_digest policy_digest common key lifecycle_root state matched=0
  jq -e --arg old "$old" --arg target "$target" --arg checkout "$checkout" --arg launcher "$launcher" \
    '.schema_version==1 and .installed_head==$old and .target_head==$target and .installed_checkout==$checkout and .installed_launcher==$launcher and
     (.reviewer_approval|type=="string" and length>0) and .recover_launchers==false' "$auth" >/dev/null 2>&1 || return 1
  policy_digest="$(install_policy_digest "$target")" || return 1
  [ "$(jq -r .policy_digest "$auth")" = "$policy_digest" ] || return 1
  if [ "$phase" = preflight ] || [ "$phase" = resume ]; then
    local recorded_manifest recorded_link first_install
    recorded_manifest="$(jq -r '.linux_manifest_sha256 // ""' "$auth")"
    recorded_link="$(jq -r '.linux_link_target // ""' "$auth")"
    first_install="$(jq -r .first_install "$auth")"
    if [ "$(jq -r .legacy_migration "$auth")" = true ]; then
      [ "$old" = "$target" ] && [ -z "$recorded_manifest" ] && [ "$first_install" = false ] &&
        [ "$(sha256sum "$checkout/bin/ai-task-gates" | cut -d' ' -f1)" = "$(jq -r .installed_source_sha256 "$auth")" ] || return 1
    fi
    if [ "$(jq -r '.stale_manifest_recovery // false' "$auth")" = true ]; then
      local recorded_sha actual_sha old_source_hash
      recorded_sha="$(jq -r '.linux_manifest_recorded_sha // empty' "$auth")"
      [[ "$recorded_sha" =~ ^[0-9a-f]{40}$ ]] && [ "$recorded_sha" != "$old" ] || return 1
      git -C "$checkout" merge-base --is-ancestor "$recorded_sha" "$old" 2>/dev/null || return 1
      actual_sha="$(linux_manifest_receipt "$checkout" "$launcher" "$manifest")" || return 1
      [ "$actual_sha" = "$recorded_sha" ] && [ -n "$recorded_manifest" ] || return 1
      old_source_hash="$(git -C "$checkout" show "$old:bin/ai-task-gates" 2>/dev/null | sha256sum | cut -d' ' -f1)"
      [ "$old_source_hash" = "$(jq -r .installed_source_sha256 "$auth")" ] || return 1
    fi
    if [ "$first_install" = true ]; then
      [ ! -e "$launcher" ] && [ ! -L "$launcher" ] && [ -z "$recorded_link" ] && [ -z "$recorded_manifest" ] || return 1
    else
      [ "$first_install" = false ] && [ -L "$launcher" ] && [ -n "$recorded_link" ] || return 1
    fi
    if [ -L "$launcher" ]; then
      [ "$(readlink "$launcher")" = "$recorded_link" ] || return 1
    else
      [ -z "$recorded_link" ] && [ ! -e "$launcher" ] || return 1
    fi
    if [ -n "$recorded_manifest" ]; then
      [ -f "$manifest" ] &&
        [ "$(sha256sum "$manifest" | cut -d' ' -f1)" = "$recorded_manifest" ] || return 1
      if [ "$(jq -r '.stale_manifest_recovery // false' "$auth")" != true ]; then
        [ "$(linux_manifest_receipt "$checkout" "$launcher" "$manifest")" = "$old" ] || return 1
      fi
    else
      [ ! -e "$manifest" ] || return 1
    fi
  fi
  report="$(jq -r .review_report "$auth")"; [ -f "$report" ] || return 1
  report_hash="$(sha256sum "$report" | cut -d' ' -f1)"
  [ "$(jq -r .review_report_sha256 "$auth")" = "$report_hash" ] || return 1
  report_has_terminal_approve "$report" || return 1
  grep -Fqx "| reviewed commit | \`$target\` |" "$report" || return 1
  source_digest="$(jq -r .source_digest "$auth")"
  grep -Fqx "| source digest | \`$source_digest\` |" "$report" || return 1
  if [ "$(jq -r .first_install "$auth")" = true ]; then
    grep -Fqx 'Approved first-managed-install.' "$report" || return 1
  fi
  if [ "$(jq -r .legacy_migration "$auth")" = true ]; then
    grep -Fqx 'Approved legacy-managed-launcher-refresh.' "$report" || return 1
  fi
  if [ "$(jq -r '.stale_manifest_recovery // false' "$auth")" = true ]; then
    grep -Fqx 'Approved stale-linux-manifest-recovery.' "$report" || return 1
    local stale_sha stale_manifest_hash stale_source_hash
    stale_sha="$(jq -r .linux_manifest_recorded_sha "$auth")"
    stale_manifest_hash="$(jq -r .linux_manifest_sha256 "$auth")"
    stale_source_hash="$(jq -r .installed_source_sha256 "$auth")"
    local stale_header
    stale_header="$(tr -d '\r' < "$report" | sed '/^## Result$/,$d')"
    grep -q '^## Result$' <(tr -d '\r' < "$report") || return 1
    grep -Fqx "| operation | \`stale-linux-manifest-recovery\` |" <<<"$stale_header" || return 1
    grep -Fqx "| stale manifest SHA | \`$stale_sha\` |" <<<"$stale_header" || return 1
    grep -Fqx "| stale manifest hash | \`$stale_manifest_hash\` |" <<<"$stale_header" || return 1
    grep -Fqx "| live installed SHA | \`$old\` |" <<<"$stale_header" || return 1
    grep -Fqx "| live gate hash | \`$stale_source_hash\` |" <<<"$stale_header" || return 1
  fi
  [ "$("$SCRIPT_DIR/ai-review-sandbox" digest "$candidate")" = "$source_digest" ] || return 1
  review_root="$(git -C "$(dirname "$report")" rev-parse --show-toplevel 2>/dev/null)" || return 1
  review_root="$(cd "$review_root" && pwd -P)" || return 1
  case "$(cd "$(dirname "$report")" && pwd -P)/$(basename "$report")" in "$review_root"/.ai/reviews/*) ;; *) return 1 ;; esac
  [ "$review_root" != "$candidate" ] && [ "$(git -C "$review_root" rev-parse HEAD)" = "$target" ] || return 1
  [ -z "$(git -C "$review_root" status --porcelain=v1 --untracked-files=all)" ] || return 1
  common="$(cd "$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" || return 1
  [ "$common" = "$(cd "$(git -C "$review_root" rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" ] || return 1
  [ "$("$SCRIPT_DIR/ai-review-sandbox" digest "$review_root")" = "$source_digest" ] || return 1
  key="$("$SCRIPT_DIR/ai-review-lifecycle" identity "$review_root" | jq -r .repository_key)" || return 1
  lifecycle_root="${AI_REVIEW_LIFECYCLE_DIR:-$HOME/.local/state/ai-devops/review-lifecycle}"
  for state in "$lifecycle_root/runs/$key/"*/*/*.json; do
    [ -f "$state" ] || continue
    if jq -e --arg h "$target" --arg d "$source_digest" --arg p "$report" --arg s "$report_hash" \
      '.status=="completed" and .verdict=="APPROVE" and .stale==false and .head==$h and .source_digest==$d and .report_path==$p and .report_sha256==$s' "$state" >/dev/null 2>&1; then matched=1; break; fi
  done
  [ "$matched" -eq 1 ]
}

stale_completed_baseline_ok(){
  local auth="$1" completed="$2" old="$3" target="$4" checkout="$5"
  [ -f "$auth" ] &&
    [ "$(jq -r '.stale_manifest_recovery // false' "$auth" 2>/dev/null)" = true ] &&
    [ "$(jq -r '.linux_manifest_recorded_sha // empty' "$auth" 2>/dev/null)" = "$completed" ] &&
    [ "$(jq -r '.installed_head // empty' "$auth" 2>/dev/null)" = "$old" ] &&
    git -C "$checkout" merge-base --is-ancestor "$completed" "$old" 2>/dev/null &&
    git -C "$checkout" merge-base --is-ancestor "$old" "$target" 2>/dev/null
}

linux_stage_report_valid(){
  local report="$1" expected="$2" mode owner
  [ "$report" = "$expected" ] && [ -f "$report" ] && [ ! -L "$report" ] || return 1
  mode="$(stat -c %a "$report" 2>/dev/null)"; owner="$(stat -c %u "$report" 2>/dev/null)"
  [ "$mode" = 600 ] && [ "$owner" = "$(id -u)" ] || return 1
  awk -F '\t' '
    NF!=3 { bad=1 }
    $2!="required" && $2!="optional" && $2!="selected" { bad=1 }
    $2=="required" && $1!="PASS" { bad=1 }
    $2=="required" { seen[$3]++ }
    END {
      split("Base dependencies|Node toolchain (node/npm/npx)|System directories|Configuration seed|Configuration migration and validation|Unix entrypoints|Reviewer auto-requalification hook|Claude and Codex skills|Protected machine configuration|Git commit identity|Claude tool permissions|Claude closeout hook|Private memory seed|Managed artifact manifest|ai-devops doctor|Reviewer requalification", required, "|")
      for (i in required) if (seen[required[i]]!=1) bad=1
      if (bad) exit 1
    }
  ' "$report"
}

linux_stage_marker_valid(){
  local marker="$1" transaction="$2" report="$3" manifest="$4" source="$5" target="$6" checkout="$7" txn_hash report_hash manifest_hash source_hash
  [ -f "$marker" ] && [ ! -L "$marker" ] && [ -f "$transaction" ] || return 1
  [ "$(stat -c %a "$marker" 2>/dev/null)" = 600 ] && [ "$(stat -c %u "$marker" 2>/dev/null)" = "$(id -u)" ] || return 1
  linux_stage_report_valid "$report" "$STATE_DIR/install-stage-reports/$target.tsv" || return 1
  txn_hash="$(sha256sum "$transaction" | cut -d' ' -f1)"
  report_hash="$(sha256sum "$report" | cut -d' ' -f1)"
  manifest_hash="$(sha256sum "$manifest" | cut -d' ' -f1)"
  source_hash="$(sha256sum "$source" | cut -d' ' -f1)"
  jq -e --arg h "$target" --arg p "$checkout" --arg t "$txn_hash" --arg r "$report_hash" --arg m "$manifest_hash" --arg s "$source_hash" \
    '.schema_version==1 and .target_head==$h and .installed_checkout==$p and .transaction_sha256==$t and .stage_report_sha256==$r and .manifest_sha256==$m and .source_sha256==$s and .required_stages_pass==true' \
    "$marker" >/dev/null 2>&1
}

cmd_install_verify(){
  local phase='' target='' installed='' launcher='' caller_pinned=0 approval_summary='' stage_report='' installed_head candidate_root common origin_url
  local manifest='/etc/ai-devops/install-manifest.tsv' receipt='' classes='' protected=0 auth_dir issued pending ordinary completion completed_head='' auth old cls protected_flag fixture=0 fixture_root='' intent_state='' declared_installation='' class_base='' stale_recovery=0 stage_marker='' staged_ok=0 transaction=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --phase) need_value "$@"; phase="$2"; shift 2 ;;
      --target-head) need_value "$@"; target="$2"; shift 2 ;;
      --installed-checkout) need_value "$@"; installed="$2"; shift 2 ;;
      --installed-launcher) need_value "$@"; launcher="$2"; shift 2 ;;
      --caller-pinned) caller_pinned=1; shift ;;
      --stage-report) need_value "$@"; stage_report="$2"; shift 2 ;;
      *) die "unknown option for install-verify: $1" ;;
    esac
  done
  case "$phase" in preflight|resume|stages-complete|finalize|activation) ;; *) die 'install-verify needs preflight, resume, stages-complete, finalize, or activation.' ;; esac
  [ "$(uname -s)" = Linux ] || blocked 'ai-task-gates: STOP. This install verification route is Linux-only.'
  [[ "$target" =~ ^[0-9a-f]{40}$ ]] || die 'install-verify requires a full target SHA.'
  POLICY_FILE="$ROOT/config/task-gates.json"
  require_jq; load_policy; resolve_repo
  intent_state="$(state_path)"
  if [ -f "$intent_state" ]; then declared_installation="$(jq -r '.declared_class // empty' "$intent_state")"; fi
  candidate_root="$(cd "$TOPLEVEL" && pwd -P)"
  installed="$(cd "$installed" 2>/dev/null && pwd -P)" || blocked 'ai-task-gates: STOP. Installed checkout is unavailable.'
  origin_url="$(git -C "$installed" config --get remote.origin.url 2>/dev/null || true)"
  if [ "${AI_TASK_GATES_INSTALL_TEST_MODE:-}" = 1 ] && [[ "$origin_url" = file://* ]]; then
    fixture_root="$(cd "${AI_TASK_GATES_TEST_ROOT:-/nonexistent}" 2>/dev/null && pwd -P)" || blocked 'ai-task-gates: STOP. Linux install fixture root is unavailable.'
    case "$fixture_root" in /tmp/*) ;; *) blocked 'ai-task-gates: STOP. Linux install fixture must be under /tmp.' ;; esac  # temp-hygiene: allow
    case "$candidate_root" in "$fixture_root"/*) ;; *) blocked 'ai-task-gates: STOP. Linux candidate is outside fixture root.' ;; esac
    case "$installed" in "$fixture_root"/*) ;; *) blocked 'ai-task-gates: STOP. Linux installed checkout is outside fixture root.' ;; esac
    [ "$STATE_DIR" = "$fixture_root/state" ] || blocked 'ai-task-gates: STOP. Linux fixture state is outside fixture root.'
    if [ "$launcher" = /usr/local/bin/ai-task-gates ]; then
      # Only the private namespace fixture may alias its exact same launcher.
      # Equal bytes, a foreign fixture or a different inode is insufficient.
      [ "$(stat -Lc '%d:%i' "$launcher" 2>/dev/null)" = "$(stat -Lc '%d:%i' "$fixture_root/bin/ai-task-gates" 2>/dev/null)" ] &&
        [ "$(readlink -f "$launcher")" = "$fixture_root/installed/bin/ai-task-gates" ] || blocked 'ai-task-gates: STOP. Canonical fixture launcher is not the exact fixture inode.'
      launcher="$fixture_root/bin/ai-task-gates"
    fi
    [ "$launcher" = "$fixture_root/bin/ai-task-gates" ] || blocked 'ai-task-gates: STOP. Linux fixture launcher is outside fixture root.'
    manifest="$fixture_root/etc/install-manifest.tsv"
    IDENTITY=popcre/ai-devops; IDENTITY_RESOLVED=true; fixture=1
  else
    [ "$launcher" = /usr/local/bin/ai-task-gates ] || blocked 'ai-task-gates: STOP. Linux install launcher is not canonical.'
    [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]] || blocked 'ai-task-gates: STOP. Linux install requires ai-devops identity.'
  fi
  [ "$(git -C "$installed" rev-parse --path-format=absolute --git-dir)" = "$(git -C "$installed" rev-parse --path-format=absolute --git-common-dir)" ] || blocked 'ai-task-gates: STOP. Installed checkout must be primary.'
  common="$(cd "$(git -C "$installed" rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" || blocked 'ai-task-gates: STOP. Installed Git ownership unavailable.'
  [ "$common" = "$(cd "$(git -C "$candidate_root" rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" ] || blocked 'ai-task-gates: STOP. Candidate and installed checkout have different Git ownership.'
  [ "$(git -C "$candidate_root" rev-parse HEAD)" = "$target" ] || blocked 'ai-task-gates: STOP. Candidate source differs from pinned target.'
  # Every phase requires a merged release. A pinned target need not be the tip:
  # later merges may land between exact-head review/authorization and install.
  git -C "$candidate_root" merge-base --is-ancestor "$target" refs/remotes/origin/main 2>/dev/null || blocked 'ai-task-gates: STOP. Target is not in fetched origin/main history.'
  if [ "$fixture" -eq 0 ]; then case "$origin_url" in
    https://github.com/popcre/ai-devops|https://github.com/popcre/ai-devops.git|git@github.com:popcre/ai-devops|git@github.com:popcre/ai-devops.git|ssh://git@github.com/popcre/ai-devops|ssh://git@github.com/popcre/ai-devops.git|https://github.com/u2giants/ai-devops|https://github.com/u2giants/ai-devops.git|git@github.com:u2giants/ai-devops|git@github.com:u2giants/ai-devops.git|ssh://git@github.com/u2giants/ai-devops|ssh://git@github.com/u2giants/ai-devops.git) ;;
    *) blocked 'ai-task-gates: STOP. Unsupported installed origin.' ;;
  esac; fi
  [ -z "$(git -C "$installed" status --porcelain=v1 --untracked-files=all)" ] && [ -z "$(git -C "$candidate_root" status --porcelain=v1 --untracked-files=all)" ] || blocked 'ai-task-gates: STOP. Installation source checkout is dirty.'
  installed_head="$(git -C "$installed" rev-parse HEAD)"
  receipt="$(linux_manifest_receipt "$installed" "$launcher" "$manifest")" || receipt=''
  auth_dir="$STATE_DIR/install-authorizations"; issued="$auth_dir/$target.json"; pending="$issued.consuming"; ordinary="$issued.ordinary"
  stage_marker="$STATE_DIR/install-stages/$target.json"
  completion="$STATE_DIR/install-completions/last.json"
  if [ -e "$completion" ]; then
    completed_head="$(jq -r '.target_head // empty' "$completion" 2>/dev/null)"
    [[ "$completed_head" =~ ^[0-9a-f]{40}$ ]] || blocked 'ai-task-gates: STOP. Completed Linux install receipt is malformed.'
    jq -e --arg path "$installed" --arg launcher "$launcher" --arg h "$completed_head" \
      '.schema_version==1 and .installed_checkout==$path and .installed_launcher==$launcher and .target_head==$h and (.source_sha256|test("^[0-9a-f]{64}$"))' \
      "$completion" >/dev/null 2>&1 || blocked 'ai-task-gates: STOP. Completed Linux install receipt does not match this installation.'
    local committed_hash
    committed_hash="$(git -C "$installed" show "$completed_head:bin/ai-task-gates" 2>/dev/null | sha256sum | cut -d' ' -f1)"
    [ "$committed_hash" = "$(jq -r .source_sha256 "$completion")" ] || blocked 'ai-task-gates: STOP. Completed Linux install receipt source hash changed.'
    git -C "$installed" merge-base --is-ancestor "$completed_head" "$target" 2>/dev/null || blocked 'ai-task-gates: STOP. Completed Linux release is not ancestor of target.'
    if [ -n "$receipt" ] && [ "$receipt" != "$completed_head" ]; then
      [ "$receipt" = "$target" ] && { [ -e "$pending" ] || [ -e "$ordinary" ]; } || blocked 'ai-task-gates: STOP. Installed manifest diverges from the last completed release.'
    fi
  fi
  if [ "$phase" = activation ]; then
    # Read-only admission of one already completed release. This path neither
    # repairs partial installation nor consumes/recreates installation authority.
    [ "$completed_head" = "$target" ] && [ "$installed_head" = "$target" ] && [ "$receipt" = "$target" ] || blocked 'ai-task-gates: STOP. Activation requires exact completed installed release.'
    [ ! -e "$issued" ] && [ ! -L "$issued" ] && [ ! -e "$pending" ] && [ ! -L "$pending" ] && [ ! -e "$ordinary" ] && [ ! -L "$ordinary" ] && [ ! -e "$stage_marker" ] && [ ! -L "$stage_marker" ] || blocked 'ai-task-gates: STOP. Activation cannot bypass an incomplete installation.'
    [ "$(sha256sum "$manifest" | cut -d' ' -f1)" = "$(jq -r .manifest_sha256 "$completion")" ] &&
      [ "$(sha256sum "$candidate_root/bin/ai-task-gates" | cut -d' ' -f1)" = "$(jq -r .source_sha256 "$completion")" ] || blocked 'ai-task-gates: STOP. Activation installed manifest/source changed.'
    linux_stage_report_valid "$STATE_DIR/install-stage-reports/$target.tsv" "$STATE_DIR/install-stage-reports/$target.tsv" || blocked 'ai-task-gates: STOP. Activation completed stage report is invalid.'
    [ "$(sha256sum "$STATE_DIR/install-stage-reports/$target.tsv" | cut -d' ' -f1)" = "$(jq -r .stage_report_sha256 "$completion")" ] || blocked 'ai-task-gates: STOP. Activation completed stage custody changed.'
    printf 'ai-task-gates: completed installed release verified for explicit activation at %s.\n' "$target"
    return 0
  fi
  # The completion receipt is the durable commit point. Finalization deletes
  # the one-use transaction and stage marker only after publishing it, so an
  # interrupted cleanup must be replayable for this exact installed target.
  local recover_completed=0 prior_transaction=''
  if [ "$completed_head" = "$target" ]; then
    if [ -e "$pending" ]; then prior_transaction="$pending"; fi
    if [ -e "$ordinary" ]; then prior_transaction="$ordinary"; fi
    if [ -z "$prior_transaction" ] && { [ "$phase" = finalize ] || [ -e "$stage_marker" ]; }; then recover_completed=1; fi
    if [ -n "$prior_transaction" ] && [ "$(sha256sum "$prior_transaction" | cut -d' ' -f1)" = "$(jq -r '.transaction_sha256 // empty' "$completion")" ]; then recover_completed=1; fi
  fi
  if [ "$recover_completed" -eq 1 ]; then
    local completion_transaction_hash completion_marker_hash completion_manifest_hash completion_report_hash surviving='' had_leftovers=0
    if [ -e "$pending" ] || [ -e "$ordinary" ] || [ -e "$stage_marker" ]; then had_leftovers=1; fi
    [ "$receipt" = "$target" ] && [ "$installed_head" = "$target" ] && [ ! -e "$issued" ] || blocked 'ai-task-gates: STOP. Completed Linux install no longer matches live source or authority state.'
    completion_transaction_hash="$(jq -r '.transaction_sha256 // empty' "$completion")"
    completion_marker_hash="$(jq -r '.stage_marker_sha256 // empty' "$completion")"
    completion_manifest_hash="$(jq -r '.manifest_sha256 // empty' "$completion")"
    completion_report_hash="$(jq -r '.stage_report_sha256 // empty' "$completion")"
    [[ "$completion_transaction_hash" =~ ^[0-9a-f]{64}$ && "$completion_marker_hash" =~ ^[0-9a-f]{64}$ &&
       "$completion_manifest_hash" =~ ^[0-9a-f]{64}$ && "$completion_report_hash" =~ ^[0-9a-f]{64}$ ]] || blocked 'ai-task-gates: STOP. Completed Linux transaction binding is missing.'
    [ "$(sha256sum "$manifest" | cut -d' ' -f1)" = "$completion_manifest_hash" ] &&
      [ "$(sha256sum "$candidate_root/bin/ai-task-gates" | cut -d' ' -f1)" = "$(jq -r .source_sha256 "$completion")" ] || blocked 'ai-task-gates: STOP. Completed Linux installed bytes changed.'
    linux_stage_report_valid "$STATE_DIR/install-stage-reports/$target.tsv" "$STATE_DIR/install-stage-reports/$target.tsv" || blocked 'ai-task-gates: STOP. Completed Linux stage report changed.'
    [ "$(sha256sum "$STATE_DIR/install-stage-reports/$target.tsv" | cut -d' ' -f1)" = "$completion_report_hash" ] || blocked 'ai-task-gates: STOP. Completed Linux stage result hash changed.'
    [ ! -e "$pending" ] || [ ! -e "$ordinary" ] || blocked 'ai-task-gates: STOP. Ambiguous completed Linux transactions.'
    if [ -e "$pending" ]; then surviving="$pending"; fi
    if [ -e "$ordinary" ]; then surviving="$ordinary"; fi
    if [ -n "$surviving" ]; then
      [ -f "$surviving" ] && [ ! -L "$surviving" ] &&
        [ "$(sha256sum "$surviving" | cut -d' ' -f1)" = "$completion_transaction_hash" ] || blocked 'ai-task-gates: STOP. Completed Linux authority changed.'
      [ "$(jq -r .installed_head "$surviving")" = "$(jq -r .installed_head "$completion")" ] || blocked 'ai-task-gates: STOP. Completed Linux baseline changed.'
      if [ "$surviving" = "$pending" ]; then
        [ "$(jq -r .protected "$completion")" = true ] || blocked 'ai-task-gates: STOP. Completed Linux authority class changed.'
        linux_review_authority "$pending" "$(jq -r .installed_head "$completion")" "$target" "$installed" "$launcher" "$candidate_root" finalize "$manifest" || blocked 'ai-task-gates: STOP. Completed Linux review proof changed.'
      else
        [ "$(jq -r .protected "$completion")" = false ] || blocked 'ai-task-gates: STOP. Completed Linux authority class changed.'
      fi
    fi
    if [ -e "$stage_marker" ]; then
      [ -f "$stage_marker" ] && [ ! -L "$stage_marker" ] &&
        [ "$(stat -c %a "$stage_marker")" = 600 ] && [ "$(stat -c %u "$stage_marker")" = "$(id -u)" ] &&
        [ "$(sha256sum "$stage_marker" | cut -d' ' -f1)" = "$completion_marker_hash" ] || blocked 'ai-task-gates: STOP. Completed Linux stage marker changed.'
      jq -e --arg h "$target" --arg p "$installed" --arg t "$completion_transaction_hash" --arg r "$completion_report_hash" --arg m "$completion_manifest_hash" --arg s "$(jq -r .source_sha256 "$completion")" \
        '.schema_version==1 and .target_head==$h and .installed_checkout==$p and .transaction_sha256==$t and .stage_report_sha256==$r and .manifest_sha256==$m and .source_sha256==$s and .required_stages_pass==true' \
        "$stage_marker" >/dev/null 2>&1 || blocked 'ai-task-gates: STOP. Completed Linux stage proof changed.'
    elif [ -n "$surviving" ]; then
      blocked 'ai-task-gates: STOP. Completed Linux authority remains without stage proof.'
    fi
    if [ -n "$surviving" ]; then rm -f -- "$surviving" || blocked 'ai-task-gates: STOP. Cannot close completed Linux authority.'; fi
    if [ -e "$stage_marker" ]; then rm -f -- "$stage_marker" || blocked 'ai-task-gates: STOP. Cannot close completed Linux stage proof.'; fi
    if [ "$phase" = finalize ] || [ "$had_leftovers" -eq 1 ]; then
      printf 'AI_DEVOPS_INSTALL_RECOVERED=%s\n' "$target"
      return 0
    fi
  fi
  [ ! -e "$issued" ] || [ ! -e "$pending" ] || blocked 'ai-task-gates: STOP. Ambiguous install authority state.'
  if [ "$phase" = stages-complete ] || [ "$phase" = finalize ]; then
    [ "$installed_head" = "$target" ] && [ "$receipt" = "$target" ] || blocked 'ai-task-gates: STOP. Installed Linux receipt does not match completed target.'
    [ ! -e "$issued" ] || blocked 'ai-task-gates: STOP. Unconsumed install authority remains.'
    [ -e "$pending" ] || [ -e "$ordinary" ] || blocked 'ai-task-gates: STOP. Installation transaction record is missing.'
    [ ! -e "$pending" ] || [ ! -e "$ordinary" ] || blocked 'ai-task-gates: STOP. Ambiguous installation transaction records.'
    if [ -e "$pending" ]; then
      transaction="$pending"
      old="$(jq -r .installed_head "$pending")"
      [ -z "$completed_head" ] || [ "$old" = "$completed_head" ] || { [ "$phase" = finalize ] && [ "$completed_head" = "$target" ]; } ||
        stale_completed_baseline_ok "$pending" "$completed_head" "$old" "$target" "$installed" || blocked 'ai-task-gates: STOP. Protected install baseline differs from last completed release.'
      linux_review_authority "$pending" "$old" "$target" "$installed" "$launcher" "$candidate_root" finalize "$manifest" || blocked 'ai-task-gates: STOP. Pending install review proof changed.'
    else
      transaction="$ordinary"
      jq -e --arg old "$(jq -r .installed_head "$ordinary")" --arg target "$target" --arg path "$installed" \
        '.schema_version==1 and .installed_head==$old and .target_head==$target and .installed_checkout==$path' "$ordinary" >/dev/null 2>&1 || blocked 'ai-task-gates: STOP. Ordinary install transaction does not match.'
      old="$(jq -r .installed_head "$ordinary")"
      if [ -n "$completed_head" ]; then
        [ "$old" = "$completed_head" ] || { [ "$phase" = finalize ] && [ "$completed_head" = "$target" ]; } || blocked 'ai-task-gates: STOP. Ordinary install baseline differs from last completed release.'
      fi
      classes="$(install_release_classes "$old" "$target" | LC_ALL=C sort -u)" || blocked 'ai-task-gates: STOP. Ordinary transaction range cannot be classified.'
      refuse_release_raw_archives 'install-verify' "$old" "$target"
      while IFS=$'\t' read -r cls protected_flag; do
        [ -n "$cls" ] || continue
        [ "$protected_flag" != true ] || [ "$cls" = reviewer-safety ] || blocked 'ai-task-gates: STOP. Protected release cannot finalize as ordinary.'
      done <<< "$classes"
    fi
    if [ "$phase" = stages-complete ]; then
      [ -z "$stage_report" ] || [ "$stage_report" = "$STATE_DIR/install-stage-reports/$target.tsv" ] || blocked 'ai-task-gates: STOP. Linux stage report path differs from the managed path.'
      [ -n "$stage_report" ] && linux_stage_report_valid "$stage_report" "$STATE_DIR/install-stage-reports/$target.tsv" || blocked 'ai-task-gates: STOP. Required Linux stage results are absent or failed.'
      local stage_tmp transaction_hash report_hash manifest_hash source_hash
      transaction_hash="$(sha256sum "$transaction" | cut -d' ' -f1)"
      report_hash="$(sha256sum "$stage_report" | cut -d' ' -f1)"
      manifest_hash="$(sha256sum "$manifest" | cut -d' ' -f1)"
      source_hash="$(sha256sum "$candidate_root/bin/ai-task-gates" | cut -d' ' -f1)"
      mkdir -p "$(dirname "$stage_marker")" || blocked 'ai-task-gates: STOP. Cannot protect Linux stage receipt.'
      chmod 0700 "$(dirname "$stage_marker")" || blocked 'ai-task-gates: STOP. Linux stage receipt directory is not private.'
      stage_tmp="$stage_marker.tmp.$$"
      jq -nc --arg target "$target" --arg path "$installed" --arg transaction "$transaction_hash" --arg report "$report_hash" --arg manifest "$manifest_hash" --arg source "$source_hash" \
        '{schema_version:1,target_head:$target,installed_checkout:$path,transaction_sha256:$transaction,stage_report_sha256:$report,manifest_sha256:$manifest,source_sha256:$source,required_stages_pass:true}' > "$stage_tmp" &&
        chmod 0600 "$stage_tmp" && mv -f -- "$stage_tmp" "$stage_marker" || blocked 'ai-task-gates: STOP. Cannot publish Linux stage receipt.'
      printf 'ai-task-gates: Linux required stages recorded at %s.\n' "$target"; return 0
    fi
    linux_stage_marker_valid "$stage_marker" "$transaction" "$STATE_DIR/install-stage-reports/$target.tsv" "$manifest" "$candidate_root/bin/ai-task-gates" "$target" "$installed" || blocked 'ai-task-gates: STOP. Required Linux stages are not bound to this installation transaction.'
    local completion_tmp source_hash transaction_hash marker_hash manifest_hash report_hash
    source_hash="$(sha256sum "$candidate_root/bin/ai-task-gates" | cut -d' ' -f1)" || blocked 'ai-task-gates: STOP. Completed source hash unavailable.'
    transaction_hash="$(sha256sum "$transaction" | cut -d' ' -f1)"
    marker_hash="$(sha256sum "$stage_marker" | cut -d' ' -f1)"
    manifest_hash="$(sha256sum "$manifest" | cut -d' ' -f1)"
    report_hash="$(sha256sum "$STATE_DIR/install-stage-reports/$target.tsv" | cut -d' ' -f1)"
    mkdir -p "$(dirname "$completion")" || blocked 'ai-task-gates: STOP. Cannot protect completed install state.'
    completion_tmp="$completion.tmp.$$"
    jq -nc --arg old "$old" --arg target "$target" --arg path "$installed" --arg launcher "$launcher" --arg hash "$source_hash" --arg transaction "$transaction_hash" --arg marker "$marker_hash" --arg manifest "$manifest_hash" --arg report "$report_hash" --argjson protected "$([ -e "$pending" ] && printf true || printf false)" \
      '{schema_version:1,installed_head:$old,target_head:$target,installed_checkout:$path,installed_launcher:$launcher,source_sha256:$hash,transaction_sha256:$transaction,stage_marker_sha256:$marker,manifest_sha256:$manifest,stage_report_sha256:$report,protected:$protected}' > "$completion_tmp" &&
      chmod 0600 "$completion_tmp" && mv -f -- "$completion_tmp" "$completion" || blocked 'ai-task-gates: STOP. Cannot publish completed install receipt.'
    if [ "$fixture" -eq 1 ] && [ "${AI_TASK_GATES_TEST_FINALIZE_CRASH_AFTER:-}" = completion ]; then kill -KILL "$$"; fi
    if [ -e "$pending" ]; then rm -f -- "$pending" || blocked 'ai-task-gates: STOP. Cannot consume completed install authority.'; fi
    if [ -e "$ordinary" ]; then rm -f -- "$ordinary" || blocked 'ai-task-gates: STOP. Cannot close ordinary install transaction.'; fi
    if [ "$fixture" -eq 1 ] && [ "${AI_TASK_GATES_TEST_FINALIZE_CRASH_AFTER:-}" = authority ]; then kill -KILL "$$"; fi
    rm -f -- "$stage_marker" || blocked 'ai-task-gates: STOP. Cannot close Linux stage receipt.'
    if [ "$fixture" -eq 1 ] && [ "${AI_TASK_GATES_TEST_FINALIZE_CRASH_AFTER:-}" = marker ]; then kill -KILL "$$"; fi
    printf 'ai-task-gates: Linux install verified at %s.\n' "$target"; return 0
  fi
  if [ "$phase" = preflight ]; then
    :
  else
    [ "$installed_head" = "$target" ] || blocked 'ai-task-gates: STOP. Installed checkout is not at pinned target.'
  fi
  old="${completed_head:-${receipt:-$installed_head}}"
  auth="$pending"
  if [ "$phase" = preflight ] && [ -f "$issued" ]; then auth="$issued"; fi
  if [ -f "$auth" ] && [ "$(jq -r '.stale_manifest_recovery // false' "$auth" 2>/dev/null)" = true ]; then
    stale_recovery=1
    old="$(jq -r .installed_head "$auth")"
  fi
  if [ "$phase" = resume ] && [ -f "$pending" ]; then
    old="$(jq -r .installed_head "$pending")"
  elif [ "$phase" = resume ] && [ -f "$ordinary" ]; then
    old="$(jq -r .installed_head "$ordinary")"
  fi
  if [ -e "$stage_marker" ]; then
    [ -e "$pending" ] || [ -e "$ordinary" ] || blocked 'ai-task-gates: STOP. Orphaned Linux stage receipt.'
    transaction="$pending"; [ -e "$pending" ] || transaction="$ordinary"
    linux_stage_marker_valid "$stage_marker" "$transaction" "$STATE_DIR/install-stage-reports/$target.tsv" "$manifest" "$candidate_root/bin/ai-task-gates" "$target" "$installed" || blocked 'ai-task-gates: STOP. Linux stage receipt changed before retry.'
    [ "$receipt" = "$target" ] || blocked 'ai-task-gates: STOP. Staged Linux manifest differs from target.'
    staged_ok=1
  fi
  if [ -n "$completed_head" ] && [ "$old" != "$completed_head" ]; then
    stale_completed_baseline_ok "$auth" "$completed_head" "$old" "$target" "$installed" ||
      blocked 'ai-task-gates: STOP. Installation baseline differs from last completed release.'
  fi
  if [ "$phase" = preflight ] && [ "$stale_recovery" -eq 1 ]; then
    [ "$installed_head" = "$old" ] || blocked 'ai-task-gates: STOP. Reviewed stale recovery no longer matches live installed checkout.'
  fi
  git -C "$installed" merge-base --is-ancestor "$old" "$target" 2>/dev/null || blocked 'ai-task-gates: STOP. Installed receipt is not an ancestor of target.'
  class_base="$old"
  if [ "$stale_recovery" -eq 1 ]; then class_base="$receipt"; fi
  classes="$(install_release_classes "$class_base" "$target" | LC_ALL=C sort -u)" || blocked 'ai-task-gates: STOP. Could not classify Linux release.'
  refuse_release_raw_archives 'install-verify' "$class_base" "$target"
  # No install or update waits for an AI reviewer verdict (#2041). A release
  # touching reviewer code installs through the ordinary declared-installation
  # transaction; any other protected class still needs its own stronger gate.
  # A previously issued reviewed authority (authorize-install) is still honored
  # so an interrupted reviewed install can finish, but none is ever required.
  local protected_flag
  while IFS=$'\t' read -r cls protected_flag; do
    [ -n "$cls" ] || continue
    if [ "$protected_flag" = true ]; then
      [ "$cls" = reviewer-safety ] || blocked "ai-task-gates: STOP. '$cls' needs its own stronger installation gate."
    fi
  done <<< "$classes"
  if [ -e "$issued" ] || [ -e "$pending" ]; then protected=1; fi
  if [ "$phase" = preflight ]; then
    [ "$declared_installation" = installation ] || blocked 'ai-task-gates: STOP. Linux update needs a declared installation task.'
  fi
  if [ "$protected" -eq 1 ]; then
    [ "$phase" != preflight ] || [ "$caller_pinned" -eq 1 ] || blocked 'ai-task-gates: STOP. Protected Linux update requires caller-pinned target.'
    [ -f "$auth" ] || blocked 'ai-task-gates: STOP. Reviewed Linux install authority is missing.'
    local review_phase="$phase"
    [ "$staged_ok" -eq 0 ] || review_phase=staged-resume
    linux_review_authority "$auth" "$old" "$target" "$installed" "$launcher" "$candidate_root" "$review_phase" "$manifest" || blocked 'ai-task-gates: STOP. Reviewed Linux install authority is stale or changed.'
    if [ "$phase" = preflight ] && [ "$auth" = "$issued" ]; then mv -- "$issued" "$pending" || blocked 'ai-task-gates: STOP. Could not reserve one-use install authority.'; fi
  else
    [ ! -e "$issued" ] && [ ! -e "$pending" ] || blocked 'ai-task-gates: STOP. Unexpected installation authority for an ordinary update.'
    if [ "$phase" = preflight ] || [ ! -e "$ordinary" ]; then
      [ "$declared_installation" = installation ] || blocked 'ai-task-gates: STOP. Ordinary Linux installation needs a declared installation task.'
      approval_summary="declared-installation-task(no-reviewer-gate,#2041)"
    else
      jq -e --arg old "$old" --arg target "$target" --arg path "$installed" \
        '.schema_version==1 and .installed_head==$old and .target_head==$target and .installed_checkout==$path' "$ordinary" >/dev/null 2>&1 || blocked 'ai-task-gates: STOP. Ordinary Linux transaction changed before resume.'
    fi
    if [ "$phase" = preflight ] || [ ! -e "$ordinary" ]; then
      mkdir -p "$auth_dir" && chmod 0700 "$STATE_DIR" "$auth_dir" || blocked 'ai-task-gates: STOP. Cannot protect ordinary install state.'
      [ ! -e "$ordinary" ] && [ ! -L "$ordinary" ] || blocked 'ai-task-gates: STOP. Ordinary install transaction path already exists.'
      local ordinary_stage
      ordinary_stage="$(mktemp "$auth_dir/.ordinary.XXXXXXXX")" || blocked 'ai-task-gates: STOP. Cannot protect ordinary install transaction.'
      chmod 0600 "$ordinary_stage" || blocked 'ai-task-gates: STOP. Cannot protect ordinary install transaction.'
      jq -nc --arg old "$old" --arg target "$target" --arg path "$installed" --arg request "$approval_summary" --arg id "$(cat /proc/sys/kernel/random/uuid)" \
        '{schema_version:1,installed_head:$old,target_head:$target,installed_checkout:$path,authorization:$request,transaction_id:$id}' > "$ordinary_stage" &&
        ln -- "$ordinary_stage" "$ordinary" && rm -- "$ordinary_stage" || blocked 'ai-task-gates: STOP. Cannot record ordinary install transaction.'

    fi
  fi
  printf 'ai-task-gates: Linux %s verified for %s from %s.\n' "$phase" "$target" "$old"
}

# A release touching shared review code (or the live check itself) installs
# only after one real review passed on Ubuntu and on Windows for this exact
# commit (#1783, plan_release-live-review-check.md). The status check lives
# here, not in the candidate's ai-release-live-check, and fails closed.
require_release_live_review(){ # START TARGET
  local changed statuses os state
  changed="$(git -C "$TOPLEVEL" diff --name-only "$1" "$2")" || blocked 'ai-task-gates: STOP. Cannot list the release range for the live review check.'
  # shellcheck source=../tools/lib/review-capabilities.sh
  source "$ROOT/tools/lib/review-capabilities.sh" || blocked 'ai-task-gates: STOP. Cannot load the shared review code list.'
  review_shared_code_changed "$changed" || return 0
  statuses="$("$ROOT/bin/ai-gh" api "repos/popcre/ai-devops/commits/$2/statuses?per_page=100" 2>/dev/null)" || statuses=''
  for os in linux windows; do
    state="$(printf '%s' "$statuses" | jq -r --arg c "ai-devops/live-review/$os" \
      '[.[]? | select(.context==$c and .creator.login=="u2giants")] | sort_by(.created_at) | last | .state // "missing"' 2>/dev/null)" || state=missing
    [ "$state" = success ] || blocked "ai-task-gates: STOP. This release changes shared review code and its $os live review is '${state:-missing}'. From an Ubuntu review host run: ai-release-live-check fleet --target-head $2"
  done
}

cmd_authorize_install(){
  local target_head="" installed_checkout="" installed_launcher="" review_report="" reviewer_approval="" approval_summary="" legacy_migration=0 first_install=0 recover_launchers=0 stale_manifest_recovery=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --target-head) need_value "$@"; target_head="$2"; shift 2 ;;
      --installed-checkout) need_value "$@"; installed_checkout="$2"; shift 2 ;;
      --installed-launcher) need_value "$@"; installed_launcher="$2"; shift 2 ;;
      --review-report) need_value "$@"; review_report="$2"; shift 2 ;;
      --reviewer-approval) need_value "$@"; reviewer_approval="$2"; shift 2 ;;
      --legacy-migration) legacy_migration=1; shift ;;
      --first-install) first_install=1; shift ;;
      --recover-launchers) recover_launchers=1; shift ;;
      --stale-manifest-recovery) stale_manifest_recovery=1; shift ;;
      *) die "unknown option for authorize-install: $1" ;;
    esac
  done
  POLICY_FILE="$ROOT/config/task-gates.json"
  require_jq; load_policy; resolve_repo
  [[ "$IDENTITY" = popcre/ai-devops || "$IDENTITY" = u2giants/ai-devops ]] || blocked 'ai-task-gates: STOP. Install authority is limited to ai-devops.'
  [ "$(state_field declared_class)" = installation ] || blocked 'ai-task-gates: STOP. Install authority requires a separate declared installation task.'
  local start_head installed_root candidate_root installed_common candidate_common installed_head canonical_launcher origin_url
  local expected_source reviewed_digest actual_digest report_real policy_digest report_hash auth_dir auth_path reviewed_commit
  local reviewed_root reviewed_common
  start_head="$(state_field start_head)"
  [[ "$start_head" =~ ^[0-9a-f]{40}$ ]] || blocked 'ai-task-gates: STOP. Installation task lacks recorded pre-update HEAD.'
  [[ "$target_head" =~ ^[0-9a-f]{40}$ ]] && [ "$target_head" = "$(git -C "$TOPLEVEL" rev-parse HEAD)" ] || blocked 'ai-task-gates: STOP. Candidate HEAD differs from requested target.'
  [ -n "$reviewer_approval" ] && [ -n "$review_report" ] && [ -n "$installed_checkout" ] && [ -n "$installed_launcher" ] || blocked 'ai-task-gates: STOP. Install authority needs an assigned AI reviewer APPROVE, exact review, checkout, and launcher.'
  # local-tests: install authority always demands an approval; decide the
  # evidence requirement from the installation gates before the call.
  decide_local_tests_required deploy "$(merged_gate "$IDENTITY" installation | sed -n 's/^required\t//p' | paste -sd, -)" 1
  approval_summary="$(reviewer_approval_summary "$reviewer_approval" deploy "$target_head" "$TOPLEVEL")" \
    || approval_refused deploy $? 'ai-task-gates: STOP. The reviewer approval does not bind an assigned, independent APPROVE to deploying this exact target.'
  [ $((legacy_migration + first_install + recover_launchers + stale_manifest_recovery)) -le 1 ] || blocked 'ai-task-gates: STOP. Choose one installation migration mode.'
  if [ "$start_head" = "$target_head" ] && [ "$legacy_migration" -ne 1 ] && [ "$first_install" -ne 1 ] && [ "$recover_launchers" -ne 1 ] && [ "$stale_manifest_recovery" -ne 1 ]; then
    blocked 'ai-task-gates: STOP. Empty release needs an installed receipt or explicit reviewed legacy migration.'
  fi
  if [ "$start_head" != "$target_head" ] && [ "$legacy_migration" -eq 1 ]; then
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*) ;;
      *) blocked 'ai-task-gates: STOP. Linux legacy migration is only for an unchanged checkout.' ;;
    esac
  fi
  git -C "$TOPLEVEL" merge-base --is-ancestor "$start_head" "$target_head" 2>/dev/null || blocked 'ai-task-gates: STOP. Pre-update HEAD is not ancestor of candidate.'
  git -C "$TOPLEVEL" merge-base --is-ancestor "$target_head" refs/remotes/origin/main 2>/dev/null || blocked 'ai-task-gates: STOP. Candidate is not in fetched origin/main history.'
  [ -z "$(git -C "$TOPLEVEL" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Candidate checkout is dirty.'
  prepare "$start_head" ""
  # The reviewed release is the change set from the recorded pre-update HEAD;
  # a raw transcript archive inside it is refused here, before any
  # authorization artifact is written.
  refuse_raw_archives 'authorize-install' "${RAW_ARCHIVE_PATHS:-}"
  require_release_live_review "$start_head" "$target_head"
  if [ "$legacy_migration" -eq 1 ] && [ "$start_head" != "$target_head" ]; then
    local legacy_classes legacy_class legacy_protected
    legacy_classes="$(install_release_classes "$start_head" "$target_head" | LC_ALL=C sort -u)" || blocked 'ai-task-gates: STOP. Cannot classify the legacy Windows release range.'
    refuse_release_raw_archives 'authorize-install' "$start_head" "$target_head"
    while IFS=$'\t' read -r legacy_class legacy_protected; do
      [ -n "$legacy_class" ] || continue
      if [ "$legacy_protected" = true ] && [ "$legacy_class" != reviewer-safety ]; then
        blocked "ai-task-gates: STOP. Legacy Windows update crosses stronger '$legacy_class' changes."
      fi
    done <<< "$legacy_classes"
  fi
  if [ "$legacy_migration" -ne 1 ] && [ "$first_install" -ne 1 ] && [ "$recover_launchers" -ne 1 ] && [ "$stale_manifest_recovery" -ne 1 ]; then
    # Legacy reviewed route, now optional (#2041): reviewer code is ordinary
    # code, so any unprotected or reviewer-safety release may use it; a
    # stronger protected class still needs its own gate.
    case "$OBSERVED_CLASS" in
      reviewer-safety|installation|code|prose|none) ;;
      *) blocked "ai-task-gates: STOP. Release class is '$OBSERVED_CLASS'; use its own gate." ;;
    esac
  fi
  origin_url="$(git -C "$TOPLEVEL" config --get remote.origin.url 2>/dev/null || true)"
  case "$origin_url" in
    https://github.com/popcre/ai-devops|https://github.com/popcre/ai-devops.git|git@github.com:popcre/ai-devops|git@github.com:popcre/ai-devops.git|ssh://git@github.com/popcre/ai-devops|ssh://git@github.com/popcre/ai-devops.git|https://github.com/u2giants/ai-devops|https://github.com/u2giants/ai-devops.git|git@github.com:u2giants/ai-devops|git@github.com:u2giants/ai-devops.git|ssh://git@github.com/u2giants/ai-devops|ssh://git@github.com/u2giants/ai-devops.git) ;;
    *) blocked 'ai-task-gates: STOP. Install authority requires supported ai-devops GitHub origin.' ;;
  esac
  installed_root="$(cd "$installed_checkout" 2>/dev/null && pwd -P)" || blocked 'ai-task-gates: STOP. Installed checkout unavailable.'
  candidate_root="$(cd "$TOPLEVEL" && pwd -P)" || blocked 'ai-task-gates: STOP. Candidate checkout unavailable.'
  [ "$installed_root" != "$candidate_root" ] || blocked 'ai-task-gates: STOP. Candidate and installed checkouts must differ.'
  [ "$(git -C "$installed_root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" = "$(git -C "$installed_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Installed checkout is not primary.'
  installed_common="$(cd "$(git -C "$installed_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && pwd -P)" || blocked 'ai-task-gates: STOP. Installed Git ownership unavailable.'
  candidate_common="$(cd "$(git -C "$candidate_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && pwd -P)" || blocked 'ai-task-gates: STOP. Candidate Git ownership unavailable.'
  [ "$installed_common" = "$candidate_common" ] || blocked 'ai-task-gates: STOP. Candidate and installed checkouts do not share Git ownership.'
  installed_head="$(git -C "$installed_root" rev-parse HEAD 2>/dev/null)" || blocked 'ai-task-gates: STOP. Installed HEAD unavailable.'
  # Reviews outlast merges, so another session's unprotected install (or, on
  # Windows, a plain `git pull`; the receipt checks below still bind the
  # installed launchers) may fast-forward the installed checkout during the
  # review. A forward move that stays at or behind the target lies inside the
  # classified start..target range: bind the authority to the checkout's
  # actual HEAD. Any other move (backward, sideways, or past the target)
  # remains a stop.
  if [ "$installed_head" != "$start_head" ]; then
    { git -C "$installed_root" merge-base --is-ancestor "$start_head" "$installed_head" 2>/dev/null &&
      git -C "$installed_root" merge-base --is-ancestor "$installed_head" "$target_head" 2>/dev/null; } ||
      blocked 'ai-task-gates: STOP. Installed checkout moved since task declaration outside the reviewed release range.'
    printf 'ai-task-gates: installed checkout advanced from %s to %s within the reviewed release range.\n' "$start_head" "$installed_head" >&2
  fi
  [ -z "$(git -C "$installed_root" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Installed checkout is dirty.'
  if [[ "$(uname -s)" = MINGW* || "$(uname -s)" = MSYS* || "$(uname -s)" = CYGWIN* ]]; then canonical_launcher="$HOME/.local/bin/ai-task-gates"; else canonical_launcher="/usr/local/bin/ai-task-gates"; fi
  if command -v cygpath >/dev/null 2>&1; then
    local normalized_launcher normalized_canonical
    normalized_launcher="$(cygpath -am -- "$installed_launcher" | tr '[:upper:]' '[:lower:]')"
    normalized_canonical="$(cygpath -am -- "$canonical_launcher" | tr '[:upper:]' '[:lower:]')"
    [ -n "$normalized_launcher" ] && [ -n "$normalized_canonical" ] && [ "$normalized_launcher" = "$normalized_canonical" ] || blocked 'ai-task-gates: STOP. Launcher is not canonical managed path.'
  else
    [ "$installed_launcher" = "$canonical_launcher" ] || blocked 'ai-task-gates: STOP. Launcher is not canonical managed path.'
  fi
  expected_source="$installed_root/bin/ai-task-gates"
  [ -f "$expected_source" ] || blocked 'ai-task-gates: STOP. Installed source missing.'
  if [ "$first_install" -eq 1 ]; then
    [ ! -e "$installed_launcher" ] && [ ! -L "$installed_launcher" ] && [ ! -e "$installed_launcher.cmd" ] || blocked 'ai-task-gates: STOP. First install requires both managed gate launchers absent.'
    local catalog_name catalog_row
    while IFS= read -r catalog_row; do
      [ -n "$catalog_row" ] && [[ "$catalog_row" != \#* ]] || continue
      catalog_name="${catalog_row%%$'\t'*}"
      [ ! -e "$(dirname "$installed_launcher")/$catalog_name" ] && [ ! -e "$(dirname "$installed_launcher")/$catalog_name.cmd" ] || blocked 'ai-task-gates: STOP. First install found existing managed launchers; use reviewed recovery.'
    done < "$candidate_root/config/machine-tools.tsv"
    local existing_launcher
    for existing_launcher in "$(dirname "$installed_launcher")"/*; do
      [ -f "$existing_launcher" ] || continue
      if head -n 2 "$existing_launcher" | tr -d '\r' | grep -Fq 'Managed by ai-devops install-machine-tools.ps1.'; then
        blocked 'ai-task-gates: STOP. First install found a managed launcher outside the current catalog; use reviewed recovery.'
      fi
    done
  elif [ "$recover_launchers" -eq 1 ]; then
    [ ! -e "$installed_launcher" ] || [ -f "$installed_launcher" ] || blocked 'ai-task-gates: STOP. Bash launcher is not a regular file.'
    [ ! -e "$installed_launcher.cmd" ] || [ -f "$installed_launcher.cmd" ] || blocked 'ai-task-gates: STOP. Command launcher is not a regular file.'
    [ ! -L "$installed_launcher" ] && [ ! -L "$installed_launcher.cmd" ] || blocked 'ai-task-gates: STOP. Launcher recovery requires managed regular files.'
    [ ! -f "$installed_launcher" ] || [ ! -f "$installed_launcher.cmd" ] || blocked 'ai-task-gates: STOP. Launcher pair is complete; use its ordinary route.'
    if [ -f "$installed_launcher" ] || [ -f "$installed_launcher.cmd" ]; then
      windows_partial_launcher_route "$expected_source" "$installed_launcher" || blocked 'ai-task-gates: STOP. Present managed launcher routes elsewhere.'
    fi
    [ -f "$candidate_root/config/machine-tools.tsv" ] || blocked 'ai-task-gates: STOP. Managed launcher catalog unavailable.'
    local inventory_lines
    inventory_lines="$(windows_managed_inventory "$(dirname "$installed_launcher")" "$candidate_root/config/machine-tools.tsv")" || blocked 'ai-task-gates: STOP. Managed launcher inventory is unsafe.'
    [ -n "$inventory_lines" ] || blocked 'ai-task-gates: STOP. Launcher recovery found no managed installation; use first-install review.'
  elif [ -L "$installed_launcher" ]; then
    [ -f "$installed_launcher" ] || blocked 'ai-task-gates: STOP. Installed launcher missing.'
    [ "$(readlink -f "$installed_launcher")" = "$(readlink -f "$expected_source")" ] || blocked 'ai-task-gates: STOP. Installed launcher routes elsewhere.'
    if [ "$stale_manifest_recovery" -eq 1 ]; then
      [ "$installed_launcher" = /usr/local/bin/ai-task-gates ] || blocked 'ai-task-gates: STOP. Stale manifest recovery is Linux-only.'
      local manifest_recorded_sha
      manifest_recorded_sha="$(linux_manifest_receipt "$installed_root" "$installed_launcher" /etc/ai-devops/install-manifest.tsv)" || blocked 'ai-task-gates: STOP. Stale manifest cannot be verified against its committed source.'
      [ "$manifest_recorded_sha" != "$installed_head" ] || blocked 'ai-task-gates: STOP. Manifest is current; stale recovery is inapplicable.'
      git -C "$installed_root" merge-base --is-ancestor "$manifest_recorded_sha" "$installed_head" 2>/dev/null || blocked 'ai-task-gates: STOP. Manifest source is not ancestor of installed HEAD.'
      local stale_classes stale_class stale_protected
      stale_classes="$(install_release_classes "$manifest_recorded_sha" "$target_head" | LC_ALL=C sort -u)" || blocked 'ai-task-gates: STOP. Cannot classify stale-manifest release range.'
      refuse_release_raw_archives 'authorize-install' "$manifest_recorded_sha" "$target_head"
      while IFS=$'\t' read -r stale_class stale_protected; do
        [ -n "$stale_class" ] || continue
        if [ "$stale_protected" = true ] && [ "$stale_class" != reviewer-safety ]; then
          blocked "ai-task-gates: STOP. Stale manifest crosses stronger '$stale_class' changes."
        fi
      done <<< "$stale_classes"
      local stale_manifest_hash stale_live_hash
      stale_manifest_hash="$(sha256sum /etc/ai-devops/install-manifest.tsv | cut -d' ' -f1)"
      stale_live_hash="$(sha256sum "$expected_source" | cut -d' ' -f1)"
    elif [ "$legacy_migration" -eq 1 ]; then
      [ ! -e /etc/ai-devops/install-manifest.tsv ] || blocked 'ai-task-gates: STOP. Linux legacy migration requires an absent install manifest.'
    elif [ "$installed_launcher" = /usr/local/bin/ai-task-gates ]; then
      toolkit_source_receipt "$installed_root" "$installed_launcher" "$installed_head" /etc/ai-devops/install-manifest.tsv || blocked 'ai-task-gates: STOP. Linux update requires the installed source receipt; use reviewed same-source migration first.'
    fi
  else
    [ -f "$installed_launcher" ] || blocked 'ai-task-gates: STOP. Installed launcher missing.'
    windows_launcher_route "$expected_source" "$installed_launcher" || blocked 'ai-task-gates: STOP. Installed Windows launcher routing differs.'
    if [ "$legacy_migration" -eq 1 ]; then
      [ -z "$WINDOWS_RECEIPT_SHA" ] || blocked 'ai-task-gates: STOP. Legacy migration requires a launcher without a receipt.'
    elif [ -z "$WINDOWS_RECEIPT_SHA" ]; then
      blocked 'ai-task-gates: STOP. Windows legacy launchers require the reviewed legacy migration route.'
    else
      git -C "$installed_root" merge-base --is-ancestor "$WINDOWS_RECEIPT_SHA" "$installed_head" 2>/dev/null || blocked 'ai-task-gates: STOP. Windows receipt is not ancestor of the installed checkout.'
    fi
  fi
  report_real="$(cd "$(dirname "$review_report")" 2>/dev/null && pwd -P)/$(basename "$review_report")" || blocked 'ai-task-gates: STOP. Review report unavailable.'
  reviewed_root="$(git -C "$(dirname "$report_real")" rev-parse --show-toplevel 2>/dev/null)" || blocked 'ai-task-gates: STOP. Review report is outside a Git checkout.'
  reviewed_root="$(cd "$reviewed_root" && pwd -P)" || blocked 'ai-task-gates: STOP. Reviewed checkout unavailable.'
  [ "$reviewed_root" != "$candidate_root" ] || blocked 'ai-task-gates: STOP. Protected review and installation must use separate tasks.'
  case "$report_real" in "$reviewed_root"/.ai/reviews/*) ;; *) blocked 'ai-task-gates: STOP. Review report is outside reviewed checkout evidence.' ;; esac
  reviewed_common="$(cd "$(git -C "$reviewed_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && pwd -P)" || blocked 'ai-task-gates: STOP. Reviewed Git ownership unavailable.'
  [ "$reviewed_common" = "$candidate_common" ] || blocked 'ai-task-gates: STOP. Review and installation do not share Git ownership.'
  [ "$(git -C "$reviewed_root" rev-parse HEAD 2>/dev/null)" = "$target_head" ] || blocked 'ai-task-gates: STOP. Reviewed checkout moved from exact target.'
  [ -z "$(git -C "$reviewed_root" status --porcelain=v1 --untracked-files=all 2>/dev/null)" ] || blocked 'ai-task-gates: STOP. Reviewed checkout is dirty.'
  # Read the reviewed commit only from the wrapper-written header (before the
  # first "## Result" line); a runner door may repeat its own header table
  # below it, and reviewer text never names the target.
  reviewed_commit="$(sed '/^## Result$/,$d' "$report_real" | awk -F'|' '$2 ~ /reviewed commit/ {gsub(/[^0-9a-f]/,"",$3); print $3}')"
  [ "$reviewed_commit" = "$target_head" ] || blocked 'ai-task-gates: STOP. Review does not name exact target.'
  report_has_terminal_approve "$report_real" || blocked 'ai-task-gates: STOP. Exact-head independent review has not approved release.'
  # A migration review approves exactly one operation: the report's recorded
  # operation (written by the review wrapper from `ai-review --operation`) must
  # be the requested one, and no sibling operation may be approved beside it.
  local requested_operation="" sibling_operation report_header=""
  if [ "$legacy_migration" -eq 1 ]; then requested_operation=legacy-managed-launcher-refresh
  elif [ "$first_install" -eq 1 ]; then requested_operation=first-managed-install
  elif [ "$recover_launchers" -eq 1 ]; then requested_operation=partial-managed-launcher-recovery
  elif [ "$stale_manifest_recovery" -eq 1 ]; then requested_operation=stale-linux-manifest-recovery
  fi
  if [ -n "$requested_operation" ]; then
    for sibling_operation in legacy-managed-launcher-refresh first-managed-install partial-managed-launcher-recovery stale-linux-manifest-recovery; do
      [ "$sibling_operation" = "$requested_operation" ] && continue
      ! grep -Fqx "Approved $sibling_operation." "$report_real" || blocked 'ai-task-gates: STOP. Review approves more than the requested installation operation.'
    done
    # Only the wrapper-written header (before the first "## Result" line) is
    # trusted; reviewer text below it cannot supply the operation row or the
    # stale-manifest host evidence rows.
    report_header="$(tr -d '\r' < "$report_real" | sed '/^## Result$/,$d')"
    grep -q '^## Result$' <(tr -d '\r' < "$report_real") &&
      [ "$(grep -c '^| operation | ' <<<"$report_header")" = 1 ] && grep -Fqx "| operation | \`$requested_operation\` |" <<<"$report_header" || blocked 'ai-task-gates: STOP. Review report does not record the requested installation operation.'
  fi
  if [ "$legacy_migration" -eq 1 ]; then
    grep -Fqx 'Approved legacy-managed-launcher-refresh.' "$report_real" || blocked 'ai-task-gates: STOP. Review did not approve the legacy managed launcher migration operation.'
  fi
  if [ "$first_install" -eq 1 ]; then
    grep -Fqx 'Approved first-managed-install.' "$report_real" || blocked 'ai-task-gates: STOP. Review did not approve the first managed installation operation.'
  fi
  if [ "$recover_launchers" -eq 1 ]; then
    grep -Fqx 'Approved partial-managed-launcher-recovery.' "$report_real" || blocked 'ai-task-gates: STOP. Review did not approve partial managed launcher recovery.'
  fi
  if [ "$stale_manifest_recovery" -eq 1 ]; then
    grep -Fqx 'Approved stale-linux-manifest-recovery.' "$report_real" || blocked 'ai-task-gates: STOP. Review did not approve stale Linux manifest recovery.'
    grep -Fqx "| stale manifest SHA | \`$manifest_recorded_sha\` |" <<<"$report_header" &&
      grep -Fqx "| stale manifest hash | \`$stale_manifest_hash\` |" <<<"$report_header" &&
      grep -Fqx "| live installed SHA | \`$installed_head\` |" <<<"$report_header" &&
      grep -Fqx "| live gate hash | \`$stale_live_hash\` |" <<<"$report_header" || blocked 'ai-task-gates: STOP. Review did not bind exact stale manifest and live source evidence.'
  fi
  reviewed_digest="$(sed '/^## Result$/,$d' "$report_real" | awk -F'|' '$2 ~ /source digest/ {gsub(/[^0-9a-f]/,"",$3); print $3}')"
  actual_digest="$("$SCRIPT_DIR/ai-review-sandbox" digest "$candidate_root")" || blocked 'ai-task-gates: STOP. Candidate source digest unavailable.'
  [ -n "$reviewed_digest" ] && [ "$reviewed_digest" = "$actual_digest" ] || blocked 'ai-task-gates: STOP. Review source digest differs from candidate.'
  [ "$reviewed_digest" = "$("$SCRIPT_DIR/ai-review-sandbox" digest "$reviewed_root")" ] || blocked 'ai-task-gates: STOP. Reviewed checkout source digest changed.'
  policy_digest="$(install_policy_digest "$target_head")" || blocked 'ai-task-gates: STOP. Target policy digest unavailable.'
  report_hash="$(sha256sum "$report_real" | cut -d' ' -f1)"
  local lifecycle_root repo_key lifecycle_state lifecycle_ok=0
  lifecycle_root="$(printenv AI_REVIEW_LIFECYCLE_DIR || true)"
  [ -n "$lifecycle_root" ] || lifecycle_root="$HOME/.local/state/ai-devops/review-lifecycle"
  repo_key="$("$SCRIPT_DIR/ai-review-lifecycle" identity "$candidate_root" | jq -r .repository_key)" || blocked 'ai-task-gates: STOP. Review lifecycle identity unavailable.'
  for lifecycle_state in "$lifecycle_root/runs/$repo_key/"*/*/*.json; do
    [ -f "$lifecycle_state" ] || continue
    if jq -e --arg head "$target_head" --arg source "$reviewed_digest" --arg report "$report_real" --arg hash "$report_hash" \
      '.status=="completed" and .verdict=="APPROVE" and .stale==false and .head==$head and .source_digest==$source and .report_path==$report and .report_sha256==$hash' \
      "$lifecycle_state" >/dev/null 2>&1; then lifecycle_ok=1; break; fi
  done
  [ "$lifecycle_ok" -eq 1 ] || blocked 'ai-task-gates: STOP. Review report has no completed, matching lifecycle record.'
  local receipt_checkout="$installed_root" receipt_launcher="$installed_launcher" receipt_report="$report_real"
  local launcher_hash="" cmd_hash="" source_hash="" manifest_hash="" linux_link_target=""
  local inventory_json='[]'
  if [ "$legacy_migration" -eq 1 ] || [ "$first_install" -eq 1 ] || [ "$recover_launchers" -eq 1 ] || [ "$stale_manifest_recovery" -eq 1 ]; then
    source_hash="$(sha256sum "$expected_source" | cut -d' ' -f1)"
  fi
  if [ "$legacy_migration" -eq 1 ]; then
    if [ -L "$installed_launcher" ]; then
      launcher_hash="$(sha256sum "$installed_launcher" | cut -d' ' -f1)"
    else
      launcher_hash="$(sha256sum "$installed_launcher" | cut -d' ' -f1)"
      cmd_hash="$(sha256sum "$installed_launcher.cmd" | cut -d' ' -f1)"
    fi
  fi
  if [ "$recover_launchers" -eq 1 ]; then
    [ ! -f "$installed_launcher" ] || launcher_hash="$(sha256sum "$installed_launcher" | cut -d' ' -f1)"
    [ ! -f "$installed_launcher.cmd" ] || cmd_hash="$(sha256sum "$installed_launcher.cmd" | cut -d' ' -f1)"
    inventory_json="$(printf '%s\n' "$inventory_lines" | jq -Rsc 'split("\n")[:-1]|map(split("\t")|{name:.[0],sha256:.[1]})')" || blocked 'ai-task-gates: STOP. Managed launcher inventory cannot be sealed.'
  fi
  if [ "$installed_launcher" = /usr/local/bin/ai-task-gates ] && [ -L "$installed_launcher" ]; then
    linux_link_target="$(readlink "$installed_launcher")" || blocked 'ai-task-gates: STOP. Installed Linux launcher target unavailable.'
    if [ -f /etc/ai-devops/install-manifest.tsv ]; then
      manifest_hash="$(sha256sum /etc/ai-devops/install-manifest.tsv | cut -d' ' -f1)" || blocked 'ai-task-gates: STOP. Installed Linux manifest hash unavailable.'
      if [ "$stale_manifest_recovery" -ne 1 ]; then
        toolkit_source_receipt "$installed_root" "$installed_launcher" "$installed_head" /etc/ai-devops/install-manifest.tsv || blocked 'ai-task-gates: STOP. Installed Linux manifest does not attest the pre-update source.'
      fi
    fi
  fi
  if [[ "$(uname -s)" = MINGW* || "$(uname -s)" = MSYS* || "$(uname -s)" = CYGWIN* ]]; then
    source_hash="$(sha256sum "$expected_source" | cut -d' ' -f1)"
    receipt_checkout="$(cygpath -aw "$installed_root")" || blocked 'ai-task-gates: STOP. Installed Windows path unavailable.'
    receipt_launcher="$(cygpath -aw "$installed_launcher")" || blocked 'ai-task-gates: STOP. Launcher Windows path unavailable.'
    receipt_report="$(cygpath -aw "$report_real")" || blocked 'ai-task-gates: STOP. Review Windows path unavailable.'
  fi
  auth_dir="$STATE_DIR/install-authorizations"; auth_path="$auth_dir/$target_head.json"
  mkdir -p "$auth_dir" && chmod 0700 "$STATE_DIR" "$auth_dir" || blocked 'ai-task-gates: STOP. Cannot protect install state.'
  [ ! -e "$auth_path" ] && [ ! -L "$auth_path" ] || blocked 'ai-task-gates: STOP. Authorization already exists for target.'
  local auth_stage
  auth_stage="$(mktemp "$auth_dir/.authority.XXXXXXXX")" || blocked 'ai-task-gates: STOP. Could not protect install authority.'
  chmod 0600 "$auth_stage" || blocked 'ai-task-gates: STOP. Could not protect install authority.'
  jq -nc --arg target "$target_head" --arg base "$installed_head" --arg checkout "$receipt_checkout" \
    --arg launcher "$receipt_launcher" --arg policy "$policy_digest" --arg source "$reviewed_digest" \
    --arg report "$receipt_report" --arg report_hash "$report_hash" --arg request "$approval_summary" \
    --argjson legacy "$legacy_migration" --argjson first "$first_install" --argjson recovery "$recover_launchers" --argjson stale "$stale_manifest_recovery" --argjson inventory "$inventory_json" --arg launcher_hash "$launcher_hash" --arg cmd_hash "$cmd_hash" --arg source_hash "$source_hash" --arg manifest_hash "$manifest_hash" --arg linux_link_target "$linux_link_target" --arg manifest_recorded_sha "${manifest_recorded_sha:-}" \
    --arg windows_receipt_sha "${WINDOWS_RECEIPT_SHA:-}" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema_version:1,target_head:$target,installed_head:$base,installed_checkout:$checkout,installed_launcher:$launcher,policy_digest:$policy,source_digest:$source,review_report:$report,review_report_sha256:$report_hash,reviewer_approval:$request,legacy_migration:($legacy==1),first_install:($first==1),recover_launchers:($recovery==1),stale_manifest_recovery:($stale==1),managed_inventory:$inventory,installed_launcher_sha256:$launcher_hash,installed_cmd_sha256:$cmd_hash,installed_source_sha256:$source_hash,windows_receipt_sha:$windows_receipt_sha,linux_manifest_sha256:$manifest_hash,linux_manifest_recorded_sha:$manifest_recorded_sha,linux_link_target:$linux_link_target,issued_at:$at}' > "$auth_stage" \
    && ln -- "$auth_stage" "$auth_path" && rm -- "$auth_stage" || blocked 'ai-task-gates: STOP. Could not write install authority.'

  printf 'ai-task-gates: exact reviewed toolkit install authorized for %s from %s.\n' "$target_head" "$installed_head"
}

# Warn (never block) about checkout advances that bypassed the protected install.
# The post-merge hook records every plain pull or merge in the installed checkout;
# a record whose head is not the installed receipt is reported on the next run.
warn_unprotected_advances(){
  local log="$STATE_DIR/unprotected-advances.log" manifest="${AI_TASK_GATES_MANIFEST:-/etc/ai-devops/install-manifest.tsv}" receipt when root from to pending=""
  [ -s "$log" ] || return 0
  receipt="$(awk -F'\t' '$1=="meta" && $2=="source_sha"{print $3; exit}' "$manifest" 2>/dev/null || true)"
  # Only records after the last protected acknowledgement (written by update.sh
  # after a verified install) are still pending; older ones are settled.
  while IFS=$'\t' read -r when root from to; do
    if [ "$from" = protected ]; then pending=""; continue; fi
    [ -n "${to:-}" ] && [ "$to" != "$receipt" ] || continue
    pending="$pending$when"$'\t'"$root"$'\t'"${from:-none}"$'\t'"$to"$'\n'
  done < <(tail -n 200 "$log")
  printf '%s' "$pending" | while IFS=$'\t' read -r when root from to; do
    [ -n "${to:-}" ] || continue
    printf 'ai-task-gates: warning: %s moved %s from %s to %s outside the protected install path (installed receipt %s). Install through update.sh with a reviewed authority.\n' "$when" "$root" "$from" "$to" "${receipt:-unknown}" >&2
  done
}

main(){
  local command="${1:-}"; [ $# -gt 0 ] && shift
  case "$command" in
    check|explain) warn_unprotected_advances || true ;;
  esac
  case "$command" in
    start) cmd_start "$@" ;;
    check) cmd_check "$@" ;;
    authorize-install) cmd_authorize_install "$@" ;;
    install-verify) cmd_install_verify "$@" ;;
    explain) cmd_explain_cached "$@" && explain_write_inputs ;;
    status) cmd_status "$@" ;;
    end) cmd_end "$@" ;;
    classify)
      [ $# -ge 1 ] || die 'classify requires an event name.'
      tg_legacy_classify "$1" ;;
    version) printf 'ai-task-gates %s\n' "$VERSION" ;;
    ''|-h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
