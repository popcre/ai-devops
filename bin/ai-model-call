#!/usr/bin/env bash
# ai-model-call — one fail-closed stage invocation with atomic output.
set -euo pipefail
MODELS_ENV="${AI_DEVOPS_MODELS_ENV:-/etc/ai-devops/models.env}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REVIEW="${AI_REVIEW_BIN:-$ROOT/ai-review}"
usage(){ printf '%s\n' 'Usage: ai-model-call <plan|plan-review|implement|diff-review|test|security|final> <prompt-file> <output-file>'; }
die(){ printf 'ai-model-call: error: %s\n' "$*" >&2; exit 1; }
[ "$#" -eq 3 ] || { usage >&2; exit 2; }; STAGE="$1"; PROMPT="$2"; OUT="$3"
[ -f "$PROMPT" ] && [ ! -L "$PROMPT" ] || die "prompt is not a regular file: $PROMPT"
[ ! -e "$OUT" ] || die "refusing to replace immutable stage output: $OUT"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'must run inside a Git repository.'
REPO="$(git rev-parse --show-toplevel)"; mkdir -p "$(dirname "$OUT")"; TMP="$(mktemp "$(dirname "$OUT")/.stage.XXXXXX")"
cleanup(){ rm -f "$TMP"; }; trap cleanup EXIT INT TERM
[ -f "$MODELS_ENV" ] && . "$MODELS_ENV"
CODEX_PLAN_CMD="${CODEX_PLAN_CMD:-codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox read-only -c model_reasoning_effort=medium}"
CODEX_IMPLEMENT_CMD="${CODEX_IMPLEMENT_CMD:-codex exec -m gpt-5.6-sol --skip-git-repo-check --sandbox workspace-write -c model_reasoning_effort=medium}"
CODEX_TEST_CMD="${CODEX_TEST_CMD:-$CODEX_IMPLEMENT_CMD}"
validate_codex(){
  local command="$1" sandbox="$2"
  if printf '%s' "$command" | grep -Eq '[;&|<>`]|[$][({]'; then
    die 'model commands may not contain shell operators or expansions.'
  fi
  case " $command " in *" --sandbox $sandbox "*) ;; *) die "stage requires explicit --sandbox $sandbox.";; esac
  case " $command " in *' -m gpt-5.6-sol '*|*' --model gpt-5.6-sol '*) ;; *) die 'Codex stage commands must explicitly pin gpt-5.6-sol.';; esac
  printf '%s' "$command" | grep -Eq 'model_reasoning_effort=(low|medium)([^A-Za-z]|$)' || die 'Codex reasoning must be explicitly low or medium.'
  read -r -a MODEL_ARGS <<< "$command"; command -v "${MODEL_ARGS[0]}" >/dev/null 2>&1 || die "model command not found: ${MODEL_ARGS[0]}"
}
review_stage(){
  local mode="$1" report rc brief
  brief="$(cd "$(dirname "$PROMPT")" && pwd -P)/$(basename "$PROMPT")"
  set +e; report="$(cd "$REPO" && AI_REVIEW_BRIEF_FILE="$brief" "$REVIEW" claude "$mode")"; rc=$?; set -e
  [ "$rc" -eq 0 ] && [ -s "$report" ] || die "governed Claude review failed for $STAGE."
  cp "$report" "$TMP"
}
case "$STAGE" in
  plan) validate_codex "$CODEX_PLAN_CMD" read-only; printf '%s\n' "$(cat "$PROMPT")" | (cd "$REPO" && "${MODEL_ARGS[@]}" -) > "$TMP" 2>&1 || die 'Codex planning failed.' ;;
  implement) validate_codex "$CODEX_IMPLEMENT_CMD" workspace-write; printf '%s\n' "$(cat "$PROMPT")" | (cd "$REPO" && "${MODEL_ARGS[@]}" -) > "$TMP" 2>&1 || die 'Codex implementation failed.' ;;
  test) validate_codex "$CODEX_TEST_CMD" workspace-write; printf '%s\n' "$(cat "$PROMPT")" | (cd "$REPO" && "${MODEL_ARGS[@]}" -) > "$TMP" 2>&1 || die 'Codex testing failed.' ;;
  plan-review) review_stage plan-review;; diff-review) review_stage diff-review;; security) review_stage security-review;; final) review_stage final-check;;
  *) usage >&2; exit 2;;
esac
[ -s "$TMP" ] || die "stage $STAGE produced no output."
mv "$TMP" "$OUT"; trap - EXIT INT TERM; printf '%s\n' "$OUT"
