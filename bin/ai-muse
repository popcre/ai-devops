#!/usr/bin/env bash
# ai-muse - persistent, named Muse Spark review conversations.
set -euo pipefail
umask 077

SELF="${BASH_SOURCE[0]}"
REAL_SELF="$(readlink -f "$SELF" 2>/dev/null || true)"
[ -z "$REAL_SELF" ] || SELF="$REAL_SELF"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
VERSION="$(tr -d ' \r\n' < "$ROOT/config/opencode/version")"
CFG="${AI_MUSE_CONFIG_DIR:-$HOME/.config/ai-devops-muse}"
OC_CFG="$CFG/opencode-xdg/opencode"
BIN="$HOME/.local/lib/ai-devops/opencode/$VERSION/node_modules/opencode-ai/bin/opencode.exe"
MODEL="meta-model-api/muse-spark-1.2-contributor"
CALLER="${AI_MUSE_CALLER:-}"
STATE="${AI_MUSE_STATE_DIR:-$HOME/.local/state/ai-devops/muse}"
TIMEOUT="${AI_MUSE_TIMEOUT:-1800}"
SANDBOX="$ROOT/bin/ai-review-sandbox"
PACKET="$ROOT/bin/ai-review-packet"
RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-muse.XXXXXX")"
chmod 700 "$RUN_TMP" 2>/dev/null || true

die(){ printf 'ai-muse: error: %s\n' "$*" >&2; exit 1; }
protect_windows_path(){
  local path="$1" kind="${2:-file}" ps helper
  [ -n "${SYSTEMROOT:-}" ] || return 0
  command -v cygpath >/dev/null 2>&1 || return 1
  ps="$(command -v pwsh.exe 2>/dev/null || command -v pwsh 2>/dev/null || command -v powershell.exe 2>/dev/null || true)"; [ -n "$ps" ] || return 1
  helper="$ROOT/bin/windows-private-file.ps1"; [ -f "$helper" ] || return 1
  AI_DEVOPS_PRIVATE_HELPER="$(cygpath -w "$helper")" AI_DEVOPS_PRIVATE_TARGET="$(cygpath -w "$path")" AI_DEVOPS_PRIVATE_KIND="$kind" \
    "$ps" -NoProfile -ExecutionPolicy Bypass -Command '. $env:AI_DEVOPS_PRIVATE_HELPER; if ($env:AI_DEVOPS_PRIVATE_KIND -eq "directory") { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET -Directory } else { Protect-AiDevOpsPrivatePath -Path $env:AI_DEVOPS_PRIVATE_TARGET }' >/dev/null
}
secure_review_directory(){
  local dir="$1"
  chmod 700 "$dir" 2>/dev/null || return 1
  protect_windows_path "$dir" directory || return 1
  printf 'private review storage enforced\n' > "$dir/.ai-devops-private-reviews-v1" || return 1
  chmod 600 "$dir/.ai-devops-private-reviews-v1" 2>/dev/null || return 1
}
need(){ command -v "$1" >/dev/null 2>&1 || die "$1 is required."; }
name_ok(){ case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) [ "${#1}" -le 40 ];; esac; }
[ -n "$CALLER" ] || { printf 'ai-muse: error: AI_MUSE_CALLER must explicitly name the caller (for example codex or claude).\n' >&2; exit 1; }
name_ok "$CALLER" || { printf 'ai-muse: error: invalid caller name %s.\n' "$CALLER" >&2; exit 1; }
repo_root(){ git -C "${1:-$PWD}" rev-parse --show-toplevel 2>/dev/null || die "not a Git repository: ${1:-$PWD}"; }
repo_id(){ local r="$1" u; u="$(git -C "$r" config --get remote.origin.url 2>/dev/null || true)"; printf '%s\n%s' "$(cd "$r" && pwd -P)" "$u" | sha256sum | cut -c1-12; }
meta_path(){ printf '%s/sessions/%s/%s--%s.json' "$STATE" "$1" "$CALLER" "$2"; }
tag(){ printf 'muse-%s-%s' "$CALLER" "$1"; }
LOCK=""; LOCK_TOKEN=""; CRED_LOCK=""; CRED_TOKEN=""; TURN_PID=""; ACTIVE_META=""; PUBLISH_TMP=""; PUBLISH_FD=""; PUBLISH_ID=""; PUBLISH_FD_ID=""; PUBLISH_DIR_PHYSICAL=""; PUBLISH_ROOT=""; PUBLISH_BASENAME=""
release_lock(){ [ -z "$LOCK" ] && return 0; [ "$(cat "$LOCK/token" 2>/dev/null || true)" != "$LOCK_TOKEN" ] || rm -rf "$LOCK"; LOCK=""; LOCK_TOKEN=""; }
release_credential_lock(){ [ -z "$CRED_LOCK" ] && return 0; [ "$(cat "$CRED_LOCK/token" 2>/dev/null || true)" != "$CRED_TOKEN" ] || rm -rf "$CRED_LOCK"; CRED_LOCK=""; CRED_TOKEN=""; }
cleanup(){
  local accepted_path="" accepted_id=""
  [ ! -f "$RUN_TMP/published-report" ] || { accepted_path="$(sed -n '1p' "$RUN_TMP/published-report")"; accepted_id="$(sed -n '2p' "$RUN_TMP/published-report")"; }
  release_credential_lock; release_lock
  [ -z "$PUBLISH_FD" ] || { eval "exec ${PUBLISH_FD}>&-" 2>/dev/null || true; PUBLISH_FD=""; }
  if [ -n "$PUBLISH_TMP" ] && [ -n "$PUBLISH_ID" ] && [ -n "$PUBLISH_DIR_PHYSICAL" ] && [ -d "$(dirname "$PUBLISH_TMP")" ] && [ "$(cd "$(dirname "$PUBLISH_TMP")" && pwd -P 2>/dev/null || true)" = "$PUBLISH_DIR_PHYSICAL" ] && [ "$(stat -c '%d:%i' "$PUBLISH_TMP" 2>/dev/null || true)" = "$PUBLISH_ID" ]; then rm -f -- "$PUBLISH_TMP" 2>/dev/null || true; fi
  if [ -n "$PUBLISH_ROOT" ] && [ -n "$PUBLISH_ID" ] && [ -d "$PUBLISH_ROOT/.ai" ]; then
    while IFS= read -r -d '' moved; do case "$(cd "$(dirname "$moved")" && pwd -P 2>/dev/null || true)" in "$(cd "$PUBLISH_ROOT" && pwd -P)"/*) [ "$moved" = "$accepted_path" ] && [ "$PUBLISH_ID" = "$accepted_id" ] && continue; [ -f "$moved" ] && [ ! -L "$moved" ] && [ "$(stat -c '%d:%i' "$moved" 2>/dev/null || true)" = "$PUBLISH_ID" ] && rm -f -- "$moved" 2>/dev/null || true;; esac; done < <(find "$PUBLISH_ROOT/.ai" -type f -print0 2>/dev/null)
  fi
  rm -rf "$RUN_TMP"
}
mark_uncertain(){
  local reason="$1" tmp
  [ -n "$ACTIVE_META" ] && [ -f "$ACTIVE_META" ] || return 0
  tmp="$(tmp_file)"
  jq --arg now "$(date -u +%FT%TZ)" --arg reason "$reason" '.status="provider_outcome_uncertain"|.failure_reason=$reason|.updated_at=$now' "$ACTIVE_META" > "$tmp" && mv -f "$tmp" "$ACTIVE_META" || true
}
on_signal(){
  mark_uncertain interrupted-local-observer
  if [ -n "$TURN_PID" ]; then
    if command -v pkill >/dev/null 2>&1; then pkill -TERM -P "$TURN_PID" 2>/dev/null || true; fi
    kill -TERM "$TURN_PID" 2>/dev/null || true
    wait "$TURN_PID" 2>/dev/null || true
    TURN_PID=""
  fi
  cleanup; exit 130
}
trap cleanup EXIT
trap on_signal HUP INT TERM
tmp_file(){ mktemp "$RUN_TMP/file.XXXXXX"; }
lock_session(){
  local candidate="$STATE/locks/$1--$CALLER--$2.lock.d" owner stale quarantine attempt token; mkdir -p "$(dirname "$candidate")"; token="$$-$RANDOM-$(date +%s)"
  for attempt in 1 2 3; do
    if mkdir "$candidate" 2>/dev/null; then printf '%s\n' "$token" > "$candidate/token"; printf '%s\n' "$$" > "$candidate/pid"; LOCK="$candidate"; LOCK_TOKEN="$token"; return 0; fi
    stale=0; owner="$(cat "$candidate/pid" 2>/dev/null || true)"
    case "$owner" in ''|*[!0-9]*) [ -n "$(find "$candidate" -maxdepth 0 -mmin +1 -print -quit 2>/dev/null)" ] && stale=1;; *) kill -0 "$owner" 2>/dev/null || stale=1;; esac
    [ "$stale" -eq 1 ] || break; quarantine="$candidate.stale.$token.$attempt"
    if mv "$candidate" "$quarantine" 2>/dev/null; then rm -rf "$quarantine"; fi
  done
  die "session '$2' is busy; wait for its current Muse turn to finish."
}
unlock_session(){ release_lock; }

runtime_env(){
  export XDG_CONFIG_HOME="$CFG/opencode-xdg"
  export XDG_DATA_HOME="$HOME/.local/share/ai-devops/opencode-muse-direct"
  export XDG_STATE_HOME="$HOME/.local/state/ai-devops/muse-direct"
  export XDG_CACHE_HOME="$HOME/.cache/ai-devops/opencode-muse-direct"
  mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
}
require_runtime(){
  [ -x "$BIN" ] || die "local_dependency_unavailable: LOCAL OpenCode is not installed. Run: $ROOT/bin/setup-opencode-muse.sh"
  "$BIN" --version >/dev/null 2>&1 || die "local_dependency_unavailable: LOCAL OpenCode cannot start. This is not a Muse provider fault. Run: AI_MUSE_CALLER=$CALLER ai-muse doctor"
  [ -f "$OC_CFG/opencode.json" ] || die "local_dependency_unavailable: Muse is not configured. Run: $ROOT/bin/setup-opencode-muse.sh"
  cmp -s "$ROOT/config/opencode-muse/opencode.json" "$OC_CFG/opencode.json" || die 'local_dependency_unavailable: Muse protection configuration changed. Re-run setup-opencode-muse.sh.'
  cmp -s "$ROOT/config/opencode-muse/agent/muse-review.md" "$OC_CFG/agent/muse-review.md" || die 'local_dependency_unavailable: Muse tool protection changed. Re-run setup-opencode-muse.sh.'
}
read_prompt(){
  local mode="${1:-}" value="${2:-}" f; f="$(tmp_file)"
  case "$mode" in
    --prompt) printf '%s' "$value" > "$f";;
    --prompt-file) [ -f "$value" ] || { rm -f "$f"; die "prompt file not found: $value"; }; cp "$value" "$f";;
    '') [ ! -t 0 ] || { rm -f "$f"; die 'provide --prompt, --prompt-file, or standard input.'; }; cat > "$f";;
    *) rm -f "$f"; die "unknown prompt option: $mode";;
  esac
  [ -s "$f" ] || { rm -f "$f"; die 'prompt is empty.'; }; printf '%s' "$f"
}
prepare(){
  local root="$1" name="$2" prompt="$3" t; t="$(tag "$name")"
  REVIEW_DIR="$("$SANDBOX" ensure-copy "$root" "$t")"
  git -C "$REVIEW_DIR" clean -fdq -- .ai/reviews 2>/dev/null || true
  PACKET_DIR="$("$PACKET" build "$REVIEW_DIR" "$t" --decision "$(cat "$prompt")" --class medium)"
  "$PACKET" verify "$PACKET_DIR" >/dev/null
  HEAD_SHA="$(git -C "$REVIEW_DIR" rev-parse HEAD)"; PACKET_HASH="$(cat "$PACKET_DIR/MANIFEST.sha256")"
}
load_key(){
  need op; local candidate="$STATE/credential.lock.d" owner token attempt; token="$$-$RANDOM-$(date +%s)"; mkdir -p "$STATE"
  for attempt in 1 2 3; do
    if mkdir "$candidate" 2>/dev/null; then printf '%s\n' "$token" > "$candidate/token"; printf '%s\n' "$$" > "$candidate/pid"; CRED_LOCK="$candidate"; CRED_TOKEN="$token"; break; fi
    owner="$(cat "$candidate/pid" 2>/dev/null || true)"; case "$owner" in ''|*[!0-9]*) if [ -n "$(find "$candidate" -maxdepth 0 -mmin +1 -print -quit 2>/dev/null)" ]; then mv "$candidate" "$candidate.stale.$token" 2>/dev/null && rm -rf "$candidate.stale.$token"; else sleep 1; fi;; *) kill -0 "$owner" 2>/dev/null && sleep 1 || { mv "$candidate" "$candidate.stale.$token" 2>/dev/null && rm -rf "$candidate.stale.$token"; };; esac
  done
  [ -n "$CRED_LOCK" ] || die '1Password is busy; retry the Muse turn.'
  MODEL_API_KEY="$(op read 'op://vibe_coding/Meta ai Muse Spark API Key/api key')"; release_credential_lock; [ -n "$MODEL_API_KEY" ] || die 'Muse key resolved empty.'
}
tree_state(){
  local root="$1" rel
  { git -C "$root" rev-parse HEAD; git -C "$root" diff --binary HEAD; while IFS= read -r -d '' rel; do printf '%s\0' "$rel"; sha256sum "$root/$rel"; done < <(git -C "$root" ls-files --others --exclude-standard -z); } | sha256sum | cut -d' ' -f1
}
new_report_path(){ printf '%s/.ai/reviews/muse-%s-%s-%s-%s.md' "$1" "$2" "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$RANDOM"; }
ensure_report_destination(){
  local root="$1" path="$2" dir="$root/.ai/reviews" rel
  case "$path" in "$dir"/*) ;; *) die "refusing Muse report outside $dir: $path" ;; esac
  [ ! -L "$root/.ai" ] && [ ! -L "$dir" ] || die 'refusing Muse reports: .ai or .ai/reviews is a linked path.'
  rel="${path#"$root"/}"
  git -C "$root" check-ignore -q "$rel" || die "refusing Muse report: exact destination is not Git-ignored: $rel. Add .ai/reviews/ to .gitignore, then retry."
  ! git -C "$root" ls-files --error-unmatch "$rel" >/dev/null 2>&1 || die "refusing Muse report: exact destination is tracked: $rel. Preserve it, remove it from Git tracking with: git rm --cached -- '$rel'; then retry."
  [ ! -e "$path" ] || die "refusing Muse report: exact destination already exists: $rel"
  mkdir -p "$dir" || die "could not create Muse report directory: $dir"
  secure_review_directory "$dir" || die "could not enforce private Muse report storage: $dir"
  [ ! -L "$dir" ] || die 'refusing Muse reports: .ai/reviews became a linked path.'
  local physical_root physical_dir
  physical_root="$(cd "$root" && pwd -P)"; physical_dir="$(cd "$dir" && pwd -P)"
  case "$physical_dir" in "$physical_root"/*) ;; *) die 'refusing Muse reports: .ai/reviews escapes the repository.';; esac
}
reserve_report_staging(){
  local root="$1" dir="$root/.ai/reviews" path_state had_noclobber=0 open_rc=0
  PUBLISH_DIR_PHYSICAL="$(cd "$dir" && pwd -P)"
  PUBLISH_TMP="$(mktemp -u "$dir/.muse-stage.XXXXXX")" || die 'could not choose a Muse report staging name.'
  PUBLISH_ROOT="$root"; PUBLISH_BASENAME="$(basename "$PUBLISH_TMP")"
  [ -z "${AI_MUSE_TEST_PRE_OPEN_MARKER:-}" ] || printf '%s\n' "$PUBLISH_TMP" > "$AI_MUSE_TEST_PRE_OPEN_MARKER"
  [ -z "${AI_MUSE_TEST_PRE_OPEN_DELAY:-}" ] || sleep "$AI_MUSE_TEST_PRE_OPEN_DELAY"
  case "$-" in *C*) had_noclobber=1;; esac
  set -C
  exec {PUBLISH_FD}>"$PUBLISH_TMP" || open_rc=$?
  [ "$had_noclobber" = 1 ] || set +C
  [ "$open_rc" = 0 ] && [ -n "$PUBLISH_FD" ] || die 'could not exclusively reserve Muse report staging without following an existing path.'
  [ -z "${AI_MUSE_TEST_POST_OPEN_MARKER:-}" ] || printf '%s\n' "$PUBLISH_TMP" > "$AI_MUSE_TEST_POST_OPEN_MARKER"
  [ -z "${AI_MUSE_TEST_POST_OPEN_DELAY:-}" ] || sleep "$AI_MUSE_TEST_POST_OPEN_DELAY"
  PUBLISH_FD_ID="$(stat -Lc '%f:%h:%d:%i' "/proc/$BASHPID/fd/$PUBLISH_FD" 2>/dev/null)"; PUBLISH_ID="$(stat -Lc '%d:%i' "/proc/$BASHPID/fd/$PUBLISH_FD" 2>/dev/null)"; path_state="$(stat -c '%f:%h:%d:%i' "$PUBLISH_TMP" 2>/dev/null)"
  case "$PUBLISH_FD_ID" in *:1:* ) [ -f "/proc/$BASHPID/fd/$PUBLISH_FD" ] || die 'reserved Muse staging descriptor is not a regular file.';; *) die 'reserved Muse staging descriptor is not one private regular file.';; esac
  [ "$path_state" = "$PUBLISH_FD_ID" ] || die 'reserved Muse staging pathname does not match its held descriptor.'
}
finish_report_staging(){
  local root="$1" path="$2" dir="$root/.ai/reviews"
  [ -n "$PUBLISH_FD" ] && [ -n "$PUBLISH_TMP" ] && [ -n "$PUBLISH_ID" ] || die 'Muse report staging was not reserved before provider contact.'
  ensure_report_destination "$root" "$path"
  [ "$(cd "$dir" && pwd -P)" = "$PUBLISH_DIR_PHYSICAL" ] || die 'refusing Muse report: destination directory changed after staging.'
  [ -f "$PUBLISH_TMP" ] && [ ! -L "$PUBLISH_TMP" ] || die 'refusing Muse report: reserved staging file is no longer reachable.'
  [ "$(stat -c '%f:%h:%d:%i' "$PUBLISH_TMP" 2>/dev/null)" = "$PUBLISH_FD_ID" ] && [ "$(stat -Lc '%f:%h:%d:%i' "/proc/$BASHPID/fd/$PUBLISH_FD" 2>/dev/null)" = "$PUBLISH_FD_ID" ] || die 'refusing Muse report: reserved staging file identity or link count changed.'
  [ -z "${AI_MUSE_TEST_PRE_PUBLISH_MARKER:-}" ] || printf '%s\n' "$path" > "$AI_MUSE_TEST_PRE_PUBLISH_MARKER"
  [ -z "${AI_MUSE_TEST_STAGING_MARKER:-}" ] || printf '%s\n' "$PUBLISH_TMP" > "$AI_MUSE_TEST_STAGING_MARKER"
  [ -z "${AI_MUSE_TEST_PRE_PUBLISH_DELAY:-}" ] || sleep "$AI_MUSE_TEST_PRE_PUBLISH_DELAY"
  ensure_report_destination "$root" "$path"
  [ "$(cd "$dir" && pwd -P)" = "$PUBLISH_DIR_PHYSICAL" ] || die 'refusing Muse report: destination directory changed during final publication.'
  [ "$(stat -c '%f:%h:%d:%i' "$PUBLISH_TMP" 2>/dev/null)" = "$PUBLISH_FD_ID" ] && [ "$(stat -Lc '%f:%h:%d:%i' "/proc/$BASHPID/fd/$PUBLISH_FD" 2>/dev/null)" = "$PUBLISH_FD_ID" ] || die 'refusing Muse report: staging identity or link count changed during final publication.'
  ln "$PUBLISH_TMP" "$path" 2>/dev/null || die "could not publish Muse report without overwriting: $path"
  if [ "$(stat -c '%d:%i' "$path" 2>/dev/null)" != "$PUBLISH_ID" ]; then
    rm -f -- "$path"
    die 'refusing Muse report: published file does not match the held staging file.'
  fi
  chmod 600 "$path" 2>/dev/null || die 'could not protect the published Muse report.'
  protect_windows_path "$path" file || die 'could not enforce the published Muse report Windows ACL.'
  printf '%s\n%s\n' "$path" "$PUBLISH_ID" > "$RUN_TMP/published-report" || die 'could not record accepted Muse report identity.'
  eval "exec ${PUBLISH_FD}>&-" || die 'could not close Muse report staging file.'; PUBLISH_FD=""
  rm -f "$PUBLISH_TMP"
  PUBLISH_TMP=""; PUBLISH_ID=""; PUBLISH_FD_ID=""; PUBLISH_DIR_PHYSICAL=""; PUBLISH_ROOT=""; PUBLISH_BASENAME=""
}
heartbeat_meta(){
  local meta="$1" pid="$2" tmp
  [ -z "${MODEL_API_KEY+x}" ] || die 'internal credential-boundary failure: Muse key reached the heartbeat parent.'
  [ -f "$meta" ] || return 0; tmp="$(tmp_file)"
  jq --arg now "$(date -u +%FT%TZ)" --argjson pid "$pid" '.status="turn_in_progress"|.worker_pid=$pid|.last_heartbeat_at=$now|.updated_at=$now' "$meta" > "$tmp" && mv -f "$tmp" "$meta"
}
MUSE_CREDENTIAL_BOUNDARY='
secret_file="${AI_MUSE_SECRET_FILE:-}"
[ -n "$secret_file" ] && [ -f "$secret_file" ] && [ ! -L "$secret_file" ] || exit 86
IFS= read -r MODEL_API_KEY < "$secret_file" || exit 87
rm -f -- "$secret_file" || exit 88
unset AI_MUSE_SECRET_FILE
export MODEL_API_KEY
exec "$@"
'
validate_heartbeat(){
  case "${AI_MUSE_HEARTBEAT_INTERVAL:-10}" in ''|0|*[!0-9]*) die 'AI_MUSE_HEARTBEAT_INTERVAL must be a positive whole number of seconds.' ;; esac
}
run_turn(){
  local dir="$1" prompt="$2" out="$3" sid="${4:-}" meta="${5:-}" rc args event_sid_count salvaged_ids waited=0 heartbeat="${AI_MUSE_HEARTBEAT_INTERVAL:-10}" provider_key prompt_text timeout_bin="${AI_MUSE_TIMEOUT_BIN:-/usr/bin/timeout}" env_bin=/usr/bin/env safe_name
  local bash_bin=/usr/bin/bash key_file
  local -a clean_env
  validate_heartbeat
  TURN_SID=""; FINISH=""; TEXT=""; TOKENS=null; TURN_ERROR=""
  runtime_env; [ -x "$timeout_bin" ] || die "local_dependency_unavailable: trusted timeout executable is unavailable: $timeout_bin"; case "$timeout_bin" in /*) ;; *) die 'trusted timeout executable path must be absolute.';; esac
  prompt_text="$(cat "$prompt")"; load_key; provider_key="$MODEL_API_KEY"; unset MODEL_API_KEY; args=(run --dir "$dir" --agent muse-review --model "$MODEL" --format json); [ -z "$sid" ] || args+=(--session "$sid")
  [ -x "$bash_bin" ] && [ -x "$env_bin" ] || die 'trusted absolute Bash/env executables are required for the Muse credential boundary.'
  key_file="$(mktemp "$RUN_TMP/muse-key.XXXXXX")" || die 'could not reserve the private Muse credential handoff.'
  printf '%s\n' "$provider_key" > "$key_file" || die 'could not write the private Muse credential handoff.'
  chmod 600 "$key_file" 2>/dev/null || die 'could not protect the private Muse credential handoff.'
  protect_windows_path "$key_file" file || die 'could not enforce the private Muse credential-handoff ACL.'
  provider_key=""
  set +e
  clean_env=("$env_bin" -i "PATH=$PATH" "HOME=$HOME" "AI_MUSE_SECRET_FILE=$key_file" "XDG_CONFIG_HOME=$XDG_CONFIG_HOME" "XDG_DATA_HOME=$XDG_DATA_HOME" "XDG_STATE_HOME=$XDG_STATE_HOME" "XDG_CACHE_HOME=$XDG_CACHE_HOME")
  for safe_name in USERPROFILE TEMP TMP TMPDIR SYSTEMROOT COMSPEC PATHEXT USER USERNAME LOGNAME LANG LC_ALL TERM SSL_CERT_FILE SSL_CERT_DIR NODE_EXTRA_CA_CERTS; do
    [ -z "${!safe_name:-}" ] || clean_env+=("$safe_name=${!safe_name}")
  done
  if [ -n "${AI_MUSE_TEST_DIR:-}" ]; then
    clean_env+=("AI_MUSE_TEST_DIR=$AI_MUSE_TEST_DIR")
    while IFS='=' read -r safe_name _; do case "$safe_name" in AI_MUSE_TEST_*|MUSE_STUB_*) clean_env+=("$safe_name=${!safe_name}");; esac; done < <(env)
  fi
  ( [ -z "$PUBLISH_FD" ] || eval "exec ${PUBLISH_FD}>&-"; exec "${clean_env[@]}" "$bash_bin" --noprofile --norc -c "$MUSE_CREDENTIAL_BOUNDARY" muse-credential-boundary "$timeout_bin" "$TIMEOUT" "$BIN" "${args[@]}" "$prompt_text" ) > "$out" 2> "$out.stderr" & TURN_PID=$!
  ACTIVE_META="$meta"; [ -z "$meta" ] || heartbeat_meta "$meta" "$TURN_PID"
  while kill -0 "$TURN_PID" 2>/dev/null; do
    sleep 1; waited=$((waited+1))
    [ -z "$meta" ] || [ $((waited % heartbeat)) -ne 0 ] || { heartbeat_meta "$meta" "$TURN_PID"; printf 'Muse turn active: %ss\n' "$waited" >&2; }
  done
  wait "$TURN_PID"; rc=$?; TURN_PID=""
  [ -z "${AI_MUSE_TEST_POST_PROCESS_MARKER:-}" ] || printf reached > "$AI_MUSE_TEST_POST_PROCESS_MARKER"
  [ -z "${AI_MUSE_TEST_POST_PROCESS_DELAY:-}" ] || sleep "$AI_MUSE_TEST_POST_PROCESS_DELAY"
  set -e; RUN_RC="$rc"
  salvaged_ids="$(while IFS= read -r line; do printf '%s\n' "$line" | jq -r '.sessionID//empty' 2>/dev/null || true; done < "$out" | sed '/^$/d' | sort -u)"
  [ "$(printf '%s\n' "$salvaged_ids" | sed '/^$/d' | wc -l)" -ne 1 ] || TURN_SID="$salvaged_ids"
  if ! jq -s -e 'length>0 and all(.[];type=="object")' "$out" >/dev/null 2>&1; then TURN_ERROR='Muse returned malformed event output.'; return 1; fi
  event_sid_count="$(jq -sr '[.[]|.sessionID//empty]|unique|length' "$out")"
  [ "$event_sid_count" -eq 1 ] || { TURN_ERROR='Muse returned a mixed or unidentified session event stream.'; return 1; }
  TURN_SID="$(jq -sr '[.[]|.sessionID//empty]|unique|first//empty' "$out")"
  FINISH="$(jq -sr '[.[]|select(.type=="step_finish")|.part.reason//empty]|last//empty' "$out")"
  TEXT="$(jq -sr '[.[]|select(.type=="text")|.part.text//empty]|join("")' "$out")"
  TOKENS="$(jq -sc '[.[]|select(.type=="step_finish")|.part.tokens//empty]|last//null' "$out")"
  if [ "$rc" -ne 0 ]; then TURN_ERROR="Muse turn failed before proven completion (exit $rc). Run: AI_MUSE_CALLER=$CALLER ai-muse doctor"; return 1; fi
  if [ -z "$TURN_SID" ]; then TURN_ERROR='Muse completed without a session ID.'; return 1; fi
  if [ "$FINISH" != stop ]; then TURN_ERROR="Muse did not prove completion (reason: ${FINISH:-missing})."; return 1; fi
  if [ -z "$TEXT" ]; then TURN_ERROR='Muse completed without a usable response.'; return 1; fi
  if [ "${REQUIRE_VERDICT:-0}" = 1 ] && ! printf '%s\n' "$TEXT" | sed '/^[[:space:]]*$/d' | tail -n 1 | grep -Eq '^VERDICT:[[:space:]]+(FINDINGS|NO FINDINGS)$'; then TURN_ERROR='Muse stopped without an allowed final VERDICT line.'; return 1; fi
}
preserve_failure(){
  local root="$1" name="$2" prompt="$3" out="$4" meta="$5" mode="$6" path tmp now sid
  path="$root/.ai/reviews/muse-$name-incomplete-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM.md"; ensure_report_destination "$root" "$path"
  [ -n "$PUBLISH_FD" ] || return 1
  { printf '# Muse incomplete turn\n\nThis is not an accepted review result. Raw provider and error bodies are deliberately omitted.\n\n## Failure\n\n%s\n\n## Request\n\n%s\n\n## Recoverable identity\n\n- requested session: `%s`\n- returned session: `%s`\n- completion reason: `%s`\n- process result: `%s`\n' "$TURN_ERROR" "$(cat "$prompt")" "$( [ -f "$meta" ] && jq -r '.session_id//""' "$meta" || true)" "$TURN_SID" "$FINISH" "${RUN_RC:-unknown}"; [ -z "$TEXT" ] || printf '\n## Partial response\n\n%s\n' "$TEXT"; } >&"$PUBLISH_FD" || return 1
  finish_report_staging "$root" "$path"
  chmod 600 "$path" 2>/dev/null || true; now="$(date -u +%FT%TZ)"
  if [ -f "$meta" ]; then
    tmp="$(tmp_file)"
    if [ "$mode" = ask ]; then
      jq --arg report "$path" --arg now "$now" --arg sid "$TURN_SID" '.status="provider_outcome_uncertain"|.last_failure_report=$report|.returned_session_id=(if $sid=="" then null else $sid end)|.updated_at=$now' "$meta" > "$tmp"
    else
      jq --arg report "$path" --arg now "$now" --arg sid "$TURN_SID" '.status="provider_outcome_uncertain"|.last_failure_report=$report|.session_id=(if $sid=="" then .session_id else $sid end)|.updated_at=$now' "$meta" > "$tmp"
    fi
    mv -f "$tmp" "$meta" || return 1; return 0
  fi
  [ -n "$TURN_SID" ] || return 0; sid="$TURN_SID"; mkdir -p "$(dirname "$meta")"
  tmp="$(tmp_file)"; jq -n --arg name "$name" --arg caller "$CALLER" --arg root "$root" --arg rid "$(repo_id "$root")" --arg sid "$sid" --arg dir "$REVIEW_DIR" --arg tag "$(tag "$name")" --arg model "$MODEL" --arg head "$HEAD_SHA" --arg packet "$PACKET_HASH" --arg report "$path" --arg now "$now" '{schema_version:1,status:"provider_outcome_uncertain",name:$name,caller:$caller,repository_root:$root,repository_id:$rid,session_id:$sid,review_dir:$dir,sandbox_tag:$tag,model:$model,head:$head,packet_sha256:$packet,last_report:null,last_failure_report:$report,created_at:$now,updated_at:$now}' > "$tmp" || return 1; mv -f "$tmp" "$meta" || return 1; chmod 600 "$meta" 2>/dev/null || true
}
report(){
  local root="$1" name="$2" prompt="$3" path="$4"
  ensure_report_destination "$root" "$path"; [ -n "$PUBLISH_FD" ] || die "Muse report staging was not reserved: $path"
  { printf '# Muse persistent review\n\n| field | value |\n|---|---|\n'; printf '| model | `%s` |\n| session | `%s` |\n| caller | `%s` |\n| repository | `%s` |\n| reviewed commit | `%s` |\n| review copy | `%s` |\n| evidence fingerprint | `%s` |\n| tokens | `%s` |\n\n' "$MODEL" "$TURN_SID" "$CALLER" "$root" "$HEAD_SHA" "$REVIEW_DIR" "$PACKET_HASH" "$TOKENS"; printf '## Request\n\n%s\n\n## Result\n\n%s\n' "$(cat "$prompt")" "$TEXT"; } >&"$PUBLISH_FD" || die "could not write Muse report: $path"
  finish_report_staging "$root" "$path"
  [ -s "$path" ] || die "Muse report was empty: $path"; printf '%s' "$path"
}
cmd_new(){
  local name="$1"; shift; local root rid meta prompt out rep before after tmp report_path now
  name_ok "$name" || die "invalid session name '$name'."; require_runtime; need jq; need git
  root="$(repo_root)"; rid="$(repo_id "$root")"; meta="$(meta_path "$rid" "$name")"; lock_session "$rid" "$name"; [ ! -e "$meta" ] || die "session '$name' exists. Use: AI_MUSE_CALLER=$CALLER ai-muse ask $name"; validate_heartbeat
  prompt="$(read_prompt "$@")"; report_path="$(new_report_path "$root" "$name")"; ensure_report_destination "$root" "$report_path"; reserve_report_staging "$root"; before="$(tree_state "$root")"; prepare "$root" "$name" "$prompt"; out="$(tmp_file)"
  mkdir -p "$(dirname "$meta")"; now="$(date -u +%FT%TZ)"; tmp="$(tmp_file)"; jq -n --arg name "$name" --arg caller "$CALLER" --arg root "$root" --arg rid "$rid" --arg dir "$REVIEW_DIR" --arg tag "$(tag "$name")" --arg model "$MODEL" --arg head "$HEAD_SHA" --arg packet "$PACKET_HASH" --arg now "$now" '{schema_version:1,status:"turn_in_progress",name:$name,caller:$caller,repository_root:$root,repository_id:$rid,session_id:null,review_dir:$dir,sandbox_tag:$tag,model:$model,head:$head,packet_sha256:$packet,last_report:null,created_at:$now,updated_at:$now,last_heartbeat_at:$now}' > "$tmp"; mv -f "$tmp" "$meta"; chmod 600 "$meta" 2>/dev/null || true
  printf 'Muse session started: %s\nState: %s\n' "$name" "$meta" >&2
  if ! run_turn "$REVIEW_DIR" "$prompt" "$out" "" "$meta"; then if preserve_failure "$root" "$name" "$prompt" "$out" "$meta" new; then die "$TURN_ERROR Incomplete evidence was saved under .ai/reviews/."; else die "$TURN_ERROR Incomplete evidence could not be saved."; fi; fi
  # Preserve the provider session immediately after proven completion. A later
  # local failure remains recoverable through show, ask, transcript, or delete.
  tmp="$(tmp_file)"; jq --arg sid "$TURN_SID" --arg now "$(date -u +%FT%TZ)" '.status="completed_pending_local_checks"|.session_id=$sid|.updated_at=$now' "$meta" > "$tmp"; mv -f "$tmp" "$meta"
  after="$(tree_state "$root")"; [ "$before" = "$after" ] || die "the source repository changed during the Muse turn; stale response rejected. The session was preserved; use AI_MUSE_CALLER=$CALLER with show, ask, transcript, or delete."; rep="$(report "$root" "$name" "$prompt" "$report_path")"
  tmp="$(tmp_file)"; jq --arg report "$rep" --arg now "$(date -u +%FT%TZ)" '.status="active"|.last_report=$report|.updated_at=$now' "$meta" > "$tmp"; mv -f "$tmp" "$meta"; ACTIVE_META=""
  rm -f "$prompt" "$out" "$out.stderr"; unlock_session; printf '%s\n' "$TEXT"; printf 'Muse session: %s\nReport: %s\n' "$name" "$rep" >&2
}
cmd_ask(){
  local name="$1"; shift; local root rid meta sid status prompt out rep tmp before after report_path
  name_ok "$name" || die "invalid session name '$name'."; require_runtime; need jq; root="$(repo_root)"; rid="$(repo_id "$root")"; meta="$(meta_path "$rid" "$name")"; lock_session "$rid" "$name"; [ -f "$meta" ] || die "no session '$name' for caller '$CALLER' in this repository."
  status="$(jq -r '.status//"active"' "$meta")"; [ "$status" = active ] || die "session '$name' requires reconciliation ($status). Inspect: AI_MUSE_CALLER=$CALLER ai-muse transcript $name ; then run: AI_MUSE_CALLER=$CALLER ai-muse reconcile $name"
  validate_heartbeat
  sid="$(jq -r .session_id "$meta")"; prompt="$(read_prompt "$@")"; report_path="$(new_report_path "$root" "$name")"; ensure_report_destination "$root" "$report_path"; reserve_report_staging "$root"; before="$(tree_state "$root")"; prepare "$root" "$name" "$prompt"; out="$(tmp_file)"; tmp="$(tmp_file)"; jq --arg now "$(date -u +%FT%TZ)" '.status="turn_in_progress"|.last_heartbeat_at=$now|.updated_at=$now' "$meta" > "$tmp"; mv -f "$tmp" "$meta"
  if ! run_turn "$REVIEW_DIR" "$prompt" "$out" "$sid" "$meta"; then if preserve_failure "$root" "$name" "$prompt" "$out" "$meta" ask; then die "$TURN_ERROR Incomplete evidence was saved under .ai/reviews/."; else die "$TURN_ERROR Incomplete evidence could not be saved; the session remains blocked."; fi; fi
  if [ "$TURN_SID" != "$sid" ]; then TURN_ERROR="Muse resumed a different session ($TURN_SID instead of $sid)."; if preserve_failure "$root" "$name" "$prompt" "$out" "$meta" ask; then die "$TURN_ERROR Response rejected and evidence preserved."; else die "$TURN_ERROR Response rejected; evidence could not be saved and the session remains blocked."; fi; fi
  tmp="$(tmp_file)"; jq --arg now "$(date -u +%FT%TZ)" '.status="completed_pending_local_checks"|.updated_at=$now' "$meta" > "$tmp"; mv -f "$tmp" "$meta"
  after="$(tree_state "$root")"; [ "$before" = "$after" ] || die "the source repository changed during the Muse turn; stale response rejected. The advanced session was preserved; inspect it with AI_MUSE_CALLER=$CALLER ai-muse transcript $name before continuing."; rep="$(report "$root" "$name" "$prompt" "$report_path")"
  tmp="$(tmp_file)"; jq --arg head "$HEAD_SHA" --arg packet "$PACKET_HASH" --arg report "$rep" --arg now "$(date -u +%FT%TZ)" '.status="active"|.head=$head|.packet_sha256=$packet|.last_report=$report|.updated_at=$now' "$meta" > "$tmp"; mv -f "$tmp" "$meta"; ACTIVE_META=""; rm -f "$prompt" "$out" "$out.stderr"; unlock_session; printf '%s\n' "$TEXT"; printf 'Muse session: %s\nReport: %s\n' "$name" "$rep" >&2
}
find_meta(){ local root rid m; name_ok "$1" || die "invalid session name '$1'."; root="$(repo_root)"; rid="$(repo_id "$root")"; m="$(meta_path "$rid" "$1")"; [ -f "$m" ] || die "no session '$1' for caller '$CALLER' in this repository."; printf '%s' "$m"; }
cmd_list(){ local f; printf '%-24s %-8s %-26s %s\n' NAME CALLER UPDATED REPOSITORY; while IFS= read -r -d '' f; do jq -r '[.name,.caller,.updated_at,.repository_root]|@tsv' "$f"; done < <(find "$STATE/sessions" -type f -name '*.json' -print0 2>/dev/null) | awk -F '\t' '{printf "%-24s %-8s %-26s %s\n",$1,$2,$3,$4}'; }
cmd_show(){ jq . "$(find_meta "$1")"; }
cmd_transcript(){ local m; m="$(find_meta "$1")"; runtime_env; "$BIN" export "$(jq -r .session_id "$m")"; }
cmd_reconcile(){ local m rid tmp status; m="$(find_meta "$1")"; rid="$(jq -r .repository_id "$m")"; lock_session "$rid" "$1"; status="$(jq -r '.status//"active"' "$m")"; case "$status" in provider_outcome_uncertain|completed_pending_local_checks|turn_in_progress) ;; *) die "session '$1' cannot be reconciled from status: $status";; esac; tmp="$(tmp_file)"; jq --arg now "$(date -u +%FT%TZ)" '.status="active"|.reconciled_at=$now|.updated_at=$now' "$m" > "$tmp"; mv -f "$tmp" "$m"; unlock_session; printf 'reconciled Muse session: %s\n' "$1"; }
cmd_delete(){ local m root rid tag sid status tmp; m="$(find_meta "$1")"; root="$(jq -r .repository_root "$m")"; rid="$(jq -r .repository_id "$m")"; lock_session "$rid" "$1"; tag="$(jq -r .sandbox_tag "$m")"; sid="$(jq -r .session_id "$m")"; status="$(jq -r '.status//"active"' "$m")"; runtime_env
  if [ "$status" != provider_deleted ]; then
    "$BIN" session delete "$sid" >/dev/null 2>&1 || die "could not positively confirm deletion of Muse session $sid; local record preserved."
    tmp="$(tmp_file)"; jq --arg now "$(date -u +%FT%TZ)" '.status="provider_deleted"|.updated_at=$now' "$m" > "$tmp"; mv -f "$tmp" "$m"
  fi
  "$PACKET" remove "$(jq -r .review_dir "$m")" "$tag" >/dev/null 2>&1 || true; "$SANDBOX" remove-copy "$root" "$tag"; rm -f "$m"; unlock_session; printf 'deleted Muse session: %s\n' "$1"
}
cmd_doctor(){
  local failures=0 live=0 prompt out fixture prior_timeout
  case "${1:-}" in '') ;; --live) live=1;; *) die "unknown doctor option: $1";; esac
  [ "$#" -le 1 ] || die 'usage: ai-muse doctor [--live]'
  check(){ local label="$1"; shift; if "$@" >/dev/null 2>&1; then printf 'PASS  %s\n' "$label"; else printf 'FAIL  %s\n' "$label"; failures=$((failures+1)); fi; }
  printf 'ai-muse doctor\n\n'
  check 'pinned OpenCode is installed' test -x "$BIN"
  check 'Muse configuration is installed' test -f "$OC_CFG/opencode.json"
  check 'trusted provider configuration is installed byte-for-byte' cmp -s "$ROOT/config/opencode-muse/opencode.json" "$OC_CFG/opencode.json"
  check 'trusted review profile is installed byte-for-byte' cmp -s "$ROOT/config/opencode-muse/agent/muse-review.md" "$OC_CFG/agent/muse-review.md"
  check '1Password command is available' command -v op
  [ "$failures" -eq 0 ] || exit 1
  if [ "$live" -eq 1 ]; then
    require_runtime; need jq
    fixture="$RUN_TMP/doctor-fixture"; mkdir -p "$fixture"
    prompt="$(tmp_file)"; out="$(tmp_file)"
    printf 'Reply with exactly MUSE_REVIEWER_HEALTHY' > "$prompt"
    prior_timeout="$TIMEOUT"; TIMEOUT="${AI_MUSE_DOCTOR_TIMEOUT:-90}"
    case "$TIMEOUT" in ''|0|*[!0-9]*) die 'AI_MUSE_DOCTOR_TIMEOUT must be a positive whole number of seconds.';; esac
    if ! run_turn "$fixture" "$prompt" "$out"; then TIMEOUT="$prior_timeout"; die "$TURN_ERROR"; fi
    TIMEOUT="$prior_timeout"
    [ "$TEXT" = MUSE_REVIEWER_HEALTHY ] || die 'Muse live probe returned unexpected text.'
    printf 'PASS  live provider response\n'
  fi
}
usage(){ printf '%s\n' 'ai-muse new <name> --prompt TEXT|--prompt-file FILE|stdin' 'ai-muse ask <name> --prompt TEXT|--prompt-file FILE|stdin' 'ai-muse list | show <name> | transcript <name> | reconcile <name> | delete <name> | doctor' 'ai-muse review [repository] [request]  (compatibility command)'; }

case "${1:-}" in
  new) shift; n="${1:-}"; [ -n "$n" ] || die 'usage: ai-muse new <name> ...'; shift; cmd_new "$n" "$@";;
  ask) shift; n="${1:-}"; [ -n "$n" ] || die 'usage: ai-muse ask <name> ...'; shift; cmd_ask "$n" "$@";;
  list) cmd_list;; show) shift; cmd_show "${1:-}";; transcript) shift; cmd_transcript "${1:-}";; reconcile) shift; cmd_reconcile "${1:-}";; delete) shift; cmd_delete "${1:-}";; doctor) shift; cmd_doctor "$@";;
  review) shift; repo="${1:-$PWD}"; request="${2:-}"; if [ -z "$request" ] && [ ! -t 0 ]; then request="$(cat)"; fi; request="${request:-Review the current changes for correctness, security, and missing tests.}"; printf '%s' "$request" | grep -Eqi 'VERDICT:' || request="$request

Finish with exactly one final line: VERDICT: FINDINGS or VERDICT: NO FINDINGS."; (cd "$(repo_root "$repo")" && REQUIRE_VERDICT=1 cmd_new "review-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM" --prompt "$request");;
  -h|--help|help|'') usage;; *) die "unknown command '$1'. Use: ai-muse --help";;
esac
