#!/usr/bin/env bash
# ai-glm — persistent, named GLM sessions hosted by a local OpenCode server.
#
# This is the ONLY supported way for Claude or Codex to talk to GLM. Never call
# `opencode`, `opencode run`, or the server's HTTP API directly: this script owns the
# server URL, the credentials, the API shapes, and every safety invariant.
#
#   ai-glm new <name> [--prompt T | --prompt-file F | stdin]   start a review session
#   ai-glm ask <name> [...]                                    continue it
#   ai-glm implement <name> [...]                              one-shot write job in a throwaway clone
#   ai-glm list | show <name> | transcript <name> | diff <name>
#   ai-glm abort <name> | delete <name>
#   ai-glm doctor
#   ai-glm server status|start|stop|restart
#
# Model, agent, provider, tools and working directory are fixed when a session is
# created and are deliberately NOT overridable per call: a stable request prefix is
# what makes provider prompt caching work, and a stable agent is what keeps a review
# session read-only.
set -euo pipefail

CFG_DIR="${AI_DEVOPS_CONFIG_DIR:-$HOME/.config/ai-devops}"
OC_HOME="$CFG_DIR/opencode"
PW_FILE="$OC_HOME/server-password"

# Attach to another user's already-running server rather than standing up a
# second one.
#
# The OpenCode server is a single loopback process owned by whichever user set
# it up (on hetz that is `ai`, on 127.0.0.1:4096). A session running as root
# there previously got 17 doctor failures and "setup never finished", because
# root has no server-password of its own — even though the server it needs is
# running and reachable. Installing a SECOND server for root would mean two
# OpenCode processes, two copies of the Z.ai key, and double consumption of one
# shared coding plan. One server, shared, is the fewest moving parts.
#
# Only ever reads a password the current user can already read: root can read
# any home directory by definition, and for a non-root user the read simply
# fails and nothing changes. This grants no access anyone did not already have.
# AI_GLM_SERVER_USER pins the owning user explicitly.
if [ ! -s "$PW_FILE" ]; then
  for _oc_user in ${AI_GLM_SERVER_USER:-ai}; do
    # Never "attach" to ourselves. Running as the owning user with a bare
    # AI_DEVOPS_CONFIG_DIR would otherwise resolve to that same user's real
    # password file, report "attached to the server owned by ai" while we ARE
    # ai, and short-circuit the full installation report doctor is meant to
    # give on a machine that is not set up yet.
    [ "$_oc_user" = "$(id -un 2>/dev/null || echo)" ] && continue
    # `|| true` is load-bearing: under `set -e` an assignment from a failing
    # command substitution aborts the script, and `getent` does not exist on
    # Windows/Git Bash. Without it, ai-glm exited on line 30 on every Windows run.
    _oc_home="$(getent passwd "$_oc_user" 2>/dev/null | cut -d: -f6 || true)"
    [ -n "${_oc_home:-}" ] || continue
    _oc_pw="$_oc_home/.config/ai-devops/opencode/server-password"
    if [ -r "$_oc_pw" ] && [ -s "$_oc_pw" ]; then
      PW_FILE="$_oc_pw"
      OC_SHARED_FROM="$_oc_user"
      break
    fi
  done
  unset _oc_user _oc_home _oc_pw
fi
STATE_DIR="${AI_GLM_STATE_DIR:-$HOME/.local/state/ai-devops/glm}"
PORT="${AI_GLM_PORT:-4096}"
BASE="http://127.0.0.1:$PORT"
PROVIDER="zai-coding-plan"
MODEL="${AI_GLM_MODEL:-glm-5.3}"
CALLER="${AI_GLM_CALLER:-claude}"
TIMEOUT="${AI_GLM_TIMEOUT:-1800}"        # seconds to wait for one GLM turn
LOCK_TIMEOUT="${AI_GLM_LOCK_TIMEOUT:-300}"
POLL_SECS=5
JSON_OUT=0

die()  { printf 'ai-glm: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ai-glm: warning: %s\n' "$*" >&2; }
note() { [ "$JSON_OUT" = 1 ] || printf '%s\n' "$*" >&2; }

local_service_fatal() {
  printf '%s\n' \
    'ai-glm: FATAL: local opencode server is not answering (health endpoint).' \
    '  failure: local_dependency_unavailable' \
    '  This is a LOCAL SERVICE fault on this machine, NOT a provider or model fault.' \
    '  Start it with: ai-glm server start' \
    '  Then re-run. (ai-glm doctor shows the full check list.)' >&2
  exit 1
}

case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
  *) IS_WINDOWS=0 ;;
esac
[ "${OS:-}" = "Windows_NT" ] && IS_WINDOWS=1

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."; }
need curl; need jq; need git

# --------------------------------------------------------------------------------
# HTTP. Every request is authenticated; the server 401s otherwise.
# --------------------------------------------------------------------------------
server_pw() {
  # Return empty rather than dying: doctor probes the server while deliberately
  # inspecting a machine that may not be set up, and a die() here printed a stray
  # error in the middle of the report. require_server gives the actionable message.
  [ -s "$PW_FILE" ] || return 1
  tr -d '\r\n' < "$PW_FILE"
}
api() { # api METHOD PATH [JSON_BODY_FILE]
  local method="$1" path="$2" body="${3:-}" pw
  pw="$(server_pw || true)"
  if [ -n "$body" ]; then
    curl -sS -m 120 -u "${OPENCODE_SERVER_USERNAME:-opencode}:$pw" \
      -X "$method" "$BASE$path" -H 'content-type: application/json' --data-binary @"$body"
  else
    curl -sS -m 120 -u "${OPENCODE_SERVER_USERNAME:-opencode}:$pw" -X "$method" "$BASE$path"
  fi
}
api_code() { # api_code METHOD PATH -> HTTP status only
  local pw; pw="$(server_pw || true)"
  curl -sS -m 30 -o /dev/null -w '%{http_code}' \
    -u "${OPENCODE_SERVER_USERNAME:-opencode}:$pw" -X "$1" "$BASE$2" 2>/dev/null || echo 000
}
server_up() { [ "$(api_code GET /global/health)" = "200" ]; }
require_server() {
  if [ ! -s "$PW_FILE" ]; then
    die "local_dependency_unavailable: GLM is not set up on this machine (no $PW_FILE). This is not a provider or model fault.
       Ubuntu:  bin/setup-opencode-glm.sh
       Windows: .\\bin\\setup-opencode-glm.ps1"
  fi
  server_up || local_service_fatal
}

# --------------------------------------------------------------------------------
# Repository + session identity
#
# The key is repo + caller + name. Claude and Codex keep separate sessions, so both
# can use the short name "auth-review" in the same repo without colliding.
# --------------------------------------------------------------------------------
repo_root() {
  local r
  r="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository (cd into one, or pass --repo)."
  printf '%s' "$r"
}

# --- review boundary ----------------------------------------------------------
# OpenCode gives a session exactly ONE directory, and in a linked worktree the
# repository's control files sit outside it, so the reviewer dies before reading
# any code. ai-review-sandbox turns such a worktree into a self-contained
# snapshot; in an ordinary clone it echoes the root unchanged. See that script's
# header for the full story.
SANDBOX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-sandbox"
[ -x "$SANDBOX_BIN" ] || SANDBOX_BIN="$(command -v ai-review-sandbox 2>/dev/null || true)"
review_boundary() { # review_boundary ROOT NAME -> directory to hand the reviewer
  [ -f "$1/.git" ] || { printf '%s' "$1"; return 0; }
  [ -n "$SANDBOX_BIN" ] || die "this is a linked worktree and ai-review-sandbox is missing; install the toolkit's bin/ on PATH."
  "$SANDBOX_BIN" ensure "$1" "glm-$2" || die "could not prepare a review snapshot for the worktree $1"
}
release_boundary() { # release_boundary ROOT NAME
  [ -f "$1/.git" ] || return 0
  [ -n "$SANDBOX_BIN" ] || return 0
  "$SANDBOX_BIN" remove "$1" "glm-$2" || warn "review snapshot for '$2' could not be removed."
}

# --- evidence packet ----------------------------------------------------------
# The glm-review agent profile sets `bash: false`, so GLM cannot run `git diff`
# and cannot work out what changed. Without a packet it spends its budget
# rediscovering the comparison — and on 2026-08-16/17 it also reached for web
# search when a local reference was missing. ai-review-packet writes the
# shell-derived facts into .ai-review/ inside the review directory.
#
# The packet is ADDITIVE: read and grep over the whole directory are unchanged
# and the manifest says so. It is git-excluded, so it cannot trip the read-only
# working-tree canary in cmd_ask.
PACKET_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-review-packet"
[ -x "$PACKET_BIN" ] || PACKET_BIN="$(command -v ai-review-packet 2>/dev/null || true)"

# The packet directory is named after this session's tag (shared-db#1296), so
# the preamble must name the directory that was actually built, not a fixed one.
PACKET_REL=".ai-review"
REVIEW_DIR=""; REVIEW_BASE=""; REVIEW_HEAD=""; PACKET_HASH=""
# Sets the globals above. Never call it in a command substitution: the identity
# would be computed in a subshell and lost.
prepare_review() { # prepare_review ROOT NAME
  local root="$1" name="$2" pkt want
  REVIEW_DIR="$(review_boundary "$root" "$name")"
  REVIEW_HEAD="$(git -C "$REVIEW_DIR" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$REVIEW_HEAD" ] || die "could not read HEAD in $REVIEW_DIR; refusing to review a directory with no commit identity."
  if [ -n "${OPT_ASSERT_HEAD:-}" ]; then
    want="$(git -C "$REVIEW_DIR" rev-parse --verify --quiet "${OPT_ASSERT_HEAD}^{commit}" || true)"
    [ "$want" = "$REVIEW_HEAD" ] || die "--assert-head does not match this repository.
  you said : $OPT_ASSERT_HEAD
  actual   : $REVIEW_HEAD
A verdict recorded against the wrong commit is worthless evidence. Nothing was
reviewed. Re-read the SHA from git rather than transcribing it."
  fi
  [ -n "$PACKET_BIN" ] || die "ai-review-packet is missing; install the toolkit's bin/ on PATH. A review without an evidence packet burns its whole budget rediscovering the diff."
  pkt="$("$PACKET_BIN" build "$REVIEW_DIR" "glm-$name" --class small \
           ${OPT_BASE:+--base "$OPT_BASE"} \
           ${OPT_TESTS:+--tests "$OPT_TESTS"} \
           ${OPT_DECISION:+--decision "$OPT_DECISION"})" \
    || die "could not build the review evidence packet for $REVIEW_DIR"
  REVIEW_BASE="$(sed -n 's/^| \*\*base\*\* | `\([0-9a-f]\{40\}\)`.*/\1/p' "$pkt/MANIFEST.md" | head -1)"
  PACKET_REL="$(basename "$pkt")"
  PACKET_HASH="$(cat "$pkt/MANIFEST.sha256")"
  note "  evidence packet: $pkt (base ${REVIEW_BASE:0:12}, head ${REVIEW_HEAD:0:12}, sha ${PACKET_HASH:0:12})"
}

PACKET_PREAMBLE="Your evidence packet is at .ai-review/MANIFEST.md in this directory. Read it
first. It contains the exact commits under review, the changed files, the full
patch, and what you are being asked to decide.

You may read any other file in this directory to confirm a finding — the packet
is your starting point, not a boundary. What you must NOT do is spend turns
reconstructing the diff yourself; it is already in .ai-review/patch.diff.
Everything you need is local; do not search the web.

---

"
# Prepend the preamble to a prompt file in place.
prefix_packet_preamble() { # prefix_packet_preamble PROMPT_FILE
  local pf="$1" tmp
  [ -n "$PACKET_HASH" ] || return 0
  tmp="$(mktemp)"
  { printf '%s' "${PACKET_PREAMBLE//.ai-review/$PACKET_REL}"; cat "$pf"; } > "$tmp"
  mv "$tmp" "$pf"
}
repo_id() {
  local root remote
  root="$(cd "$1" && pwd -P)"
  remote="$(git -C "$root" config --get remote.origin.url 2>/dev/null || echo '')"
  printf '%s' "$(printf '%s\n%s' "$root" "$remote" | sha256sum | cut -c1-12)"
}
repo_remote() { git -C "$1" config --get remote.origin.url 2>/dev/null || true; }
safe_repo_remote() { repo_remote "$1" | sed -E 's#(https?://)[^/@]+@#\1[REDACTED]@#; s/[?#].*$//'; }
valid_name() {
  case "$1" in
    ''|*[!a-zA-Z0-9._-]*) return 1 ;;
    *) [ "${#1}" -le 64 ] ;;
  esac
}
meta_path() { printf '%s/sessions/%s/%s--%s.json' "$STATE_DIR" "$1" "$CALLER" "$2"; }
lock_path() { printf '%s/locks/%s--%s--%s.lock.d' "$STATE_DIR" "$1" "$CALLER" "$2"; }

# Portable mutex. `flock` does not exist in Git Bash, and this harness has to behave
# identically on Ubuntu and on Windows, so the lock is an atomic mkdir plus a pid file.
# A lock whose owning process is gone is treated as stale and reclaimed, so a crashed
# or killed run never wedges a session permanently.
lock_acquire() { # lock_acquire DIR TIMEOUT_SECONDS
  local d="$1" timeout="$2" waited=0 owner
  mkdir -p "$(dirname "$d")"
  while ! mkdir "$d" 2>/dev/null; do
    owner="$(cat "$d/pid" 2>/dev/null || echo '')"
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$d"; continue                       # stale: owner is gone
    fi
    [ "$waited" -lt "$timeout" ] || return 1
    sleep 2; waited=$((waited + 2))
  done
  printf '%s' "$$" > "$d/pid"
  # shellcheck disable=SC2064
  trap "rm -rf '$d'" EXIT
  return 0
}

lock_release() { rm -rf "$1" 2>/dev/null || true; }

implementation_lock_acquire() { # never reclaim: a stale lock is reconciliation evidence
  local d="$1"
  mkdir -p "$(dirname "$d")"
  mkdir "$d" 2>/dev/null || return 1
  if ! printf '%s' "$$" > "$d/pid"; then rm -rf "$d"; return 1; fi
  # shellcheck disable=SC2064
  trap "rm -rf '$d'" EXIT
}

write_meta() { # write_meta FILE JSON  (atomic: temp + mv on the same filesystem)
  local f="$1" tmp
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$(dirname "$f")/.tmp.XXXXXX")"
  printf '%s\n' "$2" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$f"
}

implementation_terminal() {
  case "$1" in completed|failed|aborted) return 0 ;; *) return 1 ;; esac
}

implementation_active() {
  case "$1" in starting|running|abort-requested) return 0 ;; *) return 1 ;; esac
}

implementation_cleanup_pending() {
  jq -e '.cleanup.clone == "pending" or .cleanup.server_session == "pending"' "$1" >/dev/null 2>&1
}

implementation_clone_path() { # RID NAME
  printf '%s/wt/%s/%s--%s' "$STATE_DIR" "$1" "$CALLER" "$2"
}

remove_owned_clone_tree() { # exact ownership must be validated by the caller first
  local clone="$1" attempt=0
  # OpenCode 1.18.12 can leave a Windows tool child alive briefly after the exact
  # session abort/delete returns. Wait at most two minutes for its directory handle;
  # never kill descendants of the shared server because they may belong to another
  # concurrent session.
  while [ "$attempt" -lt 120 ]; do
    if [ "$IS_WINDOWS" = 1 ] && [ -d "$clone/.git" ]; then
      # The canonical state prefix plus a legal 64-character job name can push tracked
      # files beyond MAX_PATH. Git for Windows honors core.longpaths during removal;
      # ordinary MSYS rm does not. Remove repository content through Git first, then the
      # now-short administrative remainder. This is used only after exact ownership proof.
      git -c core.longpaths=true -C "$clone" rm -rf --ignore-unmatch . >/dev/null 2>&1 || true
      git -c core.longpaths=true -C "$clone" clean -ffdx >/dev/null 2>&1 || true
    fi
    rm -rf "$clone" 2>/dev/null || true
    # MSYS rm can remove every long-path child yet leave the now-empty top directory.
    rmdir "$clone" 2>/dev/null || true
    [ ! -e "$clone" ] && return 0
    sleep 1
    attempt=$((attempt + 1))
  done
  [ ! -e "$clone" ]
}

metadata_lock_acquire() { # lock used only for one atomic record transition
  local d="$1" waited=0 owner
  while ! mkdir "$d" 2>/dev/null; do
    owner="$(cat "$d/pid" 2>/dev/null || echo '')"
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$d"; continue; fi
    [ "$waited" -lt 100 ] || return 1
    sleep 0.1; waited=$((waited + 1))
  done
  if ! printf '%s' "$$" > "$d/pid"; then rm -rf "$d"; return 1; fi
}

implementation_record_path_valid() {
  local f="$1" rid caller name expected
  rid="$(jq -r '.repository_id // empty' "$f" 2>/dev/null)"
  caller="$(jq -r '.caller // empty' "$f" 2>/dev/null)"
  name="$(jq -r '.name // empty' "$f" 2>/dev/null)"
  expected="$STATE_DIR/sessions/$rid/$caller--$name.json"
  [ "$(canonical_path "$f" "$STATE_DIR")" = "$(canonical_path "$expected" "$STATE_DIR")" ]
}

implementation_meta_valid() { # FILE [EXPECTED_ROOT] [EXPECTED_CALLER]
  local f="$1" expected_root="${2:-}" expected_caller="${3:-$CALLER}" root rid name caller clone expected
  jq -e '
    .schema_version == 3 and .type == "implementation" and
    (.name|type)=="string" and (.repository_root|type)=="string" and
    (.repository_id|type)=="string" and (.caller|type)=="string" and
    (.base_sha|type)=="string" and (.owner_pid|type)=="number" and
    (.status|IN("starting","running","abort-requested","completed","failed","aborted")) and
    (.clone_path == null or (.clone_path|type)=="string") and
    (.opencode_session_id == null or (.opencode_session_id|type)=="string") and
    (.failure_summary == null or (.failure_summary|type)=="string") and
    (.failure_detail == null or ((.failure_detail|type)=="object" and
      (.failure_detail.reason_id|type)=="string" and
      (.failure_detail.reason|type)=="string")) and
    (.failure_detected_at == null or (.failure_detected_at|type)=="string") and
    (.changes_present == null or (.changes_present|type)=="boolean") and
    (.patch_exists == null or (.patch_exists|type)=="boolean") and
    (.outcome == null or (.outcome|IN(
      "completed","failed-partial","failed-no-changes",
      "aborted-partial","aborted-no-changes",
      "timed-out-partial","timed-out-no-changes",
      "usage-limit-partial","usage-limit-no-changes",
      "permission-failed-partial","permission-failed-no-changes",
      "artifact-export-failed"))) and
    (.failure_kind == null or (.failure_kind|IN(
      "provider-or-service","usage-limit","timed-out","permission-failed","transport-failed",
      "aborted","artifact-export-failed","artifact-metadata-failed",
      "report-write-failed","patch-export-failed","resource-cleanup-failed",
      "owner-process-died","interrupted","wrapper-setup-failed"))) and
    (.incomplete_patch_path == null or (.incomplete_patch_path|type)=="string") and
    (.incomplete_report_path == null or (.incomplete_report_path|type)=="string") and
    (.artifact_state == null or (.artifact_state|IN("pending","none","durable","failed"))) and
    (.provider_usage_state == null or (.provider_usage_state|IN("pending","unavailable","final"))) and
    (.provider_tokens == null or (.provider_tokens|type)=="object")
  ' "$f" >/dev/null 2>&1 || return 1
  root="$(jq -r .repository_root "$f")"; rid="$(jq -r .repository_id "$f")"
  name="$(jq -r .name "$f")"; caller="$(jq -r .caller "$f")"
  valid_name "$name" || return 1
  [ -d "$root" ] && [ "$rid" = "$(repo_id "$root")" ] || return 1
  [ "$caller" = "$expected_caller" ] || return 1
  [ -z "$expected_root" ] || [ "$(canonical_path "$root" "$root")" = "$(canonical_path "$expected_root" "$expected_root")" ] || return 1
  clone="$(jq -r '.clone_path // empty' "$f")"
  if [ -n "$clone" ]; then
    expected="$STATE_DIR/wt/$rid/$caller--$name"
    [ "$(canonical_path "$clone" "$STATE_DIR")" = "$(canonical_path "$expected" "$STATE_DIR")" ] || return 1
  fi
}

implementation_update() { # FILE JQ_FILTER [jq args...]
  local f="$1" filter="$2" old new tmp record_caller update_lock="$1.update.lock.d"; shift 2
  metadata_lock_acquire "$update_lock" || return 1
  record_caller="$(jq -r '.caller // empty' "$f" 2>/dev/null)"
  if [ ! -f "$f" ] || [ -z "$record_caller" ] || ! implementation_meta_valid "$f" "" "$record_caller"; then
    rm -rf "$update_lock"; return 1
  fi
  old="$(jq -r .status "$f")"
  tmp="$(mktemp)"
  jq "$@" "$filter | .updated_at=\"$(date -u +%FT%TZ)\"" "$f" > "$tmp" || { rm -f "$tmp"; rm -rf "$update_lock"; return 1; }
  new="$(jq -r .status "$tmp")"
  case "$old:$new" in
    starting:starting|starting:running|starting:abort-requested|starting:failed|starting:aborted|\
    running:running|running:abort-requested|running:completed|running:failed|running:aborted|\
    abort-requested:abort-requested|abort-requested:completed|abort-requested:failed|abort-requested:aborted|\
    completed:completed|failed:failed|aborted:aborted) ;;
    *) rm -f "$tmp"; rm -rf "$update_lock"; return 1 ;;
  esac
  implementation_meta_valid "$tmp" "" "$record_caller" || { rm -f "$tmp"; rm -rf "$update_lock"; return 1; }
  if ! write_meta "$f" "$(cat "$tmp")"; then rm -f "$tmp"; rm -rf "$update_lock"; return 1; fi
  rm -f "$tmp"; rm -rf "$update_lock"
}

implementation_abort_requested() {
  [ -f "$1" ] && [ "$(jq -r '.status // empty' "$1" 2>/dev/null)" = abort-requested ]
}

test_pause() { # internal deterministic fixture hook; inert outside the test suite
  [ "${AI_GLM_TEST_PAUSE_AT:-}" = "$1" ] || return 0
  [ "${AI_GLM_TEST_MODE:-0}" = 1 ] || die "AI_GLM_TEST_PAUSE_AT is test-only."
  : > "${AI_GLM_TEST_READY:?AI_GLM_TEST_READY is required}"
  while [ ! -e "${AI_GLM_TEST_RELEASE:?AI_GLM_TEST_RELEASE is required}" ]; do sleep 0.1; done
}

test_failure() { # internal deterministic failure hook; inert outside the test suite
  [ "${AI_GLM_TEST_MODE:-0}" = 1 ] && [ "${AI_GLM_TEST_FAIL_AT:-}" = "$1" ]
}

# --------------------------------------------------------------------------------
# Turn execution
#
# Completion rule, deliberately strict. A turn is done only when the newest assistant
# message reports finish=="stop" AND the server has reported idle twice in a row.
# Anything else - unknown finish value, stuck tool, pending permission - times out or
# hard-fails loudly. "Session id absent from /session/status" alone is NOT completion:
# a wedged turn also looks idle, and treating that as success silently reports an
# empty review as a finished one.
# --------------------------------------------------------------------------------
HTTP_STATUS=""; HTTP_BODY=""
# Transport retry bound for the permission endpoint.
#
# A permission poll is a LOCAL loopback request against our own OpenCode server. When
# curl itself exits nonzero - connection refused, connection reset, or this timeout
# expiring - no reply was ever received, so nothing was refused and no provider tokens
# were spent. Retrying it is free and re-sends nothing to Z.ai, which is why this does
# not break the standing rule against retrying paid provider turns. On 2026-08-12 a
# single dropped poll killed an 8-minute implement job and was reported to the user as a
# permission failure. Three attempts matches the Windows service wrapper's own bound.
PERMISSION_HTTP_ATTEMPTS="${AI_GLM_PERMISSION_HTTP_ATTEMPTS:-3}"
PERMISSION_HTTP_RETRY_SECS="${AI_GLM_PERMISSION_HTTP_RETRY_SECS:-2}"
PERMISSION_HTTP_TIMEOUT="${AI_GLM_PERMISSION_HTTP_TIMEOUT:-20}"
permission_http() { # permission_http METHOD PATH [JSON]; sets HTTP_STATUS + HTTP_BODY
  local method="$1" path="$2" json="${3:-}" pw tmp rc attempt=1
  pw="$(server_pw)"
  while :; do
    rc=0; tmp="$(mktemp)"
    if [ -n "$json" ]; then
      HTTP_STATUS="$(curl -sS -m "$PERMISSION_HTTP_TIMEOUT" -o "$tmp" -w '%{http_code}' \
        -u "${OPENCODE_SERVER_USERNAME:-opencode}:$pw" -X "$method" "$BASE$path" \
        -H 'content-type: application/json' -d "$json" 2>/dev/null)" || rc=$?
    else
      HTTP_STATUS="$(curl -sS -m "$PERMISSION_HTTP_TIMEOUT" -o "$tmp" -w '%{http_code}' \
        -u "${OPENCODE_SERVER_USERNAME:-opencode}:$pw" -X "$method" "$BASE$path" \
        2>/dev/null)" || rc=$?
    fi
    HTTP_BODY="$(cat "$tmp")"; rm -f "$tmp"
    [ "$rc" -eq 0 ] && return 0
    # A server that DID answer keeps its real status and still fails closed elsewhere.
    # Only the never-answered case reaches here and is retried.
    HTTP_STATUS="000"
    [ "$attempt" -lt "$PERMISSION_HTTP_ATTEMPTS" ] || return 0
    attempt=$((attempt + 1))
    sleep "$PERMISSION_HTTP_RETRY_SECS"
  done
}

delete_exact_server_session() { # SID; 404 is already clean
  permission_http DELETE "/session/$1"
  case "$HTTP_STATUS" in 2*|404) return 0 ;; *) return 1 ;; esac
}

sanitize_permission_body() { # redact first, then cap response detail at 2 KiB
  local body="$1" clean truncated=""
  clean="$(printf '%s' "$body" | jq -c '
    walk(if type=="object" then with_entries(
      if (.key|ascii_downcase|test("token|authorization|secret|credential|password|content|value"))
      then .value="[REDACTED]" else . end) else . end)' 2>/dev/null || printf '%s' "$body" | sed -E 's/(token|authorization|secret|credential|password|content|value)[^,}]*/\1=[REDACTED]/Ig')"
  [ "${#clean}" -le 2048 ] || { clean="${clean:0:2048}"; truncated=" [truncated]"; }
  printf '%s%s' "$clean" "$truncated"
}

canonical_path() { # canonical_path PATH BASE; supports paths that do not exist yet
  local path="$1" base="$2" out
  case "$path" in
    /*|[A-Za-z]:[\\/]*|\\\\*) ;;
    *) path="$base/$path" ;;
  esac
  if [ "$IS_WINDOWS" = 1 ] && command -v cygpath >/dev/null 2>&1; then
    out="$(cygpath -am "$path" 2>/dev/null)" || return 1
    printf '%s' "$out" | tr '[:upper:]' '[:lower:]'
  elif command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$path" 2>/dev/null
  else
    return 1
  fi
}

path_category() { # path_category TARGET SESSION_DIR
  local target root
  target="$(canonical_path "$1" "$2")" || { printf invalid; return; }
  root="$(canonical_path "$2" "$2")" || { printf invalid; return; }
  case "$target" in "$root"|"$root"/*) printf inside ;; *) printf outside ;; esac
}

permission_diagnostic() { # STATUS MODE CATEGORY BODY
  printf 'status=%s mode=%s path=%s sanitized_response=%s' \
    "$1" "$2" "$3" "$(sanitize_permission_body "$4")"
}

# --------------------------------------------------------------------------------
# Durable permission diagnostics
#
# classify_permissions has many distinct rejection branches but handle_permissions maps
# them onto a handful of durable codes, so before 2026-08-12 five different branches all
# recorded permission-invalid-response and the exact reason went only to the caller's
# stderr. For an unattended background job that destroyed the one fact needed to fix the
# bug. Every rejection now also records a bounded, sanitized failure_detail object with a
# stable reason_id, so ai-glm show names the branch that fired.
# --------------------------------------------------------------------------------
permission_reason_id() { # REASON -> stable slug naming the classifier branch
  case "$1" in
    local\ permission\ endpoint\ did\ not\ answer*) printf transport-no-reply ;;
    un-approvable*)                                printf unapprovable-request ;;
    permission\ endpoint\ returned\ HTTP*)         printf http-status ;;
    malformed\ permission\ response*)              printf malformed-json ;;
    unsupported\ permission\ response\ envelope*)  printf unsupported-envelope ;;
    *missing\ an\ id*)                             printf missing-id ;;
    unknown\ permission\ action:*)                 printf unknown-action ;;
    *missing\ resources*)                          printf missing-resources ;;
    todowrite\ permission\ shape*)                 printf todowrite-shape ;;
    permission\ resource\ is\ *)                   printf resource-out-of-bounds ;;
    running\ read\ path\ is\ *)                    printf running-read-out-of-bounds ;;
    permission\ approval\ did\ not\ clear*)        printf approval-ineffective ;;
    permission\ approval\ reply\ failed*)          printf approval-reply-failed ;;
    *) printf unclassified ;;
  esac
}

permission_reason_action() { # REASON -> the offending action, or "missing"
  local tail
  case "$1" in
    unknown\ permission\ action:*) printf '%s' "${1#unknown permission action: }" ;;
    *\(action:\ *) tail="${1##*\(action: }"; printf '%s' "${tail%%\)*}" ;;
    *) printf missing ;;
  esac
}

permission_failure_detail() { # REASON STATUS MODE CATEGORY BODY -> sanitized JSON object
  # Everything written here is either wrapper-authored text or output of
  # sanitize_permission_body. A raw response body must never reach a durable record.
  jq -nc --arg reason_id "$(permission_reason_id "$1")" --arg reason "$1" \
    --arg action "$(permission_reason_action "$1")" --arg status "$2" --arg mode "$3" \
    --arg path "$4" --arg sanitized_response "$(sanitize_permission_body "$5")" \
    '{reason_id:$reason_id,reason:$reason,action:$action,status:$status,
      mode:$mode,path:$path,sanitized_response:$sanitized_response}' 2>/dev/null \
    || printf '{"reason_id":"unclassified","reason":"detail could not be encoded","action":"missing","status":"","mode":"","path":"","sanitized_response":""}'
}

classify_permissions() { # MODE SESSION_DIR HTTP_STATUS BODY -> TSV: id action resources
  local mode="$1" root="$2" status="$3" body="$4" shape count i item id action resources resource category
  [ "$mode" = review ] || [ "$mode" = implement ] || { printf 'unknown mode' >&2; return 1; }
  if [ "$status" = 000 ]; then
    # 000 is not a status any server can send. permission_http assigns it only when curl
    # itself failed after every retry, so this is a dropped LOCAL request, not a
    # permission the wrapper refused. Keep it out of the non-2xx branch below: those are
    # real answers from a live server and must keep failing closed.
    printf 'local permission endpoint did not answer after %s attempts (%ss timeout each)' \
      "$PERMISSION_HTTP_ATTEMPTS" "$PERMISSION_HTTP_TIMEOUT" >&2
    return 1
  fi
  if [ "$status" -lt 200 ] 2>/dev/null || [ "$status" -ge 300 ] 2>/dev/null; then
    if printf '%s' "$body" | jq -e '._tag? == "InvalidRequestError"' >/dev/null 2>&1; then
      printf 'un-approvable OpenCode permission request' >&2
    else
      printf 'permission endpoint returned HTTP %s' "$status" >&2
    fi
    return 1
  fi
  printf '%s' "$body" | jq -e . >/dev/null 2>&1 || { printf 'malformed permission response' >&2; return 1; }
  shape="$(printf '%s' "$body" | jq -r 'if type=="object" and (.data|type)=="array" then "data" else "unsupported" end')"
  [ "$shape" != unsupported ] || { printf 'unsupported permission response envelope' >&2; return 1; }
  count="$(printf '%s' "$body" | jq -r '.data|length')"
  for ((i=0; i<count; i++)); do
    item="$(printf '%s' "$body" | jq -c --argjson i "$i" '.data[$i]')"
    id="$(printf '%s' "$item" | jq -r '.id // empty')"
    action="$(printf '%s' "$item" | jq -r '.action // empty' | tr '[:upper:]' '[:lower:]')"
    if [ "$action" = todowrite ]; then
      # Measured against the pinned OpenCode 1.18.12 binary and live API on
      # 2026-08-10. TodoWrite asks for exactly resources:["*"] and save:["*"],
      # then updates only the current session's internal todo store. This star is
      # action-local data, never a general filesystem or tool wildcard.
      printf '%s' "$item" | jq -e '
        .resources == ["*"] and .save == ["*"]' >/dev/null 2>&1 \
        || { printf 'todowrite permission shape is not the measured resources/save wildcard (action: todowrite)' >&2; return 1; }
      resources='*'
    else
      resources="$(printf '%s' "$item" | jq -r '
        if (.resources|type)=="array" and (.resources|length)>0
        then .resources[] else empty end')"
    fi
    [ -n "$id" ] || { printf 'permission entry is missing an id (action: %s)' "${action:-missing}" >&2; return 1; }
    case "$action" in read|list|glob|grep|todowrite) ;; *) printf 'unknown permission action: %s' "${action:-missing}" >&2; return 1 ;; esac
    [ -n "$resources" ] || { printf 'permission entry is missing resources (action: %s)' "${action:-missing}" >&2; return 1; }
    if [ "$action" != todowrite ]; then
      while IFS= read -r resource; do
        category="$(path_category "$resource" "$root")"
        [ "$category" = inside ] || { printf 'permission resource is %s (action: %s)' "$category" "${action:-missing}" >&2; return 1; }
      done <<< "$resources"
    fi
    printf '%s\t%s\t%s\n' "$id" "$action" "$(printf '%s' "$resources" | jq -Rs 'split("\n")|map(select(length>0))|join(",")')"
  done
}

record_implementation_permission_failure() { # META CLONE CODE SAFE_SUMMARY [DETAIL_JSON]
  local meta="$1" clone="$2" code="$3" summary="$4" detail="${5:-null}" changes=false patch_exists=false patch
  [ -n "$meta" ] && [ -f "$meta" ] || return 0
  printf '%s' "$detail" | jq -e . >/dev/null 2>&1 || detail=null
  [ -z "$(git -C "$clone" status --porcelain 2>/dev/null)" ] || changes=true
  patch="$(jq -r '.patch_path // empty' "$meta" 2>/dev/null || true)"
  [ -z "$patch" ] || [ ! -f "$patch" ] || patch_exists=true
  implementation_update "$meta" \
    '.status="failed" | .failure=$code | .failure_summary=$summary |
     .failure_detail=$detail |
     .failure_detected_at=$now | .changes_present=$changes | .patch_exists=$patch_exists' \
    --arg code "$code" --arg summary "$summary" --arg now "$(date -u +%FT%TZ)" \
    --argjson detail "$detail" \
    --argjson changes "$changes" --argjson patch_exists "$patch_exists" \
    || die "permission failed, and its safe implementation-job evidence could not be recorded."
}

fail_permission() { # META CLONE CODE SAFE_SUMMARY USER_MESSAGE [DETAIL_JSON]
  record_implementation_permission_failure "$1" "$2" "$3" "$4" "${6:-null}"
  die "$5"
}

permission_next_step() { # NAME [IMPLEMENTATION_META]
  if [ -n "${2:-}" ]; then
    printf 'Inspect the failed job with: ai-glm show %s. Its owner will finish exact cleanup before safe deletion' "$1"
  else
    printf 'Run: ai-glm abort %s' "$1"
  fi
}

running_read_boundary() { # ASSISTANT_JSON SESSION_DIR -> inside|outside|invalid|missing
  local msg="$1" root="$2" paths path category found=0
  # OpenCode 1.18.12 ToolPart.state.input is intentionally open-ended. The measured
  # built-in read tool uses filePath. Do not guess aliases: an unmeasured shape is
  # "missing" and falls back to the strict overall turn timeout.
  paths="$(printf '%s' "$msg" | jq -r '
    .content[]? |
    select(.type=="tool" and .state.status=="running" and ((.name // .tool)=="read")) |
    .state.input.filePath // empty' 2>/dev/null || true)"
  [ -n "$paths" ] || { printf missing; return; }
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    found=1; category="$(path_category "$path" "$root")"
    case "$category" in outside|invalid) printf '%s' "$category"; return ;; esac
  done <<< "$paths"
  [ "$found" -eq 1 ] && printf inside || printf missing
}

APPROVED_PERMISSION_IDS=""
# Meta file of the turn currently in flight, so await_turn can prove liveness while it
# blocks. Empty when no turn is running. See touch_liveness().
TURN_META=""
handle_permissions() { # SID NAME MODE SESSION_DIR [IMPLEMENTATION_META]
  local sid="$1" name="$2" mode="$3" root="$4" impl_meta="${5:-}" rows id action resources prior category err msg stuck boundary code summary guidance
  guidance="$(permission_next_step "$name" "$impl_meta")"
  permission_http GET "/api/session/$sid/permission"
  # OpenCode 1.18.12 emits the same metadata-free HTTP 500 UnknownError while a normal
  # read is running and while an outside-directory read is stuck. The status is not a
  # permission signal by itself. Use the measured running read input deterministically;
  # never convert elapsed polls into a generic tool-duration watchdog.
  if [ "$HTTP_STATUS" = 500 ] && printf '%s' "$HTTP_BODY" | jq -e \
       '.name? == "UnknownError" and (.data.message? | type == "string")' >/dev/null 2>&1; then
    msg="$(last_assistant "$sid" 2>/dev/null || printf '{}')"
    stuck="$(running_tools "$msg" 2>/dev/null || true)"
    boundary="$(running_read_boundary "$msg" "$root")"
    case "$boundary" in
      outside|invalid)
        fail_permission "$impl_meta" "$root" permission-outside-directory \
          "blocked an outside-directory read permission on the first observable poll" \
          "GLM permission failed: running read path is $boundary${stuck:+ (tool: $stuck)}.
       $(permission_diagnostic "$HTTP_STATUS" "$mode" "$boundary" "$HTTP_BODY")
       $guidance. For an outside-directory file, place a safe copy under
       the session repository or provide a small safe excerpt, then retry." \
          "$(permission_failure_detail "running read path is $boundary (action: read)" \
             "$HTTP_STATUS" "$mode" "$boundary" "$HTTP_BODY")"
        ;;
      *) return 0 ;;
    esac
  fi
  if ! rows="$(classify_permissions "$mode" "$root" "$HTTP_STATUS" "$HTTP_BODY" 2>"${TMPDIR:-/tmp}/ai-glm-perm-err-$$")"; then
    err="$(cat "${TMPDIR:-/tmp}/ai-glm-perm-err-$$" 2>/dev/null)"; rm -f "${TMPDIR:-/tmp}/ai-glm-perm-err-$$"
    category=missing
    printf '%s' "$err" | grep -q 'outside' && category=outside
    case "$err" in
      local\ permission\ endpoint\ did\ not\ answer*)
        # Transport, not permission. permission_http never received a reply, so no
        # permission request was ever seen and nothing was refused. Reporting this as
        # "GLM permission failed" sent a reader hunting for a permission problem that
        # did not exist, and killed an 8-minute job on 2026-08-12.
        code=transport-failed
        summary="the local OpenCode permission endpoint did not answer after ${PERMISSION_HTTP_ATTEMPTS} attempts" ;;
      unknown\ permission\ action:*) code=permission-unsupported-action; summary="blocked an unsupported permission action on the first observable poll" ;;
      todowrite\ permission\ shape*) code=permission-unsupported-shape; summary="blocked an unmeasured todowrite permission shape on the first observable poll" ;;
      *outside*) code=permission-outside-directory; summary="blocked an outside-directory permission on the first observable poll" ;;
      *) code=permission-invalid-response; summary="blocked an invalid or unsupported permission response on the first observable poll" ;;
    esac
    if [ "$code" = transport-failed ]; then
      msg="GLM run stopped: ${err}. This is a LOCAL transport failure, not a permission
       problem: the wrapper never received a permission request, so nothing was refused.
       $(permission_diagnostic "$HTTP_STATUS" "$mode" "$category" "$HTTP_BODY")
       Check the server first: ai-glm doctor, then ai-glm server status. $guidance."
    else
      msg="GLM permission failed: ${err:-unknown response}${stuck:+ (tool: $stuck)}.
       $(permission_diagnostic "$HTTP_STATUS" "$mode" "$category" "$HTTP_BODY")
       $guidance. For an outside-directory file, place a safe copy under
       the session repository or provide a small safe excerpt, then retry."
    fi
    fail_permission "$impl_meta" "$root" "$code" "$summary" "$msg" \
      "$(permission_failure_detail "${err:-unknown response}" "$HTTP_STATUS" "$mode" "$category" "$HTTP_BODY")"
  fi
  rm -f "${TMPDIR:-/tmp}/ai-glm-perm-err-$$"
  [ -n "$rows" ] || { APPROVED_PERMISSION_IDS=""; return 0; }
  while IFS=$'\t' read -r id action resources; do
    prior="$(printf '%s\n' "$APPROVED_PERMISSION_IDS" | grep -cxF "$id" || true)"
    if [ "$prior" -ge 2 ]; then
      fail_permission "$impl_meta" "$root" permission-approval-ineffective \
        "permission approval for $action remained pending after two follow-up polls" \
        "GLM permission approval did not clear after two polls (action: $action, path: inside).
       $guidance" \
        "$(permission_failure_detail "permission approval did not clear after two polls (action: $action)" \
           "$HTTP_STATUS" "$mode" inside "")"
    fi
    permission_http POST "/api/session/$sid/permission/$id/reply" '{"reply":"always"}'
    case "$HTTP_STATUS" in
      2*) ;;
      000) fail_permission "$impl_meta" "$root" transport-failed \
        "the local OpenCode permission endpoint did not answer the approval reply after ${PERMISSION_HTTP_ATTEMPTS} attempts" \
        "GLM run stopped: local permission endpoint did not answer after ${PERMISSION_HTTP_ATTEMPTS} attempts (${PERMISSION_HTTP_TIMEOUT}s timeout each) while approving action $action.
       This is a LOCAL transport failure, not a permission problem.
       Check the server first: ai-glm doctor, then ai-glm server status. $guidance." \
        "$(permission_failure_detail "local permission endpoint did not answer the approval reply after ${PERMISSION_HTTP_ATTEMPTS} attempts (action: $action)" \
           "$HTTP_STATUS" "$mode" inside "$HTTP_BODY")" ;;
      *) fail_permission "$impl_meta" "$root" permission-approval-failed \
      "permission approval for $action failed on its first reply" \
      "GLM permission approval failed (HTTP $HTTP_STATUS, action: $action, path: inside).
       $(permission_diagnostic "$HTTP_STATUS" "$mode" inside "$HTTP_BODY")
       $guidance" \
      "$(permission_failure_detail "permission approval reply failed (action: $action)" \
         "$HTTP_STATUS" "$mode" inside "$HTTP_BODY")" ;;
    esac
    APPROVED_PERMISSION_IDS="${APPROVED_PERMISSION_IDS}${id}"$'\n'
  done <<< "$rows"
}

last_assistant() { # -> JSON of the newest assistant message
  api GET "/api/session/$1/message?limit=1" | jq -c '.data[0] // {}'
}

running_tools() {
  printf '%s' "$1" | jq -r '[.content[]? | select(.type=="tool" and .state.status=="running") | .name] | join(", ")'
}

send_prompt() { # send_prompt SID PROMPT_FILE
  local sid="$1" pf="$2" body
  body="$(mktemp)"
  jq -Rs '{prompt:{text:.}}' < "$pf" > "$body"
  api POST "/api/session/$sid/prompt" "$body" > /dev/null
  rm -f "$body"
}

# Stamp last_activity_at while a turn is still in flight. Best effort by design: a
# liveness stamp must never be able to fail a review, so every error is swallowed.
LIVENESS_SIG=""
touch_liveness() { # touch_liveness ASSISTANT_JSON
  [ -n "$TURN_META" ] || return 0
  [ -f "$TURN_META" ] || return 0
  local sig now tmp progressed=false
  sig="$(printf '%s' "${1:-}" | sha256sum 2>/dev/null | cut -c1-16)"
  if [ -n "$sig" ] && [ "$sig" != "$LIVENESS_SIG" ]; then
    LIVENESS_SIG="$sig"; progressed=true
  fi
  now="$(date -u +%FT%TZ)"
  tmp="$(mktemp "$(dirname "$TURN_META")/.tmp.XXXXXX" 2>/dev/null)" || return 0
  if jq --arg ts "$now" --argjson prog "$progressed"        '.last_poll_at=$ts | if $prog then .provider_progress_at=$ts | .last_activity_at=$ts else . end'        "$TURN_META" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$TURN_META" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  return 0
}

await_turn() { # await_turn SID NAME MODE SESSION_DIR [IMPLEMENTATION_META] -> assistant JSON
  local sid="$1" name="$2" mode="$3" root="$4" impl_meta="${5:-}" waited=0 idle=0 msg finish stuck
  APPROVED_PERMISSION_IDS=""
  sleep 6
  while [ "$waited" -lt "$TIMEOUT" ]; do
    handle_permissions "$sid" "$name" "$mode" "$root" "$impl_meta"
    if api GET /session/status | grep -q "$sid"; then
      idle=0
    else
      idle=$((idle + 1))
    fi
    msg="$(last_assistant "$sid")"
    # LIVENESS -- stamped from the ASSISTANT MESSAGE, not from /session/status.
    # A first attempt hooked this to the `idle=0` branch above and DID NOT WORK: on a
    # real review /session/status returned `{}` for the whole turn, so that branch never
    # ran and the field stayed frozen at creation time. Measured, not assumed.
    # The message digest is the signal that actually moves while the model produces
    # output, so `provider_progress_at` means "the provider emitted something new".
    # `last_poll_at` is the weaker companion: the wrapper is alive and polling.
    touch_liveness "$msg"
    finish="$(printf '%s' "$msg" | jq -r '.finish // ""')"
    if [ "$finish" = "stop" ] && [ "$idle" -ge 2 ]; then
      printf '%s' "$msg"; return 0
    fi
    if [ -n "$impl_meta" ] && implementation_abort_requested "$impl_meta" && [ "$idle" -ge 2 ]; then
      return 130
    fi
    sleep "$POLL_SECS"
    waited=$((waited + POLL_SECS))
  done
  msg="$(last_assistant "$sid")"
  stuck="$(running_tools "$msg")"
  finish="$(printf '%s' "$msg" | jq -r '.finish // "none"')"
  if [ -n "$impl_meta" ]; then
    implementation_update "$impl_meta" \
      '.failure="turn-timeout" | .failure_summary="turn deadline passed without proven completion" |
       .failure_detected_at=$now' --arg now "$(date -u +%FT%TZ)" || return 1
    return 124
  fi
  die "GLM turn did not complete within ${TIMEOUT}s (last finish='$finish'${stuck:+, tool still running: $stuck}).
       Run: ai-glm abort $2"
}

msg_text()   { printf '%s' "$1" | jq -r '[.content[]? | select(.type=="text") | .text] | join("\n")'; }
msg_tokens() { printf '%s' "$1" | jq -c '.tokens // null'; }

# --------------------------------------------------------------------------------
# Reports
# --------------------------------------------------------------------------------
write_report() { # write_report ROOT NAME KIND TEXT TOKENS SID
  local root="$1" name="$2" kind="$3" text="$4" tokens="$5" sid="$6" ts f branch ver
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  f="$root/.ai/reviews/glm-$name-$ts.md"
  mkdir -p "$(dirname "$f")"
  branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  ver="$( (api GET /global/health | jq -r .version) 2>/dev/null || echo '?')"
  {
    printf '# GLM %s — %s\n\n' "$kind" "$name"
    printf '| field | value |\n|---|---|\n'
    printf '| model | %s/%s |\n' "$PROVIDER" "$MODEL"
    printf '| opencode | %s (pinned) |\n' "$ver"
    printf '| session | %s |\n' "$name"
    printf '| session id | `%s` |\n' "$sid"
    printf '| repository | %s |\n' "$root"
    printf '| branch | %s |\n' "$branch"
    printf '| caller | %s |\n' "$CALLER"
    printf '| requested | %s |\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '| tokens | `%s` |\n\n' "$tokens"
    printf -- '---\n\n%s\n' "$text"
  } > "$f"
  printf '%s' "$f"
}

emit() { # emit NAME KIND SID TEXT TOKENS REPORT
  if [ "$JSON_OUT" = 1 ]; then
    jq -n --arg name "$1" --arg kind "$2" --arg sid "$3" --arg text "$4" \
          --argjson tokens "${5:-null}" --arg report "$6" \
          --arg model "$PROVIDER/$MODEL" --arg caller "$CALLER" \
      '{schema_version:1, ok:true,
        session:{name:$name, type:$kind, id:$sid, caller:$caller, model:$model},
        response:{text:$text}, usage:$tokens, artifacts:{report:$report}}'
  else
    printf '%s\n' "$4"
    printf '\n--- session: %s (%s)  model: %s/%s  tokens: %s\n--- report: %s\n' \
      "$1" "$2" "$PROVIDER" "$MODEL" "${5:-null}" "$6" >&2
  fi
}

# --------------------------------------------------------------------------------
# Prompt input
# --------------------------------------------------------------------------------
read_prompt() { # read_prompt -> path to a temp file holding the prompt
  local f
  [ -z "$PROMPT_FILE" ] || [ -f "$PROMPT_FILE" ] || die "prompt file not found: $PROMPT_FILE"
  [ -n "$PROMPT_TEXT" ] || [ -n "$PROMPT_FILE" ] || [ ! -t 0 ] || die "provide a prompt: --prompt TEXT, --prompt-file FILE, or stdin."
  f="$(mktemp)"
  if [ -n "$PROMPT_TEXT" ]; then
    printf '%s' "$PROMPT_TEXT" > "$f"
  elif [ -n "$PROMPT_FILE" ]; then
    cat "$PROMPT_FILE" > "$f"
  elif [ ! -t 0 ]; then
    cat > "$f"
  fi
  [ -s "$f" ] || { rm -f "$f"; die "prompt is empty."; }
  printf '%s' "$f"
}

# --------------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------------
create_session() { # create_session TITLE AGENT DIRECTORY -> session id
  local body sid
  body="$(mktemp)"
  jq -n --arg t "$1" --arg a "$2" --arg p "$PROVIDER" --arg m "$MODEL" \
     '{title:$t, agent:$a, model:{providerID:$p, id:$m}}' > "$body"
  sid="$(api POST "/session?directory=$3" "$body" | jq -r '.id // empty')"
  rm -f "$body"
  [ -n "$sid" ] || die "could not create an OpenCode session."
  printf '%s' "$sid"
}

verify_model() { # verify_model MSG_JSON — reject silent provider fallback
  local got
  got="$(printf '%s' "$1" | jq -r '.model.id // ""')"
  [ -z "$got" ] || [ "$got" = "$MODEL" ] || \
    die "requested model '$MODEL' but the provider answered with '$got'. No fallback accepted."
}

cmd_new() {
  local name="$1" root boundary rid mp sid pf msg text tokens report lock
  valid_name "$name" || die "invalid session name '$name' (use letters, numbers, . _ -)"
  require_server
  root="${REPO_OVERRIDE:-$(repo_root)}"
  [ -d "$root/.git" ] || [ -f "$root/.git" ] || die "not a git repository: $root"
  rid="$(repo_id "$root")"; mp="$(meta_path "$rid" "$name")"
  lock="$(lock_path "$rid" "$name")"
  lock_acquire "$lock" "$LOCK_TIMEOUT" || die "session '$name' is busy and did not free up within ${LOCK_TIMEOUT}s."
  [ ! -f "$mp" ] || die "session '$name' already exists for caller '$CALLER' in this repo. Use: ai-glm ask $name"
  pf="$(read_prompt)"
  prepare_review "$root" "$name"   # sets REVIEW_DIR/BASE/HEAD/PACKET_HASH
  boundary="$REVIEW_DIR"
  prefix_packet_preamble "$pf"
  sid="$(create_session "$name" glm-review "$boundary")"
  if ! write_meta "$mp" "$(jq -n --arg n "$name" --arg sid "$sid" --arg r "$root" --arg b "$boundary" --arg remote "$(repo_remote "$root")" --arg rid "$rid" \
      --arg c "$CALLER" --arg m "$MODEL" --arg p "$PROVIDER" --arg ts "$(date -u +%FT%TZ)" \
      --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" --arg pkthash "$PACKET_HASH" \
      '{schema_version:2, name:$n, type:"review", opencode_session_id:$sid, repository_root:$r, boundary_root:$b, repository_remote:$remote,
        repository_id:$rid, caller:$c, agent:"glm-review", provider:$p, model:$m,
        base:$base, head:$head, packet_sha256:$pkthash,
        created_at:$ts, last_activity_at:$ts, status:"active"}')"; then
    api DELETE "/session/$sid" >/dev/null 2>&1 || warn "metadata write failed and server session $sid could not be deleted; remove it explicitly."
    die "could not save local metadata for session '$name'."
  fi
  send_prompt "$sid" "$pf"; rm -f "$pf"
  TURN_META="$mp"
  msg="$(await_turn "$sid" "$name" review "$boundary")"
  TURN_META=""
  verify_model "$msg"
  text="$(msg_text "$msg")"; tokens="$(msg_tokens "$msg")"
  report="$(write_report "$root" "$name" review "$text" "$tokens" "$sid")"
  emit "$name" review "$sid" "$text" "$tokens" "$report"
}

cmd_ask() {
  local name="$1" root boundary rid mp sid pf msg text tokens report before after lock prev_head
  require_server
  root="${REPO_OVERRIDE:-$(repo_root)}"; rid="$(repo_id "$root")"; mp="$(meta_path "$rid" "$name")"
  [ -f "$mp" ] || die "no session '$name' for caller '$CALLER' in this repo. Start one: ai-glm new $name"
  sid="$(jq -r .opencode_session_id "$mp")"
  [ "$(jq -r .type "$mp")" = "review" ] || die "session '$name' is not a review session."
  api GET "/session/$sid" | jq -e .id >/dev/null 2>&1 || \
    die "session '$name' is orphaned: local metadata exists but the OpenCode server has no such session.
       Start a new one (a replacement under the same name would falsely imply continuity):
         ai-glm delete $name && ai-glm new $name ..."
  pf="$(read_prompt)"
  lock="$(lock_path "$rid" "$name")"
  lock_acquire "$lock" "$LOCK_TIMEOUT" || die "session '$name' is busy and did not free up within ${LOCK_TIMEOUT}s.
       If you are sure nothing else is running, remove: $lock"
  before="$(git -C "$root" status --porcelain | { grep -v '^?? \.ai/' || true; } | sha256sum)"
  # Refresh the snapshot so a later turn reviews the CURRENT working tree rather
  # than a stale copy. The snapshot path is deterministic, so the live OpenCode
  # session keeps the directory it was created with.
  prepare_review "$root" "$name"
  boundary="$REVIEW_DIR"
  prev_head="$(jq -r '.head // ""' "$mp")"
  if [ -n "$prev_head" ] && [ "$prev_head" != "$REVIEW_HEAD" ]; then
    warn "the repository moved since session '$name' started.
  reviewed at: $prev_head
  now at     : $REVIEW_HEAD
The earlier evidence is STALE and cannot approve this head. The packet has been
rebuilt for the new head; treat any verdict from this session as applying to
$REVIEW_HEAD only."
  fi
  prefix_packet_preamble "$pf"
  send_prompt "$sid" "$pf"; rm -f "$pf"
  TURN_META="$mp"
  msg="$(await_turn "$sid" "$name" review "$boundary")"
  TURN_META=""
  verify_model "$msg"
  after="$(git -C "$root" status --porcelain | { grep -v '^?? \.ai/' || true; } | sha256sum)"
  if [ "$before" != "$after" ]; then
    write_meta "$mp" "$(jq '.status="failed"' "$mp")"
    die "review session '$name' CHANGED the working tree. Review mode must be read-only.
       The session is marked failed; inspect 'git status' before doing anything else."
  fi
  write_meta "$mp" "$(jq --arg ts "$(date -u +%FT%TZ)"     --arg base "$REVIEW_BASE" --arg head "$REVIEW_HEAD" --arg pkthash "$PACKET_HASH"     '.last_activity_at=$ts | .base=$base | .head=$head | .packet_sha256=$pkthash' "$mp")"
  text="$(msg_text "$msg")"; tokens="$(msg_tokens "$msg")"
  report="$(write_report "$root" "$name" review "$text" "$tokens" "$sid")"
  emit "$name" review "$sid" "$text" "$tokens" "$report"
}

IMPL_META=""; IMPL_LOCK=""; IMPL_CLONE=""; IMPL_SID=""; IMPL_PF=""; IMPL_CARRY=""
IMPL_FINAL_STATE=""; IMPL_FAILURE=""; IMPL_CLEANING=0; IMPL_PRESERVE_CLONE=0; IMPL_CHANGES_PROVEN=0

implementation_failure_kind() { # FAILURE -> bounded failure kind
  case "$1" in
    usage-limit) printf usage-limit ;;
    turn-timeout) printf timed-out ;;
    transport-failed) printf transport-failed ;;
    permission-*) printf permission-failed ;;
    abort-requested) printf aborted ;;
    interrupted) printf interrupted ;;
    artifact-export-failed) printf artifact-export-failed ;;
    artifact-metadata-failed) printf artifact-metadata-failed ;;
    report-write-failed) printf report-write-failed ;;
    patch-export-failed) printf patch-export-failed ;;
    resource-cleanup-failed) printf resource-cleanup-failed ;;
    owner-process-died) printf owner-process-died ;;
    clone-create-failed) printf wrapper-setup-failed ;;
    *) printf provider-or-service ;;
  esac
}

implementation_failure_family() { # FINAL_STATE FAILURE
  case "$2" in
    usage-limit) printf usage-limit ;;
    turn-timeout) printf timed-out ;;
    permission-*) printf permission-failed ;;
    abort-requested|interrupted) printf aborted ;;
    *) [ "$1" = aborted ] && printf aborted || printf failed ;;
  esac
}

implementation_safe_reason() { # FAILURE
  case "$1" in
    usage-limit) printf 'The provider reported a usage or billing limit.' ;;
    turn-timeout) printf 'The wrapper deadline passed without proven terminal completion.' ;;
    transport-failed) printf 'The local OpenCode permission endpoint never answered, so the run stopped without any permission decision.' ;;
    permission-*) printf 'The wrapper rejected a permission state that was not proven safe.' ;;
    abort-requested) printf 'A named abort was requested for the exact implementation session.' ;;
    interrupted) printf 'The owner process received an interrupt or termination request.' ;;
    *) printf 'GLM did not reach the wrapper required terminal completion state.' ;;
  esac
}

implementation_changed() { # CLONE BASE
  git -C "$1" add -A >/dev/null 2>&1 || return 2
  [ -n "$(git -C "$1" diff --cached --name-only "$2" 2>/dev/null)" ]
}

write_incomplete_artifacts() { # META CLONE FAILURE -> 0 durable, 2 no changes, 1 export failed
  local meta="$1" clone="$2" failure="$3" root name base sid dir ts patch report patch_tmp report_tmp stat family outcome
  implementation_record_path_valid "$meta" && implementation_meta_valid "$meta" || return 1
  root="$(jq -r .repository_root "$meta")"; name="$(jq -r .name "$meta")"; base="$(jq -r .base_sha "$meta")"
  sid="$(jq -r '.opencode_session_id // "unavailable"' "$meta")"
  [ "$(canonical_path "$clone" "$STATE_DIR")" = "$(canonical_path "$(jq -r .clone_path "$meta")" "$STATE_DIR")" ] || return 1
  [ -n "$IMPL_LOCK" ] && [ "$(cat "$IMPL_LOCK/pid" 2>/dev/null || echo '')" = "$$" ] || return 1
  local changed_rc=0
  implementation_changed "$clone" "$base" || changed_rc=$?
  case "$changed_rc" in 0) ;; 1) return 2 ;; *) return 1 ;; esac
  IMPL_CHANGES_PROVEN=1
  test_failure incomplete-destination && return 1
  dir="$root/.ai/reviews"; mkdir -p "$dir" 2>/dev/null || return 1
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  patch="$dir/glm-$name-$ts.incomplete.patch"; report="$dir/glm-$name-$ts.incomplete.md"
  patch_tmp="$(mktemp "$dir/.glm-incomplete-patch.XXXXXX")" || return 1
  report_tmp="$(mktemp "$dir/.glm-incomplete-report.XXXXXX")" || { rm -f "$patch_tmp"; return 1; }
  chmod 0600 "$patch_tmp" "$report_tmp" 2>/dev/null || true
  git -C "$clone" diff --cached --binary "$base" > "$patch_tmp" 2>/dev/null || { rm -f "$patch_tmp" "$report_tmp"; return 1; }
  [ -s "$patch_tmp" ] || { rm -f "$patch_tmp" "$report_tmp"; return 2; }
  stat="$(git -C "$clone" diff --cached --stat "$base" 2>/dev/null | head -40 | cut -c1-240)"
  family="$(implementation_failure_family "${IMPL_FINAL_STATE:-failed}" "$failure")"; outcome="$family-partial"
  {
    printf '# INCOMPLETE GLM implementation - %s\n\n' "$name"
    printf 'This work is INCOMPLETE. It is not proof that the task is correct, tested, or safe.\n\n'
    printf -- '- Job: `%s`\n' "$name"
    printf -- '- OpenCode session ID: `%s`\n' "$sid"
    printf -- '- Repository: `%s`\n' "$root"
    printf -- '- Base SHA: `%s`\n' "$base"
    printf -- '- Requested model: `%s/%s`\n' "$PROVIDER" "$MODEL"
    printf -- '- Terminal outcome: `%s`\n' "$outcome"
    printf -- '- Safe reason: %s\n' "$(implementation_safe_reason "$failure")"
    printf -- '- Provider usage: `unavailable`\n'
    printf -- '- Tests: not confirmed complete\n'
    printf -- '- Patch: `%s`\n\n' "$patch"
    printf '## Changed-file summary\n\n```text\n%s\n```\n\n' "${stat:-Git recorded changes, but no bounded stat text was available.}"
    printf '## Manual inspection\n\n'
    printf '1. Inspect only: `git apply --stat '\''%s'\''`\n' "$patch"
    printf '2. Verify against the captured base: `git apply --check '\''%s'\''`\n' "$patch"
    printf '3. Never apply this incomplete patch without reviewing every change and running the required tests.\n'
  } > "$report_tmp" || { rm -f "$patch_tmp" "$report_tmp"; return 1; }
  test_failure incomplete-move && { rm -f "$patch_tmp" "$report_tmp"; return 1; }
  mv "$patch_tmp" "$patch" || { rm -f "$patch_tmp" "$report_tmp"; return 1; }
  if ! mv "$report_tmp" "$report"; then rm -f "$patch" "$report_tmp"; return 1; fi
  test_failure incomplete-metadata && { rm -f "$patch" "$report"; return 1; }
  if ! implementation_update "$meta" \
      '.outcome=$outcome | .failure_kind=$kind | .incomplete_patch_path=$patch |
       .incomplete_report_path=$report | .patch_path=$patch | .report_path=$report |
       .artifact_state="durable" | .changes_present=true | .patch_exists=true |
       .provider_usage_state="unavailable" | .provider_tokens=null' \
      --arg outcome "$outcome" --arg kind "$(implementation_failure_kind "$failure")" \
      --arg patch "$patch" --arg report "$report"; then
    rm -f "$patch" "$report"; return 1
  fi
  note "INCOMPLETE patch written: $patch"
  note "INCOMPLETE report written: $report"
  note "Inspect only: git apply --stat '$patch'"
  note "Verify only:  git apply --check '$patch'"
  return 0
}

implementation_cleanup() {
  local rc="${1:-1}" clone_state=none session_state=none final="$IMPL_FINAL_STATE" safe=1 terminal_recorded=0 recorded_clone expected_clone lock_pid artifact_rc=2 family outcome kind
  [ "$IMPL_CLEANING" = 0 ] || return 0
  if [ -n "$IMPL_META" ] && [ -f "$IMPL_META" ] &&
     implementation_terminal "$(jq -r '.status // empty' "$IMPL_META" 2>/dev/null)" &&
     ! implementation_cleanup_pending "$IMPL_META"; then
    return 0
  fi
  IMPL_CLEANING=1; trap - EXIT INT TERM HUP
  rm -f "${IMPL_PF:-}" "${IMPL_CARRY:-}" 2>/dev/null || true
  if [ -z "$final" ]; then
    if [ -n "$IMPL_META" ] && implementation_abort_requested "$IMPL_META"; then final=aborted
    else final=failed; fi
  fi
  if [ "$final" != completed ] && [ -n "$IMPL_CLONE" ] && [ -d "$IMPL_CLONE" ] &&
     [ -n "$(jq -r '.clone_path // empty' "$IMPL_META" 2>/dev/null)" ]; then
    set +e
    write_incomplete_artifacts "$IMPL_META" "$IMPL_CLONE" "${IMPL_FAILURE:-turn-failed}"
    artifact_rc=$?
    set -e
    if [ "$artifact_rc" -eq 1 ]; then
      IMPL_PRESERVE_CLONE=1; final=failed; IMPL_FAILURE=artifact-export-failed
      implementation_update "$IMPL_META" \
        '.status="failed" | .outcome="artifact-export-failed" | .failure_kind="artifact-export-failed" |
         .failure="artifact-export-failed" | .artifact_state="failed" |
         .provider_usage_state="unavailable" | .provider_tokens=null | .changes_present=$changes' \
        --argjson changes "$([ "$IMPL_CHANGES_PROVEN" = 1 ] && echo true || echo null)" \
        || warn "artifact export failed and its terminal evidence could not be updated."
      warn "INCOMPLETE artifact export failed. The exact recovery clone was preserved: $IMPL_CLONE"
      warn "Inspect it in place. Do not add a remote or copy it over the real repository."
      warn "After manual recovery, use 'ai-glm show $(jq -r .name "$IMPL_META")' and remove only this recorded clone."
    elif [ "$artifact_rc" -eq 2 ]; then
      family="$(implementation_failure_family "$final" "${IMPL_FAILURE:-turn-failed}")"; outcome="$family-no-changes"
      kind="$(implementation_failure_kind "${IMPL_FAILURE:-turn-failed}")"
      implementation_update "$IMPL_META" \
        '.outcome=$outcome | .failure_kind=$kind | .artifact_state="none" |
         .changes_present=false | .patch_exists=false | .provider_usage_state="unavailable" |
         .provider_tokens=null' --arg outcome "$outcome" --arg kind "$kind" \
        || { safe=0; IMPL_FAILURE=artifact-metadata-failed; }
      note "implementation ended without proven completion and made no changes; no empty patch was created."
    fi
  elif [ "$final" != completed ] && [ -n "$IMPL_META" ] && [ -f "$IMPL_META" ]; then
    family="$(implementation_failure_family "$final" "${IMPL_FAILURE:-turn-failed}")"; outcome="$family-no-changes"
    kind="$(implementation_failure_kind "${IMPL_FAILURE:-turn-failed}")"
    implementation_update "$IMPL_META" \
      '.outcome=$outcome | .failure_kind=$kind | .artifact_state="none" |
       .changes_present=false | .patch_exists=false | .provider_usage_state="unavailable" |
       .provider_tokens=null' --arg outcome "$outcome" --arg kind "$kind" \
      || { safe=0; IMPL_FAILURE=artifact-metadata-failed; }
  fi
  # Dispose the exact server session before clone removal. On Windows, OpenCode keeps
  # file handles below its session directory until deletion, and removing the clone
  # first both fails on long paths and risks racing a still-live tool.
  if [ -n "$IMPL_SID" ]; then
    if server_up && delete_exact_server_session "$IMPL_SID"; then
      session_state=removed
    else
      session_state=failed; safe=0
      warn "implementation server session $IMPL_SID could not be removed; its exact id remains in the job record."
    fi
  fi
  if [ -n "$IMPL_CLONE" ] && [ -e "$IMPL_CLONE" ]; then
    recorded_clone="$(jq -r '.clone_path // empty' "$IMPL_META" 2>/dev/null || true)"
    expected_clone="$(implementation_clone_path "$(jq -r '.repository_id // empty' "$IMPL_META" 2>/dev/null)" "$(jq -r '.name // empty' "$IMPL_META" 2>/dev/null)")"
    lock_pid="$(cat "$IMPL_LOCK/pid" 2>/dev/null || echo '')"
    if [ "$IMPL_PRESERVE_CLONE" = 1 ]; then
      clone_state=preserved
    elif [ -n "$IMPL_META" ] && implementation_record_path_valid "$IMPL_META" && implementation_meta_valid "$IMPL_META" &&
       [ "$lock_pid" = "$$" ] &&
       [ "$(canonical_path "$expected_clone" "$STATE_DIR")" = "$(canonical_path "$IMPL_CLONE" "$STATE_DIR")" ] &&
       { [ -z "$recorded_clone" ] || [ "$(canonical_path "$recorded_clone" "$STATE_DIR")" = "$(canonical_path "$IMPL_CLONE" "$STATE_DIR")" ]; }; then
      if remove_owned_clone_tree "$IMPL_CLONE"; then clone_state=removed
      else clone_state=failed; safe=0; fi
    else
      clone_state=ambiguous; safe=0
      warn "implementation clone ownership is ambiguous; left untouched: $IMPL_CLONE"
    fi
  fi
  [ "$safe" = 1 ] || { final=failed; IMPL_FAILURE="${IMPL_FAILURE:-resource-cleanup-failed}"; }
  if [ -n "$IMPL_META" ] && [ -f "$IMPL_META" ] && implementation_record_path_valid "$IMPL_META" && implementation_meta_valid "$IMPL_META"; then
    implementation_update "$IMPL_META" \
      '.status=$state | .finished_at=$now | .exit_code=$rc | .failure=$failure |
       .cleanup={clone:$clone,server_session:$session}' \
      --arg state "$final" --arg now "$(date -u +%FT%TZ)" --argjson rc "$rc" \
      --arg failure "$IMPL_FAILURE" --arg clone "$clone_state" --arg session "$session_state" \
      && terminal_recorded=1 || warn "could not record terminal implementation state."
  fi
  if [ "$terminal_recorded" = 1 ]; then
    [ -n "$IMPL_LOCK" ] && lock_release "$IMPL_LOCK"
  else
    warn "implementation lock retained so doctor can reconcile the dead owner safely: $IMPL_LOCK"
  fi
  IMPL_CLEANING=0
}

cmd_implement() {
  local name="$1" root rid mp state msg text tokens patch report base turn_rc
  valid_name "$name" || die "invalid session name '$name'"
  require_server
  root="${REPO_OVERRIDE:-$(repo_root)}"; rid="$(repo_id "$root")"
  base="$(git -C "$root" rev-parse HEAD 2>/dev/null)" || die "repository has no commits yet; commit something first."
  mp="$(meta_path "$rid" "$name")"; IMPL_LOCK="$(lock_path "$rid" "$name")"
  if ! implementation_lock_acquire "$IMPL_LOCK"; then
    state="$(jq -r '.status // "unknown"' "$mp" 2>/dev/null || echo unknown)"
    die "implementation job '$name' is already $state. No clone, server session, or provider turn was created."
  fi
  if [ -f "$mp" ]; then
    implementation_record_path_valid "$mp" && implementation_meta_valid "$mp" "$root" || die "implementation record '$mp' is malformed; refusing to overwrite or clean it."
    state="$(jq -r .status "$mp")"
    implementation_active "$state" && die "implementation job '$name' is already $state. Inspect it with: ai-glm show $name"
    die "implementation job '$name' is $state. Clear it before safe reuse: ai-glm delete $name"
  fi
  IMPL_META="$mp"; IMPL_CLONE="$(implementation_clone_path "$rid" "$name")"
  write_meta "$IMPL_META" "$(jq -n --arg n "$name" --arg r "$root" --arg remote "$(safe_repo_remote "$root")" \
      --arg rid "$rid" --arg c "$CALLER" --arg b "$base" --arg ts "$(date -u +%FT%TZ)" --argjson pid "$$" \
      --arg provider "$PROVIDER" --arg model "$MODEL" \
      '{schema_version:3,name:$n,type:"implementation",repository_root:$r,repository_remote:$remote,
        repository_id:$rid,caller:$c,agent:"glm-implement",provider:$provider,model:$model,
        base_sha:$b,owner_pid:$pid,created_at:$ts,updated_at:$ts,status:"starting",
        clone_path:null,opencode_session_id:null,patch_path:null,report_path:null,
        finished_at:null,exit_code:null,failure:null,failure_summary:null,
        failure_detail:null,
        failure_detected_at:null,changes_present:null,patch_exists:null,
        outcome:null,failure_kind:null,incomplete_patch_path:null,incomplete_report_path:null,
        artifact_state:"pending",provider_usage_state:"pending",provider_tokens:null,
        cleanup:{clone:"pending",server_session:"pending"}}')" \
    || die "could not save implementation job record '$mp'."
  implementation_meta_valid "$IMPL_META" "$root" || die "new implementation record failed validation."
  trap 'implementation_cleanup "$?"' EXIT
  trap 'IMPL_FAILURE="interrupted"; IMPL_FINAL_STATE="aborted"; exit 130' INT TERM HUP
  test_pause record
  implementation_abort_requested "$IMPL_META" && { IMPL_FINAL_STATE=aborted; return 130; }
  IMPL_PF="$(read_prompt)"
  mkdir -p "$(dirname "$IMPL_CLONE")"
  [ ! -e "$IMPL_CLONE" ] || die "canonical implementation clone already exists without a reusable job: $IMPL_CLONE"
  if test_failure clone-create; then
    mkdir -p "$IMPL_CLONE"; printf 'partial clone fixture\n' > "$IMPL_CLONE/.partial-clone"
    IMPL_FAILURE=clone-create-failed
    die "simulated partial clone creation failure"
  fi
  if ! git -c core.longpaths=true clone --quiet --no-hardlinks "$root" "$IMPL_CLONE" 2>/dev/null; then
    IMPL_FAILURE=clone-create-failed
    die "could not create the GLM sandbox at $IMPL_CLONE"
  fi
  git -C "$IMPL_CLONE" checkout --quiet --detach "$base" 2>/dev/null || die "could not check out $base in the sandbox"
  git -C "$IMPL_CLONE" remote remove origin >/dev/null 2>&1 || true
  implementation_update "$IMPL_META" '.clone_path=$clone' --arg clone "$IMPL_CLONE" || die "could not attach the clone to the implementation record."
  test_pause clone
  implementation_abort_requested "$IMPL_META" && { IMPL_FINAL_STATE=aborted; return 130; }
  IMPL_CARRY="$(mktemp)"
  git -C "$root" diff HEAD > "$IMPL_CARRY" 2>/dev/null || true
  [ -s "$IMPL_CARRY" ] && git -C "$IMPL_CLONE" apply "$IMPL_CARRY" 2>/dev/null
  rm -f "$IMPL_CARRY"; IMPL_CARRY=""
  cat >> "$IMPL_CLONE/.git/info/exclude" <<'EXCL'
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.venv/
venv/
dist/
build/
target/
*.log
EXCL
  IMPL_SID="$(create_session "$name (implement)" glm-implement "$IMPL_CLONE")"
  if test_failure session-metadata; then
    delete_exact_server_session "$IMPL_SID" || true
    die "simulated implementation metadata failure"
  fi
  implementation_update "$IMPL_META" '.opencode_session_id=$sid | .status="running"' --arg sid "$IMPL_SID" || {
    delete_exact_server_session "$IMPL_SID" || true
    die "could not attach the server session to the implementation record."
  }
  test_pause session
  implementation_abort_requested "$IMPL_META" && { IMPL_FINAL_STATE=aborted; return 130; }
  send_prompt "$IMPL_SID" "$IMPL_PF"; rm -f "$IMPL_PF"; IMPL_PF=""
  set +e
  msg="$(await_turn "$IMPL_SID" "$name" implement "$IMPL_CLONE" "$IMPL_META")"; turn_rc=$?
  set -e
  if [ "$turn_rc" -ne 0 ]; then
    if [ "$turn_rc" -eq 130 ] || implementation_abort_requested "$IMPL_META"; then
      IMPL_FINAL_STATE=aborted; IMPL_FAILURE="abort-requested"; return 130
    fi
    if [ "$(jq -r '.failure // empty' "$IMPL_META" 2>/dev/null)" = turn-timeout ]; then
      IMPL_FAILURE=turn-timeout
    elif server_up; then
      msg="$(last_assistant "$IMPL_SID" 2>/dev/null || printf '{}')"
      if printf '%s' "$msg" | jq -r '[.content[]? | select(.type=="text") | .text] | join(" ")' 2>/dev/null |
         grep -Eqi 'usage limit reached|billing (cycle|limit)|quota (reached|exceeded)'; then
        IMPL_FAILURE=usage-limit
      elif [ "$(jq -r '.status // empty' "$IMPL_META" 2>/dev/null)" = failed ]; then
        IMPL_FAILURE="$(jq -r '.failure // "turn-failed"' "$IMPL_META")"
      else
        IMPL_FAILURE=turn-failed
      fi
    elif [ "$(jq -r '.status // empty' "$IMPL_META" 2>/dev/null)" = failed ]; then
      IMPL_FAILURE="$(jq -r '.failure // "turn-failed"' "$IMPL_META")"
    else
      IMPL_FAILURE="turn-failed"
    fi
    return "$turn_rc"
  fi
  verify_model "$msg"
  test_pause completed-turn
  git -C "$IMPL_CLONE" add -A >/dev/null 2>&1 || true
  patch="$root/.ai/reviews/glm-$name-$(date -u +%Y%m%dT%H%M%SZ).patch"
  mkdir -p "$(dirname "$patch")"
  text="$(msg_text "$msg")"; tokens="$(msg_tokens "$msg")"
  if test_failure patch || ! git -C "$IMPL_CLONE" diff --cached --binary "$base" > "$patch"; then
    rm -f "$patch"; IMPL_FAILURE="patch-export-failed"
    report="$(write_report "$root" "$name" "implementation failure" "$text

Patch export failed. No patch path was recorded. The terminal job record retains this
GLM response and the exact failure reason; the disposable clone is still cleaned safely.
" "$tokens" "$IMPL_SID")" || return 1
    implementation_update "$IMPL_META" '.report_path=$report' --arg report "$report" || return 1
    return 1
  fi
  report="$(write_report "$root" "$name" implement "$text

## Patch

\`$patch\`

\`\`\`
$(git -C "$IMPL_CLONE" diff --cached --stat "$base")
\`\`\`
" "$tokens" "$IMPL_SID")" || { IMPL_FAILURE="report-write-failed"; return 1; }
  implementation_update "$IMPL_META" '.patch_path=$patch | .report_path=$report' --arg patch "$patch" --arg report "$report" || {
    IMPL_FAILURE="artifact-metadata-failed"; return 1
  }
  note "Patch written to: $patch"
  note "Apply it only after review:  git apply --check '$patch' && git apply '$patch'"
  emit "$name" implement "$IMPL_SID" "$text" "$tokens" "$report"
  if [ "$tokens" = null ]; then
    implementation_update "$IMPL_META" \
      '.outcome="completed" | .artifact_state="durable" | .changes_present=($changes) |
       .patch_exists=true | .provider_usage_state="unavailable" | .provider_tokens=null' \
      --argjson changes "$([ -s "$patch" ] && echo true || echo false)" || { IMPL_FAILURE="artifact-metadata-failed"; return 1; }
  else
    implementation_update "$IMPL_META" \
      '.outcome="completed" | .artifact_state="durable" | .changes_present=($changes) |
       .patch_exists=true | .provider_usage_state="final" | .provider_tokens=$tokens' \
      --argjson changes "$([ -s "$patch" ] && echo true || echo false)" --argjson tokens "$tokens" \
      || { IMPL_FAILURE="artifact-metadata-failed"; return 1; }
  fi
  IMPL_FINAL_STATE=completed
}

cmd_list() {
  local f
  shopt -s nullglob
  if [ "$JSON_OUT" = 1 ]; then
    jq -s '{schema_version:1, sessions:.}' "$STATE_DIR"/sessions/*/*.json 2>/dev/null || echo '{"schema_version":1,"sessions":[]}'
    return
  fi
  printf '%-24s %-15s %-8s %-16s %-20s %s\n' NAME TYPE CALLER STATUS UPDATED REPOSITORY
  for f in "$STATE_DIR"/sessions/*/*.json; do
    jq -r '[.name,.type,.caller,.status,(.updated_at // .last_activity_at // .created_at // "unknown"),.repository_root]|@tsv' "$f"
  done | awk -F'\t' '{printf "%-24s %-15s %-8s %-16s %-20s %s\n",$1,$2,$3,$4,$5,$6}'
}

find_meta() { # find_meta NAME -> path
  local root rid mp remote cand found="" moved_impl=""
  root="${REPO_OVERRIDE:-$(repo_root)}"; rid="$(repo_id "$root")"; mp="$(meta_path "$rid" "$1")"
  if [ ! -f "$mp" ]; then
    remote="$(repo_remote "$root")"
    [ -n "$remote" ] || die "no session '$1' for caller '$CALLER' in this repo."
    while IFS= read -r cand; do
      [ "$(jq -r '.name // ""' "$cand")" = "$1" ] || continue
      [ "$(jq -r '.caller // ""' "$cand")" = "$CALLER" ] || continue
      if [ "$(jq -r '.type // ""' "$cand")" = implementation ]; then
        [ "$(jq -r '.repository_remote // ""' "$cand")" = "$(safe_repo_remote "$root")" ] || continue
        [ -z "$moved_impl" ] || die "multiple moved-checkout implementation records match '$1'; refusing ambiguity."
        moved_impl="$cand"; continue
      fi
      [ "$(jq -r '.repository_remote // ""' "$cand")" = "$remote" ] || continue
      [ -z "$found" ] || die "multiple moved-checkout records match session '$1'; refusing an ambiguous migration."
      found="$cand"
    done < <(find "$STATE_DIR/sessions" -type f -name "$CALLER--$1.json" 2>/dev/null)
    [ -z "$moved_impl" ] || die "implementation job '$1' belongs to a different checkout path. Inspect or delete it from its recorded repository; one-shot ownership is never migrated."
    [ -z "$found" ] || { mkdir -p "$(dirname "$mp")"; mv "$found" "$mp"; }
  fi
  [ -f "$mp" ] || die "no session '$1' for caller '$CALLER' in this repo."
  printf '%s' "$mp"
}

cmd_show() {
  local mp type; mp="$(find_meta "$1")"; type="$(jq -r '.type // empty' "$mp")"
  if [ "$type" = implementation ]; then
    implementation_record_path_valid "$mp" && implementation_meta_valid "$mp" "" "$CALLER" || die "implementation record '$mp' is malformed; refusing to display it as trusted state."
    jq '{schema_version,name,type,status,repository_root,repository_remote,repository_id,caller,agent,provider,model,
         base_sha,owner_pid,created_at,updated_at,finished_at,clone_path,opencode_session_id,
         patch_path,report_path,exit_code,failure,failure_summary,failure_detail,failure_detected_at,
         outcome,failure_kind,changes_present,patch_exists,incomplete_patch_path,
         incomplete_report_path,artifact_state,provider_usage_state,provider_tokens,cleanup}' "$mp"
  else
    cat "$mp"
  fi
}

cmd_abort() {
  local mp type state sid
  mp="$(find_meta "$1")"; type="$(jq -r '.type // empty' "$mp")"
  if [ "$type" != implementation ]; then
    require_server
    api POST "/session/$(jq -r .opencode_session_id "$mp")/abort" >/dev/null
    note "aborted: $1"; return
  fi
  implementation_record_path_valid "$mp" && implementation_meta_valid "$mp" "" "$CALLER" || die "implementation record '$mp' is malformed; refusing an ambiguous abort."
  state="$(jq -r .status "$mp")"
  implementation_active "$state" || die "implementation job '$1' is $state, not active."
  implementation_update "$mp" '.status="abort-requested" | .abort_requested_at=$now' --arg now "$(date -u +%FT%TZ)" \
    || die "could not record the abort request; no server call was made."
  sid="$(jq -r '.opencode_session_id // empty' "$mp")"
  if [ -n "$sid" ]; then
    require_server
    permission_http POST "/session/$sid/abort"
    case "$HTTP_STATUS" in 2*) ;; *) die "abort was recorded, but exact server session $sid returned HTTP $HTTP_STATUS. The owner will clean up conservatively." ;; esac
  fi
  note "abort requested: $1. Its owner process will remove the exact clone and record the terminal result."
}

cmd_diff() {
  local mp; mp="$(find_meta "$1")"
  [ "$(jq -r '.type // empty' "$mp")" = review ] || die "implementation job '$1' is one-shot; inspect its recorded patch path with: ai-glm show $1"
  require_server; api GET "/session/$(jq -r .opencode_session_id "$mp")/diff"
}

cmd_transcript() {
  local mp sid; mp="$(find_meta "$1")"
  [ "$(jq -r '.type // empty' "$mp")" = review ] || die "implementation job '$1' is one-shot and its disposable server session is not a persistent transcript target."
  sid="$(jq -r .opencode_session_id "$mp")"
  require_server
  api GET "/api/session/$sid/message?limit=200" | jq -r '
    .data | reverse | .[] |
    if .type=="user" then "\n### user\n" + (.text // "")
    else "\n### glm\n" + ([.content[]? | select(.type=="text") | .text] | join("\n"))
    end'
}

cmd_delete() {
  local mp sid type state clone root; mp="$(find_meta "$1")"; type="$(jq -r '.type // empty' "$mp")"
  sid="$(jq -r '.opencode_session_id // empty' "$mp")"
  if [ "$type" = implementation ]; then
    implementation_record_path_valid "$mp" && implementation_meta_valid "$mp" "" "$CALLER" || die "implementation record '$mp' is malformed; refusing to delete it."
    state="$(jq -r .status "$mp")"; clone="$(jq -r '.clone_path // empty' "$mp")"
    implementation_active "$state" && die "implementation job '$1' is $state. Abort it and wait for a terminal state before deleting it."
    implementation_cleanup_pending "$mp" && die "implementation job '$1' has failed, but its owner has not finished exact cleanup. Wait, then inspect it with: ai-glm show $1"
    [ -z "$clone" ] || [ ! -e "$clone" ] || die "recorded clone still exists at $clone; refusing to erase its ownership record."
    if [ -n "$sid" ] && [ "$(jq -r '.cleanup.server_session // "pending"' "$mp")" != removed ]; then
      server_up || die "the exact server session still needs cleanup, but the server is unavailable. Retry delete after: ai-glm server start"
      delete_exact_server_session "$sid" || die "could not delete exact server session $sid (HTTP $HTTP_STATUS); record preserved."
    fi
  else
    server_up && api DELETE "/session/$sid" >/dev/null 2>&1 || true
  fi
  # Review snapshots are disposable and must not outlive their session.
  if [ "$type" != implementation ]; then
    root="$(jq -r '.repository_root // empty' "$mp")"
    [ -z "$root" ] || [ ! -e "$root" ] || release_boundary "$root" "$1"
  fi
  rm -f "$mp"
  note "deleted session: $1"
}

reconcile_implementation_record() { # conservative dead-owner recovery; never trusts PID alone
  local mp="$1" root rid name caller state pid clone sid lock lock_pid clone_state=none session_state=none
  [ "$(jq -r '.type // empty' "$mp" 2>/dev/null)" = implementation ] || return 0
  root="$(jq -r '.repository_root // empty' "$mp" 2>/dev/null)"
  caller="$(jq -r '.caller // empty' "$mp" 2>/dev/null)"
  if [ -z "$root" ] || [ -z "$caller" ] || ! implementation_record_path_valid "$mp" || ! implementation_meta_valid "$mp" "$root" "$caller"; then
    warn "malformed implementation record left untouched: $mp"; return 1
  fi
  state="$(jq -r .status "$mp")"
  if ! implementation_active "$state"; then
    [ "$state" = failed ] && implementation_cleanup_pending "$mp" || return 0
  fi
  rid="$(jq -r .repository_id "$mp")"; name="$(jq -r .name "$mp")"; pid="$(jq -r .owner_pid "$mp")"
  clone="$(jq -r '.clone_path // empty' "$mp")"; sid="$(jq -r '.opencode_session_id // empty' "$mp")"
  lock="$STATE_DIR/locks/$rid--$caller--$name.lock.d"; lock_pid="$(cat "$lock/pid" 2>/dev/null || echo '')"
  if kill -0 "$pid" 2>/dev/null; then return 0; fi
  if [ ! -d "$lock" ] || [ "$lock_pid" != "$pid" ]; then
    warn "dead implementation owner has ambiguous lock evidence; left untouched: $mp"; return 1
  fi
  if [ -n "$sid" ]; then
    server_up || { warn "dead implementation owner cannot be reconciled while the server is unavailable: $mp"; return 1; }
    permission_http GET "/session/$sid"
    case "$HTTP_STATUS" in
      200)
        permission_http POST "/session/$sid/abort"
        case "$HTTP_STATUS" in 2*) ;; *) warn "exact dead-owner session could not be aborted; left untouched: $sid"; return 1 ;; esac
        permission_http DELETE "/session/$sid"
        case "$HTTP_STATUS" in 2*) session_state=removed ;; *) warn "exact dead-owner session could not be deleted; left untouched: $sid"; return 1 ;; esac
        ;;
      404) session_state=absent ;;
      *) warn "server state for dead implementation owner is ambiguous (HTTP $HTTP_STATUS); left untouched: $mp"; return 1 ;;
    esac
  fi
  if [ -n "$clone" ] && [ -e "$clone" ]; then
    remove_owned_clone_tree "$clone" || { warn "exact dead-owner clone could not be removed: $clone"; return 1; }
    clone_state=removed
  fi
  implementation_update "$mp" \
    '.status="failed" | .finished_at=$now | .exit_code=1 |
     .failure=(.failure // "owner-process-died") |
     .cleanup={clone:$clone,server_session:$session}' \
    --arg now "$(date -u +%FT%TZ)" --arg clone "$clone_state" --arg session "$session_state" \
    || { warn "dead-owner resources were cleaned but terminal metadata could not be written: $mp"; return 1; }
  lock_release "$lock"
  warn "reconciled dead implementation owner for '$name'; terminal record retained."
}

reconcile_implementation_records() {
  local f rc=0
  shopt -s nullglob
  for f in "$STATE_DIR"/sessions/*/*.json; do
    reconcile_implementation_record "$f" || rc=1
  done
  return "$rc"
}

cmd_server() {
  if [ "$IS_WINDOWS" = 1 ]; then
    case "${1:-status}" in
      start)   schtasks //Run    //TN "AiDevOps-OpenCodeGlm" >/dev/null && note "started" ;;
      stop)    schtasks //End    //TN "AiDevOps-OpenCodeGlm" >/dev/null && note "stopped" ;;
      restart) schtasks //End //TN "AiDevOps-OpenCodeGlm" >/dev/null 2>&1 || true
               local waited=0
               # Task Scheduler can stop the Git Bash wrapper while leaving its
               # native OpenCode child alive. Stop only the verified loopback
               # listener; never kill an unrelated process that owns this port.
               set +e
               powershell.exe -NoProfile -Command "\$c=Get-NetTCPConnection -State Listen -LocalAddress 127.0.0.1 -LocalPort $PORT -ErrorAction SilentlyContinue; if (\$c) { \$p=Get-Process -Id \$c.OwningProcess -ErrorAction Stop; if (\$p.ProcessName -notmatch 'opencode') { exit 42 }; Stop-Process -Id \$p.Id -Force }" >/dev/null 2>&1
               local stop_rc=$?
               set -e
               [ "$stop_rc" -ne 42 ] || die "port 127.0.0.1:$PORT belongs to a non-OpenCode process; it was not stopped and the task was not restarted."
               [ "$stop_rc" -eq 0 ] || die "could not inspect or stop the old OpenCode listener; the task was not restarted."
               while powershell.exe -NoProfile -Command "if (Get-NetTCPConnection -State Listen -LocalAddress 127.0.0.1 -LocalPort $PORT -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" >/dev/null 2>&1; do
                 [ "$waited" -lt 30 ] || die "port 127.0.0.1:$PORT stayed busy for 30 seconds; the task was not restarted."
                 sleep 1; waited=$((waited + 1))
               done
               schtasks //Run //TN "AiDevOps-OpenCodeGlm" >/dev/null || die "could not restart AiDevOps-OpenCodeGlm"
               waited=0
               until server_up; do
                 [ "$waited" -lt 30 ] || die "AiDevOps-OpenCodeGlm restarted but did not become healthy within 30 seconds."
                 sleep 1; waited=$((waited + 1))
               done
               note "restarted and healthy" ;;
      status)  schtasks //Query //TN "AiDevOps-OpenCodeGlm" //V //FO LIST 2>/dev/null | head -20
               printf 'health: %s\n' "$(api GET /global/health 2>/dev/null || echo unreachable)" ;;
      *) die "usage: ai-glm server start|stop|restart|status" ;;
    esac
    return
  fi
  case "${1:-status}" in
    start)   systemctl --user start opencode-glm.service;   note "started" ;;
    stop)    systemctl --user stop opencode-glm.service;    note "stopped" ;;
    restart) systemctl --user restart opencode-glm.service; note "restarted" ;;
    status)
      systemctl --user status opencode-glm.service --no-pager || true
      printf 'health: %s\n' "$(api GET /global/health 2>/dev/null || echo unreachable)"
      ;;
    *) die "usage: ai-glm server start|stop|restart|status" ;;
  esac
}

# --------------------------------------------------------------------------------
# doctor
# --------------------------------------------------------------------------------
FAILS=0
chk() { # chk LABEL COMMAND...
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then printf 'PASS  %s\n' "$label"
  else printf 'FAIL  %s\n' "$label"; FAILS=$((FAILS+1)); fi
}
warnchk() {
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then printf 'PASS  %s\n' "$label"; else printf 'WARN  %s\n' "$label"; fi
}

cmd_doctor() {
  local repo_root_dir pinned installed health_ver pw bin_path leaked f
  local -a secret_targets
  # Resolve through the /usr/local/bin symlink, or the repo root would come out as
  # /usr/local and every repo-relative check would fail.
  local self
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  repo_root_dir="$(cd "$(dirname "$self")/.." && pwd)"
  pinned="$(tr -d ' \t\r\n' < "$repo_root_dir/config/opencode/version" 2>/dev/null || echo '')"

  printf 'ai-glm doctor\n\n'

  # Attached to another user's server: the local-installation checks below are
  # about standing a server UP, and this user is not the one who did that. Only
  # reachability and usability matter here. Reporting 17 "failures" for files
  # that were never meant to exist in this home is worse than useless — it reads
  # as "GLM is broken" when GLM is working.
  if [ -n "${OC_SHARED_FROM:-}" ]; then
    printf 'attached to the OpenCode server owned by user "%s"\n' "$OC_SHARED_FROM"
    printf 'credentials: %s\n\n' "$PW_FILE"
    chk "server password readable"         test -s "$PW_FILE"
    if server_up; then
      printf 'PASS  health endpoint answers\n'
      health_ver="$(api GET /global/health 2>/dev/null | jq -r '.version // empty' || true)"
      chk "health version matches pin ($pinned)" test -n "$health_ver" -a "$health_ver" = "$pinned"
      chk "requires authentication"        test "$(curl -sS -o /dev/null -w '%{http_code}' -m 10 "$BASE/global/health")" = "401"
      local providers; providers="$(api GET /config/providers 2>/dev/null || echo '{}')"
      printf '%s' "$providers" | jq -e --arg p "$PROVIDER" '.providers[]|select(.id==$p)' >/dev/null 2>&1 \
        && printf 'PASS  provider %s available\n' "$PROVIDER" \
        || { printf 'FAIL  provider %s available\n' "$PROVIDER"; FAILS=$((FAILS+1)); }
      printf '%s' "$providers" | jq -e --arg p "$PROVIDER" --arg m "$MODEL" \
        '.providers[]|select(.id==$p).models|has($m)' >/dev/null 2>&1 \
        && printf 'PASS  model %s available\n' "$MODEL" \
        || { printf 'FAIL  model %s available\n' "$MODEL"; FAILS=$((FAILS+1)); }
    else
      printf 'FAIL  health endpoint answers\n'; FAILS=$((FAILS+1))
      printf '      the server owned by "%s" is not running. Start it there:\n' "$OC_SHARED_FROM"
      printf '        su - %s -c "ai-glm server start"\n' "$OC_SHARED_FROM"
    fi
    printf '\n'
    if [ "$FAILS" -eq 0 ]; then
      printf 'GLM is usable from this account via user "%s".\n' "$OC_SHARED_FROM"
      return 0
    fi
    printf '%d check(s) FAILED. The server is owned by "%s" — fix it there, not here.\n' "$FAILS" "$OC_SHARED_FROM"
    return 1
  fi

  chk "pinned version file present"        test -n "$pinned"
  chk "launcher installed"                 test -f "$HOME/.local/bin/opencode-glm-launch"
  if [ "$IS_WINDOWS" = 1 ]; then
    # Windows has no Unix wrapper: the launcher execs the pinned binary directly and
    # ai-glm.cmd is what puts the command on PATH.
    chk "ai-glm command installed"         test -f "$HOME/.local/bin/ai-glm.cmd"
    bin_path="$(sed -n 's|^exec "\(.*opencode\.exe\)".*|\1|p' "$HOME/.local/bin/opencode-glm-launch" 2>/dev/null | tail -1 || true)"
  else
    chk "opencode wrapper installed"       test -x "$HOME/.local/bin/opencode-ai-devops"
    bin_path="$HOME/.local/bin/opencode-ai-devops"
  fi
  # Never let a missing binary abort doctor: under `set -e` a failing command
  # substitution here ended the whole report after three lines on Windows.
  installed=""
  if [ -n "${bin_path:-}" ] && [ -f "$bin_path" ]; then
    installed="$("$bin_path" --version 2>/dev/null | tail -1 | tr -d ' \r' || true)"
  fi
  chk "installed binary matches pin ($pinned)" test -n "$installed" -a "$installed" = "$pinned"
  chk "canonical config installed"         test -f "$CFG_DIR/opencode-xdg/opencode/opencode.json"
  chk "review agent installed"             test -f "$CFG_DIR/opencode-xdg/opencode/agent/glm-review.md"
  chk "implement agent installed"          test -f "$CFG_DIR/opencode-xdg/opencode/agent/glm-implement.md"
  chk "review agent has no bash tool"      grep -q '^  bash: false' "$CFG_DIR/opencode-xdg/opencode/agent/glm-review.md"
  chk "implement agent has a bash tool"    grep -q '^  bash: true'  "$CFG_DIR/opencode-xdg/opencode/agent/glm-implement.md"
  chk "server password present"            test -s "$PW_FILE"
  if [ "$IS_WINDOWS" = 1 ]; then
    # Check the real ACL. Anything granting Everyone/Users/Authenticated Users is a fail.
    if command -v icacls >/dev/null 2>&1; then
      if icacls "$(cygpath -w "$PW_FILE" 2>/dev/null || printf '%s' "$PW_FILE")" 2>/dev/null |
         grep -qiE 'Everyone|BUILTIN\\Users|Authenticated Users'; then
        printf 'FAIL  server password is user-only\n'; FAILS=$((FAILS+1))
      else
        printf 'PASS  server password is user-only\n'
      fi
    else
      printf 'WARN  server password is user-only (icacls unavailable, not checked)\n'
    fi
  else
    chk "server password is 0600"          test "$(stat -c '%a' "$PW_FILE" 2>/dev/null)" = "600"
  fi
  chk "1Password CLI present"              command -v op
  chk "service-account token present"      test -s "$CFG_DIR/op-service-account"
  chk "mcp.env present"                    test -f "$CFG_DIR/mcp.env"
  chk "ZAI_API_KEY reference present"      grep -q '^ZAI_API_KEY=' "$CFG_DIR/mcp.env"
  if [ "$IS_WINDOWS" = 1 ]; then
    chk "service wrapper installed"        test -f "$HOME/.local/bin/opencode-glm-service"
    if schtasks //Query //TN "AiDevOps-OpenCodeGlm" >/dev/null 2>&1 ||
       schtasks  /Query  /TN "AiDevOps-OpenCodeGlm" >/dev/null 2>&1; then
      printf 'PASS  scheduled task registered\n'
    else
      printf 'FAIL  scheduled task registered\n'; FAILS=$((FAILS+1))
    fi
    local task_facts
    task_facts="$(powershell.exe -NoProfile -NonInteractive -Command \
      '$t=Get-ScheduledTask -TaskName AiDevOps-OpenCodeGlm -ErrorAction SilentlyContinue; if(-not $t){exit 1}; $i=Get-ScheduledTaskInfo -TaskName AiDevOps-OpenCodeGlm; "state=$($t.State);last=$($i.LastTaskResult)"' \
      2>/dev/null | tr -d '\r' || true)"
    if [ -n "$task_facts" ]; then
      printf 'INFO  scheduled task %s\n' "$task_facts"
      chk "service wrapper retries 3 times at 1 minute" grep -q 'max_attempts=4' "$HOME/.local/bin/opencode-glm-service"
    else
      printf 'FAIL  scheduled task state and recovery policy readable\n'; FAILS=$((FAILS+1))
    fi
  else
    chk "systemd unit installed"           test -f "$HOME/.config/systemd/user/opencode-glm.service"
    chk "service enabled"                  systemctl --user is-enabled opencode-glm.service
    chk "service active"                   systemctl --user is-active opencode-glm.service
    # StartLimitBurst leaves a flapping unit in `failed` where it would sit silently.
    if systemctl --user is-failed opencode-glm.service >/dev/null 2>&1; then
      printf 'FAIL  service is not in a failed state\n'; FAILS=$((FAILS+1))
    else
      printf 'PASS  service is not in a failed state\n'
    fi
  fi
  # A bare "FAIL health endpoint answers" tells you nothing you can act on. When the
  # server is down, say WHY and give the exact next command.
  if server_up; then
    printf 'PASS  health endpoint answers\n'
  else
    printf 'FAIL  health endpoint answers\n'; FAILS=$((FAILS+1))
    if [ "$IS_WINDOWS" = 1 ]; then
      if schtasks //Query //TN "AiDevOps-OpenCodeGlm" >/dev/null 2>&1 ||
         schtasks  /Query  /TN "AiDevOps-OpenCodeGlm" >/dev/null 2>&1; then
        printf '      the scheduled task exists but nothing is listening on %s\n' "$BASE"
        printf '      start it:   ai-glm server start\n'
      else
        printf '      no scheduled task on this machine - setup never finished\n'
        printf '      run:        .\\bin\\setup-opencode-glm.ps1\n'
      fi
      if [ -s "$OC_HOME/server.log" ]; then
        printf '      last lines of %s:\n' "$OC_HOME/server.log"
        tail -n 12 "$OC_HOME/server.log" 2>/dev/null | sed 's/^/        /'
      else
        printf '      no %s yet, so the service has never started\n' "$OC_HOME/server.log"
      fi
    else
      if systemctl --user list-unit-files opencode-glm.service >/dev/null 2>&1; then
        printf '      start it:   ai-glm server start\n'
        journalctl --user -u opencode-glm -n 12 --no-pager 2>/dev/null | sed 's/^/        /'
      else
        printf '      no service on this machine - setup never finished\n'
        printf '      run:        bin/setup-opencode-glm.sh\n'
      fi
    fi
  fi
  if server_up; then
    health_ver="$(api GET /global/health | jq -r .version)"
    chk "health version matches pin"       test "$health_ver" = "$pinned"
    chk "requires authentication"          test "$(curl -sS -o /dev/null -w '%{http_code}' -m 10 "$BASE/global/health")" = "401"
    local providers; providers="$(api GET /config/providers 2>/dev/null || echo '{}')"
    printf '%s' "$providers" | jq -e --arg p "$PROVIDER" '.providers[]|select(.id==$p)' >/dev/null 2>&1 \
      && printf 'PASS  provider %s available\n' "$PROVIDER" \
      || { printf 'FAIL  provider %s available\n' "$PROVIDER"; FAILS=$((FAILS+1)); }
    printf '%s' "$providers" | jq -e --arg p "$PROVIDER" --arg m "$MODEL" \
      '.providers[]|select(.id==$p).models|has($m)' >/dev/null 2>&1 \
      && printf 'PASS  model %s available\n' "$MODEL" \
      || { printf 'FAIL  model %s available\n' "$MODEL"; FAILS=$((FAILS+1)); }
  fi
  # Loopback only. A public bind would expose GLM (and the repo) to the network.
  if [ "$IS_WINDOWS" = 0 ] && command -v ss >/dev/null 2>&1; then
    if ss -ltn 2>/dev/null | grep -q ":$PORT " && ss -ltn 2>/dev/null | grep ":$PORT " | grep -qvE '127\.0\.0\.1|\[::1\]'; then
      printf 'FAIL  server listens ONLY on loopback\n'; FAILS=$((FAILS+1))
    else
      printf 'PASS  server listens only on loopback\n'
    fi
  fi
  if [ "$IS_WINDOWS" = 1 ]; then
    secret_targets=("$HOME/.local/bin/opencode-glm-launch" "$HOME/.local/bin/opencode-glm-service" "$HOME/.local/bin/ai-glm.cmd")
  else
    secret_targets=("$HOME/.config/systemd/user/opencode-glm.service" "$HOME/.local/bin/opencode-glm-launch")
  fi
  leaked=0
  for f in "${secret_targets[@]}"; do
    [ -f "$f" ] || continue
    # The scripts legitimately name the VARIABLES; a leak is an actual key value.
    grep -oE '(ops_|sk-|ghp_)[A-Za-z0-9_-]{20,}' "$f" >/dev/null 2>&1 && leaked=1
  done
  if [ "$leaked" = 0 ]; then printf 'PASS  no secret value in the service files\n'
  else printf 'FAIL  no secret value in the service files\n'; FAILS=$((FAILS+1)); fi
  if [ -d "$CFG_DIR/glm-claude" ]; then
    rm -rf "$CFG_DIR/glm-claude" 2>/dev/null || true
    if [ -d "$CFG_DIR/glm-claude" ]; then
      printf 'FAIL  old glm-claude config removed (could not delete %s)\n' "$CFG_DIR/glm-claude"; FAILS=$((FAILS+1))
    else
      printf 'PASS  old glm-claude config removed (swept just now)\n'
    fi
  else
    printf 'PASS  old glm-claude config removed\n'
  fi
  chk "retired ai-glm-agent fully gone"    bash -c "! command -v ai-glm-agent"
  # Reconcile only records with exact schema, canonical clone, dead owner, matching
  # stale lock, and exact server evidence. Old unrecorded directories have no such
  # ownership proof and must never be swept automatically.
  if reconcile_implementation_records; then
    printf 'PASS  implementation job records reconciled safely\n'
  else
    printf 'WARN  ambiguous implementation job state was preserved; inspect ai-glm list/show\n'
  fi
  if [ -d "$STATE_DIR/wt" ] && [ -n "$(find "$STATE_DIR/wt" -mindepth 2 -maxdepth 2 -type d 2>/dev/null)" ]; then
    printf 'WARN  scratch clones remain under %s/wt; ambiguous or live paths were left untouched\n' "$STATE_DIR"
  else
    printf 'PASS  no unexplained scratch clones\n'
  fi

  printf '\n'
  if [ "$FAILS" -gt 0 ]; then printf '%d check(s) FAILED.\n' "$FAILS"; exit 1; fi
  printf 'All required checks passed.\n'
}

# --------------------------------------------------------------------------------
# Argument parsing. Overrides that would break cache stability or the safety model
# are rejected explicitly rather than ignored.
# --------------------------------------------------------------------------------
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
PROMPT_TEXT=""; PROMPT_FILE=""; REPO_OVERRIDE=""
OPT_BASE=""; OPT_TESTS=""; OPT_DECISION=""; OPT_ASSERT_HEAD=""
CMD="${1:-}"; shift || true
[ -n "$CMD" ] || { usage; return 2; }
ARG=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prompt)       PROMPT_TEXT="${2:-}"; shift 2 ;;
    --prompt-file)  PROMPT_FILE="${2:-}"; shift 2 ;;
    --repo)         REPO_OVERRIDE="$(cd "${2:-}" && pwd)"; shift 2 ;;
    --caller)       CALLER="${2:-}"; shift 2 ;;
    --base)         OPT_BASE="${2:-}"; shift 2 ;;
    --tests)        OPT_TESTS="${2:-}"; shift 2 ;;
    --decision)     OPT_DECISION="${2:-}"; shift 2 ;;
    --assert-head)  OPT_ASSERT_HEAD="${2:-}"; shift 2 ;;
    --json)         JSON_OUT=1; shift ;;
    --timeout)      TIMEOUT="${2:-}"; shift 2 ;;
    --lock-timeout) LOCK_TIMEOUT="${2:-}"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    --model|--agent|--system|--tools|--provider|--mcp|--directory|--temperature|--reasoning)
      die "$1 is not overridable. Model, agent, provider, tools and directory are fixed
       when a session is created: a stable request prefix is what makes prompt caching
       work, and a stable agent is what keeps a review session read-only." ;;
    -*)             die "unknown option: $1" ;;
    *)              [ -n "$ARG" ] && ARG="$ARG $1" || ARG="$1"; shift ;;
  esac
done

case "$CMD" in
  new)        [ -n "$ARG" ] || die "usage: ai-glm new <name> ..."; cmd_new "$ARG" ;;
  ask)        [ -n "$ARG" ] || die "usage: ai-glm ask <name> ..."; cmd_ask "$ARG" ;;
  implement)  [ -n "$ARG" ] || die "usage: ai-glm implement <name> ..."; cmd_implement "$ARG" ;;
  list)       cmd_list ;;
  show)       cmd_show "$ARG" ;;
  transcript) cmd_transcript "$ARG" ;;
  diff)       cmd_diff "$ARG" ;;
  abort)      cmd_abort "$ARG" ;;
  delete)     cmd_delete "$ARG" ;;
  doctor)     cmd_doctor ;;
  server)     cmd_server "$ARG" ;;
  -h|--help|help) usage ;;
  *)          die "unknown command: $CMD (try: ai-glm --help)" ;;
esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
