#!/usr/bin/env bash
# ai-glm: glm second opinion through the shared simple OpenCode path
# (bin/ai-second-opinion, popcre/ai-devops#2074). See its --help.
d="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
py=python3; command -v python3 >/dev/null 2>&1 || py=python
exec "$py" "$d/ai-second-opinion" glm "$@"
