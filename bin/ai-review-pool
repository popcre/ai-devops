#!/usr/bin/env bash
# ai-review-pool — fail-closed approval-gate reviews for the pool providers
# that the reviewer registry carries, including GLM's protected native sessions.
#
# The front door (bin/ai-review) dispatches here after checking
# config/reviewer-registry.json. This adapter mirrors the claude/codex
# wrappers' guarantees with the machinery that is already provider-neutral:
#   - ai-review-packet resolve/build/verify binds the exact source identity
#     (base + assert-head) before and after the paid run;
#   - ai-review-lifecycle begin runs the provider preflight (health and
#     quarantine) and owns terminal accounting;
#   - the session runners (ai-grok-review and siblings) are NOT read-only
#     (owner instruction, issue #974): each may run shell commands, builds,
#     tests and edits, but only inside its own disposable, remote-less copy;
#     the caller's checkout is never written, and packet verify after the run
#     is the source-drift guard;
#   - a verdict is valid only when the report carries a literal
#     "## Verdict" heading with exactly one allowed word AND names the
#     reviewed head SHA, and the report clears a minimum analysis floor.
# Exit status follows the wrapper contract: 0 for any VALID verdict
# (including REJECT); the caller decides what an APPROVE authorizes.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage(){ printf '%s\n' 'Usage: ai-review-pool <grok|muse|qwen|gemini|deepseek|stepfun|glm> <plan-review|diff-review|security-review|final-check> [--tests CMD] [--base REF] [--assert-head SHA] [--force]' '       Env: AI_POOL_RUNNER_<PROVIDER> overrides the session runner for tests.'; }

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  _AI_EVENT_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
  source "$(dirname "$_AI_EVENT_SELF")/../tools/reviewer_event_guard.sh"
fi

VERSION="1.0.0"
MODELS_ENV="${AI_DEVOPS_MODELS_ENV:-/etc/ai-devops/models.env}"
# Every review-critical binary is pinned HERE, before models.env is sourced
# (claude/codex pin their tools the same way): the packet resolver, the
# lifecycle, and the sandbox tool that owns the model's file boundary, the
# drift digest and the copy's lifetime.
PACKET="${AI_REVIEW_PACKET_BIN:-$ROOT/ai-review-packet}"
LIFECYCLE="${AI_REVIEW_LIFECYCLE_BIN:-$ROOT/ai-review-lifecycle}"
SANDBOX="${AI_REVIEW_SANDBOX_BIN:-$ROOT/ai-review-sandbox}"
RUNNER_WAIT_BUDGET="${AI_POOL_RUNNER_WAIT:-1800}"
CALLER="${AI_POOL_CALLER:-zcode}"

die(){ printf 'ai-review-pool: error: %s\n' "$*" >&2; exit 3; }

# Briefs carry reviewer-approval references and reports carry model-quoted source; both
# stay private on a shared machine (the session runners do the same).
umask 077

provider="${1:-}"; mode="${2:-}"
# Legacy session-runner fallback only: a provider registered in
# config/review-runner-doors.json is dispatched through the shared review
# runner below and never reaches these. They stay for the shrunk-registry
# test path and for any provider not yet migrated.
case "$provider" in
  grok)  RUNNER="$ROOT/ai-grok-review";  RUNNER_MAX_TURNS="${AI_POOL_RUNNER_MAX_TURNS:-120}" ;; # same review budget as ai-qwen; 32 ran out on a 48-file change
  muse)  RUNNER="$ROOT/ai-muse";         RUNNER_MAX_TURNS="" ;; # runner owns its budget; no --max-turns flag
  qwen)  RUNNER="$ROOT/ai-qwen";         RUNNER_MAX_TURNS="" ;; # ai-qwen owns its 120-turn/60m review budget and rejects --max-turns
  gemini) RUNNER="$ROOT/ai-gemini";      RUNNER_MAX_TURNS="" ;; # runner owns its budget; no --max-turns flag
  deepseek) RUNNER="$ROOT/ai-review-engine"; RUNNER_MAX_TURNS="" ;; # OpenCode door: no session-runner copy; only the shared runner may dispatch it
  stepfun) RUNNER="$ROOT/ai-stepfun";    RUNNER_MAX_TURNS="" ;; # runner owns its budget; platform rule lives in the door and bin/ai-stepfun
  glm) RUNNER="$ROOT/ai-glm"; RUNNER_MAX_TURNS="" ;; # native wrapper owns model, protected credentials, packet and session budget
  ''|-h|--help|help) usage; [ -n "$provider" ] || exit 0; exit 2 ;;
  *) printf 'ai-review-pool: error: %s is not a pool provider with a session runner.\n' "$provider" >&2; exit 2 ;;
esac
case "$mode" in plan-review|diff-review|security-review|final-check) ;; *) usage >&2; exit 2;; esac
# This adapter is the recorded reviewer wrapper for the dispatched provider
# (same contract as ai-grok-review): the guard records the invocation, re-execs
# this script with the event identity, and the runner invoked below inherits it
# through the guard's parent-match re-entry instead of recording a second one.
# The invocation is recorded BEFORE any shell file is sourced, so unlogged
# code cannot run ahead of the ledger entry (claude's ordering).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  reviewer_event_guard "$provider" "$_AI_EVENT_SELF" "$@"
fi
# models.env may carry provider endpoints as shell assignments. It is sourced
# only AFTER the invocation is recorded, and it can never retarget a
# review-critical binary: AI_POOL_RUNNER_*, AI_REVIEW_ENGINE_BIN and
# AI_REVIEW_SANDBOX_BIN substitutions are TEST HOOKS and require an explicit
# AI_POOL_TEST_HOOKS=1, which the offline suites set. Everything else
# review-critical was pinned above, before this file is sourced. An ungated
# AI_REVIEW_ENGINE_BIN is refused here, before ENGINE is resolved, so a
# wrapper cannot point the runner at a look-alike that skips every governance
# step while still satisfying the door's token check.
for _hook_var in AI_POOL_RUNNER_GROK AI_POOL_RUNNER_MUSE AI_POOL_RUNNER_QWEN AI_POOL_RUNNER_GEMINI AI_POOL_RUNNER_DEEPSEEK AI_POOL_RUNNER_STEPFUN AI_REVIEW_ENGINE_BIN AI_REVIEW_SANDBOX_BIN AI_POOL_RUNNER_GLM; do
  if [ -n "${!_hook_var:-}" ] && [ "${AI_POOL_TEST_HOOKS:-0}" != 1 ]; then
    die "$_hook_var is a test hook; set AI_POOL_TEST_HOOKS=1 to substitute a review binary."
  fi
done
unset _hook_var
# ---------------------------------------------------------------------------
# Passing-report reuse (#1428). The same reviewer re-reviewing the same exact
# source in the same mode spends a full paid review to learn nothing new. When
# the lifecycle store already holds a verified APPROVE from THIS provider for
# this mode, head, whole-source digest, repository and resolved base, print
# that report path and stop before any provider call. --force always
# dispatches. A review operation or a reviewer-approval-governed review asks a
# different question, so neither is ever reused. Every lookup error falls
# through to a normal review and says so; nothing is skipped silently.
# ---------------------------------------------------------------------------
_pool_force=0; _pool_base=""; _pool_assert=""; _pool_args=("${@:3}")
set -- "$provider" "$mode"
_i=0
while [ "$_i" -lt "${#_pool_args[@]}" ]; do
  _a="${_pool_args[$_i]}"
  if [ "$_a" = --force ]; then _pool_force=1; _i=$((_i+1)); continue; fi
  set -- "$@" "$_a"
  case "$_a" in
    --base|--assert-head|--tests)
      if [ $((_i+1)) -lt "${#_pool_args[@]}" ]; then
        _v="${_pool_args[$((_i+1))]}"; set -- "$@" "$_v"
        [ "$_a" != --base ] || _pool_base="$_v"
        [ "$_a" != --assert-head ] || _pool_assert="$_v"
        _i=$((_i+2)); continue
      fi ;;
  esac
  _i=$((_i+1))
done
unset _pool_args _i _a _v
pool_reuse_lookup(){ # 0 = reused (path printed), 2 = no match, other = lookup error
  local repo identity head digest key base="" found report
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  identity="$("$LIFECYCLE" identity "$repo" 2>/dev/null)" || return 1
  head="$(jq -r '.head // empty' <<<"$identity" 2>/dev/null)" || return 1
  digest="$(jq -r '.source_digest // empty' <<<"$identity" 2>/dev/null)" || return 1
  key="$(jq -r '.repository_key // empty' <<<"$identity" 2>/dev/null)" || return 1
  [ -n "$head" ] && [ -n "$digest" ] && [ -n "$key" ] || return 1
  if [ -n "$_pool_assert" ]; then
    [ "$(git -C "$repo" rev-parse --verify --quiet --end-of-options "$_pool_assert^{commit}" 2>/dev/null)" = "$head" ] || return 1
  fi
  if [ -n "$_pool_base" ]; then
    base="$(git -C "$repo" rev-parse --verify --quiet --end-of-options "$_pool_base^{commit}" 2>/dev/null)" || return 1
  fi
  found="$(cd "$repo" && python3 "$ROOT/../tools/reviewer_events.py" find-passing-report "$provider" "$mode" "$head" "$digest" "$key" "$base" "${AI_REVIEW_IMPLEMENTER:-}")" || return 1
  report="$(jq -r '.report // empty' <<<"$found" 2>/dev/null)" || return 1
  [ -n "$report" ] || return 2
  printf 'ai-review-pool: reusing passing %s %s report for head %s (source digest %s); no provider call. Pass --force to review again.\n' "$provider" "$mode" "$head" "$digest" >&2
  printf '%s\n' "$report"
}
if [ "$_pool_force" = 1 ]; then
  printf 'ai-review-pool: --force given; passing-report reuse skipped.\n' >&2
elif [ -z "${AI_REVIEW_OPERATION:-}" ] && [ -z "${AI_REVIEW_REVIEWER_APPROVAL:-}" ]; then
  _reuse_rc=0; pool_reuse_lookup || _reuse_rc=$?
  case "$_reuse_rc" in
    0) exit 0 ;;
    2) ;;
    *) printf 'ai-review-pool: passing-report lookup unavailable; running a normal review.\n' >&2 ;;
  esac
  unset _reuse_rc
fi
# ---------------------------------------------------------------------------
# Structural forcing function (plan_reviewer-pipeline-core §9 Phase D).
# A provider whose door is registered in config/review-runner-doors.json MUST
# be dispatched through the shared review runner (bin/ai-review-engine).
# pool refuses any substitution that would bypass the runner: a library the
# doors may skip is a rejected shape. This is the admission gate that ends the
# copy-paste governance path for migrated doors.
# ---------------------------------------------------------------------------
# AI_REVIEW_ENGINE_BIN was gated above: without AI_POOL_TEST_HOOKS=1 the
# override is refused, and ENGINE is the pinned runner in this tree.
ENGINE="${AI_REVIEW_ENGINE_BIN:-$ROOT/ai-review-engine}"
# The SHIPPED registry is authoritative for which providers are
# runner-managed. AI_REVIEW_RUNNER_DOORS_JSON may extend that set for tests,
# but it can never shrink it: unregistering a migrated door (grok) must not
# drop the structural gate and fall through to the legacy session-runner path.
SHIPPED_DOORS_JSON="$ROOT/../config/review-runner-doors.json"
DOORS_JSON="${AI_REVIEW_RUNNER_DOORS_JSON:-$SHIPPED_DOORS_JSON}"
_runner_door_registered() {
  if [ -f "$SHIPPED_DOORS_JSON" ] && jq -e --arg p "$1" 'has($p)' "$SHIPPED_DOORS_JSON" >/dev/null 2>&1; then
    return 0
  fi
  [ -f "$DOORS_JSON" ] && jq -e --arg p "$1" 'has($p)' "$DOORS_JSON" >/dev/null 2>&1
}
if _runner_door_registered "$provider"; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'must be run inside a Git repository.'
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  # --operation (issue #658) is validated HERE, before the engine is invoked,
  # so an unknown name or a non-final-check mode never dispatches anything.
  if [ -n "${AI_REVIEW_OPERATION:-}" ]; then
    [ "$mode" = final-check ] || die "review operation needs final-check, not $mode."
    # shellcheck source=../tools/lib/review-operation.sh
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools/lib/review-operation.sh" || die 'cannot load the review operation list.'
    review_operation_valid "$AI_REVIEW_OPERATION" || die "unknown review operation: $AI_REVIEW_OPERATION"
    # Host evidence (stale-linux-manifest-recovery) must read before dispatch,
    # same gate as the legacy path: no evidence, no review.
    review_operation_evidence "$AI_REVIEW_OPERATION" >/dev/null || die "cannot read host evidence for review operation: $AI_REVIEW_OPERATION"
  fi
  # AI_POOL_RUNNER_* may only name the engine itself. Anything else is a
  # bypassed review and is refused before any lifecycle state exists.
  _pool_sub_var="AI_POOL_RUNNER_$(printf '%s' "$provider" | tr '[:lower:]' '[:upper:]')"
  if [ -n "${!_pool_sub_var:-}" ]; then
    _sub_real="$(readlink -f "${!_pool_sub_var}" 2>/dev/null || printf '%s' "${!_pool_sub_var}")"
    _engine_real="$(readlink -f "$ENGINE" 2>/dev/null || printf '%s' "$ENGINE")"
    if [ "$_sub_real" != "$_engine_real" ]; then
      die "refusing a $provider review that bypasses the shared review runner (ai-review-engine). ${_pool_sub_var} may only name the engine; use AI_REVIEW_ENGINE_BIN under AI_POOL_TEST_HOOKS=1 to substitute it."
    fi
  fi
  RUNNER="$ENGINE"
  # Forward the remaining options (already validated by the usage contract)
  # to the runner's review contract. The engine owns task gate, identity,
  # sandbox, packet seal + durable store, lifecycle terminal, report floor,
  # and cleanup-after-store; the door supplies provider bits only.
  shift 2
  _engine_args=(review --provider "$provider" --name "pool-${provider}-${mode}" --repo "$REPO_ROOT" --mode "$mode" --caller "$CALLER")
  # Same budget rule as the legacy path: grok's 120-turn default (the env
  # override is already folded into RUNNER_MAX_TURNS) and nothing for runners
  # that own their budget and reject the flag.
  [ -z "$RUNNER_MAX_TURNS" ] || _engine_args+=(--max-turns "$RUNNER_MAX_TURNS")
  # --operation (issue #658) rides the same brief contract through the engine;
  # the core enforces final-check and the exact approval line.
  [ -z "${AI_REVIEW_OPERATION:-}" ] || _engine_args+=(--operation "$AI_REVIEW_OPERATION")
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base|--assert-head|--tests)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value."
        _engine_args+=("$1" "$2"); shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  exec "$RUNNER" "${_engine_args[@]}"
fi
case "$provider" in
  grok)   [ -z "${AI_POOL_RUNNER_GROK:-}" ] || RUNNER="$AI_POOL_RUNNER_GROK" ;;
  muse)   [ -z "${AI_POOL_RUNNER_MUSE:-}" ] || RUNNER="$AI_POOL_RUNNER_MUSE" ;;
  qwen)   [ -z "${AI_POOL_RUNNER_QWEN:-}" ] || RUNNER="$AI_POOL_RUNNER_QWEN" ;;
  gemini) [ -z "${AI_POOL_RUNNER_GEMINI:-}" ] || RUNNER="$AI_POOL_RUNNER_GEMINI" ;;
  stepfun) [ -z "${AI_POOL_RUNNER_STEPFUN:-}" ] || RUNNER="$AI_POOL_RUNNER_STEPFUN" ;;
  glm) [ -z "${AI_POOL_RUNNER_GLM:-}" ] || RUNNER="$AI_POOL_RUNNER_GLM" ;;
esac
[ -f "$MODELS_ENV" ] && . "$MODELS_ENV"
[ -x "$RUNNER" ] || [ -f "$RUNNER" ] || die "session runner not found for $provider: $RUNNER"
# Single expansion: the value is never re-evaluated, and the name is pinned
# by the provider case above.
printf -v _pool_caller_var 'AI_%s_CALLER' "${provider^^}"
export "$_pool_caller_var=$CALLER"; unset _pool_caller_var

shift 2
TESTS_COMMAND=""; OPT_BASE=""; OPT_ASSERT_HEAD=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base|--assert-head)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value."
      if [ "$1" = --base ]; then OPT_BASE="$2"; else OPT_ASSERT_HEAD="$2"; fi
      shift 2;;
    --tests)
      [ -z "$TESTS_COMMAND" ] || die '--tests may be supplied only once.'
      [ "$#" -ge 2 ] && [ -n "$2" ] || die '--tests requires a non-empty command.'
      TESTS_COMMAND="$2"; shift 2;;
    *) die "unknown option: $1";;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'must be run inside a Git repository.'
REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT"
REPORT_DIR="$REPO_ROOT/.ai/reviews"
[ ! -L "$REPO_ROOT/.ai" ] && [ ! -L "$REPORT_DIR" ] || die 'refusing a linked .ai report destination.'
git check-ignore -q .ai/reviews/ai-review-pool-probe || die '.ai/reviews must be Git-ignored.'
mkdir -p "$REPORT_DIR"; [ ! -L "$REPORT_DIR" ] || die 'report destination became a link.'

RUN_ID="$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM"; STARTED="$(date +%s)"
# Runner name limits differ (Muse: 40 characters; Gemini's derived sandbox
# tag: 64). Keep the full run ID in lifecycle/report evidence, but derive a
# short name from the provider, mode, caller and that exact run ID. A rare
# collision still fails closed in the runner's own session reservation.
TAG="pool-${provider}-$(printf '%s' "${provider}-${mode}-${CALLER}-${RUN_ID}" | git hash-object --stdin | cut -c1-16)"
STATE=""; TMP_BRIEF=""; TMP_TEXT=""; TMP_ERR=""; TMP_TESTS=""; TMP_DELETE=""; REVIEW_DIR=""
cleanup(){
  reviewer_event_cleanup_allowed "$provider" || return 1
  [ -z "$TMP_BRIEF" ] || rm -f "$TMP_BRIEF"; [ -z "$TMP_TEXT" ] || rm -f "$TMP_TEXT"
  [ -z "$TMP_ERR" ] || rm -f "$TMP_ERR"; [ -z "$TMP_TESTS" ] || rm -f "$TMP_TESTS"
  [ -z "$TMP_DELETE" ] || rm -f "$TMP_DELETE"
  [ -z "$REVIEW_DIR" ] || "$SANDBOX" remove-copy "$REPO_ROOT" "$TAG" >/dev/null 2>&1 || true
}
# Under set -e a refused cleanup would replace the real exit code (for
# example out-of-credit 92) with 1; on EXIT keep the code the run chose.
trap 'cleanup || true' EXIT
trap cleanup INT TERM

SOURCE_IDENTITY="$("$PACKET" resolve "$REPO_ROOT" ${OPT_BASE:+--base "$OPT_BASE"} ${OPT_ASSERT_HEAD:+--assert-head "$OPT_ASSERT_HEAD"})" || die 'source identity refused before review dispatch.'
STATE="$($LIFECYCLE begin --provider "$provider" --repo "$REPO_ROOT" --run-id "$RUN_ID" --caller "$CALLER" --preflight standard)" || die 'provider preflight failed; no review was assigned.'
# The paid review runs against a DISPOSABLE SNAPSHOT, exactly like the
# claude/codex wrappers: the copy excludes git-ignored files, the session
# runner is launched from inside it, and its digest (baselined AFTER the
# tests command, which may legitimately create artifacts in the copy) is
# compared after the run so a model write invalidates the verdict.
[ -x "$SANDBOX" ] || [ -f "$SANDBOX" ] || die 'sandbox tool not found for the review snapshot.'
REVIEW_DIR="$(AI_REVIEW_SANDBOX_BASE="${OPT_BASE:-}" "$SANDBOX" ensure-copy "$REPO_ROOT" "$TAG")" || {
  "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure snapshot-failed >/dev/null 2>&1 || true
  die 'could not create the review snapshot.'
}
# The sandbox copy carries no remotes; the session runners key their shared
# review locks on the origin URL, so the live origin is propagated into the
# copy. The RAW stored remote is read (`config --get`, never `remote get-url`,
# which expands url.*.insteadOf rewrites that can embed global credentials),
# and ALL userinfo is stripped - to the LAST '@' in the authority, so a
# password containing '@' cannot survive - with the scheme lowercased and
# scp-like users normalized to the conventional 'git@' the lock matcher
# expects. Nothing credential-shaped reaches the model-readable snapshot
# config. Git internals sit outside the snapshot digest by construction.
UPSTREAM_RAW="$(git -C "$REPO_ROOT" config --get remote.origin.url 2>/dev/null || true)"
if [ -n "$UPSTREAM_RAW" ]; then
  case "$UPSTREAM_RAW" in
    *://*)
      _scheme="${UPSTREAM_RAW%%://*}"; _rest="${UPSTREAM_RAW#*://}"
      _authority="${_rest%%/*}"; _path="${_rest#"$_authority"}"
      _authority="${_authority##*@}"; _authority="${_authority,,}"
      UPSTREAM_URL="$(printf '%s://%s%s' "${_scheme,,}" "$_authority" "$_path")" ;;
    *:*)
      # scp-like forms. Any '@' anywhere in the value means userinfo may hide
      # before the host even when it precedes the first colon
      # (user:token@host:path), so everything through the LAST '@' is dropped
      # and the conventional git@ user restored; a bare host:path stays as-is.
      case "$UPSTREAM_RAW" in
        *@*) UPSTREAM_URL="git@${UPSTREAM_RAW##*@}" ;;
        *)   UPSTREAM_URL="$UPSTREAM_RAW" ;;
      esac ;;
    *) UPSTREAM_URL="$UPSTREAM_RAW" ;;
  esac
  unset _scheme _rest _authority _path
  git -C "$REVIEW_DIR" remote remove origin >/dev/null 2>&1 || true
  git -C "$REVIEW_DIR" remote add origin -- "$UPSTREAM_URL" || { die 'could not propagate the upstream into the review snapshot.'; }
fi
REVIEW_HEAD="$(jq -r .head "$STATE")"; REVIEW_DIGEST="$(jq -r .source_digest "$STATE")"
[ -n "$REVIEW_HEAD" ] && [ "$REVIEW_HEAD" != null ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure packet-failed >/dev/null 2>&1 || true; die 'lifecycle state carries no reviewed head.'; }
# The head is later used as a fixed-string match for verdict binding; a
# short or non-hex value would weaken that match to noise, so refuse it here.
[[ "$REVIEW_HEAD" =~ ^[0-9a-f]{40}$ ]] || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure packet-failed >/dev/null 2>&1 || true; die "lifecycle state head is not a full commit SHA: $REVIEW_HEAD"; }

case "$mode" in
  plan-review) DECISION='Judge the implementation plan for missing cases, unsafe assumptions, forgotten files, and test gaps.';;
  diff-review) DECISION='Judge the complete change for correctness, regressions, data exposure, and missing tests.';;
  security-review) DECISION='Judge only security risks: authorization, data leakage, injection, secrets, file boundaries, and permissions.';;
  final-check) DECISION='Give the final go/no-go judgment for shipping this exact source state.';;
esac
if [ -n "${AI_REVIEW_REVIEWER_APPROVAL:-}" ] && [ -f "$AI_REVIEW_REVIEWER_APPROVAL" ]; then DECISION="$DECISION

Assigned AI reviewer approval governing this review: $(basename "$AI_REVIEW_REVIEWER_APPROVAL")"; fi

OPERATION_EVIDENCE=""
if [ -n "${AI_REVIEW_OPERATION:-}" ]; then
  [ "$mode" = final-check ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure packet-failed >/dev/null 2>&1 || true; die "review operation needs final-check, not $mode."; }
  # shellcheck source=../tools/lib/review-operation.sh
  . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools/lib/review-operation.sh" || die 'cannot load the review operation list.'
  OPERATION_EVIDENCE="$(review_operation_evidence "$AI_REVIEW_OPERATION")" || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure packet-failed >/dev/null 2>&1 || true; die "cannot read host evidence for review operation: $AI_REVIEW_OPERATION"; }
  OPERATION_REQUEST="$(review_operation_request "$AI_REVIEW_OPERATION" "$OPERATION_EVIDENCE")" || { "$LIFECYCLE" fail --state "$STATE" --elapsed 0 --failure packet-failed >/dev/null 2>&1 || true; die "unknown review operation: $AI_REVIEW_OPERATION"; }
  DECISION="$DECISION

$OPERATION_REQUEST"
fi
TMP_BRIEF="$(mktemp "$REPORT_DIR/.pool-brief.XXXXXX")"; TMP_TEXT="$(mktemp "$REPORT_DIR/.pool-output.XXXXXX")"; TMP_ERR="$(mktemp "$REPORT_DIR/.pool-stderr.XXXXXX")"
CHANGED_FILES=""
if [ -n "$OPT_BASE" ]; then
  # Use the SHA the packet resolver already proved, never the caller's raw
  # ref string, and never let a dashed value reach git as an option.
  RESOLVED_BASE="$(jq -r '.base // empty' <<<"$SOURCE_IDENTITY" 2>/dev/null || true)"
  [ -n "$RESOLVED_BASE" ] || RESOLVED_BASE="$(git rev-parse --verify --quiet --end-of-options "$OPT_BASE^{commit}" 2>/dev/null || true)"
  if [ -n "$RESOLVED_BASE" ]; then
    CHANGED_FILES="$(git diff --name-only "$RESOLVED_BASE" "$REVIEW_HEAD" -- 2>/dev/null || true)"
  fi
fi
# A --tests command is gate EVIDENCE, operator-supplied like the packet
# builder's --tests. It runs with its WORKING DIRECTORY inside the same
# disposable snapshot (so relative-path effects - fixtures, logs, artifacts -
# land in the copy, git-ignored files are absent, and the live tree's tracked
# state is untouched), but the process itself is an ordinary host shell: it
# retains the caller's uid and environment, so this is a boundary of
# CONVENTION for trusted input, not a sandbox. A nonzero exit refuses the
# dispatch; full output stays local and only the result reaches the brief.
TESTS_RESULT=""
if [ -n "$TESTS_COMMAND" ]; then
  TMP_TESTS="$(mktemp "$REPORT_DIR/.pool-tests.XXXXXX")"
  if ( cd "$REVIEW_DIR" && bash -c "$TESTS_COMMAND" ) > "$TMP_TESTS" 2>&1; then TESTS_RESULT='exit 0 - passed in the review snapshot before dispatch'; else
    rm -f "$TMP_TESTS"
    "$LIFECYCLE" fail --state "$STATE" --elapsed "$(( $(date +%s)-STARTED ))" --failure tests-command-failed >/dev/null 2>&1 || true
    die 'tests command failed; no review was dispatched.'
  fi
fi
cat > "$TMP_BRIEF" <<BRIEF
You are performing a $mode. You MAY run shell commands, builds and tests, and edit files, but only inside your disposable review copy: your edits are discarded and are never part of the change under review. Never commit, push, merge, or touch any remote, the pull-request branch, or any checkout outside your copy. No web search.

Your session harness announces an evidence packet (a sealed snapshot of the repository with a MANIFEST.md and the patch). THAT PACKET is the review subject, and you may read only files inside it - never the live working checkout, whose ignored files are outside this review's boundary. The reviewed head commit is $REVIEW_HEAD and the source digest is $REVIEW_DIGEST; you MUST quote the full reviewed head SHA in your report.$(if [ -n "$CHANGED_FILES" ]; then printf '\n\nThe change under review is exactly these files (read the packet manifest and its patch first, then these files, then only what you need inside the packet to confirm a finding):\n%s' "$CHANGED_FILES"; fi)$([ -n "$TESTS_COMMAND" ] && printf '\n\ntests command on record: %s (executed before dispatch; result: %s)' "$TESTS_COMMAND" "$TESTS_RESULT")

$DECISION

Return ALL findings in one pass, grouped by severity, with file and line evidence; check for sibling issues of the same class before returning. End with a literal heading and one allowed word exactly:

## Verdict
APPROVE|REJECT|BLOCKED
BRIEF

# The review runs inside the disposable snapshot (no live-checkout binding),
# so the durable requirement is recorded without a sandbox ownership marker;
# the runner invoked below records its own nested invocation event.
reviewer_event_evidence require-report "$provider" || die 'could not reserve durable review evidence.'
# Forward the caller's comparison so the runner seals ITS packet against the
# same base and head: a runner left to its own defaults could judge a
# different diff while this adapter's accounting records the caller's.
# Only the grok runner accepts this exact argv today; muse/qwen/gemini fail
# closed on it (unknown flag or name-length limits), which is correct refusal
# rather than an unreviewed dispatch. Per-provider argv shaping is deliberately
# NOT guessed here - each runner's own refusal names what it needs.
RUNNER_ARGS=(new "$TAG" --prompt-file "$TMP_BRIEF")
# Only runners that accept --max-turns (grok) get one; the others reject it.
[ -z "$RUNNER_MAX_TURNS" ] || RUNNER_ARGS+=(--max-turns "$RUNNER_MAX_TURNS")
[ -z "$OPT_BASE" ] || RUNNER_ARGS+=(--base "$OPT_BASE")
[ -z "$OPT_ASSERT_HEAD" ] || RUNNER_ARGS+=(--assert-head "$OPT_ASSERT_HEAD")
# The session runners emit the model's final answer on STDOUT (ai-gemini only
# under its pool contract AI_GEMINI_BODY_STDOUT=1, set below; issue #821) and all
# progress/usage chrome on STDERR (ai-grok-review: note() writes >&2,
# extract_answer writes the body). Capture is split so every verdict gate
# below judges the model body alone and can never be satisfied by chrome.
# The runner is launched FROM the snapshot so its sealed packet, its model
# paths and any write it attempts all stay inside the disposable copy. The
# digest baseline is taken here - after the tests command - so only the
# MODEL's run can move it. The wait budget is raised because snapshot-bound
# reviews read a full tree copy and can outgrow the runner's 900s default.
SNAPSHOT_DIGEST_BEFORE="$("$SANDBOX" digest "$REVIEW_DIR" 2>/dev/null)" || { die 'could not digest the review snapshot.'; }
set +e; ( cd "$REVIEW_DIR" && exec env AI_GROK_WAIT_TIMEOUT="$RUNNER_WAIT_BUDGET" AI_GEMINI_BODY_STDOUT=1 "$RUNNER" "${RUNNER_ARGS[@]}" ) > "$TMP_TEXT" 2> "$TMP_ERR"; PROVIDER_RC=$?; set -e
ELAPSED="$(( $(date +%s)-STARTED ))"
if [ "$PROVIDER_RC" -ne 0 ]; then
  # Provider diagnostics can quote credential-shaped errors (codex's wrapper
  # redacts the same classes before retaining them); redact before echoing.
  sed -E 's/((API[_-]?KEY|TOKEN|SECRET|PASSWORD)[[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig; s/(Bearer[[:space:]]+)[A-Za-z0-9._~+\/-]+/\1[REDACTED]/Ig' "$TMP_ERR" | sed 's/^/  runner: /' >&2 2>/dev/null || true
  # Out of credit (docs/reviewer-rotation-rules.md rule 10) keeps its exit code
  # and both contract lines, unprefixed, so the session tells Albert at once.
  if [ "$PROVIDER_RC" -eq 92 ] && grep -q '^AI_REVIEWER_OUT_OF_CREDIT ' "$TMP_ERR" 2>/dev/null; then
    grep -E '^(AI_REVIEWER_OUT_OF_CREDIT |OUT OF CREDIT: )' "$TMP_ERR" >&2 || true
    "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure out-of-credit --report "$TMP_TEXT" >/dev/null 2>&1 || true
    exit 92
  fi
  # Empty / blocked / no-verdict turns are a REVIEW-STEP failure and reroute
  # (child 1). They must never be booked as provider-failed, which the action
  # taxonomy treats as a `result` and would redden the PR test verdict.
  # The empty-verdict contract is three-part (Codex 2026-10-05): the runner
  # must exit 81, print the AI_REVIEW_EMPTY_VERDICT marker on its own line,
  # AND be a provider whose wrapper defines that contract (ai-gemini's
  # die_empty_verdict). A bare nonzero exit (including 81) is not enough —
  # another provider can exit 81 for an unrelated failure — and neither is a
  # marker-shaped line in unrelated stderr (a diagnostic quoting the
  # contract). All three must hold or the turn stays provider-failed.
  if [ "$PROVIDER_RC" -eq 81 ] && [ "$provider" = gemini ] \
     && grep -q '^AI_REVIEW_EMPTY_VERDICT ' "$TMP_ERR" 2>/dev/null; then
    "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure missing-verdict --report "$TMP_TEXT" >/dev/null 2>&1 || true
    die "$provider returned an empty or blocked verdict; review-step failure, reroute (never a PASS)."
  fi
  "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure provider-failed --report "$TMP_TEXT" >/dev/null 2>&1 || true
  die "$provider runner exited nonzero ($PROVIDER_RC); diagnostic retained in the lifecycle record."
fi
# The snapshot digest covers tracked content, tracked drift and non-ignored
# new files (the runner's gitignored .ai/reports excluded by design), so a
# model write inside the review invalidates the verdict no matter what the
# report claims.
SNAPSHOT_DIGEST_AFTER="$("$SANDBOX" digest "$REVIEW_DIR" 2>/dev/null || true)"
if [ -z "$SNAPSHOT_DIGEST_AFTER" ] || [ "$SNAPSHOT_DIGEST_AFTER" != "$SNAPSHOT_DIGEST_BEFORE" ]; then
  "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure snapshot-drifted --report "$TMP_TEXT" >/dev/null 2>&1 || true
  die 'the review snapshot changed during the review; verdict refused.'
fi
[ -s "$TMP_TEXT" ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure empty-report >/dev/null 2>&1 || true; die "$provider returned an empty report."; }

# The prompt asks for an early provisional verdict and the final verdict LAST
# under a literal heading, so only the last `## Verdict` heading counts for
# providers whose brief uses that shape.  Gemini is the exception: its runner
# (ai-gemini:303) validates the FIRST `## Verdict` block, so the pool must
# agree with that gate or a contradictory body (REJECT first, APPROVE last)
# would be recorded as approval while ai-gemini already accepted the REJECT.
# For Gemini, contradictory verdicts are refused (fail closed).  For other
# providers a provisional-then-final pair is expected; only the last counts.
if [ "$provider" = gemini ]; then
  ALL_VERDICTS="$(awk '/^## Verdict[[:space:]]*$/{getline; gsub(/^[[:space:]]+|[[:space:]]+$/,""); if($0 ~ /^(APPROVE|REJECT|BLOCKED)$/) print}' "$TMP_TEXT")"
  UNIQUE_VERDICTS="$(printf '%s\n' "$ALL_VERDICTS" | sort -u)"
  VERDICT_COUNT="$(printf '%s\n' "$UNIQUE_VERDICTS" | grep -c . || true)"
  if [ "$VERDICT_COUNT" -gt 1 ]; then
    "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure missing-verdict --report "$TMP_TEXT" >/dev/null 2>&1 || true
    die "$provider returned contradictory ## Verdict values; refusing ambiguous verdict."
  fi
  VERDICT_LINE="$(awk '/^## Verdict[[:space:]]*$/{print NR; exit}' "$TMP_TEXT")"
else
  VERDICT_LINE="$(awk '/^## Verdict[[:space:]]*$/{n=NR} END{print n+0}' "$TMP_TEXT")"
fi
VERDICT="$(awk -v n="$VERDICT_LINE" 'n>0 && NR==n+1{gsub(/^[[:space:]]+|[[:space:]]+$/,""); print; exit}' "$TMP_TEXT")"
case "$VERDICT" in APPROVE|REJECT|BLOCKED) ;; *) "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure missing-verdict --report "$TMP_TEXT" >/dev/null 2>&1 || true; die "$provider returned no valid ## Verdict.";; esac
# Binding and the analysis floor are judged on the MODEL BODY - stdout only,
# captured separately from the runner's stderr chrome. The analysis is the
# text on the far side of the verdict block: before a terminal `## Verdict`
# (this brief's shape, which every provider is told to use) or, for Gemini
# only, after a leading one (ai-gemini's non-governed contract requires
# `## Verdict` first and the findings after - ai-gemini:303,383-386). No
# other provider's runner imposes a leading verdict, so for them a leading
# `## Verdict` is just a provisional block and the analysis still sits
# before the final heading. A footer-only body has no analysis on either
# side and is still refused.
FIRST_NONEMPTY="$(awk 'NF{print NR; exit}' "$TMP_TEXT")"
if [ "$provider" = gemini ] && [ "$VERDICT_LINE" -gt 0 ] && [ "${FIRST_NONEMPTY:-0}" -eq "$VERDICT_LINE" ]; then
  ANALYSIS_START="$((VERDICT_LINE + 2))"  # skip the heading and its one verdict word
  ANALYSIS_END=0                          # 0 = through end of body
else
  ANALYSIS_START=1
  ANALYSIS_END="$VERDICT_LINE"            # stop before the final verdict heading
fi
if ! awk -v h="$REVIEW_HEAD" -v s="$ANALYSIS_START" -v e="$ANALYSIS_END" 'NR<s{next} e>0 && NR>=e{exit} index($0, h){found=1} END{exit found?0:1}' "$TMP_TEXT"; then
  "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure verdict-not-bound-to-head --report "$TMP_TEXT" >/dev/null 2>&1 || true
  die "$provider verdict did not name the reviewed head; refusing unbound verdict."
fi
BODY_BYTES="$(awk -v s="$ANALYSIS_START" -v e="$ANALYSIS_END" 'NR<s{next} e>0 && NR>=e{exit} {b += length($0) + 1} END {print b+0}' "$TMP_TEXT")"
[ "$BODY_BYTES" -ge 400 ] || { "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure report-floor --report "$TMP_TEXT" >/dev/null 2>&1 || true; die "$provider analysis body is below the minimum analysis floor (runner chrome excluded)."; }

OUT="$REPORT_DIR/${provider}-${mode}-${RUN_ID}.md"; [ ! -e "$OUT" ] || die "unique report collision: $OUT"
TMP_REPORT="$(mktemp "$REPORT_DIR/.pool-report.XXXXXX")"
{
  printf '# %s pool review — %s\n\n| field | value |\n|---|---|\n' "$provider" "$mode"
  printf '| provider | `%s` |\n| repository | `%s` |\n| reviewed commit | `%s` |\n| source digest | `%s` |\n' "$provider" "$REPO_ROOT" "$REVIEW_HEAD" "$REVIEW_DIGEST"
  [ -z "${AI_REVIEW_OPERATION:-}" ] || printf '| operation | `%s` |\n' "$AI_REVIEW_OPERATION"
  [ -z "${OPERATION_EVIDENCE:-}" ] || printf '%s\n' "$OPERATION_EVIDENCE"
  printf '| run | `%s` |\n| caller | `%s` |\n| elapsed seconds | `%s` |\n| tools | read-only session runner |\n\n## Result\n\n' "$RUN_ID" "$CALLER" "$ELAPSED"
  cat "$TMP_TEXT"
} > "$TMP_REPORT"; [ -s "$TMP_REPORT" ] || die 'report assembly was empty.'; mv "$TMP_REPORT" "$OUT"; TMP_REPORT=""
reviewer_event_publish_report "$provider" "$OUT" || die 'report publication failed; local evidence retained.'

AFTER_IDENTITY="$("$PACKET" resolve "$REPO_ROOT" ${OPT_BASE:+--base "$OPT_BASE"} ${OPT_ASSERT_HEAD:+--assert-head "$OPT_ASSERT_HEAD"})" || AFTER_IDENTITY=""
# The post-review identity gate mirrors the packet verifier's forward-move
# tolerance (plan review-packet-race step B, PR #639): another session
# legitimately landing unrelated work can move the shared target ref (for a
# linked worktree, remote-tracking refs are COMMON to every worktree of the
# repository) while this paid review runs, and a strict whole-string compare
# destroys the completed report for a diff that did not change by one byte
# (#1254: a completed muse APPROVE at head 5b5a9f9 was retained stale when
# origin/main moved forward mid-review). HEAD, digest, base, merge-base and
# every structural field stay STRICT; only the target tip may move, and only
# FORWARD, proven by ancestry in this same repository. A rewrite, a backward
# move, a changed head or a changed digest refuses exactly as before.
identity_stable() { # identity_stable BEFORE_JSON AFTER_JSON REPO
  local before="$1" after="$2" repo="$3" field b_target a_target b_ref a_ref
  if ! { jq -e 'type=="object" and (.head|type=="string")' <<<"$before" >/dev/null 2>&1 && \
         jq -e 'type=="object" and (.head|type=="string")' <<<"$after"  >/dev/null 2>&1; }; then
    # Not a parseable packet identity: keep the strict byte compare.
    [ -n "$after" ] && [ "$after" = "$before" ]
    return
  fi
  for field in repository head source_digest base merge_base rule requested_base; do
    [ "$(jq -r --arg f "$field" '.[$f] // ""' <<<"$before")" = "$(jq -r --arg f "$field" '.[$f] // ""' <<<"$after")" ] || return 1
  done
  b_ref="$(jq -r '.target_ref // ""' <<<"$before")"; a_ref="$(jq -r '.target_ref // ""' <<<"$after")"
  [ "$b_ref" = "$a_ref" ] || return 1
  b_target="$(jq -r '.target // ""' <<<"$before")"; a_target="$(jq -r '.target // ""' <<<"$after")"
  [ "$b_target" = "$a_target" ] && return 0
  [ -n "$b_target" ] && [ -n "$a_target" ] || return 1
  git -C "$repo" merge-base --is-ancestor "$b_target" "$a_target" 2>/dev/null
}
if ! identity_stable "$SOURCE_IDENTITY" "$AFTER_IDENTITY" "$REPO_ROOT"; then
  mv "$OUT" "$OUT.stale" 2>/dev/null || true
  "$LIFECYCLE" fail --state "$STATE" --elapsed "$ELAPSED" --failure source-identity-changed --report "$OUT.stale" >/dev/null 2>&1 || true
  die 'source identity changed during review; paid report retained as stale.'
fi
FINAL_STATE="$($LIFECYCLE finish --state "$STATE" --verdict "$VERDICT" --report "$OUT" --elapsed "$ELAPSED")" || { mv "$OUT" "$OUT.accounting-failed" 2>/dev/null || true; die 'lifecycle accounting failed.'; }
[ "$(jq -r .stale <<<"$FINAL_STATE")" = false ] && [ "$(jq -r .verdict <<<"$FINAL_STATE")" = "$VERDICT" ] || { mv "$OUT" "$OUT.stale" 2>/dev/null || true; die 'source changed during review.'; }
# One-shot runner session release (issue #711 Phase 5, plan "the creating run
# deletes before returning"): once the verdict is accounted, the runner's own
# session-delete path discards the provider session, the runner's working
# copy, and the state-dir meta together — a raw remove-copy would orphan the
# first and last of those. It must run from inside the snapshot, because the
# runner keyed its session on the snapshot's repo identity; the pool EXIT trap
# removes the snapshot itself right after. Best-effort by design, exactly like
# the front-door sweep: a refused cleanup (e.g. unreconciled evidence) retains
# the copy for reconciliation and must never fail a completed review. Only the
# muse runner is wired; the others keep their copy until the sweep (follow-up
# issue: verify each runner's session-delete equivalent before wiring it).
if [ "${AI_KEEP_SANDBOX:-0}" != 1 ]; then
  case "$provider" in
    muse)
      # Everything from here on is post-accounting and best-effort: the review
      # is durable, so no step in this branch may abort (set -e), hang, or
      # otherwise cost the caller its exit 0 and report path. The delete is a
      # provider-facing call, so it gets a hard bound — SIGTERM at 60 s plus
      # kill-after, the same shape bin/ai-deepseek-agent uses — resolved from
      # /usr/bin:/bin only, because an ambient PATH can front Windows
      # timeout.exe (a delay utility that runs no command). No `--` separator:
      # the MSYS timeout rejects it, and $RUNNER is always an absolute path.
      # When no such timeout tool exists, skip the release entirely — the
      # sweep still takes the copy (Qwen round 1 finding 1; Grok round 2
      # findings P1/P2).
      RELEASE_TIMEOUT_BIN="$(PATH=/usr/bin:/bin command -v timeout || true)"
      if [ -z "$RELEASE_TIMEOUT_BIN" ]; then
        printf 'ai-review-pool: no timeout tool to bound the session release; session %s copy retained until sweep.\n' "$TAG" >&2 || true
      else
        TMP_DELETE="$(mktemp "$REPORT_DIR/.pool-release.XXXXXX" 2>/dev/null)" || TMP_DELETE=""
        if ( cd "$REVIEW_DIR" && exec env AI_MUSE_CALLER="$CALLER" "$RELEASE_TIMEOUT_BIN" -k 5 60 "$RUNNER" delete "$TAG" ) >/dev/null 2>>"${TMP_DELETE:-/dev/null}"; then
          :
        else
          { [ -n "$TMP_DELETE" ] && [ -s "$TMP_DELETE" ] && sed -E 's/((API[_-]?KEY|TOKEN|SECRET|PASSWORD)[[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig; s/(Bearer[[:space:]]+)[A-Za-z0-9._~+\/-]+/\1[REDACTED]/Ig' "$TMP_DELETE" | sed 's/^/  runner: /'; } >&2 || true
          printf 'ai-review-pool: muse session release refused; session %s, runner copy muse-%s-%s-*, pool snapshot %s retained until sweep.\n' "$TAG" "$CALLER" "$TAG" "$REVIEW_DIR" >&2 || true
        fi
      fi
      ;;
    *)
      printf 'ai-review-pool: runner session cleanup not yet wired for %s; copy retained until sweep.\n' "$provider" >&2 || true
      ;;
  esac
fi
# The report path stays the final stdout line: merged-output consumers read it
# back-to-front, so the release note must precede it, never follow it.
printf '%s\n' "$OUT"
