#!/usr/bin/env bash
# ai-completion-check-hook — Claude Code Stop hook: the closeout gate.
#
# Why this exists: on 2026-08-26 Albert reported sessions telling him a job was
# finished while authorized work had not been started — "Nothing is needed from
# you now" while a scrape had not begun. The always-loaded rule that was supposed
# to prevent it had been rewritten twice already (#50, #72) and was live on Codex
# when it failed. Wording alone has not held.
#
# This is the mechanical half. When a turn ends on a completion claim, it stops
# once and makes the session account for the deliverables the request named. It
# does not veto: the session answers the question and ends the turn normally.
#
# Deliberately cheap and fail-open:
#   * every turn end runs it, so the no-match path does nothing and exits 0
#   * ANY internal error exits 0 — a broken hook must never wedge a session
#   * it fires at most once per user prompt (see the re-entry guard below), so it
#     cannot loop
#
# A third shape was added 2026-09-24 (#723): a turn that ends holding a
# machine wait ("I'll keep polling the PR") is stopped unless that session
# holds a REGISTERED ai-blocker-watch wait — registration is the default for
# any wait over ~10 minutes, and polling inside the turn is the exception for
# short ones. Human waits ("waiting on Albert") never match.
#
# Full context: plan_completion-honesty-enforcement.md in u2giants/ai-devops.

set -u

payload="$(cat 2>/dev/null || true)"
[[ -n "$payload" ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
session="$(printf '%s' "$payload" | jq -r '.session_id // "nosession"' 2>/dev/null || echo nosession)"
safe_session="$(printf '%s' "$session" | tr -c 'A-Za-z0-9._-' '_')"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ai-devops/completion-check"
action_dir="$state_dir/actions"
action_file="$action_dir/$safe_session"
action_marker="$action_file.action"
case "$event" in
  UserPromptSubmit)
    mkdir -p "$action_dir" 2>/dev/null || exit 0
    rm -f "$action_marker" 2>/dev/null || true
    printf 'no-action\n' >"$action_file.tmp.$$" 2>/dev/null && mv "$action_file.tmp.$$" "$action_file" 2>/dev/null || true
    exit 0 ;;
  PostToolUse)
    mkdir -p "$action_dir" 2>/dev/null || exit 0
    tool_name="$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null || true)"
    case "$tool_name" in
      Write|Edit|MultiEdit|NotebookEdit) action_state=action ;;
      Bash)
        tool_command="$(printf '%s' "$payload" | jq -r '.tool_input.command // .tool_input.cmd // empty' 2>/dev/null || true)"
        if printf '%s' "$tool_command" | grep -Eiq '(^|[;&|[:space:]])(apply_patch|git[[:space:]]+(add|commit|push|merge|rebase|cherry-pick)|pytest|python[[:space:]]+-m[[:space:]]+(pytest|unittest)|npm[[:space:]]+(test|run)|pnpm[[:space:]]+(test|run)|yarn[[:space:]]+(test|run)|bash[[:space:]]+tests/[^;&|[:space:]]*|\./tests/[^;&|[:space:]]*|dotnet[[:space:]]+test|go[[:space:]]+test|cargo[[:space:]]+test|make|cmake[[:space:]]+--build)([;&|[:space:]]|$)'; then
          action_state=action
        else action_state=inspection
        fi ;;
      # Reads, searches, delegated diagnosis, web/connector calls, and unknown
      # future tools do not prove implementation. This avoids a new connector
      # silently becoming a bypass merely because its name is unfamiliar.
      *) action_state=inspection ;;
    esac
    # The separate marker makes action evidence monotonic and race-safe when
    # parallel tool completions arrive together. Inspection may update the
    # diagnostic state file, but it can never remove this marker.
    if [ "$action_state" = action ]; then : > "$action_marker" 2>/dev/null || true; fi
    printf '%s\n' "$action_state" >"$action_file.tmp.$$" 2>/dev/null && mv "$action_file.tmp.$$" "$action_file" 2>/dev/null || true
    exit 0 ;;
  Stop|SubagentStop|"") ;;
  *) exit 0 ;;
esac

# Claude Code sets this while the session is already continuing because of a stop
# hook. Older builds may not send it; the per-prompt guard below covers those.
active="$(printf '%s' "$payload" | jq -r '.stop_hook_active // false' 2>/dev/null || echo false)"
[[ "$active" == "true" ]] && exit 0

# The final assistant text of THIS turn. Documented as the field to use — the
# transcript file is written asynchronously and lags the live conversation.
message="$(printf '%s' "$payload" | jq -r '.last_assistant_message // empty' 2>/dev/null || true)"
[[ -n "$message" ]] || exit 0

# Closing claims that assert the ball is in nobody's court. Kept in one list so
# the set is auditable.
#
# The last five were added on 2026-08-26 after this hook missed the real thing
# twice in one session: a turn closed with "Nothing right now" and another with
# "nothing is waiting on you", and neither matched. It fired on that turn only
# because the reply happened to QUOTE the phrase "nothing is needed" while
# explaining the hook itself. A guard that passes the real case and trips on a
# mention of itself is worse than none, so both halves are fixed here.
COMPLETION_CLAIMS=(
  "nothing is needed"
  "nothing needed from you"
  "nothing further is needed"
  "nothing is pending"
  "no action needed"
  "no action is needed"
  "no further action"
  "you're all set"
  "you are all set"
  "all set"
  "everything is done"
  "everything is complete"
  "fully complete"
  "work is complete"
  "task is complete"
  "nothing right now"
  "nothing is waiting"
  "nothing waiting on you"
  "nothing else is waiting"
  "nothing from you"
)

FUTURE_COMMITMENTS=(
  "i'm proceeding"
  "proceeding now"
  "i will proceed"
  "i'm running"
  "i am running"
  "running now"
  "i'm monitoring"
  "i am monitoring"
  "monitoring now"
  "i'm continuing"
  "i am continuing"
  "continuing now"
  "i'll update you"
  "i will update you"
  "i’ll proceed"
  "i'll proceed"
  "i'll start"
  "i’ll start"
  "i'm going to"
  "i am going to"
  "starting now"
  "next i'll"
  "next i’ll"
  "next i will"
  "i'll come back with"
  "i’ll come back with"
  "kicking off"
  "let me now"
)

# A turn that ENDS holding a machine wait (#723). Under the standing rules a
# wait that may exceed ~10 minutes is REGISTERED with ai-blocker-watch and only
# then does the turn end; a short wait is held inside the turn while the session
# keeps working. A close like "I'll keep polling the PR" is therefore always one
# of two failures: an unregistered wait the wake machinery cannot resume, or a
# turn that should not have ended. Human waits are deliberately NOT here —
# "waiting on Albert" is a named owner in the still-open block, not a pollable
# thing — so every phrase names a machine object or a polling cadence.
WAITING_CLAIMS=(
  "still waiting for the"
  "still waiting on the"
  "keep waiting"
  "keep polling"
  "still polling"
  "polling every"
  "poll again"
  "i'll poll"
  "i will poll"
  "check again in"
  "checking again in"
  "recheck in"
  "rechecking in"
  "checking every"
  "watching until"
  "waiting on the pr"
  "waiting for the pr"
  "waiting on the pull request"
  "waiting for the pull request"
  "waiting on the check"
  "waiting for the check"
  "waiting on ci"
  "waiting for ci"
  "waiting on the review"
  "waiting for the review"
  "waiting on the merge"
  "waiting for the merge"
  "waiting on the queue"
  "waiting for the queue"
  "waiting on the run"
  "waiting for the run"
  "waiting on the workflow"
  "waiting for the workflow"
  "waiting for it to merge"
  "waiting for it to close"
  "waiting for it to land"
  "waiting for it to finish"
)

# Judge how the reply CLOSES, not the whole essay. A completion claim is a way of
# ENDING a turn; the same words in the middle of an explanation are prose. This
# is why the mention-of-itself false positive happened, and it is the same fix
# already applied to the eval's classifier — the two must not drift apart.
closing="$(printf '%s' "$message" | awk 'BEGIN{RS=""} {block[NR]=$0} END{start=(NR>1?NR-1:1); for(i=start;i<=NR;i++) print block[i]}' 2>/dev/null || printf '%s' "$message")"
# Never judge less than the tail: a one-paragraph reply IS its own closing.
[[ -n "$closing" ]] || closing="$message"

matched=""
lower="$(printf '%s' "$closing" | tr '[:upper:]' '[:lower:]')"
for claim in "${COMPLETION_CLAIMS[@]}"; do
  if [[ "$lower" == *"$claim"* ]]; then matched="$claim"; break; fi
done

match_kind="completion"
if [[ -z "$matched" ]]; then
  for commitment in "${FUTURE_COMMITMENTS[@]}"; do
    if [[ "$lower" == *"$commitment"* ]]; then matched="$commitment"; break; fi
  done
  if [[ -n "$matched" ]]; then
    match_kind="future"

    # UserPromptSubmit starts each turn with no action. Read-only inspection does
    # not fulfil a promise to proceed with implementation, while any unknown
    # older-client tool event stays fail-open. Missing event evidence also stays
    # fail-open. Unknown tool kinds are inspection, so adding a connector cannot
    # silently bypass the promise guard.
    [[ -f "$action_file" ]] && [[ ! -f "$action_marker" ]] || exit 0
  else
    for held in "${WAITING_CLAIMS[@]}"; do
      if [[ "$lower" == *"$held"* ]]; then matched="$held"; break; fi
    done
    [[ -n "$matched" ]] || exit 0
    match_kind="waiting"

    # A REGISTERED wait makes this close correct — the watcher owes this
    # session a wake, so the turn SHOULD end. Ask BlockerWatch, locally and
    # without any network call: has-wait exits 0 when the session holds a wait
    # still in flight, 1 when it does not. Anything else (tool absent on this
    # machine, cannot check) fails open — a broken hook must never wedge a
    # session. The sibling script covers a repo checkout; command -v covers
    # the installed copy, which lives without its repo siblings.
    bw_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    bw="${AI_BLOCKER_WATCH_BIN:-$bw_dir/ai-blocker-watch}"
    [ -x "$bw" ] || bw="$(command -v ai-blocker-watch 2>/dev/null || true)"
    if [ -n "$bw" ]; then
      "$bw" has-wait "$session" >/dev/null 2>&1
      brc=$?
      [ "$brc" -eq 1 ] || exit 0
    else
      exit 0
    fi
  fi
fi

# Re-entry guard. One block per user prompt: after firing, the same prompt_id is
# recorded and never blocked again, so the session's next turn ends normally even
# if it repeats the phrase. This is what makes a stop loop impossible on builds
# that do not send stop_hook_active.
prompt="$(printf '%s' "$payload" | jq -r '.prompt_id // empty' 2>/dev/null || true)"
[[ -n "$prompt" ]] || prompt="$(printf '%s' "$message" | cksum 2>/dev/null | tr -d ' \n' || true)"
[[ -n "$prompt" ]] || exit 0

mkdir -p "$state_dir" 2>/dev/null || exit 0
# Session ids are opaque; keep only characters that are safe in a filename.
state_file="$state_dir/$safe_session"

if [[ -f "$state_file" ]] && grep -qxF "$prompt" "$state_file" 2>/dev/null; then
  exit 0
fi
printf '%s\n' "$prompt" >>"$state_file" 2>/dev/null || exit 0
# Keep the file small; only the recent turns of this session matter.
tail -n 50 "$state_file" >"$state_file.tmp" 2>/dev/null && mv "$state_file.tmp" "$state_file" 2>/dev/null || true

if [[ "$match_kind" == "future" ]]; then
  reason="You committed to an action in this reply (\"$matched\") but the turn shows no implementation, test, or other execution action. Either perform it now, or state plainly that it is not started and why."
elif [[ "$match_kind" == "waiting" ]]; then
  reason="This turn ends holding a wait (\"$matched\"). A wait that may exceed ~10 minutes is REGISTERED — ai-blocker-watch wait <owner/repo#N> (--for <owner/repo#M> | --park \"<title>\") --brief-file <file> — and only then does the turn end; the watcher wakes this session when it releases. A short wait is held inside the turn while you KEEP WORKING, never ended on. Subagents register the same way with the session they run in. Waiting on a person instead? Name who and what you need in the still-open block; that is not a registered wait."
else
  reason="This turn ends by claiming completion (\"$matched\"). Before it does: name every deliverable this request asked for and check each one against something real — a file that exists, a command's output, a live result. Preparation is not delivery: groundwork for a deliverable that does not exist yet is PENDING. If any deliverable is unfinished and nothing blocks it, you are already authorized — keep working instead of ending the turn. If everything genuinely checks out, say so again and this will not fire twice."
fi

# Three shapes, one message: hookSpecificOutput is the documented Stop decision
# control, decision/reason is the older form still honored by installed builds,
# and systemMessage surfaces the text either way. Extra keys are ignored.
jq -nc --arg r "$reason" '{
  decision: "block",
  reason: $r,
  systemMessage: $r,
  hookSpecificOutput: {
    hookEventName: "Stop",
    permissionDecision: "deny",
    permissionDecisionReason: $r
  }
}' 2>/dev/null || exit 0

exit 0
