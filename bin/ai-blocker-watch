#!/usr/bin/env bash
# ai-blocker-watch — tell waiting work, and waiting sessions, that a blocker closed.
#
# WHY THIS EXISTS. Shared-db work nests: an application issue waits on an
# orchestrator issue, which waits on a gate bug, which waits on a pull request.
# The only link was prose ("Blocked on #2852"), nothing followed it, and a
# parent resumed only if one session happened to remember it. Sessions in
# Claude, Codex and ZCode sat open for days not knowing their blocker had closed.
#
# Four mechanisms. `tick` (run every few minutes by `schedule`) drives all of
# them; the alarm and link-maintenance parts are interval-gated so a tick stays
# cheap:
#   1. Propagation. Blocking is recorded as GitHub's native "blocked by"
#      dependency. When an issue in a configured repo closes, every OPEN issue
#      it was blocking gets one comment naming the closed blocker. Closing that
#      parent later repeats the step one level up, so a chain unwinds by itself.
#   2. Wake. A session that runs `wait` is registered with its harness, session
#      ID and directory. When its blocker closes, the watcher resumes that exact
#      session headlessly (claude -p --resume / codex exec resume /
#      zcode --resume) with a prompt to recheck and continue.
#   3. Unowned-blocker alarm. A blocker nobody owns stalls every session behind
#      it. Each alarm scan finds OPEN issues that block another OPEN issue yet
#      have no assignee, no `owner:` line, no open linked pull request and no
#      activity (ignoring this tool's own comments) for more than
#      alarm_stall_hours, leaves ONE marked comment asking for an owner, and
#      lists them in a daily digest issue in alarm_digest_repo — blockers
#      holding up a chain alarm_depth_priority or more levels deep first.
#   4. Link maintenance (#596). A shared-db work issue carries a db-work-scope
#      fence whose `depends_on:` line names its blockers as same-repo issue
#      numbers — data the issue already carries, validated by the queue
#      tooling. Each links scan parses that fence on OPEN issues in the
#      configured repos and records every missing native link: present →
#      nothing to do; missing → create it and note it in the tick log. A
#      malformed fence is skipped and counted, never a crash. Links can no
#      longer be forgotten, because sessions were never trusted to record them.
#
# Usage:
#   ai-blocker-watch wait ...
#       Registration is no longer required (coord-del Step 4B). Prints a short
#       note and exits 0. Use bounded `ai-pr-wait` while you remain in the
#       turn; otherwise leave the existing issue or pull request as the card
#       and return later — GitHub notifications are the reminder.
#   ai-blocker-watch find <words...> [--all]
#       Plain-language search of parked and resumed work across the configured
#       owners. --all includes closed issues.
#   ai-blocker-watch has-wait <session-id>
#       Registration is no longer required. Prints a short note and exits 0.
#   ai-blocker-watch link <blocked owner/repo#M> <blocker owner/repo#N>
#   ai-blocker-watch list
#   ai-blocker-watch cancel <wait-id>
#   ai-blocker-watch reap [--dry-run]
#       Archive dead task/session state past its TTL (orphan_ttl_hours):
#       terminal records (woken/failed/unrunnable/orphaned) and interrupted
#       wakes idle longer than the TTL are moved to ~/.ai-devops/blocker-watch/
#       reaped/ with one audit line in reap.log. Live `waiting` records and
#       reviewer leases are never touched; unique uncommitted work is
#       preserved (the worktree is left alone). --dry-run lists decisions.
#   ai-blocker-watch tick [--dry-run]
#   ai-blocker-watch alarm [--dry-run]      scan for unowned blockers now
#   ai-blocker-watch links [--dry-run]      maintain blocked-by links from
#       db-work-scope depends_on fences now
#   ai-blocker-watch schedule | unschedule      (Windows Task Scheduler, or the
#       user crontab on Linux/macOS; both marked, idempotent, safe to re-run)
#
# When a wait is released the watcher picks one of three modes and writes the
# outcome onto the parked issue, swapping its "parked" label for "resumed":
#   resumed  — the original folder and the session transcript both still
#              exist, so that exact session is continued (the most context).
#   fresh    — they are gone, so a NEW headless session starts in the
#              recorded MAIN checkout, reads the parked issue, makes its own
#              worktree from current upstream, and carries on.
#   orphaned — neither is possible. The issue says so and a person must pick
#              it up. That tick exits non-zero.
#
# tick exits non-zero when any propagation, wake, links or alarm scan failed,
# so a scheduled run that did not do its work is visible. Finding stalled
# unowned blockers is NOT a failure. Failed wakes retry on later ticks up to
# max_wake_attempts, then stay in state "failed" for a human. A wake whose
# harness program is not installed on this machine is skipped once with a
# visible error and left in state "unrunnable" — it does not burn retries.
# Propagation (commenting), blocked-by link maintenance (link creation) AND
# the unowned-blocker alarm (request-for-owner comments, the daily digest) run
# on ONE machine only, named by propagate_on_host in the config; every machine
# wakes its own sessions.
#
# ZCode wakes need a one-time CLI sign-in: run zcode.cjs login on each machine.
# On Windows the login URL is TRUNCATED AT '&' when auto-opened, so copy the
# full URL from the terminal into the browser yourself.
#
# Environment:
#   AI_BLOCKER_WATCH_HOME    state (default ~/.ai-devops/blocker-watch)
#   AI_BLOCKER_WATCH_CONFIG  settings (default <repo>/config/blocker-watch.json)
#   AI_BLOCKER_WATCH_TEST_GH  fake GitHub command for explicit test mode only
set -euo pipefail
die(){ printf 'ai-blocker-watch: error: %s\n' "$*" >&2; exit 2; }
note(){ printf 'ai-blocker-watch: %s\n' "$*" >&2; }

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _t="$(readlink "$_self")"
  case "$_t" in /*) _self="$_t" ;; *) _self="$(dirname "$_self")/$_t" ;; esac
done
TOOL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
HOME_DIR="${AI_BLOCKER_WATCH_HOME:-${HOME:?HOME is unavailable}/.ai-devops/blocker-watch}"
CONFIG="${AI_BLOCKER_WATCH_CONFIG:-$TOOL_ROOT/config/blocker-watch.json}"
GH="$TOOL_ROOT/bin/ai-gh"
# A production override could silently send every scheduled read/write around
# the shared quota gate. Only the offline suite may inject a fake transport.
[ -z "${AI_BLOCKER_WATCH_GH:-}" ] || die 'AI_BLOCKER_WATCH_GH is retired; the scheduled transport must use ai-gh'
if [ -n "${AI_BLOCKER_WATCH_TEST_GH:-}" ]; then
  [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] || die 'AI_BLOCKER_WATCH_TEST_GH requires AI_DEVOPS_TEST_MODE=1'
  [ -x "$AI_BLOCKER_WATCH_TEST_GH" ] || die 'test GitHub transport is not executable'
  GH="$AI_BLOCKER_WATCH_TEST_GH"
fi
[ -x "$GH" ] || die 'shared GitHub transport is not executable'
GH_COST_READY=0
if [ "$GH" = "$TOOL_ROOT/bin/ai-gh" ] && [ -f "$TOOL_ROOT/tools/github-requests/telemetry.sh" ]; then
  source "$TOOL_ROOT/tools/github-requests/telemetry.sh"
  GH_COST_READY=1
fi
record_graphql_cost(){
  [ "$GH_COST_READY" = 1 ] || return 0
  printf '%s' "$2" | gh_measure_graphql_cost ai-blocker-watch "$1" "${BW_WORKFLOW:-blocker_watch_manual}" "${BW_TICK_RECEIPT_ID:-}" direct "${BW_TICK_CONTEXT:-}" ||
    note 'request measurement unavailable: GraphQL cost not saved'
}
# Label only the transport subprocess. Resumed AI sessions are independent
# callers and must not inherit BlockerWatch's attribution.
gh_call(){
  # Scheduled ticks run as the "pop-ai-watchers" GitHub App, which has its own
  # hourly allowance, so they never spend the personal allowance interactive
  # sessions need (2026-09-28 exhaustion). Commands a session runs itself (wait,
  # park, find) keep the personal login. No app key on this machine, or no
  # owner in the call, falls back to the personal login: nothing stops.
  local owner tok
  if [ "$BW_APP" = 1 ] && owner="$(gh_owner "$@")" && tok="$("$APP_TOKEN" token "$owner" 2>/dev/null)"; then
    GH_TOKEN="$tok" AI_GH_CALLER=ai-blocker-watch "$GH" "$@"
  else
    AI_GH_CALLER=ai-blocker-watch "$GH" "$@"
  fi
}
# The repository owner a gh call targets (-R/--repo, repos/<owner>/, repo:<owner>/,
# or a GraphQL owner= field). Prints nothing and fails when the call names none.
gh_owner(){
  local a prev='' o=''
  for a in "$@"; do
    case "$prev" in -R|--repo) o="${a%%/*}" ;; esac
    case "$a" in
      repos/*/*) o="${a#repos/}"; o="${o%%/*}" ;;
      owner=*) o="${a#owner=}" ;;
      *repo:*/*) o="${a#*repo:}"; o="${o%%/*}" ;;
    esac
    [ -z "$o" ] || break
    prev="$a"
  done
  [[ "$o" =~ ^[A-Za-z0-9-]+$ ]] && printf '%s\n' "$o"
}
BW_APP=0
APP_TOKEN="$TOOL_ROOT/bin/ai-gh-app-auth"
# Only call sites below set this fixed telemetry label; a parent shell must not
# be able to misclassify unrelated BlockerWatch requests.
unset AI_GH_OPERATION
BW_WORKFLOW=''
BW_TICK_RECEIPT_ID=''
BW_TICK_CONTEXT=''
WAITS="$HOME_DIR/waits"; NOTIFIED="$HOME_DIR/notified.tsv"; SCAN="$HOME_DIR/last-scan"
LAST_ALARM="$HOME_DIR/last-alarm"; LAST_LINKS="$HOME_DIR/last-links"
LOGS="$HOME_DIR/logs"
command -v jq >/dev/null || die "jq is required"
# Windows jq and gh builds can end lines with CR; strip it so values compare cleanly.
jq(){ command jq "$@" | tr -d '\r'; }
[ -f "$CONFIG" ] || die "config not found: $CONFIG"
cfg(){ jq -r "$1" "$CONFIG"; }
mkdir -p "$WAITS" "$LOGS"; touch "$NOTIFIED"

now_iso(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
parse_ref(){ # owner/repo#N -> "owner/repo N"
  [[ "$1" =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]] || die "expected owner/repo#N, got: $1"
  printf '%s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}
gh_api(){ gh_call api "$@" | tr -d '\r'; }

link(){ # link <blocked> <blocker> [blocker id, when already read]
  local br bn kr kn id="${3:-}"
  read -r br bn <<<"$(parse_ref "$1")"; read -r kr kn <<<"$(parse_ref "$2")"
  # Same-tick snapshot already holds open issues' ids and blocked-by edges
  # (#658 P5). A miss is not proof of anything — fall back to REST.
  if [ -z "$id" ] && [ -n "${SNAPIDX[$kr#$kn]+set}" ]; then
    id="${SNAPIDX[$kr#$kn]%%$'\t'*}"
  fi
  [ -n "$id" ] || id="$(AI_GH_OPERATION=bw.link_issue gh_api "repos/$kr/issues/$kn" --jq .id)" || die "cannot read $2"
  note "linking $1 as blocked by $2 on GitHub"
  # SNAPDEP is keyed by blocker: SNAPDEP[blocker] lists the issues it blocks.
  if [ -n "${SNAPREPO[$br]+set}" ]; then
    case "${SNAPDEP[$kr#$kn]:- }" in *" $br#$bn "*)
      note "$1 is already blocked by $2"; return 0 ;;
    esac
  fi
  if AI_GH_OPERATION=bw.link_issue gh_api "repos/$br/issues/$bn/dependencies/blocked_by" --jq '.[].id' | grep -qx "$id"; then
    note "$1 is already blocked by $2"; return 0
  fi
  AI_GH_OPERATION=bw.link_issue gh_api -X POST "repos/$br/issues/$bn/dependencies/blocked_by" -F "issue_id=$id" >/dev/null ||
    die "GitHub refused the link $1 blocked by $2"
  note "recorded: $1 is blocked by $2"
}

ensure_labels(){ # ensure_labels <owner/repo> — labels are cheap and idempotent
  local repo="$1"
  gh_call label create "$(cfg .parked_label)" -R "$repo" --color FBCA04 \
    --description "Waiting on a blocker; BlockerWatch restarts it" >/dev/null 2>&1 || true
  gh_call label create "$(cfg .resumed_label)" -R "$repo" --color 0E8A16 \
    --description "BlockerWatch restarted this parked work" >/dev/null 2>&1 || true
}

cmd_wait(){
  note "registration is no longer required; use bounded ai-pr-wait in-turn, or leave the issue/PR as the card and return later"
  return 0
}

cmd_list(){
  local f any=0
  for f in "$WAITS"/*.json; do [ -e "$f" ] || continue; any=1
    jq -r '[.id, .state, .blocker, .harness, (.for // ""), (.parked_issue // "")] | @tsv' "$f"; done
  [ "$any" = 1 ] || note "no registered waits"
}

cmd_find(){
  local all=0; local -a words=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      -*) die "unknown option: $1" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  [ "${#words[@]}" -gt 0 ] || die "usage: ai-blocker-watch find <words…> [--all]"
  local q="${words[*]}" o
  local -a common=()
  while IFS= read -r o; do [ -z "$o" ] || common+=(--owner "$o"); done < <(cfg '.find_owners[]')
  common+=(--json repository,number,title,state,updatedAt,url --limit 30)
  [ "$all" = 1 ] || common+=(--state open)
  # gh search combines --label with AND, so parked and resumed need one call each.
  local out1 out2 rows
  out1="$(gh_call search issues "$q" "${common[@]}" --label "$(cfg .parked_label)" 2>/dev/null || echo '[]')"
  out2="$(gh_call search issues "$q" "${common[@]}" --label "$(cfg .resumed_label)" 2>/dev/null || echo '[]')"
  rows="$(printf '%s\n%s\n' "$out1" "$out2" | jq -r -s '
    (add // []) | unique_by(.url) | sort_by(.updatedAt) | reverse
    | .[] | "\((.repository.nameWithOwner // .repository.name // "?"))#\(.number)\t\(.state)\t\(.updatedAt[0:10])\t\(.title)"' 2>/dev/null || true)"
  if [ -z "$rows" ]; then note "no parked work matches \"$q\""; return 0; fi
  printf '%s\n' "$rows"
}

cmd_cancel(){ [ $# -eq 1 ] || die "usage: cancel <wait-id>"; rm -f -- "$WAITS/$1.json" || true; note "cancelled $1"; }

# --- orphan task/session reap (B1, #1116) ------------------------------------
# WHY THIS EXISTS. Sessions park work here and some of them never come back.
# Terminal records (woken/failed/unrunnable/orphaned) and interrupted wakes
# sat in the state directory for days — the measured pain was a 14-hour
# orphaned background task holding the machine. This reap is the TTL layer:
# it archives dead task/session state past a TTL so the machine stops carrying
# it, without ever touching live work.
#
# WHAT GETS REAPED (and only this):
#   1. Terminal wait records (woken, failed, unrunnable, orphaned) whose
#      last-activity timestamp is older than orphan_ttl_hours.
#   2. Interrupted `waking` records whose last_attempt_at is older than
#      orphan_ttl_hours (the wake process is long past wake_timeout_minutes).
#   3. Dead fixer pid files (the process is gone; the file is residue).
#
# WHAT IS NEVER REAPED:
#   - `waiting` records. Wake/resume must stay intact: a fresh continuation
#     is still possible when the blocker closes.
#   - `waking` records younger than the TTL (the wake may still be running).
#   - Reviewer leases or any reviewer-slot state. Lease liveness is a
#     separate completed design (plan_reviewer_lease_liveness.md) that
#     forbids freeing a reviewer slot on age alone. This function does not
#     read, write, or release lease state of any kind.
#   - Unique uncommitted work. The wait record is archived, never a dirty
#     worktree: a record whose cwd has uncommitted changes is logged as
#     `preserved` and its worktree is left alone (cleanup-worktree rules).
#
# Recoverable and auditable: every reaped JSON is moved to
# $HOME_DIR/reaped/<id>.json and one line is appended to $HOME_DIR/reap.log
# with the id, old state, reason, and timestamp. Dry-run lists decisions
# and reaps nothing.
REAP_DIR="$HOME_DIR/reaped"; REAP_LOG="$HOME_DIR/reap.log"

iso_epoch(){ date -u -d "$1" +%s 2>/dev/null || echo 0; }

reap_age_hours(){ # reap_age_hours <iso timestamp> -> whole hours since then (0 if unreadable)
  local ep now_e
  ep="$(iso_epoch "$1")"; now_e="$(date -u +%s)"
  [ "$ep" -gt 0 ] 2>/dev/null || { printf 0; return; }
  printf '%s' "$(( (now_e - ep) / 3600 ))"
}

reap_last_activity(){ # reap_last_activity <wait json> -> best timestamp for age
  jq -r '[.woken_at, .checked_at, .last_attempt_at, .active_writer_at, .registered_at] | map(select(. != null and . != "")) | first // ""' "$1" 2>/dev/null
}

reap_is_candidate(){ # reap_is_candidate <state> <last activity iso> <ttl hours> -> 0 if reappable
  local state="$1" at="$2" ttl="$3" age
  case "$state" in
    waiting) return 1 ;;  # live: wake/resume intact
    waking)
      # A wake older than the TTL is interrupted: wake_timeout_minutes is
      # 45, so anything this old is not still running.
      ;;
    woken|failed|unrunnable|orphaned) ;;
    *) return 1 ;;
  esac
  [ -n "$at" ] || return 1
  age="$(reap_age_hours "$at")"
  [ "$age" -ge "$ttl" ] 2>/dev/null
}

worktree_has_unique_work(){ # worktree_has_unique_work <cwd> -> 0 when dirty (preserve)
  local cwd="$1"
  [ -n "$cwd" ] && [ -d "$cwd" ] || return 1
  # Uncommitted tracked changes or untracked files mean unique work.
  [ -n "$(git -C "$cwd" status --porcelain 2>/dev/null)" ]
}

reap_one(){ # reap_one <json path> <dry 0|1> -> 0 reaped, 1 kept
  local f="$1" dry="$2" id state at age ttl reason dest
  id="$(basename "$f" .json)"
  state="$(jq -r '.state // ""' "$f" 2>/dev/null)"
  at="$(reap_last_activity "$f")"
  ttl="$(cfgd .orphan_ttl_hours 24)"
  reap_is_candidate "$state" "$at" "$ttl" || return 1
  age="$(reap_age_hours "$at")"
  reason="terminal state '$state' idle ${age}h (ttl ${ttl}h)"
  [ "$state" != waking ] || reason="interrupted wake idle ${age}h (ttl ${ttl}h)"
  local cwd preserved=""
  cwd="$(jq -r '.cwd // ""' "$f" 2>/dev/null)"
  if worktree_has_unique_work "$cwd"; then preserved=" preserved unique work at $cwd"; fi
  if [ "$dry" = 1 ]; then
    note "would reap $id ($reason)$preserved"
    return 0
  fi
  mkdir -p "$REAP_DIR"
  dest="$REAP_DIR/$id.json"
  mv "$f" "$dest" || return 1
  printf '%s reaped %s state=%s age=%sh reason=%s%s\n' \
    "$(now_iso)" "$id" "$state" "$age" "$reason" "$preserved" >> "$REAP_LOG"
  note "reaped $id ($reason)$preserved"
  return 0
}

reap_fixer_pids(){ # reap_fixer_pids <dry 0|1>: remove pid files whose process is gone
  local dry="$1" dir="$HOME_DIR/fixers" pf pid n=0
  [ -d "$dir" ] || return 0
  for pf in "$dir"/*.pid; do
    [ -e "$pf" ] || continue
    pid="$(cat "$pf" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      if [ "$dry" = 1 ]; then note "would reap dead fixer pid file $(basename "$pf")"; else
        rm -f "$pf"
        printf '%s reaped fixer-pid file=%s pid=%s reason=process-gone\n' "$(now_iso)" "$(basename "$pf")" "${pid:-empty}" >> "$REAP_LOG"
        note "reaped dead fixer pid file $(basename "$pf")"
      fi
      n=$((n + 1))
    fi
  done
  return 0
}

cmd_reap(){
  local dry=0
  [ "${1:-}" != --dry-run ] || dry=1
  local ttl max f count=0
  ttl="$(cfgd .orphan_ttl_hours 24)"
  max="$(cfgd .reap_max_per_run 64)"
  [ "$ttl" -ge 1 ] 2>/dev/null || die "orphan_ttl_hours must be a positive integer"
  [ "$max" -ge 1 ] 2>/dev/null || die "reap_max_per_run must be a positive integer"
  note "reap start (ttl ${ttl}h, max $max, dry=$dry)"
  for f in "$WAITS"/*.json; do
    [ -e "$f" ] || continue
    [ "$count" -lt "$max" ] || { note "reap cap $max reached; later records wait for the next run"; break; }
    if reap_one "$f" "$dry"; then count=$((count + 1)); fi
  done
  reap_fixer_pids "$dry"
  note "reap end: $count wait record(s) $([ "$dry" = 1 ] && echo 'would be reaped' || echo reaped)"
}

cmd_has_wait(){
  note "registration is no longer required"
  exit 0
}

# --- tick -------------------------------------------------------------------
DRY=0; FAILED=0
propagate(){
  # Exactly one machine propagates comments (config propagate_on_host). Every
  # machine still wakes its own local sessions below. notified.tsv dedupes per
  # machine only, so without this gate N scheduled machines post N copies of
  # each comment. An absent key keeps the historic behaviour (propagate here),
  # which stays correct for a single-machine install.
  local want; want="$(cfg '.propagate_on_host // ""')"
  if [ -n "$want" ]; then
    local me; me="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' | cut -d. -f1)"
    if [ "$me" != "${want,,}" ]; then
      note "propagation is owned by $want (this machine is ${me:-unknown}); only local wakes run here"
      return 0
    fi
  fi
  local start since repo n dep dr dn key
  start="$(now_iso)"
  if [ -s "$SCAN" ]; then since="$(cat "$SCAN")"
  else since="$(date -u -d "-$(cfg .first_scan_lookback_minutes) minutes" +%Y-%m-%dT%H:%M:%SZ)"; fi
  # One search query per BATCH of repos, never one per repo: ai-gh already
  # throttles GitHub, and a per-repo loop costs one search per repo per tick.
  # GitHub caps a search q at 256 characters, so batches flush before the
  # shared qualifier tail ("is:issue is:closed closed:>=<timestamp>", 48 chars
  # with the trailing repo term) pushes them over; nineteen repos cost three
  # queries instead of nineteen.
  local -a queries=() ; local cur="" cur_owner=""
  while read -r repo; do
    [ -n "$repo" ] || continue
    local term="repo:$repo "
    # A batch holds one owner only: each owner is its own app installation.
    if [ -n "$cur" ] && { [ $(( ${#cur} + ${#term} + 48 )) -gt 256 ] || [ "${repo%%/*}" != "$cur_owner" ]; }; then
      queries+=("${cur}is:issue is:closed closed:>=$since"); cur=""
    fi
    cur+="$term"; cur_owner="${repo%%/*}"
  done < <(cfg '.repos[]' | LC_ALL=C sort)
  [ -z "$cur" ] || queries+=("${cur}is:issue is:closed closed:>=$since")
  local ok=1 q closed
  for q in "${queries[@]}"; do
    if ! closed="$(gh_api -X GET search/issues -f "q=$q" -f per_page=100 \
        --jq '.items[] | "\(.repository_url | sub("^.*/repos/"; ""))#\(.number)"')"; then
      note "could not list closed issues for: $q"; ok=0; continue
    fi
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      repo="${line%%#*}"; n="${line##*#}"
      local deps=""
      # The tick's open-issue snapshot already says which OPEN issues wait on
      # this one; REST only when it has none (a miss is not "no dependents").
      snapshot_all_indexed && deps="$(snapshot_dependents_of "$repo" "$n")"
      if [ -z "$deps" ] && ! deps="$(AI_GH_OPERATION=bw.dependents gh_api "repos/$repo/issues/$n/dependencies/blocking" --jq '.[] | select(.state=="open") | "\(.repository_url | sub("^.*/repos/"; ""))#\(.number)"')"; then
        note "could not read what $repo#$n was blocking"; ok=0; continue
      fi
      for dep in $deps; do
        key="$repo#$n	$dep"
        grep -qxF "$key" "$NOTIFIED" && continue
        read -r dr dn <<<"$(parse_ref "$dep")"
        if [ "$DRY" = 1 ]; then note "would tell $dep that $repo#$n closed"; continue; fi
        if gh_call issue comment "$dn" -R "$dr" --body "<!-- ai-blocker-watch:$repo#$n -->
Blocker $repo#$n is closed. Whoever owns this issue: recheck it and continue. (ai-blocker-watch)" >/dev/null; then
          printf '%s\n' "$key" >> "$NOTIFIED"; note "told $dep that $repo#$n closed"
        else note "could not comment on $dep"; ok=0; fi
      done
    done <<<"$closed"
  done
  if [ "$ok" = 1 ]; then [ "$DRY" = 1 ] || printf '%s' "$start" > "$SCAN"; else FAILED=1; fi
}

parked_comment(){ # parked_comment <wait file> <wait id> <mode> <rc> <log> <final 0|1>
  local f="$1" wid="$2" mode="$3" rc="$4" log="$5" final="$6"
  local pi; pi="$(jq -r '.parked_issue // ""' "$f")"
  [ -n "$pi" ] || return 0          # old records predate parked issues
  local pr pn; read -r pr pn <<<"$(parse_ref "$pi")"
  local marker="<!-- ai-blocker-watch:woke:$wid -->" existing
  existing="$(gh_api "repos/$pr/issues/$pn/comments" --jq '.[].body' 2>/dev/null || true)"
  if printf '%s' "$existing" | grep -qF "$marker"; then return 0; fi
  local ref what how body
  ref="$(jq -r '.blocker // ""' "$f")"
  if [ -n "$ref" ]; then what="Blocker $ref closed."; else what="The wait time $(jq -r '.until // ""' "$f") passed."; fi
  if [ "$mode" = resumed ]; then how="Resumed the original"; else how="Started a fresh"; fi
  body="$marker
$what $how $(jq -r .harness "$f") session on $(hostname 2>/dev/null || echo unknown) (exit $rc). Log: $log."
  if [ "$final" = 1 ]; then
    body="$body It failed $(jq -r .attempts "$f") times. A person must restart it from this issue."
  fi
  body="$body (ai-blocker-watch)"
  if gh_call issue comment "$pn" -R "$pr" --body "$body" >/dev/null; then
    if [ "$rc" = 0 ]; then
      gh_call issue edit "$pn" -R "$pr" --remove-label "$(cfg .parked_label)" --add-label "$(cfg .resumed_label)" >/dev/null ||
        { note "could not swap the labels on $pi"; FAILED=1; }
    fi
  else
    note "could not write the outcome on $pi"; FAILED=1
  fi
}

wake(){ # wake <wait file>
  local f="$1" h s cwd ref r n state title prompt log arg
  h="$(jq -r .harness "$f")"; s="$(jq -r .session "$f")"; cwd="$(jq -r .cwd "$f")"
  ref="$(jq -r '.blocker // ""' "$f")"
  local until_at parked_issue parked_url main_checkout wid
  until_at="$(jq -r '.until // ""' "$f")"; parked_issue="$(jq -r '.parked_issue // ""' "$f")"
  parked_url="$(jq -r '.parked_url // ""' "$f")"; main_checkout="$(jq -r '.main_checkout // ""' "$f")"
  wid="$(basename "$f" .json)"
  # Released by whichever comes first: the blocker closing, or the time passing.
  local released="" why="" ispr="" merged="" meta=""
  title=""
  if [ -n "$ref" ]; then
    read -r r n <<<"$(parse_ref "$ref")"
    # Still OPEN in this tick's snapshot → no REST read. A miss (closed, a pull
    # request, a repo outside the scan) always falls through to REST.
    if meta="$(snapshot_open_hit "$ref")"; then :
    elif ! meta="$(AI_GH_OPERATION=bw.wake_miss gh_api "repos/$r/issues/$n" --jq '[.state, ((.pull_request != null) | tostring), .title] | @tsv')"; then
      note "could not read $ref"; FAILED=1; return; fi
    IFS=$'\t' read -r state ispr title <<<"$meta"
    if [ "$state" = closed ]; then
      released=blocker
      why="the blocker you registered a wait on, $ref (\"$title\"), is now closed."
      if [ "$ispr" = true ]; then
        merged="$(gh_api "repos/$r/pulls/$n" --jq .merged 2>/dev/null || echo unknown)"
        if [ "$merged" = false ]; then
          why="$why It is a pull request that closed WITHOUT being merged, so decide whether it must be reopened before you continue."
        fi
      fi
    fi
  fi
  if [ -z "$released" ] && [ -n "$until_at" ]; then
    local now_e due_e
    now_e="$(date -u +%s)"; due_e="$(date -u -d "$until_at" +%s 2>/dev/null || echo 0)"
    if [ "$due_e" -gt 0 ] && [ "$now_e" -ge "$due_e" ]; then
      released=time; why="the time you asked to be called back at, $until_at, has passed."
    fi
  fi
  [ -n "$released" ] || return 0
  local home_m="$HOME" zb=""
  command -v cygpath >/dev/null 2>&1 && home_m="$(cygpath -m "$HOME")"
  zb="$(ls -t "$HOME"/.zcode/v2/runtime/provider/*/*/*/zcode-builtin.json 2>/dev/null | head -1 || true)"
  [ -z "$zb" ] || ! command -v cygpath >/dev/null 2>&1 || zb="$(cygpath -m "$zb")"
  # Resume the exact session when its folder AND its transcript still exist;
  # otherwise start a fresh session from the parked issue in the main checkout.
  local tglob g have_transcript=1 mode=resumed codex_child=0 transcript first_line
  tglob="$(jq -r --arg h "$h" '.transcript_glob[$h] // ""' "$CONFIG")"
  if [ -n "$tglob" ]; then
    g="${tglob//\{home\}/$home_m}"; g="${g//\{session\}/$s}"
    compgen -G "$g" >/dev/null 2>&1 || have_transcript=0
    # Codex cannot resume a multi-agent v2 child through the CLI. Its session
    # metadata identifies that case; the parked issue is the durable context
    # for a fresh independent session instead. Never inspect transcript body.
    if [ "$h" = codex ] && [ "$have_transcript" = 1 ]; then
      while IFS= read -r transcript; do
        IFS= read -r first_line < "$transcript" || :
        if printf '%s\n' "$first_line" | jq -e --arg s "$s" \
          '.type == "session_meta" and .payload.id == $s and
           (.payload.source.subagent.thread_spawn.parent_thread_id // "") != ""' >/dev/null 2>&1; then
          codex_child=1; break
        fi
      done < <(compgen -G "$g")
    fi
  fi
  if [ -d "$cwd" ] && [ "$have_transcript" = 1 ] && [ "$codex_child" = 0 ]; then mode=resumed
  elif [ -n "$main_checkout" ] && [ -d "$main_checkout" ] && [ -n "$parked_url" ] &&
       jq -e --arg h "$h" '.harness_fresh[$h]' "$CONFIG" >/dev/null 2>&1; then mode=fresh
  else mode=orphaned; fi
  if [ "$mode" = orphaned ]; then
    if [ "$DRY" = 1 ]; then note "would mark wait $wid orphaned: nothing on this machine can restart it"; FAILED=1; return; fi
    local otmp="$f.tmp"
    jq --arg at "$(now_iso)" '.state="orphaned" | .checked_at=$at' "$f" > "$otmp" && mv "$otmp" "$f"
    local tgt; tgt="${parked_issue:-$(jq -r '.for // ""' "$f")}"
    if [ -n "$tgt" ]; then
      local tr tn; read -r tr tn <<<"$(parse_ref "$tgt")"
      local orphan_reason="the original $h session or its folder ($cwd) is gone"
      [ "$codex_child" = 0 ] || orphan_reason="the original Codex subagent cannot be resumed independently"
      gh_call issue comment "$tn" -R "$tr" --body "<!-- ai-blocker-watch:orphaned:$wid -->
The wait was released ($why) but $orphan_reason, and no usable fresh continuation was available, so BlockerWatch cannot restart the work. A person must pick it up from this issue. (ai-blocker-watch)" >/dev/null ||
        note "could not comment on $tgt"
    fi
    note "wait $wid is orphaned: no safe continuation is available; restart it from ${tgt:-its brief}"
    FAILED=1; return
  fi
  if [ "$mode" = resumed ]; then
    prompt="ai-blocker-watch: $why"
    [ -z "$(jq -r '.for // ""' "$f")" ] || prompt="$prompt You were waiting on it for $(jq -r .for "$f")."
    [ -z "$(jq -r '.note // ""' "$f")" ] || prompt="$prompt Your note: $(jq -r .note "$f")."
    prompt="$prompt Recheck the wait's final state, then continue the work you were waiting to do. When you finish, or are blocked again, comment the result on ${parked_issue:-your work issue}. If something else now blocks you, leave that issue or pull request as the card and return later — registration is not required."
  else
    local pr pn; read -r pr pn <<<"$(parse_ref "$parked_issue")"
    local fresh_reason="the session that registered it is gone"
    [ "$codex_child" = 0 ] || fresh_reason="the original Codex subagent cannot be resumed independently"
    prompt="ai-blocker-watch: you are a NEW session picking up parked work, because $fresh_reason. The wait was released: $why The full brief is in $parked_url. Read that issue and all of its comments first (gh issue view $pn -R $pr --comments). Follow the repository's AGENTS.md. Create your own worktree from current upstream before you edit anything. Then continue the next steps the brief names. When you finish, or are blocked again, comment the result on that issue. If you are blocked again, leave that issue or pull request as the card and return later - registration is not required."
    cwd="$main_checkout"
  fi
  local cfgkey=harness; [ "$mode" = resumed ] || cfgkey=harness_fresh
  local -a cmd=()
  while IFS= read -r -d '' arg; do
    arg="${arg//\{session\}/$s}"; arg="${arg//\{cwd\}/$cwd}"; arg="${arg//\{prompt\}/$prompt}"
    arg="${arg//\{home\}/$home_m}"; arg="${arg//\{zcode_builtin\}/$zb}"
    cmd+=("$arg")
  done < <(jq -j --arg h "$h" --arg k "$cfgkey" '.[$k][$h][] | . + "\u0000"' "$CONFIG")
  [ "${#cmd[@]}" -gt 0 ] || { note "no command for harness $h"; FAILED=1; return; }
  # The harness must exist on THIS machine — wakes are per-machine, and a wait
  # registered for a program this machine does not have (ZCode on a Claude-only
  # box, say) must stop with a visible error instead of burning its retries on
  # a command that can never run. Skip `env` and VAR=value prefixes; the first
  # remaining argument is the program.
  local prog="" elem
  for elem in "${cmd[@]}"; do
    case "$elem" in
      env) ;;
      *=*) ;;
      *) prog="$elem"; break ;;
    esac
  done
  local resolved=0
  if [ -n "$prog" ]; then
    case "$prog" in
      */*|*\\*) [ -e "$prog" ] && resolved=1 ;;
      *) command -v "$prog" >/dev/null 2>&1 && resolved=1 ;;
    esac
  fi
  if [ "$resolved" != 1 ]; then
    if [ "$DRY" = 1 ]; then
      note "would mark $h wait $wid unrunnable: harness program not found on this machine: ${prog:-<empty command>}"
    else
      local tmp="$f.tmp"
      jq --arg at "$(now_iso)" --arg p "${prog:-<empty command>}" \
        '.state="unrunnable" | .error=("harness program not found on this machine: " + $p) | .checked_at=$at' "$f" > "$tmp" && mv "$tmp" "$f"
      note "cannot wake $h session $s: harness program not found on this machine: ${prog:-<empty command>}; wait $wid is now unrunnable (leave the issue as the card once the program is installed)"
    fi
    FAILED=1; return
  fi
  if [ "$DRY" = 1 ]; then note "would start a $mode $h session in $cwd (wait released: $why)"; return; fi
  log="$LOGS/$wid-$(date -u +%Y%m%dT%H%M%S).log"
  local tmp="$f.tmp"
  jq --arg at "$(now_iso)" --arg m "$mode" '.state="waking" | .mode=$m | .attempts+=1 | .last_attempt_at=$at' "$f" > "$tmp" && mv "$tmp" "$f"
  note "$mode $h session $s in $cwd (wait released: $why); log $log"
  if (cd "$cwd" && timeout "$(( $(cfg .wake_timeout_minutes) * 60 ))" "${cmd[@]}") >"$log" 2>&1 </dev/null; then
    jq --arg at "$(now_iso)" --arg log "$log" --arg m "$mode" '.state="woken" | .mode=$m | .woken_at=$at | .log=$log' "$f" > "$tmp" && mv "$tmp" "$f"
    parked_comment "$f" "$wid" "$mode" 0 "$log" 0
  else
    local rc=$?
    # The desktop may still own this Codex thread. Its resume command rejects
    # a second writer before running the prompt; keep the wait for a later tick
    # without spending a wake attempt or reporting a failed continuation.
    if [ "$h" = codex ] && [ "$mode" = resumed ] &&
       grep -Fq 'already has an active writer (code -32600)' "$log"; then
      jq --arg at "$(now_iso)" '.state="waiting" | .attempts-=1 | .active_writer_at=$at | del(.last_attempt_at)' "$f" > "$tmp" && mv "$tmp" "$f" || { FAILED=1; return; }
      note "Codex session $s is still active; wait $wid remains queued"
      return
    fi
    FAILED=1
    if [ "$(jq .attempts "$f")" -ge "$(cfg .max_wake_attempts)" ]; then
      jq --arg log "$log" --argjson rc "$rc" --arg m "$mode" '.state="failed" | .mode=$m | .log=$log | .exit=$rc' "$f" > "$tmp" && mv "$tmp" "$f"
      parked_comment "$f" "$wid" "$mode" "$rc" "$log" 1
    else
      jq --arg log "$log" --argjson rc "$rc" --arg m "$mode" '.state="waiting" | .mode=$m | .log=$log | .exit=$rc' "$f" > "$tmp" && mv "$tmp" "$f"
    fi
    note "$mode $h session $s failed with exit $rc; see $log"
  fi
}

# --- open-issue snapshot shared by the alarm and link scans (#658 P5) ------
# Both hourly scans need every OPEN issue in every configured repo. Reading the
# list once per repo per tick, with the union of both scans' fields, halves the
# largest source of BlockerWatch GitHub traffic. A failed read is remembered
# for the rest of the tick so the second scan fails the same way instead of
# re-sending the request; a link created this tick is added to the copy so
# the alarm still sees it without a second read (or, if that edit fails, the
# copy is dropped and the alarm re-reads the repo).
SNAP_Q='query($owner:String!,$name:String!,$after:String){repository(owner:$owner,name:$name){issues(first:100,states:OPEN,after:$after){pageInfo{hasNextPage endCursor}nodes{number databaseId title assignees(first:10){totalCount} body blockedBy(first:50){nodes{number state title repository{nameWithOwner} assignees(first:10){totalCount}}}}}}rateLimit{cost remaining resetAt}}'
declare -A SNAP=() SNAPN=() SNAPERR=()
open_snapshot(){ # open_snapshot <owner/repo> <note prefix>: pages in SNAP[repo|i], count in SNAPN[repo]; rc 1 on failure
  local repo="$1" pfx="$2" pages=0 cursor="" out i read_rc
  if [ -n "${SNAPERR[$repo]+set}" ]; then note "$pfx: ${SNAPERR[$repo]} (not retried this tick)"; return 1; fi
  [ -z "${SNAPN[$repo]+set}" ] || return 0
  while :; do
    pages=$((pages+1))
    if [ "$pages" -gt 10 ]; then SNAPERR[$repo]="$repo has more open issues than one scan reads (1000)"; break; fi
    read_rc=0
    if [ -n "$cursor" ]; then
      out="$(AI_GH_OPERATION=bw.snapshot gh_api graphql -f query="$SNAP_Q" -f owner="${repo%/*}" -f name="${repo#*/}" -f after="$cursor")" || read_rc=$?
    else
      out="$(AI_GH_OPERATION=bw.snapshot gh_api graphql -f query="$SNAP_Q" -f owner="${repo%/*}" -f name="${repo#*/}")" || read_rc=$?
    fi
    record_graphql_cost graphql.open_issue_snapshot "$out"
    if [ "$read_rc" -ne 0 ]; then SNAPERR[$repo]="could not list open issues in $repo"; break; fi
    printf '%s' "$out" | jq -e '(has("errors")|not) and (.data.repository != null)' >/dev/null || { SNAPERR[$repo]="unreadable answer from $repo"; break; }
    SNAP["$repo|$pages"]="$out"
    if [ "$(printf '%s' "$out" | jq -r '.data.repository.issues.pageInfo.hasNextPage')" = true ]; then
      cursor="$(printf '%s' "$out" | jq -r '.data.repository.issues.pageInfo.endCursor')"; continue
    fi
    SNAPN[$repo]="$pages"; snapshot_index_build "$repo"; return 0
  done
  for ((i=1; i<=pages; i++)); do unset "SNAP[$repo|$i]"; done
  note "$pfx: ${SNAPERR[$repo]}"; return 1
}
# Snapshot index (P5 REST savings): the same pages, keyed for the tick's other
# readers so propagate, wake and link stop asking GitHub what this tick already
# read. SNAPIDX[repo#n] = "id<TAB>title" for every OPEN issue; SNAPDEP[repo#n]
# lists the OPEN issues blocked by repo#n (" a#1 b#2 "), including links the
# links scan created this tick. An
# index is a cache of relationships, never authority for a mutation, and a
# miss is never proof of closure: callers fall back to REST. SNAPREPO marks the
# configured repos indexed this tick; dependents are trusted only when all are.
declare -A SNAPIDX=() SNAPDEP=() SNAPREPO=()
snapshot_index_set(){ # snapshot_index_set <blocked repo#n> <blocker repo#n>: record one edge
  case "${SNAPDEP[$2]:- }" in *" $1 "*) ;; *) SNAPDEP[$2]="${SNAPDEP[$2]:- }$1 " ;; esac
}
snapshot_index_build(){ # snapshot_index_build <owner/repo>: index the pages open_snapshot just read
  local repo="$1" pg kind a b c
  for ((pg=1; pg<=SNAPN[$repo]; pg++)); do
    while IFS=$'\t' read -r kind a b c; do
      case "$kind" in
        I) SNAPIDX["$a"]="$b"$'\t'"$c" ;;
        B) snapshot_index_set "$a" "$b" ;;
      esac
    done < <(printf '%s' "${SNAP[$repo|$pg]}" | jq -r --arg r "$repo" '.data.repository.issues.nodes[] | ("\($r)#\(.number)") as $k |
      (["I", $k, (.databaseId // "" | tostring), ((.title // "") | gsub("[\t\n\r]"; " "))] | @tsv),
      ((.blockedBy.nodes // [])[] | ["B", $k, "\(.repository.nameWithOwner // $r)#\(.number)", ""] | @tsv)')
  done
  SNAPREPO[$repo]=1
}
snapshot_open_hit(){ # snapshot_open_hit <repo#n>: prints "open<TAB>false<TAB>title" when this tick saw it OPEN
  local r="${1%#*}"
  [ -n "${SNAPREPO[$r]+set}" ] && [ -n "${SNAPIDX[$1]+set}" ] || return 1
  printf 'open\tfalse\t%s' "${SNAPIDX[$1]#*$'\t'}"
}
snapshot_dependents_of(){ # snapshot_dependents_of <repo> <n>: OPEN issues this tick saw blocked by repo#n
  local d; for d in ${SNAPDEP[$1#$2]:-}; do printf '%s\n' "$d"; done
}
snapshot_all_indexed(){
  local r; while read -r r; do [ -z "$r" ] || [ -n "${SNAPREPO[$r]+set}" ] || return 1; done < <(cfg '.repos[]'); return 0
}
snapshot_drop(){ local i; for ((i=1; i<=${SNAPN[$1]:-0}; i++)); do unset "SNAP[$1|$i]"; done; unset "SNAPN[$1]"; }
snapshot_addlink(){ # snapshot_addlink <owner/repo> <issue> <blocker>: record a new same-repo link in the snapshot
  local repo="$1" i node="" pg
  [ -n "${SNAPN[$repo]+set}" ] || return 0
  for ((i=1; i<=SNAPN[$repo]; i++)); do
    node="$(printf '%s' "${SNAP[$repo|$i]}" | jq -c --argjson k "$3" --arg r "$repo" 'first(.data.repository.issues.nodes[] | select(.number==$k) | {number, state:"OPEN", title, repository:{nameWithOwner:$r}, assignees}) // empty')" || return 1
    [ -z "$node" ] || break
  done
  [ -n "$node" ] || return 0 # the blocker is not open, so no scan here reads it
  local new
  for ((pg=1; pg<=SNAPN[$repo]; pg++)); do # rewrite only the page holding the issue
    printf '%s' "${SNAP[$repo|$pg]}" | jq -e --argjson n "$2" 'any(.data.repository.issues.nodes[]; .number==$n)' >/dev/null || continue
    new="$(printf '%s' "${SNAP[$repo|$pg]}" | jq -c --argjson n "$2" --argjson b "$node" '(.data.repository.issues.nodes[] | select(.number==$n) | .blockedBy.nodes) += [$b]')" || return 1
    SNAP["$repo|$pg"]="$new"
    break
  done
}

# --- alarm: unowned open blockers (#550) ------------------------------------
# A blocker nobody owns stalls every session behind it. Each scan finds OPEN
# issues that block another OPEN issue yet have no assignee, no `owner:` line,
# no open linked pull request and no activity (ignoring this tool's own
# comments) for more than alarm_stall_hours, leaves ONE marked comment asking
# for an owner, and lists them in a daily digest issue in alarm_digest_repo —
# blockers holding up a chain alarm_depth_priority or more levels deep first.
# Stalls are findings, not failures: only a failed read or post fails the tick.
cfgd(){ local v; v="$(cfg "$1")"; if [ "$v" != null ] && [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "$2"; fi; }
alarm_on(){ [ "$(cfgd .alarm_enabled true)" = true ]; }
ISSUE_Q='query($owner:String!,$name:String!,$n:Int!){repository(owner:$owner,name:$name){issue(number:$n){updatedAt createdAt body comments(last:30){nodes{body createdAt}} timelineItems(first:50,itemTypes:[CROSS_REFERENCED_EVENT]){nodes{... on CrossReferencedEvent{source{... on PullRequest{number state}}}}} blocking(first:50){nodes{number state repository{nameWithOwner}}}}}rateLimit{cost remaining resetAt}}'
# Per-tick read cache and node budget live in files under ALARM_TICK: issue_json
# is always called as j="$(issue_json ...)", so shell variables would die with
# that subshell and the cache/budget would never take effect (#809).
ALARM_TICK=""
issue_json(){ # issue_json <owner/repo> <n>: cached ISSUE_Q answer; 0 ok, 1 node budget, 2 failed
  local repo="$1" n="$2" out key="$1#$2" spent budget cachef read_rc=0
  # '@' cannot appear in a GitHub owner or repo name, so owner/repo cannot collide.
  cachef="$ALARM_TICK/cache/${key//\//@}"
  if [ -f "$cachef" ]; then cat "$cachef"; return 0; fi
  budget="$(cfgd .alarm_max_nodes 40)"
  spent="$(cat "$ALARM_TICK/agql" 2>/dev/null || printf 0)"
  [ "$spent" -lt "$budget" ] || return 1
  printf '%s' "$((spent+1))" > "$ALARM_TICK/agql"
  out="$(AI_GH_OPERATION=bw.alarm_issue gh_api graphql -f query="$ISSUE_Q" -f owner="${repo%/*}" -f name="${repo#*/}" -F "n=$n")" || read_rc=$?
  record_graphql_cost graphql.issue_detail "$out"
  [ "$read_rc" -eq 0 ] || return 2
  printf '%s' "$out" | jq -e '(has("errors")|not) and (.data.repository.issue != null)' >/dev/null || return 2
  printf '%s' "$out" > "$cachef"
  printf '%s' "$out"
}
depth_of(){ # depth_of <owner/repo> <n> <seen>: longest open chain this issue holds up; best effort
  local repo="$1" n="$2" seen="$3" j rc d best=0 kr kn st key
  key="$repo#$n"
  case ",$seen," in *",$key,"*) printf '%s' 1; return 0 ;; esac
  rc=0; j="$(issue_json "$repo" "$n")" || rc=$?
  if [ "$rc" -eq 1 ]; then note "alarm: node budget reached while measuring the chain behind $key"; printf '%s' 1; return 0; fi
  [ "$rc" -eq 0 ] || { printf '%s' 1; return 0; }
  while IFS=$'\t' read -r kr kn st; do
    [ "$st" = OPEN ] || continue
    d="$(depth_of "$kr" "$kn" "$seen,$key")"
    [ "$d" -gt "$best" ] && best="$d"
  done < <(printf '%s' "$j" | jq -r '.data.repository.issue.blocking.nodes[] | [.repository.nameWithOwner, (.number|tostring), .state] | @tsv')
  printf '%s' "$((best+1))"
}

alarm_scan(){ # alarm_scan <dry 0|1>
  local dry="$1" start repo out cutoff afail=0
  local pr pn kr kn ac ti k key j rc marker pr_open alarmed lastact la_ep
  # The alarm POSTS (request-for-owner comments, the digest issue), so it is
  # owned by the same single machine as propagation: without this gate N
  # scheduled machines race to open N digests and N comments. A dry run only
  # reads, so it stays available on every machine. Absent key = act here,
  # matching propagate()'s single-machine default.
  if [ "$dry" -ne 1 ]; then
    local want; want="$(cfg '.propagate_on_host // ""')"
    if [ -n "$want" ]; then
      local me; me="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' | cut -d. -f1)"
      if [ "$me" != "${want,,}" ]; then
        note "the unowned-blocker alarm is owned by $want (this machine is ${me:-unknown}); only local wakes run here"
        return 0
      fi
    fi
  fi
  start="$(now_iso)"
  ALARM_TICK="$HOME_DIR/alarm-tick"
  rm -rf "$ALARM_TICK"
  (umask 077; mkdir -p "$ALARM_TICK/cache"; printf '0' > "$ALARM_TICK/agql")
  local -A seen=() sttl=() spar=() stall=() sage=() salarmed=() sdepth=() sact=()
  cutoff="$(date -u -d "-$(cfgd .alarm_stall_hours 24) hours" +%Y-%m-%dT%H:%M:%SZ)"
  # Pass 1: the shared open-issue snapshot gives every OPEN blocker of an
  # OPEN issue (with assignees for free; owned ones drop out).
  local pg
  for repo in $(cfg '.repos[]'); do
    open_snapshot "$repo" alarm || { afail=1; continue; }
    for ((pg=1; pg<=SNAPN[$repo]; pg++)); do
      out="${SNAP[$repo|$pg]}"
      while IFS=$'\t' read -r pr pn kr kn ac ti; do
        [ -n "$kr" ] || continue
        [ "$ac" -gt 0 ] && continue # an assignee is an owner; nothing further to check
        key="$kr#$kn"
        if [ -z "${seen[$key]+set}" ]; then seen[$key]=1; sttl[$key]="$ti"; fi
        spar[$key]="${spar[$key]:-}$pr#$pn "
      done < <(printf '%s' "$out" | jq -r --arg pr "$repo" '.data.repository.issues.nodes[] | .number as $p | .blockedBy.nodes[] | select(.state=="OPEN") | [$pr, ($p|tostring), .repository.nameWithOwner, (.number|tostring), (.assignees.totalCount|tostring), .title] | @tsv')
    done
  done
  # Pass 2: per unassigned candidate, one cached query decides owner marker,
  # open linked pull request, prior alarm comment, and real last activity.
  for key in "${!seen[@]}"; do
    kr="${key%#*}"; kn="${key#*#}"
    rc=0; j="$(issue_json "$kr" "$kn")" || rc=$?
    if [ "$rc" -eq 1 ]; then note "alarm: node budget reached before $key; raise alarm_max_nodes"; afail=1; continue; fi
    if [ "$rc" -ne 0 ]; then note "alarm: could not read $key"; afail=1; continue; fi
    marker="$(printf '%s' "$j" | jq -r '[(.data.repository.issue.comments.nodes[].body // ""), (.data.repository.issue.body // "")] | join("\n") | test("(?im)^[[:space:]]*owner[[:space:]]*[:=]")')"
    [ "$marker" = true ] && continue
    pr_open="$(printf '%s' "$j" | jq -r '[.data.repository.issue.timelineItems.nodes[].source.state] | any(. == "OPEN")')"
    [ "$pr_open" = true ] && continue
    alarmed="$(printf '%s' "$j" | jq -r --arg k "$key" 'any(.data.repository.issue.comments.nodes[].body; contains("ai-blocker-watch:unowned:" + $k))')"
    # updatedAt counts this tool's own alarm comment as activity; look past it.
    lastact="$(printf '%s' "$j" | jq -r '
      .data.repository.issue as $i |
      ($i.comments.nodes | map(select((.body // "") | contains("ai-blocker-watch:unowned:"))) | map(.createdAt) | max) as $ours |
      ($i.comments.nodes | map(select((.body // "") | (contains("ai-blocker-watch:unowned:") | not))) | map(.createdAt) | max) as $theirs |
      if ($ours != null and ($i.updatedAt <= $ours) and ($theirs == null or $theirs < $ours)) then ($theirs // $i.createdAt) else $i.updatedAt end')"
    [[ "$lastact" > "$cutoff" ]] && continue
    la_ep="$(date -u -d "$lastact" +%s 2>/dev/null || printf 0)"
    if [ "$la_ep" -eq 0 ]; then lastact="2000-01-01T00:00:00Z"; fi # unknown activity time reads as the oldest
    stall[$key]=1; salarmed[$key]="$alarmed"; sact[$key]="$lastact"
    sage[$key]="$(( ( $(date -u +%s) - la_ep ) / 3600 ))h"
    spar[$key]="${spar[$key]% }"
  done
  # Depth: a blocker holding up a chain 3+ levels deep idles the most sessions.
  for key in "${!stall[@]}"; do
    sdepth[$key]="$(depth_of "${key%#*}" "${key#*#}" "")"
  done
  local day body drepo title dnum sorted depth_prio line pri="" rest=""
  day="$(date -u +%Y-%m-%d)"
  body="$HOME_DIR/digest-$day.md"
  drepo="$(cfgd .alarm_digest_repo popcre/ai-devops)"
  depth_prio="$(cfgd .alarm_depth_priority 3)"
  sorted="$(for key in "${!stall[@]}"; do printf '%s\t%s\t%s\n' "${sdepth[$key]}" "${sact[$key]}" "$key"; done | sort -t$'\t' -k1,1rn -k2,2 | cut -f3)"
  for key in $sorted; do
    line="$(printf -- '- **%s** "%s" — no assignee, no `owner:` line, no open linked pull request, no activity for %s. Blocks %s (chain %s deep).' "$key" "${sttl[$key]}" "${sage[$key]}" "${spar[$key]}" "${sdepth[$key]}")"
    if [ "${sdepth[$key]}" -ge "$depth_prio" ]; then pri="${pri:+$pri
}$line"; else rest="${rest:+$rest
}$line"; fi
  done
  {
    printf '<!-- ai-blocker-watch:digest:%s -->\n' "$day"
    printf 'ai-blocker-watch unowned-blocker digest for %s (UTC).\n\n' "$day"
    if [ "${#stall[@]}" -eq 0 ]; then
      printf 'No open blocker older than %s hours lacks an owner (an assignee, an `owner:` line, an open linked pull request, or activity).\n' "$(cfgd .alarm_stall_hours 24)"
    else
      if [ -n "$pri" ]; then
        printf '## Priority — holding up a chain %s+ levels deep (idles the most sessions)\n\n%s\n' "$depth_prio" "$pri"
        [ -z "$rest" ] || printf '\n## Also unowned\n\n%s\n' "$rest"
      else
        printf '## Unowned blockers older than %s hours\n\n%s\n' "$(cfgd .alarm_stall_hours 24)" "$rest"
      fi
      printf '\nAn issue leaves this list when it gains an assignee, an `owner:` line, an open linked pull request, or fresh activity. Each issue gets at most one request-for-owner comment from the watcher.\n'
    fi
  } > "$body"
  for key in $sorted; do
    [ "${salarmed[$key]}" = true ] && continue
    if [ "$dry" = 1 ]; then note "would ask $key for an owner (no owner, no activity for ${sage[$key]})"; continue; fi
    if gh_call issue comment "${key#*#}" -R "${key%#*}" --body "<!-- ai-blocker-watch:unowned:$key -->
This open issue blocks ${spar[$key]} and has gone ${sage[$key]} with no owner: no assignee, no \`owner:\` line, no open linked pull request, no activity.
Take it (assign yourself, or add an \`owner:\` line naming who owns it) or hand it to a named queue owner. Listed in today's ai-blocker-watch digest. (ai-blocker-watch)" >/dev/null; then
      note "asked $key for an owner"
    else note "alarm: could not comment on $key"; afail=1; fi
  done
  if [ "${#stall[@]}" -gt 0 ] || [ -e "$HOME_DIR/digest-$day.done" ]; then
    title="ai-blocker-watch digest $day"
    if [ "$dry" = 1 ]; then
      note "would update the digest in $drepo: $title"
    else
      # Today's digest, once open, is just another open issue this tick already
      # read (#658 P5) — look there before spending a search request.
      dnum=""
      if [ -n "${SNAPREPO[$drepo]+set}" ]; then
        local k t best=""
        for k in "${!SNAPIDX[@]}"; do
          case "$k" in "$drepo#"*) ;; *) continue ;; esac
          t="${SNAPIDX[$k]#*$'\t'}"
          [ "$t" = "$title" ] || continue
          # Lowest number wins if a raced duplicate digest exists.
          [ -z "$best" ] || [ "${k##*#}" -ge "${best##*#}" ] || continue
          best="$k"
        done
        [ -z "$best" ] || dnum="${best##*#}"
      fi
      if [ -n "$dnum" ]; then
        :
      elif dnum="$(gh_call search issues "$title" --repo "$drepo" --json number,title --jq ".[] | select(.title == \"$title\") | .number" 2>/dev/null)"; then
        dnum="$(printf '%s' "$dnum" | head -1)"
      else
        note "alarm: could not search $drepo for today's digest"; dnum=""; afail=1
      fi
      if [ -n "$dnum" ]; then
        touch "$HOME_DIR/digest-$day.done"
        if ! cmp -s "$body" "$HOME_DIR/digest-$day.prev" 2>/dev/null; then
          if gh_call issue edit "$dnum" -R "$drepo" --body-file "$body" >/dev/null; then
            cp "$body" "$HOME_DIR/digest-$day.prev"; note "updated digest $drepo#$dnum"
          else note "alarm: could not update digest $drepo#$dnum"; afail=1; fi
        fi
      else
        if gh_call issue create -R "$drepo" -t "$title" --body-file "$body" >/dev/null; then
          cp "$body" "$HOME_DIR/digest-$day.prev"; touch "$HOME_DIR/digest-$day.done"; note "opened digest in $drepo: $title"
        else note "alarm: could not open today's digest in $drepo"; afail=1; fi
      fi
    fi
  fi
  if [ "$afail" = 0 ]; then
    [ "$dry" = 1 ] || printf '%s' "$start" > "$LAST_ALARM"
  else FAILED=1; fi
  # ISSUE_Q payloads include comment bodies; never leave them on disk past the scan.
  rm -rf "$ALARM_TICK"
}

# scan_due <clock file> <interval minutes> [early]: the scan is due after its
# interval; with `early`, after half of it. When one hourly scan runs, the other
# is pulled forward so both share one open-issue snapshot instead of drifting
# into separate ticks that each read every repo.
scan_due(){
  local since elapsed full
  since="$(cat "$1" 2>/dev/null || printf '')"
  elapsed="$(( $(date -u +%s) - $(date -u -d "${since:-1970-01-01T00:00:00Z}" +%s 2>/dev/null || printf 0) ))"
  full=$(( $2 * 60 ))
  [ "$elapsed" -ge "$full" ] || { [ "${3:-}" = early ] && [ $(( elapsed * 2 )) -ge "$full" ]; }
}
maybe_alarm(){
  alarm_on || return 0
  if [ "$DRY" = 1 ]; then alarm_scan 1; return 0; fi
  if scan_due "$LAST_ALARM" "$(cfgd .alarm_interval_minutes 60)" "${1:-}"; then alarm_scan 0; fi
}

# --- links: blocked-by links from db-work-scope depends_on (#596) -----------
# A session that files "M cannot proceed until N closes" writes N into M's
# db-work-scope fence as `depends_on: N` — one inline comma-separated field of
# same-repo issue numbers with an optional '#' prefix, the exact contract the
# shared-db queue tooling validates. The native "blocked by" link is therefore
# data the issue already carries, not a judgment call left to the session.
# Each links scan reads OPEN issues in the configured repos, parses the fence,
# and records every missing link: present → nothing to do; missing → create it
# and note it in the tick log. A malformed fence (more than one block, an
# unterminated block, a duplicated or unreadable depends_on line, a
# non-numeric entry) is skipped and counted — never a crash and never a failed
# tick. Links are only ever ADDED here; a stale depends_on line is the issue
# author's to fix.
links_on(){ [ "$(cfgd .links_enabled true)" = true ]; }

parse_depends_on(){ # stdin: issue body -> dep numbers, one per line; rc 1 = malformed fence
  local content line cur nlines val
  content="$(awk '
    /^```db-work-scope[ \t]*$/ { n++; if (n > 1) exit 3; inf=1; next }
    inf && /^```[ \t]*$/ { inf=0; next }
    inf { print }
    END { if (inf) exit 4 }
  ')" || return 1
  [ -n "$content" ] || return 0
  # Structural check, mirroring the queue tooling's line rules: list items are
  # legal only inside objects:/writes:/reads:; every other line must be a
  # lowercase field line, and no field repeats. A YAML-list-style depends_on
  # (an empty field followed by `- N` items) is therefore malformed here
  # exactly as it is there — skipped and counted, never silently empty.
  cur=""
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    case "$line" in objects:|writes:|reads:) cur="${line%%:}"; continue ;; esac
    if [ -n "$cur" ]; then case "$line" in -\ *) continue ;; esac; fi
    cur=""
    printf '%s\n' "$line" | grep -qE '^[a-z_]+:' || return 1
  done <<<"$content"
  nlines="$(printf '%s\n' "$content" | grep -c '^depends_on:')"
  [ "$nlines" -le 1 ] || return 1
  [ "$nlines" -eq 1 ] || return 0
  val="$(printf '%s\n' "$content" | sed -n 's/^depends_on:[[:space:]]*//p' | head -1)"
  [ -n "$val" ] || return 0
  printf '%s\n' "$val" | tr ',' '\n' | {
    local bad=0 tok
    while IFS= read -r tok; do
      tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"
      [ -n "$tok" ] || continue
      tok="${tok#\#}"
      case "$tok" in
        *[!0-9]*|"") bad=1 ;;
        *) if [ "$((10#$tok))" -gt 0 ]; then printf '%s\n' "$((10#$tok))"; else bad=1; fi ;;
      esac
    done
    [ "$bad" -eq 0 ]
  }
}

maintain_links(){ # maintain_links <dry 0|1>
  local dry="$1" start repo out lfail=0
  # Link creation POSTs to GitHub, so posting is owned by the same single
  # machine as propagation and the alarm — without this gate N scheduled
  # machines race to create the same links. A dry run only reads, so it stays
  # available on every machine. Absent key = act here.
  if [ "$dry" -ne 1 ]; then
    local want; want="$(cfg '.propagate_on_host // ""')"
    if [ -n "$want" ]; then
      local me; me="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' | cut -d. -f1)"
      if [ "$me" != "${want,,}" ]; then
        note "blocked-by link maintenance is owned by $want (this machine is ${me:-unknown}); only local wakes run here"
        return 0
      fi
    fi
  fi
  start="$(now_iso)"
  local -A idmap=() eseen=()
  local -a edges=()
  local malformed=0 unresolvable=0 created=0
  # Pass 1: the shared open-issue snapshot gives every OPEN issue's
  # depends_on edges, plus an id map for same-repo resolution.
  local pg num did b64 blocked deps dep
  for repo in $(cfg '.repos[]'); do
    open_snapshot "$repo" links || { lfail=1; continue; }
    for ((pg=1; pg<=SNAPN[$repo]; pg++)); do
      out="${SNAP[$repo|$pg]}"
      while IFS=$'\t' read -r num did b64 blocked; do
        [ -n "$num" ] || continue
        [ "$did" = null ] || idmap["$repo#$num"]="$did"
        deps="$(printf '%s' "$b64" | base64 -d 2>/dev/null | tr -d '\r' | parse_depends_on)" || { malformed=$((malformed+1)); note "links: $repo#$num has a malformed db-work-scope fence; skipped"; continue; }
        for dep in $deps; do
          if [ "$dep" = "$num" ]; then note "links: $repo#$num depends_on names itself; skipped"; malformed=$((malformed+1)); continue; fi
          case " $blocked " in *" $dep "*) continue ;; esac # link present → nothing to do
          [ -z "${eseen[$repo#$num>$dep]+set}" ] || continue
          eseen["$repo#$num>$dep"]=1; edges+=("$repo#$num $dep")
        done
      done < <(printf '%s' "$out" | jq -r '.data.repository.issues.nodes[] | [(.number|tostring), (.databaseId|tostring), ((.body // "") | @base64), ([.blockedBy.nodes[].number | tostring] | join(" "))] | @tsv')
    done
  done
  # Pass 2: create each missing link. The blocker's id comes from the
  # open-issue map when the blocker is open, else one REST read — a closed
  # blocker still records a truthful link, and an unreadable target is
  # skipped and counted, never a failed tick.
  local edge bref dep id br bn
  for edge in ${edges[@]+"${edges[@]}"}; do
    bref="${edge%% *}"; dep="${edge##* }"; br="${bref%#*}"; bn="${bref#*#}"
    id="${idmap[$br#$dep]:-}"
    if [ -z "$id" ]; then
      id="$(AI_GH_OPERATION=bw.link_issue gh_api "repos/$br/issues/$dep" --jq 'if .pull_request then "pr" else .id end' 2>/dev/null)" || id=""
      if [ -z "$id" ]; then note "links: cannot read $br#$dep (named in $bref's depends_on); skipped"; unresolvable=$((unresolvable+1)); continue; fi
      # GitHub only links issues to issues; a pull request target is refused
      # every scan and kept the links clock from ever advancing.
      if [ "$id" = pr ]; then note "links: $br#$dep (named in $bref's depends_on) is a pull request, which GitHub cannot link; skipped"; unresolvable=$((unresolvable+1)); continue; fi
    fi
    if [ "$dry" = 1 ]; then note "links: would record $bref is blocked by $br#$dep (from its db-work-scope depends_on)"; continue; fi
    if AI_GH_OPERATION=bw.link_issue gh_api -X POST "repos/$br/issues/$bn/dependencies/blocked_by" -F "issue_id=$id" >/dev/null; then
      created=$((created+1)); snapshot_index_set "$bref" "$br#$dep"; snapshot_addlink "$br" "$bn" "$dep" || snapshot_drop "$br"; note "links: recorded $bref is blocked by $br#$dep (from its db-work-scope depends_on)"
    else
      note "links: GitHub refused the link $bref blocked by $br#$dep"; lfail=1
    fi
  done
  [ "$malformed" -eq 0 ] || note "links: skipped $malformed malformed db-work-scope fence(s) this scan"
  [ "$unresolvable" -eq 0 ] || note "links: skipped $unresolvable unreadable depends_on target(s) this scan"
  if [ "$lfail" = 0 ]; then [ "$dry" = 1 ] || printf '%s' "$start" > "$LAST_LINKS"; else FAILED=1; fi
}

maybe_links(){
  links_on || return 0
  if [ "$DRY" = 1 ]; then maintain_links 1; return 0; fi
  if scan_due "$LAST_LINKS" "$(cfgd .links_interval_minutes 60)" "${1:-}"; then maintain_links 0; fi
}

# --- stuck-work watchdog trigger (popcre/ai-devops#1011) ---------------------
# GitHub drops most scheduled runs in this repository (an hourly cron fired
# every 4-7 hours on 2026-09-28/29), so the watchdog's 15-minute cadence is
# driven from here: on fixer_on_host, every stuck_watchdog_interval_minutes, a
# tick runs tools/stuck-work/watchdog.mjs as the pop-ai-watchers App (its own
# allowance). Re-runs use this machine's gh login and happen at most once per
# head SHA. About 15 API calls per run.
stuck_watchdog_scan(){
  [ "$(cfgd .stuck_watchdog_enabled false)" = true ] || return 0
  local want me; want="$(cfgd .fixer_on_host '')"
  me="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' | cut -d. -f1)"
  [ -n "$want" ] && [ "$me" = "${want,,}" ] || return 0
  local last="$HOME_DIR/last-stuck-watchdog"
  [ "$DRY" = 1 ] || scan_due "$last" "$(cfgd .stuck_watchdog_interval_minutes 15)" || return 0
  local script="$TOOL_ROOT/tools/stuck-work/watchdog.mjs" auth="$TOOL_ROOT/bin/ai-gh-app-auth" tok rerun="" log
  if [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ]; then script="${AI_BLOCKER_WATCH_TEST_STUCK_SCRIPT:-$script}"; auth="${AI_BLOCKER_WATCH_TEST_APP_AUTH:-$auth}"; fi
  [ -f "$script" ] && command -v node >/dev/null 2>&1 || { note "stuck watchdog: node or $script missing"; FAILED=1; return 0; }
  tok="$("$auth" token popcre 2>/dev/null)" || { note "stuck watchdog: no app token on this machine"; FAILED=1; return 0; }
  [ "$DRY" = 1 ] || rerun="$("$GH" auth token 2>/dev/null || true)"
  log="$LOGS/stuck-watchdog-$(date -u +%Y%m%dT%H%M%S).log"
  local -a args=(--json "$HOME_DIR/stuck-report.json"); [ "$DRY" = 1 ] && args+=(--dry-run)
  if GH_TOKEN="$tok" RERUN_TOKEN="$rerun" timeout 300 node "$script" "${args[@]}" >"$log" 2>&1; then
    [ "$DRY" = 1 ] || now_iso > "$last"
    note "stuck watchdog: $(grep -m1 '^Stuck-work watchdog' "$log" || echo ran) (log $log)"
  else
    note "stuck watchdog failed; log $log"; FAILED=1
  fi
}

lock_take(){
  local lock="$HOME_DIR/tick.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    # A tick killed mid-run leaves the lock; anything older than the wake timeout is stale.
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +"$(( $(cfg .wake_timeout_minutes) + 5 ))" 2>/dev/null)" ]; then
      rmdir "$lock"; mkdir "$lock"
    else note "another tick is running"; return 1; fi
  fi
  trap 'rmdir "$HOME_DIR/tick.lock" 2>/dev/null || true' EXIT
  return 0
}

cmd_alarm(){
  BW_WORKFLOW=blocker_watch_alarm
  [ "${1:-}" != --dry-run ] || DRY=1
  alarm_on || die "the unowned-blocker alarm is disabled in the config"
  lock_take || return 0
  alarm_scan "$DRY"
  [ "$FAILED" = 0 ] || { note "alarm finished with failures"; exit 1; }
}

cmd_links(){
  BW_WORKFLOW=blocker_watch_links
  [ "${1:-}" != --dry-run ] || DRY=1
  links_on || die "blocked-by link maintenance is disabled in the config"
  lock_take || return 0
  maintain_links "$DRY"
  [ "$FAILED" = 0 ] || { note "links finished with failures"; exit 1; }
}

cmd_tick(){
  BW_WORKFLOW=blocker_watch_tick
  # The offline suite never mints real tokens.
  [ "${AI_DEVOPS_TEST_MODE:-0}" = 1 ] || BW_APP=1
  [ "${1:-}" != --dry-run ] || DRY=1
  lock_take || return 0
  local tick_started_ms='' tick_elapsed_ms=''
  BW_TICK_RECEIPT_ID=''
  BW_TICK_CONTEXT=''
  if [ "$GH_COST_READY" = 1 ] && [ "$DRY" != 1 ]; then
    BW_TICK_RECEIPT_ID="$(gh_measure_workflow_id)" || note 'request measurement unavailable: tick ID not created'
    gh_measure_clock; tick_started_ms="$GH_MEASURE_CLOCK"
    # One read-only local lookup per tick; unknown identity stays unattributed.
    if [ -x "$TOOL_ROOT/tools/github-requests/pr-status-context" ]; then
      BW_TICK_CONTEXT="$("$TOOL_ROOT/tools/github-requests/pr-status-context" 2>/dev/null || true)"
    fi
  fi
  # Scans that are due run first, so their open-issue snapshot also answers
  # propagate and wake this tick instead of per-item REST reads.
  local early=""
  if { links_on && scan_due "$LAST_LINKS" "$(cfgd .links_interval_minutes 60)"; } ||
     { alarm_on && scan_due "$LAST_ALARM" "$(cfgd .alarm_interval_minutes 60)"; }; then early=early; fi
  maybe_links "$early"
  maybe_alarm "$early"
  propagate
  local f
  for f in "$WAITS"/*.json; do
    [ -e "$f" ] || continue
    [ "$(jq -r .state "$f")" = waiting ] || continue
    wake "$f"
  done
  stuck_watchdog_scan
  # Housekeeping: archive dead task/session state past its TTL. Local-only,
  # cheap, bounded; never touches waiting records or reviewer leases.
  reap_fixer_pids 0
  local reap_n=0 reap_ttl reap_max reap_f
  reap_ttl="$(cfgd .orphan_ttl_hours 24)"; reap_max="$(cfgd .reap_max_per_run 64)"
  for reap_f in "$WAITS"/*.json; do
    [ -e "$reap_f" ] || continue
    [ "$reap_n" -lt "$reap_max" ] || break
    if reap_one "$reap_f" 0; then reap_n=$((reap_n + 1)); fi
  done
  [ "$reap_n" -eq 0 ] || note "tick reaped $reap_n aged task/session record(s)"
  [ "$FAILED" = 0 ] || { note "tick finished with failures"; exit 1; }
  if [ -n "$BW_TICK_RECEIPT_ID" ]; then
    gh_measure_clock
    tick_elapsed_ms=$(( GH_MEASURE_CLOCK - tick_started_ms ))
    [ "$tick_elapsed_ms" -ge 0 ] || tick_elapsed_ms=0
    gh_measure_workflow_outcome ai-blocker-watch blocker_watch_tick "$BW_TICK_RECEIPT_ID" completed "$tick_elapsed_ms" ||
      note 'request measurement unavailable: tick outcome not saved'
  fi
}


TASK_NAME='ai-devops\blocker-watch'
CRON_MARKER='# ai-devops blocker-watch (managed by ai-blocker-watch schedule; unschedule removes)'
# Every machine used to tick on the same wall-clock minute, so their GitHub
# reads landed in one burst and tripped GitHub's per-user rate limit. Each
# machine now ticks at its own stable minute offset derived from its hostname.
tick_offset(){ # tick_offset <every>: 0..every-1, stable per machine
  local every="$1" sum
  [ "$every" -gt 1 ] 2>/dev/null || { printf 0; return; }
  sum="$(printf '%s' "$(hostname 2>/dev/null || printf unknown)" | cksum | cut -d' ' -f1)"
  printf '%s' "$(( sum % every ))"
}
cron_job_line(){
  local every off; every="$(cfg .schedule_every_minutes)"; off="$(tick_offset "$every")"
  printf '%s-59/%s * * * * %s tick >> %s 2>&1' "$off" "$every" "'$TOOL_ROOT/bin/ai-blocker-watch'" "'$HOME_DIR/tick.log'"
}
cmd_schedule(){
  local every self
  every="$(cfg .schedule_every_minutes)"
  if command -v schtasks.exe >/dev/null 2>&1; then
    local bash_exe
    bash_exe="$(cygpath -w "$(command -v bash)")"; self="$(cygpath -m "$TOOL_ROOT/bin/ai-blocker-watch")"
    # conhost --headless keeps a console window from flashing every run.
    # /F re-points an existing task, so rerunning the installer stays safe.
    MSYS2_ARG_CONV_EXCL='*' schtasks.exe /Create /F /SC MINUTE /MO "$every" /ST "$(printf '00:%02d' "$(tick_offset "$every")")" /TN "$TASK_NAME" \
      /TR "conhost.exe --headless \"$bash_exe\" -lc \"'$self' tick >> ~/.ai-devops/blocker-watch/tick.log 2>&1\"" >/dev/null
    note "scheduled every $every minutes as $TASK_NAME"
    return
  fi
  # Linux/macOS: the same command installs a marked, idempotent USER crontab
  # entry, so the machine install path is one command on every platform.
  command -v crontab >/dev/null || die "schedule needs schtasks (Windows) or crontab (Linux/macOS); neither is available"
  local tmp; tmp="$(mktemp)"
  { crontab -l 2>/dev/null | grep -vF "$CRON_MARKER" | grep -vF "'$TOOL_ROOT/bin/ai-blocker-watch' tick" || :; } >> "$tmp"
  printf '%s\n%s\n' "$CRON_MARKER" "$(cron_job_line)" >> "$tmp"
  local rc=0; crontab "$tmp" || rc=$?; rm -f "$tmp"
  [ "$rc" -eq 0 ] || die "crontab refused the blocker-watch entry"
  note "scheduled every $every minutes in the user crontab"
}
cmd_unschedule(){
  if command -v schtasks.exe >/dev/null 2>&1; then
    MSYS2_ARG_CONV_EXCL='*' schtasks.exe /Delete /F /TN "$TASK_NAME" >/dev/null; note "removed $TASK_NAME"
    return
  fi
  command -v crontab >/dev/null || die "unschedule needs schtasks (Windows) or crontab"
  local tmp; tmp="$(mktemp)"
  { crontab -l 2>/dev/null | grep -vF "$CRON_MARKER" | grep -vF "'$TOOL_ROOT/bin/ai-blocker-watch' tick" || :; } > "$tmp"
  local rc=0; crontab "$tmp" || rc=$?; rm -f "$tmp"
  [ "$rc" -eq 0 ] || die "crontab refused the removal"
  note "removed the blocker-watch crontab entry"
}

case "${1:-}" in
  wait) shift; cmd_wait "$@" ;;
  link) shift; [ $# -eq 2 ] || die "usage: link <blocked owner/repo#M> <blocker owner/repo#N>"; link "$1" "$2" ;;
  list) cmd_list ;;
  find) shift; cmd_find "$@" ;;
  has-wait) shift; cmd_has_wait "$@" ;;
  cancel) shift; cmd_cancel "$@" ;;
  reap) shift; cmd_reap "$@" ;;
  tick) shift; cmd_tick "$@" ;;
  alarm) shift; cmd_alarm "$@" ;;
  links) shift; cmd_links "$@" ;;
  schedule) cmd_schedule ;;
  unschedule) cmd_unschedule ;;
  -h|--help|help) sed -n '2,112p' "$_self" | sed 's/^# \{0,1\}//' ;;  *) die "unknown command; see ai-blocker-watch --help" ;;
esac
