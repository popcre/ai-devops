# Candidate reviewer entries built from the shared route registry
# (config/reviewer-routes.json; #2549/#2550). Explicitly selectable, never in
# ROTATION: existing defaults are unchanged. The deepseek-openrouter route
# swaps the engine per call; see spec_for().
for _rid in ("muse-openrouter", "hy4-openrouter"):
    _spec = RR.opencode_spec(_rid)
    PROVIDERS[_spec["route"]] = _spec
del _rid, _spec


def spec_for(provider, route=None):
    """The runtime spec for a provider call, or an explicit candidate route.

    A route overrides the legacy provider spec (engine included); anything
    unknown is refused, never defaulted."""
    if route:
        rspec = RR.route(route)  # RouteError on unknown ids
        if rspec["reviewer"] != provider and provider != route:
            raise RR.RouteError(f"route {route} does not belong to reviewer {provider!r}")
        spec = {"model": rspec["model"], "key_file": rspec["key_file"],
                "key_env": rspec["key_env"], "override": rspec["override"],
                "timeout": int(rspec["timeout"]), "route": route, "engine": rspec["engine"],
                "reviewer": rspec["reviewer"], "base_url": rspec.get("base_url")}
        if rspec["engine"] == "opencode":
            spec["provider"] = RR.opencode_provider_block(rspec)
        else:
            spec["provider"] = None
        return spec
    spec = dict(PROVIDERS[provider])
    spec.setdefault("engine", "opencode")
    return spec


AGENT = """---
description: Read-only simple reviewer
mode: primary
tools:
  write: false
  edit: false
  patch: false
  bash: false
  webfetch: false
  task: false
---

You are a read-only independent code reviewer. Inspect local files and report
concrete findings with paths. Never change files or claim that you ran
anything. End with exactly one final line: VERDICT: APPROVE, VERDICT: REJECT
or VERDICT: REVISE.
"""

# Anchored to a status/code word so "line 429" or a bare "quota" is not credit.
CREDIT_RE = re.compile(
    r"\b(?:status|code|http|error)[\"' :=]{0,4}(?:402|429|1113)\b|insufficient[ _]balance|"
    r"out of credits?|exceeded your current quota|(?:quota|allowance)\s+(?:exceeded|exhausted|used up)|"
    r"rate[ _-]?limit(?:ed| exceeded)|payment required", re.I)
SECRET_RE = re.compile(r"(?i)\b(\w*(?:API_KEY|TOKEN|SECRET|PASSWORD)\w*)(\s*[=:]\s*)[\"']?[^\s\"',}]+"
                       r"|\bBearer\s+[A-Za-z0-9._~+/=-]+")


MODELS_URL = "https://models.dev/api.json"
MODELS_MAX_AGE = 24 * 3600


def models_cache_path():
    return os.environ.get("AI_OPENCODE_MODELS_CACHE") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
        "ai-devops", "opencode", "models.json")


def seed_models(xdg, env):
    """Give a fresh isolated OpenCode tree a current model catalogue.

    OpenCode's first run in an empty cache uses its bundled catalogue, which can
    lack a newly pinned model (ProviderModelNotFoundError). Refresh a shared
    per-user copy when missing or older than a day; if offline, keep the old
    copy; with no copy at all, leave OpenCode to its bundled list."""
    shared = models_cache_path()
    try:
        age = time.time() - os.path.getmtime(shared)
    except OSError:
        age = None
    if age is None or age > MODELS_MAX_AGE:
        url = os.environ.get("AI_OPENCODE_MODELS_URL") or MODELS_URL
        try:
            import urllib.request
            # models.dev refuses Python's default user agent (HTTP 403).
            req = urllib.request.Request(url, headers={"User-Agent": "ai-devops-opencode"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = resp.read()
            if not isinstance(json.loads(data), dict):
                raise ValueError("not a catalogue")
            os.makedirs(os.path.dirname(shared), exist_ok=True)
            tmp = shared + f".{os.getpid()}.tmp"
            with open(tmp, "wb") as fh:
                fh.write(data)
            os.replace(tmp, shared)
        except Exception:  # offline or bad reply: fall back to any older copy
            pass
    if not os.path.isfile(shared):
        return None
    dest = os.path.join(xdg, "cache", "opencode", "models.json")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copyfile(shared, dest)
    env["OPENCODE_MODELS_PATH"] = dest
    return dest


def redact(text, key=None):
    """Mask credential-shaped text before it reaches the artifact or the PR."""
    if key and len(key) >= 6:
        text = text.replace(key, "[REDACTED]")
    return SECRET_RE.sub(lambda m: (m.group(1) + m.group(2) + "[REDACTED]") if m.group(1)
                         else "Bearer [REDACTED]", text)
# A lone leading space is a diff context line, never the reviewer's own verdict.
VERDICT_RE = re.compile(r"^(?! \S)[\s>*_#`]*VERDICT\s*:\s*\**\s*(APPROVE|REJECT|REVISE)\b", re.I)


def parse_verdict(text):
    """Return the last VERDICT outside code fences, or None."""
    verdict, fenced = None, False
    for line in (text or "").splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if fenced:
            continue
        m = VERDICT_RE.match(line)
        if m:
            verdict = m.group(1).upper()
    return verdict


def is_credit_error(text):
    return bool(text and CREDIT_RE.search(text))


def read_events(stdout):
    """Return OpenCode text, final message, errors and an explicit stop failure.

    The final message is the text after the reviewer's last step or tool
    call: its report, without the narration that came before it."""
    texts, errors, current, final = [], [], [], []
    stop_failure = None
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if ev.get("type") == "text":
            part = ev.get("part") or {}
            value = part.get("text") if isinstance(part, dict) else None
            if isinstance(value, str) and value:
                texts.append(value)
                current.append(value)
                final = current
        elif ev.get("type") == "error":
            errors.append(json.dumps(ev.get("error", ev))[:2000])
        elif ev.get("type") == "step_finish":
            part = ev.get("part")
            reason = part.get("reason") if isinstance(part, dict) else None
            if reason == "stop" and current:
                stop_failure = None
            elif reason in ("length", "content-filter", "error"):
                stop_failure = reason
        elif ev.get("type") in ("step_start", "tool_use"):
            current = []
    return "\n".join(texts), "\n".join(final), "\n".join(errors), stop_failure


def cache_receipts(stdout):
    """Sum reported cache counters, leaving unreported fields unknown.

    These are observed subtotals, not estimates for unreported steps. Only
    nonnegative integer counts are usable; an explicit zero is a measurement.
    """
    reads = writes = None
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict) or ev.get("type") != "step_finish":
            continue
        part = ev.get("part")
        tokens = part.get("tokens") if isinstance(part, dict) else None
        cache = tokens.get("cache") if isinstance(tokens, dict) else None
        if not isinstance(cache, dict):
            continue
        read, write = cache.get("read"), cache.get("write")
        if type(read) is int and read >= 0:
            reads = (reads or 0) + read
        if type(write) is int and write >= 0:
            writes = (writes or 0) + write
    return {"read": reads, "write": writes}


def final_report(final, full):
    """The findings to publish: the final message without VERDICT lines, capped."""
    text = final if parse_verdict(final) or not parse_verdict(full) else full
    lines = [ln for ln in (text or "").splitlines() if not VERDICT_RE.match(ln)]
    out = redact("\n".join(lines).strip())
    return out if len(out) <= MAX_FINDINGS else out[:MAX_FINDINGS] + "\n[findings truncated]"


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], check=True, capture_output=True,
                          text=True, encoding="utf-8", errors="replace").stdout


def resolve_opencode():
    override = os.environ.get("AI_REVIEW_SIMPLE_OPENCODE")
    if override:
        return override
    try:
        with open(os.path.join(ROOT, "config", "opencode", "version")) as fh:
            ver = fh.read().strip()
        pinned = os.path.expanduser(
            f"~/.local/lib/ai-devops/opencode/{ver}/node_modules/opencode-ai/bin/opencode.exe")
        if os.access(pinned, os.X_OK):
            return pinned
    except OSError:
        pass
    return shutil.which("opencode")


def resolve_antigravity():
    """The Google Antigravity CLI (`agy`): explicit override, PATH, then standard install paths."""
    override = os.environ.get("AI_REVIEW_SIMPLE_AGY") or os.environ.get("AI_AGY_CLI")
    if override:
        if os.path.isfile(override) and (os.name == "nt" or os.access(override, os.X_OK)):
            return override
        return None
    found = shutil.which("agy")
    if found:
        return found
    if os.name == "nt" and os.environ.get("LOCALAPPDATA"):
        win_cli = os.path.join(os.environ["LOCALAPPDATA"], "agy", "bin", "agy.exe")
        if os.path.isfile(win_cli):
            return win_cli
    unix_cli = os.path.expanduser("~/.local/bin/agy")
    if os.path.isfile(unix_cli) and os.access(unix_cli, os.X_OK):
        return unix_cli
    return None


def antigravity_model(spec):
    return os.environ.get("AI_ANTIGRAVITY_MODEL") or spec["model"]


def read_antigravity_result(stdout):
    """Parse `agy --output-format json` stdout into (response, conversation_id, error).

    Tolerates leading non-JSON warning lines before a single- or multi-line JSON
    payload. Only status == 'SUCCESS' with a non-empty response counts as an answer."""
    text = (stdout or "").strip()
    if not text:
        return "", None, "empty output"
    data = None
    try:
        data = json.loads(text)
    except ValueError:
        idx = text.find("{")
        while idx != -1:
            try:
                data = json.loads(text[idx:])
                break
            except ValueError:
                idx = text.find("{", idx + 1)
    if not isinstance(data, dict):
        return "", None, text[:500]
    cid = data.get("conversation_id") or None
    status = str(data.get("status") or "").upper()
    response = data.get("response") if isinstance(data.get("response"), str) else ""
    err = str(data.get("error") or "").strip()
    if status != "SUCCESS" or not response.strip():
        return "", cid, err or f"status={status or 'unknown'}"
    return response, cid, ""


def read_key(name):
    spec = PROVIDERS[name] if isinstance(name, str) else name
    if spec.get("override") and os.environ.get(spec["override"]):
        return os.environ[spec["override"]]
    if not spec.get("key_file"):
        return None
    secrets = os.environ.get("AI_REVIEW_SIMPLE_SECRETS_DIR",
                             os.path.expanduser("~/.config/ai-devops/secrets"))
    try:
        with open(os.path.join(secrets, spec["key_file"])) as fh:
            raw = fh.read().strip()
    except OSError:
        return None
    if spec["key_file"].endswith(".json"):
        try:
            return json.loads(raw).get("key") or None
        except (ValueError, AttributeError):
            return None
    return raw.splitlines()[0] if raw else None


LEAN_REVIEW = """Review only this change in a read-only checkout. Read local evidence as needed.
Report correctness, security, compatibility, and changed-behavior test defects
with file, line, and impact. Omit style preferences. Never edit files.
End with exactly one final line: VERDICT: APPROVE (safe to merge),
VERDICT: REJECT (must not merge), or VERDICT: REVISE (needs specific fixes).
Use the word VERDICT only on that last line.

"""
CONCISE_REVIEW = (
    "For each finding give only the file and line, defect, and impact. "
    "Include every material finding. Omit progress narration and repeated patch text.\n\n"
)


def build_prompt(repo, base, head, variant=None):
    with open(TEMPLATE) as fh:
        tpl = fh.read()
    diff = git(repo, "diff", f"{base}...{head}")
    if variant == "lean":
        _, heading, scope = tpl.partition("## Review scope")
        if not heading:
            raise RR.RouteError("review template is missing its scope section")
        tpl = LEAN_REVIEW + heading + scope
    if variant == "concise":
        tpl = CONCISE_REVIEW + tpl
    if len(diff) > MAX_DIFF:
        diff = diff[:MAX_DIFF] + "\n[diff truncated; read the files directly]\n"
    stat_text = git(repo, "diff", "--stat", f"{base}...{head}")
    if len(stat_text) > MAX_STAT:
        stat_text = stat_text[:MAX_STAT] + "\n[stat truncated]\n"
    # A fence longer than any backtick run in the diff, so PR text cannot close it.
    runs = [len(m) for m in re.findall(r"`{3,}", diff)]
    fence = "`" * max([3] + [n + 1 for n in runs])
    for k, v in (("{fence}", fence), ("{base}", base), ("{head}", head), ("{stat}", stat_text)):
        tpl = tpl.replace(k, v)
    return tpl.replace("{diff}", diff)  # last, so diff text is never rescanned


def _force_rmtree(path):
    def onerror(func, p, _exc):
        try:
            os.chmod(p, stat.S_IRWXU)
            os.chmod(os.path.dirname(p), stat.S_IRWXU)
            func(p)
        except OSError:
            pass
    shutil.rmtree(path, onerror=onerror)


def make_workspace(repo, head, provider, tmp, spec=None, cache=None, affinity_id=None):
    work = os.path.join(tmp, "work")
    subprocess.run(["git", "clone", "--quiet", "--no-checkout", "--no-hardlinks", repo, work],
                   check=True, capture_output=True)
    subprocess.run(["git", "-C", work, "checkout", "--quiet", "--detach", head],
                   check=True, capture_output=True)
    subprocess.run(["git", "-C", work, "remote", "remove", "origin"], capture_output=True)
    for d, _dirs, files in os.walk(work):
        for f in files:
            p = os.path.join(d, f)
            if not os.path.islink(p):
                os.chmod(p, stat.S_IRUSR | stat.S_IRGRP)
    spec = spec or PROVIDERS[provider]
    home = os.path.join(tmp, "home")
    os.makedirs(home)
    if spec.get("engine") == "antigravity":
        return work, home
    if spec.get("engine") == "deepseek-harness":
        # A fresh private harness profile: only this route's adapter and model.
        profiles = os.path.join(tmp, "dsh", "profiles", "headless")
        os.makedirs(profiles)
        with open(os.path.join(profiles, "cordis.patch.yml"), "w") as fh:
            fh.write(RR.harness_patch_yaml(spec, affinity_id))
        return work, home
    cfg_dir = os.path.join(tmp, "xdg", "config", "opencode")
    os.makedirs(os.path.join(cfg_dir, "agent"))
    cfg = {"$schema": "https://opencode.ai/config.json", "model": spec["model"],
           "share": "disabled", "autoupdate": False}
    if spec["provider"]:
        cfg["provider"] = spec["provider"]
        if (cache or affinity_id) and spec.get("route"):
            cfg["provider"] = RR.opencode_provider_block(RR.route(spec["route"]),
                                                         cache=cache, affinity_id=affinity_id)
    with open(os.path.join(cfg_dir, "opencode.json"), "w") as fh:
        json.dump(cfg, fh, indent=1)
    with open(os.path.join(cfg_dir, "agent", "simple-review.md"), "w") as fh:
        fh.write(AGENT)
    return work, home


def run_once(provider, prompt, work, home, tmp, key, timeout, spec=None, observe=None):
    """One attempt. Returns (verdict, text, error)."""
    spec = spec or PROVIDERS[provider]
    if spec.get("engine") == "antigravity":
        return run_antigravity_once(spec, prompt, work, timeout, observe=observe)
    if spec.get("engine") == "deepseek-harness":
        return run_harness_once(spec, prompt, work, tmp, key, timeout, observe=observe)
    oc = resolve_opencode()
    if not oc:
        return None, "", "local: opencode binary not found", None
    xdg = os.path.join(tmp, "xdg")
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": home,
           "XDG_CONFIG_HOME": os.path.join(xdg, "config"),
           "XDG_DATA_HOME": os.path.join(xdg, "data"),
           "XDG_STATE_HOME": os.path.join(xdg, "state"),
           "XDG_CACHE_HOME": os.path.join(xdg, "cache"),
           "OPENCODE_DISABLE_CLAUDE_CODE": "1", "OPENCODE_DISABLE_EXTERNAL_SKILLS": "1",
           "PYTHONDONTWRITEBYTECODE": "1", spec["key_env"]: key}
    env.update({n: os.environ[n] for n in ("LANG", "TMPDIR", "SSL_CERT_FILE", "SSL_CERT_DIR",
                "NODE_EXTRA_CA_CERTS", "AI_REVIEW_SIMPLE_FAKE_STATE", "SYSTEMROOT", "WINDIR",
                "TEMP", "TMP", "PATHEXT", "COMSPEC") if os.environ.get(n)})
    # Windows fail-fast repair (#2531, 2026-11-17): without SYSTEMROOT the pinned
    # OpenCode binary dies with 0xC0000409 before any output, so every
    # OpenCode-engine review route crashed on Windows (the deepseek-harness
    # engine and bin/ai-second-opinion were unaffected). Same qualified
    # passthrough set as bin/ai-second-opinion:_run_opencode_turn; on Linux the
    # vars are absent and nothing is added.
    seed_models(xdg, env)
    cmd = [oc, "run", "--agent", "simple-review", "--auto", "--format", "json",
           "--model", spec["model"], "--dir", work]
    proc = subprocess.Popen(cmd, cwd=work, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, start_new_session=True)
    try:
        out, err = proc.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            if hasattr(os, "killpg"):
                os.killpg(proc.pid, signal.SIGKILL)
            else:  # Windows
                proc.kill()
        except OSError:
            pass
        out, _ = proc.communicate()
        if observe:
            observe(out, "timeout")
        return None, "", f"timeout after {timeout}s", None
    full, final, ev_err, stop_failure = read_events(out)
    if stop_failure:
        full = final = ""
        ev_err = f"{ev_err}\nincomplete reviewer output: {stop_failure}".strip()
    text = final_report(final, full)
    verdict = parse_verdict(final) or parse_verdict(full)
    if observe:
        observe(out, "verdict" if verdict else "failed")
    if verdict:
        return verdict, text, None, cache_receipts(out)
    problem = redact("\n".join(x for x in (ev_err, (err or "")[-2000:]) if x.strip()), key)
    if is_credit_error(problem):
        return None, text, "out-of-credit: " + problem[:500], cache_receipts(out)
    return None, text, (f"no verdict (exit {proc.returncode}): " + problem[:500]).strip(), cache_receipts(out)


def read_harness_events(stdout):
    """Split dsh --json NDJSON into (final text, error text).

    Only a completed final assistant event counts: tool narration, error
    events and a final error reason are never a verdict."""
    final, errors = "", []
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if ev.get("type") == "error":
            errors.append(json.dumps(ev.get("error", ev.get("message", ev)))[:2000])
        elif ev.get("type") == "final":
            reason = (ev.get("reason") or {})
            if isinstance(reason, dict) and reason.get("kind") == "completed":
                text = ev.get("text")
                if isinstance(text, str) and text.strip() and not final:
                    final = text
                else:
                    errors.append("invalid or duplicate final response")
            else:
                detail = reason.get("error") if isinstance(reason, dict) else reason
                errors.append(json.dumps(detail or reason or "final without completion")[:2000])
    return final if not errors else "", "\n".join(errors)


def run_harness_once(spec, prompt, work, tmp, key, timeout, observe=None):
    """One DeepSeek Harness attempt through the shared route adapter (#2549).

    Runs the pinned headless profile with a private DSH_HOME, the task on
    stdin, no approvals and a minimal environment holding only this route's
    credential."""
    dsh = RR.resolve_deepseek_harness()
    if not dsh:
        return None, "", "local: deepseek harness binary not found", None
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.path.join(tmp, "home"),
           "DSH_HOME": os.path.join(tmp, "dsh"), spec["key_env"]: key,
           "PYTHONDONTWRITEBYTECODE": "1", "OPENCODE_DISABLE_CLAUDE_CODE": "1",
           "OPENCODE_DISABLE_EXTERNAL_SKILLS": "1"}
    env.update({n: os.environ[n] for n in ("LANG", "TMPDIR", "TEMP", "TMP", "SYSTEMROOT",
                "COMSPEC", "PATHEXT", "WINDIR", "SSL_CERT_FILE", "SSL_CERT_DIR",
                "NODE_EXTRA_CA_CERTS", "AI_REVIEW_SIMPLE_FAKE_STATE") if os.environ.get(n)})
    if os.name == "nt":
        env["USERPROFILE"] = env["HOME"]
    cmd = [dsh, "--profile", "headless", "--json", "--permission-mode", "read-only",
           "--approval-policy", "never", "-"]
    proc = subprocess.Popen(cmd, cwd=work, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, encoding="utf-8", errors="replace",
                            start_new_session=True)
    try:
        out, err = proc.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            if hasattr(os, "killpg"):
                os.killpg(proc.pid, signal.SIGKILL)
            else:  # Windows
                proc.kill()
        except OSError:
            pass
        out, _ = proc.communicate()
        if observe:
            observe(out, "timeout")
        return None, "", f"timeout after {timeout}s", None
    final, ev_err = read_harness_events(out)
    verdict = parse_verdict(final)
    if observe:
        observe(out, "verdict" if verdict else "failed")
    if verdict:
        return verdict, final_report(final, final), None, {"read": None, "write": None}
    problem = redact("\n".join(x for x in (ev_err, (err or "")[-2000:]) if x.strip()), key)
    if is_credit_error(problem):
        return None, final_report(final, final), "out-of-credit: " + problem[:500], None
    return None, final_report(final, final), (f"no verdict (exit {proc.returncode}): "
                                              + problem[:500]).strip(), None


def run_antigravity_once(spec, prompt, work, timeout, observe=None):
    """One read-only Google Antigravity + Gemini attempt via `agy`."""
    agy = resolve_antigravity()
    if not agy:
        return None, "", "local: antigravity CLI (agy) not found", None
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "PYTHONDONTWRITEBYTECODE": "1"}
    for n in ("HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "XDG_CONFIG_HOME",
              "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "LANG", "TMPDIR",
              "TEMP", "TMP", "SYSTEMROOT", "COMSPEC", "PATHEXT", "WINDIR",
              "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS",
              "AI_REVIEW_SIMPLE_FAKE_STATE"):
        if os.environ.get(n):
            env[n] = os.environ[n]
    # Inherit user HOME/profile so `agy` can read its OAuth store (~/.gemini/antigravity/);
    # read-only isolation is enforced by `--mode plan` plus chmod 440 on the private work copy.
    cmd = [agy, "--mode", "plan", "--model", antigravity_model(spec), "--output-format", "json",
           "--print-timeout", f"{timeout}s"]
    proc = subprocess.Popen(cmd, cwd=work, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, encoding="utf-8", errors="replace",
                            start_new_session=hasattr(os, "killpg"))
    try:
        out, err = proc.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            if hasattr(os, "killpg"):
                os.killpg(proc.pid, signal.SIGKILL)
            elif os.name == "nt":
                subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                               capture_output=True)
            else:
                proc.kill()
        except OSError:
            pass
        try:
            out, _ = proc.communicate(timeout=10)
        except Exception:
            out = ""
        if observe:
            observe(out, "timeout")
        return None, "", f"timeout after {timeout}s", None
    response, _cid, ev_err = read_antigravity_result(out)
    verdict = parse_verdict(response)
    if observe:
        observe(out, "verdict" if verdict else "failed")
    if verdict:
        return verdict, final_report(response, response), None, {"read": None, "write": None}
    problem = redact("\n".join(x for x in (ev_err, (err or "")[-2000:]) if x.strip()))
    if is_credit_error(problem):
        return None, final_report(response, response), "out-of-credit: " + problem[:500], None
    return None, final_report(response, response), (f"no verdict (exit {proc.returncode}): "
                                                    + problem[:500]).strip(), None


def review(args):
    start = time.monotonic()
    route = getattr(args, "route", None)
    receipts = None
    provider = args.provider
    if route and not provider:
        provider = RR.route(route)["reviewer"]
    spec = spec_for(provider, route)
    result = {"provider": route or provider, "head": args.head, "verdict": None,
              "findings": "", "elapsed": 0, "error": None}
    if route:
        result["route"], result["engine"] = route, spec["engine"]
    variant = os.environ.get("AI_REVIEW_PROMPT_VARIANT") if route else None
    attempts = None
    billing_id = RR.billing_session_id() if route else None
    if route and os.environ.get("AI_REVIEW_USAGE") == "1":
        attempts = result["usage_attempts"] = []

    def observe(stdout, outcome):
        from reviewer_usage import reviewer_attempt

        attempts.append(reviewer_attempt(
            stdout, route=route, model=spec["model"], engine=spec["engine"],
            outcome=outcome, elapsed=time.monotonic() - attempt_start,
            billing_id=billing_id if spec.get("base_url") == RR.OPENROUTER_URL else None,
        ))

    def finish(code):
        result["elapsed"] = round(time.monotonic() - start, 1)
        with open(args.out, "w") as fh:
            json.dump(result, fh, indent=1)
        print(json.dumps({k: result[k] for k in ("provider", "verdict", "elapsed", "error")}))
        return code

    if variant not in (None, "lean", "concise"):
        result["error"] = "refused: unknown reviewer prompt variant"
        return finish(2)

    try:
        actual = git(args.repo, "rev-parse", "HEAD").strip()
        head = git(args.repo, "rev-parse", "--verify", args.head + "^{commit}").strip()
        base = git(args.repo, "rev-parse", "--verify", args.base + "^{commit}").strip()
    except subprocess.CalledProcessError as exc:
        result["error"] = "refused: " + (exc.stderr or "git failed").strip()[:300]
        return finish(2)
    if actual != head:
        result["error"] = f"refused: head mismatch (checkout {actual}, requested {head})"
        return finish(2)
    result["head"] = head
    key = None
    if spec.get("engine") != "antigravity":
        key = read_key(spec)
        if not key:
            result["error"] = "local: credential missing"
            return finish(3)
    timeout = args.timeout or spec["timeout"]
    tmp = None
    try:
        prompt = build_prompt(args.repo, base, head, variant)
        tmp = tempfile.mkdtemp(prefix=f"ai-review-simple-{result['provider']}-")
        cache_fields = RR.cache_fields(route, args.repo, head) if route else None
        if cache_fields and variant:
            cache_fields["prompt_cache_key"] += "-" + variant
        affinity_id = billing_id or RR.cache_affinity_id(route, args.repo, head)
        work, home = make_workspace(args.repo, head, provider, tmp, spec=spec,
                                    cache=cache_fields, affinity_id=affinity_id)
        receipts = None
        for _attempt in range(2):  # retry once, never on credit, timeout or refusal
            attempt_start = time.monotonic()
            verdict, text, error, receipts = run_once(provider, prompt, work, home, tmp,
                                                      key, timeout, spec=spec,
                                                      observe=observe if attempts is not None else None)
            if verdict or (error or "").startswith(("out-of-credit", "timeout", "local:")) \
                    or (error and RR.classify(error)[0] == "terminal"):
                break
    except RR.RouteError as exc:
        result["error"] = f"refused: {exc}"
        return finish(2)
    except (subprocess.CalledProcessError, OSError, UnicodeError) as exc:
        detail = getattr(exc, "stderr", None) or str(exc)
        if isinstance(detail, bytes):
            detail = detail.decode("utf-8", "replace")
        result["error"] = "local: " + redact(f"{type(exc).__name__}: {detail}".strip(), key)[:300]
        return finish(3)
    finally:
        if tmp:
            _force_rmtree(tmp)
    result["findings"] = text
    result["verdict"], result["error"] = verdict, error
    if error and error.startswith("out-of-credit"):
        result["error"] = "out-of-credit"
        result["detail"] = error[len("out-of-credit: "):]
    if route and RR.cache_enabled():
        result["cache"] = receipts or {"read": None, "write": None}
    if route and not verdict and error and RR.classify(error)[0] == "terminal":
        result["error"] = "refused: " + (result.get("detail") or error)[:300]
        result.pop("detail", None)
        return finish(2)  # a policy or read-only refusal is terminal, never retried elsewhere
    return finish(0 if verdict else 3)


ROTATION = ("muse", "glm", "deepseek", "stepfun", "antigravity")


def rotation(pr):
    """REVISION rule 2: one reviewer per PR, PR number mod len(ROTATION), then fall through."""
    start = int(pr) % len(ROTATION)
    return list(ROTATION[start:] + ROTATION[:start])


def run_plan(args):
    """Candidate mode (#2549/#2550): run an ordered route plan against one head.

    One result file per attempt plus results/order. A verdict ends the plan, a
    terminal refusal stops it, and a confirmed shared OpenRouter outage skips
    the remaining OpenRouter routes without spending their attempts."""
    os.makedirs(args.results_dir, exist_ok=True)
    known = RR.routes()
    openrouter_routes = {rid for rid, spec in known.items()
                         if spec.get("base_url") == RR.OPENROUTER_URL}
    order_path = os.path.join(args.results_dir, "order")
    with open(order_path, "w") as fh:
        pass
    shared_outage = False
    for entry in (args.run_plan or "").split():
        rid = entry if entry in known else None
        with open(order_path, "a") as fh:
            fh.write(entry + "\n")
        out = os.path.join(args.results_dir, f"{entry}.json")
        if shared_outage and rid in openrouter_routes:
            with open(out, "w") as fh:
                json.dump({"provider": entry, "head": args.head, "verdict": None, "findings": "",
                           "elapsed": 0, "error": "skipped: shared OpenRouter outage"}, fh)
            print(f"{entry}: skipped (shared OpenRouter outage)")
            continue
        one = argparse.Namespace(provider=RR.route(rid)["reviewer"] if rid else entry,
                                 route=rid, repo=args.repo, base=args.base, head=args.head,
                                 out=out, timeout=args.timeout)
        try:
            code = review(one)
        except RR.RouteError as exc:
            code = 2
            with open(out, "w") as fh:
                json.dump({"provider": entry, "head": args.head, "verdict": None, "findings": "",
                           "elapsed": 0, "error": f"refused: {exc}"}, fh, indent=1)
        print(f"{entry}: exit {code} (0 verdict, 3 unavailable, 2 refused)")
        if code == 0 or code == 2:
            break
        if rid in openrouter_routes:
            try:
                with open(out) as fh:
                    error = (json.load(fh) or {}).get("error") or ""
            except (OSError, ValueError):
                error = ""
            if RR.classify(error)[1] == "shared-outage":
                shared_outage = True
    return 0



def is_docs_path(path):
    path = path.strip().lstrip("./")
    if path.startswith(("docs/", "HANDOFF.d/")):
        return True
    name = path.rsplit("/", 1)[-1]
    if not name.endswith(".md"):
        return False
    return not (name.startswith("plan_") or name == "IMPLEMENTATION-PLAN.md")


def is_docs_only(paths):
    """REVISION rule 4. An empty list is not docs-only: review it."""
    paths = [p for p in paths if p.strip()]
    return bool(paths) and all(is_docs_path(p) for p in paths)


def combine(results, head=None, routes=None):
    """Advisory rule: the first finished verdict for this head decides.
    APPROVE is pass, REJECT or REVISE is findings, none is neutral.
    No state is ever a failure. In candidate mode (routes given) a verdict is
    counted only when its row's route id is one of the registry routes asked
    to run: a spoofed route name publishes nothing."""
    rows, approve, reject, state = [], 0, 0, "neutral"
    for r in results:
        v = (r.get("verdict") or "").upper()
        if v not in VERDICTS or (head and r.get("head") != head):
            v = ""
        spoofed = False
        if routes is not None and r.get("route"):
            spoofed = r["route"] not in routes or r.get("provider") != r["route"]
            if spoofed:
                v = ""
        if v and state == "neutral":
            state = "pass" if v == "APPROVE" else "findings"
        if v == "APPROVE":
            approve += 1
        elif v:
            reject += 1
        row = {"provider": r.get("provider", "?"), "verdict": v or "unavailable",
               "error": r.get("error") if not v else None,
               "elapsed": r.get("elapsed"), "findings": r.get("findings") or ""}
        if r.get("route"):
            row["route"] = r["route"]
            if spoofed:
                row["error"] = "unverified route attribution"
        rows.append(row)
    reviewer = next((x["provider"] for x in rows if x["verdict"] != "unavailable"), None)
    return {"state": state, "approve": approve, "reject": reject,
            "finished": approve + reject, "reviewer": reviewer, "rows": rows}


def _cell(text):
    return (text or "").replace("|", "/").replace("\n", " ").strip()


def render_comment(summary, head):
    """Markdown comment: verdict table, one collapsible block per reviewer,
    the merge-rule outcome line, then the signature."""
    state = summary["state"]
    title = {"pass": "approved", "findings": "has findings",
             "neutral": "unavailable (no reviewer answered)"}[state]
    out = [f"## AI review {title}", "", f"Head `{head or '?'}`", ""]
    candidate = any(r.get("route") for r in summary["rows"])
    out += ["| Reviewer | Verdict | Time |", "|---|---|---|"] if not candidate else \
           ["| Reviewer | Route | Verdict | Time |", "|---|---|---|---|"]
    for r in summary["rows"]:
        secs = f"{r['elapsed']:.0f}s" if isinstance(r["elapsed"], (int, float)) else "-"
        if candidate:
            out.append(f"| {_cell(r['provider'])} | {_cell(r.get('route') or '-')} | "
                       f"{_cell(r['verdict'])} | {secs} |")
        else:
            out.append(f"| {_cell(r['provider'])} | {_cell(r['verdict'])} | {secs} |")
    for r in summary["rows"]:
        body = r["findings"] or (f"Unavailable: {redact(r['error'])}" if r["error"]
                                 else "No findings recorded.")
        body = body[:MAX_FINDINGS].replace("</details>", "&lt;/details&gt;")
        out += ["", f"<details><summary>{_cell(r['provider'])}: {_cell(r['verdict'])}</summary>",
                "", body, "", "</details>"]
    out += ["", f"**Outcome: {state}.** Review is advisory and never blocks a merge."]
    if state == "findings":
        out += ["", "The reviewer asked for changes. A `review-finding` issue tracks them."]
    sig = os.environ.get("AI_GH_SIGNATURE")
    if sig:
        out += ["", sig]
    return "\n".join(out) + "\n"


def main(argv=None):
    ap = argparse.ArgumentParser(prog="ai-review-simple", description=__doc__.split("\n")[0])
    ap.add_argument("--combine", nargs="+", metavar="JSON")
    ap.add_argument("--provider", choices=sorted(PROVIDERS))
    ap.add_argument("--route", choices=sorted(RR.routes()),
                    help="candidate route (opt-in, #2549/#2550); overrides the provider spec")
    ap.add_argument("--repo", default=".")
    for name in ("--comment-out", "--base", "--head", "--out"):
        ap.add_argument(name)
    ap.add_argument("--timeout", type=int)
    ap.add_argument("--rotation", type=int, metavar="PR")
    ap.add_argument("--candidate-plan", type=int, metavar="PR",
                    help="expand the rotation into the candidate route attempt order")
    ap.add_argument("--run-plan", metavar="ROUTES",
                    help="candidate mode: run this ordered route/reviewer plan, one result file each")
    ap.add_argument("--results-dir", default="results")
    ap.add_argument("--docs-only", metavar="FILE_LIST")
    args = ap.parse_args(argv)
    if args.rotation is not None:
        print(" ".join(rotation(args.rotation)))
        return 0
    if args.candidate_plan is not None:
        print(" ".join(RR.candidate_plan(rotation(args.candidate_plan))))
        return 0
    if args.docs_only:
        with open(args.docs_only, encoding="utf-8") as fh:
            print("true" if is_docs_only(fh.read().splitlines()) else "false")
        return 0
    if args.run_plan is not None:
        if not (args.repo and args.base and args.head):
            ap.error("--run-plan needs --repo, --base and --head")
        return run_plan(args)
    if args.combine:
        results = []
        for path in args.combine:
            try:
                with open(path) as fh:
                    results.append(json.load(fh))
            except (OSError, ValueError):
                results.append({"provider": os.path.basename(path).split(".")[0],
                                "error": "result missing"})
        candidate_routes = next((r["route"] for r in results if r.get("route")), None)
        summary = combine(results, args.head,
                          routes=set(RR.routes()) if candidate_routes else None)
        if args.comment_out:
            with open(args.comment_out, "w") as fh:
                fh.write(render_comment(summary, args.head))
        print(json.dumps({k: v for k, v in summary.items() if k != "rows"}))
        return 0
    if not ((args.provider or args.route) and args.base and args.head and args.out):
        ap.error("--provider (or --route), --base, --head and --out are required")
    if not args.provider and args.route:
        args.provider = RR.route(args.route)["reviewer"]
    try:
        spec_for(args.provider, args.route)
        if args.route:
            RR.billing_session_id()
    except RR.RouteError as exc:
        ap.error(str(exc))
    return review(args)


if __name__ == "__main__":
    sys.exit(main())
