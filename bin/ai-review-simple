#!/usr/bin/env python3
"""ai-review-simple: review one PR head with one reviewer, statelessly (#2041).

  ai-review-simple --provider {muse,glm,deepseek,stepfun,...} --repo DIR --base SHA --head SHA --out FILE.json
  ai-review-simple --route ROUTE --repo DIR --base SHA --head SHA --out FILE.json
  ai-review-simple --run-plan "ROUTE..." --repo DIR --base SHA --head SHA --results-dir DIR
  ai-review-simple --combine [--head SHA] [--comment-out FILE] RESULT.json...
  ai-review-simple --rotation PR_NUMBER | --candidate-plan PR_NUMBER
  ai-review-simple --docs-only FILE_LIST

Review exits 0 for a verdict, 3 unavailable, 2 refused. The verdict comes from
the reviewer's own words only. Review is advisory (plan REVISION rule 1):
combine reports the first finished verdict as {state: pass|findings|neutral}
and never fails. --rotation prints the provider try order for a PR;
--docs-only prints "true" when every listed path is docs (REVISION rule 4).

Candidate routes (#2549/#2550, config/reviewer-routes.json) are opt-in through
--route / --run-plan / --candidate-plan; without them every default behavior
is unchanged. --run-plan executes an ordered attempt plan: a verdict ends it,
a terminal refusal stops it, and a confirmed shared OpenRouter outage skips
the remaining OpenRouter routes.
"""
import argparse
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
import reviewer_routes as RR  # shared candidate routes (#2549/#2550)

TEMPLATE = os.path.join(ROOT, "templates", "review-prompt-simple.md")
VERDICTS = ("APPROVE", "REJECT", "REVISE")
MAX_DIFF, MAX_STAT, MAX_FINDINGS = 300_000, 20_000, 4000

# Provider facts for the advisory CI reviewer and bin/ai-second-opinion
# (ai-glm, ai-muse, ai-stepfun), from config/opencode-*/opencode.json. GLM uses
# OpenCode's built-in
# zai-coding-plan provider (no custom block), keyed by ZHIPU_API_KEY.
PROVIDERS = {
