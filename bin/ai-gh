#!/usr/bin/env bash
# ai-gh — the machine-wide GitHub call throttle. Use it instead of bare `gh`.
#
# WHY THIS EXISTS. On 2026-09-15 parallel sub-agents of the shared-db
# orchestrator each polled GitHub every 60-90 seconds (`gh run watch`, sleep
# loops). GitHub refused requests with its PRIMARY hourly limit (5000 requests
# per user per hour): "gh: API rate limit exceeded for user ID 55610577",
# 19:25-19:37 UTC, request ID F95F:1E2E31:F1BFCA:3218145:6AA99BB1, window reset
# 20:30Z. A single session reading `gh api rate_limit` sees only its own moment
# and cannot pace the other sessions, and the primary counter never shows the
# secondary (burst) limit at all. The only fix is one shared gate that every AI
# process on the machine passes through.
#
# What it enforces, across every process that uses the same state directory:
#   - Serialization: one GitHub call at a time, through a lock directory.
#   - Spacing: at least AI_GH_MIN_SPACING_SECONDS (default 3) between calls.
#   - Back-off: a rate-limit refusal (a 403/429 whose message says rate limit,
#     "secondary rate limit", "abuse detection", Retry-After; an ordinary 403
#     permission error is NOT one) puts the whole
#     machine in back-off for max(Retry-After, AI_GH_BACKOFF_SECONDS=600).
#     A refused call is never retried by this tool: no hot loop.
#   - Watch commands (`gh run watch`, `--watch`) are refused. Wait with
#     `ai-gh-wait` (minimum 5-minute interval) or `ai-pr-wait` instead.
#
# Usage: ai-gh <any gh arguments>
#
# Environment:
#   AI_GH_STATE_DIR            shared state (default ~/.ai-devops/gh-throttle)
#   AI_GH_MIN_SPACING_SECONDS  gap between any two calls (default 3)
#   AI_GH_BACKOFF_SECONDS      minimum back-off after a refusal (default 600)
#   AI_GH_NO_WAIT=1            during back-off, exit 75 at once instead of sleeping
#   AI_GH_ACCOUNT              state partition (GitHub limits are per account)
#   AI_GH_LOCK_STALE_SECONDS   lock age treated as abandoned (default 300). A call
#                              that legitimately runs longer (a big clone or a long
#                              paginated read) should be raised with this variable,
#                              or it will have its lock reclaimed under it.
#   AI_GH_NO_WAIT_LOCK_SECONDS with AI_GH_NO_WAIT=1, max lock wait before exit 75 (default 10)
#   AI_GH_QUOTA_PROBE_SECONDS  hourly-budget probe cache age (default 300; "off" disables)
#   AI_GH_QUOTA_PAUSE_PCT      below this % remaining (default 20) the machine is put
#                              in back-off until the window resets and this call exits 75
#                              (the caller decides whether to wait out an hour, not this tool)
#   AI_GH_QUOTA_SLOW_PCT / AI_GH_QUOTA_SLOW_SPACING  below 40% remaining, space calls 30s
#   Logs: $AI_GH_STATE_DIR/failures.log (every failed call: status, headers,
#   body, redacted) and refusals.log (rate-limit refusals and budget pauses).
#   AI_GH_REAL_GH              path of the real gh (default: first gh on PATH that is not this file)
#
# Exit status: gh's own status, or
#   2   refused usage (a watch command)
#   75  GitHub refused with a rate limit (back-off recorded), or back-off active with AI_GH_NO_WAIT=1
set -uo pipefail

# GitHub's limits are per account, so back-off and budget state is partitioned by
# account. AI_GH_ACCOUNT names it (default: GH_HOST/GITHUB_USER if set, else
# "default"); u2giants and popcre therefore never pause each other.
STATE="${AI_GH_STATE_DIR:-$HOME/.ai-devops/gh-throttle/${AI_GH_ACCOUNT:-${GITHUB_USER:-${GH_HOST:-default}}}}"
SPACING="${AI_GH_MIN_SPACING_SECONDS:-3}"
BACKOFF="${AI_GH_BACKOFF_SECONDS:-600}"
STALE="${AI_GH_LOCK_STALE_SECONDS:-300}"
LOCK="$STATE/lock.d"
say(){ printf 'ai-gh: %s\n' "$*" >&2; }
isnum(){ case "$1" in ''|*[!0-9]*) return 1;; esac; }
for v in SPACING BACKOFF STALE; do isnum "${!v}" || { say "$v must be a whole number"; exit 2; }; done

prev=''
for a in "$@"; do
  if [ "$a" = --watch ] || { [ "$prev" = run ] && [ "$a" = watch ]; }; then
    say "watch commands are forbidden (they poll GitHub every few seconds and trip the secondary rate limit)."
    say "wait with: ai-gh-wait --until-regex <pattern> -- <gh args>   (minimum 5-minute interval), or ai-pr-wait <pr>"
    exit 2
  fi
  prev="$a"
done

self="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL="${AI_GH_REAL_GH:-}"
if [ -z "$REAL" ]; then
  while IFS= read -r cand; do
    r="$(readlink -f "$cand" 2>/dev/null || echo "$cand")"
    [ "$r" = "$self" ] || [ "$(basename "$r")" = ai-gh ] && continue
    REAL="$cand"; break
  done < <(type -ap gh 2>/dev/null)
fi
[ -n "$REAL" ] || { say "the real gh is not installed"; exit 3; }

mkdir -p "$STATE" || { say "cannot create $STATE"; exit 3; }
now(){ date +%s; }
readnum(){ local x; x="$(cat "$1" 2>/dev/null)"; isnum "$x" && echo "$x" || echo 0; }

HELD=0
TOKEN="$$.$RANDOM.$RANDOM.$(date +%s)"
# Reclaim by atomic rename to a private quarantine name, never rm of the live
# path: two waiters cannot both delete it, and a new owner is never removed.
quarantine(){ local q="$LOCK.stale.$$.$RANDOM"; mv "$LOCK" "$q" 2>/dev/null && rm -rf "$q"; }
# Reclaim of someone else's lock is itself serialized, and the staleness is
# re-checked while holding that gate, so two waiters cannot reclaim in sequence
# and have the second one carry off the first one's fresh lock.
# The gate itself is self-healing: a gate left behind by a killed process is
# removed once it is older than 30s, so it can never wedge the machine.
reclaim(){
  local sampled="$1" g="$LOCK.reclaim" cur gage
  if ! mkdir "$g" 2>/dev/null; then
    gage=$(( $(now) - $(stat -c %Y "$g" 2>/dev/null || now) ))
    [ "$gage" -gt 30 ] && rm -rf "$g"
    return 1
  fi
  cur="$(cat "$LOCK/owner" 2>/dev/null)"
  [ "$cur" = "$sampled" ] && quarantine
  rmdir "$g" 2>/dev/null
  return 0
}
# Release only a lock this process still owns (token match).
release(){
  if [ "$HELD" = 1 ]; then
    local info; info="$(cat "$LOCK/owner" 2>/dev/null)"
    [ "${info##* }" = "$TOKEN" ] && quarantine
  fi
  HELD=0
}
trap release EXIT
trap 'release; exit 130' INT TERM
# Lock liveness is age-based only: pid checks are unreliable across Git Bash,
# MSYS and WSL pid namespaces sharing one state directory.
acquire(){
  local waited=0
  while :; do
    if mkdir "$LOCK" 2>/dev/null; then
      echo "$$ $(now) $TOKEN" > "$LOCK/owner"
      # Confirm the lock we hold is still ours (a racing reclaimer could have
      # carried the directory off between mkdir and this read).
      local check; check="$(cat "$LOCK/owner" 2>/dev/null)"
      if [ "${check##* }" = "$TOKEN" ]; then HELD=1; return 0; fi
      continue
    fi
    local info ts age
    info="$(cat "$LOCK/owner" 2>/dev/null)"; ts="$(echo "$info" | awk '{print $2}')"
    if isnum "${ts:-}"; then
      age=$(( $(now) - ts ))
      if [ "$age" -gt "$STALE" ]; then say "reclaiming abandoned lock (${age}s old)"; reclaim "$info" && continue; fi
    else
      # Owner never written (holder killed between mkdir and write): use the directory age.
      age=$(( $(now) - $(stat -c %Y "$LOCK" 2>/dev/null || now) ))
      if [ "$age" -gt 60 ]; then say "reclaiming lock with no owner record (${age}s old)"; reclaim "$info" && continue; fi
    fi
    if [ "${AI_GH_NO_WAIT:-0}" = 1 ] && [ "$waited" -ge "${AI_GH_NO_WAIT_LOCK_SECONDS:-10}" ]; then
      say "another GitHub call holds the throttle lock; not waiting (AI_GH_NO_WAIT=1)."; exit 75
    fi
    sleep 1; waited=$(( waited + 1 ))
  done
}

acquire
until_ts="$(readnum "$STATE/backoff_until")"
while [ "$(now)" -lt "$until_ts" ]; do
  left=$(( until_ts - $(now) ))
  if [ "${AI_GH_NO_WAIT:-0}" = 1 ]; then
    say "GitHub back-off active for ${left}s more (a rate-limit refusal was recorded); not calling GitHub."
    exit 75
  fi
  release
  say "GitHub back-off active; sleeping ${left}s before this call."
  sleep "$left"
  acquire
  until_ts="$(readnum "$STATE/backoff_until")"
done
last="$(readnum "$STATE/last_call")"
gap=$(( last + SPACING - $(now) ))
[ "$gap" -gt 0 ] && sleep "$gap"

# Hourly budget (PRIMARY limit: 5000 requests/hour shared by every process on
# one token). `gh api rate_limit` does not count against the limit. The probe
# result is cached for QUOTA_PROBE seconds and decremented locally per call.
# Below QUOTA_PAUSE_PCT remaining, the machine pauses until the window resets;
# below QUOTA_SLOW_PCT, calls are spaced QUOTA_SLOW_SPACING seconds apart.
QUOTA_PROBE="${AI_GH_QUOTA_PROBE_SECONDS:-300}"
PAUSE_PCT="${AI_GH_QUOTA_PAUSE_PCT:-20}"
SLOW_PCT="${AI_GH_QUOTA_SLOW_PCT:-40}"
SLOW_SPACING="${AI_GH_QUOTA_SLOW_SPACING:-30}"
# Redaction of log TEXT. The narrow `token=`/`token:` form is deliberate: a bare
# "token in keyring is invalid" message must stay readable to be diagnosable.
redact(){ sed -E 's/(gh[pousr]_|github_pat_)[A-Za-z0-9_]+/[REDACTED]/g; s/([Aa]uthorization[=:] *).*/\1[REDACTED]/; s/([Bb]earer|[Bb]asic) +[A-Za-z0-9._~+\/=-]+/\1 [REDACTED]/g; s/(token|password|secret|api[_-]?key)([=:]"?)[^ "]+/\1\2[REDACTED]/Ig'; }
# Redaction of the logged COMMAND LINE: values of value-carrying flags never
# reach the log, and `gh secret|variable set ...` is logged as the verb only.
safe_args(){
  case "${1:-}" in
    secret|variable) printf '%s %s [REDACTED]' "$1" "${2:-}"; return ;;
  esac
  local out='' skip=0 a
  for a in "$@"; do
    if [ "$skip" = 1 ]; then out="$out [REDACTED]"; skip=0; continue; fi
    case "$a" in
      -f|-F|-b|-H|--field|--raw-field|--body|--body-file|--arg|--jq|--header) out="$out $a"; skip=1 ;;
      --field=*|--raw-field=*|--body=*|--arg=*|--header=*) out="$out ${a%%=*}=[REDACTED]" ;;
      # Values glued to a short flag (-fname=value, -bVALUE, -HAuthorization: x).
      -f?*|-F?*|-b?*|-H?*) out="$out ${a:0:2}[REDACTED]" ;;
      *) out="$out $a" ;;
    esac
  done
  printf '%s' "${out# }"
}
probe_quota(){
  local q
  q="$("$REAL" api rate_limit --jq '[.resources.core.remaining,.resources.core.limit,.resources.core.reset]|@tsv' 2>/dev/null | tr -d '\r')"
  set -- $q
  isnum "${1:-}" && isnum "${2:-}" && isnum "${3:-}" && [ "$2" -gt 0 ] || return 1
  printf '%s %s %s %s\n' "$(now)" "$1" "$2" "$3" > "$STATE/quota"
}
if [ "$QUOTA_PROBE" != off ]; then
  { [ -f "$STATE/quota" ] && read -r qts qrem qlim qreset < "$STATE/quota"; } || qts=0
  if ! isnum "${qts:-}" || [ $(( $(now) - qts )) -ge "$QUOTA_PROBE" ]; then
    probe_quota
    { [ -f "$STATE/quota" ] && read -r qts qrem qlim qreset < "$STATE/quota"; } || qts=0
    # The probe is a request too: keep normal spacing before the real call.
    [ "$SPACING" -gt 0 ] && sleep "$SPACING"
  fi
  if isnum "${qrem:-}" && isnum "${qlim:-}" && [ "${qlim:-0}" -gt 0 ]; then
    pct=$(( qrem * 100 / qlim ))
    if [ "$pct" -lt "$PAUSE_PCT" ] && [ "$(now)" -lt "${qreset:-0}" ]; then
      echo "$qreset" > "$STATE/backoff_until"
      printf '%s budget-pause remaining=%s/%s reset=%s\n' "$(date -u +%FT%TZ)" "$qrem" "$qlim" "$qreset" >> "$STATE/refusals.log"
      say "hourly GitHub budget low (${qrem}/${qlim}); machine-wide pause until the window resets in $(( qreset - $(now) ))s."
      exit 75
    fi
    if [ "$pct" -lt "$SLOW_PCT" ]; then
      gap=$(( $(readnum "$STATE/last_call") + SLOW_SPACING - $(now) ))
      if [ "$gap" -gt 0 ] && [ "${AI_GH_NO_WAIT:-0}" = 1 ]; then
        say "hourly GitHub budget below ${SLOW_PCT}%; next call allowed in ${gap}s, not waiting (AI_GH_NO_WAIT=1)."; exit 75
      fi
      [ "$gap" -gt 0 ] && sleep "$gap"
    fi
    printf '%s %s %s %s\n' "$qts" $(( qrem > 0 ? qrem - 1 : 0 )) "$qlim" "$qreset" > "$STATE/quota"
  fi
fi

qreset_cached="${qreset:-}"
err="$(mktemp)"
ERRFILE="$err"; trap 'rm -f "$ERRFILE"; release' EXIT; trap 'rm -f "$ERRFILE"; release; exit 130' INT TERM
now > "$STATE/last_call"
# stderr is passed through live (prompts and progress stay visible) and copied
# for the failure record.
exec 4>&1
rc="$({ { "$REAL" "$@" 2>&1 1>&4; printf '%s' "$?" >&5; } | tee "$err" >&2; } 5>&1)"
exec 4>&-
isnum "${rc:-}" || rc=1
now > "$STATE/last_call"
if [ "$rc" -ne 0 ]; then
  # Exact failure record: HTTP status, rate-limit headers, and message body,
  # credentials redacted. gh does not surface response headers on failure, so
  # the header snapshot comes from a free `rate_limit` request made right after.
  hdr=''
  # Header snapshot: one request, never after a SECONDARY limit refusal (it would
  # add to the burst GitHub is already refusing).
  secondary=0
  grep -Eiq 'secondary rate limit|abuse detection|HTTP 429|too many requests|retry-after' "$err" && secondary=1
  [ "$QUOTA_PROBE" != off ] && [ "$secondary" = 0 ] && hdr="$("$REAL" api --include rate_limit 2>&1 | tr -d '\r' | grep -Ei '^(HTTP/|retry-after|x-ratelimit-|x-github-request-id)' )"
  {
    printf '=== %s rc=%s args=%s\n' "$(date -u +%FT%TZ)" "$rc" "$(safe_args "$@")"
    printf -- '--- status: %s\n' "$(grep -Eo 'HTTP [0-9]{3}' "$err" | head -1)"
    printf -- '--- message body (stderr):\n'; cat "$err"
    printf -- '--- headers (retry-after, x-ratelimit-*, request id) at failure time:\n%s\n' "${hdr:-unavailable}"
  } | redact >> "$STATE/failures.log"
fi
if [ "$rc" -ne 0 ] && grep -Eiq 'secondary rate limit|abuse detection|rate limit exceeded|API rate limit|HTTP 429|too many requests|retry-after' "$err"; then
  ra="$(grep -Eio 'retry-after"?:? *[0-9]+' "$err" | grep -Eo '[0-9]+' | head -1)"
  wait="$BACKOFF"; isnum "${ra:-}" && [ "$ra" -gt "$wait" ] && wait="$ra"
  kind=secondary
  if grep -Eiq 'API rate limit( already)? exceeded|rate limit( already)? exceeded for' "$err"; then
    kind=primary
    # Window reset from the header snapshot already taken, else the cached quota; no new request.
    qreset="$(printf '%s\n' "$hdr" | grep -Ei '^x-ratelimit-reset:' | grep -Eo '[0-9]+' | head -1)"
    isnum "${qreset:-}" || qreset="${qreset_cached:-}"
    isnum "${qreset:-}" && [ $(( qreset - $(now) )) -gt "$wait" ] && wait=$(( qreset - $(now) ))
  fi
  new=$(( $(now) + wait ))
  [ "$new" -gt "$(readnum "$STATE/backoff_until")" ] && echo "$new" > "$STATE/backoff_until"
  { printf '%s kind=%s rc=%s retry_after=%s backoff=%ss args=%s\n' "$(date -u +%FT%TZ)" "$kind" "$rc" "${ra:-none}" "$wait" "$(safe_args "$@")"; sed 's/^/    /' "$err"; } | redact >> "$STATE/refusals.log"
  say "GitHub refused with a $kind rate limit. Machine-wide back-off for ${wait}s recorded. Do not retry sooner."
  rm -f "$err"; exit 75
fi
rm -f "$err"
exit "$rc"
