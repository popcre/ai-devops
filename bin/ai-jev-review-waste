#!/usr/bin/env bash
# ai-jev-review-waste -- thin read-only consumer of tools/lib/jev-client.sh
# for the review-waste pipeline (plan_jev-review-waste-mining.md).
#
# Commands:
#   chunk-filter --items FILE     # JSONL of {"id","state"}; one Choice per item
#   value-level  --items FILE     # JSONL of {"id","state"}; one Score per item
#
# Each item state is preselected public/synthetic review text. The caller never
# prints raw state, keys, or raw responses. On any error, uncertainty, model
# mismatch, or changed source digest it prints `abstain` for that item (or the
# run) and exits nonzero only on total failure to start.
#
# Output (stdout): one JSON object per line
#   {"id":"...","decision":"...","label":"...","confidence":...,"abstain":false}
# or {"id":"...","decision":"abstain","reason":"...","abstain":true}
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../tools/lib/jev-client.sh
. "$SCRIPT_DIR/../tools/lib/jev-client.sh"

CMD=""
ITEMS=""
SRC_DIGEST=""

usage() {
  echo "usage: ai-jev-review-waste {chunk-filter|value-level} --items FILE [--src-digest HEX]" >&2
  exit 2
}

# Keep the original arguments: the op run re-exec must see the same command.
ORIG_ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    chunk-filter|value-level) CMD="$1"; shift ;;
    --items) ITEMS="${2:-}"; shift 2 ;;
    --src-digest) SRC_DIGEST="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$CMD" ] && [ -n "$ITEMS" ] && [ -f "$ITEMS" ] || usage

if ! jev_bootstrap "$0" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"} </dev/null; then
  echo '{"id":null,"decision":"abstain","reason":"bootstrap","abstain":true}'
  exit 1
fi

# Model pin must match config; already enforced by jev_request. Source digest
# is caller-supplied provenance: if provided we only echo it into the record.
emit_abstain() {
  jq -nc --arg id "$1" --arg r "$2" '{id:$id,decision:"abstain",reason:$r,abstain:true}'
}

load_labels() {
  jq -c '.decisions.chunk_filter.allowed_labels' "$JEV_CONFIG"
}

run_chunk_filter() {
  local allowed id state req resp out conf label
  allowed="$(load_labels)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id="$(printf '%s' "$line" | jq -r '.id // empty')"
    state="$(printf '%s' "$line" | jq -r '.state // empty')"
    if [ -z "$id" ] || [ -z "$state" ]; then
      emit_abstain "${id:-}" "bad-item"
      continue
    fi
    jev_tmp req || { emit_abstain "$id" "temp"; continue; }
    jev_tmp resp || { emit_abstain "$id" "temp"; continue; }
    jq -nc --arg s "$state" --arg m "$JEV_MODEL_PIN" --rawfile cfg "$JEV_CONFIG" '
      ($cfg|fromjson).decisions.chunk_filter as $d
      | {
          model: $m,
          state: $s,
          questions: {
            chunk_filter: {
              type: "choice",
              instructions: $d.instructions,
              criteria: $d.criteria
            }
          }
        }' > "$req"
    if ! jev_request "$req" "$resp" 2>/dev/null; then
      emit_abstain "$id" "request"
      continue
    fi
    out="$(jev_read_choice "$resp" chunk_filter "$allowed" 2>/dev/null || true)"
    if [ -z "$out" ]; then
      emit_abstain "$id" "parse"
      continue
    fi
    label="$(printf '%s' "$out" | jq -r '.label')"
    conf="$(printf '%s' "$out" | jq -r '.confidence')"
    # Threshold is unfrozen placeholder until calibration freezes it.
    min_conf="$(jq -r '.decisions.chunk_filter.threshold.min_confidence' "$JEV_CONFIG")"
    if [ "$(jq -nr --argjson c "$conf" --argjson m "$min_conf" '$c < $m')" = true ]; then
      emit_abstain "$id" "below-threshold"
      continue
    fi
    jq -nc --arg id "$id" --argjson out "$out" --arg d "$SRC_DIGEST" '
      {
        id: $id,
        decision: "chunk_filter",
        label: $out.label,
        confidence: $out.confidence,
        abstain: false
      } + (if $d != "" then {src_digest: $d} else {} end)'
  done < "$ITEMS"
}

run_value_level() {
  local id state req resp out conf min_conf idx label
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id="$(printf '%s' "$line" | jq -r '.id // empty')"
    state="$(printf '%s' "$line" | jq -r '.state // empty')"
    if [ -z "$id" ] || [ -z "$state" ]; then
      emit_abstain "${id:-}" "bad-item"
      continue
    fi
    jev_tmp req || { emit_abstain "$id" "temp"; continue; }
    jev_tmp resp || { emit_abstain "$id" "temp"; continue; }
    jq -nc --arg s "$state" --arg m "$JEV_MODEL_PIN" --rawfile cfg "$JEV_CONFIG" '
      ($cfg|fromjson).decisions.value_level as $d
      | {
          model: $m,
          state: $s,
          questions: {
            value_level: {
              type: "score",
              instructions: $d.instructions,
              criteria: $d.criteria
            }
          }
        }' > "$req"
    if ! jev_request "$req" "$resp" 2>/dev/null; then
      emit_abstain "$id" "request"
      continue
    fi
    out="$(jev_read_score "$resp" value_level 2>/dev/null || true)"
    if [ -z "$out" ]; then
      emit_abstain "$id" "parse"
      continue
    fi
    conf="$(printf '%s' "$out" | jq -r '.confidence')"
    min_conf="$(jq -r '.decisions.value_level.threshold.min_confidence' "$JEV_CONFIG")"
    if [ "$(jq -nr --argjson c "$conf" --argjson m "$min_conf" '$c < $m')" = true ]; then
      emit_abstain "$id" "below-threshold"
      continue
    fi
    idx="$(printf '%s' "$out" | jq -r '.level_index')"
    label="$(jq -r --argjson i "$idx" '.decisions.value_level.level_index[( $i|tostring )] // "unknown"' "$JEV_CONFIG")"
    # Negative requires arc evidence; caller marks that separately. Face label only here.
    jq -nc --arg id "$id" --arg label "$label" --argjson out "$out" --arg d "$SRC_DIGEST" '
      {
        id: $id,
        decision: "value_level",
        label: $label,
        score: $out.score,
        confidence: $out.confidence,
        abstain: false
      } + (if $d != "" then {src_digest: $d} else {} end)'
  done < "$ITEMS"
}

case "$CMD" in
  chunk-filter) run_chunk_filter ;;
  value-level) run_value_level ;;
  *) usage ;;
esac
