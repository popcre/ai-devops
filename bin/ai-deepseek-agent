#!/usr/bin/env bash
# ai-deepseek-agent — freeform, multi-turn conversation with DeepSeek.
#
# This is NOT a one-shot diff reviewer. Claude and Codex use it to actually
# talk back and forth with DeepSeek about anything -- a plan, a design, a
# piece of code, an environment/config question, a debugging theory, a
# disagreement -- the same way codex-second-opinion lets Claude debate Codex.
# DeepSeek sees the FULL conversation history on every turn (there is no
# native DeepSeek CLI with session-resume, so this script keeps the thread in
# a JSON transcript file and resends it each time).
#
# Usage:
#   ai-deepseek-agent send "<message>" [--file FILE]... [--model deepseek-chat|deepseek-reasoner] [--system "<system prompt>"] [--review]
#       Start a NEW conversation. Prints:
#         SESSION_ID: <id>
#         <DeepSeek's reply>
#
#   ai-deepseek-agent reply <session-id> "<message>" [--file FILE]...
#       Continue an EXISTING conversation. Prints DeepSeek's reply.
#
#   ai-deepseek-agent show <session-id>
#       Print the full transcript so far.
#
#   ai-deepseek-agent list
#       List open session ids for this repo, newest first.
#
# --file FILE appends that file's contents to the message -- paste in a diff,
# a plan, a config file, a log, whatever DeepSeek needs to see. Sessions are
# stored under .ai/deepseek-sessions/ in the current repo (or cwd if not in a
# repo) and are local scratch, not meant to be committed.
#
# Secrets: DEEPSEEK_API_KEY self-resolves from 1Password (same pattern as
# opencode-glm-launch), so this works whether or not the calling shell already
# exported it.

set -uo pipefail

CFG_DIR="${AI_DEVOPS_CONFIG_DIR:-$HOME/.config/ai-devops}"
TOKEN_FILE="$CFG_DIR/op-service-account"
MCP_ENV="$CFG_DIR/mcp.env"
MODEL="${DEEPSEEK_MODEL:-deepseek-chat}"
BASE_URL='https://api.deepseek.com'
[ -z "${DEEPSEEK_BASE_URL:-}" ] || [ "$DEEPSEEK_BASE_URL" = "$BASE_URL" ] || { echo 'Error: DEEPSEEK_BASE_URL cannot override the pinned official DeepSeek endpoint.' >&2; exit 1; }
LOCK_WAIT="${AI_DEEPSEEK_LOCK_WAIT:-30}"
CALLER="${AI_DEEPSEEK_CALLER:-unknown}"
CONNECT_TIMEOUT="${AI_DEEPSEEK_CONNECT_TIMEOUT:-15}"
CALL_TIMEOUT="${AI_DEEPSEEK_CALL_TIMEOUT:-300}"

usage() {
  cat <<'EOF'
Usage:
  ai-deepseek-agent send "<message>" [--file FILE]... [--model MODEL] [--system "<prompt>"] [--review]
      Start a NEW conversation. Prints SESSION_ID: <id>, then the reply.

  ai-deepseek-agent reply <session-id> "<message>" [--file FILE]...
      Continue an existing conversation with full history.

  ai-deepseek-agent show <session-id>
      Print the full transcript.

  ai-deepseek-agent list
      List open session ids for this repo, newest first.

  ai-deepseek-agent doctor [--live]
      Validate the governed runtime; --live makes one bounded provider probe.

A genuine back-and-forth: DeepSeek sees the whole thread on every reply, the
same as resuming a Codex session. Use it for plans, code, environment/config
questions, debugging theories, or a second-opinion debate -- not just diffs.

--review requires a final ## Verdict heading and APPROVE, REJECT, or BLOCKED.
It also tells DeepSeek that it has NO repository access, so it must not claim
that anything exists or is missing unless the text quotes it, and must return
BLOCKED when a conclusion would need evidence it was not given. --file may be
repeated to attach all the evidence a real judgement needs.
It writes a metadata sidecar bound to this repository's exact HEAD commit.
EOF
}

SUBCMD="${1:-}"
[ -n "$SUBCMD" ] && shift || true

case "$SUBCMD" in
  send|reply|show|list|doctor) ;;
  ""|-h|--help|help) usage; exit 0 ;;
  *) echo "Unknown subcommand: $SUBCMD" >&2; echo >&2; usage >&2; exit 2 ;;
esac

# --- Resolve only DEEPSEEK_API_KEY, then cross an explicit clean environment. ---
DEEPSEEK_CREDENTIAL_BOUNDARY='
keep_key="${DEEPSEEK_API_KEY:-}"; script="$1"; shift
unset DEEPSEEK_API_KEY
exec 9<<<"$keep_key"
keep_key=""
clean=(/usr/bin/env -i "PATH=${PATH:-}" "HOME=${HOME:-}" "AI_DEEPSEEK_SECRET_FD=9" "AI_DEEPSEEK_REEXEC=1")
for name in USERPROFILE TEMP TMP TMPDIR SYSTEMROOT COMSPEC PATHEXT USER USERNAME LOGNAME LANG LC_ALL AI_DEVOPS_CONFIG_DIR DEEPSEEK_MODEL AI_DEEPSEEK_CALLER AI_DEEPSEEK_CONNECT_TIMEOUT AI_DEEPSEEK_CALL_TIMEOUT AI_DEEPSEEK_LOCK_WAIT; do
  [ -z "${!name:-}" ] || clean+=("$name=${!name}")
done
exec "${clean[@]}" /usr/bin/bash --noprofile --norc "$script" "$@"
'
if [ -n "${AI_DEEPSEEK_SECRET_FD:-}" ]; then
  case "$AI_DEEPSEEK_SECRET_FD" in ''|*[!0-9]*) echo 'Error: invalid managed DeepSeek credential descriptor.' >&2; exit 1;; esac
  IFS= read -r DEEPSEEK_API_KEY <&"$AI_DEEPSEEK_SECRET_FD" || { echo 'Error: managed DeepSeek credential handoff was empty.' >&2; exit 1; }
  eval "exec ${AI_DEEPSEEK_SECRET_FD}<&-"
  unset AI_DEEPSEEK_SECRET_FD
fi
if [ -z "${DEEPSEEK_API_KEY:-}" ] && { [ "$SUBCMD" = "send" ] || [ "$SUBCMD" = "reply" ] || { [ "$SUBCMD" = doctor ] && [ "${1:-}" = --live ]; }; }; then
  if [ -n "${AI_DEEPSEEK_REEXEC:-}" ]; then
    echo "Error: DEEPSEEK_API_KEY resolved EMPTY from $MCP_ENV after 'op run'." >&2
    echo "       Check the DEEPSEEK_API_KEY reference in config/mcp.env.example." >&2
    exit 1
  fi
  OP_BIN="$(command -v op 2>/dev/null || true)"; [ -n "$OP_BIN" ] || { echo "Error: 1Password CLI (op) is required." >&2; exit 1; }
  OP_PHYSICAL="$(readlink -f "$OP_BIN" 2>/dev/null || true)"
  if [ -n "${AI_DEEPSEEK_TEST_DIR:-}" ]; then case "$OP_PHYSICAL" in "$AI_DEEPSEEK_TEST_DIR"/*) ;; *) echo 'Error: test 1Password executable escaped its fixture directory.' >&2; exit 1;; esac
  elif [ -n "${LOCALAPPDATA:-}" ]; then case "$OP_PHYSICAL" in "$(cygpath -u "$LOCALAPPDATA")"/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_*/op.exe) ;; *) echo 'Error: 1Password CLI is not the expected WinGet installation.' >&2; exit 1;; esac
  else [ "$OP_PHYSICAL" = /usr/bin/op ] || { echo 'Error: 1Password CLI is not the trusted system installation.' >&2; exit 1; }; fi
  OP_BIN="$OP_PHYSICAL"
  case "$OP_BIN" in /*) ;; *) echo 'Error: resolved 1Password executable path must be absolute.' >&2; exit 1;; esac
  [ -s "$TOKEN_FILE" ] || { echo "Error: missing 1Password service-account token file: $TOKEN_FILE" >&2; exit 1; }
  [ -f "$MCP_ENV" ] || { echo "Error: missing managed 1Password reference file: $MCP_ENV" >&2; exit 1; }
  [ "$(grep -c '^DEEPSEEK_API_KEY=op://' "$MCP_ENV" 2>/dev/null || true)" = 1 ] || { echo 'Error: managed DeepSeek configuration must contain exactly one 1Password reference.' >&2; exit 1; }
  DEEPSEEK_REF_FILE="$(mktemp)" || exit 1; chmod 600 "$DEEPSEEK_REF_FILE" 2>/dev/null || true
  grep '^DEEPSEEK_API_KEY=op://' "$MCP_ENV" > "$DEEPSEEK_REF_FILE" || { rm -f "$DEEPSEEK_REF_FILE"; exit 1; }
  OP_SERVICE_TOKEN="$(<"$TOKEN_FILE")"
  # Windows cannot execute an extensionless Bash script directly through
  # `op run`. Re-enter through this exact Git Bash interpreter. Do not use a
  # bare `bash`: Windows PATH may resolve that name to WSL instead.
  if [[ "${OSTYPE:-}" == msys* || "${OSTYPE:-}" == cygwin* ]]; then
    BASH_EXE="$(cygpath -w /usr/bin/bash)"
  else
    BASH_EXE=/usr/bin/bash
  fi
  set +e
  ( export OP_SERVICE_ACCOUNT_TOKEN="$OP_SERVICE_TOKEN"; exec /usr/bin/env -u BASH_ENV -u ENV "$OP_BIN" run --env-file "$DEEPSEEK_REF_FILE" -- "$BASH_EXE" --noprofile --norc -c "$DEEPSEEK_CREDENTIAL_BOUNDARY" deepseek-credential-boundary "$0" "$SUBCMD" "$@" )
  REEXEC_RC=$?; set -e; rm -f "$DEEPSEEK_REF_FILE"; exit "$REEXEC_RC"
fi

# The re-exec environment delivers the key once. Capture it in this shell and
# immediately remove the exported copy before Python, Git, curl, or any other
# child can start. Only shell-built header bytes use this non-exported value.
DEEPSEEK_PROVIDER_KEY="${DEEPSEEK_API_KEY:-}"
unset DEEPSEEK_API_KEY

command -v curl >/dev/null 2>&1 || { echo "Error: curl is required." >&2; exit 1; }

PYTHON=""
if command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
  PYTHON=python
fi
[ -n "$PYTHON" ] || { echo "Error: Python is required." >&2; exit 1; }
case "$CONNECT_TIMEOUT" in ''|0|*[!0-9]*) echo 'Error: AI_DEEPSEEK_CONNECT_TIMEOUT must be a positive whole number of seconds.' >&2; exit 2;; esac
case "$CALL_TIMEOUT" in ''|0|*[!0-9]*) echo 'Error: AI_DEEPSEEK_CALL_TIMEOUT must be a positive whole number of seconds.' >&2; exit 2;; esac

REPO_ROOT=""; SESS_DIR=""; EXPECTED_SESS_DIR=""
if [ "$SUBCMD" != doctor ]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel)"
  else
    REPO_ROOT="$PWD"
  fi
  EXPECTED_SESS_DIR="$REPO_ROOT/.ai/deepseek-sessions"
  mkdir -p "$EXPECTED_SESS_DIR"

  # Refuse a linked storage folder. Otherwise even a perfectly validated name can
  # read outside this repository through a directory link chosen by the caller.
  SESS_DIR="$($PYTHON - "$EXPECTED_SESS_DIR" <<'PY'
import os, sys
p = os.path.abspath(sys.argv[1])
r = os.path.realpath(p)
if os.path.normcase(p) != os.path.normcase(r):
    raise SystemExit("Error: DeepSeek session storage must not be a symlink: " + p)
print(r)
PY
)" || exit 1
fi

new_id() { printf '%s-%s' "$(date +%Y%m%d-%H%M%S)" "$$"; }

valid_name() {
  local id="$1" stem
  [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || return 1
  [[ "$id" != .* ]] || return 1
  stem="${id%%.*}"; stem="${stem^^}"
  case "$stem" in CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) return 1 ;; esac
}

session_path() { # ID [suffix]
  local id="$1" suffix="${2:-.json}" candidate
  valid_name "$id" || { echo "Error: invalid session id: $id" >&2; return 1; }
  candidate="$($PYTHON - "$SESS_DIR" "$id$suffix" <<'PY'
import os, sys
base=os.path.realpath(sys.argv[1])
candidate=os.path.join(base,sys.argv[2])
resolved=os.path.realpath(candidate)
try: inside=os.path.commonpath([base,resolved]) == base
except ValueError: inside=False
if not inside: raise SystemExit("Error: session path escapes private storage.")
print(candidate)
PY
)" || return 1
  # Existing links are rejected even when their destination happens to remain
  # inside the store. Session identity must name a regular owned file.
  [ ! -L "$candidate" ] || { echo "Error: session file must not be a symlink: $id" >&2; return 1; }
  printf '%s' "$candidate"
}

LOCK_DIR=""; LOCK_TOKEN=""; LOCK_OWNER_PID=""
ACTIVE_API_PID=""; ACTIVE_API_TMP=""; REVIEW_HEAD=""
release_lock() {
  [ -n "$LOCK_DIR" ] || return 0
  [ -f "$LOCK_DIR/owner" ] && [ "$(cat "$LOCK_DIR/owner" 2>/dev/null)" = "$LOCK_TOKEN" ] || return 0
  rm -f "$LOCK_DIR/owner"; rmdir "$LOCK_DIR" 2>/dev/null || true
  LOCK_DIR=""; LOCK_TOKEN=""
}
on_lock_signal() { # SIGNAL_EXIT_CODE
  local code="$1"
  trap - EXIT INT TERM
  if [ -n "$ACTIVE_API_PID" ]; then
    kill -TERM "$ACTIVE_API_PID" 2>/dev/null || true
    wait "$ACTIVE_API_PID" 2>/dev/null || true
    ACTIVE_API_PID=""
  fi
  [ -z "$ACTIVE_API_TMP" ] || rm -f $ACTIVE_API_TMP
  ACTIVE_API_TMP=""
  [ "$BASHPID" != "$LOCK_OWNER_PID" ] || release_lock
  exit "$code"
}
acquire_lock() { # transcript path
  local target="$1" waited=0
  LOCK_DIR="$target.lock"; LOCK_TOKEN="$$-$(date +%s)-$RANDOM"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    [ "$waited" -lt "$LOCK_WAIT" ] || { LOCK_DIR=""; echo "Error: session is busy." >&2; return 1; }
    sleep 1; waited=$((waited + 1))
  done
  printf '%s\n' "$LOCK_TOKEN" > "$LOCK_DIR/owner"
  LOCK_OWNER_PID="$BASHPID"
  trap '[ "$BASHPID" != "$LOCK_OWNER_PID" ] || release_lock' EXIT
  trap 'on_lock_signal 130' INT
  trap 'on_lock_signal 143' TERM
}

write_atomic() { # destination source-json
  "$PYTHON" - "$1" "$2" <<'PY'
import os, shutil, sys, tempfile
dest, src = sys.argv[1:]
fd, tmp = tempfile.mkstemp(prefix=".deepseek.", dir=os.path.dirname(dest))
try:
    with os.fdopen(fd, "wb") as out, open(src, "rb") as inp:
        shutil.copyfileobj(inp, out); out.flush(); os.fsync(out.fileno())
    os.replace(tmp, dest)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PY
}

call_api() {
  # $1 = messages JSON, $2 = reply text file. Runs curl as an owned child so a
  # signal cannot release the conversation lock while the request still runs.
  local msgs_file="$1" reply_file="$2" req_file resp_file status_file http_code rc
  req_file="$(mktemp)"; resp_file="$(mktemp)"; status_file="$(mktemp)"
  ACTIVE_API_TMP="$req_file $resp_file $status_file"
  MODEL="$MODEL" "$PYTHON" - "$msgs_file" >"$req_file" <<'PY'
import json, os, sys
messages = json.load(open(sys.argv[1], encoding="utf-8"))
print(json.dumps({"model": os.environ["MODEL"], "messages": messages, "stream": False}))
PY
  printf 'Authorization: Bearer %s\nContent-Type: application/json\n' "$DEEPSEEK_PROVIDER_KEY" | curl -sS -o "$resp_file" -w '%{http_code}' \
    --connect-timeout "$CONNECT_TIMEOUT" --max-time "$CALL_TIMEOUT" \
    "$BASE_URL/chat/completions" \
    -H @- \
    -d @"$req_file" >"$status_file" &
  ACTIVE_API_PID=$!
  rc=0; wait "$ACTIVE_API_PID" || rc=$?
  ACTIVE_API_PID=""
  http_code="$(cat "$status_file" 2>/dev/null || true)"
  if [ "$rc" -ne 0 ]; then
    echo "Error: DeepSeek API request failed or exceeded ${CALL_TIMEOUT}s." >&2
    rm -f "$req_file" "$resp_file" "$status_file"
    ACTIVE_API_TMP=""
    return 1
  fi
  if [ "$http_code" != "200" ]; then
    echo "Error: DeepSeek API returned HTTP $http_code:" >&2
    cat "$resp_file" >&2
    rm -f "$req_file" "$resp_file" "$status_file"
    ACTIVE_API_TMP=""
    return 1
  fi
  "$PYTHON" -c '
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
print(data["choices"][0]["message"]["content"])
' "$resp_file" >"$reply_file"
  rc=$?
  rm -f "$req_file" "$resp_file" "$status_file"
  ACTIVE_API_TMP=""
  return $rc
}

require_review_head() {
  local head
  head="$(git -C "$REPO_ROOT" rev-parse --verify HEAD^{commit} 2>/dev/null || true)"
  [ -n "$head" ] || { echo "Error: --review requires a Git repository with an exact commit." >&2; return 1; }
  printf '%s' "$head"
}

build_candidate() {
  # $1 = current transcript or empty, $2 = output, remaining role/content pairs
  "$PYTHON" - "$@" <<'PY'
import json, sys
path, out, *items = sys.argv[1:]
try:
    messages = json.load(open(path, encoding="utf-8"))
except (FileNotFoundError, IsADirectoryError):
    messages = []
if len(items) % 2: raise SystemExit("invalid role/content pairs")
for role, content in zip(items[0::2], items[1::2]): messages.append({"role":role,"content":content})
with open(out, "w", encoding="utf-8") as f: json.dump(messages, f, indent=2)
PY
}

review_verdict() {
  "$PYTHON" - "$1" <<'PY'
import re, sys
text=sys.argv[1].replace("\r\n","\n")
m=re.search(r'(?:^|\n)## Verdict[ \t]*\n[ \t]*(APPROVE|REJECT|BLOCKED)[ \t]*(?:\n|$)', text)
if not m: raise SystemExit(1)
print(m.group(1))
PY
}

# A reply resends the whole conversation, so files attached on ANY earlier turn
# are still in front of DeepSeek. Recording only the latest turn understated
# the evidence behind a continued review verdict. The ledger accumulates every
# attachment actually sent in this session, in order, without duplicates. It is
# named without a .json suffix so `list` cannot mistake it for a conversation.
attachments_ledger() { session_path "$1" .attachments; }
# The transcript is published before the ledger is appended, so a ledger failure
# would otherwise leave a saved turn whose attachments are missing from the
# durable record - the exact understatement this ledger exists to prevent. Mark
# the session recovery-required instead, and refuse to continue it. The marker
# has no .json suffix so `list` cannot mistake it for a conversation.
recovery_marker() { session_path "$1" .recovery-required; }
mark_recovery_required() { # id reason
  local marker
  marker="$(recovery_marker "$1")" || return 1
  printf '%s\n' "$2" > "$marker" 2>/dev/null || return 1
  chmod 0600 "$marker" 2>/dev/null || true
}
recovery_required() { # id -> 0 when the session must not be continued
  local marker
  marker="$(recovery_marker "$1")" || return 1
  [ -f "$marker" ]
}
record_attachments() { # id [files...]
  # NUL-delimited. A path may legally contain spaces or newlines, and a
  # line-based ledger would silently rename or split such a file in the durable
  # record - exactly the "the evidence record lies about what was reviewed"
  # defect this change exists to remove.
  local id="$1" ledger file; shift
  [ "$#" -gt 0 ] || return 0
  ledger="$(attachments_ledger "$id")" || return 1
  # Offline hostile test hook for a real ledger write failure.
  [ "${AI_DEEPSEEK_TEST_LEDGER_FAILURE:-0}" != publish ] || return 1
  for file in "$@"; do
    [ -n "$file" ] || continue
    printf '%s\0' "$file" >> "$ledger" || return 1
  done
  chmod 0600 "$ledger" 2>/dev/null || true
}

# The boundary must sit in the SYSTEM message. A caller-supplied --system is sent
# with higher authority than the user turn, so a boundary living only in the user
# message could be contradicted ("you can read the repository") while the wrapper
# still published completed review metadata. Review mode therefore owns the system
# prompt outright and refuses to proceed when it does not.
review_system_present() { # transcript -> 0 when messages[0] is exactly the boundary
  BOUNDARY="$REVIEW_INSTRUCTION" "$PYTHON" - "$1" <<'PY'
import json, os, sys
try: msgs = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: raise SystemExit(1)
if not msgs: raise SystemExit(1)
first = msgs[0]
raise SystemExit(0 if first.get("role") == "system" and first.get("content") == os.environ["BOUNDARY"] else 1)
PY
}

write_review_metadata() { # id verdict
  local id="$1" verdict="$2" meta tmp head repo ledger
  meta="$(session_path "$id" .meta.json)" || return 1
  tmp="$(mktemp "$SESS_DIR/.meta.XXXXXX")"; repo="$REPO_ROOT"; head="${REVIEW_HEAD:-}"
  [ -n "$head" ] || { rm -f "$tmp"; return 1; }
  ledger="$(attachments_ledger "$id")" || { rm -f "$tmp"; return 1; }
  # The head binds WHEN the review happened, never what DeepSeek could see.
  # evidence_scope and attached_files keep that distinction in the durable
  # record, so no later reader mistakes a text-only opinion for repository
  # inspection at that commit.
  # Paths travel as argv and as NUL-delimited bytes, never as newline-joined
  # text, so a name containing spaces or newlines is recorded exactly as given.
  REPO="$repo" HEAD_SHA="$head" SESSION_ID="$id" VERDICT="$verdict" CALLER_NAME="$CALLER" \
  "$PYTHON" - "$tmp" "$ledger" ${REVIEW_FILES[@]+"${REVIEW_FILES[@]}"} <<'PY'
import json, os, sys
out, ledger, *attached_turn = sys.argv[1:]
try: raw = open(ledger, "rb").read()
except OSError: raw = b""
attached = []
for part in raw.split(b"\0"):
    if not part: continue
    name = os.fsdecode(part)
    if name not in attached: attached.append(name)
json.dump({"schema_version":2,"provider":"deepseek","repository_root":os.environ["REPO"],"head":os.environ["HEAD_SHA"] or None,"session_id":os.environ["SESSION_ID"],"caller":os.environ["CALLER_NAME"],"verdict":os.environ["VERDICT"],"evidence_scope":"attached-materials-only","repository_access":False,"attached_files":attached,"attached_files_this_turn":attached_turn,"status":"complete"},open(out,"w",encoding="utf-8"),indent=2)
PY
  if [ "${AI_DEEPSEEK_TEST_METADATA_FAILURE:-0}" = publish ]; then mkdir -p "$meta" || return 1; fi
  if ! write_atomic "$meta" "$tmp"; then rm -f "$tmp"; return 1; fi
  rm -f "$tmp"
}

with_files_appended() {
  # $1 = message, remaining args = file paths (may be none) -> combined text.
  # --file may be repeated: a review is only as good as the evidence it is
  # handed, and one attachment is rarely the whole story.
  local msg="$1" file; shift
  printf '%s' "$msg"
  for file in "$@"; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || { echo "Error: file not found: $file" >&2; return 1; }
    printf '\n\n--- %s ---\n%s\n--- end %s ---' "$file" "$(cat "$file")" "$file"
  done
}

# DeepSeek reaches this wrapper over a plain text API: no repository, no
# filesystem, no tools. Unless it is told so it answers as though it had
# inspected the code, and reports files it was never shown as "absent". On
# 2026-08-24 a --review run against issue #62 declared the CI workflow and both
# test runners missing; all of them exist. A verdict is bound to an exact commit
# in durable metadata, so that fabrication reads as an exact-source finding.
# This contract is the fix: state the evidence boundary, and require BLOCKED
# rather than a guess. A reply resends the whole conversation, so the boundary is
# worded around the conversation rather than one message.
REVIEW_INSTRUCTION='Evidence boundary - read this before answering. You are
being consulted through a text-only API. You have NO access to this repository,
its files, its commit history, the network, or any tool. The ONLY evidence
available to you is this conversation: the text of this message, any earlier
turns in it, and any files quoted in them.

Therefore: do not state that any file, test, workflow, directory, commit, or
setting exists, is missing, or has particular contents unless it is quoted in
this conversation. Absence from this conversation is NOT evidence of absence
from the repository.
If a conclusion would need evidence you were not given, name the missing
evidence and return BLOCKED instead of inferring it.

End the response with a literal ## Verdict heading followed on the next line by exactly APPROVE, REJECT, or BLOCKED.'

case "$SUBCMD" in
  doctor)
    LIVE=0
    case "${1:-}" in '') ;; --live) LIVE=1;; *) echo "Error: unknown doctor option: $1" >&2; exit 2;; esac
    [ "$#" -le 1 ] || { echo 'Usage: ai-deepseek-agent doctor [--live]' >&2; exit 2; }
    CREDENTIAL_READY=0
    if [ -n "$DEEPSEEK_PROVIDER_KEY" ]; then CREDENTIAL_READY=1
    elif command -v op >/dev/null 2>&1 && [ -s "$TOKEN_FILE" ] && [ -f "$MCP_ENV" ] \
      && [ "$(grep -c '^DEEPSEEK_API_KEY=op://' "$MCP_ENV" 2>/dev/null || true)" = 1 ]; then CREDENTIAL_READY=1; fi
    [ "$CREDENTIAL_READY" -eq 1 ] || { echo 'Error: DeepSeek credential plumbing is unavailable (no key and no governed 1Password reference).' >&2; exit 1; }
    printf 'PASS  curl available\nPASS  Python available (%s)\nPASS  bounded provider timeout (%ss)\n' "$PYTHON" "$CALL_TIMEOUT"
    if [ "$LIVE" -eq 1 ]; then
      MSGS="$(mktemp)"; REPLY_FILE="$(mktemp)"
      printf '[{"role":"user","content":"Reply exactly DEEPSEEK_REVIEWER_HEALTHY"}]\n' > "$MSGS"
      call_api "$MSGS" "$REPLY_FILE" || { rm -f "$MSGS" "$REPLY_FILE"; exit 1; }
      grep -qx 'DEEPSEEK_REVIEWER_HEALTHY' "$REPLY_FILE" || { rm -f "$MSGS" "$REPLY_FILE"; echo 'Error: DeepSeek live probe returned unexpected text.' >&2; exit 1; }
      rm -f "$MSGS" "$REPLY_FILE"; printf 'PASS  live provider response\n'
    fi
    ;;
  list)
    find "$SESS_DIR" -maxdepth 1 -type f -name '*.json' ! -name '*.meta.json' -printf '%T@ %f\n' 2>/dev/null \
      | sort -rn | sed -E 's/^[^ ]+ //; s/\.json$//'
    ;;

  show)
    ID="${1:-}"
    [ -n "$ID" ] || { echo "Usage: ai-deepseek-agent show <session-id>" >&2; exit 2; }
    F="$(session_path "$ID")" || exit 2
    [ -f "$F" ] || { echo "Error: no such session: $ID" >&2; exit 1; }
    "$PYTHON" -c '
import json, sys
for m in json.load(open(sys.argv[1], encoding="utf-8")):
    print("--- " + m["role"].upper() + " ---")
    print(m["content"])
    print()
' "$F"
    ;;

  send)
    MSG=""; SYSTEM=""; REVIEW=0; REVIEW_FILES=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --file) REVIEW_FILES+=("${2:-}"); shift 2 ;;
        --model) MODEL="${2:-}"; shift 2 ;;
        --system) SYSTEM="${2:-}"; shift 2 ;;
        --review) REVIEW=1; shift ;;
        *) if [ -z "$MSG" ]; then MSG="$1"; else MSG="$MSG $1"; fi; shift ;;
      esac
    done
    [ -n "$MSG" ] || { echo 'Usage: ai-deepseek-agent send "<message>" [--file FILE]...' >&2; exit 2; }
    if [ "$REVIEW" = 1 ] && [ -n "$SYSTEM" ]; then echo "Error: --system cannot be combined with --review; the review evidence boundary owns the system prompt. Put your instructions in the review message instead." >&2; exit 2; fi
    [ "$REVIEW" = 0 ] || REVIEW_HEAD="$(require_review_head)" || exit 1
    MSG="$(with_files_appended "$MSG" ${REVIEW_FILES[@]+"${REVIEW_FILES[@]}"})" || exit 1
    [ "$REVIEW" = 0 ] || MSG="$MSG

$REVIEW_INSTRUCTION"

    ID="$(new_id)"; F="$(session_path "$ID")" || exit 1
    while [ -e "$F" ]; do ID="$(new_id)-$RANDOM"; F="$(session_path "$ID")" || exit 1; done
    acquire_lock "$F" || exit 1
    CANDIDATE="$(mktemp "$SESS_DIR/.candidate.XXXXXX")"; REPLY_FILE="$(mktemp "$SESS_DIR/.reply.XXXXXX")"
    if [ "$REVIEW" = 1 ]; then build_candidate "" "$CANDIDATE" system "$REVIEW_INSTRUCTION" user "$MSG"; elif [ -n "$SYSTEM" ]; then build_candidate "" "$CANDIDATE" system "$SYSTEM" user "$MSG"; else build_candidate "" "$CANDIDATE" user "$MSG"; fi
    call_api "$CANDIDATE" "$REPLY_FILE" || { rm -f "$CANDIDATE" "$REPLY_FILE"; echo "Error: provider failed; conversation was not created." >&2; exit 1; }
    REPLY="$(<"$REPLY_FILE")"; rm -f "$REPLY_FILE"
    VERDICT=""
    if [ "$REVIEW" = 1 ]; then VERDICT="$(review_verdict "$REPLY")" || { rm -f "$CANDIDATE"; echo "Error: DeepSeek review ended without a usable verdict; conversation was not created." >&2; exit 1; }; fi
    build_candidate "$CANDIDATE" "$CANDIDATE.final" assistant "$REPLY"
    if [ "${AI_DEEPSEEK_TEST_TRANSCRIPT_FAILURE:-0}" = publish ]; then mkdir -p "$F" || true; fi
    if ! write_atomic "$F" "$CANDIDATE.final"; then
      rm -f "$CANDIDATE" "$CANDIDATE.final"
      release_lock
      echo "Error: the conversation transcript could not be published; no completion was recorded." >&2
      exit 1
    fi
    rm -f "$CANDIDATE" "$CANDIDATE.final"
    if ! record_attachments "$ID" ${REVIEW_FILES[@]+"${REVIEW_FILES[@]}"}; then
      mark_recovery_required "$ID" "attachment ledger write failed after the transcript was published" || true
      release_lock
      echo "Error: the conversation was saved, but its attachment record could not be updated. This session is marked recovery-required and cannot be continued until its ledger is reconciled." >&2
      exit 1
    fi
    if [ "$REVIEW" = 1 ] && ! write_review_metadata "$ID" "$VERDICT"; then
      release_lock
      echo "Error: review transcript was saved, but its required evidence metadata could not be published." >&2
      exit 1
    fi
    release_lock
    echo "SESSION_ID: $ID"
    echo
    echo "$REPLY"
    ;;

  reply)
    ID="${1:-}"; shift || true
    MSG=""; REVIEW=0; REVIEW_FILES=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --file) REVIEW_FILES+=("${2:-}"); shift 2 ;;
        --review) REVIEW=1; shift ;;
        *) if [ -z "$MSG" ]; then MSG="$1"; else MSG="$MSG $1"; fi; shift ;;
      esac
    done
    [ -n "$ID" ] && [ -n "$MSG" ] || { echo 'Usage: ai-deepseek-agent reply <session-id> "<message>"' >&2; exit 2; }
    [ "$REVIEW" = 0 ] || REVIEW_HEAD="$(require_review_head)" || exit 1
    F="$(session_path "$ID")" || exit 2
    [ -f "$F" ] || { echo "Error: no such session: $ID" >&2; exit 1; }
    if recovery_required "$ID"; then echo "Error: this conversation is marked recovery-required because its attachment record fell behind its transcript; its evidence list would understate what DeepSeek saw. Reconcile or delete it before continuing." >&2; exit 1; fi
    if [ "$REVIEW" = 1 ] && ! review_system_present "$F"; then echo "Error: this conversation was not started as a formal review, so its system prompt is not the review evidence boundary. Start the review with: ai-deepseek-agent send \"<message>\" --review" >&2; exit 1; fi
    MSG="$(with_files_appended "$MSG" ${REVIEW_FILES[@]+"${REVIEW_FILES[@]}"})" || exit 1
    [ "$REVIEW" = 0 ] || MSG="$MSG

$REVIEW_INSTRUCTION"

    acquire_lock "$F" || exit 1
    CANDIDATE="$(mktemp "$SESS_DIR/.candidate.XXXXXX")"; REPLY_FILE="$(mktemp "$SESS_DIR/.reply.XXXXXX")"
    build_candidate "$F" "$CANDIDATE" user "$MSG"
    call_api "$CANDIDATE" "$REPLY_FILE" || { rm -f "$CANDIDATE" "$REPLY_FILE"; echo "Error: provider failed; canonical conversation is unchanged." >&2; exit 1; }
    REPLY="$(<"$REPLY_FILE")"; rm -f "$REPLY_FILE"
    VERDICT=""
    if [ "$REVIEW" = 1 ]; then VERDICT="$(review_verdict "$REPLY")" || { rm -f "$CANDIDATE"; echo "Error: DeepSeek review ended without a usable verdict; canonical conversation is unchanged." >&2; exit 1; }; fi
    build_candidate "$CANDIDATE" "$CANDIDATE.final" assistant "$REPLY"
    if ! write_atomic "$F" "$CANDIDATE.final"; then
      rm -f "$CANDIDATE" "$CANDIDATE.final"
      release_lock
      echo "Error: the conversation transcript could not be published; canonical conversation is unchanged." >&2
      exit 1
    fi
    rm -f "$CANDIDATE" "$CANDIDATE.final"
    if ! record_attachments "$ID" ${REVIEW_FILES[@]+"${REVIEW_FILES[@]}"}; then
      mark_recovery_required "$ID" "attachment ledger write failed after the transcript was published" || true
      release_lock
      echo "Error: the conversation was saved, but its attachment record could not be updated. This session is marked recovery-required and cannot be continued until its ledger is reconciled." >&2
      exit 1
    fi
    if [ "$REVIEW" = 1 ] && ! write_review_metadata "$ID" "$VERDICT"; then
      release_lock
      echo "Error: review transcript was saved, but its required evidence metadata could not be published." >&2
      exit 1
    fi
    release_lock
    echo "$REPLY"
    ;;
esac
